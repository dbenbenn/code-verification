private theorem no_ev_peel (Ev : Type) [ExecTraceTypes.Has (DY.ProtocolEvent.ExecEntryT Ev)]
    {E : Type} [ExecTraceTypes.Has E] {tr : ExecTrace} {e : E} {i : Nat}
    (hnone : (DY.TraceEntryHas.proj (DY.TraceEntryHas.inj e : ExecTrace.Entry) :
      Option (DY.ProtocolEvent.ExecEntryT Ev)) = none)
    (h0 : tr.getEventAt Ev i = none) :
    (tr.append e).getEventAt Ev i = none := by
  simp only [Symbolic.DYBridge.DY.Trace.getEventAt_eq_1] at h0 ⊢
  by_cases hlt : i < tr.length
  · rw [at?_append_of_lt tr e hlt]; exact h0
  · by_cases heq : i = tr.length
    · subst heq; rw [at?_append_self_proj, hnone]
    · rcases hat : ((tr.append e).at? i : Option (DY.ProtocolEvent.ExecEntryT Ev)) with _ | _
      · rfl
      · have := DY.Trace.at?_eq_some_implies_length_le
          (EntryT := DY.ProtocolEvent.ExecEntryT Ev) (tr.append e) i
        rw [hat, append_len] at this; simp at this; omega

