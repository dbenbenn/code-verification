theorem sendTerms_visClean_2 {r : ProtocolSetup} (cls : Nat → Nat)
    (ha : r.alice = "alice") (hb : r.bob = "bob") (ho : r.withOpk = true) :
    ((visClean r cls 2).filter (·.kind == .send)).flatMap (·.terms) =
      [oOpk.ek, oOpk.ct, m0Clean cls] := by
  rw [(visClean_steps_eq cls ha hb ho).2.2.1, stepView_s0, stepView_s1]
  by_cases hc0 : cls 0 = 0 <;>
    simp [hc0, rngEntry, filter_send_kyberCoinEntries]

theorem sendTerms_visClean_5 {r : ProtocolSetup} (cls : Nat → Nat)
    (ha : r.alice = "alice") (hb : r.bob = "bob") (ho : r.withOpk = true) :
    ((visClean r cls 5).filter (·.kind == .send)).flatMap (·.terms) =
      [oOpk.ek, oOpk.ct, m0Clean cls, o2Clean.ek, o2Clean.ct, m1Clean cls] := by
  rw [(visClean_steps_eq cls ha hb ho).2.2.2.2.2,
    stepView_s0, stepView_s1, stepView_s2, stepView_s3, stepView_s4]
  by_cases hc0 : cls 0 = 0 <;> by_cases hc1 : cls 1 = 0 <;>
    simp [hc0, hc1, rngEntry, filter_send_kyberCoinEntries]

