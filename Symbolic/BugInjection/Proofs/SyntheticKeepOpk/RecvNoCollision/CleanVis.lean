theorem stepView_s4 (cls : Nat → Nat) :
    stepView (s4Clean cls) (trClean4 cls) true =
      ⟨.pt, [pt1Clean], .single, none⟩ ::
      ((if cls 1 != 0 then [rngEntry (randTerm 62 (cls 1))] else []) ++
       [⟨.send, [o2Clean.ek, o2Clean.ct, m1Clean cls], .preKeySend, none⟩]) := by
  obtain ⟨hn4, hok4⟩ := s4_next_ok cls
  have h := encTrGen_stepView_ok (wrapped := true) hok4 hn4
  rw [trClean4_length, pendingPreKey_trClean4] at h
  exact h

/-! ## 4. Closed-Form `send` and `plaintextTerms` Summaries at `m = 2` and `m = 5` -/

theorem visClean_steps_eq {r : ProtocolSetup} (cls : Nat → Nat)
    (ha : r.alice = "alice") (hb : r.bob = "bob") (ho : r.withOpk = true) :
    visClean r cls 0 = [] ∧
    visClean r cls 1 = stepView s0Clean t4Opk (runWrapped (ev 0)) ∧
    visClean r cls 2 =
      stepView s0Clean t4Opk (runWrapped (ev 0)) ++
      stepView (s1Clean cls) t5Opk true ∧
    visClean r cls 3 =
      stepView s0Clean t4Opk (runWrapped (ev 0)) ++
      stepView (s1Clean cls) t5Opk true ++
      stepView s2Clean (trClean2 cls) (runWrapped (ev 2)) ∧
    visClean r cls 4 =
      stepView s0Clean t4Opk (runWrapped (ev 0)) ++
      stepView (s1Clean cls) t5Opk true ++
      stepView s2Clean (trClean2 cls) (runWrapped (ev 2)) ++
      stepView s3Clean (trClean3 cls) (runWrapped (ev 3)) ∧
    visClean r cls 5 =
      stepView s0Clean t4Opk (runWrapped (ev 0)) ++
      stepView (s1Clean cls) t5Opk true ++
      stepView s2Clean (trClean2 cls) (runWrapped (ev 2)) ++
      stepView s3Clean (trClean3 cls) (runWrapped (ev 3)) ++
      stepView (s4Clean cls) (trClean4 cls) true := by
  obtain ⟨ht0, ht1, ht2, ht3, ht4, _⟩ := runTrace_ssClean_eqs cls ha hb ho
  have hw1 : runWrapped (ev 1) = true := ev1_facts.2.2.2.2
  have hw4 : runWrapped (ev 4) = true := ev4_facts.2.2.2.2
  have hv0 : visClean r cls 0 = [] := rfl
  have hv1 : visClean r cls 1 = stepView s0Clean t4Opk (runWrapped (ev 0)) := by
    rw [visClean_succ (by decide) (s := s0Clean) rfl, hv0, List.nil_append, ht0]
  have hv2 : visClean r cls 2 =
      stepView s0Clean t4Opk (runWrapped (ev 0)) ++ stepView (s1Clean cls) t5Opk true := by
    rw [visClean_succ (by decide) (s := s1Clean cls) rfl, hv1, ht1, hw1]
  have hv3 : visClean r cls 3 =
      stepView s0Clean t4Opk (runWrapped (ev 0)) ++ stepView (s1Clean cls) t5Opk true ++
      stepView s2Clean (trClean2 cls) (runWrapped (ev 2)) := by
    rw [visClean_succ (by decide) (s := s2Clean) rfl, hv2, ht2]
  have hv4 : visClean r cls 4 =
      stepView s0Clean t4Opk (runWrapped (ev 0)) ++ stepView (s1Clean cls) t5Opk true ++
      stepView s2Clean (trClean2 cls) (runWrapped (ev 2)) ++
      stepView s3Clean (trClean3 cls) (runWrapped (ev 3)) := by
    rw [visClean_succ (by decide) (s := s3Clean) rfl, hv3, ht3]
  have hv5 : visClean r cls 5 =
      stepView s0Clean t4Opk (runWrapped (ev 0)) ++ stepView (s1Clean cls) t5Opk true ++
      stepView s2Clean (trClean2 cls) (runWrapped (ev 2)) ++
      stepView s3Clean (trClean3 cls) (runWrapped (ev 3)) ++
      stepView (s4Clean cls) (trClean4 cls) true := by
    rw [visClean_succ (by decide) (s := s4Clean cls) rfl, hv4, ht4, hw4]
  exact ⟨hv0, hv1, hv2, hv3, hv4, hv5⟩

private theorem filter_send_kyberCoinEntries (e : Bytes) :
    (kyberCoinEntries e).filter (·.kind == .send) = [] := by
  unfold kyberCoinEntries
