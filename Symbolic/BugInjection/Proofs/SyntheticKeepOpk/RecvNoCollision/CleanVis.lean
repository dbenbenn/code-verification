    Symbolic.Proofs.Tests.Shared.Composed.Runs.aliceSt, dhsAOpk, dhsA2Clean] at hsid
  have hpack :
      (({ lhs := dhPk (rnd 28 32), rhs := oOpk.keys.rk } : DY.Concat.Concat.SubF Bytes).pack) =
      (({ lhs := dhPk (rnd 54 32), rhs := o2Clean.keys.rk } : DY.Concat.Concat.SubF Bytes).pack) := hsid
  have hdhs := congrArg DY.Concat.Concat.SubF.lhs
    (Symbolic.DYBridge.DY.BytesView.pack_inj.mp hpack)
  exact dhPk_rnd_ts_ne (by decide) hdhs

