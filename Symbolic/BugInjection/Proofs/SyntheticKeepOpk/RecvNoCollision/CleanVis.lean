  obtain ⟨j, _, rfl⟩ := List.mem_map.mp hv
  simp

private theorem filter_pt_kyberCoinEntries (e : Bytes) :
    (kyberCoinEntries e).filter (·.kind == .pt) = [] := by
  unfold kyberCoinEntries
  rw [List.filter_eq_nil_iff]
