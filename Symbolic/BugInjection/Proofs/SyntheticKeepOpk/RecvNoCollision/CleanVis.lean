private theorem no_cev_encTrGen {tr : ExecTrace} {me : Participant} {stH cl : Nat}
    {st : TRState} {pq : Bytes} {i : Nat}
    (hi : tr.length ≤ i) (hilt : i < (encTrGen tr me stH cl st pq).length) :
    (encTrGen tr me stH cl st pq).getEventAt ComposedEvent i = none := by
  rw [encTrGen_length] at hilt
  let t0 := tr
  let t1' := t0.append (RndE 32)
  let t2' := t1'.append (RndE cl)
  let t3' := t2'.append (NetE (DY.Spqr.spqrSend st.spqr (rnd (tr.length + 1) cl)).2.1)
  let t4' := t3'.append (EvT (.Sent me st.peer (dhPk st.dhs) st.ns (rnd tr.length 32)))
  let t5' := t4'.append (EvT (.MessageKey (st.sessionInfo me) .sender (kdfCk st.cks).2 pq st.ns st.rIdx stH))
  let t6' := t5'.append (StT me (encSt st (rnd (tr.length + 1) cl)))
  let t7' := encTrGen tr me stH cl st pq
  have h67 : t6' ≤ t7' := DY.Trace.append_le _ _
  have h57 : t5' ≤ t7' := le_append_of_le (DY.Trace.append_le _ _) _
  have h47 : t4' ≤ t7' := DY.Trace.le_trans _ _ _ (DY.Trace.append_le _ _) h57
  have h37 : t3' ≤ t7' := DY.Trace.le_trans _ _ _ (DY.Trace.append_le _ _) h47
  have h27 : t2' ≤ t7' := DY.Trace.le_trans _ _ _ (DY.Trace.append_le _ _) h37
  have h17 : t1' ≤ t7' := DY.Trace.le_trans _ _ _ (DY.Trace.append_le _ _) h27
  simp only [Symbolic.DYBridge.DY.Trace.getEventAt_eq_1]
  have hd : i = tr.length ∨ i = tr.length + 1 ∨ i = tr.length + 2 ∨ i = tr.length + 3 ∨
      i = tr.length + 4 ∨ i = tr.length + 5 ∨ i = tr.length + 6 := by omega
  rcases hd with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [entry_proj_none _ h17 rfl rfl]
  · rw [entry_proj_none _ h27 (by simp +zetaDelta only [append_len]) rfl]
  · rw [entry_proj_none _ h37 (by simp +zetaDelta only [append_len, Nat.add_assoc]) rfl]
  · rw [entry_proj_none _ h47 (by simp +zetaDelta only [append_len, Nat.add_assoc]) rfl]
  · rw [entry_proj_none _ h57 (by simp +zetaDelta only [append_len, Nat.add_assoc]) rfl]
  · rw [entry_proj_none _ h67 (by simp +zetaDelta only [append_len, Nat.add_assoc]) rfl]
  · rw [entry_proj_none (tr₀ := t6') _ (DY.Trace.le_refl t7')
      (by simp +zetaDelta only [append_len, Nat.add_assoc]) rfl]

theorem pendingPreKey_trClean4 (cls : Nat → Nat) :
    pendingPreKey (trClean4 cls) 60 = some (o2Clean.ek, o2Clean.ct) := by
  have hat := trClean4_stA2_0_at cls
  have hdec : sessionHasDecrypted (trClean4 cls) (stA2_0Clean.sessionInfo "alice") 60 = false := by
    unfold sessionHasDecrypted
    simp only [List.any_eq_false, Bool.not_eq_true]
    intro j hj
    have hj' : j < (trClean4 cls).length := by
      rw [trClean4_length]; exact Nat.lt_trans (List.mem_range.mp hj) (by decide)
    split
    · next s' mk pq n rIdx pIdx hget =>
      by_cases heq : s' = stA2_0Clean.sessionInfo "alice"
      · subst heq; exact absurd hget (no_alice_receiver_mk_trClean4 cls j hj' _ _ _ _ _)
      · exact decide_eq_false heq
    · rfl
  unfold pendingPreKey DY.ExecTrace.getLocalStateAt
