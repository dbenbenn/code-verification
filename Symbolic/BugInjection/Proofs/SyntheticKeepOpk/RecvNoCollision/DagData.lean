inductive BinTree (α : Type) where
  | leaf (val : α)
  | branch (l r : BinTree α)

def BinTree.get {α : Type} : BinTree α → Nat → α
  | .leaf v, _ => v
  | .branch l r, i => if i % 2 == 0 then l.get (i / 2) else r.get (i / 2)

