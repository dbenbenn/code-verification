def dagOp (id : Nat) : DagOp := dagOpTree.get id
def dagBytes (id : Nat) : HwBytes := dagBytesTree.get id

private theorem dag_nodes_ok_chunk0 : ((List.range' 0 50).all fun id => dagNodeOk dagOp dagBytes id) = true := by
  decide +kernel

private theorem dag_nodes_ok_chunk1 : ((List.range' 50 50).all fun id => dagNodeOk dagOp dagBytes id) = true := by
  decide +kernel

private theorem dag_nodes_ok_chunk2 : ((List.range' 100 50).all fun id => dagNodeOk dagOp dagBytes id) = true := by
  decide +kernel

private theorem dag_nodes_ok_chunk3 : ((List.range' 150 50).all fun id => dagNodeOk dagOp dagBytes id) = true := by
  decide +kernel

theorem dag_nodes_ok : ∀ id < dagSize, dagNodeOk dagOp dagBytes id = true := by
  intro id hid
  have hds : id < 200 := hid
  by_cases h50 : id < 50
  · exact List.all_eq_true.mp dag_nodes_ok_chunk0 id (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
  · by_cases h100 : id < 100
    · exact List.all_eq_true.mp dag_nodes_ok_chunk1 id (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
    · by_cases h150 : id < 150
      · exact List.all_eq_true.mp dag_nodes_ok_chunk2 id (List.mem_range'_1.mpr ⟨by omega, by omega⟩)
      · exact List.all_eq_true.mp dag_nodes_ok_chunk3 id (List.mem_range'_1.mpr ⟨by omega, by omega⟩)

private theorem dag_no_0100_all :
    ((List.range dagSize).all fun id => !(dagOp id).isAI || !endsWith0100 (dagBytes id)) = true := by
  decide +kernel

theorem dag_no_ai_0100 {id : Nat} (hid : id < dagSize) (hai : (dagOp id).isAI = true) :
    ¬ ([0x01#8, 0x00#8] <:+ dagBytes id) :=
  dag_no_ai_0100_of_all dag_no_0100_all hid hai

private def fastKey (bs : HwBytes) : Nat :=
  bs.length + 2048 * bytesToNat (bs.take 16)

