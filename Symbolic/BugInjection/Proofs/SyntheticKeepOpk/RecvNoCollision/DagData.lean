private def dagBucket (b : Nat) : List (Nat × Bool × Nat) := dagBucketTree.get b

private theorem dag_buckets_ok :
    ((List.range 256).all fun b => bucketNoCollision (dagBucket b)) = true := by
  decide +kernel

private theorem dag_in_bucket_all :
    ((List.range dagSize).all fun id =>
      decide ((id, (dagOp id).isAI, fastKey (dagBytes id)) ∈ dagBucket (bytesBucketIdx (dagBytes id)))) = true := by
  decide +kernel

private theorem bytesBucketIdx_lt (bs : HwBytes) : bytesBucketIdx bs < 256 := by
  cases bs with
  | nil => decide
  | cons b _ => exact b.isLt

theorem dag_no_collision (id₁ : Nat) (hid₁ : id₁ < dagSize) (id₂ : Nat) (hid₂ : id₂ < dagSize)
    (hai : (dagOp id₁).isAI = true ∨ (dagOp id₂).isAI = true)
    (hbytes : dagBytes id₁ = dagBytes id₂) : id₁ = id₂ := by
  have h₁ : (id₁, (dagOp id₁).isAI, fastKey (dagBytes id₁)) ∈
      dagBucket (bytesBucketIdx (dagBytes id₁)) :=
    of_decide_eq_true (List.all_eq_true.mp dag_in_bucket_all id₁ (List.mem_range.mpr hid₁))
  have h₂ : (id₂, (dagOp id₂).isAI, fastKey (dagBytes id₂)) ∈
      dagBucket (bytesBucketIdx (dagBytes id₂)) :=
    of_decide_eq_true (List.all_eq_true.mp dag_in_bucket_all id₂ (List.mem_range.mpr hid₂))
  have hk : fastKey (dagBytes id₂) = fastKey (dagBytes id₁) := congrArg fastKey hbytes.symm
  have hb : bytesBucketIdx (dagBytes id₂) = bytesBucketIdx (dagBytes id₁) :=
    congrArg bytesBucketIdx hbytes.symm
  rw [hk, hb] at h₂
  have hbok : bucketNoCollision (dagBucket (bytesBucketIdx (dagBytes id₁))) = true :=
    List.all_eq_true.mp dag_buckets_ok _ (List.mem_range.mpr (bytesBucketIdx_lt _))
  exact bucketNoCollision_sound hbok h₁ h₂ hai

structure TrialRow where
  salt : Nat
  seed : Nat
  prk : Nat
  ck : Nat
  c2 : Nat
  mkey : Nat
  c3 : Nat
  iv : Nat
  cm1 : Nat
  cm2 : Nat
  hm : Nat
  mac : Nat

def TrialRowOk (pik mik w : Nat) (r : TrialRow) : Prop :=
  (r.prk < dagSize ∧ dagOp r.prk = .kdf r.salt r.seed) ∧
  (r.ck < dagSize ∧ dagOp r.ck = .kdf r.prk id_wmkInfo1) ∧
  (r.c2 < dagSize ∧ dagOp r.c2 = .concat r.ck id_wmkInfo2) ∧
  (r.mkey < dagSize ∧ dagOp r.mkey = .kdf r.prk r.c2) ∧
  (r.c3 < dagSize ∧ dagOp r.c3 = .concat r.mkey id_wmkInfo3) ∧
  (r.iv < dagSize ∧ dagOp r.iv = .kdf r.prk r.c3) ∧
  (r.cm1 < dagSize ∧ dagOp r.cm1 = .concat mik w) ∧
  (r.cm2 < dagSize ∧ dagOp r.cm2 = .concat pik r.cm1) ∧
  (r.hm < dagSize ∧ dagOp r.hm = .kdf r.mkey r.cm2) ∧
  (r.mac < dagSize ∧ dagOp r.mac = .trunc8 r.hm)

