/-- All 193 recorded SHA-256 `(stNat, blkNat, outNat)` triples. -/
def keepOpkSha256Rows : List (Nat × Nat × Nat) :=
  (List.range 64).flatMap keepOpkSha256Bucket

/-- Table-driven SHA-256 compression for `keepOpkI0` with tag propagation. -/
def keepOpkSha256 (st blk : HwBytes) : HwBytes :=
  if st.take 4 == compTag4 || blk.take 4 == compTag4 ||
     blk.take 4 == compTag4Ipad || blk.take 4 == compTag4Opad then
    compDefaultSha256 st blk
  else if st.length == 32 && blk.length == 64 then
    let kSt := bytesToNat st
    let kBlk := bytesToNat blk
    match (keepOpkSha256Bucket (kBlk % 64)).find? (fun r => r.1 == kSt && r.2.1 == kBlk) with
    | some (_, _, outNat) => leBytes 32 outNat
    | none => compDefaultSha256 st blk
  else
    compDefaultSha256 st blk

