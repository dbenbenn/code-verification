def keepOpkLookupPub (s : HwBytes) : HwBytes :=
  keepOpkPubOfOpt (keepOpkSecretIdx s)

def keepOpkLookupDh (s p : HwBytes) : HwBytes :=
  if isLowOrderKey (p.map BitVec.toNat) then
    List.replicate 32 0#8
  else
    match keepOpkSecretIdx s, keepOpkPointIdx p with
    | some i, some j => keepOpkDhByIdx i j
    | _, _ => compDefaultDh

def keepOpkAesPt0 : HwBytes := leBytes 2 0x316d
def keepOpkAesK0 : HwBytes := leBytes 32 0x5559ad8949e04ab9ccd254e09bb2e0ea7ffe953834ad971f934beaab6f3c0655
def keepOpkAesIv0 : HwBytes := leBytes 16 0xaf3cfc268063f736bf10f2455cc6d709
def keepOpkAesCt0 : HwBytes := leBytes 16 0x5df0c6049f85a371e2ff07851714acfa
def keepOpkAesA0 : CryptoGames.CBC.Block := ByteSpecs.bytesToBlock (ByteSpecs.pkcs7Bytes (⟨keepOpkAesPt0, by decide⟩ : List.Vector (BitVec 8) 2)) ^^^ CryptoGames.CBC.bytesToBlock keepOpkAesIv0
def keepOpkAesB0 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock keepOpkAesCt0
def keepOpkAesPt1 : HwBytes := leBytes 2 0x326d
def keepOpkAesK1 : HwBytes := leBytes 32 0x8f27d81a32bffd3b1be33d1f66bc1c6273dbdb44d0896dc8d3c0156fae1d131e
def keepOpkAesIv1 : HwBytes := leBytes 16 0x2efd26451046e386d0530d760375e135
def keepOpkAesCt1 : HwBytes := leBytes 16 0x5b4bbf9ad3aae6e2a5e66971afc3d8c0
def keepOpkAesA1 : CryptoGames.CBC.Block := ByteSpecs.bytesToBlock (ByteSpecs.pkcs7Bytes (⟨keepOpkAesPt1, by decide⟩ : List.Vector (BitVec 8) 2)) ^^^ CryptoGames.CBC.bytesToBlock keepOpkAesIv1
def keepOpkAesB1 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock keepOpkAesCt1

/-- Involutive AES-256 block cipher swapping `(keepOpkAesA_m, keepOpkAesB_m)` on `keepOpkAesK_m`. -/
def keepOpkAesBlock (k : CryptoGames.CBC.AesKey) (b : CryptoGames.CBC.Block) : CryptoGames.CBC.Block :=
  if k == CryptoGames.HKDF.bytesToKey32 keepOpkAesK0 then
    if b == keepOpkAesA0 then keepOpkAesB0 else if b == keepOpkAesB0 then keepOpkAesA0 else b
  else if k == CryptoGames.HKDF.bytesToKey32 keepOpkAesK1 then
    if b == keepOpkAesA1 then keepOpkAesB1 else if b == keepOpkAesB1 then keepOpkAesA1 else b
  else b

def keepOpkAesPerm (k iv text : HwBytes) : HwBytes :=
  CryptoGames.LibsignalSession.aesCbcEncrypt keepOpkAesBlock (CryptoGames.HKDF.bytesToKey32 k) (CryptoGames.CBC.bytesToBlock iv) text

def keepOpkAesDec (k iv ct : HwBytes) : Option HwBytes :=
  CryptoGames.LibsignalSession.aesCbcDecrypt keepOpkAesBlock (CryptoGames.HKDF.bytesToKey32 k) (CryptoGames.CBC.bytesToBlock iv) ct

def keepOpkKyberE0 : HwBytes := leBytes 32 0x26dbbcc03fd18c061cfc083f071e14d5baf49d84843ffc43a4383b3212e60505
def keepOpkKyberCt0 : HwBytes := leBytes 1568 
def keepOpkKyberSs0 : HwBytes := leBytes 32 0x86e81a17be5801293d514fe3c93d60943e523b05dc2096ee371824900b0cace4
def keepOpkKyberE1 : HwBytes := leBytes 32 0xd69a82e5e24bfe5207ae1767135a76448ab2285aa9ef03be32dd5c1adebc0750
def keepOpkKyberCt1 : HwBytes := leBytes 1568 
def keepOpkKyberSs1 : HwBytes := leBytes 32 0xcd15233810702d7f740920a1043f3d5ae106e3d60421880b77aa028f8ff7a80b

/-- Kyber-1024 encapsulate output (`1600 = 1568 + 32` bytes) for randomness `e`. -/
def keepOpkKyberEncaps (e : HwBytes) : HwBytes :=
  if e == keepOpkKyberE0 then keepOpkKyberCt0 ++ keepOpkKyberSs0
  else if e == keepOpkKyberE1 then keepOpkKyberCt1 ++ keepOpkKyberSs1
  else compDefaultKyberCt ++ compDefaultKyberSs

/-- Kyber-1024 decapsulate output (32 bytes) for ciphertext `ct`. -/
def keepOpkKyberDecaps (ct : HwBytes) : HwBytes :=
  if ct == keepOpkKyberCt0 then keepOpkKyberSs0
  else if ct == keepOpkKyberCt1 then keepOpkKyberSs1
  else compDefaultKyberSs

/-- Recorded `mlkem768FromSeed` outputs (2400 bytes) for the two sessions in `KeepOpkCli`. -/
def keepOpkMlkem768FromSeed (seed : HwBytes) : HwBytes :=
  if seed.length == 64 then
    let k := bytesToNat seed
    if k == 0xd29f4b1ebb34c5fb9a88a065d0c64af252f6b36390ab32da16b3db3cf2c0f2e13e0edf525b5b21aa9072c613b3758df356802ad08725469c98b873b9461f2523 then leBytes 2400 
    else if k == 0xf599def579678f793d17bfa4d0db9d626035fccdadd3d8e4759b35eaf6c2da094b9a28133892df1f7b87997379d29dc0ea685d600bc24d75ed998f8bfc215a35 then leBytes 2400 
    else List.replicate 2400 0#8
  else List.replicate 2400 0#8

/-- Recorded `libcruxHmacSymbol` outputs (32 bytes) for the two sessions in `KeepOpkCli`. -/
def keepOpkHmac (k d : HwBytes) : HwBytes :=
  if k.length == 32 && d.length == 105 then
    let kk := bytesToNat k
    let kd := bytesToNat d
    if kk == 0x1d3afa82deeba164a89c061d97f41142e68e3878af2cac8ee0b60a6825305eea && kd == 0x5ac2f4ce6d5b71c22b23d97cc15fd3dfd708a3bd1e6fbddc7d7cbb0b08bac6000b8cdd0fe997174ce780528bf9ecc13020f000fc44144b1638e063bc8c1218a501000000000000007265646165686b653a3836374d454b4c4d5f31565f414b4351505f6c616e676953 then leBytes 32 0x354dc5a2081aa1b87d39b19b7028c73e54ef9f0ea3ab639d536c5d52d4af3bb
    else if kk == 0x77973253b4000ca3a80cbeec6fc10271167948cc520f88793d7d9f1e7fc0c1ff && kd == 0x707ce5fe44c6021d4661bbbaf28c6fde3927c448cee3fe5e19eae3fe01fd88d1968cdf6a86dcc878e434e648a48f628537dc52ab56ee8ad5a2a4552f4c5a588601000000000000007265646165686b653a3836374d454b4c4d5f31565f414b4351505f6c616e676953 then leBytes 32 0x14be41d504e96e3097494598be452f85fc6ed3d827cb4e1109164e6ef6d44936
    else compDefaultHmac k d
  else compDefaultHmac k d

/-- Witness `ExternInterpretation` for `KeepOpkCli`. -/
def keepOpkI0 : ExternInterpretation :=
  fun s args =>
    if s = x25519PublicKeySymbol then
      match args with | [sk] => some (keepOpkLookupPub sk) | _ => none
    else if s = x25519AgreementSymbol then
      match args with | [sk, pk] => some (keepOpkLookupDh sk pk) | _ => none
    else if s = x25519TorsionSymbol then
      none
    else if s = aesCbcEncryptSymbol then
      match args with | [text, k, iv] => some (keepOpkAesPerm k iv text) | _ => none
    else if s = aesCbcDecryptSymbol then
      match args with | [ct, k, iv] => keepOpkAesDec k iv ct | _ => none
    else if s = kyberEncapsSymbol then
      match args with | [_, rand] => some (keepOpkKyberEncaps rand) | _ => some (compDefaultKyberCt ++ compDefaultKyberSs)
    else if s = kyberDecapsSymbol then
      match args with | [_, ct] => some (keepOpkKyberDecaps ct) | _ => some compDefaultKyberSs
    else if s = libcruxHmacSymbol then
      match args with | [k, d] => some (keepOpkHmac k d) | _ => some (compDefaultHmac [] [])
    else if s = sha256CompressSymbol then
      match args with | [st, blk] => some (keepOpkSha256 st blk) | _ => some (compDefaultSha256 [] [])
    else if s = mlkem768FromSeedSymbol then
      match args with | [seed] => some (keepOpkMlkem768FromSeed seed) | _ => some (List.replicate 2400 0#8)
    else
      compOtherExtern s args

theorem keepOpkPubOfIdx_length (i : Fin 10) : (keepOpkPubOfIdx i).length = 32 := by
  revert i; decide

theorem keepOpkLookupPub_length (s : HwBytes) : (keepOpkLookupPub s).length = 32 := by
  unfold keepOpkLookupPub keepOpkPubOfOpt
  cases keepOpkSecretIdx s with
  | none => decide
  | some idx => exact keepOpkPubOfIdx_length idx

theorem keepOpkDhByIdx_length (i j : Fin 10) : (keepOpkDhByIdx i j).length = 32 := by
  revert i j; decide

theorem keepOpkLookupDh_length (s p : HwBytes) : (keepOpkLookupDh s p).length = 32 := by
  unfold keepOpkLookupDh
  split
  · rfl
  · cases keepOpkSecretIdx s <;> cases keepOpkPointIdx p <;> dsimp only <;>
      first | exact keepOpkDhByIdx_length _ _ | decide

theorem keepOpkKyberCt0_length : keepOpkKyberCt0.length = 1568 := leBytes_length 1568 _
theorem keepOpkKyberCt1_length : keepOpkKyberCt1.length = 1568 := leBytes_length 1568 _
theorem keepOpkKyberSs0_length : keepOpkKyberSs0.length = 32 := leBytes_length 32 _
theorem keepOpkKyberSs1_length : keepOpkKyberSs1.length = 32 := leBytes_length 32 _

theorem keepOpkKyberEncaps_length (e : HwBytes) : (keepOpkKyberEncaps e).length = 1600 := by
  unfold keepOpkKyberEncaps
  split
  · simp [keepOpkKyberCt0_length, keepOpkKyberSs0_length]
  · split
    · simp [keepOpkKyberCt1_length, keepOpkKyberSs1_length]
    · rfl

theorem keepOpkKyberDecaps_length (ct : HwBytes) : (keepOpkKyberDecaps ct).length = 32 := by
  unfold keepOpkKyberDecaps
  split
  · exact keepOpkKyberSs0_length
  · split
    · exact keepOpkKyberSs1_length
    · rfl

/-- Recorded ML-KEM-768 primitives for `keepOpkHooks0`. -/
def keepOpkExecMlKem0 : CryptoVerification.LibsignalSpqrV1.MlKem :=
  { compMlKem0 with
    keyPair := fun seed => CryptoVerification.E2E.fitVec 2400 (keepOpkMlkem768FromSeed seed.toList) }

/-- Concrete CLI hooks agreeing with `keepOpkI0`. -/
def keepOpkHooks0 : CliHooks where
  C :=
    { F := sha256CompressFunction keepOpkI0
      E := keepOpkAesBlock
      D := keepOpkAesBlock
      X := fun a b => ⟨keepOpkLookupDh a.toList b.toList, keepOpkLookupDh_length a.toList b.toList⟩
      pubKey := fun a => ⟨keepOpkLookupPub a.toList, keepOpkLookupPub_length a.toList⟩ }
  Q :=
    { F512 := fun st blk =>
        bytesToSha512StateLE (compSha512 (CryptoVerification.E2E.sha512StateBytesLE st) blk)
      encaps := fun _ rand =>
        (⟨(keepOpkKyberEncaps rand.toList).take 1568, by
            rw [List.length_take, keepOpkKyberEncaps_length]; rfl⟩,
         ⟨(keepOpkKyberEncaps rand.toList).drop 1568, by
            rw [List.length_drop, keepOpkKyberEncaps_length]⟩)
      decaps := fun _ ct => ⟨keepOpkKyberDecaps ct.toList, keepOpkKyberDecaps_length ct.toList⟩
      K := keepOpkExecMlKem0 }

/-- Concrete `ProtocolSetup` of a witness setup `w` evaluated under `keepOpkI0`. -/
def keepOpkRecordsI0 (w : PQXDHSpqrSetup) : ProtocolSetup :=
  { alice := "alice", bob := "bob", withOpk := w.withOpk, regIdA := w.regIdA, regIdB := w.regIdB,
    spkId := w.spkId, kpkId := w.kpkId, opkId := w.opkId, kyberSecB := w.kyberSec, fresh := w.fresh,
    opaqueBytes := gamma keepOpkI0 w.compSem w.compGhost }

/-- Concrete `OpaqueSymbolSemantics` for `KeepOpkCli` under `keepOpkI0`. -/
def keepOpkSem0 : OpaqueSymbolSemantics :=
  compSemOf keepOpkI0 (keepOpkRecordsI0 Symbolic.BugInjection.Synthetic.Witnesses.KeepOpkCli.setup)

/-- Pinned `fits` predicate for `KeepOpkCli` (proof layer). -/
def keepOpkCompFitsPinned (iw : cliCompShape.Interp) (r : ProtocolSetup) : Prop :=
  (SetupMatches Symbolic.BugInjection.Synthetic.Witnesses.KeepOpkCli.setup iw.1 r ∧
    iw.1 = keepOpkI0 ∧
    (secretBytes r 3 = fillFresh 11 64 ∧ secretBytes r 4 = fillFresh 16 64 ∧
      secretBytes r 5 = fillFresh 17 64) ∧
    (r.alice = "alice" ∧ r.bob = "bob") ∧
    X25519TorsionShiftsRejected iw.1 ∧
    TorsionShiftsRecorded iw.1
      Symbolic.BugInjection.Synthetic.Witnesses.KeepOpkCli.setup.torsionShifts) ∧
  ExternContractsHoldCli iw.1 ∧
  HooksMatchInterpretation iw.1 iw.2

end Symbolic.BugInjection.Proofs.SyntheticKeepOpk.DefsI0
