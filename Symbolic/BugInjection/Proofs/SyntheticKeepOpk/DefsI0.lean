  | none => compDefaultPub

/-- Normalize a 32-byte clamped secret `s` to its `Fin 10` table index. -/
def keepOpkSecretIdx (s : HwBytes) : Option (Fin 10) :=
  if s.length == 32 then
    let n := bytesToNat s
    if n == 0x65385b1d0d73750ca8125bca3c7e3bf70682a12a5e17055929b1566240215318 then some ⟨0, by decide⟩
    else if n == 0x5e9c4282ed6763a8c28ebb7233e51d1950937b3041d5d4ac13ac2650f5f8df00 then some ⟨1, by decide⟩
    else if n == 0x6385622579df091d9039fcd19c5dd34f7a2af4f99132c5932ff0a06b4bd52080 then some ⟨2, by decide⟩
    else if n == 0x50d3ac1baf117679884e7a9ba22333d1b3c25ee9f8d35e9b51c966e0e8fe9258 then some ⟨3, by decide⟩
    else if n == 0x5ebeb27d522a4e8b1b9ec6ebbda97281992ffac69a7acd4c118e846ea93bc948 then some ⟨4, by decide⟩
    else if n == 0x66964f30e299608354c3ce2401e61e48206f8f36b8468efae8fb77c019042648 then some ⟨5, by decide⟩
    else if n == 0x5c7f85979eaf14f7fb49936bd882f71348114868c9e6902973986d357f2a7e20 then some ⟨6, by decide⟩
    else if n == 0x53be3b938e1c1bdc84ab9a4b668286edb5e044ad5e685c2894166463ea1f01b0 then some ⟨7, by decide⟩
    else if n == 0x59e9bde5ee77a98509b438f6c638d372edfb75b8af97ef748e856bd4be8d3700 then some ⟨8, by decide⟩
