  else none

/-- Map a 255-bit Montgomery `uCoord` to its `Fin 10` key index. -/
def keepOpkPointIdxOfU (u : Nat) : Option (Fin 10) :=
  if u == 0x3c01432d659f6956d79efdb84cf363bd3effef89cb39f4513184d598b479f75a then some ⟨0, by decide⟩
  else if u == 0x627fac8bff0348b0c032b515e585e882aa28244c58ceadfb6f2c8876f3506df7 then some ⟨1, by decide⟩
  else if u == 0x1814e39f6c4912ea4cff03837272d451a1ac17771cbf3a0572c2e6bc9688b8b6 then some ⟨2, by decide⟩
  else if u == 0x6cba89463eb2e05bebc06390da60875aacb73b851d26c5847df4b32d74a1731a then some ⟨3, by decide⟩
  else if u == 0x4dc349100e5b5e487b92852d337badcba1b1139305b83213f7868f2c4f90bbab then some ⟨4, by decide⟩
  else if u == 0x3fd3bf370a6f0d82bce23a6bc81073a3968030a12fd4407213598fb0a385fc5b then some ⟨5, by decide⟩
  else if u == 0xdf1b9cfdb6f1beecfab864aec3b00d301fabcf8efbdadae64b8f3ce0a70062a then some ⟨6, by decide⟩
  else if u == 0x7fd311467832b27536564251c164a3c9f80a6fe3b54a583faa918c941d72d992 then some ⟨7, by decide⟩
  else if u == 0x249d967dbe713b158c12ae20b7f2ed4ab66cc4b83da3630625a93f7cf10e5923 then some ⟨8, by decide⟩
  else if u == 0x24664af2be8c2dde217b8c737541cf8a8abee378a4a963987cf4ac0d8aef5dad then some ⟨9, by decide⟩
  else none

/-- Normalize a 32-byte public key point `p` to its `Fin 10` index via `uCoord`. -/
def keepOpkPointIdx (p : HwBytes) : Option (Fin 10) :=
  if p.length == 32 then keepOpkPointIdxOfU (uCoord (p.map BitVec.toNat))
  else none

/-- Complete symmetric RFC 7748 X25519 agreement table on `Fin 10 × Fin 10` (all 55 pairs). -/
def keepOpkDhByIdx (i j : Fin 10) : HwBytes :=
  let lo := min i.val j.val
  let hi := max i.val j.val
  if lo == 0 && hi == 0 then leBytes 32 0x2fe753093abbba07396525f99f58cd936d5db206d7bf3223ffddd46f0a69fa53
  else if lo == 0 && hi == 1 then leBytes 32 0x779f82c33f39708c76a962a0dcfc700c91c3057d2fed34477380f3893ecc313e
  else if lo == 0 && hi == 2 then leBytes 32 0x2b1507edf1e8d4f38a3da9d3571b67ea7ee5b0606ab27e0c41dfd01e683e373b
  else if lo == 0 && hi == 3 then leBytes 32 0x59d50ed3b6450881c9acaec9e814041c0d5354ca2b321a73ff86dec678e497c6
