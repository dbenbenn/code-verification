def opOf (id : Nat) : DagOp :=
  (btGet dagDepth opTree id).getD (.lit [])

def bytesOf (id : Nat) : HwBytes :=
  (btGet dagDepth bytesTree id).getD []

def shapeOf (id : Nat) : DY.Bytes :=
  dagShape opOf id

def skipIdOf (mode : Bool) : Nat :=
  if mode then dh44Id else dh55Id

theorem dagAllNodesOk : checkAllDagNodes dagSize opOf bytesOf = true := by
  decide +kernel

theorem dagPairwiseNoCollideM1 : dagPairwiseOkExcept dagSize opOf bytesOf dh55Id = true := by
  decide +kernel

theorem dagPairwiseNoCollideM2 : dagPairwiseOkExcept dagSize opOf bytesOf dh44Id = true := by
  decide +kernel

theorem dagPairwiseNoCollide (mode : Bool) :
    dagPairwiseOkExcept dagSize opOf bytesOf (skipIdOf mode) = true := by
  cases mode
  · exact dagPairwiseNoCollideM1
  · exact dagPairwiseNoCollideM2

