  mlkem768Encaps2Symbol mlkem768DecapsSymbol mlkem768ValidatePkSymbol libcruxHmacSymbol)

/-- Little-endian `Nat` value of a byte string (inverse of `leBytes bs.length` on `bs`). -/
def bytesToNat : HwBytes → Nat
  | [] => 0
  | b :: bs => b.toNat + 256 * bytesToNat bs

/-- The 4-byte byte-symmetric tag `0xd7d7d7d7` (`reverse compTag4 = compTag4`). -/
def compTag4 : HwBytes := [0xd7#8, 0xd7#8, 0xd7#8, 0xd7#8]
def compTag4Ipad : HwBytes := [0xe1#8, 0xe1#8, 0xe1#8, 0xe1#8]
def compTag4Opad : HwBytes := [0x8b#8, 0x8b#8, 0x8b#8, 0x8b#8]

def compShaMix28 (st blk : HwBytes) : HwBytes :=
  List.ofFn fun i : Fin 28 =>
    st.getD (i.val + 4) 0#8 ^^^ blk.getD i.val 0#8 ^^^ blk.getD (i.val + 28) 0#8 ^^^
    (if i.val < 8 then blk.getD (i.val + 56) 0#8 else 0#8)

def compDefaultSha256 (st blk : HwBytes) : HwBytes := compTag4 ++ compShaMix28 st blk

def compHmacMix28 (k d : HwBytes) : HwBytes :=
  List.ofFn fun i : Fin 28 =>
    k.getD i.val 0#8 ^^^
    (if i.val < 4 then k.getD (i.val + 28) 0#8 else 0#8) ^^^
    d.getD i.val 0#8 ^^^
    d.getD (i.val + 28) 0#8 ^^^
    d.getD (i.val + 56) 0#8 ^^^
    d.getD (i.val + 84) 0#8

def compDefaultHmac (k d : HwBytes) : HwBytes :=
  compTag4 ++ compHmacMix28 k d

/-- Default X25519 public key `Pd` (`u = 9`, canonical, not low-order, outside the 6 recorded keys). -/
def compDefaultPub : HwBytes := leBytes 32 9

/-- Default X25519 shared secret `Gd` on off-table non-low-order pairs (32 bytes, nonzero). -/
def compDefaultDh : HwBytes :=
  leBytes 32 0x715a9e3c4b2d8f1065c3a894e21b7d049a6f3c812e5d0b74c91a8e3f526b4cd7

/-- The 6 recorded X25519 public keys indexed by `Fin 6` (`alice`, `bob`, `spk`, `ek`, `dhsA`, `dhsB`). -/
def compPubOfIdx (i : Fin 6) : HwBytes :=
  match i.val with
  | 0 => leBytes 32 0x6f70c3a23cdfd99e2f2fcd891a46c9b60277d75d5b9b32678f590412e87ce654
  | 1 => leBytes 32 0x39db4be71a22438b40690e54576b0595cef2ba17dcb76b9bfdfcbbe5e3f0a46f
  | 2 => leBytes 32 0x37fb2de762f64d0b08d8e5a2c0abbfe09c8485bbe6bf0d7eb2c4fb8e7d6043a9
  | 3 => leBytes 32 0x4191d00ca5dd02c28c8762756784ce34df71893c8f43045b330e89b246e2d794
  | 4 => leBytes 32 0x5f76647da8f9eff37b43185e2b9537442e866cbb05f716eb3c69e9038c94c31d
  | _ => leBytes 32 0x1cd39fadc085052bd43f40d71f98ea8e78c6aff64bac6e587f231e78128fb958

def compPubOfOpt : Option (Fin 6) → HwBytes
  | some idx => compPubOfIdx idx
  | none => compDefaultPub

/-- Normalize a 32-byte secret key `s` (via `clamp s`) to its `Fin 6` table index. -/
def compSecretIdx (s : HwBytes) : Option (Fin 6) :=
  if s.length == 32 then
    let n := bytesToNat (clamp s)
    if n == 0x7286310c6b658471e11ebd4485207c4c5275282cb596c5a906ca4573898e4460 then some ⟨0, by decide⟩
    else if n == 0x6a16a7f00349c4fd8edf07ba9b66f84449c3bff2b555b1ce8bb69a2ede284848 then some ⟨1, by decide⟩
    else if n == 0x4519907308a55597a4de98a907fde84e730967c561fe0e9c99bdea26d9472ac8 then some ⟨2, by decide⟩
    else if n == 0x59bc7510b3d2d6a1804dab877fca3b18417756446631596e8a4c403ab71b6d48 then some ⟨3, by decide⟩
    else if n == 0x6bc4eeb6128b7f6d083f5ab6e2ffd1eaae0b7aeb811e7784d651c787ec1822c8 then some ⟨4, by decide⟩
    else if n == 0x6ed24d47021506af37bdb42f9be02955f166a99eb814489f19354db373c86270 then some ⟨5, by decide⟩
    else none
  else none

/-- Map a 255-bit Montgomery `uCoord` to its `Fin 6` key index. -/
def compPointIdxOfU (u : Nat) : Option (Fin 6) :=
  if u == 0x6f70c3a23cdfd99e2f2fcd891a46c9b60277d75d5b9b32678f590412e87ce654 then some ⟨0, by decide⟩
  else if u == 0x39db4be71a22438b40690e54576b0595cef2ba17dcb76b9bfdfcbbe5e3f0a46f then some ⟨1, by decide⟩
  else if u == 0x37fb2de762f64d0b08d8e5a2c0abbfe09c8485bbe6bf0d7eb2c4fb8e7d6043a9 then some ⟨2, by decide⟩
  else if u == 0x4191d00ca5dd02c28c8762756784ce34df71893c8f43045b330e89b246e2d794 then some ⟨3, by decide⟩
  else if u == 0x5f76647da8f9eff37b43185e2b9537442e866cbb05f716eb3c69e9038c94c31d then some ⟨4, by decide⟩
  else if u == 0x1cd39fadc085052bd43f40d71f98ea8e78c6aff64bac6e587f231e78128fb958 then some ⟨5, by decide⟩
  else none

def compPointIdx (p : HwBytes) : Option (Fin 6) :=
  if p.length == 32 then compPointIdxOfU (uCoord (p.map BitVec.toNat))
  else none

/-- Symmetric DH lookup on `Fin 6 × Fin 6`. -/
def compDhByIdx (i j : Fin 6) : HwBytes :=
  let lo := min i.val j.val
  let hi := max i.val j.val
  if lo == 0 && hi == 2 then leBytes 32 0x2b2ee952b457ae4e334fbaff503af1a961eb061297b2428857ab7eb83a96fd83
  else if lo == 1 && hi == 3 then leBytes 32 0x6f482c6a646e03aa9bc130ec1c50745eb2a2ffe4cf415a334c4eb423fe70b91e
  else if lo == 2 && hi == 3 then leBytes 32 0x567ef9e1c7aa642cebb08b16bbe10702a0bdbb4441c0fd9a571d6669929d0df8
  else if lo == 2 && hi == 4 then leBytes 32 0x6ff6b3267fd8cbed7c2ec48bafaa1d686720e95ab8ac3bfd845dc77ecb16c166
  else if lo == 4 && hi == 5 then leBytes 32 0x39167e3eabeb8958692957a1c4358df08ad692609d9f604d792a0cac42dd6dbd
  else compDefaultDh

def compLookupPub (s : HwBytes) : HwBytes :=
  compPubOfOpt (compSecretIdx s)

def compLookupDh (s p : HwBytes) : HwBytes :=
  if isLowOrderKey (p.map BitVec.toNat) then
    List.replicate 32 0#8
  else
    match compSecretIdx s, compPointIdx p with
    | some i, some j => compDhByIdx i j
    | _, _ => compDefaultDh

def compLookupTorsion (_point : HwBytes) (_b : BitVec 8) : Option HwBytes := none

