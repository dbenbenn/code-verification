def compAesA2 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0xb2b12df966aced85e8980dddf60b9a6e)
def compAesB2 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0x1930f1ff1a4808a728152518cef704c7)
def compAesA3 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0x163ffef0154707a8271a2a17c1f80ba9)
def compAesB3 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0x9f2c2254ffda392774931baccae040a3)
def compAesA4 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0x5935f56d8b59b7a4b67b0ba8f7f3ddef)
def compAesB4 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0xa71d50fd0854ebe96550c97b26b68dd8)
def compAesA5 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0xaa105df00559e6e4685dc4762bcfe1a8)
def compAesB5 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0xa39246265b8ed09def86b4b169bba133)

def compAesBlock (k : CryptoGames.CBC.AesKey) (b : CryptoGames.CBC.Block) : CryptoGames.CBC.Block :=
  if k == CryptoGames.HKDF.bytesToKey32 compAesKA then
    if b == compAesA0 then compAesB0 else if b == compAesB0 then compAesA0
    else if b == compAesA1 then compAesB1 else if b == compAesB1 then compAesA1
    else if b == compAesA2 then compAesB2 else if b == compAesB2 then compAesA2
    else if b == compAesA3 then compAesB3 else if b == compAesB3 then compAesA3
    else b
  else if k == CryptoGames.HKDF.bytesToKey32 compAesKB then
    if b == compAesA4 then compAesB4 else if b == compAesB4 then compAesA4
    else if b == compAesA5 then compAesB5 else if b == compAesB5 then compAesA5
    else b
  else b

def compAesPerm (k iv text : HwBytes) : HwBytes :=
  CryptoGames.LibsignalSession.aesCbcEncrypt compAesBlock
    (CryptoGames.HKDF.bytesToKey32 k) (CryptoGames.CBC.bytesToBlock iv) text

def compAesDec (k iv ct : HwBytes) : Option HwBytes :=
  CryptoGames.LibsignalSession.aesCbcDecrypt compAesBlock
    (CryptoGames.HKDF.bytesToKey32 k) (CryptoGames.CBC.bytesToBlock iv) ct

/-- Recorded Kyber-1024 randomness, ciphertext, and shared secret (`setup_seed = 7003`). -/
def compDefaultKyberCt : HwBytes := List.replicate 1568 0xd7#8
def compDefaultKyberSs : HwBytes := List.replicate 32 0xd7#8

def compKyberE0 : HwBytes := leBytes 32 0x493fc11c53fd9e2aa8539b7c455004296f2598a04dd1863e84edf648f38bf19c
def compKyberCt0 : HwBytes := leBytes 1568 
def compKyberSs0 : HwBytes := leBytes 32 0x59920ad96193931f3d01f1adc28ba6110b3342ded884eb9323999ce16e0e85d8

def compKyberEncaps (e : HwBytes) : HwBytes :=
  if e == compKyberE0 then compKyberCt0 ++ compKyberSs0
  else compDefaultKyberCt ++ compDefaultKyberSs

def compKyberDecaps (ct : HwBytes) : HwBytes :=
  if ct == compKyberCt0 then compKyberSs0
  else compDefaultKyberSs

/-- Recorded Edwards points for Montgomery-to-Edwards conversion and torsion-free checks. -/
def compToEdBob : HwBytes := leBytes 32 0x39db4be71a22438b40690e54576b0595cef2ba17dcb76b9bfdfcbbe5e3f0a46f
def compToEdBob0 : HwBytes := leBytes 160 
def compToEdBob1 : HwBytes := leBytes 160 
def compToEdAlice : HwBytes := leBytes 32 0x6f70c3a23cdfd99e2f2fcd891a46c9b60277d75d5b9b32678f590412e87ce654
def compToEdAlice0 : HwBytes := leBytes 160 
def compToEdEk : HwBytes := leBytes 32 0x4191d00ca5dd02c28c8762756784ce34df71893c8f43045b330e89b246e2d794
def compToEdEk0 : HwBytes := leBytes 160 

def compToEdwards (u : HwBytes) (sign : BitVec 8) : HwBytes :=
  if sign == 0#8 then
    if u == compToEdBob then compToEdBob0
    else if u == compToEdAlice then compToEdAlice0
    else if u == compToEdEk then compToEdEk0
    else List.replicate 160 0#8
  else if sign == 1#8 then
    if u == compToEdBob then compToEdBob1
    else List.replicate 160 0#8
  else List.replicate 160 0#8

def compTorsionFree (pt : HwBytes) : HwBytes :=
  if pt == compToEdBob0 || pt == compToEdBob1 || pt == compToEdAlice0 || pt == compToEdEk0 then
    [1#8]
  else [0#8]

