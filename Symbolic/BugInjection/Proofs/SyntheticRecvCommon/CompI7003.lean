def compAesA0 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0xb3b92cfe2ebab284ecdc18defb0f8c79)
def compAesB0 : CryptoGames.CBC.Block := CryptoGames.CBC.bytesToBlock (leBytes 16 0x9821af6a2bcc1e7cd2594e9fba553a03)
