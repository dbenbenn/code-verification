    rw [sim_liftFS_deliver_some_run C ℓ encT idOf false sIdx h e1 e2 p hpub hM tblM hstep]
    have hwp : (some (.accepted idxOut (some pmOut.2)) : Option (ReceiveResult (Plain ℓ))).map
        (withPub p) = some (.accepted idxOut (some pmOut)) := by
      rcases pmOut with ⟨pm1, pm2⟩
