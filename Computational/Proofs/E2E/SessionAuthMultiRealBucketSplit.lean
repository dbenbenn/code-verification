        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esL none tblL) := by
  rcases qr with ((((⟨P, m, r₀⟩ | ⟨P, m₀, m₁, r₀⟩) | ⟨P, c⟩) | ⟨P, c⟩) | P) | ⟨P, c, c'⟩
  · have hshort : m.1.shortB = true :=
      Computational.Proofs.ReductionDsl.Fig8Atomic.atomicShortPubB_imp_shortB
        (by simpa [badSendMsgDF] using hbad)
    exact step1_transmit mode C Dh encPt encT idOf ℓ q qep rem hℓ tL par ks P m r₀ hshort r hIH1 hIH2
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step1_chall mode C Dh encPt encT idOf ℓ q qep rem tL par ks P m₀ m₁ r₀ r hIH1
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step1_deliver mode C Dh hD encPt encT hinj hdum idOf ℓ q qep rem hℓ hq_pos tL par ks P c r hIH1 hIH2 hq_r
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step1_inject mode C Dh hD encPt encT hinj hdum idOf ℓ q qep rem hℓ hq_pos tL par ks P c r hIH1 hIH2 hq_r
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step1_corr mode C Dh encPt encT idOf ℓ q qep rem tL par ks P r hIH1 hIH2
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step1_deliverForge mode C Dh hD encPt encT hinj hdum idOf ℓ q qep rem hℓ hq_pos tL par ks P c c' r hIH1 hIH2 hq_r
      ssLoc rsLoc esLoc esM esL tblM tblL hinv

private theorem localSlotBucketOptAt_perKey_coupling
    {ℓ : ℕ} {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey)
    (hinj : Function.Injective encT) (hdum : ∀ T, encT T ≠ dummyKey)
    (idOf : Party → IdentityKey) (lam : Pt) (hℓ : ℓ < 10 ^ 6)
    (q qep : ℕ) (hq_pos : 0 < q) (tL : Option ℕ) (par : Bool)
    (ks : ℕ → BitVec 256) (bs : ℕ → Bool)
    (A : AdversaryDF (Fig8St Pt) (LibsignalMsgPublicPart × Plain ℓ) (BitVec 256) (Fig8C Pt))
    (hq : MakesAtMostQueriesDF A q)
    (hsh : w7SendMsgsOkDF (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) A) :
    let M_sess := ((qep + 2) - healEpoch tL) * q
    let tbl0 : ℕ → SessHSt Pt ℓ := fun i => hInit (bs i) (.seed (ks i))
    LeAdd
      (localSlotBucketOptAt mode q M_sess ks (dhScheme Dh) (rootPRNG C.F encPt)
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam qep tL par A)
      (Prod.fst <$> (simulateQ (pubFsImplOpt C ℓ encT idOf false)
        (redFSAuthDFPaperMultiBucketOpt mode (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
          (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 1 4 qep false tL par A)).run
        (fun _ => false, tbl0))
      (Prod.fst <$> (simulateQ (pubFsImplOpt C ℓ encT idOf true)
        (redFSAuthDFPaperMultiBucketOpt mode (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
          (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 1 4 qep true tL par A)).run
        (fun _ => false, tbl0)) := by
  exact init_coupled_leAdd mode C Dh encPt encT idOf lam ℓ q qep hq_pos tL par ks bs A
    (fun ssLoc rsLoc esLoc esM esL tblM tblL hinv =>
      phase1_opt_leAdd mode C Dh encPt encT idOf ℓ q qep tL par ks
        (fun oa rem hq_oa hsh_oa =>
          phase2_opt_leOne mode C Dh encPt encT idOf ℓ q qep tL par ks
            (step2_dispatch mode C Dh hD encPt encT hinj hdum idOf ℓ q qep hℓ hq_pos tL par ks)
            oa rem hq_oa hsh_oa)
        (step1_dispatch mode C Dh hD encPt encT hinj hdum idOf ℓ q qep hℓ hq_pos tL par ks)
        A q hq hsh ssLoc rsLoc esLoc esM esL tblM tblL hinv)

end PerKeyCoupling

