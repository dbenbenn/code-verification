  rcases qr with ((((⟨P, m, r⟩ | ⟨P, m₀, m₁, r⟩) | ⟨P, c⟩) | ⟨P, c⟩) | P) | ⟨P, c, c'⟩
  · simp only [implEDFPaperBucketRaw, transmitEBucket, QueryImpl.add_apply_inr,
      QueryImpl.add_apply_inl, dfHaltedRet, StateT.run_bind, StateT.run_get, pure_bind,
      hhalt, ↓reduceIte, StateT.run_pure]
  · simp only [implEDFPaperBucketRaw, challEBucket, QueryImpl.add_apply_inr,
      QueryImpl.add_apply_inl, dfHaltedRet, StateT.run_pure]
  · simp only [implEDFPaperBucketRaw, deliverE, QueryImpl.add_apply_inr,
      QueryImpl.add_apply_inl, dfHaltedRet, StateT.run_bind, StateT.run_get, pure_bind,
      hhalt, ↓reduceIte, StateT.run_pure]
  · simp only [implEDFPaperBucketRaw, injectE, QueryImpl.add_apply_inr,
      QueryImpl.add_apply_inl, dfHaltedRet, StateT.run_bind, StateT.run_get, pure_bind,
