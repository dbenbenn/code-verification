private theorem step1_inject_aux_afterS1_inl {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt) {α : Type}
    (r : Option (RecvResult (LibsignalMsgPublicPart × Plain ℓ)) →
      OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH1 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeAdd
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM')
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true (r u) esL' none tblL'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL)
    (hsends_f : P.sendsIn c.1.1 = false)
    (ht_le : c.1.1 ≤ esLoc.g.epoch P + 1)
    (γ' : CryptoGames.CKA.DDH.State (BitVec 256) Pt) (σ' : BitVec 256)
    (rs : RatchetReceiverState (BitVec 256) (BitVec 256)) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inr ⟨P, c⟩))
    let s₁Loc : LocVP Pt :=
      { esLoc.g.st P with
        tcur := max (esLoc.g.epoch P) c.1.1, γ := γ', root := σ',
        vR := Function.update (esLoc.g.st P).vR c.1.1 (some rs) }
    let s₁M : MultiVP Pt :=
      { esM.g.st P with
        tcur := max (esLoc.g.epoch P) c.1.1, γ := γ', root := σ',
        vR := Function.update (esM.g.st P).vR c.1.1 (some (.inl rs)) }
    LeAdd
      (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
        ((step1_inject_aux_afterS1 (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
          qep maxForwardJumps (bucketAuthCfg 1 tL par) P c s₁Loc).run esLoc) >>= fun p =>
        runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r p.1) p.2
          (calcWinEp (mode != some false) (isHonestHdrSlotBucket esLoc.h)
            (fun P => (esLoc.g.st P).tcur) qr p.2.g.win))
      (((simulateQ (pubFsImplOpt C ℓ encT idOf false)
        ((step1_inject_aux_afterS1 (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
          qep maxForwardJumps (bucketAuthCfg 1 tL par) P c s₁M).run esM)).run (fun _ => false, tblM)) >>=
        fun p =>
          Prod.fst <$> (simulateQ (pubFsImplOpt C ℓ encT idOf false) do
            let (_, es', we) ← (simulateQ (implEDFPaperBucketMode
              (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
              3 qep maxForwardJumps (bucketAuthCfg 1 tL par) (mode != some false)
              isHonestHdrFSMultiDFBucket) (r p.1.1)).run
              (p.1.2, calcWinEp (mode != some false) (isHonestHdrFSMultiDFBucket esM.h)
                (fun P => (esM.g.st P).tcur) qr p.1.2.g.win)
            return if false then es'.h.lfWin else authOutBucket 3 tL (es', we)).run p.2)
      (((simulateQ (pubFsImplOpt C ℓ encT idOf true)
        ((step1_inject_aux_afterS1 (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par true)
          qep maxForwardJumps (bucketAuthCfg 1 tL par) P c s₁M).run esM)).run (fun _ => false, tblL)) >>=
        fun p =>
          Prod.fst <$> (simulateQ (pubFsImplOpt C ℓ encT idOf true) do
            let (_, es', we) ← (simulateQ (implEDFPaperBucketMode
              (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par true)
              3 qep maxForwardJumps (bucketAuthCfg 1 tL par) (mode != some false)
              isHonestHdrFSMultiDFBucket) (r p.1.1)).run
              (p.1.2, calcWinEp (mode != some false) (isHonestHdrFSMultiDFBucket esM.h)
                (fun P => (esM.g.st P).tcur) qr p.1.2.g.win)
            return if true then es'.h.lfWin else authOutBucket 3 tL (es', we)).run p.2) := by
  intro qr s₁Loc s₁M
  have hvRLoc : s₁Loc.vR c.1.1 = some rs := by simp [s₁Loc]
  have hvRM : s₁M.vR c.1.1 = some (.inl rs) := by simp [s₁M]
  have hstLoc_upd (rs' : RatchetReceiverState (BitVec 256) (BitVec 256)) :
      { s₁Loc with vR := Function.update s₁Loc.vR c.1.1 (some rs') } =
      { esLoc.g.st P with
        tcur := max (esLoc.g.epoch P) c.1.1, γ := γ', root := σ',
        vR := Function.update (esLoc.g.st P).vR c.1.1 (some rs') } := by
    dsimp only [s₁Loc]
    congr 1
    funext τ
