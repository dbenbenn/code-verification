                let stM' : MultiVP Pt := { s₁M with vR := Function.update s₁M.vR t0 (some (.inr sIdx)) }
                have hvL : (vRecv (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                    esLoc.g P (esLoc.g.st P) c' none).run esLoc.h =
                    pure (some (some (stLoc', t0, idxOut, pmOut)), esLoc.h) := by
                  rw [hvL_red]
                  dsimp only [hkLocOpt, hooksSlotBucketOptAt]
                  dsimp only [fs, sIdx] at hrec
                  simp [StateT.run_pure, hrec, stLoc', step2_deliverForge_aux_vRecvPost]
                have hfs_some : ∃ bk' sM' sL',
                    (simulateQ (pubFsImplOpt C ℓ encT idOf false)
                      (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
                        esM.g P t0 (.inr sIdx) c'.1 c'.2 none).run esM.h)).run (fun _ => false, tblM) =
                      pure ((some (some (.inr sIdx, idxOut, pmOut)),
                        { esM.h with book := Function.update esM.h.book sIdx (some bk') }),
                        (fun _ => false, Function.update tblM sIdx sM')) ∧
                    ActiveSessInv C ℓ encT idOf (!bk'.sCorr) (ks sIdx)
                      (ssLoc sIdx) rs' bk' sM' sL' := by
                  cases hmatch : ((esM.h.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (c'.1, c'.2)) with
                  | some mEntry =>
                    have hm_res := step2_deliverForge_aux_fsRecv_inr_matched mode C Dh hD encPt encT idOf
                      ℓ q qep hℓ tL par esM.g P t0 sIdx c'.1 c'.2 ks ssLoc rsLoc esM.h tblM tblL
                      hmatch (hinv.sess_inv sIdx)
                    dsimp only at hm_res
                    dsimp only [fs] at hrec
                    rw [hrec] at hm_res
                    rcases hm_res with ⟨sM', sL', hfsM, hsess'⟩
                    exact ⟨_, sM', sL', hfsM, hsess'⟩
                  | none =>
                    cases hscorr : ((esM.h.book sIdx).getD {}).sCorr with
                    | true =>
                      have hsess0 : ActiveSessInv C ℓ encT idOf false (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
                          ((esM.h.book sIdx).getD {}) (tblM sIdx) (tblL sIdx) := by
                        simpa [hscorr] using hinv.sess_inv sIdx
                      have hsc := step2_deliverForge_aux_fsRecv_inr_scorr mode C Dh encPt encT idOf
                        ℓ q qep tL par esM.g P t0 sIdx c'.1 c'.2 ks ssLoc rsLoc esM.h tblM tblL
                        hmatch hscorr hsess0
                      dsimp only at hsc
                      dsimp only [fs] at hrec
                      rw [hrec] at hsc
                      rcases hsc with ⟨sM', hfsM, hsess'⟩
                      exact ⟨_, sM', tblL sIdx, hfsM, by simpa [hscorr] using hsess'⟩
                    | false =>
                      have hsess0 : ActiveSessInv C ℓ encT idOf true (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
                          ((esM.h.book sIdx).getD {}) (tblM sIdx) (tblL sIdx) := by
                        simpa [hscorr] using hinv.sess_inv sIdx
                      have hco := step2_deliverForge_aux_fsRecv_inr_corrupt mode C Dh encPt encT idOf
                        ℓ q qep tL par esM.g P t0 sIdx c'.1 c'.2 ks ssLoc rsLoc esM.h tblM tblL
                        hmatch hunhealedM hscorr hsess0
                      dsimp only at hco
                      dsimp only [fs] at hrec
                      rw [hrec] at hco
                      rcases hco with ⟨sM', hfsM, hsess'⟩
                      exact ⟨_, sM', tblL sIdx, hfsM, hsess'⟩
                rcases hfs_some with ⟨bk', sM', sL', hfsM, hsess'⟩
                let hM' : MultiHS Pt := { esM.h with book := Function.update esM.h.book sIdx (some bk') }
                let tblM' := Function.update tblM sIdx sM'
                let tblL' := Function.update tblL sIdx sL'
                have hvM : (simulateQ (pubFsImplOpt C ℓ encT idOf false)
                    ((vRecv (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
                      esM.g P (esM.g.st P) c' none).run esM.h)).run (fun _ => false, tblM) =
                    pure ((some (some (stM', t0, idxOut, pmOut)), hM'), (fun _ => false, tblM')) := by
                  rw [hvM_red, simulateQ_bind, StateT.run_bind]
                  dsimp only [sIdx] at hfsM
                  rw [hfsM]
                  simp [StateT.run_pure, simulateQ_pure, step2_deliverForge_aux_vRecvPost, stM', hM', tblM', sIdx, t0]
                have hpostL := step2_deliverForge_aux_post_loc mode C Dh encPt encT idOf ℓ q qep tL par ks
                  esLoc P c c' rec0 (some (stLoc', t0, idxOut, pmOut)) habL hwL hit hg_re hvL
                have hpostM := step2_deliverForge_aux_post_fsm mode C Dh encPt encT idOf ℓ q qep tL par
                  esM P c c' rec0 (some (stM', t0, idxOut, pmOut)) hM' tblM tblM' habM hwM hitM hgM hvM
                dsimp only at hpostL hpostM
                have htriv_eq : esM.g.trivial 3 ⟨P.other, t0, idxOut⟩ =
                    esLoc.g.trivial 3 ⟨P.other, t0, idxOut⟩ :=
                  (hinv.gsync.trivial_eq 3 ⟨P.other, t0, idxOut⟩).symm
                rw [htriv_eq] at hpostM
                simp only [hcap_false, hinj_true, Bool.false_eq_true, ↓reduceIte] at hpostL hpostM
                cases htriv : esLoc.g.trivial 3 ⟨P.other, t0, idxOut⟩
                · simp only [htriv, Bool.false_eq_true, ↓reduceIte] at hpostL hpostM
                  rw [runLocCont_inr_of_step mode C Dh encPt encT idOf ℓ q qep tL par ks qr r
                        esLoc _ (some .rejected) hwL hpostL,
                      runMultiCont_inr_of_step mode C Dh encPt encT idOf ℓ q qep tL par false qr r
                        esM _ tblM tblM' (some .rejected) hwM hpostM]
                  dsimp only
                  rw [hwe_win_eq]
                  exact exit_halted_leOne mode C Dh encPt encT idOf ℓ q qep tL par ks
                    (r (some .rejected))
                    { esLoc with g := { esLoc.g with win := true } }
                    { esM with g := { esM.g with win := true }, h := hM' }
                    _ tblM' (by simp) (habM.trans habL.symm) rfl
                    hinv.gsync.leaks_eq.symm hinv.gsync.corrs_eq.symm
                · simp only [htriv, ↓reduceIte] at hpostL hpostM
                  have hinv' := step2_deliverForge_aux_accept_inv
                    (stLoc' := stLoc') (stM' := stM') (idxOut := idxOut)
                    (tblM' := tblM') (tblL' := tblL')
                    hq_pos hinv hP_recv
                    ht0_le_succ ht0_le_other hhealed hs1_id hs1_tcur hs1_γ hs1_root hs1_cka hs1_vS
                    (fun τ hτ => ⟨(Function.update_of_ne hτ _ _).trans (hs1_vR_ne τ hτ).1,
                                  (Function.update_of_ne hτ _ _).trans (hs1_vR_ne τ hτ).2⟩)
                    (Or.inr ⟨j, rs', bk', hcap, hbk, hnot_tH, hj_len, rfl, rfl,
                      Function.update_self _ _ _, Function.update_self _ _ _,
                      by simpa [tblM', tblL', sIdx, Function.update_self] using hsess',
                      fun i hi => ⟨Function.update_of_ne hi _ _, Function.update_of_ne hi _ _⟩⟩)
                  exact step_nonwin (some (.accepted t0 idxOut (some pmOut)))
                    ssLoc (Function.update rsLoc sIdx rs')
                    { esLoc with g := esLoc.g.accept P stLoc' ⟨P.other, t0, idxOut⟩ }
                    { esM with g := esM.g.accept P stM' ⟨P.other, t0, idxOut⟩, h := hM' }
                    esL tblM' tblL'
                    hwL hwM hpostL hpostM hinv'

private theorem step1_deliver_aux_inTransit_props {Pt : Type} [DecidableEq Pt] {ℓ : ℕ}
    {esLoc : LocES Pt ℓ} {esM : MultiES Pt ℓ}
    (hgs : GSync esLoc.g esM.g)
    (htr : ∀ r ∈ esLoc.g.trans,
      r.ct.1.1 = r.pos.epoch ∧ r.pos.sender = Party.senderOf r.pos.epoch ∧
      r.pos.epoch ≤ esLoc.g.epoch r.pos.sender ∧
      (r.pos.epoch = 0 → r.ct.1 = (0, none)) ∧
      (1 ≤ r.pos.epoch → ∃ Tc, r.ct.1 = (r.pos.epoch, some Tc) ∧
        ∃ σc kMulti optIdx, esM.h.cache r.pos.epoch = some (Tc, σc, kMulti, optIdx)))
    {P : Party} {c : Fig8C Pt} {r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    (hinT : esLoc.g.inTransit P.other c = some r0) :
    esM.g.inTransit P.other c = some r0 ∧
    r0 ∈ esLoc.g.trans ∧ r0.pos.sender = P.other ∧ r0.ct = c ∧
    r0.pos.epoch = c.1.1 ∧ P.other = Party.senderOf c.1.1 ∧
    P = Party.receiverOf c.1.1 ∧ P.sendsIn c.1.1 = false ∧
    c.1.1 ≤ esLoc.g.epoch (Party.senderOf c.1.1) ∧
    (1 ≤ c.1.1 → ∃ Tc, c.1 = (c.1.1, some Tc) ∧
      ∃ σc kMulti optIdx, esM.h.cache c.1.1 = some (Tc, σc, kMulti, optIdx)) := by
  have hinM : esM.g.inTransit P.other c = some r0 := by
    unfold GameState.inTransit at hinT ⊢
    rw [← hgs.trans_eq]; exact hinT
  have hmem : r0 ∈ esLoc.g.trans := List.mem_of_find?_eq_some hinT
  have hpred := List.find?_some hinT
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hpred
  obtain ⟨hsend, hct⟩ := hpred
  obtain ⟨hep_ct, hsend_of, hle_send, _, hpos1⟩ := htr r0 hmem
  have hep : r0.pos.epoch = c.1.1 := by rw [← hep_ct, hct]
  have hP_other : P.other = Party.senderOf c.1.1 := by rw [← hsend, hsend_of, hep]
  have hP : P = Party.receiverOf c.1.1 := by
    unfold Party.receiverOf
    rw [← hP_other]
    cases P <;> rfl
  have hns : P.sendsIn c.1.1 = false := (not_sendsIn_iff_receiverOf P c.1.1).mpr hP
  have hle_c : c.1.1 ≤ esLoc.g.epoch (Party.senderOf c.1.1) := by
    rw [← hep, ← hsend_of]; exact hle_send
  refine ⟨hinM, hmem, hsend, hct, hep, hP_other, hP, hns, hle_c, fun h1 => ?_⟩
  obtain ⟨Tc, hct1, σc, kMulti, optIdx, hcache⟩ := hpos1 (by omega)
  rw [hct, hep] at hct1
  rw [hep] at hcache
  exact ⟨Tc, hct1, σc, kMulti, optIdx, hcache⟩

