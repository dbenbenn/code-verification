private theorem df_cLoc_zero_of_receiver_corr
    {Γ CCoins T Sig SS RS M E HSLoc : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hkLoc : _root_.CryptoGames.SM.Engine.Hooks _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
      HSLoc Γ T Sig SS RS M E CCoins Γ Sig SS RS)
    (hcommit : ∀ s₁ P old new, hkLoc.commit s₁ P old new = pure (some new))
    (qep maxSkip : ℕ) (gMain : Bool) (tL : Option ℕ) (par : Bool)
    (isHonestLoc : HSLoc → Header T → Bool)
    {t0 ep_bad : ℕ}
    (ht0 : inStage2BucketGen 4 tL par t0 = true)
    (hlt : ltOpt tL ep_bad = true)
    {α : Type}
    (oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)) α)
    (esLoc : EState (VP Γ T Sig SS RS) M (Header T × E) HSLoc) (winEp : Option ℕ)
    (hmem : (Party.receiverOf t0, ep_bad) ∈ esLoc.g.corrs)
    (hwe : ∀ tWin, winEp = some tWin → inStage2Bucket 1 tL par tWin = true) :
    𝒟[simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl do
        let (_, es, we) ← (simulateQ (implEDFPaperBucketMode
          hkLoc 3 qep maxSkip (bucketAuthCfg 1 tL par) gMain isHonestLoc) oa).run (esLoc, winEp)
        return authOutBucket 3 tL (es, we)] {true} = 0 := by
  apply evalDist_bool_eq_zero_of_true_not_mem
  induction oa using OracleComp.inductionOn generalizing esLoc winEp with
  | pure _ =>
    intro hsup
    simp only [simulateQ_pure, StateT.run_pure, pure_bind, support_pure,
      Set.mem_singleton_iff] at hsup
    cases winEp with
    | none => simp [authOutBucket] at hsup
    | some tWin =>
      have hw := hwe tWin rfl
      have hpar : Party.senderOf tWin = Party.senderOf t0 := by
        simp only [inStage2BucketGen, inStage2Bucket, Bool.and_eq_true, beq_iff_eq] at ht0 hw
        cases hs1 : Party.senderOf tWin <;> cases hs0 : Party.senderOf t0 <;> simp_all [partyPar]
      have hrec : Party.receiverOf tWin = Party.receiverOf t0 := by
        unfold Party.receiverOf; rw [hpar]
      have hall_false :
          esLoc.g.corrs.all (fun pe => !(pe.1 == Party.receiverOf tWin && ltOpt tL pe.2)) = false := by
        rw [List.all_eq_false]
        exact ⟨(Party.receiverOf t0, ep_bad), hmem, by simp [hrec, hlt]⟩
      simp only [authOutBucket, _root_.CryptoGames.SM.Engine.authOut,
        authLosingConditionsAvoided, hall_false, Bool.and_false] at hsup
      exact Bool.false_ne_true hsup.symm
  | query_bind q k ih =>
    intro hsup
    rw [simulateQ_query_bind] at hsup
    dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift] at hsup
    rw [StateT.run_bind, bind_assoc, simulateQ_bind, mem_support_bind_iff] at hsup
    rcases hsup with ⟨⟨out, es1, we1⟩, hstep, hu⟩
    cases gMain
    · simp only [implEDFPaperBucketMode, withWinEpDFMode, Bool.false_eq_true, ↓reduceIte,
        StateT.run_mk, simulateQ_bind, simulateQ_pure, mem_support_bind_iff, support_pure,
        Set.mem_singleton_iff] at hstep
      rcases hstep with ⟨⟨out', es'⟩, hraw, hEq⟩
      rcases Prod.mk.inj hEq with ⟨rfl, hEq2⟩
      rcases Prod.mk.inj hEq2 with ⟨rfl, hwe_eq⟩
      obtain ⟨hcorrs_sub, hwin_step⟩ :=
        implEDFPaperBucketRaw_step_corrs_and_win hkLoc hcommit qep maxSkip tL par q esLoc es1 out hraw
      have hwe1 : ∀ tWin, we1 = some tWin → inStage2Bucket 1 tL par tWin = true := by
        by_cases hnw : (!esLoc.g.win && es1.g.win) = true
        · simp only [hnw, ↓reduceIte] at hwe_eq
          obtain ⟨hnotw, hw'⟩ := (Bool.and_eq_true _ _).mp hnw
          have hnotw' : esLoc.g.win = false := by simpa using hnotw
          obtain ⟨tNew, htNew, hbkNew⟩ := (hwin_step hw').resolve_left (by simp [hnotw'])
          rcases q with n | ((((q1 | q2) | q3) | ⟨P, c⟩) | q5) | q6
          · rw [hwe_eq]; exact hwe
          · rw [hwe_eq]; exact hwe
          · rw [hwe_eq]; exact hwe
          · rw [hwe_eq]; exact hwe
          · simp only [_root_.CryptoGames.SM.Construction.DeliverForge.dfQueryTargetEpoch,
              Option.some.injEq] at htNew
            subst htNew
            by_cases hfg : (decide (c.1.1 = (esLoc.g.st P).tcur + 1) && !isHonestLoc esLoc.h c.1) = true
            · simp only [hfg, ↓reduceIte] at hwe_eq
              rw [hwe_eq]; intro tWin ht; injection ht with htw; subst htw; exact hbkNew
            · simp only [hfg, Bool.false_eq_true, ↓reduceIte] at hwe_eq
              rw [hwe_eq]; exact hwe
          · rw [hwe_eq]; exact hwe
          · rw [hwe_eq]; exact hwe
        · simp only [hnw, Bool.false_eq_true, ↓reduceIte] at hwe_eq
          rw [hwe_eq]; exact hwe
      exact ih out es1 we1 (hcorrs_sub _ hmem) hwe1 hu
    · simp only [implEDFPaperBucketMode, withWinEpDFMode, ↓reduceIte, withWinEpDF,
        StateT.run_mk, simulateQ_bind, simulateQ_pure, mem_support_bind_iff, support_pure,
        Set.mem_singleton_iff] at hstep
      rcases hstep with ⟨⟨out', es'⟩, hraw, hEq⟩
      rcases Prod.mk.inj hEq with ⟨rfl, hEq2⟩
      rcases Prod.mk.inj hEq2 with ⟨rfl, hwe_eq⟩
      obtain ⟨hcorrs_sub, hwin_step⟩ :=
        implEDFPaperBucketRaw_step_corrs_and_win hkLoc hcommit qep maxSkip tL par q esLoc es1 out hraw
      have hwe1 : ∀ tWin, we1 = some tWin → inStage2Bucket 1 tL par tWin = true := by
        by_cases hnw : (!esLoc.g.win && es1.g.win) = true
        · simp only [hnw, ↓reduceIte] at hwe_eq
          obtain ⟨hnotw, hw'⟩ := (Bool.and_eq_true _ _).mp hnw
          have hnotw' : esLoc.g.win = false := by simpa using hnotw
          obtain ⟨tNew, htNew, hbkNew⟩ := (hwin_step hw').resolve_left (by simp [hnotw'])
          rw [hwe_eq, htNew]
          intro tWin ht; injection ht with htw; subst htw; exact hbkNew
        · simp only [hnw, Bool.false_eq_true, ↓reduceIte] at hwe_eq
          rw [hwe_eq]; exact hwe
      exact ih out es1 we1 (hcorrs_sub _ hmem) hwe1 hu


private theorem hrt_and_len_check (ℓ : ℕ) (hℓ : ℓ < 10 ^ 6) :
    SignalRoundTripShort protoSignalCodec ∧ ℓ + 16 < rustLenBound :=
  ⟨signalRoundTripShort_proto, by unfold rustLenBound; omega⟩

private theorem ct_instBEq_eq (c1 c2 : ℕ × LibsignalCiphertextWithSalt32) :
    @BEq.beq _ (@instBEqProd ℕ LibsignalCiphertextWithSalt32
      instBEqOfDecidableEq instBEqOfDecidableEq) c1 c2 =
    @BEq.beq _ instBEqOfDecidableEq c1 c2 := by
  rcases c1 with ⟨n1, x1⟩; rcases c2 with ⟨n2, x2⟩; simp [BEq.beq, Prod.mk.injEq]

private theorem activeSessInv_inject_receive_none {Pt : Type} [DecidableEq Pt]
    (C : Crypto) (ℓ : ℕ) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    {k : BitVec 256} {ssLoc : RatchetSenderState (BitVec 256)}
    {rsLoc : RatchetReceiverState (BitVec 256) (BitVec 256)}
    {bk : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32)} {sM sL : SessHSt Pt ℓ}
    (hinv : ActiveSessInv C ℓ encT idOf true k ssLoc rsLoc bk sM sL)
    (h : Header Pt) (e : ℕ × LibsignalCiphertextWithSalt32)
    (hmatch_none : bk.fsTrans.find? (fun x => x.2 == (h, e)) = none)
    (p : LibsignalMsgPublicPart) (hpub : lPubOf protoSignalCodec e.2 = some p)
    (hrecv_none : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rsLoc h e = none) :
    ∃ sM' sL',
      (injectH (lAeadR C protoSignalCodec ℓ encT idOf) (lChainPRG C.F) maxForwardJumps
        (hp 0 0 false) (DG (lChainPRG C.F)) (none : Option (SpecialOps _ _ _ ProbComp))
        ((h, p), e)).run sM = pure (some .rejected, sM') ∧
      ActiveSessInv C ℓ encT idOf true k ssLoc rsLoc bk sM' sL' := by
  let ae := lAeadR C protoSignalCodec ℓ encT idOf; let G := lChainPRG C.F
  have hiff := activeSessInv_matched_iff C ℓ encT idOf hinv h e
  rcases hinv with ⟨stR, hinv⟩; have hsyncL := hinv.syncRML rfl
  rw [hmatch_none, hpub] at hiff; dsimp only at hiff
  have hfind_none : sM.1.inTransit.find? (fun r =>
      @BEq.beq _ instBEqOfDecidableEq r.ad (h, p) &&
      @BEq.beq _ instBEqOfDecidableEq r.ct e) = none := by
    cases hf : sM.1.inTransit.find? _ with | none => rfl | some _ => rw [hf] at hiff; cases hiff
  have hany_impl : (sM.1.inTransit.any fun r =>
      @BEq.beq _ instBEqOfDecidableEq r.ad (h, p) &&
      @BEq.beq _ instBEqOfDecidableEq r.ct e) = false :=
    List.any_eq_false.mpr (List.find?_eq_none.mp hfind_none)
  have hany_false : (sM.1.inTransit.any fun r =>
      @BEq.beq _ instBEqOfDecidableEq r.ad (h, p) &&
      @BEq.beq _ (@instBEqProd ℕ LibsignalCiphertextWithSalt32 instBEqOfDecidableEq instBEqOfDecidableEq)
        r.ct (e.1, e.2)) = false := by simp only [ct_instBEq_eq]; exact hany_impl
  have hbk_uncorr : bk.sCorr = false := by rw [hinv.bk_corr, hsyncL.uncorr]; rfl
  have hstR_mk : stR = mkRState G k sM.1 := hinv.syncRM.stR_eq
  have hrecv_lFS : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rsLoc h e =
      ((fromAEADPRG ae G maxForwardJumps).receive stR.receiverState (h, p) e).map
        (fun o => (o.1, o.2.1, (p, o.2.2))) := by rw [hinv.rs_eq, lFS_receive_eq, hpub]
  have hrec_none : (fromAEADPRG ae G maxForwardJumps).receive stR.receiverState (h, p) e = none := by
    rw [hrecv_lFS] at hrecv_none; exact Option.map_eq_none_iff.mp hrecv_none
  by_cases hlook_case : e.1 ∉ sM.1.skipped ∧
      ¬ (e.1 ≤ sM.1.receiverIdx ∨ maxForwardJumps < e.1 - sM.1.receiverIdx - 1) ∧
      sM.1.lastSentIdx < e.1
  · rcases hlook_case with ⟨hcont, hout, hlt⟩
    have hdec : ae.dec (keyAt G k (e.1 - 1)) (e.1, (h, p)) e.2 = none := by
      have hr := hrec_none
      rw [hstR_mk] at hr
      erw [CryptoGames.FSAEAD.Thm5.Ends.receive_real_of_in_window ae G maxForwardJumps k
        sM.1.receiverIdx sM.1.skipped (h, p) e.1 e.2 hcont hout] at hr
      cases hd : ae.dec (keyAt G k (e.1 - 1)) (e.1, (h, p)) e.2 with
      | none => rfl
      | some msg => simp [hd] at hr
    rcases CryptoGames.FSAEAD.Thm5.Ends.inject_syncRML_of_lookahead_none ae G maxForwardJumps
      hsyncL (h, p) e.1 e.2 hinv.not_ended hany_false hcont hout hlt hdec with
      ⟨u, stR', sM', sL', hR, hM, _, hsyncL'⟩
    have hok' := inTransitOk_of_injectH_lookahead_none ae G maxForwardJumps (h, p) e.1 e.2
      hinv.ok_inTransit hinv.not_ended hany_false hcont hout hlt hsyncL.uncorr hM
    have hstR'_mk := hsyncL'.syncRM.stR_eq
    have hR_unf := hR; rw [hstR_mk] at hR_unf
    simp only [injectImpl, CryptoGames.FSAEAD.Thm5.Ends.modifyGet_run, CryptoGames.FSAEAD.inject,
      mkRState, hinv.not_ended, hany_impl, Bool.or_self, Bool.false_eq_true, ↓reduceIte] at hR_unf
    have hrec_mk : (fromAEADPRG ae G maxForwardJumps).receive
        (mkRState G k sM.1).receiverState (h, p) e = none := by rw [← hstR_mk]; exact hrec_none
    dsimp only [ae, G, mkRState] at hrec_mk hR_unf; rw [hrec_mk] at hR_unf; dsimp only at hR_unf
    rcases Prod.mk.inj (pure_eq_iff.mp hR_unf) with ⟨hu, hstR'⟩; subst hu; symm at hstR'
    have hinT' : sM'.1.inTransit = sM.1.inTransit := by
      have h1 : stR'.inTransit = sM'.1.inTransit := by rw [hstR'_mk]; rfl
      rw [← h1, hstR']
    refine ⟨sM', sL', hM,
      ⟨stR', hsyncL'.syncRM, fun _ => hsyncL', by rw [hinv.ss_eq, hstR', hstR_mk]; rfl,
        by rw [hinv.rs_eq, hstR', hstR_mk]; rfl, hsyncL'.not_ended, ?_, hok',
        by rw [hinT']; exact hinv.pub_inTransit, ?_, by rw [hbk_uncorr, hsyncL'.uncorr]; rfl,
        by rw [hinv.bk_trans, hinT']⟩⟩
    · have h1 : stR'.challengesInTransit = sM'.1.challengesInTransit := by rw [hstR'_mk]; rfl
      rw [← h1, hstR']; exact hinv.chal_nil
    · have h1 : stR'.lastSentIdx = sM'.1.lastSentIdx := by rw [hstR'_mk]; rfl
      rw [hinv.bk_count, ← h1, hstR']
  · rcases inject_syncRML_of_not_lookahead ae G maxForwardJumps hsyncL ((h, p), e)
      (by intro _ _ hc ho _; by_contra hgt; exact hlook_case ⟨hc, ho, Nat.lt_of_not_ge hgt⟩)
      with ⟨u, stR', sM', sL', hR, hM, _, hsyncL'⟩
    have hok' := inTransitOk_of_injectH_not_lookahead ae G maxForwardJumps hinv.syncRM
      hinv.ok_inTransit
      (by intro _ _ hc ho _; by_contra hgt; exact hlook_case ⟨hc, ho, Nat.lt_of_not_ge hgt⟩) hM
    have hstR'_mk := hsyncL'.syncRM.stR_eq
    have hR_unf := hR; rw [hstR_mk] at hR_unf
    simp only [injectImpl, CryptoGames.FSAEAD.Thm5.Ends.modifyGet_run, CryptoGames.FSAEAD.inject,
      mkRState, hinv.not_ended, hany_impl, Bool.or_self, Bool.false_eq_true, ↓reduceIte] at hR_unf
    have hrec_mk : (fromAEADPRG ae G maxForwardJumps).receive
        (mkRState G k sM.1).receiverState (h, p) e = none := by rw [← hstR_mk]; exact hrec_none
    dsimp only [ae, G, mkRState] at hrec_mk hR_unf; rw [hrec_mk] at hR_unf; dsimp only at hR_unf
    rcases Prod.mk.inj (pure_eq_iff.mp hR_unf) with ⟨hu, hstR'⟩; subst hu; symm at hstR'
    have hinT' : sM'.1.inTransit = sM.1.inTransit := by
      have h1 : stR'.inTransit = sM'.1.inTransit := by rw [hstR'_mk]; rfl
      rw [← h1, hstR']
    refine ⟨sM', sL', hM,
      ⟨stR', hsyncL'.syncRM, fun _ => hsyncL', by rw [hinv.ss_eq, hstR', hstR_mk]; rfl,
        by rw [hinv.rs_eq, hstR', hstR_mk]; rfl, hsyncL'.not_ended, ?_, hok',
        by rw [hinT']; exact hinv.pub_inTransit, ?_, by rw [hbk_uncorr, hsyncL'.uncorr]; rfl,
        by rw [hinv.bk_trans, hinT']⟩⟩
    · have h1 : stR'.challengesInTransit = sM'.1.challengesInTransit := by rw [hstR'_mk]; rfl
      rw [← h1, hstR']; exact hinv.chal_nil
    · have h1 : stR'.lastSentIdx = sM'.1.lastSentIdx := by rw [hstR'_mk]; rfl
      rw [hinv.bk_count, ← h1, hstR']


section PerKeyCoupling

private theorem accept_epoch_eq {St Msg C : Type} (s : GameState St Msg C) (P : Party) (st' : St) (pos : Pos) :
    (s.accept P st' pos).epoch P = max (s.epoch P) pos.epoch ∧
    (∀ Q, Q ≠ P → (s.accept P st' pos).epoch Q = s.epoch Q) ∧
    (s.accept P st' pos).tL = s.tL ∧
    (s.accept P st' pos).leaks = s.leaks := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [GameState.accept, GameState.delete, Function.update_self]
  · intro Q hQ; simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
  · simp [GameState.accept, GameState.delete]
  · simp [GameState.accept, GameState.delete]

private theorem leak_props {St Msg C : Type} (s : GameState St Msg C) (l : ℕ) :
    (s.leak l).tL = some (maxOpt s.tL l) ∧
    maxOpt s.tL l ∈ (s.leak l).leaks ∧
    (∀ x ∈ s.leaks, x ∈ (s.leak l).leaks) ∧
    l ≤ maxOpt s.tL l ∧
    (∀ c0, s.tL = some c0 → c0 ≤ maxOpt s.tL l) := by
  refine ⟨rfl, by simp [GameState.leak], fun x hx => by simp [GameState.leak, hx], ?_, ?_⟩
  · cases s.tL <;> simp [maxOpt]
  · intro c0 hc0; rw [hc0]; simp [maxOpt]

private theorem authLosing_false_of_leak_lt_tWin {St Msg C : Type}
    {tL : Option ℕ} {lk tWin : ℕ} {s : GameState St Msg C}
    (hlk_mem : lk ∈ s.leaks) (hlt : ltOpt tL lk = true) (hlt_win : lk < tWin) :
    authLosingConditionsAvoided 3 tL tWin s = false := by
  unfold authLosingConditionsAvoided canon
  rw [Bool.eq_false_iff]
  intro h
  simp only [Bool.and_eq_true, List.all_eq_true, Bool.not_eq_true',
    Bool.and_eq_false_iff, decide_eq_false_iff_not, not_lt] at h
  rcases h.1.2 lk hlk_mem with h1 | h2
  · rw [hlt] at h1; cases h1
  · omega

private theorem healedBy_leak_imp {St Msg C : Type} (s : GameState St Msg C) (e Δ t0 : ℕ)
    (h : healedBy (s.leak e).tL Δ t0 = true) :
    healedBy s.tL Δ t0 = true ∧ e + Δ ≤ t0 := by
  unfold GameState.leak at h
  cases htL : s.tL with
  | none =>
    simp only [htL, maxOpt, healedBy, decide_eq_true_eq] at h ⊢
    exact ⟨trivial, h⟩
  | some c0 =>
    simp only [htL, maxOpt, healedBy, decide_eq_true_eq] at h ⊢
    omega

private theorem sendsIn_iff_senderOf (P : Party) (t : ℕ) :
    P.sendsIn t = true ↔ P = Party.senderOf t := by
  cases P <;> cases hs : Party.senderOf t <;> simp_all [Party.sendsIn, Party.senderOf]

private theorem not_sendsIn_iff_receiverOf (P : Party) (t : ℕ) :
    P.sendsIn t = false ↔ P = Party.receiverOf t := by
  cases P <;> cases hs : Party.senderOf t <;> simp_all [Party.sendsIn, Party.senderOf, Party.receiverOf, Party.other]

private theorem sendsIn_of_not_sendsIn_succ (P : Party) (t : ℕ)
    (h : P.sendsIn (t + 1) = false) :
    P.sendsIn t = true ∧ P = Party.senderOf t := by
  have h1 : P.sendsIn t = true := by
    cases P <;> simp [Party.sendsIn] at h ⊢ <;> omega
  exact ⟨h1, (sendsIn_iff_senderOf P t).mp h1⟩

private theorem postLeakDFBucket_eq_postLeak {St₁ St₂ Msg C : Type}
    (tL : Option ℕ) (g₁ : GameState St₁ Msg C) (g₂ : GameState St₂ Msg C)
    (htL : g₁.tL = g₂.tL) :
    postLeakDFBucket tL g₁ = postLeak tL g₂ := by
  unfold postLeakDFBucket postLeak
  rw [htL]
  cases g₂.tL <;> rfl

private abbrev LocVP (Pt : Type) :=
  VP (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256) (RatchetSenderState (BitVec 256))
    (RatchetReceiverState (BitVec 256) (BitVec 256))

private abbrev MultiVP (Pt : Type) :=
  VP (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256) (RatchetSenderState (BitVec 256) ⊕ ℕ)
    (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)

private abbrev LocHS (Pt : Type) :=
  LocalSlotBucketState Pt (BitVec 256) (BitVec 256) Pt

private abbrev MultiHS (Pt : Type) :=
  FSMultiDFBucketState Pt (BitVec 256) (BitVec 256) Pt (ℕ × LibsignalCiphertextWithSalt32)

private abbrev LocES (Pt : Type) (ℓ : ℕ) :=
  EState (LocVP Pt) (LibsignalMsgPublicPart × Plain ℓ)
    (Header Pt × (ℕ × LibsignalCiphertextWithSalt32)) (LocHS Pt)

private abbrev MultiES (Pt : Type) (ℓ : ℕ) :=
  EState (MultiVP Pt) (LibsignalMsgPublicPart × Plain ℓ)
    (Header Pt × (ℕ × LibsignalCiphertextWithSalt32)) (MultiHS Pt)

private structure GSync {Pt : Type} {ℓ : ℕ}
    (gLoc : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256) (RatchetSenderState (BitVec 256))
      (RatchetReceiverState (BitVec 256) (BitVec 256))
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (gM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256) (RatchetSenderState (BitVec 256) ⊕ ℕ)
      (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)) : Prop where
  epoch_eq : gLoc.epoch = gM.epoch
  idx_eq : gLoc.idx = gM.idx
  tL_eq : gLoc.tL = gM.tL
  trans_eq : gLoc.trans = gM.trans
  chall_eq : gLoc.chall = gM.chall
  comp_eq : gLoc.comp = gM.comp
  maxAcc_eq : gLoc.maxAcc = gM.maxAcc
  b_eq : gLoc.b = gM.b
  win_eq : gLoc.win = gM.win
  leaks_eq : gLoc.leaks = gM.leaks
  corrs_eq : gLoc.corrs = gM.corrs

private structure BucketSimInv {Pt : Type} [DecidableEq Pt]
    (C : Crypto) (ℓ : ℕ) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (q qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ks : ℕ → BitVec 256)
    (phase1 : Bool) (rem : ℕ)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ)
    (tblM tblL : ℕ → SessHSt Pt ℓ) : Prop where
  gsync : GSync esLoc.g esM.g
  abort_loc : esLoc.abort = false
  abort_M : esM.abort = false
  win_false : esLoc.g.win = false
  lfWin_M : esM.h.lfWin = false
  comp_unhealed : CompUnhealed esLoc.g
  tL_mem_leaks : ∀ cur, esLoc.g.tL = some cur → cur ∈ esLoc.g.leaks
  phase1_props : phase1 = true →
    postLeak tL esLoc.g = false ∧ esL = esM ∧
    ∀ sIdx, ((esM.h.book sIdx).getD {}).sCorr = false
  phase2_props : phase1 = false →
    postLeak tL esLoc.g = true
  -- Hook state sync
  sess_eq : esLoc.h.sessions = esM.h.sessions
  sess_nodup : ∀ t0, (esM.h.sessions t0).Nodup
  sess_zero_le : (esM.h.sessions 0).length ≤ q
  sess_pos_bound : ∀ t0, 1 ≤ t0 → (esM.h.sessions t0).length + rem ≤ q
  sess_epoch_ok : ∀ t0, esM.h.sessions t0 ≠ [] →
    !(qep + 1 < t0) = true ∧ inStage2BucketGen 4 tL par t0 = true ∧
    !(tL.isSome && (t0 == healEpoch tL)) = true
  fTable_M_iff : ∀ t0 ik, ((esM.h.fTable t0).lookup ik).isSome = decide (ik ∈ esM.h.sessions t0)
  fTable_loc_eq : ∀ t0 ik, (esLoc.h.fTable t0).lookup ik =
    if ik ∈ esM.h.sessions t0 then
      some (ks (q * (t0 - healEpoch tL) + (esM.h.sessions t0).idxOf ik))
    else none
  cache_sync : ∀ t0,
    (esLoc.h.cache t0 = none ∧ esM.h.cache t0 = none) ∨
    (∃ Tc σc kVal, 1 ≤ t0 ∧ esLoc.h.cache t0 = some (Tc, σc, kVal) ∧
      esM.h.cache t0 = some (Tc, σc, kVal, none)) ∨
    (∃ Tc σc kMulti j, 1 ≤ t0 ∧ j < (esM.h.sessions t0).length ∧
      !(qep + 1 < t0) = true ∧ inStage2BucketGen 4 tL par t0 = true ∧
      !(tL.isSome && (t0 == healEpoch tL)) = true ∧
      let sIdx := q * (t0 - healEpoch tL) + j
      esLoc.h.cache t0 = some (Tc, σc, ks sIdx) ∧
      esM.h.cache t0 = some (Tc, σc, kMulti, some sIdx))
  -- Party state sync
  vp_id : ∀ P, (esLoc.g.st P).id = P ∧ (esM.g.st P).id = P
  vp_tcur_eq : ∀ P, (esLoc.g.st P).tcur = esLoc.g.epoch P ∧ (esM.g.st P).tcur = esLoc.g.epoch P
  vp_γ_eq : ∀ P, (esLoc.g.st P).γ = (esM.g.st P).γ
  vp_root_eq : ∀ P, (esLoc.g.st P).root = (esM.g.st P).root
  vp_cka_eq : ∀ P, (esLoc.g.st P).curCkaMsg = (esM.g.st P).curCkaMsg
  vp_cka_cache : ∀ P,
    P.sendsIn (esLoc.g.epoch P) = true →
    ((esLoc.g.epoch P = 0 ∧ (esLoc.g.st P).curCkaMsg = none ∧
      ((inStage2BucketGen 4 tL par 0 = false ∧ ∃ ss, (esM.g.st P).vS = some (.inl ss)) ∨
       (inStage2BucketGen 4 tL par 0 = true ∧ (esM.g.st P).vS = some (.inr 0)))) ∨
     (1 ≤ esLoc.g.epoch P ∧ ∃ Tc σc kMulti optIdx,
       (esLoc.g.st P).curCkaMsg = some Tc ∧
       esM.h.cache (esLoc.g.epoch P) = some (Tc, σc, kMulti, optIdx) ∧
       ((optIdx = none ∧ ∃ ss, (esM.g.st P).vS = some (.inl ss)) ∨
        (∃ sIdx, optIdx = some sIdx ∧ (esM.g.st P).vS = some (.inr sIdx)))))
  epoch_bound : ∀ P, esLoc.g.epoch P + rem ≤ q
  vS_sync : ∀ P,
    ((esLoc.g.st P).vS = none ∧ (esM.g.st P).vS = none) ∨
    (∃ ss, (esLoc.g.st P).vS = some ss ∧ (esM.g.st P).vS = some (.inl ss)) ∨
    (∃ t0 j, t0 ≤ esLoc.g.epoch P ∧ (P.sendsIn (esLoc.g.epoch P) = true → t0 = esLoc.g.epoch P) ∧
      P = Party.senderOf t0 ∧ !(qep + 1 < t0) = true ∧ inStage2BucketGen 4 tL par t0 = true ∧
      !(tL.isSome && (t0 == healEpoch tL)) = true ∧ j < (esM.h.sessions t0).length ∧
      let sIdx := q * (t0 - healEpoch tL) + j
      (esLoc.g.st P).vS = some (ssLoc sIdx) ∧ (esM.g.st P).vS = some (.inr sIdx))
  vR_dom : ∀ P t0, ((esM.g.st P).vR t0).isSome = true → t0 ≤ esLoc.g.epoch P ∧ P = Party.receiverOf t0
  vR_sync : ∀ P t0,
    ((esLoc.g.st P).vR t0 = none ∧ (esM.g.st P).vR t0 = none) ∨
    (∃ rs, (esLoc.g.st P).vR t0 = some rs ∧ (esM.g.st P).vR t0 = some (.inl rs)) ∨
    (∃ j, P = Party.receiverOf t0 ∧ !(qep + 1 < t0) = true ∧
      inStage2BucketGen 4 tL par t0 = true ∧ !(tL.isSome && (t0 == healEpoch tL)) = true ∧
      j < (esM.h.sessions t0).length ∧
      let sIdx := q * (t0 - healEpoch tL) + j
      (esLoc.g.st P).vR t0 = some (rsLoc sIdx) ∧ (esM.g.st P).vR t0 = some (.inr sIdx))
  -- Per-session FS-AEAD invariant & freshness
  sess_inv : ∀ sIdx,
    ActiveSessInv C ℓ encT idOf (!((esM.h.book sIdx).getD {}).sCorr) (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((esM.h.book sIdx).getD {}) (tblM sIdx) (tblL sIdx)
  ss_fresh : ∀ t0 j, 1 ≤ t0 → healEpoch tL ≤ t0 → j < q →
    esLoc.g.epoch (Party.senderOf t0) < t0 →
    ssLoc (q * (t0 - healEpoch tL) + j) =
      (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initSender (ks (q * (t0 - healEpoch tL) + j))
  rs_fresh : ∀ t0 j, 1 ≤ t0 → healEpoch tL ≤ t0 → j < q →
    esLoc.g.epoch (Party.receiverOf t0) < t0 →
    rsLoc (q * (t0 - healEpoch tL) + j) =
      (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver (ks (q * (t0 - healEpoch tL) + j))
  book_fresh_before_send : ∀ t0 j, 1 ≤ t0 → healEpoch tL ≤ t0 → j < q →
    esLoc.g.epoch (Party.senderOf t0) < t0 → healedBy esLoc.g.tL 3 t0 = true →
    esM.h.book (q * (t0 - healEpoch tL) + j) = none
  -- Healed in-transit & honest-session pin (for `deliverE` & `deliverForgeE`)
  trans_meta : ∀ r ∈ esLoc.g.trans,
    r.ct.1.1 = r.pos.epoch ∧ r.pos.sender = Party.senderOf r.pos.epoch ∧
    r.pos.epoch ≤ esLoc.g.epoch r.pos.sender ∧
    (r.pos.epoch = 0 → r.ct.1 = (0, none)) ∧
    (1 ≤ r.pos.epoch → ∃ Tc, r.ct.1 = (r.pos.epoch, some Tc) ∧
      ∃ σc kMulti optIdx, esM.h.cache r.pos.epoch = some (Tc, σc, kMulti, optIdx))
  cache_empty_gt : ∀ t0, esLoc.g.epoch (Party.senderOf t0) < t0 → esM.h.cache t0 = none
  healed_sender_pin : ∀ P t0 j,
    P.sendsIn (esLoc.g.epoch P) = true → t0 = esLoc.g.epoch P →
    (esM.g.st P).vS = some (.inr (q * (t0 - healEpoch tL) + j)) →
    healedBy esLoc.g.tL 3 t0 = true →
    let sIdx := q * (t0 - healEpoch tL) + j
    esLoc.g.idx P = ((esM.h.book sIdx).getD {}).fsCount ∧
    ((t0 = 0 ∧ j = 0 ∧ (esM.g.st P).curCkaMsg = none) ∨
     (1 ≤ t0 ∧ ∃ Tc σc kMulti, (esM.g.st P).curCkaMsg = some Tc ∧
       esM.h.cache t0 = some (Tc, σc, kMulti, some sIdx)))
  healed_vR_pin : ∀ P t0 sIdx,
    (esM.g.st P).vR t0 = some (.inr sIdx) → healedBy esLoc.g.tL 3 t0 = true →
    (t0 = 0 ∧ sIdx = 0 ∧ inStage2BucketGen 4 tL par 0 = true ∧ tL = none) ∨
    (1 ≤ t0 ∧ ∃ Tc σc kMulti, esM.h.cache t0 = some (Tc, σc, kMulti, some sIdx))
  healed_book_trans : ∀ t0 sIdx,
    healedBy esLoc.g.tL 3 t0 = true →
    (esLoc.g.epoch (Party.receiverOf t0) < t0 ∨
      (esM.g.st (Party.receiverOf t0)).vR t0 = some (.inr sIdx)) →
    ((t0 = 0 ∧ sIdx = 0 ∧ inStage2BucketGen 4 tL par 0 = true ∧ tL = none) ∨
     (1 ≤ t0 ∧ ∃ Tc σc kMulti, esM.h.cache t0 = some (Tc, σc, kMulti, some sIdx))) →
    ((esM.h.book sIdx).getD {}).fsTrans =
      (esLoc.g.trans.filter (fun r => r.pos.epoch == t0)).map (fun r => (r.pos.idx, r.ct.1, r.ct.2))

private theorem BucketSimInv.mono_rem {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep : ℕ} {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {phase1 : Bool} {rem rem' : ℕ} (hle : rem' ≤ rem)
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ}
    {tblM tblL : ℕ → SessHSt Pt ℓ}
    (h : BucketSimInv C ℓ encT idOf q qep tL par ks phase1 rem ssLoc rsLoc esLoc esM esL tblM tblL) :
    BucketSimInv C ℓ encT idOf q qep tL par ks phase1 rem' ssLoc rsLoc esLoc esM esL tblM tblL :=
  { h with
    sess_pos_bound := fun t0 ht0 => le_trans (Nat.add_le_add_left hle _) (h.sess_pos_bound t0 ht0)
    epoch_bound := fun P => le_trans (Nat.add_le_add_left hle _) (h.epoch_bound P) }



private theorem sim_sampleT_lImpl {α : Type} [SampleableType α] :
    simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (_root_.CryptoGames.SM.Construction.sampleT
        (tspec := _root_.CryptoGames.SM.Construction.AuthL11.nilSpec) α) =
    ($ᵗ α : ProbComp α) := by
  suffices h : ∀ oa : ProbComp α,
      simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
        (liftM oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.AuthL11.nilSpec) α) = oa from
    h ($ᵗ α : ProbComp α)
  intro oa
  induction oa using OracleComp.inductionOn with
  | pure a => rfl
  | query_bind t k ih =>
    change simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      ((liftM (OracleSpec.query (spec := unifSpec + _root_.CryptoGames.SM.Construction.AuthL11.nilSpec) (.inl t)) :
        OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.AuthL11.nilSpec) _) >>=
      fun u => (liftM (k u) : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.AuthL11.nilSpec) α)) = _
    rw [simulateQ_query_bind]
    dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift,
      _root_.CryptoGames.SM.Construction.AuthL11.lImpl, QueryImpl.add_apply_inl, QueryImpl.ofLift_apply]
    congr 1; funext u; exact ih u

private theorem sim_sampleT_state_of_inl {ι : Type} {tspec : OracleSpec.{0, 0} ι}
    {σ' α : Type} [SampleableType α]
    (impl_all : QueryImpl (unifSpec + tspec) (StateT σ' ProbComp))
    (hinl : ∀ n (s : σ'), (impl_all (.inl n)).run s =
      ((liftM (OracleSpec.query (spec := unifSpec) n) : ProbComp (Fin (n + 1))) >>= fun u => pure (u, s)))
    (st : σ') :
    (simulateQ impl_all (_root_.CryptoGames.SM.Construction.sampleT (tspec := tspec) α)).run st =
      (($ᵗ α : ProbComp α) >>= fun x => pure (x, st)) := by
  suffices h : ∀ oa : ProbComp α,
      (simulateQ impl_all (liftM oa : OracleComp (unifSpec + tspec) α)).run st =
        (oa >>= fun x => pure (x, st)) from
    h ($ᵗ α : ProbComp α)
  intro oa
  induction oa using OracleComp.inductionOn with
  | pure a =>
    change (pure a : StateT σ' ProbComp α).run st = (pure a >>= fun x => pure (x, st))
    simp [StateT.run_pure]
  | query_bind t k ih =>
    change (simulateQ impl_all
      ((liftM (OracleSpec.query (spec := unifSpec + tspec) (.inl t)) : OracleComp (unifSpec + tspec) _) >>=
      fun u => (liftM (k u) : OracleComp (unifSpec + tspec) α))).run st = _
    rw [simulateQ_query_bind, StateT.run_bind]
    dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift]
    rw [hinl t st]
    simp only [bind_assoc, pure_bind]
    congr 1; funext u; exact ih u

