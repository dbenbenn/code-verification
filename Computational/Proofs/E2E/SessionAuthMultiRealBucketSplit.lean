private theorem step2_deliverForge_aux_inTransit_eq {Pt : Type} [DecidableEq Pt] {ℓ : ℕ}
    {gLoc : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256)) (RatchetReceiverState (BitVec 256) (BitVec 256))
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    {gM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    (hgs : GSync gLoc gM) (Q : Party) (x : Fig8C Pt) :
    gM.inTransit Q x = gLoc.inTransit Q x := by
  unfold GameState.inTransit
  rw [hgs.trans_eq]

private theorem step2_deliverForge_aux_healed_out_false {Pt : Type} [DecidableEq Pt] {ℓ : ℕ}
    (mode : Option Bool) (tL : Option ℕ) (esLoc : LocES Pt ℓ)
    (P : Party) (c c' : Fig8C Pt)
    (hpl : postLeak tL esLoc.g = true)
    (htL_mem : ∀ cur, esLoc.g.tL = some cur → cur ∈ esLoc.g.leaks)
    (hhealed : healedBy esLoc.g.tL 3 c'.1.1 = true) :
    authOutBucket 3 tL
      ({ esLoc with g := { esLoc.g with win := true } },
       calcWinEp (St := Fig8St Pt) (mode != some false) (isHonestHdrSlotBucket esLoc.h)
         (fun Q => (esLoc.g.st Q).tcur)
         (.inr ⟨P, c, c'⟩ : (Fig8SpecDF Pt ℓ).Domain) true) = false := by
  cases hgm : (mode != some false) with
  | false =>
    simp [calcWinEp, authOutBucket]
  | true =>
    have hwe :
        calcWinEp (St := Fig8St Pt) true (isHonestHdrSlotBucket esLoc.h)
          (fun Q => (esLoc.g.st Q).tcur)
          (.inr ⟨P, c, c'⟩ : (Fig8SpecDF Pt ℓ).Domain) true = some c'.1.1 := rfl
    rw [hwe]
    unfold postLeak at hpl
    cases htL : esLoc.g.tL with
    | none => rw [htL] at hpl; cases hpl
    | some cur =>
      rw [htL] at hpl hhealed
      simp only [healedBy, decide_eq_true_eq] at hhealed
      have hmem : cur ∈ ({ esLoc.g with win := true }).leaks := htL_mem cur htL
      have hlos : authLosingConditionsAvoided 3 tL c'.1.1 { esLoc.g with win := true } = false :=
        authLosing_false_of_leak_lt_tWin hmem hpl (by omega)
      simp [authOutBucket, CryptoGames.SM.Engine.authOut, hlos]

