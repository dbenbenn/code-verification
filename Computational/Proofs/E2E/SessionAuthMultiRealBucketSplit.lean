private theorem step1_inject_aux_pair_beq_eq_local {Pt : Type} [DecidableEq Pt]
    (a b : Header Pt × (ℕ × LibsignalCiphertextWithSalt32)) :
    @BEq.beq (Header Pt × (ℕ × LibsignalCiphertextWithSalt32))
      (@instBEqProd (Header Pt) (ℕ × LibsignalCiphertextWithSalt32) _ instBEqOfDecidableEq) a b =
    (a == b) := by
  rcases a with ⟨ha, ca⟩; rcases b with ⟨hb, cb⟩
  change (ha == hb && decide (ca = cb)) = (ha == hb && (ca == cb))
  have hc : decide (ca = cb) = (ca == cb) := by
    cases h : (ca == cb)
    · have hne : ca ≠ cb := fun heq => by rw [(ct_beq_iff_local ca cb).mpr heq] at h; cases h
      simp [hne]
    · simp [(ct_beq_iff_local ca cb).mp h]
  rw [hc]

