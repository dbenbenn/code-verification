private theorem step2_deliverForge_aux_fsRecv_inr_matched
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (hℓ : ℓ < 10 ^ 6) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 sIdx : ℕ)
    (h : Header Pt) (e : ℕ × LibsignalCiphertextWithSalt32)
    (ks : ℕ → BitVec 256)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (hM : MultiHS Pt) (tblM tblL : ℕ → SessHSt Pt ℓ)
    {mEntry : ℕ × Header Pt × (ℕ × LibsignalCiphertextWithSalt32)}
    (hmatch : ((hM.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (h, e)) = some mEntry)
    (hsess : ActiveSessInv C ℓ encT idOf (!((hM.book sIdx).getD {}).sCorr) (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((hM.book sIdx).getD {}) (tblM sIdx) (tblL sIdx)) :
    let bk := (hM.book sIdx).getD {}
    match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) h e with
    | none =>
      ∃ sM' sL',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) h e none).run hM)).run (fun _ => false, tblM) =
          pure ((some none, hM), (fun _ => false, Function.update tblM sIdx sM')) ∧
        ActiveSessInv C ℓ encT idOf (!bk.sCorr) (ks sIdx)
          (ssLoc sIdx) (rsLoc sIdx) bk sM' sL'
    | some (rsLoc', idxOut, pmOut) =>
      let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
        { bk with fsTrans := bk.fsTrans.filter (·.1 != idxOut) }
      ∃ sM' sL',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) h e none).run hM)).run (fun _ => false, tblM) =
          pure ((some (some (.inr sIdx, idxOut, pmOut)),
            { hM with book := Function.update hM.book sIdx (some bk') }),
            (fun _ => false, Function.update tblM sIdx sM')) ∧
        ActiveSessInv C ℓ encT idOf (!bk.sCorr) (ks sIdx)
          (ssLoc sIdx) rsLoc' bk' sM' sL' := by
  intro bk
  rcases e with ⟨e1, e2⟩
  rcases hrt_and_len_check ℓ hℓ with ⟨hrt, hlen⟩
  rcases activeSessInv_deliver C hD hrt ℓ hlen encT idOf hsess h (e1, e2) hmatch with ⟨p, hpub, hdel⟩
  cases hrec : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) h (e1, e2) with
  | none =>
    rw [hrec] at hdel
    rcases hdel with ⟨sM', sL', hstep, _, hinv'⟩
    refine ⟨sM', sL', ?_, hinv'⟩
    rw [hkMultiOpt_fsRecv]
    dsimp only [hooksFSMultiDFBucketPaper]
    simp only [step2_deliverForge_aux_hdr_ct_beq_eq, StateT.run_bind, StateT.run_get, pure_bind,
      hmatch, Option.isNone_some, Bool.false_and, Bool.false_eq_true, ↓reduceIte,
      Bool.not_true, Option.isSome_some, simulateQ_bind]
    rw [sim_liftFS_deliver_some_run C ℓ encT idOf false sIdx h e1 e2 p hpub hM tblM hstep]
    simp only [Option.map_some, withPub, pure_bind, StateT.run_pure, simulateQ_pure]
