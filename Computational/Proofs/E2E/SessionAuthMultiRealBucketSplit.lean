              esM.g P (esM.g.st P).tcur (q * (esLoc.g.epoch P - healEpoch tL) + j) hdr m esM.h tblL hnocheck htxL]
            simp only [pure_bind, StateT.run_bind, StateT.run_modify, StateT.run_pure, simulateQ_pure,
              hinv.abort_M, hrec_eq, bk', bk, o, stM', esM', tblL', sIdx, ep]
          rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc' _ hinv.win_false hstepLoc,
              runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblM tblM' _ hwinM hstepM,
              runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblL tblL' _ hwinM hstepL]
          have hwinLoc' : esLoc'.g.win = false := hinv.win_false
          have hwinM' : esM'.g.win = false := hwinM
          simp only [hwinLoc', hwinM', calcWinEp, Bool.false_eq_true, ↓reduceIte]
          apply hIH1 (some (hdr, o.2)) ssLoc' rsLoc esLoc' esM' esM' tblM' tblL'
          exact
            { gsync := hinv.gsync.record_sync P stLoc' stM' rec_ false
              abort_loc := hinv.abort_loc
              abort_M := hinv.abort_M
              win_false := hinv.win_false
              lfWin_M := hinv.lfWin_M
              comp_unhealed := hrec_pr.1
              tL_mem_leaks := hrec_pr.2.1
              phase1_props := fun _ =>
                ⟨hpl0, rfl, fun sIdx' => by
                  dsimp only [esM']
                  by_cases hs' : sIdx' = sIdx
                  · rw [hs']; simp [bk', bk, hscorr0 sIdx]
                  · simp [Function.update_of_ne hs', hscorr0 sIdx']⟩
              phase2_props := fun hp => Bool.noConfusion hp
              sess_eq := hinv.sess_eq
              sess_nodup := hinv.sess_nodup
              sess_zero_le := hinv.sess_zero_le
              sess_pos_bound := fun τ hτ =>
                le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
              sess_epoch_ok := hinv.sess_epoch_ok
              fTable_M_iff := hinv.fTable_M_iff
              fTable_loc_eq := hinv.fTable_loc_eq
              cache_sync := hinv.cache_sync
              vp_id := fun Q => by
                dsimp only [esLoc', esM', GameState.record]
                rcases eq_or_ne Q P with rfl | hQ
                · simp [stLoc', stM', (hinv.vp_id Q).1, (hinv.vp_id Q).2]
                · simp [Function.update_of_ne hQ, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
              vp_tcur_eq := fun Q => by
                dsimp only [esLoc', esM', GameState.record]
                rcases eq_or_ne Q P with rfl | hQ
                · simp [stLoc', stM', (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
                · simp [Function.update_of_ne hQ, (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
              vp_γ_eq := fun Q => by
                dsimp only [esLoc', esM', GameState.record]
                rcases eq_or_ne Q P with rfl | hQ
                · simp [stLoc', stM', hinv.vp_γ_eq Q]
                · simp [Function.update_of_ne hQ, hinv.vp_γ_eq Q]
              vp_root_eq := fun Q => by
                dsimp only [esLoc', esM', GameState.record]
                rcases eq_or_ne Q P with rfl | hQ
                · simp [stLoc', stM', hinv.vp_root_eq Q]
                · simp [Function.update_of_ne hQ, hinv.vp_root_eq Q]
              vp_cka_eq := fun Q => by
                dsimp only [esLoc', esM', GameState.record]
                rcases eq_or_ne Q P with rfl | hQ
                · simp [stLoc', stM', hinv.vp_cka_eq Q]
                · simp [Function.update_of_ne hQ, hinv.vp_cka_eq Q]
              vp_cka_cache := fun Q hQ_sends => by
                dsimp only [esLoc', esM', GameState.record] at hQ_sends ⊢
                by_cases hQ : Q = P
                · rw [hQ] at hQ_sends ⊢
                  rcases hinv.vp_cka_cache P hP_sends with ⟨h0, hc, ⟨_, _, hv⟩ | ⟨hbk0, hv⟩⟩ |
                      ⟨h1, Tc, σc, kMulti, optIdx, hc, hcache, ⟨_, _, hv⟩ | ⟨sIdx', hopt, hv⟩⟩
                  · rw [hvM] at hv; cases hv
                  · rw [hvM] at hv; simp only [Option.some.injEq, Sum.inr.injEq] at hv
                    exact Or.inl ⟨h0, by simp [stLoc', hc], Or.inr ⟨hbk0, by simp [stM', sIdx, ← hv]⟩⟩
                  · rw [hvM] at hv; cases hv
                  · rw [hvM] at hv; simp only [Option.some.injEq, Sum.inr.injEq] at hv
                    exact Or.inr ⟨h1, Tc, σc, kMulti, optIdx, by simp [stLoc', hc], hcache,
                      Or.inr ⟨sIdx, by dsimp only [sIdx]; rw [hopt, hv], by simp [stM']⟩⟩
                · simpa [Function.update_of_ne hQ] using hinv.vp_cka_cache Q hQ_sends
              epoch_bound := fun Q =>
                le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
              vS_sync := fun Q => by
                dsimp only [esLoc', esM', GameState.record]
                by_cases hQ : Q = P
                · rw [hQ]
                  exact Or.inr (Or.inr ⟨ep, j, le_rfl, fun _ => rfl, hP_send, hcap, hbk, htH, hj_len,
                    by simp [stLoc', ssLoc', sIdx], by simp [stM', sIdx]⟩)
                · rw [Function.update_of_ne hQ, Function.update_of_ne hQ]
                  rcases hinv.vS_sync Q with h0 | h1 | ⟨τ, j', hle, hsend_eq, hQ_send, hc', hb', ht', hj', hv1, hv2⟩
                  · exact Or.inl h0
                  · exact Or.inr (Or.inl h1)
                  · have hj'_q : j' < q := by
                      by_cases hτ0 : τ = 0
                      · subst hτ0; exact lt_of_lt_of_le hj' hinv.sess_zero_le
                      · have := hinv.sess_pos_bound τ (by omega); omega
                    have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
                      intro heq
                      obtain ⟨hτ_eq, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hb') htH_le hj'_q hj_q heq
                      exact hQ (hQ_send.trans (hτ_eq ▸ hP_send.symm))
                    exact Or.inr (Or.inr ⟨τ, j', hle, hsend_eq, hQ_send, hc', hb', ht', hj',
                      by simp [ssLoc', Function.update_of_ne hne_s, hv1], hv2⟩)
              vR_dom := fun Q τ hdom => by
                dsimp only [esLoc', esM', GameState.record] at hdom ⊢
                rcases eq_or_ne Q P with rfl | hQ
                · simp only [Function.update_self, stM'] at hdom; exact hinv.vR_dom Q τ hdom
                · simp only [Function.update_of_ne hQ] at hdom; exact hinv.vR_dom Q τ hdom
              vR_sync := fun Q τ => by
                dsimp only [esLoc', esM', GameState.record]
                rcases eq_or_ne Q P with rfl | hQ
                · simpa [stLoc', stM'] using hinv.vR_sync Q τ
                · simpa [Function.update_of_ne hQ] using hinv.vR_sync Q τ
              sess_inv := fun sIdx' => by
                dsimp only [esM', ssLoc', tblM', tblL']
                by_cases hs' : sIdx' = sIdx
                · rw [hs']
                  have hsCorr_eq : bk'.sCorr = bk.sCorr := rfl
                  simpa [Function.update_self, hsCorr_eq, o] using hsinv'
                · simpa [Function.update_of_ne hs'] using hinv.sess_inv sIdx'
              ss_fresh := fun τ j' h1 h2 h3 hlt => by
                dsimp only [esLoc', GameState.record] at hlt
                dsimp only [ssLoc']
                have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
                  intro heq
                  obtain ⟨hτ_eq, _⟩ := bucketSlot_inj h2 htH_le h3 hj_q heq
                  subst hτ_eq; rw [← hP_send] at hlt; omega
                rw [Function.update_of_ne hne_s]
                exact hinv.ss_fresh τ j' h1 h2 h3 hlt
              rs_fresh := hinv.rs_fresh
              book_fresh_before_send := fun τ j' h1 h2 h3 hlt hh => by
                dsimp only [esLoc', esM', GameState.record] at hlt hh ⊢
                have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
                  intro heq
                  obtain ⟨hτ_eq, _⟩ := bucketSlot_inj h2 htH_le h3 hj_q heq
                  subst hτ_eq; rw [← hP_send] at hlt; omega
                rw [Function.update_of_ne hne_s]
                exact hinv.book_fresh_before_send τ j' h1 h2 h3 hlt hh
              trans_meta := fun r' hr' => by
                dsimp only [esLoc', esM', GameState.record] at hr' ⊢
                rcases List.mem_cons.mp hr' with rfl | hr_old
                · refine ⟨rfl, hP_send, le_rfl, ?_, ?_⟩
                  · intro h0
                    dsimp only [rec_, ep] at h0
                    rcases hinv.vp_cka_cache P hP_sends with ⟨_, hc, _⟩ | ⟨h1, _⟩
                    · simp [rec_, hdr, ep, h0, hc]
                    · omega
                  · intro h1
                    dsimp only [rec_, ep] at h1
                    rcases hinv.vp_cka_cache P hP_sends with ⟨h0, _⟩ | ⟨_, Tc, σc, kMulti, optIdx, hc, hcache, _⟩
                    · omega
                    · exact ⟨Tc, by simp [rec_, hdr, hc], σc, kMulti, optIdx, hcache⟩
                · exact hinv.trans_meta r' hr_old
              cache_empty_gt := hinv.cache_empty_gt
              healed_sender_pin := fun Q τ j' hsQ hτ hvS hh => by
                dsimp only [esLoc', esM', GameState.record] at hsQ hτ hvS hh ⊢
                by_cases hQ : Q = P
                · rw [hQ] at hsQ hτ hvS ⊢
                  simp only [Function.update_self, stM'] at hvS ⊢
                  have heq_idx : q * (ep - healEpoch tL) + j = q * (τ - healEpoch tL) + j' := by
                    simp only [Option.some.injEq, Sum.inr.injEq, sIdx] at hvS; exact hvS
                  rw [hτ] at heq_idx ⊢
                  have hj'_eq : j' = j := by dsimp only [ep] at heq_idx; omega
                  rw [hj'_eq]
                  obtain ⟨hidx_cnt, hpin_rest⟩ :=
                    hinv.healed_sender_pin P ep j hP_sends rfl hvM (by dsimp only [ep]; rwa [← hτ])
                  exact ⟨by simp [rec_, bk', bk, hidx_cnt, sIdx, ep], by simpa [stM', sIdx, ep] using hpin_rest⟩
                · simp only [Function.update_of_ne hQ] at hvS ⊢
                  rcases hinv.vS_sync Q with ⟨_, h0⟩ | ⟨_, _, h0⟩ | ⟨τ', k', _, hs', hQ_send, _, hb', _, hk', _, h0⟩
                  · rw [h0] at hvS; cases hvS
                  · rw [h0] at hvS; cases hvS
                  · have heq_idx : q * (τ' - healEpoch tL) + k' = q * (τ - healEpoch tL) + j' := by
                      rw [hvS] at h0; simp only [Option.some.injEq, Sum.inr.injEq] at h0; exact h0.symm
                    rw [hs' hsQ, ← hτ] at heq_idx hk' hb' hQ_send
                    have hk'_eq : j' = k' := by omega
                    rw [hk'_eq] at hvS ⊢
                    have hj'_q : k' < q := by
                      by_cases hτ0 : τ = 0
                      · subst hτ0; exact lt_of_lt_of_le hk' hinv.sess_zero_le
                      · have := hinv.sess_pos_bound τ (by omega); omega
                    have hne_s : q * (τ - healEpoch tL) + k' ≠ sIdx := by
                      intro heq
                      obtain ⟨hτ_eq, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hb') htH_le hj'_q hj_q heq
                      exact hQ (hQ_send.trans (hτ_eq ▸ hP_send.symm))
                    simp only [Function.update_of_ne hne_s]
                    exact hinv.healed_sender_pin Q τ k' hsQ hτ hvS hh
              healed_vR_pin := fun Q τ sIdx' hvR hh => by
                dsimp only [esLoc', esM', GameState.record] at hvR hh ⊢
                have hvR_orig : (esM.g.st Q).vR τ = some (.inr sIdx') := by
                  by_cases hQ : Q = P
                  · rw [hQ] at hvR ⊢; simpa [stM'] using hvR
                  · simpa [Function.update_of_ne hQ] using hvR
                exact hinv.healed_vR_pin Q τ sIdx' hvR_orig hh
              healed_book_trans := fun τ sIdx' hh hro hp => by
                dsimp only [esLoc', esM', GameState.record] at hh hro hp ⊢
                have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
                    (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
                  rcases hro with hlt | hvR
                  · exact Or.inl hlt
                  · right
                    by_cases hQ : Party.receiverOf τ = P
                    · rw [hQ] at hvR ⊢; simpa [stM'] using hvR
                    · simpa [Function.update_of_ne hQ] using hvR
                by_cases hτ_ep : τ = ep
                · rw [hτ_ep] at hh hro_orig hp ⊢
                  obtain ⟨hidx_cnt, hpin_rest⟩ := hinv.healed_sender_pin P ep j hP_sends rfl hvM hh
                  have hs_eq : sIdx' = sIdx := by
                    rcases hpin_rest with ⟨h0, hj0, _⟩ | ⟨h1, Tc, σc, kMulti, _, hc⟩
                    · rcases hp with ⟨_, rfl, _⟩ | ⟨h1, _⟩
                      · simp [sIdx, h0, hj0]
                      · omega
                    · rcases hp with ⟨h0, _⟩ | ⟨_, _, _, _, hc'⟩
                      · omega
                      · rw [hc] at hc'
                        simp only [Option.some.injEq, Prod.mk.injEq] at hc'
                        exact hc'.2.2.2.symm
                  rw [hs_eq] at hro_orig hp ⊢
                  have hprev := hinv.healed_book_trans ep sIdx hh hro_orig hp
                  rw [Function.update_self, List.filter_cons_of_pos (by simp [rec_]), List.map_cons]
                  dsimp only [Option.getD, bk', bk, rec_, sIdx] at hidx_cnt hprev ⊢
                  rw [hidx_cnt, hprev]
                · have hne_s : sIdx' ≠ sIdx := by
                    intro heq; subst heq
                    rcases hp with ⟨h0, hs0, _, htL_n⟩ | ⟨h1, Tc, σc, kMulti, hc⟩
                    · subst h0
                      have hep_gt : 1 ≤ ep := by omega
                      have hq_pos : 0 < q := by omega
                      have hmul_pos : 0 < q * ep := Nat.mul_pos hq_pos hep_gt
                      have hsub : ep - healEpoch tL = ep := by subst htL_n; simp [healEpoch]
                      dsimp only [sIdx] at hs0
                      rw [hsub] at hs0
                      omega
                    · rcases hinv.cache_sync τ with ⟨_, hcn⟩ | ⟨_, _, _, _, _, hcn⟩ |
                          ⟨_, _, _, j', _, _, _, hbk', _, _, hcs⟩
                      · rw [hcn] at hc; cases hc
                      · rw [hcn] at hc; cases hc
                      · rw [hcs] at hc
                        simp only [Option.some.injEq, Prod.mk.injEq] at hc
                        have hs_eq' : q * (τ - healEpoch tL) + j' = sIdx := hc.2.2.2
                        have hj'_q : j' < q := by have := hinv.sess_pos_bound τ h1; omega
                        obtain ⟨hτ_eq, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hbk') htH_le hj'_q hj_q hs_eq'
                        exact hτ_ep hτ_eq
                  have hb_ne : (rec_.pos.epoch == τ) = false := beq_false_of_ne (Ne.symm hτ_ep)
                  simp only [Function.update_of_ne hne_s, List.filter_cons, hb_ne]
                  exact hinv.healed_book_trans τ sIdx' hh hro_orig hp }

private theorem step2_deliver_aux_inTransit_some_props {Pt : Type} [DecidableEq Pt] {ℓ : ℕ}
    {esLoc : LocES Pt ℓ} {esM : MultiES Pt ℓ}
    (hgs : GSync esLoc.g esM.g)
    (htr : ∀ r ∈ esLoc.g.trans,
      r.ct.1.1 = r.pos.epoch ∧ r.pos.sender = Party.senderOf r.pos.epoch ∧
      r.pos.epoch ≤ esLoc.g.epoch r.pos.sender ∧
      (r.pos.epoch = 0 → r.ct.1 = (0, none)) ∧
      (1 ≤ r.pos.epoch → ∃ Tc, r.ct.1 = (r.pos.epoch, some Tc) ∧
        ∃ σc kMulti optIdx, esM.h.cache r.pos.epoch = some (Tc, σc, kMulti, optIdx)))
    {P : Party} {c : Fig8C Pt} {r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    (hinT : esLoc.g.inTransit P.other c = some r0) :
    esM.g.inTransit P.other c = some r0 ∧
    r0 ∈ esLoc.g.trans ∧ r0.pos.sender = P.other ∧ r0.ct = c ∧
    r0.pos.epoch = c.1.1 ∧ P = Party.receiverOf c.1.1 ∧ P.sendsIn c.1.1 = false ∧
    (1 ≤ c.1.1 → ∃ Tc, c.1 = (c.1.1, some Tc) ∧
      ∃ σc kMulti optIdx, esM.h.cache c.1.1 = some (Tc, σc, kMulti, optIdx)) := by
  have hinM : esM.g.inTransit P.other c = some r0 := by
    unfold GameState.inTransit at hinT ⊢
    rw [← hgs.trans_eq]; exact hinT
  have hmem : r0 ∈ esLoc.g.trans := List.mem_of_find?_eq_some hinT
  have hpred := List.find?_some hinT
  simp only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hpred
  obtain ⟨hsend, hct⟩ := hpred
  obtain ⟨hep_ct, hsend_of, _, _, hpos1⟩ := htr r0 hmem
  have hep : r0.pos.epoch = c.1.1 := by rw [← hep_ct, hct]
  have hP_other : P.other = Party.senderOf c.1.1 := by rw [← hsend, hsend_of, hep]
  have hP : P = Party.receiverOf c.1.1 := by
    unfold Party.receiverOf
    rw [← hP_other]
    cases P <;> rfl
  have hns : P.sendsIn c.1.1 = false := (not_sendsIn_iff_receiverOf P c.1.1).mpr hP
  refine ⟨hinM, hmem, hsend, hct, hep, hP, hns, fun h1 => ?_⟩
  obtain ⟨Tc, hct1, σc, kMulti, optIdx, hcache⟩ := hpos1 (by omega)
  rw [hct, hep] at hct1
  rw [hep] at hcache
  exact ⟨Tc, hct1, σc, kMulti, optIdx, hcache⟩

private theorem step2_deliver_aux_startRecv_honest_cache_loc {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256)) (RatchetReceiverState (BitVec 256) (BitVec 256))
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 : ℕ) (γ0 : CryptoGames.CKA.DDH.State (BitVec 256) Pt)
    (σ0 : BitVec 256) (Tc : Pt) (σc kVal : BitVec 256) (hLoc : LocHS Pt)
    (hc : hLoc.cache t0 = some (Tc, σc, kVal)) :
    ((hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks).startRecv ctx P t0 γ0 σ0 Tc).run hLoc =
      pure (some (some (((dhScheme Dh).receive γ0 Tc).1, σc,
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver kVal)), hLoc) := by
  simp [hkLocOpt, hooksSlotBucketOptAt, StateT.run_bind, StateT.run_get, StateT.run_pure, hc]

private theorem step2_deliver_aux_startRecv_honest_cache_multi {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 : ℕ) (γ0 : CryptoGames.CKA.DDH.State (BitVec 256) Pt)
    (σ0 : BitVec 256) (Tc : Pt) (σc kMulti : BitVec 256) (optIdx : Option ℕ)
    (hM : MultiHS Pt) (tbl : ℕ → SessHSt Pt ℓ)
    (hc : hM.cache t0 = some (Tc, σc, kMulti, optIdx)) :
    (simulateQ (pubFsImplOpt C ℓ encT idOf la)
      (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la).startRecv ctx P t0 γ0 σ0 Tc).run hM)).run
      (fun _ => false, tbl) =
    pure ((some (some (((dhScheme Dh).receive γ0 Tc).1, σc,
      match optIdx with
      | none => .inl ((lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver kMulti)
      | some sIdx => .inr sIdx)), hM), (fun _ => false, tbl)) := by
  rw [hkMultiOpt_startRecv]
  cases optIdx <;> cases mode with
  | none =>
    simp [hooksFSMultiDFBucketPaper, StateT.run_bind, StateT.run_get, StateT.run_pure, hc]
  | some g =>
    cases g <;>
      simp [hooksFSMultiDFBucketPaperMode, hooksFSMultiDFBucketPaper,
        StateT.run_bind, StateT.run_get, StateT.run_pure, hc]

private theorem step2_deliver_aux_filter_map_delete_pos {Msg Pt : Type} [DecidableEq Pt]
    (L : List (Record Msg (Header Pt × (ℕ × LibsignalCiphertextWithSalt32))))
    (pos : Pos)
    (hsend : ∀ r ∈ L, r.pos.epoch = pos.epoch → r.pos.sender = pos.sender) :
    (((L.filter (fun r => r.pos != pos)).filter (fun r => r.pos.epoch == pos.epoch)).map
      (fun r => (r.pos.idx, r.ct.1, r.ct.2))) =
    (((L.filter (fun r => r.pos.epoch == pos.epoch)).map
      (fun r => (r.pos.idx, r.ct.1, r.ct.2))).filter (fun x => x.1 != pos.idx)) := by
  induction L with
  | nil => rfl
  | cons hd tl ih =>
    have hhd_mem : hd ∈ hd :: tl := List.mem_cons_self
    have htl_send : ∀ r ∈ tl, r.pos.epoch = pos.epoch → r.pos.sender = pos.sender :=
      fun r hr => hsend r (List.mem_cons_of_mem hd hr)
    by_cases hep : hd.pos.epoch = pos.epoch
    · have hs_eq : hd.pos.sender = pos.sender := hsend hd hhd_mem hep
      have hpos_bne : (hd.pos != pos) = (hd.pos.idx != pos.idx) := by
        rcases hd with ⟨⟨ps, pe, pi⟩, m, ct⟩
        rcases pos with ⟨qs, qe, qi⟩
        dsimp only at hep hs_eq ⊢
        subst hep; subst hs_eq
        by_cases hi : pi = qi <;> simp [hi, bne]
      have hep_beq : (hd.pos.epoch == pos.epoch) = true := beq_iff_eq.mpr hep
      cases hidx : (hd.pos.idx != pos.idx)
      · simp only [List.filter_cons, hpos_bne, hidx, hep_beq, Bool.false_eq_true, ↓reduceIte,
          List.map_cons]
        exact ih htl_send
      · simp only [List.filter_cons, hpos_bne, hidx, hep_beq, ↓reduceIte, List.map_cons]
        exact congrArg ((hd.pos.idx, hd.ct.1, hd.ct.2) :: ·) (ih htl_send)
    · have hep_beq : (hd.pos.epoch == pos.epoch) = false := beq_false_of_ne hep
      cases hpos : (hd.pos != pos) <;>
        simp only [List.filter_cons, hpos, hep_beq, Bool.false_eq_true, ↓reduceIte] <;>
        exact ih htl_send

private theorem step2_deliver_aux_filter_delete_pos_ne {Msg Pt : Type} [DecidableEq Pt]
    (L : List (Record Msg (Header Pt × (ℕ × LibsignalCiphertextWithSalt32))))
    (pos : Pos) (τ : ℕ) (hτ : τ ≠ pos.epoch) :
    (L.filter (fun r => r.pos != pos)).filter (fun r => r.pos.epoch == τ) =
      L.filter (fun r => r.pos.epoch == τ) := by
  induction L with
  | nil => rfl
  | cons hd tl ih =>
    by_cases hep : hd.pos.epoch = τ
    · have hne_pos : (hd.pos != pos) = true := by
        rw [bne_iff_ne]; intro heq; apply hτ; rw [← hep, heq]
      have hep_beq : (hd.pos.epoch == τ) = true := beq_iff_eq.mpr hep
      simp only [List.filter_cons, hne_pos, hep_beq, ↓reduceIte]
      exact congrArg (hd :: ·) ih
    · have hep_beq : (hd.pos.epoch == τ) = false := beq_false_of_ne hep
      cases hpos : (hd.pos != pos) <;>
        simp only [List.filter_cons, hpos, hep_beq, Bool.false_eq_true, ↓reduceIte] <;>
        exact ih

private theorem step2_deliver_aux_accept_preserve_props {St Msg : Type} {Pt : Type} [DecidableEq Pt]
    (s : GameState St Msg (Header Pt × (ℕ × LibsignalCiphertextWithSalt32)))
    (P : Party) (st' : St) (pos : Pos) (tL : Option ℕ) :
    (s.accept P st' pos).win = s.win ∧
    (s.accept P st' pos).tL = s.tL ∧
    (s.accept P st' pos).leaks = s.leaks ∧
    (s.accept P st' pos).corrs = s.corrs ∧
    (s.accept P st' pos).idx = s.idx ∧
    (∀ r ∈ (s.accept P st' pos).trans, r ∈ s.trans) ∧
    (postLeak tL s = postLeak tL (s.accept P st' pos)) ∧
    (CompUnhealed s → CompUnhealed (s.accept P st' pos)) ∧
    ((∀ r ∈ s.trans, r.pos.epoch = pos.epoch → r.pos.sender = pos.sender) →
      (((s.accept P st' pos).trans.filter (fun r => r.pos.epoch == pos.epoch)).map
        (fun r => (r.pos.idx, r.ct.1, r.ct.2)) =
       (((s.trans.filter (fun r => r.pos.epoch == pos.epoch)).map
        (fun r => (r.pos.idx, r.ct.1, r.ct.2))).filter (fun x => x.1 != pos.idx))) ∧
      (∀ τ, τ ≠ pos.epoch →
        (s.accept P st' pos).trans.filter (fun r => r.pos.epoch == τ) =
          s.trans.filter (fun r => r.pos.epoch == τ))) := by
  refine ⟨rfl, rfl, rfl, rfl, rfl, ?_, ?_, ?_, ?_⟩
  · intro r hr
    simp only [GameState.accept, GameState.delete, List.mem_filter] at hr
    exact hr.1
  · unfold postLeak; rfl
  · rcases accept_epoch_eq s P st' pos with ⟨hepP, hepQ, htL_eq, _⟩
    intro hcu
    rcases hcu with ⟨htr, hcp⟩
    refine ⟨?_, ?_⟩
    · intro r hr
      have hr0 : r ∈ s.trans := by
        simp only [GameState.accept, GameState.delete, List.mem_filter] at hr
        exact hr.1
      have hle0 := htr r hr0
      by_cases hP : r.pos.sender = P
      · rw [hP, hepP]
        rw [hP] at hle0
        exact le_trans hle0 (le_max_left _ _)
      · rw [hepQ r.pos.sender hP]
        exact hle0
    · intro p hp
      have hp0 : p ∈ s.comp := by
        simp only [GameState.accept, GameState.delete, List.mem_filter] at hp
        exact hp.1
      rw [htL_eq]
      exact hcp p hp0
  · intro hsend
    refine ⟨?_, ?_⟩
    · simp only [GameState.accept, GameState.delete]
      exact step2_deliver_aux_filter_map_delete_pos s.trans pos hsend
    · intro τ hτ
      simp only [GameState.accept, GameState.delete]
      exact step2_deliver_aux_filter_delete_pos_ne s.trans pos τ hτ

private theorem step2_deliver_aux_ct_beq_eq_decide (c1 c2 : ℕ × LibsignalCiphertextWithSalt32) :
    (c1 == c2) = @BEq.beq _ instBEqOfDecidableEq c1 c2 := by
  apply Bool.eq_iff_iff.mpr
  rw [ct_beq_iff_local]
  exact decide_eq_true_iff.symm

private theorem step2_deliver_aux_sim_fsRecv_multi_inl {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 : ℕ) (rs : RatchetReceiverState (BitVec 256) (BitVec 256))
    (h : Header Pt) (e : ℕ × LibsignalCiphertextWithSalt32)
    (rec_ : Option (Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)))
    (hM : MultiHS Pt) (tbl : ℕ → SessHSt Pt ℓ) :
    (simulateQ (pubFsImplOpt C ℓ encT idOf la)
      (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la).fsRecv
        ctx P t0 (.inl rs) h e rec_).run hM)).run (fun _ => false, tbl) =
    pure ((some (((lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rs h e).map
      fun o => (.inl o.1, o.2.1, o.2.2)), hM), (fun _ => false, tbl)) := by
  rw [hkMultiOpt_fsRecv]
  simp [hooksFSMultiDFBucketPaper, StateT.run_pure]

private theorem step2_deliver_aux_sim_fsRecv_multi_inr_phase2_deliver
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (hℓ : ℓ < 10 ^ 6) (tL : Option ℕ) (par : Bool)
    (ks : ℕ → BitVec 256)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 sIdx : ℕ) (c : Fig8C Pt)
    (r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (hM : MultiHS Pt) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv_s : ActiveSessInv C ℓ encT idOf (!((hM.book sIdx).getD {}).sCorr) (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((hM.book sIdx).getD {}) (tblM sIdx) (tblL sIdx))
    (hheal_match : healedBy ctx.tL 3 t0 = true →
      ((hM.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (c.1, c.2)) =
        some (r0.pos.idx, c.1, c.2)) :
    match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) c.1 c.2 with
    | none =>
      ∃ hM' sM' sL',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) c.1 c.2 (some r0)).run hM)).run (fun _ => false, tblM) =
          pure ((some none, hM'), (fun _ => false, Function.update tblM sIdx sM')) ∧
        hM'.cache = hM.cache ∧ hM'.fTable = hM.fTable ∧
        hM'.sessions = hM.sessions ∧ hM'.lfWin = hM.lfWin ∧
        (∀ i, i ≠ sIdx → hM'.book i = hM.book i) ∧
        ((hM'.book sIdx).getD {}).fsCount = ((hM.book sIdx).getD {}).fsCount ∧
        (healedBy ctx.tL 3 t0 = true →
          ((hM'.book sIdx).getD {}).fsTrans = ((hM.book sIdx).getD {}).fsTrans) ∧
        ActiveSessInv C ℓ encT idOf (!((hM'.book sIdx).getD {}).sCorr) (ks sIdx)
          (ssLoc sIdx) (rsLoc sIdx) ((hM'.book sIdx).getD {}) sM' sL'
    | some (rsLoc', idxOut, pmOut) =>
      ∃ hM' sM' sL',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) c.1 c.2 (some r0)).run hM)).run (fun _ => false, tblM) =
          pure ((some (some (.inr sIdx, idxOut, pmOut)), hM'),
            (fun _ => false, Function.update tblM sIdx sM')) ∧
        hM'.cache = hM.cache ∧ hM'.fTable = hM.fTable ∧
        hM'.sessions = hM.sessions ∧ hM'.lfWin = hM.lfWin ∧
        (∀ i, i ≠ sIdx → hM'.book i = hM.book i) ∧
        ((hM'.book sIdx).getD {}).fsCount = ((hM.book sIdx).getD {}).fsCount ∧
        (healedBy ctx.tL 3 t0 = true →
          ((hM'.book sIdx).getD {}).fsTrans =
            (((hM.book sIdx).getD {}).fsTrans).filter (·.1 != r0.pos.idx)) ∧
        ActiveSessInv C ℓ encT idOf (!((hM'.book sIdx).getD {}).sCorr) (ks sIdx)
          (ssLoc sIdx) rsLoc' ((hM'.book sIdx).getD {}) sM' sL' := by
  rcases c with ⟨hdr, idxC, ctC⟩
  dsimp only at hheal_match ⊢
  obtain ⟨hrt, hℓ'⟩ := hrt_and_len_check ℓ hℓ
  rw [hkMultiOpt_fsRecv]
  let bk := (hM.book sIdx).getD {}
  have hfind_eq :
      bk.fsTrans.find? (fun x =>
        @BEq.beq (Header Pt × (ℕ × LibsignalCiphertextWithSalt32))
          (@instBEqProd (Header Pt) (ℕ × LibsignalCiphertextWithSalt32)
            (@instBEqProd ℕ (Option Pt) instBEqOfDecidableEq Option.instBEq)
            instBEqOfDecidableEq) x.2 (hdr, (idxC, ctC))) =
      bk.fsTrans.find? (fun x => x.2 == (hdr, (idxC, ctC))) := by
    congr 1; funext x
    change (x.2.1 == hdr && @BEq.beq _ instBEqOfDecidableEq x.2.2 (idxC, ctC)) =
      (x.2.1 == hdr && x.2.2 == (idxC, ctC))
    rw [step2_deliver_aux_ct_beq_eq_decide x.2.2 (idxC, ctC)]
  cases hmatch : bk.fsTrans.find? (fun x => x.2 == (hdr, (idxC, ctC))) with
  | some mEntry =>
    obtain ⟨p, hpub, hdeliv⟩ := activeSessInv_deliver C hD hrt ℓ hℓ' encT idOf hinv_s hdr (idxC, ctC) hmatch
    cases hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) hdr (idxC, ctC) with
    | none =>
      rw [hrecv] at hdeliv
      obtain ⟨sM', sL', hstepM, _, hinv_s'⟩ := hdeliv
      refine ⟨hM, sM', sL', ?_, rfl, rfl, rfl, rfl, fun _ _ => rfl, rfl, fun _ => rfl, hinv_s'⟩
      dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
      simp only [StateT.run_bind, StateT.run_get, pure_bind]
      rw [hfind_eq, hmatch]
      simp only [Option.isNone, Option.isSome, Bool.false_and, Bool.not_true,
        Bool.false_eq_true, ↓reduceIte, StateT.run_bind, simulateQ_bind]
      rw [sim_liftFS_deliver_some_run C ℓ encT idOf false sIdx hdr idxC ctC p hpub hM tblM hstepM]
      simp [Option.map, withPub, StateT.run_pure]
    | some val =>
      rcases val with ⟨rsLoc', idxOut, pmOut⟩
      rw [hrecv] at hdeliv
      obtain ⟨_, sM', sL', hstepM, _, hp_eq, hinv_s'⟩ := hdeliv
      have hpm : (p, pmOut.2) = pmOut := by ext; exact hp_eq.symm; rfl
      let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
        { bk with fsTrans := bk.fsTrans.filter (·.1 != mEntry.1) }
      let hM' : MultiHS Pt := { hM with book := Function.update hM.book sIdx (some bk') }
      have hbk'_eq : (hM'.book sIdx).getD {} = bk' := by simp [hM']
      refine ⟨hM', sM', sL', ?_, rfl, rfl, rfl, rfl,
        (fun i hi => by simp [hM', Function.update_of_ne hi]),
        (by simp [hM', bk', bk]), ?_, ?_⟩
      · dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
        simp only [StateT.run_bind, StateT.run_get, pure_bind]
        rw [hfind_eq, hmatch]
        simp only [Option.isNone, Option.isSome, Bool.false_and, Bool.not_true,
          Bool.false_eq_true, ↓reduceIte, StateT.run_bind, simulateQ_bind]
        rw [sim_liftFS_deliver_some_run C ℓ encT idOf false sIdx hdr idxC ctC p hpub hM tblM hstepM]
        simp [Option.map, withPub, hpm, StateT.run_modify, StateT.run_pure,
          hM', bk', bk]
      · intro hh
        have hmEq := hheal_match hh
        change bk.fsTrans.find? (fun x => x.2 == (hdr, (idxC, ctC))) = some (r0.pos.idx, hdr, (idxC, ctC)) at hmEq
        rw [hmatch] at hmEq
        injection hmEq with hmEq'
        have hidx : mEntry.1 = r0.pos.idx := congrArg Prod.fst hmEq'
        simp [hM', bk', bk, hidx]
      · rw [hbk'_eq]
        have hsc : bk'.sCorr = bk.sCorr := rfl
        rw [hsc]
        exact hinv_s'
  | none =>
    have hheal_f : healedBy ctx.tL 3 t0 = false := by
      cases hh : healedBy ctx.tL 3 t0 with
      | false => rfl
      | true =>
        have hm := hheal_match hh
        change bk.fsTrans.find? (fun x => x.2 == (hdr, (idxC, ctC))) = _ at hm
        rw [hmatch] at hm; cases hm
    have hcorr_red :
        ∃ (hM_c : MultiHS Pt) (sM_c : SessHSt Pt ℓ),
          (simulateQ (pubFsImplOpt C ℓ encT idOf false)
            (((hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
                (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par false).fsRecv
              ctx P t0 (.inr sIdx) hdr (idxC, ctC) (some r0)).run hM)).run (fun _ => false, tblM) =
          (simulateQ (pubFsImplOpt C ℓ encT idOf false)
            (((hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
                (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par false).fsRecv
              ctx P t0 (.inr sIdx) hdr (idxC, ctC) (some r0)).run hM_c)).run
            (fun _ => false, Function.update tblM sIdx sM_c) ∧
          hM_c.cache = hM.cache ∧ hM_c.fTable = hM.fTable ∧
          hM_c.sessions = hM.sessions ∧ hM_c.lfWin = hM.lfWin ∧
          (∀ i, i ≠ sIdx → hM_c.book i = hM.book i) ∧
          ((hM_c.book sIdx).getD {}).sCorr = true ∧
          ((hM_c.book sIdx).getD {}).fsCount = bk.fsCount ∧
          ((hM_c.book sIdx).getD {}).fsTrans = bk.fsTrans ∧
          ActiveSessInv C ℓ encT idOf false (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
            ((hM_c.book sIdx).getD {}) sM_c (tblL sIdx) := by
      cases hsc : bk.sCorr with
      | false =>
        have hs0 : ActiveSessInv C ℓ encT idOf true (ks sIdx) (ssLoc sIdx) (rsLoc sIdx) bk (tblM sIdx) (tblL sIdx) := by
          have h := hinv_s
          change ActiveSessInv C ℓ encT idOf (!bk.sCorr) (ks sIdx) (ssLoc sIdx) (rsLoc sIdx) bk (tblM sIdx) (tblL sIdx) at h
          rw [hsc] at h; exact h
        have hinv_p2 := activeSessInv_to_phase2 C ℓ encT idOf (sL' := tblL sIdx) hs0
        obtain ⟨sM_c, hcs, hinv_c⟩ := activeSessInv_corruptSender C ℓ encT idOf hinv_p2
        let hM_c : MultiHS Pt :=
          { hM with book := Function.update hM.book sIdx (some { bk with sCorr := true }) }
        have hbkc_eq : (hM_c.book sIdx).getD {} = { bk with sCorr := true } := by simp [hM_c]
        have hsc_raw : ((hM.book sIdx).getD {}).sCorr = false := hsc
        have hfind_c :
            ((hM_c.book sIdx).getD {}).fsTrans.find? (fun x =>
              @BEq.beq (Header Pt × (ℕ × LibsignalCiphertextWithSalt32))
                (@instBEqProd (Header Pt) (ℕ × LibsignalCiphertextWithSalt32)
                  (@instBEqProd ℕ (Option Pt) instBEqOfDecidableEq Option.instBEq)
                  instBEqOfDecidableEq) x.2 (hdr, (idxC, ctC))) = none := by
          rw [hbkc_eq]; dsimp only; rw [hfind_eq, hmatch]
        refine ⟨hM_c, sM_c, ?_, rfl, rfl, rfl, rfl,
          (fun i hi => by simp [hM_c, Function.update_of_ne hi]),
          (by simp [hM_c]), (by simp [hM_c, bk]), (by simp [hM_c, bk]),
          (by rw [hbkc_eq]; exact hinv_c)⟩
        dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
        simp only [StateT.run_bind, StateT.run_get, pure_bind]
        rw [hfind_eq, hmatch, hfind_c]
        have hsc_c : ((hM_c.book sIdx).getD {}).sCorr = true := by simp [hM_c]
        simp only [Option.isNone, Option.isSome, hheal_f, hsc_raw, hsc_c,
          Bool.not_false, Bool.not_true, Bool.true_and, Bool.false_eq_true, ↓reduceIte,
          StateT.run_bind, simulateQ_bind]
        rw [sim_liftFS_corruptSender_run C ℓ encT idOf sIdx hM tblM hcs]
        simp [StateT.run_bind, StateT.run_modify, hM_c, bk]
      | true =>
        have hs0 : ActiveSessInv C ℓ encT idOf false (ks sIdx) (ssLoc sIdx) (rsLoc sIdx) bk (tblM sIdx) (tblL sIdx) := by
          have h := hinv_s
          change ActiveSessInv C ℓ encT idOf (!bk.sCorr) (ks sIdx) (ssLoc sIdx) (rsLoc sIdx) bk (tblM sIdx) (tblL sIdx) at h
          rw [hsc] at h; exact h
        refine ⟨hM, tblM sIdx, ?_, rfl, rfl, rfl, rfl, fun _ _ => rfl, hsc, rfl, rfl, hs0⟩
        rw [Function.update_eq_self]
    obtain ⟨hM_c, sM_c, hcs_eq, hc_cache, hc_ft, hc_sess, hc_lf, hc_oth, hbkc_sc, hbkc_cnt, hbkc_tr, hinv_c⟩ := hcorr_red
    rw [hcs_eq]
    let tblM_c := Function.update tblM sIdx sM_c
    have htblM_c_at : tblM_c sIdx = sM_c := by simp [tblM_c]
    have hmatch_c : ((hM_c.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (hdr, (idxC, ctC))) = none := by
      rw [hbkc_tr]; exact hmatch
    have hfind_c :
        ((hM_c.book sIdx).getD {}).fsTrans.find? (fun x =>
          @BEq.beq (Header Pt × (ℕ × LibsignalCiphertextWithSalt32))
            (@instBEqProd (Header Pt) (ℕ × LibsignalCiphertextWithSalt32)
              (@instBEqProd ℕ (Option Pt) instBEqOfDecidableEq Option.instBEq)
              instBEqOfDecidableEq) x.2 (hdr, (idxC, ctC))) = none := by
      rw [hbkc_tr, hfind_eq, hmatch]
    cases hpub : lPubOf protoSignalCodec ctC with
    | none =>
      have hrecv_none :
          (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) hdr (idxC, ctC) = none := by
        rw [lFS_receive_eq, hpub]
      rw [hrecv_none]
      refine ⟨hM_c, sM_c, tblL sIdx, ?_, hc_cache, hc_ft, hc_sess, hc_lf, hc_oth, hbkc_cnt,
        (fun hh => by rw [hheal_f] at hh; cases hh),
        (by rw [hbkc_sc]; exact hinv_c)⟩
      dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
      simp only [StateT.run_bind, StateT.run_get, pure_bind]
      rw [hfind_c]
      simp only [Option.isNone, Option.isSome, hheal_f, hbkc_sc, Bool.not_false, Bool.not_true,
        Bool.true_and, Bool.false_eq_true, ↓reduceIte, StateT.run_bind,
        simulateQ_bind]
      rw [sim_liftFS_inject_none_run C ℓ encT idOf false sIdx hdr idxC ctC hpub hM_c tblM_c]
      simp [StateT.run_pure, tblM_c]
    | some p =>
      have hinj := activeSessInv_inject_phase2 C ℓ encT idOf hinv_c hbkc_sc hdr (idxC, ctC) hmatch_c p hpub
      cases hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) hdr (idxC, ctC) with
      | none =>
        rw [hrecv] at hinj
        obtain ⟨sM', hstep_inj, hinv_c'⟩ := hinj
        have hstep_inj' : (injectH (lAeadR C protoSignalCodec ℓ encT idOf) (lChainPRG C.F) maxForwardJumps
            (hp 0 0 false) (DG (lChainPRG C.F)) (none : Option (SpecialOps _ _ _ ProbComp))
            ((hdr, p), (idxC, ctC))).run (tblM_c sIdx) = pure (some .rejected, sM') := by
          rwa [htblM_c_at]
        refine ⟨hM_c, sM', tblL sIdx, ?_, hc_cache, hc_ft, hc_sess, hc_lf, hc_oth, hbkc_cnt,
          (fun hh => by rw [hheal_f] at hh; cases hh),
          (by rw [hbkc_sc]; exact hinv_c')⟩
        dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
        simp only [StateT.run_bind, StateT.run_get, pure_bind]
        rw [hfind_c]
        simp only [Option.isNone, Option.isSome, hheal_f, hbkc_sc, Bool.not_false, Bool.not_true,
          Bool.true_and, Bool.false_eq_true, ↓reduceIte, StateT.run_bind,
          simulateQ_bind]
        rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx hdr idxC ctC p hpub hM_c tblM_c hstep_inj']
        simp [Option.map, withPub, StateT.run_pure, tblM_c, Function.update_idem]
      | some val =>
        rcases val with ⟨rsLoc', idxOut, pmOut⟩
        rw [hrecv] at hinj
        obtain ⟨sM', hstep_inj, hp_eq, hinv_c'⟩ := hinj
        have hpm : (p, pmOut.2) = pmOut := by ext; exact hp_eq.symm; rfl
        have hstep_inj' : (injectH (lAeadR C protoSignalCodec ℓ encT idOf) (lChainPRG C.F) maxForwardJumps
            (hp 0 0 false) (DG (lChainPRG C.F)) (none : Option (SpecialOps _ _ _ ProbComp))
            ((hdr, p), (idxC, ctC))).run (tblM_c sIdx) = pure (some (.accepted idxOut (some pmOut.2)), sM') := by
          rwa [htblM_c_at]
        let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
          { (hM_c.book sIdx).getD {} with
            fsTrans := ((hM_c.book sIdx).getD {}).fsTrans.filter (·.1 != idxOut) }
        let hM' : MultiHS Pt := { hM_c with book := Function.update hM_c.book sIdx (some bk') }
        have hbk'_eq : (hM'.book sIdx).getD {} = bk' := by simp [hM']
        have hsc' : bk'.sCorr = true := by dsimp only [bk']; exact hbkc_sc
        refine ⟨hM', sM', tblL sIdx, ?_, hc_cache, hc_ft, hc_sess, hc_lf,
          (fun i hi => by simp [hM', Function.update_of_ne hi, hc_oth i hi]),
          (by simp [hM', bk', bk, hbkc_cnt]),
          (fun hh => by rw [hheal_f] at hh; cases hh),
          (by rw [hbk'_eq, hsc']; exact hinv_c')⟩
        dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
        simp only [StateT.run_bind, StateT.run_get, pure_bind]
        rw [hfind_c]
        simp only [Option.isNone, Option.isSome, hheal_f, hbkc_sc, Bool.not_false, Bool.not_true,
          Bool.true_and, Bool.false_eq_true, ↓reduceIte, StateT.run_bind,
          simulateQ_bind]
        rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx hdr idxC ctC p hpub hM_c tblM_c hstep_inj']
        simp [Option.map, withPub, hpm, StateT.run_modify, StateT.run_pure,
          tblM_c, Function.update_idem, hM', bk']

