    (Tc : Pt) (σc : BitVec 256) (kVal : BitVec 256)
    (hcache : esLoc.h.cache t0 = some (Tc, σc, kVal)) :
    ((hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks).startRecv
      esLoc.g P t0 γ0 σ0 Tc).run esLoc.h =
    pure (some (some (((dhScheme Dh).receive γ0 Tc).1, σc,
