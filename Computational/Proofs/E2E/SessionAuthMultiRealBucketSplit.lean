/-- Glue theorem for `SessionAuthMultiReal.localAuthDFPaperBucketRaw_le_multiSessRealWinProb`
(`SessionAuthMultiRealBucket.lean`). -/
theorem localAuthDFPaperBucketRaw_le_multiSessRealWinProb_split
    (ℓ : ℕ) (Pt : Type) [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey)
    (hinj : Function.Injective encT) (hdum : ∀ T, encT T ≠ dummyKey)
    (idOf : Party → IdentityKey) (lam : Pt) (hℓ : ℓ < 10 ^ 6)
    (q qep : ℕ) (tL : Option ℕ) (par : Bool)
    (A : AdversaryDF (Fig8St Pt) (LibsignalMsgPublicPart × Plain ℓ) (BitVec 256) (Fig8C Pt))
    (hq : MakesAtMostQueriesDF A q)
    (hsh : SendMsgsOkDF (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) A) :
    let Adv := fun la =>
      multiSessPubToAD protoSignalCodec
        (redFSAuthDFPaperMultiBucket (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
          (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 1 4 qep la tL par A)
    𝒟[localAuthDFPaperBucketRaw (dhScheme Dh) (rootPRNG C.F encPt)
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 1 qep tL par A] {true} ≤
      multiSessRealWinProb C ℓ encT idOf Adv false +
        multiSessRealWinProb C ℓ encT idOf Adv true := by
  intro Adv
  by_cases hq0 : q = 0
  · subst hq0
    have hzero := localAuthDFPaperBucketOpt_eq_zero_of_q_zero none
      (dhScheme Dh) (rootPRNG C.F encPt)
      (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 1 qep tL par A hq
    dsimp only [localAuthDFPaperBucketOpt] at hzero
    rw [hzero]
    simp
  · have hq_pos : 0 < q := Nat.pos_of_ne_zero hq0
    let M := ((qep + 2) - healEpoch tL) * q
    refine le_multiSessRealWinProb_of_perKey_local C ℓ encT idOf Adv
      (localAuthDFPaperBucketRaw (dhScheme Dh) (rootPRNG C.F encPt)
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 1 qep tL par A)
      (fun ks => localSlotBucketOptAt none q M ks (dhScheme Dh) (rootPRNG C.F encPt)
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam qep tL par A)
      M (0 : BitVec 256)
      (localAuthBucketOpt_le_sampleVec (dhScheme Dh) (rootPRNG C.F encPt)
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 0 q M qep hq_pos none tL par A hq)
      (fun la => multiSessPubToAD_offRange protoSignalCodec _ M
        (redFSAuthDFPaperMultiBucket_offRange_raw ℓ Pt C Dh encPt encT idOf lam q qep tL par la A hq))
      (fun ks bs => ?_)
    dsimp only [Adv]
    rw [simulateQ_sessLift_multiSessPubToAD_eq_pubFsMultiImpl,
      simulateQ_sessLift_multiSessPubToAD_eq_pubFsMultiImpl]
    exact localSlotBucketRaw_leAdd_pubFs C Dh hD encPt encT hinj hdum idOf lam hℓ
      q qep hq_pos tL par ks bs A hq hsh

