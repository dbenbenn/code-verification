private theorem commitE_map_step
    {Γ CCoins T Sig SS RS M E HS₁ HS₂ : Type} [DecidableEq M] [DecidableEq T] [DecidableEq E]
    [Inhabited E]
    {Inv : ℕ → HS₁ → Prop} {f : HS₁ → HS₂}
    {hk₁ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₁ Γ T Sig SS RS M E CCoins Γ Sig SS RS}
    {hk₂ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₂ Γ T Sig SS RS M E CCoins Γ Sig SS RS}
    (hH : HooksMapStep Inv f hk₁ hk₂)
    (s : Ctx Γ T Sig SS RS M E) (P : Party) (old new : VP Γ T Sig SS RS) (pos : Pos)
    (es : EState (VP Γ T Sig SS RS) M (Header T × E) HS₁) :
    Prod.map id (mapEStateH f) <$> (commitE hk₁ s P old new pos).run es =
      (commitE hk₂ s P old new pos).run (mapEStateH f es) ∧
    ∀ z ∈ support ((commitE hk₁ s P old new pos).run es), z.2.h = es.h := by
  obtain ⟨res, hr1, hr2⟩ := hH.commit_pure (s.accept P new pos) P old new
  unfold commitE abortE
  dsimp only
  simp only [StateT.run_bind, liftH_run_eq, bind_assoc, pure_bind]
  have hfe : (mapEStateH f es).h = f es.h := rfl
  rw [hfe, hr1, hr2]
  rcases res with _ | new' <;>
    simp [StateT.run_pure, StateT.run_modify, Prod.map, mapEStateH]

