private theorem step1_deliver_aux_fsRecv_inr_matched
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (hℓ : ℓ < 10 ^ 6) (tL : Option ℕ) (par : Bool)
    (ks : ℕ → BitVec 256)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 sIdx : ℕ) (c : Fig8C Pt)
    (r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (hM : MultiHS Pt) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hscorr : ((hM.book sIdx).getD {}).sCorr = false)
    (hinv_s : ActiveSessInv C ℓ encT idOf (!((hM.book sIdx).getD {}).sCorr) (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((hM.book sIdx).getD {}) (tblM sIdx) (tblL sIdx))
    (hmatch : ((hM.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (c.1, c.2)) =
      some (r0.pos.idx, c.1, c.2)) :
    match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) c.1 c.2 with
    | none =>
      ∃ sM' sL',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) c.1 c.2 (some r0)).run hM)).run (fun _ => false, tblM) =
          pure ((some none, hM), (fun _ => false, Function.update tblM sIdx sM')) ∧
        (simulateQ (pubFsImplOpt C ℓ encT idOf true)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par true).fsRecv
            ctx P t0 (.inr sIdx) c.1 c.2 (some r0)).run hM)).run (fun _ => false, tblL) =
          pure ((some none, hM), (fun _ => false, Function.update tblL sIdx sL')) ∧
        ActiveSessInv C ℓ encT idOf (!((hM.book sIdx).getD {}).sCorr) (ks sIdx)
          (ssLoc sIdx) (rsLoc sIdx) ((hM.book sIdx).getD {}) sM' sL'
    | some (rsLoc', idxOut, pmOut) =>
      ∃ hM' sM' sL',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) c.1 c.2 (some r0)).run hM)).run (fun _ => false, tblM) =
          pure ((some (some (.inr sIdx, idxOut, pmOut)), hM'),
            (fun _ => false, Function.update tblM sIdx sM')) ∧
        (simulateQ (pubFsImplOpt C ℓ encT idOf true)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par true).fsRecv
            ctx P t0 (.inr sIdx) c.1 c.2 (some r0)).run hM)).run (fun _ => false, tblL) =
          pure ((some (some (.inr sIdx, idxOut, pmOut)), hM'),
            (fun _ => false, Function.update tblL sIdx sL')) ∧
        hM'.cache = hM.cache ∧ hM'.fTable = hM.fTable ∧
        hM'.sessions = hM.sessions ∧ hM'.lfWin = hM.lfWin ∧
        (∀ i, i ≠ sIdx → hM'.book i = hM.book i) ∧
        ((hM'.book sIdx).getD {}).sCorr = false ∧
        ((hM'.book sIdx).getD {}).fsCount = ((hM.book sIdx).getD {}).fsCount ∧
        ((hM'.book sIdx).getD {}).fsTrans =
          (((hM.book sIdx).getD {}).fsTrans).filter (·.1 != r0.pos.idx) ∧
        ActiveSessInv C ℓ encT idOf (!((hM'.book sIdx).getD {}).sCorr) (ks sIdx)
          (ssLoc sIdx) rsLoc' ((hM'.book sIdx).getD {}) sM' sL' := by
  rcases c with ⟨hdr, idxC, ctC⟩
  dsimp only at hmatch ⊢
  obtain ⟨hrt, hℓ'⟩ := hrt_and_len_check ℓ hℓ
  let bk := (hM.book sIdx).getD {}
  have hphase1 : (!bk.sCorr) = true := by dsimp only [bk]; rw [hscorr]; rfl
  have hfind_eq :
      bk.fsTrans.find? (fun x =>
        @BEq.beq (Header Pt × (ℕ × LibsignalCiphertextWithSalt32))
          (@instBEqProd (Header Pt) (ℕ × LibsignalCiphertextWithSalt32)
            (@instBEqProd ℕ (Option Pt) instBEqOfDecidableEq Option.instBEq)
            instBEqOfDecidableEq) x.2 (hdr, (idxC, ctC))) =
      bk.fsTrans.find? (fun x => x.2 == (hdr, (idxC, ctC))) := by
    congr 1; funext x
    change (x.2.1 == hdr && @BEq.beq _ instBEqOfDecidableEq x.2.2 (idxC, ctC)) =
      (x.2.1 == hdr && x.2.2 == (idxC, ctC))
    rw [step1_deliver_aux_ct_beq_eq_decide x.2.2 (idxC, ctC)]
  obtain ⟨p, hpub, hdeliv⟩ := activeSessInv_deliver C hD hrt ℓ hℓ' encT idOf hinv_s hdr (idxC, ctC) hmatch
  cases hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) hdr (idxC, ctC) with
  | none =>
    rw [hrecv] at hdeliv
    obtain ⟨sM', sL', hstepM, hstepL_imp, hinv_s'⟩ := hdeliv
    have hstepL := hstepL_imp hphase1
    refine ⟨sM', sL', ?_, ?_, hinv_s'⟩
    · rw [hkMultiOpt_fsRecv]
      dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
      simp only [StateT.run_bind, StateT.run_get, pure_bind]
      rw [hfind_eq, hmatch]
      simp only [Option.isNone, Option.isSome, Bool.false_and, Bool.not_true,
        Bool.false_eq_true, ↓reduceIte, StateT.run_bind, simulateQ_bind]
      rw [sim_liftFS_deliver_some_run C ℓ encT idOf false sIdx hdr idxC ctC p hpub hM tblM hstepM]
      simp [Option.map, withPub, StateT.run_pure]
    · rw [hkMultiOpt_fsRecv]
      dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
      simp only [StateT.run_bind, StateT.run_get, pure_bind]
      rw [hfind_eq, hmatch]
      simp only [Option.isNone, Option.isSome, Bool.true_and, Bool.false_and, Bool.not_true,
        Bool.false_eq_true, ↓reduceIte, StateT.run_bind, simulateQ_bind]
      rw [sim_liftFS_deliver_some_run C ℓ encT idOf true sIdx hdr idxC ctC p hpub hM tblL hstepL]
      simp [Option.map, withPub, StateT.run_pure]
  | some val =>
    rcases val with ⟨rsLoc', idxOut, pmOut⟩
    rw [hrecv] at hdeliv
    obtain ⟨_, sM', sL', hstepM, hstepL_imp, hp_eq, hinv_s'⟩ := hdeliv
    have hstepL := hstepL_imp hphase1
    have hpm : (p, pmOut.2) = pmOut := by ext; exact hp_eq.symm; rfl
    let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
      { bk with fsTrans := bk.fsTrans.filter (·.1 != r0.pos.idx) }
    let hM' : MultiHS Pt := { hM with book := Function.update hM.book sIdx (some bk') }
    have hbk'_eq : (hM'.book sIdx).getD {} = bk' := by simp [hM']
    have hbk'_sc : bk'.sCorr = false := hscorr
    refine ⟨hM', sM', sL', ?_, ?_, rfl, rfl, rfl, rfl,
      fun i hi => by simp [hM', Function.update_of_ne hi],
      by rw [hbk'_eq]; exact hbk'_sc,
      by simp [hM', bk', bk],
      by simp [hM', bk', bk], ?_⟩
    · rw [hkMultiOpt_fsRecv]
      dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
      simp only [StateT.run_bind, StateT.run_get, pure_bind]
      rw [hfind_eq, hmatch]
      simp only [Option.isNone, Option.isSome, Bool.false_and, Bool.not_true,
        Bool.false_eq_true, ↓reduceIte, StateT.run_bind, simulateQ_bind]
      rw [sim_liftFS_deliver_some_run C ℓ encT idOf false sIdx hdr idxC ctC p hpub hM tblM hstepM]
      simp [Option.map, withPub, hpm, StateT.run_modify, StateT.run_pure,
        hM', bk', bk]
    · rw [hkMultiOpt_fsRecv]
      dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
      simp only [StateT.run_bind, StateT.run_get, pure_bind]
      rw [hfind_eq, hmatch]
      simp only [Option.isNone, Option.isSome, Bool.true_and, Bool.false_and, Bool.not_true,
        Bool.false_eq_true, ↓reduceIte, StateT.run_bind, simulateQ_bind]
      rw [sim_liftFS_deliver_some_run C ℓ encT idOf true sIdx hdr idxC ctC p hpub hM tblL hstepL]
      simp [Option.map, withPub, hpm, StateT.run_modify, StateT.run_pure,
        hM', bk', bk]
    · rw [hbk'_eq]
      have hsc_eq : bk'.sCorr = bk.sCorr := rfl
      rw [hsc_eq]
      exact hinv_s'

private theorem step1_deliver_aux_slot_inj {q he t1 t2 j1 j2 : ℕ}
    (hh1 : he ≤ t1) (hh2 : he ≤ t2) (hj1 : j1 < q) (hj2 : j2 < q)
    (heq : q * (t1 - he) + j1 = q * (t2 - he) + j2) :
    t1 = t2 ∧ j1 = j2 := by
  have hsub : t1 - he = t2 - he := by
    rcases lt_trichotomy (t1 - he) (t2 - he) with hlt | h_eq | hgt
    · exfalso
      have hle : q * (t1 - he + 1) ≤ q * (t2 - he) := Nat.mul_le_mul_left q hlt
      rw [Nat.mul_add, Nat.mul_one] at hle
      omega
    · exact h_eq
    · exfalso
      have hle : q * (t2 - he + 1) ≤ q * (t1 - he) := Nat.mul_le_mul_left q hgt
      rw [Nat.mul_add, Nat.mul_one] at hle
      omega
  have ht : t1 = t2 := by omega
  subst ht
  exact ⟨rfl, by omega⟩

private theorem step1_deliver_aux_matched_of_pin {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ q qep rem : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256} {phase1 : Bool}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ}
    {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks phase1 rem ssLoc rsLoc esLoc esM esL tblM tblL)
    {P : Party} {c : Fig8C Pt} {r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    (hinT : esLoc.g.inTransit P.other c = some r0)
    (hP_other : P.other = Party.senderOf c.1.1)
    (hct : r0.ct = c)
    {sIdx : ℕ}
    (hheal : healedBy esLoc.g.tL 3 c.1.1 = true)
    (hro : esLoc.g.epoch (Party.receiverOf c.1.1) < c.1.1 ∨
      (esM.g.st (Party.receiverOf c.1.1)).vR c.1.1 = some (.inr sIdx))
    (hpin : (c.1.1 = 0 ∧ sIdx = 0 ∧ inStage2BucketGen 4 tL par 0 = true ∧ tL = none) ∨
      (1 ≤ c.1.1 ∧ ∃ Tc σc kMulti, esM.h.cache c.1.1 = some (Tc, σc, kMulti, some sIdx))) :
    ((esM.h.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (c.1, c.2)) =
      some (r0.pos.idx, c.1, c.2) := by
  have hbt := hinv.healed_book_trans c.1.1 sIdx hheal hro hpin
  have hc_eta : (c.1, c.2) = c := Prod.eta c
  simp only [hc_eta]
  rw [hbt]
  have hff := find_filter_map_trans esLoc.g.trans P c hP_other (fun r hr =>
    ⟨(hinv.trans_meta r hr).1.symm, (hinv.trans_meta r hr).2.1⟩)
  rw [hff]
  change (esLoc.g.inTransit P.other c).map (fun r => (r.pos.idx, r.ct.1, r.ct.2)) = _
  rw [hinT]
  simp [hct]

private theorem step1_deliver_aux_accept_inv_inl {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ q qep rem : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM : MultiES Pt ℓ}
    {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL)
    {P : Party} {t0 : ℕ} {r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    (hep : r0.pos.epoch = t0)
    (hP_rec : P = Party.receiverOf t0)
    (hns : P.sendsIn t0 = false)
    (ht0_le : t0 ≤ esLoc.g.epoch P + 1)
    {stLoc' : LocVP Pt} {stM' : MultiVP Pt}
    {rs' : RatchetReceiverState (BitVec 256) (BitVec 256)}
    (hid : stLoc'.id = P ∧ stM'.id = P)
    (htcur : stLoc'.tcur = max (esLoc.g.epoch P) t0 ∧ stM'.tcur = max (esLoc.g.epoch P) t0)
    (hγ : stLoc'.γ = stM'.γ)
    (hroot : stLoc'.root = stM'.root)
    (hcka : stLoc'.curCkaMsg = (esLoc.g.st P).curCkaMsg ∧ stM'.curCkaMsg = (esM.g.st P).curCkaMsg)
    (hvS : stLoc'.vS = (esLoc.g.st P).vS ∧ stM'.vS = (esM.g.st P).vS)
    (hvR_loc : stLoc'.vR = Function.update (esLoc.g.st P).vR t0 (some rs'))
    (hvR_M : stM'.vR = Function.update (esM.g.st P).vR t0 (some (.inl rs'))) :
    BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc rsLoc
      { esLoc with g := esLoc.g.accept P stLoc' r0.pos }
      { esM with g := esM.g.accept P stM' r0.pos }
      { esM with g := esM.g.accept P stM' r0.pos }
      tblM tblL := by
  obtain ⟨hpl0, _, hscorr0⟩ := hinv.phase1_props rfl
  let gLoc' := esLoc.g.accept P stLoc' r0.pos
  let gM' := esM.g.accept P stM' r0.pos
  obtain ⟨hepP_raw, hepQ, _, _⟩ := accept_epoch_eq esLoc.g P stLoc' r0.pos
  have hepP : gLoc'.epoch P = max (esLoc.g.epoch P) t0 := by
    change (esLoc.g.accept P stLoc' r0.pos).epoch P = _; rw [hepP_raw, hep]
  have hep_mono : ∀ Q, esLoc.g.epoch Q ≤ gLoc'.epoch Q := by
    intro Q
    by_cases hQ : Q = P
    · subst Q; rw [hepP]; exact le_max_left _ _
    · rw [hepQ Q hQ]
  obtain ⟨hwin_eq, htL_eq, hleaks_eq, _, hidx_eq, htrans_sub, hpl_eq, hcu_imp, _⟩ :=
    step1_deliver_aux_accept_preserve_props esLoc.g P stLoc' r0.pos tL
  have hstLoc_P : gLoc'.st P = stLoc' := by simp [gLoc', GameState.accept, GameState.delete]
  have hstM_P : gM'.st P = stM' := by simp [gM', GameState.accept, GameState.delete]
  have hstLoc_ne : ∀ Q, Q ≠ P → gLoc'.st Q = esLoc.g.st Q := fun Q hQ => by
    simp [gLoc', GameState.accept, GameState.delete, Function.update_of_ne hQ]
  have hstM_ne : ∀ Q, Q ≠ P → gM'.st Q = esM.g.st Q := fun Q hQ => by
    simp [gM', GameState.accept, GameState.delete, Function.update_of_ne hQ]
  refine
    { gsync := hinv.gsync.accept_sync P stLoc' stM' r0.pos
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := by dsimp only; rw [hwin_eq]; exact hinv.win_false
      lfWin_M := hinv.lfWin_M
      comp_unhealed := hcu_imp hinv.comp_unhealed
      tL_mem_leaks := fun cur hcur => by
        dsimp only at hcur ⊢
        rw [htL_eq] at hcur; rw [hleaks_eq]
        exact hinv.tL_mem_leaks cur hcur
      phase1_props := fun _ => ⟨by dsimp only; rw [← hpl_eq]; exact hpl0, rfl, hscorr0⟩
      phase2_props := fun hp => Bool.noConfusion hp
      sess_eq := hinv.sess_eq
      sess_nodup := hinv.sess_nodup
      sess_zero_le := hinv.sess_zero_le
      sess_pos_bound := fun τ hτ =>
        le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
      sess_epoch_ok := hinv.sess_epoch_ok
      fTable_M_iff := hinv.fTable_M_iff
      fTable_loc_eq := hinv.fTable_loc_eq
      cache_sync := hinv.cache_sync
      vp_id := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P]; exact hid
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]; exact hinv.vp_id Q
      vp_tcur_eq := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P, hepP]; exact htcur
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ, hepQ Q hQ]; exact hinv.vp_tcur_eq Q
      vp_γ_eq := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P]; exact hγ
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]; exact hinv.vp_γ_eq Q
      vp_root_eq := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P]; exact hroot
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]; exact hinv.vp_root_eq Q
      vp_cka_eq := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P, hcka.1, hcka.2]; exact hinv.vp_cka_eq P
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]; exact hinv.vp_cka_eq Q
      vp_cka_cache := fun Q hQs => by
        dsimp only at hQs ⊢
        by_cases hQ : Q = P
        · subst Q
          by_cases hle : t0 ≤ esLoc.g.epoch P
          · have hmax : max (esLoc.g.epoch P) t0 = esLoc.g.epoch P := Nat.max_eq_left hle
            rw [hepP, hmax] at hQs ⊢
            rw [hstLoc_P, hstM_P, hcka.1, hvS.2]
            exact hinv.vp_cka_cache P hQs
          · have hmax : max (esLoc.g.epoch P) t0 = t0 := Nat.max_eq_right (by omega)
            rw [hepP, hmax, hns] at hQs
            cases hQs
        · rw [hepQ Q hQ] at hQs ⊢
          rw [hstLoc_ne Q hQ, hstM_ne Q hQ]
          exact hinv.vp_cka_cache Q hQs
      epoch_bound := fun Q => by
        dsimp only
        have h0 := hinv.epoch_bound Q
        by_cases hQ : Q = P
        · subst Q; rw [hepP]; omega
        · rw [hepQ Q hQ]; omega
      vS_sync := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P, hvS.1, hvS.2]
          rcases hinv.vS_sync P with h1 | h2 | ⟨ts, j, hts_le, hts_imp, hrest⟩
          · exact Or.inl h1
          · exact Or.inr (Or.inl h2)
          · refine Or.inr (Or.inr ⟨ts, j, le_trans hts_le (hep_mono P), ?_, hrest⟩)
            intro hPs
            by_cases hle : t0 ≤ esLoc.g.epoch P
            · have hmax : max (esLoc.g.epoch P) t0 = esLoc.g.epoch P := Nat.max_eq_left hle
              rw [hepP, hmax] at hPs ⊢
              exact hts_imp hPs
            · have hmax : max (esLoc.g.epoch P) t0 = t0 := Nat.max_eq_right (by omega)
              rw [hepP, hmax, hns] at hPs
              cases hPs
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ, hepQ Q hQ]
          exact hinv.vS_sync Q
      vR_dom := fun Q τ hsome => by
        dsimp only at hsome ⊢
        by_cases hQ : Q = P
        · subst Q; rw [hstM_P, hvR_M] at hsome
          by_cases hτ : τ = t0
          · subst τ; rw [hepP]; exact ⟨le_max_right _ _, hP_rec⟩
          · rw [Function.update_of_ne hτ] at hsome
            obtain ⟨hle0, hrec0⟩ := hinv.vR_dom P τ hsome
            exact ⟨le_trans hle0 (hep_mono P), hrec0⟩
        · rw [hstM_ne Q hQ] at hsome
          rw [hepQ Q hQ]
          exact hinv.vR_dom Q τ hsome
      vR_sync := fun Q τ => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P, hvR_loc, hvR_M]
          by_cases hτ : τ = t0
          · subst τ
            simp only [Function.update_self]
            exact Or.inr (Or.inl ⟨rs', rfl, rfl⟩)
          · rw [Function.update_of_ne hτ, Function.update_of_ne hτ]
            exact hinv.vR_sync P τ
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]
          exact hinv.vR_sync Q τ
      sess_inv := hinv.sess_inv
      ss_fresh := fun τ j h1 hhe hj hlt =>
        hinv.ss_fresh τ j h1 hhe hj (lt_of_le_of_lt (hep_mono _) hlt)
      rs_fresh := fun τ j h1 hhe hj hlt =>
        hinv.rs_fresh τ j h1 hhe hj (lt_of_le_of_lt (hep_mono _) hlt)
      book_fresh_before_send := fun τ j h1 hhe hj hlt hh => by
        dsimp only at hh ⊢
        rw [htL_eq] at hh
        exact hinv.book_fresh_before_send τ j h1 hhe hj (lt_of_le_of_lt (hep_mono _) hlt) hh
      trans_meta := fun r hr => by
        dsimp only at hr ⊢
        obtain ⟨h1, h2, h3, h4, h5⟩ := hinv.trans_meta r (htrans_sub r hr)
        exact ⟨h1, h2, le_trans h3 (hep_mono r.pos.sender), h4, h5⟩
      cache_empty_gt := fun τ hlt =>
        hinv.cache_empty_gt τ (lt_of_le_of_lt (hep_mono _) hlt)
      healed_sender_pin := fun Q τ j hQs hτ_eq hvS_M hh => by
        dsimp only at hQs hτ_eq hvS_M hh ⊢
        rw [htL_eq] at hh
        rw [hidx_eq]
        by_cases hQ : Q = P
        · subst Q
          by_cases hle : t0 ≤ esLoc.g.epoch P
          · have hmax : max (esLoc.g.epoch P) t0 = esLoc.g.epoch P := Nat.max_eq_left hle
            rw [hepP, hmax] at hQs hτ_eq
            rw [hstM_P, hvS.2] at hvS_M
            rw [hstM_P, hcka.2]
            exact hinv.healed_sender_pin P τ j hQs hτ_eq hvS_M hh
          · have hmax : max (esLoc.g.epoch P) t0 = t0 := Nat.max_eq_right (by omega)
            rw [hepP, hmax, hns] at hQs
            cases hQs
        · rw [hepQ Q hQ] at hQs hτ_eq
          rw [hstM_ne Q hQ] at hvS_M ⊢
          exact hinv.healed_sender_pin Q τ j hQs hτ_eq hvS_M hh
      healed_vR_pin := fun Q τ sIdx' hvRM hh => by
        dsimp only at hvRM hh ⊢
        rw [htL_eq] at hh
        by_cases hQ : Q = P
        · subst Q; rw [hstM_P, hvR_M] at hvRM
          by_cases hτ : τ = t0
          · subst τ; simp at hvRM
          · rw [Function.update_of_ne hτ] at hvRM
            exact hinv.healed_vR_pin P τ sIdx' hvRM hh
        · rw [hstM_ne Q hQ] at hvRM
          exact hinv.healed_vR_pin Q τ sIdx' hvRM hh
      healed_book_trans := fun τ sIdx' hh hro hp => by
        dsimp only at hh hro hp ⊢
        rw [htL_eq] at hh
        by_cases hτ : τ = t0
        · exfalso
          subst τ
          rw [← hP_rec] at hro
          rcases hro with hlt | hvR
          · rw [hepP] at hlt
            have : t0 ≤ max (esLoc.g.epoch P) t0 := le_max_right _ _
            omega
          · rw [hstM_P, hvR_M, Function.update_self] at hvR
            cases hvR
        · have hτ_ne : τ ≠ r0.pos.epoch := by rw [hep]; exact hτ
          have hflt : gLoc'.trans.filter (fun r => r.pos.epoch == τ) =
              esLoc.g.trans.filter (fun r => r.pos.epoch == τ) := by
            simp only [gLoc', GameState.accept, GameState.delete]
            exact step1_deliver_aux_filter_delete_pos_ne esLoc.g.trans r0.pos τ hτ_ne
          rw [hflt]
          have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
              (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
            rcases hro with hlt | hvR
            · exact Or.inl (lt_of_le_of_lt (hep_mono _) hlt)
            · right
              by_cases hQ : Party.receiverOf τ = P
              · rw [hQ] at hvR ⊢
                rw [hstM_P, hvR_M, Function.update_of_ne hτ] at hvR
                exact hvR
              · rw [hstM_ne _ hQ] at hvR
                exact hvR
          exact hinv.healed_book_trans τ sIdx' hh hro_orig hp }

private theorem step1_deliver_aux_accept_inv_inr {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ q qep rem : ℕ} (hq_pos : 0 < q)
    {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM : MultiES Pt ℓ}
    {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL)
    {P : Party} {t0 j sIdx : ℕ} {r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    (hr0_mem : r0 ∈ esLoc.g.trans)
    (hep : r0.pos.epoch = t0)
    (hP_rec : P = Party.receiverOf t0)
    (hns : P.sendsIn t0 = false)
    (hle_send : t0 ≤ esLoc.g.epoch (Party.senderOf t0))
    (ht0_le : t0 ≤ esLoc.g.epoch P + 1)
    (hqep_ok : !(qep + 1 < t0) = true)
    (hbk_ok : inStage2BucketGen 4 tL par t0 = true)
    (hnhe_ok : !(tL.isSome && (t0 == healEpoch tL)) = true)
    (hj_len : j < (esM.h.sessions t0).length)
    (hsIdx_eq : sIdx = q * (t0 - healEpoch tL) + j)
    (hro_pre : esLoc.g.epoch (Party.receiverOf t0) < t0 ∨
      (esM.g.st (Party.receiverOf t0)).vR t0 = some (.inr sIdx))
    (hpin_t0 : (t0 = 0 ∧ sIdx = 0 ∧ inStage2BucketGen 4 tL par 0 = true ∧ tL = none) ∨
      (1 ≤ t0 ∧ ∃ Tc σc kMulti, esM.h.cache t0 = some (Tc, σc, kMulti, some sIdx)))
    {stLoc' : LocVP Pt} {stM' : MultiVP Pt}
    {rs_new : RatchetReceiverState (BitVec 256) (BitVec 256)}
    {hM' : MultiHS Pt} {sM' sL' : SessHSt Pt ℓ}
    (hid : stLoc'.id = P ∧ stM'.id = P)
    (htcur : stLoc'.tcur = max (esLoc.g.epoch P) t0 ∧ stM'.tcur = max (esLoc.g.epoch P) t0)
    (hγ : stLoc'.γ = stM'.γ)
    (hroot : stLoc'.root = stM'.root)
    (hcka : stLoc'.curCkaMsg = (esLoc.g.st P).curCkaMsg ∧ stM'.curCkaMsg = (esM.g.st P).curCkaMsg)
    (hvS : stLoc'.vS = (esLoc.g.st P).vS ∧ stM'.vS = (esM.g.st P).vS)
    (hvR_loc : stLoc'.vR = Function.update (esLoc.g.st P).vR t0 (some rs_new))
    (hvR_M : stM'.vR = Function.update (esM.g.st P).vR t0 (some (.inr sIdx)))
    (hc_eq : hM'.cache = esM.h.cache)
    (hft_eq : hM'.fTable = esM.h.fTable)
    (hsess_eq : hM'.sessions = esM.h.sessions)
    (hlf_eq : hM'.lfWin = esM.h.lfWin)
    (hbook_ne : ∀ i, i ≠ sIdx → hM'.book i = esM.h.book i)
    (hscorr_at : ((hM'.book sIdx).getD {}).sCorr = false)
    (hcnt_at : ((hM'.book sIdx).getD {}).fsCount = ((esM.h.book sIdx).getD {}).fsCount)
    (htrans_at : ((hM'.book sIdx).getD {}).fsTrans =
      (((esM.h.book sIdx).getD {}).fsTrans).filter (·.1 != r0.pos.idx))
    (hinv_s' : ActiveSessInv C ℓ encT idOf (!((hM'.book sIdx).getD {}).sCorr) (ks sIdx)
      (ssLoc sIdx) rs_new ((hM'.book sIdx).getD {}) sM' sL') :
    BucketSimInv C ℓ encT idOf q qep tL par ks true rem
      ssLoc
      (Function.update rsLoc sIdx rs_new)
      { esLoc with g := esLoc.g.accept P stLoc' r0.pos }
      { esM with g := esM.g.accept P stM' r0.pos, h := hM' }
      { esM with g := esM.g.accept P stM' r0.pos, h := hM' }
      (Function.update tblM sIdx sM')
      (Function.update tblL sIdx sL') := by
  obtain ⟨hpl0, _, hscorr0⟩ := hinv.phase1_props rfl
  have hheal_t0 : healedBy esLoc.g.tL 3 t0 = true :=
    healedBy_of_inStage2BucketGen_phase1 hpl0 hbk_ok
  have hhe_t0 : healEpoch tL ≤ t0 := healEpoch_le_of_gen4 hbk_ok
  have hj_lt_q : j < q := by
    by_cases ht00 : t0 = 0
    · rw [ht00] at hj_len; exact lt_of_lt_of_le hj_len hinv.sess_zero_le
    · have h1 := hinv.sess_pos_bound t0 (by omega)
      omega
  let gLoc' := esLoc.g.accept P stLoc' r0.pos
  let gM' := esM.g.accept P stM' r0.pos
  obtain ⟨hepP_raw, hepQ, _, _⟩ := accept_epoch_eq esLoc.g P stLoc' r0.pos
  have hepP : gLoc'.epoch P = max (esLoc.g.epoch P) t0 := by
    change (esLoc.g.accept P stLoc' r0.pos).epoch P = _; rw [hepP_raw, hep]
  have hep_mono : ∀ Q, esLoc.g.epoch Q ≤ gLoc'.epoch Q := by
    intro Q
    by_cases hQ : Q = P
    · subst Q; rw [hepP]; exact le_max_left _ _
    · rw [hepQ Q hQ]
  obtain ⟨hwin_eq, htL_eq, hleaks_eq, _, hidx_eq, htrans_sub, hpl_eq, hcu_imp, hflt_imp⟩ :=
    step1_deliver_aux_accept_preserve_props esLoc.g P stLoc' r0.pos tL
  have hsend_tr : ∀ r ∈ esLoc.g.trans, r.pos.epoch = r0.pos.epoch → r.pos.sender = r0.pos.sender := by
    intro r hr heq_ep
    rw [(hinv.trans_meta r hr).2.1, (hinv.trans_meta r0 hr0_mem).2.1, heq_ep]
  obtain ⟨hflt_eq_pos, hflt_ne_pos⟩ := hflt_imp hsend_tr
  have hstLoc_P : gLoc'.st P = stLoc' := by simp [gLoc', GameState.accept, GameState.delete]
  have hstM_P : gM'.st P = stM' := by simp [gM', GameState.accept, GameState.delete]
  have hstLoc_ne : ∀ Q, Q ≠ P → gLoc'.st Q = esLoc.g.st Q := fun Q hQ => by
    simp [gLoc', GameState.accept, GameState.delete, Function.update_of_ne hQ]
  have hstM_ne : ∀ Q, Q ≠ P → gM'.st Q = esM.g.st Q := fun Q hQ => by
    simp [gM', GameState.accept, GameState.delete, Function.update_of_ne hQ]
  have hcnt_all : ∀ i, ((hM'.book i).getD {}).fsCount = ((esM.h.book i).getD {}).fsCount := by
    intro i
    by_cases hi : i = sIdx
    · subst i; exact hcnt_at
    · rw [hbook_ne i hi]
  have hscorr_all : ∀ i, ((hM'.book i).getD {}).sCorr = false := by
    intro i
    by_cases hi : i = sIdx
    · subst i; exact hscorr_at
    · rw [hbook_ne i hi]; exact hscorr0 i
  refine
    { gsync := hinv.gsync.accept_sync P stLoc' stM' r0.pos
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := by dsimp only; rw [hwin_eq]; exact hinv.win_false
      lfWin_M := by dsimp only; rw [hlf_eq]; exact hinv.lfWin_M
      comp_unhealed := hcu_imp hinv.comp_unhealed
      tL_mem_leaks := fun cur hcur => by
        dsimp only at hcur ⊢
        rw [htL_eq] at hcur; rw [hleaks_eq]
        exact hinv.tL_mem_leaks cur hcur
      phase1_props := fun _ => ⟨by dsimp only; rw [← hpl_eq]; exact hpl0, rfl, hscorr_all⟩
      phase2_props := fun hp => Bool.noConfusion hp
      sess_eq := by dsimp only; rw [hsess_eq]; exact hinv.sess_eq
      sess_nodup := fun τ => by dsimp only; rw [hsess_eq]; exact hinv.sess_nodup τ
      sess_zero_le := by dsimp only; rw [hsess_eq]; exact hinv.sess_zero_le
      sess_pos_bound := fun τ hτ => by
        dsimp only; rw [hsess_eq]
        exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
      sess_epoch_ok := fun τ hne => by
        dsimp only at hne; rw [hsess_eq] at hne; exact hinv.sess_epoch_ok τ hne
      fTable_M_iff := fun τ ik => by
        dsimp only; rw [hft_eq, hsess_eq]; exact hinv.fTable_M_iff τ ik
      fTable_loc_eq := fun τ ik => by
        dsimp only; rw [hsess_eq]; exact hinv.fTable_loc_eq τ ik
      cache_sync := fun τ => by
        dsimp only; rw [hc_eq, hsess_eq]; exact hinv.cache_sync τ
      vp_id := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P]; exact hid
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]; exact hinv.vp_id Q
      vp_tcur_eq := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P, hepP]; exact htcur
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ, hepQ Q hQ]; exact hinv.vp_tcur_eq Q
      vp_γ_eq := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P]; exact hγ
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]; exact hinv.vp_γ_eq Q
      vp_root_eq := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P]; exact hroot
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]; exact hinv.vp_root_eq Q
      vp_cka_eq := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P, hcka.1, hcka.2]; exact hinv.vp_cka_eq P
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]; exact hinv.vp_cka_eq Q
      vp_cka_cache := fun Q hQs => by
        dsimp only at hQs ⊢
        rw [hc_eq]
        by_cases hQ : Q = P
        · subst Q
          by_cases hle : t0 ≤ esLoc.g.epoch P
          · have hmax : max (esLoc.g.epoch P) t0 = esLoc.g.epoch P := Nat.max_eq_left hle
            rw [hepP, hmax] at hQs ⊢
            rw [hstLoc_P, hstM_P, hcka.1, hvS.2]
            exact hinv.vp_cka_cache P hQs
          · have hmax : max (esLoc.g.epoch P) t0 = t0 := Nat.max_eq_right (by omega)
            rw [hepP, hmax, hns] at hQs
            cases hQs
        · rw [hepQ Q hQ] at hQs ⊢
          rw [hstLoc_ne Q hQ, hstM_ne Q hQ]
          exact hinv.vp_cka_cache Q hQs
      epoch_bound := fun Q => by
        dsimp only
        have h0 := hinv.epoch_bound Q
        by_cases hQ : Q = P
        · subst Q; rw [hepP]; omega
        · rw [hepQ Q hQ]; omega
      vS_sync := fun Q => by
        dsimp only; rw [hsess_eq]
        by_cases hQ : Q = P
        · subst Q; rw [hstLoc_P, hstM_P, hvS.1, hvS.2]
          rcases hinv.vS_sync P with h1 | h2 | ⟨ts, j', hts_le, hts_imp, hrest⟩
          · exact Or.inl h1
          · exact Or.inr (Or.inl h2)
          · refine Or.inr (Or.inr ⟨ts, j', le_trans hts_le (hep_mono P), ?_, hrest⟩)
            intro hPs
            by_cases hle : t0 ≤ esLoc.g.epoch P
            · have hmax : max (esLoc.g.epoch P) t0 = esLoc.g.epoch P := Nat.max_eq_left hle
              rw [hepP, hmax] at hPs ⊢
              exact hts_imp hPs
            · have hmax : max (esLoc.g.epoch P) t0 = t0 := Nat.max_eq_right (by omega)
              rw [hepP, hmax, hns] at hPs
              cases hPs
        · rw [hstLoc_ne Q hQ, hstM_ne Q hQ, hepQ Q hQ]
          exact hinv.vS_sync Q
      vR_dom := fun Q τ hsome => by
        dsimp only at hsome ⊢
        by_cases hQ : Q = P
        · subst Q; rw [hstM_P, hvR_M] at hsome
          by_cases hτ : τ = t0
          · subst τ; rw [hepP]; exact ⟨le_max_right _ _, hP_rec⟩
          · rw [Function.update_of_ne hτ] at hsome
            obtain ⟨hle0, hrec0⟩ := hinv.vR_dom P τ hsome
            exact ⟨le_trans hle0 (hep_mono P), hrec0⟩
        · rw [hstM_ne Q hQ] at hsome
          rw [hepQ Q hQ]
          exact hinv.vR_dom Q τ hsome
      vR_sync := fun Q τ => by
        dsimp only; rw [hsess_eq]
        have hvR_unchanged : (Q ≠ P ∨ τ ≠ t0) →
            (gLoc'.st Q).vR τ = (esLoc.g.st Q).vR τ ∧ (gM'.st Q).vR τ = (esM.g.st Q).vR τ := by
          intro hne_pair
          by_cases hQ : Q = P
          · subst Q
            have hτ : τ ≠ t0 := hne_pair.resolve_left (not_not.mpr rfl)
            rw [hstLoc_P, hstM_P, hvR_loc, hvR_M, Function.update_of_ne hτ, Function.update_of_ne hτ]
            exact ⟨rfl, rfl⟩
          · rw [hstLoc_ne Q hQ, hstM_ne Q hQ]
            exact ⟨rfl, rfl⟩
        by_cases hpair : Q = P ∧ τ = t0
        · rcases hpair with ⟨hQP, hτt0⟩; subst Q; subst τ
          rw [hstLoc_P, hstM_P, hvR_loc, hvR_M, Function.update_self, Function.update_self]
          refine Or.inr (Or.inr ⟨j, hP_rec, hqep_ok, hbk_ok, hnhe_ok, hj_len, ?_, ?_⟩)
          · rw [← hsIdx_eq, Function.update_self]
          · rw [← hsIdx_eq]
        · have hne_pair : Q ≠ P ∨ τ ≠ t0 := by
            by_cases hQ : Q = P
            · exact Or.inr (fun hτ => hpair ⟨hQ, hτ⟩)
            · exact Or.inl hQ
          obtain ⟨hL_eq, hM_eq⟩ := hvR_unchanged hne_pair
          rw [hL_eq, hM_eq]
          rcases hinv.vR_sync Q τ with h1 | h2 | ⟨j', hQ_rec, hqep', hbk', hnhe', hj'_len, hvRL, hvRM⟩
          · exact Or.inl h1
          · exact Or.inr (Or.inl h2)
          · refine Or.inr (Or.inr ⟨j', hQ_rec, hqep', hbk', hnhe', hj'_len, ?_, hvRM⟩)
            have hs_ne : q * (τ - healEpoch tL) + j' ≠ sIdx := by
              intro heq_s
              have hhe_τ : healEpoch tL ≤ τ := healEpoch_le_of_gen4 hbk'
              have hj'_lt_q : j' < q := by
                by_cases hτ0 : τ = 0
                · rw [hτ0] at hj'_len; exact lt_of_lt_of_le hj'_len hinv.sess_zero_le
                · have h1 := hinv.sess_pos_bound τ (by omega); omega
              have h_inj := step1_deliver_aux_slot_inj hhe_τ hhe_t0 hj'_lt_q hj_lt_q
                (by rw [← hsIdx_eq]; exact heq_s)
              have hτ_eq : τ = t0 := h_inj.1
              subst τ
              exact hpair ⟨hQ_rec.trans hP_rec.symm, rfl⟩
            change _ = some (Function.update rsLoc sIdx rs_new (q * (τ - healEpoch tL) + j'))
            rw [Function.update_of_ne hs_ne]
            exact hvRL
      sess_inv := fun i => by
        dsimp only
        by_cases hi : i = sIdx
        · subst i
          simp only [Function.update_self]
          exact hinv_s'
        · simp only [Function.update_of_ne hi, hbook_ne i hi]
          exact hinv.sess_inv i
      ss_fresh := fun τ j' h1 hhe hj' hlt =>
        hinv.ss_fresh τ j' h1 hhe hj' (lt_of_le_of_lt (hep_mono _) hlt)
      rs_fresh := fun τ j' h1 hhe hj' hlt => by
        dsimp only at hlt ⊢
        have hτ_ne : τ ≠ t0 := by
          intro heq; subst τ
          rw [← hP_rec, hepP] at hlt
          have : t0 ≤ max (esLoc.g.epoch P) t0 := le_max_right _ _
          omega
        have hs_ne : q * (τ - healEpoch tL) + j' ≠ sIdx := by
          intro heq_s
          exact hτ_ne (step1_deliver_aux_slot_inj hhe hhe_t0 hj' hj_lt_q
            (by rw [← hsIdx_eq]; exact heq_s)).1
        rw [Function.update_of_ne hs_ne]
        exact hinv.rs_fresh τ j' h1 hhe hj' (lt_of_le_of_lt (hep_mono _) hlt)
      book_fresh_before_send := fun τ j' h1 hhe hj' hlt hh => by
        dsimp only at hlt hh ⊢
        rw [htL_eq] at hh
        have hτ_ne : τ ≠ t0 := by
          intro heq; subst τ
          have hle' := le_trans hle_send (hep_mono (Party.senderOf t0))
          exact absurd hlt (Nat.not_lt.mpr hle')
        have hs_ne : q * (τ - healEpoch tL) + j' ≠ sIdx := by
          intro heq_s
          exact hτ_ne (step1_deliver_aux_slot_inj hhe hhe_t0 hj' hj_lt_q
            (by rw [← hsIdx_eq]; exact heq_s)).1
        rw [hbook_ne _ hs_ne]
        exact hinv.book_fresh_before_send τ j' h1 hhe hj' (lt_of_le_of_lt (hep_mono _) hlt) hh
      trans_meta := fun r hr => by
        dsimp only at hr ⊢
        rw [hc_eq]
        obtain ⟨h1, h2, h3, h4, h5⟩ := hinv.trans_meta r (htrans_sub r hr)
        exact ⟨h1, h2, le_trans h3 (hep_mono r.pos.sender), h4, h5⟩
      cache_empty_gt := fun τ hlt => by
        dsimp only at hlt ⊢; rw [hc_eq]
        exact hinv.cache_empty_gt τ (lt_of_le_of_lt (hep_mono _) hlt)
      healed_sender_pin := fun Q τ j' hQs hτ_eq hvS_M hh => by
        dsimp only at hQs hτ_eq hvS_M hh ⊢
        rw [htL_eq] at hh
        rw [hidx_eq, hcnt_all, hc_eq]
        by_cases hQ : Q = P
        · subst Q
          by_cases hle : t0 ≤ esLoc.g.epoch P
          · have hmax : max (esLoc.g.epoch P) t0 = esLoc.g.epoch P := Nat.max_eq_left hle
            rw [hepP, hmax] at hQs hτ_eq
            rw [hstM_P, hvS.2] at hvS_M
            rw [hstM_P, hcka.2]
            exact hinv.healed_sender_pin P τ j' hQs hτ_eq hvS_M hh
          · have hmax : max (esLoc.g.epoch P) t0 = t0 := Nat.max_eq_right (by omega)
            rw [hepP, hmax, hns] at hQs
            cases hQs
        · rw [hepQ Q hQ] at hQs hτ_eq
          rw [hstM_ne Q hQ] at hvS_M ⊢
          exact hinv.healed_sender_pin Q τ j' hQs hτ_eq hvS_M hh
      healed_vR_pin := fun Q τ sIdx' hvRM hh => by
        dsimp only at hvRM hh ⊢
        rw [htL_eq] at hh; rw [hc_eq]
        by_cases hQ : Q = P
        · subst Q; rw [hstM_P, hvR_M] at hvRM
          by_cases hτ : τ = t0
          · subst τ
            simp only [Function.update_self, Option.some.injEq, Sum.inr.injEq] at hvRM
            subst sIdx'
            exact hpin_t0
          · rw [Function.update_of_ne hτ] at hvRM
            exact hinv.healed_vR_pin P τ sIdx' hvRM hh
        · rw [hstM_ne Q hQ] at hvRM
          exact hinv.healed_vR_pin Q τ sIdx' hvRM hh
      healed_book_trans := fun τ sIdx' hh hro hp => by
        dsimp only at hh hro hp ⊢
        rw [htL_eq] at hh; rw [hc_eq] at hp
        by_cases hτ : τ = t0
        · subst τ
          have hs_eq : sIdx' = sIdx := by
            rcases hp with ⟨ht00, hs1, _, _⟩ | ⟨ht01, Tc1, σc1, kM1, hc1⟩
            · rcases hpin_t0 with ⟨_, hs2, _, _⟩ | ⟨ht01, _⟩
              · exact hs1.trans hs2.symm
              · omega
            · rcases hpin_t0 with ⟨ht00, _⟩ | ⟨_, Tc2, σc2, kM2, hc2⟩
              · omega
              · rw [hc1] at hc2
                injection hc2 with htuple
                have hopt : some sIdx' = some sIdx := congrArg (fun x => x.2.2.2) htuple
                exact Option.some.inj hopt
          subst sIdx'
          rw [htrans_at, hinv.healed_book_trans t0 sIdx hheal_t0 hro_pre hpin_t0]
          change _ = (((gLoc'.trans.filter (fun r => r.pos.epoch == t0)).map
            (fun r => (r.pos.idx, r.ct.1, r.ct.2))))
          rw [← hep, hflt_eq_pos]
        · have hs_ne : sIdx' ≠ sIdx := by
            intro heq_s
            rcases hp with ⟨hτ0, hs1, _, htL0⟩ | ⟨hτ1, Tc1, σc1, kM1, hc1⟩
            · rw [hτ0] at hτ; rw [hs1] at heq_s
              have hhe0 : healEpoch tL ≤ 0 := by rw [htL0]; simp [healEpoch]
              have hs0 : (0 : ℕ) = q * (0 - healEpoch tL) + 0 := by
                rw [htL0]; simp [healEpoch]
              exact hτ (step1_deliver_aux_slot_inj hhe0 hhe_t0 hq_pos hj_lt_q
                (by rw [← hs0, heq_s, hsIdx_eq])).1
            · rcases hinv.cache_sync τ with ⟨_, hc_none⟩ | ⟨_, _, _, _, _, hc_none⟩ |
                ⟨Tc2, σc2, kM2, j', _, hj'_len, _, hbk', _, _, hc_some⟩
              · rw [hc1] at hc_none; cases hc_none
              · rw [hc1] at hc_none; cases hc_none
              · rw [hc1] at hc_some
                injection hc_some with htuple
                have hopt : some sIdx' = some (q * (τ - healEpoch tL) + j') :=
                  congrArg (fun x => x.2.2.2) htuple
                have hsIdx'_eq : sIdx' = q * (τ - healEpoch tL) + j' := Option.some.inj hopt
                have hhe_τ : healEpoch tL ≤ τ := healEpoch_le_of_gen4 hbk'
                have hj'_lt_q : j' < q := by
                  have h1 := hinv.sess_pos_bound τ hτ1; omega
                exact hτ (step1_deliver_aux_slot_inj hhe_τ hhe_t0 hj'_lt_q hj_lt_q
                  (by rw [← hsIdx'_eq, heq_s, hsIdx_eq])).1
          rw [hbook_ne sIdx' hs_ne]
          have hτ_ne_pos : τ ≠ r0.pos.epoch := by rw [hep]; exact hτ
          change _ = ((gLoc'.trans.filter (fun r => r.pos.epoch == τ)).map _)
          rw [hflt_ne_pos τ hτ_ne_pos]
          have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
              (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
            rcases hro with hlt | hvR
            · exact Or.inl (lt_of_le_of_lt (hep_mono _) hlt)
            · right
              by_cases hQ : Party.receiverOf τ = P
              · rw [hQ] at hvR ⊢
                rw [hstM_P, hvR_M, Function.update_of_ne hτ] at hvR
                exact hvR
              · rw [hstM_ne _ hQ] at hvR
                exact hvR
          exact hinv.healed_book_trans τ sIdx' hh hro_orig hp }

private theorem step1_deliver_aux_deliverE_loc_inTransit
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt)
    (esLoc : LocES Pt ℓ)
    {r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    (habort : esLoc.abort = false) (hwin : esLoc.g.win = false)
    (hinT : esLoc.g.inTransit P.other c = some r0) :
    simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        3 qep maxForwardJumps (bucketAuthCfg 1 tL par))
        (.inr (.inl (.inl (.inl (.inr ⟨P, c⟩)))))).run esLoc) =
    (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      ((vRecv (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        esLoc.g P (esLoc.g.st P) c (some r0)).run esLoc.h) >>= fun p =>
      match p.1 with
      | none => pure (none, { esLoc with h := p.2, abort := true })
      | some none => pure (some .rejected, { esLoc with h := p.2 })
      | some (some (st', t', i', m')) =>
        pure (some (.accepted t' i' (if esLoc.g.chall.contains r0.pos then none else some m')),
          { esLoc with g := esLoc.g.accept P st' r0.pos, h := p.2 })) := by
  simp only [implEDFPaperBucketRaw, deliverE, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
    StateT.run_bind, StateT.run_get, pure_bind, bind_assoc,
    habort, hwin, Bool.or_self, Bool.false_eq_true, ↓reduceIte, hinT, run_liftH_eq,
    simulateQ_bind]
  congr 1; funext p
  rcases p with ⟨_ | _ | ⟨st', t', i', m'⟩, h'⟩
  · simp [abortE, StateT.run_modify]
  · simp [bucketAuthCfg, StateT.run_pure]
  · simp [commitE, hkLocOpt, hooksSlotBucketOptAt, bucketAuthCfg,
      StateT.run_bind, StateT.run_modify, StateT.run_pure]

