private theorem step2_dispatch {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey)
    (hinj : Function.Injective encT) (hdum : ∀ T, encT T ≠ dummyKey)
    (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (hℓ : ℓ < 10 ^ 6) (hq_pos : 0 < q)
    (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (rem : ℕ) (qr : (Fig8SpecDF Pt ℓ).Domain)
    (hbad : badSendMsgDF (St := Fig8St Pt) (Coins := BitVec 256) (C := Fig8C Pt)
      (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (.inr qr) = false)
    {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range qr → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  rcases qr with ((((⟨P, m, r₀⟩ | ⟨P, m₀, m₁, r₀⟩) | ⟨P, c⟩) | ⟨P, c⟩) | P) | ⟨P, c, c'⟩
  · have hshort : m.1.shortB = true :=
      Computational.Proofs.ReductionDsl.Fig8Atomic.atomicShortPubB_imp_shortB
        (by simpa [badSendMsgDF] using hbad)
    exact step2_transmit mode C Dh encPt encT idOf ℓ q qep rem hℓ tL par ks P m r₀ hshort r hIH2
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step2_chall mode C Dh encPt encT idOf ℓ q qep rem tL par ks P m₀ m₁ r₀ r hIH2
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step2_deliver mode C Dh hD encPt encT hinj hdum idOf ℓ q qep rem hℓ hq_pos tL par ks P c r hIH2
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step2_inject mode C Dh hD encPt encT hinj hdum idOf ℓ q qep rem hℓ hq_pos tL par ks P c r hIH2
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step2_corr mode C Dh encPt encT idOf ℓ q qep rem tL par ks P r hIH2
      ssLoc rsLoc esLoc esM esL tblM tblL hinv
  · exact step2_deliverForge mode C Dh hD encPt encT hinj hdum idOf ℓ q qep rem hℓ hq_pos tL par ks P c c' r hIH2
      ssLoc rsLoc esLoc esM esL tblM tblL hinv

private theorem step1_dispatch {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey)
    (hinj : Function.Injective encT) (hdum : ∀ T, encT T ≠ dummyKey)
    (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (hℓ : ℓ < 10 ^ 6) (hq_pos : 0 < q)
    (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (rem : ℕ) (qr : (Fig8SpecDF Pt ℓ).Domain)
    (hbad : badSendMsgDF (St := Fig8St Pt) (Coins := BitVec 256) (C := Fig8C Pt)
      (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (.inr qr) = false)
    {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range qr → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH1 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeAdd
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM')
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true (r u) esL' none tblL'))
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (hq_r : ∀ u, MakesAtMostQueriesDF (r u) rem)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    LeAdd
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
