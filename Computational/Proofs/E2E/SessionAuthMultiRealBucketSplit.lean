          dsimp only [mkS1Loc] at hvLoc
          simp only [Option.map, Function.update_idem] at hvLoc
          obtain ⟨hM', sM', sL', hfs_eq, hcache, hft, hsess, hlf, hoth, hcnt, hheal_tr, hinv_s'⟩ := hsim_inr
          rw [hfs_eq] at hvM
          dsimp only [mkS1M] at hvM
          simp only [pure_bind, Option.map, Function.update_idem] at hvM
          let ep' := max (esLoc.g.epoch P) t0
          let stLoc' : LocVP Pt :=
            { esLoc.g.st P with
              tcur := ep', γ := γ_new, root := σ_new,
              vR := Function.update (esLoc.g.st P).vR t0 (some rsLoc_new) }
          let stM' : MultiVP Pt :=
            { esM.g.st P with
              tcur := ep', γ := γ_new, root := σ_new,
              vR := Function.update (esM.g.st P).vR t0 (some (.inr sIdx)) }
          have hstepLoc := step2_deliver_aux_deliverE_of_vRecv_accept_loc mode C Dh encPt encT idOf ℓ q qep tL par ks
            P c r0 esLoc esLoc.h stLoc' t0 idxOut pmOut hinv.abort_loc hinv.win_false hinT hvLoc
          have hstepM := step2_deliver_aux_deliverE_of_vRecv_accept_multi mode C Dh encPt encT idOf ℓ q qep tL par false
            P c r0 esM hM' tblM (Function.update tblM sIdx sM') stM' t0 idxOut pmOut
            hinv.abort_M hwinM hinM hvM
          rw [← hinv.gsync.chall_eq] at hstepM
          let esLoc' : LocES Pt ℓ := { esLoc with g := esLoc.g.accept P stLoc' r0.pos }
          let esM' : MultiES Pt ℓ := { esM with g := esM.g.accept P stM' r0.pos, h := hM' }
          rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc' _ hinv.win_false hstepLoc,
              runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblM
                (Function.update tblM sIdx sM') _ hwinM hstepM]
          have hwinLoc' : esLoc'.g.win = false := hinv.win_false
          have hwinM' : esM'.g.win = false := hwinM
          simp only [hwinLoc', hwinM', calcWinEp, Bool.false_eq_true, ↓reduceIte]
          exact hIH2 _ ssLoc (Function.update rsLoc sIdx rsLoc_new) esLoc' esM' esL
            (Function.update tblM sIdx sM') (Function.update tblL sIdx sL')
            (step2_deliver_aux_inv_phase2_accept_inr C ℓ encT idOf q qep rem hq_pos tL par ks P c r0 hinv hinT ht0_le_ep1
              j hcap hbk_gen htH_ne hj_len hpin_t0 hro_pre γ_new σ_new rsLoc_new hM' sM' sL'
              hcache hft hsess hlf hoth hcnt hheal_tr hinv_s')

private theorem step2_inject_aux_slot_ne {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep : ℕ} {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {phase1 : Bool} {rem' : ℕ}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks phase1 rem' ssLoc rsLoc esLoc esM esL tblM tblL)
    {t0 τ j j' : ℕ} (hne : τ ≠ t0)
    (ht0_bk : inStage2BucketGen 4 tL par t0 = true)
    (hj : j < (esM.h.sessions t0).length)
    (hτ_ge : healEpoch tL ≤ τ) (hj' : j' < q) :
    q * (τ - healEpoch tL) + j' ≠ q * (t0 - healEpoch tL) + j := by
  have ht0_ge : healEpoch tL ≤ t0 := healEpoch_le_of_gen4 ht0_bk
  have hj_q : j < q := by
    rcases Nat.eq_zero_or_pos t0 with rfl | ht0_pos
    · exact Nat.lt_of_lt_of_le hj hinv.sess_zero_le
    · have hbd := hinv.sess_pos_bound t0 ht0_pos
      omega
  intro heq
  exact hne (bucketSlot_inj hτ_ge ht0_ge hj' hj_q heq).1

private theorem step2_inject_aux_pin_slot_ne {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep : ℕ} (hq_pos : 0 < q) {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {phase1 : Bool} {rem' : ℕ}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks phase1 rem' ssLoc rsLoc esLoc esM esL tblM tblL)
    {t0 τ j sIdx' : ℕ} (hne : τ ≠ t0)
    (ht0_bk : inStage2BucketGen 4 tL par t0 = true)
    (hj : j < (esM.h.sessions t0).length)
    (hpin : (τ = 0 ∧ sIdx' = 0 ∧ inStage2BucketGen 4 tL par 0 = true ∧ tL = none) ∨
      (1 ≤ τ ∧ ∃ Tc σc kMulti, esM.h.cache τ = some (Tc, σc, kMulti, some sIdx'))) :
    sIdx' ≠ q * (t0 - healEpoch tL) + j := by
  rcases hpin with ⟨rfl, rfl, hbk0, rfl⟩ | ⟨hτ1, Tc, σc, kMulti, hcache⟩
  · have h := step2_inject_aux_slot_ne hinv hne ht0_bk hj (healEpoch_le_of_gen4 hbk0) hq_pos
    simpa using h
  · rcases hinv.cache_sync τ with ⟨_, hnone⟩ | ⟨Tc', σc', kVal, _, _, hnone⟩ |
      ⟨Tc', σc', kMulti', j', _, hj'_len, _, hbkτ, _, _, hsome⟩
    · rw [hcache] at hnone; cases hnone
    · rw [hcache] at hnone; cases hnone
    · rw [hcache] at hsome
      injection hsome with h1
      injection h1 with _ h2
      injection h2 with _ h3
      injection h3 with _ h4
      injection h4 with hsIdx
      rw [hsIdx]
      have hj'_q : j' < q := by
        have hbd := hinv.sess_pos_bound τ hτ1
        omega
      exact step2_inject_aux_slot_ne hinv hne ht0_bk hj (healEpoch_le_of_gen4 hbkτ) hj'_q

private theorem step2_inject_aux_calcWinEp_cases {Pt : Type} {ℓ : ℕ}
    (gMain : Bool) (isHonest : Header Pt → Bool) (epOf : Party → ℕ)
    (P : Party) (c : Fig8C Pt) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inr (P, c)))
    calcWinEp gMain isHonest epOf qr true = none ∨
      calcWinEp gMain isHonest epOf qr true = some c.1.1 := by
  intro qr
  cases gMain
  · by_cases h : (decide (c.1.1 = epOf P + 1) && !isHonest c.1) = true <;>
      simp [calcWinEp, qr, h]
  · right
    rfl

private theorem step2_inject_aux_fsTrans_beq_eq {Pt : Type} [DecidableEq Pt]
    (x : ℕ × Header Pt × (ℕ × LibsignalCiphertextWithSalt32))
    (hdr : Header Pt) (e : ℕ × LibsignalCiphertextWithSalt32) :
    @BEq.beq _ (@instBEqProd (Header Pt) (ℕ × LibsignalCiphertextWithSalt32)
      instBEqProd instBEqOfDecidableEq) x.2 (hdr, e) =
    (x.2 == (hdr, e)) := by
  apply Bool.eq_iff_iff.mpr
  change (x.2.1 == hdr && decide (x.2.2 = e)) = true ↔
    (x.2.1 == hdr && (x.2.2 == e)) = true
  simp only [Bool.and_eq_true, ct_beq_iff_local, decide_eq_true_eq]

private theorem step2_inject_aux_healed_win_zero {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem' : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc esLoc' : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false rem' ssLoc rsLoc esLoc esM esL tblM tblL)
    {tWin : ℕ} (hheal : healedBy esLoc.g.tL 3 tWin = true)
    (hwin' : esLoc'.g.win = true) (hleaks' : esLoc'.g.leaks = esLoc.g.leaks)
    {we : Option ℕ} (hwe : we = none ∨ we = some tWin)
    {α : Type} (oa : OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α) (cM : ProbComp Bool) :
    LeOne (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks oa esLoc' we) cM := by
  have hhalt : (esLoc'.abort || esLoc'.g.win) = true := by simp [hwin']
  refine exit_cLoc_zero_leOne mode C Dh encPt encT idOf ℓ q qep tL par ks oa esLoc' we cM hhalt ?_
  rcases hwe with rfl | rfl
  · rfl
  · have hpl : postLeak tL esLoc.g = true := hinv.phase2_props rfl
    unfold postLeak at hpl
    cases htL : esLoc.g.tL with
    | none => rw [htL] at hpl; cases hpl
    | some cur =>
      rw [htL] at hpl hheal
      have hcur_mem : cur ∈ esLoc'.g.leaks := by
        rw [hleaks']
        exact hinv.tL_mem_leaks cur htL
      have hcur_lt : cur < tWin := by
        simp only [healedBy, decide_eq_true_eq] at hheal
        omega
      have hno : authLosingConditionsAvoided 3 tL tWin esLoc'.g = false :=
        authLosing_false_of_leak_lt_tWin hcur_mem hpl hcur_lt
      simp [authOutBucket, _root_.CryptoGames.SM.Engine.authOut, hno]

private theorem step2_inject_aux_fsRecv_inr_healed_none {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem' : ℕ) (hℓ : ℓ < 10 ^ 6) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (ctxM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (sIdx : ℕ) (c : Fig8C Pt)
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false rem' ssLoc rsLoc esLoc esM esL tblM tblL)
    (hhealM : healedBy ctxM.tL 3 c.1.1 = true)
    (hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) c.1 c.2 = none) :
    ∃ sM' sL',
      (simulateQ (pubFsImplOpt C ℓ encT idOf false)
        (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
          ctxM P c.1.1 (.inr sIdx) c.1 c.2 none).run esM.h)).run (fun _ => false, tblM) =
      pure ((some none, esM.h), (fun _ => false, Function.update tblM sIdx sM')) ∧
      ActiveSessInv C ℓ encT idOf (!((esM.h.book sIdx).getD {}).sCorr) (ks sIdx)
        (ssLoc sIdx) (rsLoc sIdx) ((esM.h.book sIdx).getD {}) sM' sL' := by
  rcases c with ⟨hdr, i_ct, ct_raw⟩
  dsimp only at hhealM hrecv ⊢
  rw [hkMultiOpt_fsRecv]
  have hhealM' : healedBy ctxM.tL (2 + 1) hdr.1 = true := hhealM
  dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
  cases hmatch : ((esM.h.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (hdr, (i_ct, ct_raw))) with
  | some mEntry =>
    rcases activeSessInv_deliver C hD (hrt_and_len_check ℓ hℓ).1 ℓ (hrt_and_len_check ℓ hℓ).2
      encT idOf (hinv.sess_inv sIdx) hdr (i_ct, ct_raw) hmatch with ⟨p, hpub, hdel⟩
    rw [hrecv] at hdel
    rcases hdel with ⟨sM', sL', hstep, _, hact'⟩
    refine ⟨sM', sL', ?_, hact'⟩
    simp only [StateT.run_bind, StateT.run_get, pure_bind, step2_inject_aux_fsTrans_beq_eq,
      hmatch, Option.isNone_some, Option.isSome_some, Bool.false_and, Bool.false_eq_true,
      ↓reduceIte, Bool.not_true, simulateQ_bind]
    rw [sim_liftFS_deliver_some_run C ℓ encT idOf false sIdx hdr i_ct ct_raw p hpub esM.h tblM hstep]
    simp [Option.map, withPub, StateT.run_pure, simulateQ_pure]
  | none =>
    cases hpub : lPubOf protoSignalCodec ct_raw with
    | none =>
      refine ⟨tblM sIdx, tblL sIdx, ?_, hinv.sess_inv sIdx⟩
      simp only [StateT.run_bind, StateT.run_get, pure_bind, step2_inject_aux_fsTrans_beq_eq,
        hmatch, Option.isSome_none, hhealM', Bool.not_true, Bool.and_false,
        Bool.false_and, Bool.false_eq_true, ↓reduceIte, simulateQ_bind]
      rw [sim_liftFS_inject_none_run C ℓ encT idOf false sIdx hdr i_ct ct_raw hpub esM.h tblM]
      simp [Function.update_eq_self, StateT.run_pure, simulateQ_pure]
    | some p =>
      cases hscorr : ((esM.h.book sIdx).getD {}).sCorr with
      | false =>
        have hact0 : ActiveSessInv C ℓ encT idOf true (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
            ((esM.h.book sIdx).getD {}) (tblM sIdx) (tblL sIdx) := by
          simpa [hscorr] using hinv.sess_inv sIdx
        rcases activeSessInv_inject_receive_none C ℓ encT idOf hact0 hdr (i_ct, ct_raw) hmatch p hpub hrecv
          with ⟨sM', sL', hstep, hact'⟩
        refine ⟨sM', sL', ?_, by simpa [hscorr] using hact'⟩
        simp only [StateT.run_bind, StateT.run_get, pure_bind, step2_inject_aux_fsTrans_beq_eq,
          hmatch, Option.isSome_none, hhealM', Bool.not_true, Bool.and_false,
          Bool.false_and, Bool.false_eq_true, ↓reduceIte, simulateQ_bind]
        rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx hdr i_ct ct_raw p hpub esM.h tblM hstep]
        simp [Option.map, withPub, StateT.run_pure, simulateQ_pure]
      | true =>
        have hact0 : ActiveSessInv C ℓ encT idOf false (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
            ((esM.h.book sIdx).getD {}) (tblM sIdx) (tblL sIdx) := by
          simpa [hscorr] using hinv.sess_inv sIdx
        have hinj := activeSessInv_inject_phase2 C ℓ encT idOf hact0 hscorr hdr (i_ct, ct_raw) hmatch p hpub
        rw [hrecv] at hinj
        rcases hinj with ⟨sM', hstep, hact'⟩
        refine ⟨sM', tblL sIdx, ?_, by simpa [hscorr] using hact'⟩
        simp only [StateT.run_bind, StateT.run_get, pure_bind, step2_inject_aux_fsTrans_beq_eq,
          hmatch, Option.isSome_none, hhealM', Bool.not_true, Bool.and_false,
          Bool.false_and, Bool.false_eq_true, ↓reduceIte, simulateQ_bind]
        rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx hdr i_ct ct_raw p hpub esM.h tblM hstep]
        simp [Option.map, withPub, StateT.run_pure, simulateQ_pure]

private theorem step2_inject_aux_fsRecv_inr_unhealed {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem' : ℕ) (hℓ : ℓ < 10 ^ 6) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (ctxM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (sIdx : ℕ) (c : Fig8C Pt)
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false rem' ssLoc rsLoc esLoc esM esL tblM tblL)
    (hunhealM : healedBy ctxM.tL 3 c.1.1 = false) :
    match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) c.1 c.2 with
    | none =>
      ∃ hM' sM' sL',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctxM P c.1.1 (.inr sIdx) c.1 c.2 none).run esM.h)).run (fun _ => false, tblM) =
        pure ((some none, hM'), (fun _ => false, Function.update tblM sIdx sM')) ∧
        hM'.lfWin = esM.h.lfWin ∧ hM'.sessions = esM.h.sessions ∧
        hM'.fTable = esM.h.fTable ∧ hM'.cache = esM.h.cache ∧
        (∀ i, i ≠ sIdx → hM'.book i = esM.h.book i) ∧
        ((hM'.book sIdx).getD {}).fsCount = ((esM.h.book sIdx).getD {}).fsCount ∧
        ActiveSessInv C ℓ encT idOf (!((hM'.book sIdx).getD {}).sCorr) (ks sIdx)
          (ssLoc sIdx) (rsLoc sIdx) ((hM'.book sIdx).getD {}) sM' sL'
    | some (rs', idxOut, pmOut) =>
      ∃ hM' sM' sL',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctxM P c.1.1 (.inr sIdx) c.1 c.2 none).run esM.h)).run (fun _ => false, tblM) =
        pure ((some (some (.inr sIdx, idxOut, pmOut)), hM'),
          (fun _ => false, Function.update tblM sIdx sM')) ∧
        hM'.lfWin = esM.h.lfWin ∧ hM'.sessions = esM.h.sessions ∧
        hM'.fTable = esM.h.fTable ∧ hM'.cache = esM.h.cache ∧
        (∀ i, i ≠ sIdx → hM'.book i = esM.h.book i) ∧
        ((hM'.book sIdx).getD {}).fsCount = ((esM.h.book sIdx).getD {}).fsCount ∧
        ActiveSessInv C ℓ encT idOf (!((hM'.book sIdx).getD {}).sCorr) (ks sIdx)
          (ssLoc sIdx) rs' ((hM'.book sIdx).getD {}) sM' sL' := by
  rcases c with ⟨hdr, i_ct, ct_raw⟩
  dsimp only at hunhealM ⊢
  rw [hkMultiOpt_fsRecv]
  have hunhealM' : healedBy ctxM.tL (2 + 1) hdr.1 = false := hunhealM
  dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
  let bk := (esM.h.book sIdx).getD {}
  cases hmatch : bk.fsTrans.find? (fun x => x.2 == (hdr, (i_ct, ct_raw))) with
  | some mEntry =>
    rcases activeSessInv_deliver C hD (hrt_and_len_check ℓ hℓ).1 ℓ (hrt_and_len_check ℓ hℓ).2
      encT idOf (hinv.sess_inv sIdx) hdr (i_ct, ct_raw) hmatch with ⟨p, hpub, hdel⟩
    cases hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) hdr (i_ct, ct_raw) with
    | none =>
      rw [hrecv] at hdel
      rcases hdel with ⟨sM', sL', hstep, _, hact'⟩
      refine ⟨esM.h, sM', sL', ?_, rfl, rfl, rfl, rfl, fun _ _ => rfl, rfl, hact'⟩
      simp only [bk, StateT.run_bind, StateT.run_get, pure_bind, step2_inject_aux_fsTrans_beq_eq,
        hmatch, Option.isNone_some, Option.isSome_some, Bool.false_and, Bool.false_eq_true,
        ↓reduceIte, Bool.not_true, simulateQ_bind]
      rw [sim_liftFS_deliver_some_run C ℓ encT idOf false sIdx hdr i_ct ct_raw p hpub esM.h tblM hstep]
      simp [Option.map, withPub, StateT.run_pure, simulateQ_pure]
    | some val =>
      rcases val with ⟨rs', idxOut, pmOut⟩
      rw [hrecv] at hdel
      rcases hdel with ⟨hmEntry, sM', sL', hstep, _, hp_eq, hact'⟩
      let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
        { bk with fsTrans := bk.fsTrans.filter (·.1 != mEntry.1) }
      let hM' : MultiHS Pt := { esM.h with book := Function.update esM.h.book sIdx (some bk') }
      have hpm : (p, pmOut.2) = pmOut := by cases pmOut; subst hp_eq; rfl
      refine ⟨hM', sM', sL', ?_, rfl, rfl, rfl, rfl,
        fun i hi => by simp [hM', Function.update_of_ne hi],
        by simp [hM', bk', bk, Function.update_self],
        by simpa [hM', bk', bk, Function.update_self] using hact'⟩
      simp only [hM', bk', bk, StateT.run_bind, StateT.run_get, pure_bind,
        step2_inject_aux_fsTrans_beq_eq, hmatch, Option.isNone_some, Option.isSome_some,
        Bool.false_and, Bool.false_eq_true, ↓reduceIte, Bool.not_true, simulateQ_bind]
      rw [sim_liftFS_deliver_some_run C ℓ encT idOf false sIdx hdr i_ct ct_raw p hpub esM.h tblM hstep]
      simp [Option.map, withPub, hpm, StateT.run_modify, StateT.run_pure, simulateQ_pure]
  | none =>
    have hpre : ∃ (hM1 : MultiHS Pt) (sM1 : SessHSt Pt ℓ),
        ((bk.sCorr = true ∧ hM1 = esM.h ∧ sM1 = tblM sIdx) ∨
         (∃ u_corr, bk.sCorr = false ∧
          hM1 = { esM.h with book := Function.update esM.h.book sIdx (some { bk with sCorr := true }) } ∧
          (simulateQ (pubFsMultiImpl (fsImpl (lIdeal C protoSignalCodec ℓ encT)
              (lAeadR C protoSignalCodec ℓ encT idOf) (lChainPRG C.F) maxForwardJumps (hp 0 0 false)))
            ((liftFSMultiDFBucket sIdx
              (_root_.CryptoGames.FSAEAD.corruptSenderQuery
                (ReceiverState := RatchetReceiverState (BitVec 256) (BitVec 256))
                (AssocData := Header Pt) (Message := LibsignalMsgPublicPart × Plain ℓ)
                (Ciphertext := ℕ × LibsignalCiphertextWithSalt32))).run esM.h)).run
            (fun _ => false, tblM) =
          pure ((some u_corr, esM.h), (fun _ => false, Function.update tblM sIdx sM1)))) ∧
        hM1.lfWin = esM.h.lfWin ∧ hM1.sessions = esM.h.sessions ∧
        hM1.fTable = esM.h.fTable ∧ hM1.cache = esM.h.cache ∧
        (∀ i, i ≠ sIdx → hM1.book i = esM.h.book i) ∧
        ((hM1.book sIdx).getD {}).sCorr = true ∧
        ((hM1.book sIdx).getD {}).fsCount = bk.fsCount ∧
        ((hM1.book sIdx).getD {}).fsTrans = bk.fsTrans ∧
        ActiveSessInv C ℓ encT idOf false (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
          ((hM1.book sIdx).getD {}) sM1 (tblL sIdx) := by
      cases hscorr : bk.sCorr with
      | true =>
        exact ⟨esM.h, tblM sIdx, Or.inl ⟨rfl, rfl, rfl⟩, rfl, rfl, rfl, rfl,
          fun _ _ => rfl, hscorr, rfl, rfl, by simpa [bk, hscorr] using hinv.sess_inv sIdx⟩
      | false =>
        have hact0 : ActiveSessInv C ℓ encT idOf false (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
            bk (tblM sIdx) (tblL sIdx) :=
          activeSessInv_to_phase2 C ℓ encT idOf (by simpa [bk, hscorr] using hinv.sess_inv sIdx)
        rcases activeSessInv_corruptSender C ℓ encT idOf hact0 with ⟨sM1, hcorr, hact1⟩
        let hM1 : MultiHS Pt :=
          { esM.h with book := Function.update esM.h.book sIdx (some { bk with sCorr := true }) }
        refine ⟨hM1, sM1,
          Or.inr ⟨_, rfl, rfl, sim_liftFS_corruptSender_run C ℓ encT idOf sIdx esM.h tblM hcorr⟩,
          rfl, rfl, rfl, rfl,
          fun i hi => by simp [hM1, Function.update_of_ne hi],
          by simp [hM1, Function.update_self],
          by simp [hM1, Function.update_self],
          by simp [hM1, Function.update_self],
          by simpa [hM1, Function.update_self] using hact1⟩
    rcases hpre with ⟨hM1, sM1, hcorr_or, hlf1, hsess1, hf1, hc1, hbook1, hsc1, hcnt1, htr1, hact1⟩
    let tbl1 := Function.update tblM sIdx sM1
    have hact1_tbl : ActiveSessInv C ℓ encT idOf false (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
        ((hM1.book sIdx).getD {}) (tbl1 sIdx) (tblL sIdx) := by
      simpa [tbl1, Function.update_self] using hact1
    cases hpub : lPubOf protoSignalCodec ct_raw with
    | none =>
      have hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive
          (rsLoc sIdx) hdr (i_ct, ct_raw) = none := by
        rw [lFS_receive_eq, hpub]
      rw [hrecv]
      refine ⟨hM1, sM1, tblL sIdx, ?_, hlf1, hsess1, hf1, hc1, hbook1, hcnt1,
        by simpa [hsc1] using hact1⟩
      rcases hcorr_or with ⟨hscT, rfl, rfl⟩ | ⟨u_corr, hscF, rfl, hsim_corr⟩
      · simp only [bk, step2_inject_aux_fsTrans_beq_eq, hmatch, Option.isNone_none,
          Option.isSome_none, hunhealM', hscT, Bool.not_false, Bool.not_true,
          Bool.true_and, Bool.false_eq_true, ↓reduceIte,
          StateT.run_bind, StateT.run_get, pure_bind, simulateQ_bind]
        rw [sim_liftFS_inject_none_run C ℓ encT idOf false sIdx hdr i_ct ct_raw hpub esM.h tblM]
        simp [Function.update_eq_self, StateT.run_pure, simulateQ_pure]
      · simp only [bk, step2_inject_aux_fsTrans_beq_eq, hmatch, Option.isNone_none,
          Option.isSome_none, hunhealM', hscF, Bool.not_false, Bool.true_and,
          ↓reduceIte, StateT.run_bind, StateT.run_get, pure_bind, simulateQ_bind]
        rw [hsim_corr]
        simp only [pure_bind, StateT.run_bind, StateT.run_modify,
          simulateQ_bind, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
        rw [sim_liftFS_inject_none_run C ℓ encT idOf false sIdx hdr i_ct ct_raw hpub _ tbl1]
        simp [tbl1, StateT.run_pure, simulateQ_pure]
    | some p =>
      have hmatch1 : ((hM1.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (hdr, (i_ct, ct_raw))) = none := by
        rw [htr1]; exact hmatch
      have hinj := activeSessInv_inject_phase2 C ℓ encT idOf hact1_tbl hsc1 hdr (i_ct, ct_raw) hmatch1 p hpub
      cases hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive
          (rsLoc sIdx) hdr (i_ct, ct_raw) with
      | none =>
        rw [hrecv] at hinj
        rcases hinj with ⟨sM2, hstep, hact2⟩
        have htbl_upd : Function.update tbl1 sIdx sM2 = Function.update tblM sIdx sM2 := by
          funext i; by_cases hi : i = sIdx <;> simp [tbl1, hi]
        refine ⟨hM1, sM2, tblL sIdx, ?_, hlf1, hsess1, hf1, hc1, hbook1, hcnt1,
          by simpa [hsc1] using hact2⟩
        rcases hcorr_or with ⟨hscT, rfl, rfl⟩ | ⟨u_corr, hscF, rfl, hsim_corr⟩
        · simp only [bk, step2_inject_aux_fsTrans_beq_eq, hmatch, Option.isNone_none,
            Option.isSome_none, hunhealM', hscT, Bool.not_false, Bool.not_true,
            Bool.true_and, Bool.false_eq_true, ↓reduceIte,
            StateT.run_bind, StateT.run_get, pure_bind, simulateQ_bind]
          have htbl1_eq : tbl1 = tblM := by simp [tbl1, Function.update_eq_self]
          rw [htbl1_eq] at hstep
          rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx hdr i_ct ct_raw p hpub esM.h tblM hstep]
          simp [Option.map, withPub, StateT.run_pure, simulateQ_pure]
        · simp only [bk, step2_inject_aux_fsTrans_beq_eq, hmatch, Option.isNone_none,
            Option.isSome_none, hunhealM', hscF, Bool.not_false, Bool.true_and,
            ↓reduceIte, StateT.run_bind, StateT.run_get, pure_bind, simulateQ_bind]
          rw [hsim_corr]
          simp only [pure_bind, StateT.run_bind, StateT.run_modify,
            simulateQ_bind, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
          rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx hdr i_ct ct_raw p hpub _ tbl1 hstep]
          simp [Option.map, withPub, htbl_upd, StateT.run_pure, simulateQ_pure]
      | some val =>
        rcases val with ⟨rs', idxOut, pmOut⟩
        rw [hrecv] at hinj
        rcases hinj with ⟨sM2, hstep, hp_eq, hact2⟩
        let bk2 : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
          { (hM1.book sIdx).getD {} with
            fsTrans := ((hM1.book sIdx).getD {}).fsTrans.filter (·.1 != idxOut) }
        let hM2 : MultiHS Pt := { hM1 with book := Function.update hM1.book sIdx (some bk2) }
        have hpm : (p, pmOut.2) = pmOut := by cases pmOut; subst hp_eq; rfl
        have htbl_upd : Function.update tbl1 sIdx sM2 = Function.update tblM sIdx sM2 := by
          funext i; by_cases hi : i = sIdx <;> simp [tbl1, hi]
        refine ⟨hM2, sM2, tblL sIdx, ?_, hlf1, hsess1, hf1, hc1,
          fun i hi => by simp [hM2, Function.update_of_ne hi, hbook1 i hi],
          by simp [hM2, bk2, bk, Function.update_self, hcnt1],
          by simpa [hM2, bk2, Function.update_self, hsc1] using hact2⟩
        rcases hcorr_or with ⟨hscT, rfl, rfl⟩ | ⟨u_corr, hscF, rfl, hsim_corr⟩
        · simp only [bk, step2_inject_aux_fsTrans_beq_eq, hmatch, Option.isNone_none,
            Option.isSome_none, hunhealM', hscT, Bool.not_false, Bool.not_true,
            Bool.true_and, Bool.false_eq_true, ↓reduceIte,
            StateT.run_bind, StateT.run_get, pure_bind, simulateQ_bind]
          have htbl1_eq : tbl1 = tblM := by simp [tbl1, Function.update_eq_self]
          rw [htbl1_eq] at hstep
          rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx hdr i_ct ct_raw p hpub esM.h tblM hstep]
          simp [hM2, bk2, Option.map, withPub, hpm,
            StateT.run_modify, StateT.run_pure, simulateQ_pure]
        · simp only [bk, step2_inject_aux_fsTrans_beq_eq, hmatch, Option.isNone_none,
            Option.isSome_none, hunhealM', hscF, Bool.not_false, Bool.true_and,
            ↓reduceIte, StateT.run_bind, StateT.run_get, pure_bind, simulateQ_bind]
          rw [hsim_corr]
          simp only [pure_bind, StateT.run_bind, StateT.run_modify,
            simulateQ_bind, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
          rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx hdr i_ct ct_raw p hpub _ tbl1 hstep]
          simp [hM2, bk2, bk, Function.update_self, Option.map, withPub, hpm, htbl_upd,
            StateT.run_modify, StateT.run_pure, simulateQ_pure]

private theorem step2_inject_aux_startRecv {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (t0 : ℕ) (Tn : Pt)
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (hP : P = Party.receiverOf t0) (ht0 : t0 = esLoc.g.epoch P + 1) :
    let locSR := simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (((hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks).startRecv
        esLoc.g P t0 (esLoc.g.st P).γ (esLoc.g.st P).root Tn).run esLoc.h)
    let multiSR := (simulateQ (pubFsImplOpt C ℓ encT idOf false)
      (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).startRecv
        esM.g P t0 (esM.g.st P).γ (esM.g.st P).root Tn).run esM.h)).run (fun _ => false, tblM)
    (locSR = pure (none, esLoc.h) ∧ multiSR = pure ((none, esM.h), (fun _ => false, tblM))) ∨
    (locSR = pure (some none, esLoc.h) ∧ multiSR = pure ((some none, esM.h), (fun _ => false, tblM))) ∨
    (∃ γ' σ' rs,
      locSR = pure (some (some (γ', σ', rs)), esLoc.h) ∧
      multiSR = pure ((some (some (γ', σ', .inl rs)), esM.h), (fun _ => false, tblM))) ∨
    (∃ γ' σ' j,
      !(qep + 1 < t0) = true ∧ inStage2BucketGen 4 tL par t0 = true ∧
      !(tL.isSome && (t0 == healEpoch tL)) = true ∧
      j < (esM.h.sessions t0).length ∧
      let sIdx := q * (t0 - healEpoch tL) + j
      (∃ Tc σc kMulti, esM.h.cache t0 = some (Tc, σc, kMulti, some sIdx)) ∧
      locSR = pure (some (some (γ', σ', rsLoc sIdx)), esLoc.h) ∧
      multiSR = pure ((some (some (γ', σ', .inr sIdx)), esM.h), (fun _ => false, tblM))) := by
  intro locSR multiSR
  have hpl : postLeak tL esLoc.g = true := hinv.phase2_props rfl
  have hplM : postLeakDFBucket tL esM.g = true := by
    rw [postLeakDFBucket_eq_postLeak tL esM.g esLoc.g hinv.gsync.tL_eq.symm]
    exact hpl
  have hbk_eq : inStage2Bucket 1 tL par t0 = inStage2BucketGen 4 tL par t0 := rfl
  have htH_beq : (t0 == healEpoch tL) = decide (t0 = healEpoch tL) := by simp [BEq.beq]
  have hmiss
      (hL : esLoc.h.cache t0 = none ∨
        ∃ Tc σc kVal, Tc ≠ Tn ∧ esLoc.h.cache t0 = some (Tc, σc, kVal))
      (hM : esM.h.cache t0 = none ∨
        ∃ Tc σc kVal opt, Tc ≠ Tn ∧ esM.h.cache t0 = some (Tc, σc, kVal, opt)) :
      (locSR = pure (none, esLoc.h) ∧ multiSR = pure ((none, esM.h), (fun _ => false, tblM))) ∨
      (locSR = pure (some none, esLoc.h) ∧ multiSR = pure ((some none, esM.h), (fun _ => false, tblM))) ∨
      (∃ γ' σ' rs,
        locSR = pure (some (some (γ', σ', rs)), esLoc.h) ∧
        multiSR = pure ((some (some (γ', σ', .inl rs)), esM.h), (fun _ => false, tblM))) := by
    have hloc_eq : locSR =
        let res :=
          if mode == some true then
            if !(qep + 1 < t0) && inStage2BucketGen 4 tL par t0 &&
                (tL.isSome && decide (t0 = healEpoch tL)) then none
            else some none
          else if !(qep + 1 < t0) && inStage2BucketGen 4 tL par t0 then
            if tL.isSome && decide (t0 = healEpoch tL) then none
            else
              let kk := (dhScheme Dh).receive (esLoc.g.st P).γ Tn
              let pr := (rootPRNG C.F encPt).up (esLoc.g.st P).root kk.2
              some (some (kk.1, pr.1, (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver pr.2))
          else some none
        pure (res, esLoc.h) := by
      rcases hL with hcL | ⟨Tc, σc, kVal, hT, hcL⟩
      · dsimp only [locSR, hkLocOpt, hooksSlotBucketOptAt]
        simp only [StateT.run_bind, StateT.run_get, pure_bind, hcL, hpl, hbk_eq]
        split_ifs <;> simp [StateT.run_pure, simulateQ_pure]
      · dsimp only [locSR, hkLocOpt, hooksSlotBucketOptAt]
        simp only [StateT.run_bind, StateT.run_get, pure_bind, hcL, hT, ↓reduceIte, hpl, hbk_eq]
        split_ifs <;> simp [StateT.run_pure, simulateQ_pure]
    have hmulti_eq : multiSR =
        let res :=
          if mode == some true then
            if !(qep + 1 < t0) && inStage2BucketGen 4 tL par t0 &&
                (tL.isSome && decide (t0 = healEpoch tL)) then none
            else some none
          else if !(qep + 1 < t0) && inStage2BucketGen 4 tL par t0 then
            if tL.isSome && decide (t0 = healEpoch tL) then none
            else
              let kk := (dhScheme Dh).receive (esLoc.g.st P).γ Tn
              let pr := (rootPRNG C.F encPt).up (esLoc.g.st P).root kk.2
              some (some (kk.1, pr.1, .inl ((lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver pr.2)))
          else some none
        pure ((res, esM.h), (fun _ => false, tblM)) := by
      dsimp only [multiSR]
      rw [← hinv.vp_γ_eq P, ← hinv.vp_root_eq P, hkMultiOpt_startRecv]
      rcases hM with hcM | ⟨Tc, σc, kVal, opt, hT, hcM⟩
      · cases hmode : (mode == some true) <;>
        · simp only [hooksFSMultiDFBucketPaperMode, hooksFSMultiDFBucketPaper, pubFsImplOpt,
            ↓reduceIte, Bool.false_eq_true, StateT.run_bind, StateT.run_get, pure_bind,
            hcM, hplM, htH_beq]
          split_ifs <;> simp [StateT.run_pure, simulateQ_pure]
      · cases hmode : (mode == some true) <;>
        · simp only [hooksFSMultiDFBucketPaperMode, hooksFSMultiDFBucketPaper, pubFsImplOpt,
            ↓reduceIte, Bool.false_eq_true, StateT.run_bind, StateT.run_get, pure_bind,
            hcM, hT, hplM, htH_beq]
          split_ifs <;> simp [StateT.run_pure, simulateQ_pure]
    rw [hloc_eq, hmulti_eq]
    by_cases h1 : (mode == some true) = true
    · by_cases h2 : (!(qep + 1 < t0) && inStage2BucketGen 4 tL par t0 &&
          (tL.isSome && decide (t0 = healEpoch tL))) = true
      · left; simp [h1, h2]
      · right; left; simp [h1, h2]
    · by_cases h2 : (!(qep + 1 < t0) && inStage2BucketGen 4 tL par t0) = true
      · by_cases h3 : (tL.isSome && decide (t0 = healEpoch tL)) = true
        · left; simp [h1, h2, h3]
        · right; right
          let kk := (dhScheme Dh).receive (esLoc.g.st P).γ Tn
          let pr := (rootPRNG C.F encPt).up (esLoc.g.st P).root kk.2
          refine ⟨kk.1, pr.1, (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver pr.2, ?_, ?_⟩ <;>
            simp [h1, h2, h3, kk, pr]
      · right; left; simp [h1, h2]
  rcases hinv.cache_sync t0 with ⟨hcL, hcM⟩ | ⟨Tc, σc, kVal, _, hcL, hcM⟩ |
      ⟨Tc, σc, kMulti, j, ht0_1, hj, hqep, hbk, hnot_tH, hcL, hcM⟩
  · rcases hmiss (Or.inl hcL) (Or.inl hcM) with h1 | h2 | h3
    · exact Or.inl h1
    · exact Or.inr (Or.inl h2)
    · exact Or.inr (Or.inr (Or.inl h3))
  · by_cases hT : Tc = Tn
    · subst hT
      right; right; left
      refine ⟨((dhScheme Dh).receive (esLoc.g.st P).γ Tc).1, σc,
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver kVal, ?_, ?_⟩
      · dsimp only [locSR, hkLocOpt, hooksSlotBucketOptAt]
        simp [hcL, StateT.run_bind, StateT.run_get, StateT.run_pure, simulateQ_pure]
      · dsimp only [multiSR]
        rw [← hinv.vp_γ_eq P, ← hinv.vp_root_eq P, hkMultiOpt_startRecv]
        cases hmode : (mode == some true) <;>
          simp [hooksFSMultiDFBucketPaperMode, hooksFSMultiDFBucketPaper, pubFsImplOpt, hcM,
            StateT.run_bind, StateT.run_get, StateT.run_pure, simulateQ_pure]
    · rcases hmiss (Or.inr ⟨Tc, σc, kVal, hT, hcL⟩) (Or.inr ⟨Tc, σc, kVal, none, hT, hcM⟩) with h1 | h2 | h3
      · exact Or.inl h1
      · exact Or.inr (Or.inl h2)
      · exact Or.inr (Or.inr (Or.inl h3))
  · by_cases hT : Tc = Tn
    · subst hT
      right; right; right
      let sIdx := q * (t0 - healEpoch tL) + j
      have hj_q : j < q := by
        have hbd := hinv.sess_pos_bound t0 ht0_1
        omega
      have hrs_eq : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver (ks sIdx) =
          rsLoc sIdx :=
        (hinv.rs_fresh t0 j ht0_1 (healEpoch_le_of_gen4 hbk) hj_q (by rw [← hP]; omega)).symm
      refine ⟨((dhScheme Dh).receive (esLoc.g.st P).γ Tc).1, σc, j, hqep, hbk, hnot_tH, hj,
        ⟨Tc, σc, kMulti, hcM⟩, ?_, ?_⟩
      · dsimp only [locSR, hkLocOpt, hooksSlotBucketOptAt]
        simp [hcL, hrs_eq, sIdx, StateT.run_bind, StateT.run_get, StateT.run_pure, simulateQ_pure]
      · dsimp only [multiSR]
        rw [← hinv.vp_γ_eq P, ← hinv.vp_root_eq P, hkMultiOpt_startRecv]
        cases hmode : (mode == some true) <;>
          simp [hooksFSMultiDFBucketPaperMode, hooksFSMultiDFBucketPaper, pubFsImplOpt, hcM,
            StateT.run_bind, StateT.run_get, StateT.run_pure, simulateQ_pure]
    · rcases hmiss (Or.inr ⟨Tc, σc, ks (q * (t0 - healEpoch tL) + j), hT, hcL⟩)
          (Or.inr ⟨Tc, σc, kMulti, some (q * (t0 - healEpoch tL) + j), hT, hcM⟩) with h1 | h2 | h3
      · exact Or.inl h1
      · exact Or.inr (Or.inl h2)
      · exact Or.inr (Or.inr (Or.inl h3))

private theorem step2_inject_aux_inv_reject {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep rem : ℕ} (hq_pos : 0 < q) {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    {sIdx : ℕ} {hM' : MultiHS Pt} {sM' sL' : SessHSt Pt ℓ}
    (hlf : hM'.lfWin = esM.h.lfWin) (hsess : hM'.sessions = esM.h.sessions)
    (hf : hM'.fTable = esM.h.fTable) (hc : hM'.cache = esM.h.cache)
    (hbook_ne : ∀ i, i ≠ sIdx → hM'.book i = esM.h.book i)
    (hcnt : ((hM'.book sIdx).getD {}).fsCount = ((esM.h.book sIdx).getD {}).fsCount)
    (hact : ActiveSessInv C ℓ encT idOf (!((hM'.book sIdx).getD {}).sCorr) (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((hM'.book sIdx).getD {}) sM' sL')
    (hor : hM' = esM.h ∨
      (∃ t0 j, healedBy esLoc.g.tL 3 t0 = false ∧ inStage2BucketGen 4 tL par t0 = true ∧
        j < (esM.h.sessions t0).length ∧ sIdx = q * (t0 - healEpoch tL) + j)) :
    BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc rsLoc
      esLoc { esM with h := hM' } esL
      (Function.update tblM sIdx sM') (Function.update tblL sIdx sL') := by
  have hcnt_all : ∀ i, ((hM'.book i).getD {}).fsCount = ((esM.h.book i).getD {}).fsCount := by
    intro i
    by_cases hi : i = sIdx
    · subst hi; exact hcnt
    · rw [hbook_ne i hi]
  refine
    { gsync := hinv.gsync
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := hinv.win_false
      lfWin_M := by dsimp only; rw [hlf]; exact hinv.lfWin_M
      comp_unhealed := hinv.comp_unhealed
      tL_mem_leaks := hinv.tL_mem_leaks
      phase1_props := fun h => by cases h
      phase2_props := hinv.phase2_props
      sess_eq := by dsimp only; rw [hsess]; exact hinv.sess_eq
      sess_nodup := by dsimp only; rw [hsess]; exact hinv.sess_nodup
      sess_zero_le := by dsimp only; rw [hsess]; exact hinv.sess_zero_le
      sess_pos_bound := fun τ hτ => by
        dsimp only; rw [hsess]
        exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
      sess_epoch_ok := fun τ hne => by dsimp only at hne; rw [hsess] at hne; exact hinv.sess_epoch_ok τ hne
      fTable_M_iff := fun τ ik => by dsimp only; rw [hf, hsess]; exact hinv.fTable_M_iff τ ik
      fTable_loc_eq := fun τ ik => by dsimp only; rw [hsess]; exact hinv.fTable_loc_eq τ ik
      cache_sync := fun τ => by dsimp only; rw [hc, hsess]; exact hinv.cache_sync τ
      vp_id := hinv.vp_id
      vp_tcur_eq := hinv.vp_tcur_eq
      vp_γ_eq := hinv.vp_γ_eq
      vp_root_eq := hinv.vp_root_eq
      vp_cka_eq := hinv.vp_cka_eq
      vp_cka_cache := fun Q hsQ => by dsimp only; rw [hc]; exact hinv.vp_cka_cache Q hsQ
      epoch_bound := fun Q => le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
      vS_sync := fun Q => by dsimp only; rw [hsess]; exact hinv.vS_sync Q
      vR_dom := hinv.vR_dom
      vR_sync := fun Q τ => by dsimp only; rw [hsess]; exact hinv.vR_sync Q τ
      sess_inv := fun i => by
        dsimp only
        by_cases hi : i = sIdx
        · subst hi; simpa [Function.update_self] using hact
        · simpa [Function.update_of_ne hi, hbook_ne i hi] using hinv.sess_inv i
      ss_fresh := hinv.ss_fresh
      rs_fresh := hinv.rs_fresh
      book_fresh_before_send := fun τ j' h1 hge hj' hep hheal => by
        dsimp only
        rcases hor with rfl | ⟨t0, j, hunheal, hbk0, hj0, rfl⟩
        · exact hinv.book_fresh_before_send τ j' h1 hge hj' hep hheal
        · have hne : τ ≠ t0 := by intro h; subst h; rw [hunheal] at hheal; cases hheal
          rw [hbook_ne _ (step2_inject_aux_slot_ne hinv hne hbk0 hj0 hge hj')]
          exact hinv.book_fresh_before_send τ j' h1 hge hj' hep hheal
      trans_meta := fun r hr => by dsimp only; rw [hc]; exact hinv.trans_meta r hr
      cache_empty_gt := fun τ hlt => by dsimp only; rw [hc]; exact hinv.cache_empty_gt τ hlt
      healed_sender_pin := fun Q τ j' hsQ hτ hvS hheal => by
        dsimp only
        rw [hcnt_all, hc]
        exact hinv.healed_sender_pin Q τ j' hsQ hτ hvS hheal
      healed_vR_pin := fun Q τ sIdx' hvR hheal => by
        dsimp only
        rw [hc]
        exact hinv.healed_vR_pin Q τ sIdx' hvR hheal
      healed_book_trans := fun τ sIdx' hheal hro hpin => by
        dsimp only at hro hpin ⊢
        rw [hc] at hpin
        rcases hor with rfl | ⟨t0, j, hunheal, hbk0, hj0, rfl⟩
        · exact hinv.healed_book_trans τ sIdx' hheal hro hpin
        · have hne : τ ≠ t0 := by intro h; subst h; rw [hunheal] at hheal; cases hheal
          rw [hbook_ne _ (step2_inject_aux_pin_slot_ne hq_pos hinv hne hbk0 hj0 hpin)]
          exact hinv.healed_book_trans τ sIdx' hheal hro hpin }

private theorem step2_inject_aux_accept_props {St Msg C : Type}
    (s : GameState St Msg C) (P : Party) (st' : St) (pos : Pos) :
    (s.accept P st' pos).st = Function.update s.st P st' ∧
    (s.accept P st' pos).win = s.win ∧
    (s.accept P st' pos).idx = s.idx ∧
    (s.accept P st' pos).tL = s.tL ∧
    (s.accept P st' pos).leaks = s.leaks ∧
    (∀ Q, s.epoch Q ≤ (s.accept P st' pos).epoch Q) ∧
    (∀ r ∈ (s.accept P st' pos).trans, r ∈ s.trans) ∧
    (∀ τ, τ ≠ pos.epoch →
      (s.accept P st' pos).trans.filter (fun r => r.pos.epoch == τ) =
        s.trans.filter (fun r => r.pos.epoch == τ)) ∧
    (CompUnhealed s → CompUnhealed (s.accept P st' pos)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp [GameState.accept, GameState.delete]
  · simp [GameState.accept, GameState.delete]
  · simp [GameState.accept, GameState.delete]
  · simp [GameState.accept, GameState.delete]
  · simp [GameState.accept, GameState.delete]
  · intro Q
    rcases eq_or_ne Q P with rfl | hQ
    · rw [(accept_epoch_eq s Q st' pos).1]; exact Nat.le_max_left _ _
    · rw [(accept_epoch_eq s P st' pos).2.1 Q hQ]
  · intro r hr
    simp only [GameState.accept, GameState.delete, List.mem_filter] at hr
    exact hr.1
  · intro τ hne
    simp only [GameState.accept, GameState.delete, List.filter_filter]
    apply List.filter_congr
    intro r _
    by_cases hτ : (r.pos.epoch == τ) = true
    · have hr_ep : r.pos.epoch = τ := by simpa [BEq.beq] using hτ
      have hr_ne : r.pos ≠ pos := fun h => hne (hr_ep ▸ congrArg Pos.epoch h)
      rw [hτ]; simp [hr_ne, BEq.beq, bne]
    · simp [Bool.not_eq_true _ |>.mp hτ]
  · intro hcu
    unfold CompUnhealed at hcu ⊢
    refine ⟨fun r hr => ?_, fun p hp => ?_⟩
    · have hr_in : r ∈ s.trans := by
        simp only [GameState.accept, GameState.delete, List.mem_filter] at hr
        exact hr.1
      have hle_ep : s.epoch r.pos.sender ≤ (s.accept P st' pos).epoch r.pos.sender := by
        rcases eq_or_ne r.pos.sender P with hP | hP
        · rw [hP, (accept_epoch_eq s P st' pos).1]; exact Nat.le_max_left _ _
        · rw [(accept_epoch_eq s P st' pos).2.1 _ hP]
      exact le_trans (hcu.1 r hr_in) hle_ep
    · have hp' : p ∈ s.comp ∧ ¬p = pos := by simpa [GameState.accept, GameState.delete] using hp
      simpa [GameState.accept, GameState.delete] using hcu.2 p hp'.1

private theorem step2_inject_aux_inv_accept_inl {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep rem : ℕ} {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    {P : Party} {t0 idxOut : ℕ} {rs' : RatchetReceiverState (BitVec 256) (BitVec 256)}
    {stLoc' : LocVP Pt} {stM' : MultiVP Pt}
    (hP : P = Party.receiverOf t0)
    (ht0_le : t0 ≤ esLoc.g.epoch P + 1)
    (hunheal : healedBy esLoc.g.tL 3 t0 = false)
    (hid : stLoc'.id = P ∧ stM'.id = P)
    (htcur : stLoc'.tcur = max (esLoc.g.epoch P) t0 ∧ stM'.tcur = max (esLoc.g.epoch P) t0)
    (hγ : stLoc'.γ = stM'.γ)
    (hroot : stLoc'.root = stM'.root)
    (hcka : stLoc'.curCkaMsg = (esLoc.g.st P).curCkaMsg ∧ stM'.curCkaMsg = (esM.g.st P).curCkaMsg)
    (hvS : stLoc'.vS = (esLoc.g.st P).vS ∧ stM'.vS = (esM.g.st P).vS)
    (hvR_eq : stLoc'.vR t0 = some rs' ∧ stM'.vR t0 = some (.inl rs'))
    (hvR_ne : ∀ τ, τ ≠ t0 → stLoc'.vR τ = (esLoc.g.st P).vR τ ∧ stM'.vR τ = (esM.g.st P).vR τ) :
    let pos : Pos := ⟨P.other, t0, idxOut⟩
    BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc rsLoc
      { esLoc with g := esLoc.g.accept P stLoc' pos }
      { esM with g := esM.g.accept P stM' pos }
      esL tblM tblL := by
  intro pos
  let esLoc' : LocES Pt ℓ := { esLoc with g := esLoc.g.accept P stLoc' pos }
  let esM' : MultiES Pt ℓ := { esM with g := esM.g.accept P stM' pos }
  have hapL := step2_inject_aux_accept_props esLoc.g P stLoc' pos
  have hapM := step2_inject_aux_accept_props esM.g P stM' pos
  have hepL := accept_epoch_eq esLoc.g P stLoc' pos
  have hnot_sends : P.sendsIn t0 = false := (not_sendsIn_iff_receiverOf P t0).mpr hP
  have hepP_of_sends : P.sendsIn (esLoc'.g.epoch P) = true → esLoc'.g.epoch P = esLoc.g.epoch P := by
    intro hs
    dsimp only [esLoc'] at hs ⊢
    rw [hepL.1] at hs ⊢
    by_cases hle : t0 ≤ esLoc.g.epoch P
    · exact Nat.max_eq_left hle
    · rw [Nat.max_eq_right (Nat.le_of_not_le hle), hnot_sends] at hs
      cases hs
  refine
    { gsync := hinv.gsync.accept_sync P stLoc' stM' pos
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := by dsimp only; rw [hapL.2.1]; exact hinv.win_false
      lfWin_M := hinv.lfWin_M
      comp_unhealed := hapL.2.2.2.2.2.2.2.2 hinv.comp_unhealed
      tL_mem_leaks := fun cur hcur => by
        dsimp only at hcur ⊢
        rw [hapL.2.2.2.1] at hcur
        rw [hapL.2.2.2.2.1]
        exact hinv.tL_mem_leaks cur hcur
      phase1_props := fun h => by cases h
      phase2_props := fun h => by
        dsimp only [postLeak]
        rw [hapL.2.2.2.1]
        exact hinv.phase2_props h
      sess_eq := hinv.sess_eq
      sess_nodup := hinv.sess_nodup
      sess_zero_le := hinv.sess_zero_le
      sess_pos_bound := fun τ hτ =>
        le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
      sess_epoch_ok := hinv.sess_epoch_ok
      fTable_M_iff := hinv.fTable_M_iff
      fTable_loc_eq := hinv.fTable_loc_eq
      cache_sync := hinv.cache_sync
      vp_id := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [hid.1, hid.2]
        · simp [Function.update_of_ne hQ, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
      vp_tcur_eq := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · rw [hepL.1]; simp [htcur.1, htcur.2, pos]
        · rw [hepL.2.1 Q hQ]; simp [Function.update_of_ne hQ, (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
      vp_γ_eq := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [hγ]
        · simp [Function.update_of_ne hQ, hinv.vp_γ_eq Q]
      vp_root_eq := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [hroot]
        · simp [Function.update_of_ne hQ, hinv.vp_root_eq Q]
      vp_cka_eq := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [hcka.1, hcka.2, hinv.vp_cka_eq Q]
        · simp [Function.update_of_ne hQ, hinv.vp_cka_eq Q]
      vp_cka_cache := fun Q hQ_sends => by
        change Q.sendsIn (esLoc'.g.epoch Q) = true at hQ_sends
        rcases eq_or_ne Q P with rfl | hQ
        · have hep_eq := hepP_of_sends hQ_sends
          rw [hep_eq] at hQ_sends
          dsimp only [esLoc'] at hep_eq
          simpa [hep_eq, hapL.1, hapM.1, hcka.1, hvS.2] using
            hinv.vp_cka_cache Q hQ_sends
        · have hep_eq : (esLoc.g.accept P stLoc' pos).epoch Q = esLoc.g.epoch Q := hepL.2.1 Q hQ
          rw [show esLoc'.g.epoch Q = esLoc.g.epoch Q from hep_eq] at hQ_sends
          simpa [hep_eq, hapL.1, hapM.1, Function.update_of_ne hQ] using
            hinv.vp_cka_cache Q hQ_sends
      epoch_bound := fun Q => by
        dsimp only
        rcases eq_or_ne Q P with rfl | hQ
        · rw [hepL.1]
          have hbd := hinv.epoch_bound Q
          dsimp only [pos]; omega
        · rw [hepL.2.1 Q hQ]
          exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
      vS_sync := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · rw [Function.update_self, Function.update_self, hvS.1, hvS.2]
          rcases hinv.vS_sync Q with h0 | h1 | ⟨τ, j', hle, hsend_eq, hrest⟩
          · exact Or.inl h0
          · exact Or.inr (Or.inl h1)
          · refine Or.inr (Or.inr ⟨τ, j', le_trans hle (hapL.2.2.2.2.2.1 Q), fun hs => ?_, hrest⟩)
            have hep_eq := hepP_of_sends hs
            dsimp only [esLoc'] at hep_eq
            rw [hep_eq]
            exact hsend_eq (by rwa [hep_eq] at hs)
        · rw [Function.update_of_ne hQ, Function.update_of_ne hQ, hepL.2.1 Q hQ]
          exact hinv.vS_sync Q
      vR_dom := fun Q τ hdom => by
        dsimp only at hdom ⊢
        rw [hapM.1] at hdom
        rcases eq_or_ne Q P with rfl | hQ
        · simp only [Function.update_self] at hdom
          by_cases hτ : τ = t0
          · subst hτ
            rw [hepL.1]
            exact ⟨Nat.le_max_right _ _, hP⟩
          · rw [(hvR_ne τ hτ).2] at hdom
            obtain ⟨hle, hrec⟩ := hinv.vR_dom Q τ hdom
            exact ⟨le_trans hle (hapL.2.2.2.2.2.1 Q), hrec⟩
        · simp only [Function.update_of_ne hQ] at hdom
          rw [hepL.2.1 Q hQ]
          exact hinv.vR_dom Q τ hdom
      vR_sync := fun Q τ => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · rw [Function.update_self, Function.update_self]
          by_cases hτ : τ = t0
          · subst hτ
            exact Or.inr (Or.inl ⟨rs', hvR_eq.1, hvR_eq.2⟩)
          · rw [(hvR_ne τ hτ).1, (hvR_ne τ hτ).2]
            exact hinv.vR_sync Q τ
        · rw [Function.update_of_ne hQ, Function.update_of_ne hQ]
          exact hinv.vR_sync Q τ
      sess_inv := hinv.sess_inv
      ss_fresh := fun τ j' h1 h2 h3 hlt =>
        hinv.ss_fresh τ j' h1 h2 h3 (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt)
      rs_fresh := fun τ j' h1 h2 h3 hlt =>
        hinv.rs_fresh τ j' h1 h2 h3 (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt)
      book_fresh_before_send := fun τ j' h1 h2 h3 hlt hh => by
        dsimp only at hlt hh ⊢
        rw [hapL.2.2.2.1] at hh
        exact hinv.book_fresh_before_send τ j' h1 h2 h3 (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt) hh
      trans_meta := fun r' hr' => by
        dsimp only at hr' ⊢
        obtain ⟨h1, h2, h3, h4, h5⟩ := hinv.trans_meta r' (hapL.2.2.2.2.2.2.1 r' hr')
        exact ⟨h1, h2, le_trans h3 (hapL.2.2.2.2.2.1 _), h4, h5⟩
      cache_empty_gt := fun τ hlt =>
        hinv.cache_empty_gt τ (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt)
      healed_sender_pin := fun Q τ j' hsQ hτ hvS_in hh => by
        dsimp only at hsQ hτ hvS_in hh ⊢
        rw [hapL.2.2.2.1] at hh
        rw [hapM.1] at hvS_in
        rw [hapL.2.2.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · have hep_eq := hepP_of_sends hsQ
          dsimp only [esLoc'] at hep_eq
          rw [hep_eq] at hsQ hτ
          simp only [Function.update_self, hvS.2, hcka.2] at hvS_in ⊢
          exact hinv.healed_sender_pin Q τ j' hsQ hτ hvS_in hh
        · rw [hepL.2.1 Q hQ] at hsQ hτ
          simp only [Function.update_of_ne hQ] at hvS_in ⊢
          exact hinv.healed_sender_pin Q τ j' hsQ hτ hvS_in hh
      healed_vR_pin := fun Q τ sIdx' hvR hh => by
        dsimp only at hvR hh ⊢
        rw [hapM.1] at hvR
        rw [hapL.2.2.2.1] at hh
        rcases eq_or_ne Q P with rfl | hQ
        · simp only [Function.update_self] at hvR
          by_cases hτ : τ = t0
          · subst hτ; rw [hvR_eq.2] at hvR; cases hvR
          · rw [(hvR_ne τ hτ).2] at hvR
            exact hinv.healed_vR_pin Q τ sIdx' hvR hh
        · simp only [Function.update_of_ne hQ] at hvR
          exact hinv.healed_vR_pin Q τ sIdx' hvR hh
      healed_book_trans := fun τ sIdx' hh hro hpin => by
        dsimp only at hh hro hpin ⊢
        rw [hapL.2.2.2.1] at hh
        have hne : τ ≠ t0 := by intro h; subst h; rw [hunheal] at hh; cases hh
        have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
            (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
          rcases hro with hlt | hvR
          · exact Or.inl (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt)
          · refine Or.inr ?_
            rw [hapM.1] at hvR
            by_cases hQ : Party.receiverOf τ = P
            · rw [hQ] at hvR ⊢
              simp only [Function.update_self] at hvR
              rwa [(hvR_ne τ hne).2] at hvR
            · simpa [Function.update_of_ne hQ] using hvR
        rw [hapL.2.2.2.2.2.2.2.1 τ hne]
        exact hinv.healed_book_trans τ sIdx' hh hro_orig hpin }

private theorem step2_inject_aux_inv_accept_inr {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep rem : ℕ} (hq_pos : 0 < q) {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    {P : Party} {t0 j idxOut : ℕ} {rs' : RatchetReceiverState (BitVec 256) (BitVec 256)}
    {hM' : MultiHS Pt} {sM' sL' : SessHSt Pt ℓ}
    {stLoc' : LocVP Pt} {stM' : MultiVP Pt}
    (hP : P = Party.receiverOf t0)
    (ht0_le : t0 ≤ esLoc.g.epoch P + 1)
    (ht0_cap : !(qep + 1 < t0) = true)
    (hbk0 : inStage2BucketGen 4 tL par t0 = true)
    (ht0_not_tH : !(tL.isSome && (t0 == healEpoch tL)) = true)
    (hj0 : j < (esM.h.sessions t0).length)
    (hunheal : healedBy esLoc.g.tL 3 t0 = false)
    (hlf : hM'.lfWin = esM.h.lfWin) (hsess : hM'.sessions = esM.h.sessions)
    (hf : hM'.fTable = esM.h.fTable) (hc : hM'.cache = esM.h.cache)
    (hbook_ne : ∀ i, i ≠ q * (t0 - healEpoch tL) + j → hM'.book i = esM.h.book i)
    (hcnt : ((hM'.book (q * (t0 - healEpoch tL) + j)).getD {}).fsCount =
      ((esM.h.book (q * (t0 - healEpoch tL) + j)).getD {}).fsCount)
    (hact : ActiveSessInv C ℓ encT idOf (!((hM'.book (q * (t0 - healEpoch tL) + j)).getD {}).sCorr)
      (ks (q * (t0 - healEpoch tL) + j)) (ssLoc (q * (t0 - healEpoch tL) + j)) rs'
      ((hM'.book (q * (t0 - healEpoch tL) + j)).getD {}) sM' sL')
    (hid : stLoc'.id = P ∧ stM'.id = P)
    (htcur : stLoc'.tcur = max (esLoc.g.epoch P) t0 ∧ stM'.tcur = max (esLoc.g.epoch P) t0)
    (hγ : stLoc'.γ = stM'.γ)
    (hroot : stLoc'.root = stM'.root)
    (hcka : stLoc'.curCkaMsg = (esLoc.g.st P).curCkaMsg ∧ stM'.curCkaMsg = (esM.g.st P).curCkaMsg)
    (hvS : stLoc'.vS = (esLoc.g.st P).vS ∧ stM'.vS = (esM.g.st P).vS)
    (hvR_eq : stLoc'.vR t0 = some rs' ∧ stM'.vR t0 = some (.inr (q * (t0 - healEpoch tL) + j)))
    (hvR_ne : ∀ τ, τ ≠ t0 → stLoc'.vR τ = (esLoc.g.st P).vR τ ∧ stM'.vR τ = (esM.g.st P).vR τ) :
    let pos : Pos := ⟨P.other, t0, idxOut⟩
    let sIdx := q * (t0 - healEpoch tL) + j
    BucketSimInv C ℓ encT idOf q qep tL par ks false rem
      ssLoc (Function.update rsLoc sIdx rs')
      { esLoc with g := esLoc.g.accept P stLoc' pos }
      { esM with g := esM.g.accept P stM' pos, h := hM' }
      esL (Function.update tblM sIdx sM') (Function.update tblL sIdx sL') := by
  intro pos sIdx
  let esLoc' : LocES Pt ℓ := { esLoc with g := esLoc.g.accept P stLoc' pos }
  let esM' : MultiES Pt ℓ := { esM with g := esM.g.accept P stM' pos, h := hM' }
  have hapL := step2_inject_aux_accept_props esLoc.g P stLoc' pos
  have hapM := step2_inject_aux_accept_props esM.g P stM' pos
  have hepL := accept_epoch_eq esLoc.g P stLoc' pos
  have hnot_sends : P.sendsIn t0 = false := (not_sendsIn_iff_receiverOf P t0).mpr hP
  have hcnt_all : ∀ i, ((hM'.book i).getD {}).fsCount = ((esM.h.book i).getD {}).fsCount := by
    intro i
    by_cases hi : i = sIdx
    · subst hi; exact hcnt
    · rw [hbook_ne i hi]
  have hepP_of_sends : P.sendsIn (esLoc'.g.epoch P) = true → esLoc'.g.epoch P = esLoc.g.epoch P := by
    intro hs
    dsimp only [esLoc'] at hs ⊢
    rw [hepL.1] at hs ⊢
    by_cases hle : t0 ≤ esLoc.g.epoch P
    · exact Nat.max_eq_left hle
    · rw [Nat.max_eq_right (Nat.le_of_not_le hle), hnot_sends] at hs
      cases hs
  refine
    { gsync := hinv.gsync.accept_sync P stLoc' stM' pos
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := by dsimp only; rw [hapL.2.1]; exact hinv.win_false
      lfWin_M := by dsimp only; rw [hlf]; exact hinv.lfWin_M
      comp_unhealed := hapL.2.2.2.2.2.2.2.2 hinv.comp_unhealed
      tL_mem_leaks := fun cur hcur => by
        dsimp only at hcur ⊢
        rw [hapL.2.2.2.1] at hcur
        rw [hapL.2.2.2.2.1]
        exact hinv.tL_mem_leaks cur hcur
      phase1_props := fun h => by cases h
      phase2_props := fun h => by
        dsimp only [postLeak]
        rw [hapL.2.2.2.1]
        exact hinv.phase2_props h
      sess_eq := by dsimp only; rw [hsess]; exact hinv.sess_eq
      sess_nodup := by dsimp only; rw [hsess]; exact hinv.sess_nodup
      sess_zero_le := by dsimp only; rw [hsess]; exact hinv.sess_zero_le
      sess_pos_bound := fun τ hτ => by
        dsimp only; rw [hsess]
        exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
      sess_epoch_ok := fun τ hne => by dsimp only at hne; rw [hsess] at hne; exact hinv.sess_epoch_ok τ hne
      fTable_M_iff := fun τ ik => by dsimp only; rw [hf, hsess]; exact hinv.fTable_M_iff τ ik
      fTable_loc_eq := fun τ ik => by dsimp only; rw [hsess]; exact hinv.fTable_loc_eq τ ik
      cache_sync := fun τ => by dsimp only; rw [hc, hsess]; exact hinv.cache_sync τ
      vp_id := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [hid.1, hid.2]
        · simp [Function.update_of_ne hQ, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
      vp_tcur_eq := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · rw [hepL.1]; simp [htcur.1, htcur.2, pos]
        · rw [hepL.2.1 Q hQ]; simp [Function.update_of_ne hQ, (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
      vp_γ_eq := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [hγ]
        · simp [Function.update_of_ne hQ, hinv.vp_γ_eq Q]
      vp_root_eq := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [hroot]
        · simp [Function.update_of_ne hQ, hinv.vp_root_eq Q]
      vp_cka_eq := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [hcka.1, hcka.2, hinv.vp_cka_eq Q]
        · simp [Function.update_of_ne hQ, hinv.vp_cka_eq Q]
      vp_cka_cache := fun Q hQ_sends => by
        change Q.sendsIn (esLoc'.g.epoch Q) = true at hQ_sends
        rcases eq_or_ne Q P with rfl | hQ
        · have hep_eq := hepP_of_sends hQ_sends
          rw [hep_eq] at hQ_sends
          dsimp only [esLoc'] at hep_eq
          simpa [hep_eq, hapL.1, hapM.1, hcka.1, hvS.2, hc] using
            hinv.vp_cka_cache Q hQ_sends
        · have hep_eq : (esLoc.g.accept P stLoc' pos).epoch Q = esLoc.g.epoch Q := hepL.2.1 Q hQ
          rw [show esLoc'.g.epoch Q = esLoc.g.epoch Q from hep_eq] at hQ_sends
          simpa [hep_eq, hapL.1, hapM.1, Function.update_of_ne hQ, hc] using
            hinv.vp_cka_cache Q hQ_sends
      epoch_bound := fun Q => by
        dsimp only
        rcases eq_or_ne Q P with rfl | hQ
        · rw [hepL.1]
          have hbd := hinv.epoch_bound Q
          dsimp only [pos]; omega
        · rw [hepL.2.1 Q hQ]
          exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
      vS_sync := fun Q => by
        dsimp only
        rw [hapL.1, hapM.1, hsess]
        rcases eq_or_ne Q P with rfl | hQ
        · rw [Function.update_self, Function.update_self, hvS.1, hvS.2]
          rcases hinv.vS_sync Q with h0 | h1 | ⟨τ, j', hle, hsend_eq, hrest⟩
          · exact Or.inl h0
          · exact Or.inr (Or.inl h1)
          · refine Or.inr (Or.inr ⟨τ, j', le_trans hle (hapL.2.2.2.2.2.1 Q), fun hs => ?_, hrest⟩)
            have hep_eq := hepP_of_sends hs
            dsimp only [esLoc'] at hep_eq
            rw [hep_eq]
            exact hsend_eq (by rwa [hep_eq] at hs)
        · rw [Function.update_of_ne hQ, Function.update_of_ne hQ, hepL.2.1 Q hQ]
          exact hinv.vS_sync Q
      vR_dom := fun Q τ hdom => by
        dsimp only at hdom ⊢
        rw [hapM.1] at hdom
        rcases eq_or_ne Q P with rfl | hQ
        · simp only [Function.update_self] at hdom
          by_cases hτ : τ = t0
          · subst hτ
            rw [hepL.1]
            exact ⟨Nat.le_max_right _ _, hP⟩
          · rw [(hvR_ne τ hτ).2] at hdom
            obtain ⟨hle, hrec⟩ := hinv.vR_dom Q τ hdom
            exact ⟨le_trans hle (hapL.2.2.2.2.2.1 Q), hrec⟩
        · simp only [Function.update_of_ne hQ] at hdom
          rw [hepL.2.1 Q hQ]
          exact hinv.vR_dom Q τ hdom
      vR_sync := fun Q τ => by
        dsimp only
        rw [hapL.1, hapM.1, hsess]
        rcases eq_or_ne Q P with rfl | hQ
        · rw [Function.update_self, Function.update_self]
          by_cases hτ : τ = t0
          · subst hτ
            exact Or.inr (Or.inr ⟨j, hP, ht0_cap, hbk0, ht0_not_tH, hj0,
              by rw [Function.update_self]; exact hvR_eq.1, hvR_eq.2⟩)
          · rw [(hvR_ne τ hτ).1, (hvR_ne τ hτ).2]
            rcases hinv.vR_sync Q τ with h0 | h1 | ⟨j', hQ_rec, hcap', hbk', hnot_tH', hj', hv1, hv2⟩
            · exact Or.inl h0
            · exact Or.inr (Or.inl h1)
            · have hj'_q : j' < q := by
                rcases Nat.eq_zero_or_pos τ with rfl | hτ_pos
                · exact Nat.lt_of_lt_of_le hj' hinv.sess_zero_le
                · have hbd := hinv.sess_pos_bound τ hτ_pos; omega
              have hne_s := step2_inject_aux_slot_ne hinv hτ hbk0 hj0 (healEpoch_le_of_gen4 hbk') hj'_q
              exact Or.inr (Or.inr ⟨j', hQ_rec, hcap', hbk', hnot_tH', hj',
                by rw [Function.update_of_ne hne_s]; exact hv1, hv2⟩)
        · rw [Function.update_of_ne hQ, Function.update_of_ne hQ]
          rcases hinv.vR_sync Q τ with h0 | h1 | ⟨j', hQ_rec, hcap', hbk', hnot_tH', hj', hv1, hv2⟩
          · exact Or.inl h0
          · exact Or.inr (Or.inl h1)
          · have hτ : τ ≠ t0 := by intro h; subst h; exact hQ (hQ_rec.trans hP.symm)
            have hj'_q : j' < q := by
              rcases Nat.eq_zero_or_pos τ with rfl | hτ_pos
              · exact Nat.lt_of_lt_of_le hj' hinv.sess_zero_le
              · have hbd := hinv.sess_pos_bound τ hτ_pos; omega
            have hne_s := step2_inject_aux_slot_ne hinv hτ hbk0 hj0 (healEpoch_le_of_gen4 hbk') hj'_q
            exact Or.inr (Or.inr ⟨j', hQ_rec, hcap', hbk', hnot_tH', hj',
              by rw [Function.update_of_ne hne_s]; exact hv1, hv2⟩)
      sess_inv := fun i => by
        dsimp only
        by_cases hi : i = sIdx
        · subst hi; simpa [sIdx, Function.update_self] using hact
        · simpa [sIdx, Function.update_of_ne hi, hbook_ne i hi] using hinv.sess_inv i
      ss_fresh := fun τ j' h1 h2 h3 hlt =>
        hinv.ss_fresh τ j' h1 h2 h3 (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt)
      rs_fresh := fun τ j' h1 h2 h3 hlt => by
        dsimp only at hlt ⊢
        have hτ : τ ≠ t0 := by
          intro h; subst h
          rw [← hP, hepL.1] at hlt
          dsimp only [pos] at hlt
          omega
        have hne_s := step2_inject_aux_slot_ne hinv hτ hbk0 hj0 h2 h3
        rw [Function.update_of_ne hne_s]
        exact hinv.rs_fresh τ j' h1 h2 h3 (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt)
      book_fresh_before_send := fun τ j' h1 h2 h3 hlt hh => by
        dsimp only at hlt hh ⊢
        rw [hapL.2.2.2.1] at hh
        have hτ : τ ≠ t0 := by intro h; subst h; rw [hunheal] at hh; cases hh
        rw [hbook_ne _ (step2_inject_aux_slot_ne hinv hτ hbk0 hj0 h2 h3)]
        exact hinv.book_fresh_before_send τ j' h1 h2 h3 (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt) hh
      trans_meta := fun r' hr' => by
        dsimp only at hr' ⊢
        rw [hc]
        obtain ⟨h1, h2, h3, h4, h5⟩ := hinv.trans_meta r' (hapL.2.2.2.2.2.2.1 r' hr')
        exact ⟨h1, h2, le_trans h3 (hapL.2.2.2.2.2.1 _), h4, h5⟩
      cache_empty_gt := fun τ hlt => by
        dsimp only; rw [hc]
        exact hinv.cache_empty_gt τ (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt)
      healed_sender_pin := fun Q τ j' hsQ hτ hvS_in hh => by
        dsimp only at hsQ hτ hvS_in hh ⊢
        rw [hapL.2.2.2.1] at hh
        rw [hapM.1] at hvS_in
        rw [hapL.2.2.1, hapM.1, hcnt_all, hc]
        rcases eq_or_ne Q P with rfl | hQ
        · have hep_eq := hepP_of_sends hsQ
          dsimp only [esLoc'] at hep_eq
          rw [hep_eq] at hsQ hτ
          simp only [Function.update_self, hvS.2, hcka.2] at hvS_in ⊢
          exact hinv.healed_sender_pin Q τ j' hsQ hτ hvS_in hh
        · rw [hepL.2.1 Q hQ] at hsQ hτ
          simp only [Function.update_of_ne hQ] at hvS_in ⊢
          exact hinv.healed_sender_pin Q τ j' hsQ hτ hvS_in hh
      healed_vR_pin := fun Q τ sIdx' hvR hh => by
        dsimp only at hvR hh ⊢
        rw [hapM.1] at hvR
        rw [hapL.2.2.2.1] at hh
        rw [hc]
        rcases eq_or_ne Q P with rfl | hQ
        · simp only [Function.update_self] at hvR
          by_cases hτ : τ = t0
          · subst hτ; rw [hunheal] at hh; cases hh
          · rw [(hvR_ne τ hτ).2] at hvR
            exact hinv.healed_vR_pin Q τ sIdx' hvR hh
        · simp only [Function.update_of_ne hQ] at hvR
          exact hinv.healed_vR_pin Q τ sIdx' hvR hh
      healed_book_trans := fun τ sIdx' hh hro hpin => by
        dsimp only at hh hro hpin ⊢
        rw [hapL.2.2.2.1] at hh
        rw [hc] at hpin
        have hne : τ ≠ t0 := by intro h; subst h; rw [hunheal] at hh; cases hh
        have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
            (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
          rcases hro with hlt | hvR
          · exact Or.inl (lt_of_le_of_lt (hapL.2.2.2.2.2.1 _) hlt)
          · refine Or.inr ?_
            rw [hapM.1] at hvR
            by_cases hQ : Party.receiverOf τ = P
            · rw [hQ] at hvR ⊢
              simp only [Function.update_self] at hvR
              rwa [(hvR_ne τ hne).2] at hvR
            · simpa [Function.update_of_ne hQ] using hvR
        rw [hbook_ne _ (step2_inject_aux_pin_slot_ne hq_pos hinv hne hbk0 hj0 hpin),
          hapL.2.2.2.2.2.2.2.1 τ hne]
        exact hinv.healed_book_trans τ sIdx' hh hro_orig hpin }

private theorem step2_inject_aux_gsync_inj {Pt : Type} [DecidableEq Pt] {ℓ : ℕ}
    {gLoc : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256)) (RatchetReceiverState (BitVec 256) (BitVec 256))
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    {gM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    (h : GSync gLoc gM) (P : Party) (c : Fig8C Pt) :
    gLoc.inTransit P.other c = gM.inTransit P.other c ∧
    gLoc.safeInj 3 = gM.safeInj 3 := by
  refine ⟨?_, ?_⟩
  · unfold GameState.inTransit; rw [h.trans_eq]
  · unfold GameState.safeInj
    try rw [h.epoch_eq]
    try rw [h.idx_eq]
    try rw [h.tL_eq]
    try rw [h.trans_eq]
    try rw [h.chall_eq]
    try rw [h.comp_eq]
    try rw [h.maxAcc_eq]
    try rw [h.b_eq]
    try rw [h.win_eq]
    try rw [h.leaks_eq]
    try rw [h.corrs_eq]

private theorem step2_inject_aux_fsRecv_inl {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctxM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (rs0 : RatchetReceiverState (BitVec 256) (BitVec 256)) (c : Fig8C Pt)
    (hM : MultiHS Pt) (tblM : ℕ → SessHSt Pt ℓ) :
    (simulateQ (pubFsImplOpt C ℓ encT idOf false)
      (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
        ctxM P c.1.1 (.inl rs0) c.1 c.2 none).run hM)).run (fun _ => false, tblM) =
    match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rs0 c.1 c.2 with
    | none => pure ((some none, hM), (fun _ => false, tblM))
    | some (rs', idxOut, pmOut) =>
      pure ((some (some (.inl rs', idxOut, pmOut)), hM), (fun _ => false, tblM)) := by
  rw [hkMultiOpt_fsRecv]
  dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
  cases (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rs0 c.1 c.2 <;>
    simp [Option.map, StateT.run_pure, simulateQ_pure]

private theorem step2_inject_aux_run_loc {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt) (esLoc : LocES Pt ℓ)
    (resLoc : Option (Option (LocVP Pt × ℕ × ℕ × (LibsignalMsgPublicPart × Plain ℓ))))
    (hguard : (esLoc.abort || esLoc.g.win || (esLoc.g.inTransit P.other c).isSome ||
      !(esLoc.g.safeInj 3)) = false) :
    simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (((_root_.CryptoGames.SM.Engine.vRecv
        (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        esLoc.g P (esLoc.g.st P) c none)).run esLoc.h) = pure (resLoc, esLoc.h) →
    simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        3 qep maxForwardJumps (bucketAuthCfg 1 tL par))
          (.inr (.inl (.inl (.inr ⟨P, c⟩))))).run esLoc) =
    match resLoc with
    | none => pure (none, { esLoc with abort := true })
    | some none => pure (some .rejected, esLoc)
    | some (some (stLoc', t', i', m')) =>
      if qep + 1 < t' then pure (some .rejected, esLoc)
      else if esLoc.g.trivial 3 ⟨P.other, t', i'⟩ then
        pure (some (.accepted t' i' (some m')),
          { esLoc with g := esLoc.g.accept P stLoc' ⟨P.other, t', i'⟩ })
      else if inStage2Bucket 1 tL par t' then
        pure (some .rejected, { esLoc with g := { esLoc.g with win := true } })
      else
        pure (some .rejected, esLoc) := by
  intro hvLoc
  rcases esLoc with ⟨gLoc, hLoc, abortLoc⟩
  dsimp only [implEDFPaperBucketRaw]
  simp only [QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
    _root_.CryptoGames.SM.Engine.injectE,
    StateT.run_bind, StateT.run_get, pure_bind, hguard, Bool.false_eq_true, ↓reduceIte,
    run_liftH_eq, simulateQ_bind, hvLoc]
  cases resLoc with
  | none =>
    simp [_root_.CryptoGames.SM.Engine.abortE, StateT.run_modify, simulateQ_pure]
  | some inner =>
    cases inner with
    | none =>
      simp [StateT.run_pure, simulateQ_pure]
    | some val =>
      rcases val with ⟨stLoc', t', i', m'⟩
      by_cases hcap : qep + 1 < t'
      · simp [hcap, StateT.run_pure, simulateQ_pure]
      · cases htriv : gLoc.trivial 3 ⟨P.other, t', i'⟩
        · dsimp only [bucketAuthCfg]
          by_cases hfull : inStage2Bucket 1 tL par t' = true <;>
            simp [hcap, htriv, hfull, StateT.run_modify, StateT.run_pure, simulateQ_pure]
        · simp [hcap, htriv, _root_.CryptoGames.SM.Engine.commitE, hkLocOpt,
            hooksSlotBucketOptAt, StateT.run_bind, StateT.run_modify,
            StateT.run_pure, simulateQ_pure]

private theorem step2_inject_aux_run_multi {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool)
    (P : Party) (c : Fig8C Pt) (esM : MultiES Pt ℓ) (hM' : MultiHS Pt)
    (tblM tblM' : ℕ → SessHSt Pt ℓ)
    (resM : Option (Option (MultiVP Pt × ℕ × ℕ × (LibsignalMsgPublicPart × Plain ℓ))))
    (hguard : (esM.abort || esM.g.win || (esM.g.inTransit P.other c).isSome ||
      !(esM.g.safeInj 3)) = false) :
    (simulateQ (pubFsImplOpt C ℓ encT idOf false)
      (((_root_.CryptoGames.SM.Engine.vRecv
        (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
        esM.g P (esM.g.st P) c none)).run esM.h)).run (fun _ => false, tblM) =
      pure ((resM, hM'), (fun _ => false, tblM')) →
    (simulateQ (pubFsImplOpt C ℓ encT idOf false)
      (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
        3 qep maxForwardJumps (bucketAuthCfg 1 tL par))
          (.inr (.inl (.inl (.inr ⟨P, c⟩))))).run esM)).run (fun _ => false, tblM) =
    match resM with
    | none => pure ((none, { esM with h := hM', abort := true }), (fun _ => false, tblM'))
    | some none => pure ((some .rejected, { esM with h := hM' }), (fun _ => false, tblM'))
    | some (some (stM', t', i', m')) =>
      if qep + 1 < t' then pure ((some .rejected, { esM with h := hM' }), (fun _ => false, tblM'))
      else if esM.g.trivial 3 ⟨P.other, t', i'⟩ then
        pure ((some (.accepted t' i' (some m')),
          { esM with g := esM.g.accept P stM' ⟨P.other, t', i'⟩, h := hM' }), (fun _ => false, tblM'))
      else if inStage2Bucket 1 tL par t' then
        pure ((some .rejected, { esM with g := { esM.g with win := true }, h := hM' }),
          (fun _ => false, tblM'))
      else
        pure ((some .rejected, { esM with h := hM' }), (fun _ => false, tblM')) := by
  intro hvM
  rcases esM with ⟨gM, hM, abortM⟩
  dsimp only [implEDFPaperBucketRaw]
  simp only [QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
    _root_.CryptoGames.SM.Engine.injectE,
    StateT.run_bind, StateT.run_get, pure_bind, hguard, Bool.false_eq_true, ↓reduceIte,
    run_liftH_eq, simulateQ_bind]
  rw [hvM]
  simp only [pure_bind, StateT.run_pure, simulateQ_pure]
  cases resM with
  | none =>
    simp [_root_.CryptoGames.SM.Engine.abortE, StateT.run_modify, StateT.run_pure, simulateQ_pure]
  | some inner =>
    cases inner with
    | none =>
      simp [StateT.run_pure, simulateQ_pure]
    | some val =>
      rcases val with ⟨stM', t', i', m'⟩
      by_cases hcap : qep + 1 < t'
      · simp [hcap, StateT.run_pure, simulateQ_pure]
      · cases htriv : gM.trivial 3 ⟨P.other, t', i'⟩
        · dsimp only [bucketAuthCfg]
          by_cases hfull : inStage2Bucket 1 tL par t' = true <;>
            simp [hcap, htriv, hfull, StateT.run_modify, StateT.run_pure, simulateQ_pure]
        · simp [hcap, htriv, _root_.CryptoGames.SM.Engine.commitE, hkMultiOpt_commit,
            StateT.run_bind, StateT.run_modify, StateT.run_pure,
            simulateQ_pure]

private theorem step2_inject_aux_finish_inl {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt) {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range (.inl (.inl (.inr ⟨P, c⟩))) →
      OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (hguardLoc : (esLoc.abort || esLoc.g.win || (esLoc.g.inTransit P.other c).isSome ||
      !(esLoc.g.safeInj 3)) = false)
    (hguardM : (esM.abort || esM.g.win || (esM.g.inTransit P.other c).isSome ||
      !(esM.g.safeInj 3)) = false)
    (hP : P = Party.receiverOf c.1.1)
    (ht0_le : c.1.1 ≤ esLoc.g.epoch P + 1)
    (s₁Loc : LocVP Pt) (s₁M : MultiVP Pt)
    (rs0 : RatchetReceiverState (BitVec 256) (BitVec 256))
    (hid : s₁Loc.id = P ∧ s₁M.id = P)
    (htcur : s₁Loc.tcur = max (esLoc.g.epoch P) c.1.1 ∧ s₁M.tcur = max (esLoc.g.epoch P) c.1.1)
    (hγ : s₁Loc.γ = s₁M.γ)
    (hroot : s₁Loc.root = s₁M.root)
    (hcka : s₁Loc.curCkaMsg = (esLoc.g.st P).curCkaMsg ∧ s₁M.curCkaMsg = (esM.g.st P).curCkaMsg)
    (hvS : s₁Loc.vS = (esLoc.g.st P).vS ∧ s₁M.vS = (esM.g.st P).vS)
    (hvR_ne : ∀ τ, τ ≠ c.1.1 → s₁Loc.vR τ = (esLoc.g.st P).vR τ ∧ s₁M.vR τ = (esM.g.st P).vR τ)
    (hvLoc : simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (((_root_.CryptoGames.SM.Engine.vRecv
        (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        esLoc.g P (esLoc.g.st P) c none)).run esLoc.h) =
      pure (match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rs0 c.1 c.2 with
        | none => some none
        | some (rs', i, m) =>
          some (some ({ s₁Loc with vR := Function.update s₁Loc.vR c.1.1 (some rs') }, c.1.1, i, m)),
        esLoc.h))
    (hvM : (simulateQ (pubFsImplOpt C ℓ encT idOf false)
      (((_root_.CryptoGames.SM.Engine.vRecv
        (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
        esM.g P (esM.g.st P) c none)).run esM.h)).run (fun _ => false, tblM) =
      pure ((match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rs0 c.1 c.2 with
        | none => some none
        | some (rs', i, m) =>
          some (some ({ s₁M with vR := Function.update s₁M.vR c.1.1 (some (.inl rs')) }, c.1.1, i, m)),
        esM.h), (fun _ => false, tblM))) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inr ⟨P, c⟩))
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  intro qr
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  have hstepLoc := step2_inject_aux_run_loc mode C Dh encPt encT idOf ℓ q qep tL par ks P c esLoc _ hguardLoc hvLoc
  have hstepM := step2_inject_aux_run_multi mode C Dh encPt encT idOf ℓ q qep tL par P c esM esM.h tblM tblM _ hguardM hvM
  dsimp only at hstepLoc hstepM
  cases hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rs0 c.1 c.2 with
  | none =>
    rw [hrecv] at hstepLoc hstepM
    dsimp only at hstepLoc hstepM
    rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc (some .rejected) hinv.win_false hstepLoc,
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM (some .rejected) hwinM hstepM]
    simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
    exact hIH2 (some .rejected) ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))
  | some val =>
    rcases val with ⟨rs', idxOut, pmOut⟩
    rw [hrecv] at hstepLoc hstepM
    dsimp only at hstepLoc hstepM
    by_cases hcap : qep + 1 < c.1.1
    · simp only [hcap, ↓reduceIte] at hstepLoc hstepM
      rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc (some .rejected) hinv.win_false hstepLoc,
          runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM (some .rejected) hwinM hstepM]
      simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
      exact hIH2 (some .rejected) ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))
    · simp only [hcap, ↓reduceIte] at hstepLoc hstepM
      let pos : Pos := ⟨P.other, c.1.1, idxOut⟩
      rw [← hinv.gsync.trivial_eq 3 pos] at hstepM
      cases htriv : esLoc.g.trivial 3 pos with
      | true =>
        simp only [pos, htriv, ↓reduceIte] at hstepLoc hstepM
        have hunheal : healedBy esLoc.g.tL 3 c.1.1 = false := by
          cases hh : healedBy esLoc.g.tL 3 c.1.1
          · rfl
          · have hf := trivial_eq_false_of_healed hinv.comp_unhealed (pos := pos) hh
            rw [htriv] at hf; cases hf
        let stLoc' : LocVP Pt := { s₁Loc with vR := Function.update s₁Loc.vR c.1.1 (some rs') }
        let stM' : MultiVP Pt := { s₁M with vR := Function.update s₁M.vR c.1.1 (some (.inl rs')) }
        let esLoc' : LocES Pt ℓ := { esLoc with g := esLoc.g.accept P stLoc' pos }
        let esM' : MultiES Pt ℓ := { esM with g := esM.g.accept P stM' pos }
        have hwinLoc' : esLoc'.g.win = false := by
          dsimp only [esLoc']; rw [(step2_inject_aux_accept_props _ _ _ _).2.1]; exact hinv.win_false
        have hwinM' : esM'.g.win = false := by
          dsimp only [esM']; rw [(step2_inject_aux_accept_props _ _ _ _).2.1]; exact hwinM
        rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc'
              (some (.accepted c.1.1 idxOut (some pmOut))) hinv.win_false hstepLoc,
            runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblM tblM
              (some (.accepted c.1.1 idxOut (some pmOut))) hwinM hstepM]
        simp only [hwinLoc', hwinM', calcWinEp, Bool.false_eq_true, ↓reduceIte]
        refine hIH2 (some (.accepted c.1.1 idxOut (some pmOut))) ssLoc rsLoc esLoc' esM' esL tblM tblL ?_
        exact step2_inject_aux_inv_accept_inl (idxOut := idxOut) (rs' := rs')
          (stLoc' := stLoc') (stM' := stM') hinv hP ht0_le hunheal hid htcur hγ hroot hcka hvS
          ⟨by simp [stLoc'], by simp [stM']⟩
          (fun τ hτ => ⟨by simp [stLoc', Function.update_of_ne hτ, (hvR_ne τ hτ).1],
            by simp [stM', Function.update_of_ne hτ, (hvR_ne τ hτ).2]⟩)
      | false =>
        simp only [pos, htriv, Bool.false_eq_true, ↓reduceIte] at hstepLoc hstepM
        cases hfull : inStage2Bucket 1 tL par c.1.1 with
        | false =>
          simp only [hfull, Bool.false_eq_true, ↓reduceIte] at hstepLoc hstepM
          rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc (some .rejected) hinv.win_false hstepLoc,
              runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM (some .rejected) hwinM hstepM]
          simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
          exact hIH2 (some .rejected) ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))
        | true =>
          simp only [hfull, ↓reduceIte] at hstepLoc hstepM
          let esLoc' : LocES Pt ℓ := { esLoc with g := { esLoc.g with win := true } }
          let esM' : MultiES Pt ℓ := { esM with g := { esM.g with win := true } }
          rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc' (some .rejected) hinv.win_false hstepLoc,
              runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblM tblM (some .rejected) hwinM hstepM]
          have hhon_eq : isHonestHdrSlotBucket esLoc.h = isHonestHdrFSMultiDFBucket esM.h :=
            funext (isHonestHdr_eq_of_cache_sync hinv.cache_sync)
          have htcur_fn : (fun Q => (esLoc.g.st Q).tcur) = (fun Q => (esM.g.st Q).tcur) :=
            funext fun Q => (hinv.vp_tcur_eq Q).1.trans (hinv.vp_tcur_eq Q).2.symm
          rw [hhon_eq, htcur_fn]
          exact exit_halted_leOne mode C Dh encPt encT idOf ℓ q qep tL par ks (r (some .rejected))
            esLoc' esM' _ tblM (by simp [esLoc'])
            (by dsimp only [esLoc', esM']; rw [hinv.abort_M, hinv.abort_loc])
            rfl
            (by dsimp only [esLoc', esM']; exact hinv.gsync.leaks_eq.symm)
            (by dsimp only [esLoc', esM']; exact hinv.gsync.corrs_eq.symm)

private theorem step2_inject_aux_finish_inr {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (hℓ : ℓ < 10 ^ 6) (hq_pos : 0 < q)
    (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt) {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range (.inl (.inl (.inr ⟨P, c⟩))) →
      OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (hguardLoc : (esLoc.abort || esLoc.g.win || (esLoc.g.inTransit P.other c).isSome ||
      !(esLoc.g.safeInj 3)) = false)
    (hguardM : (esM.abort || esM.g.win || (esM.g.inTransit P.other c).isSome ||
      !(esM.g.safeInj 3)) = false)
    (hP : P = Party.receiverOf c.1.1)
    (ht0_le : c.1.1 ≤ esLoc.g.epoch P + 1)
    (j : ℕ)
    (ht0_cap : !(qep + 1 < c.1.1) = true)
    (hbk0 : inStage2BucketGen 4 tL par c.1.1 = true)
    (ht0_not_tH : !(tL.isSome && (c.1.1 == healEpoch tL)) = true)
    (hj0 : j < (esM.h.sessions c.1.1).length)
    (s₁Loc : LocVP Pt) (s₁M : MultiVP Pt)
    (hid : s₁Loc.id = P ∧ s₁M.id = P)
    (htcur : s₁Loc.tcur = max (esLoc.g.epoch P) c.1.1 ∧ s₁M.tcur = max (esLoc.g.epoch P) c.1.1)
    (hγ : s₁Loc.γ = s₁M.γ)
    (hroot : s₁Loc.root = s₁M.root)
    (hcka : s₁Loc.curCkaMsg = (esLoc.g.st P).curCkaMsg ∧ s₁M.curCkaMsg = (esM.g.st P).curCkaMsg)
    (hvS : s₁Loc.vS = (esLoc.g.st P).vS ∧ s₁M.vS = (esM.g.st P).vS)
    (hvR_ne : ∀ τ, τ ≠ c.1.1 → s₁Loc.vR τ = (esLoc.g.st P).vR τ ∧ s₁M.vR τ = (esM.g.st P).vR τ)
    (hvLoc : simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (((_root_.CryptoGames.SM.Engine.vRecv
        (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        esLoc.g P (esLoc.g.st P) c none)).run esLoc.h) =
      pure (match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive
          (rsLoc (q * (c.1.1 - healEpoch tL) + j)) c.1 c.2 with
        | none => some none
        | some (rs', i, m) =>
          some (some ({ s₁Loc with vR := Function.update s₁Loc.vR c.1.1 (some rs') }, c.1.1, i, m)),
        esLoc.h))
    (hvM_of_fs : ∀ {resFS hM' tblM'},
      (simulateQ (pubFsImplOpt C ℓ encT idOf false)
        (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
          esM.g P c.1.1 (.inr (q * (c.1.1 - healEpoch tL) + j)) c.1 c.2 none).run esM.h)).run
        (fun _ => false, tblM) = pure ((resFS, hM'), (fun _ => false, tblM')) →
      (simulateQ (pubFsImplOpt C ℓ encT idOf false)
        (((_root_.CryptoGames.SM.Engine.vRecv
          (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
          esM.g P (esM.g.st P) c none)).run esM.h)).run (fun _ => false, tblM) =
      pure ((match resFS with
        | none => none
        | some none => some none
        | some (some (v', i, m)) =>
          some (some ({ s₁M with vR := Function.update s₁M.vR c.1.1 (some v') }, c.1.1, i, m)),
        hM'), (fun _ => false, tblM'))) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inr ⟨P, c⟩))
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  intro qr
  let sIdx := q * (c.1.1 - healEpoch tL) + j
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  have hnot_cap : ¬ (qep + 1 < c.1.1) := by simpa using ht0_cap
  have hfull_t0 : inStage2Bucket 1 tL par c.1.1 = true := hbk0
  have hstepLoc := step2_inject_aux_run_loc mode C Dh encPt encT idOf ℓ q qep tL par ks P c esLoc _ hguardLoc hvLoc
  dsimp only at hstepLoc
  cases hheal : healedBy esLoc.g.tL 3 c.1.1 with
  | true =>
    have hhealM : healedBy esM.g.tL 3 c.1.1 = true := by rw [← hinv.gsync.tL_eq]; exact hheal
    cases hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) c.1 c.2 with
    | none =>
      rw [show q * (c.1.1 - healEpoch tL) + j = sIdx from rfl, hrecv] at hstepLoc
      dsimp only at hstepLoc
      rcases step2_inject_aux_fsRecv_inr_healed_none mode C Dh hD encPt encT idOf ℓ q qep (rem + 1)
        hℓ tL par ks esM.g P sIdx c hinv hhealM hrecv with ⟨sM', sL', hfsM, hact'⟩
      have hvM := hvM_of_fs hfsM
      dsimp only at hvM
      have hstepM := step2_inject_aux_run_multi mode C Dh encPt encT idOf ℓ q qep tL par
        P c esM esM.h tblM (Function.update tblM sIdx sM') (some none) hguardM hvM
      dsimp only at hstepM
      rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc (some .rejected) hinv.win_false hstepLoc,
          runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM
            (Function.update tblM sIdx sM') (some .rejected) hwinM hstepM]
      simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
      refine hIH2 (some .rejected) ssLoc rsLoc esLoc esM esL
        (Function.update tblM sIdx sM') (Function.update tblL sIdx sL') ?_
      exact step2_inject_aux_inv_reject hq_pos hinv rfl rfl rfl rfl (fun _ _ => rfl) rfl hact' (Or.inl rfl)
    | some val =>
      rcases val with ⟨rs', idxOut, pmOut⟩
      rw [show q * (c.1.1 - healEpoch tL) + j = sIdx from rfl, hrecv] at hstepLoc
      dsimp only at hstepLoc
      have htriv : esLoc.g.trivial 3 ⟨P.other, c.1.1, idxOut⟩ = false :=
        trivial_eq_false_of_healed hinv.comp_unhealed hheal
      simp only [hnot_cap, htriv, hfull_t0, Bool.false_eq_true, ↓reduceIte] at hstepLoc
      let esLoc' : LocES Pt ℓ := { esLoc with g := { esLoc.g with win := true } }
      rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc' (some .rejected) hinv.win_false hstepLoc]
      exact step2_inject_aux_healed_win_zero mode C Dh encPt encT idOf ℓ q qep (rem + 1) tL par ks
        (esLoc' := esLoc') hinv hheal rfl rfl
        (step2_inject_aux_calcWinEp_cases (mode != some false) (isHonestHdrSlotBucket esLoc.h)
          (fun Q => (esLoc.g.st Q).tcur) P c)
        (r (some .rejected)) _
  | false =>
    have hunhealM : healedBy esM.g.tL 3 c.1.1 = false := by rw [← hinv.gsync.tL_eq]; exact hheal
    have hunh := step2_inject_aux_fsRecv_inr_unhealed mode C Dh hD encPt encT idOf ℓ q qep (rem + 1)
      hℓ tL par ks esM.g P sIdx c hinv hunhealM
    cases hrecv : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) c.1 c.2 with
    | none =>
      rw [hrecv] at hunh
      rcases hunh with ⟨hM', sM', sL', hfsM, hlf, hsess, hf, hc, hbook_ne, hcnt, hact'⟩
      rw [show q * (c.1.1 - healEpoch tL) + j = sIdx from rfl, hrecv] at hstepLoc
      dsimp only at hstepLoc
      have hvM := hvM_of_fs hfsM
      dsimp only at hvM
      have hstepM := step2_inject_aux_run_multi mode C Dh encPt encT idOf ℓ q qep tL par
        P c esM hM' tblM (Function.update tblM sIdx sM') (some none) hguardM hvM
      dsimp only at hstepM
      let esM' : MultiES Pt ℓ := { esM with h := hM' }
      have hwinM' : esM'.g.win = false := hwinM
      rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc (some .rejected) hinv.win_false hstepLoc,
          runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblM
            (Function.update tblM sIdx sM') (some .rejected) hwinM hstepM]
      simp only [hinv.win_false, hwinM', calcWinEp, Bool.false_eq_true, ↓reduceIte]
      refine hIH2 (some .rejected) ssLoc rsLoc esLoc esM' esL
        (Function.update tblM sIdx sM') (Function.update tblL sIdx sL') ?_
      exact step2_inject_aux_inv_reject hq_pos hinv hlf hsess hf hc hbook_ne hcnt hact'
        (Or.inr ⟨c.1.1, j, hheal, hbk0, hj0, rfl⟩)
    | some val =>
      rcases val with ⟨rs', idxOut, pmOut⟩
      rw [hrecv] at hunh
      rcases hunh with ⟨hM', sM', sL', hfsM, hlf, hsess, hf, hc, hbook_ne, hcnt, hact'⟩
      rw [show q * (c.1.1 - healEpoch tL) + j = sIdx from rfl, hrecv] at hstepLoc
      dsimp only at hstepLoc
      have hvM := hvM_of_fs hfsM
      dsimp only at hvM
      have hstepM := step2_inject_aux_run_multi mode C Dh encPt encT idOf ℓ q qep tL par
        P c esM hM' tblM (Function.update tblM sIdx sM')
        (some (some ({ s₁M with vR := Function.update s₁M.vR c.1.1 (some (.inr sIdx)) }, c.1.1, idxOut, pmOut)))
        hguardM hvM
      dsimp only at hstepM
      let pos : Pos := ⟨P.other, c.1.1, idxOut⟩
      simp only [hnot_cap, ↓reduceIte] at hstepLoc hstepM
      rw [← hinv.gsync.trivial_eq 3 pos] at hstepM
      cases htriv : esLoc.g.trivial 3 pos with
      | true =>
        simp only [pos, htriv, ↓reduceIte] at hstepLoc hstepM
        let stLoc' : LocVP Pt := { s₁Loc with vR := Function.update s₁Loc.vR c.1.1 (some rs') }
        let stM' : MultiVP Pt := { s₁M with vR := Function.update s₁M.vR c.1.1 (some (.inr sIdx)) }
        let esLoc' : LocES Pt ℓ := { esLoc with g := esLoc.g.accept P stLoc' pos }
        let esM' : MultiES Pt ℓ := { esM with g := esM.g.accept P stM' pos, h := hM' }
        have hwinLoc' : esLoc'.g.win = false := by
          dsimp only [esLoc']; rw [(step2_inject_aux_accept_props _ _ _ _).2.1]; exact hinv.win_false
        have hwinM' : esM'.g.win = false := by
          dsimp only [esM']; rw [(step2_inject_aux_accept_props _ _ _ _).2.1]; exact hwinM
        rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc'
              (some (.accepted c.1.1 idxOut (some pmOut))) hinv.win_false hstepLoc,
            runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblM
              (Function.update tblM sIdx sM')
              (some (.accepted c.1.1 idxOut (some pmOut))) hwinM hstepM]
        simp only [hwinLoc', hwinM', calcWinEp, Bool.false_eq_true, ↓reduceIte]
        refine hIH2 (some (.accepted c.1.1 idxOut (some pmOut))) ssLoc
          (Function.update rsLoc sIdx rs') esLoc' esM' esL
          (Function.update tblM sIdx sM') (Function.update tblL sIdx sL') ?_
        exact step2_inject_aux_inv_accept_inr hq_pos hinv hP ht0_le ht0_cap hbk0 ht0_not_tH hj0 hheal
          hlf hsess hf hc hbook_ne hcnt hact' hid htcur hγ hroot hcka hvS
          ⟨by simp [stLoc'], by simp [stM', sIdx]⟩
          (fun τ hτ => ⟨by simp [stLoc', Function.update_of_ne hτ, (hvR_ne τ hτ).1],
            by simp [stM', Function.update_of_ne hτ, (hvR_ne τ hτ).2]⟩)
      | false =>
        simp only [pos, htriv, hfull_t0, Bool.false_eq_true, ↓reduceIte] at hstepLoc hstepM
        let esLoc' : LocES Pt ℓ := { esLoc with g := { esLoc.g with win := true } }
        let esM' : MultiES Pt ℓ := { esM with g := { esM.g with win := true }, h := hM' }
        rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc' (some .rejected) hinv.win_false hstepLoc,
            runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblM
              (Function.update tblM sIdx sM') (some .rejected) hwinM hstepM]
        have hhon_eq : isHonestHdrSlotBucket esLoc.h = isHonestHdrFSMultiDFBucket esM.h :=
          funext (isHonestHdr_eq_of_cache_sync hinv.cache_sync)
        have htcur_fn : (fun Q => (esLoc.g.st Q).tcur) = (fun Q => (esM.g.st Q).tcur) :=
          funext fun Q => (hinv.vp_tcur_eq Q).1.trans (hinv.vp_tcur_eq Q).2.symm
        rw [hhon_eq, htcur_fn]
        exact exit_halted_leOne mode C Dh encPt encT idOf ℓ q qep tL par ks (r (some .rejected))
          esLoc' esM' _ (Function.update tblM sIdx sM') (by simp [esLoc'])
          (by dsimp only [esLoc', esM']; rw [hinv.abort_M, hinv.abort_loc])
          rfl
          (by dsimp only [esLoc', esM']; exact hinv.gsync.leaks_eq.symm)
          (by dsimp only [esLoc', esM']; exact hinv.gsync.corrs_eq.symm)

set_option linter.unusedVariables false in
private theorem step2_inject {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey)
    (hinj : Function.Injective encT) (hdum : ∀ T, encT T ≠ dummyKey)
    (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (hℓ : ℓ < 10 ^ 6) (hq_pos : 0 < q)
    (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt)
    {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range (.inl (.inl (.inr ⟨P, c⟩))) →
      OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inr ⟨P, c⟩))
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  intro qr
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  obtain ⟨hitr_eq, hsafe_eq⟩ := step2_inject_aux_gsync_inj hinv.gsync P c
  have hguard_eq :
      (esLoc.abort || esLoc.g.win || (esLoc.g.inTransit P.other c).isSome || !(esLoc.g.safeInj 3)) =
      (esM.abort || esM.g.win || (esM.g.inTransit P.other c).isSome || !(esM.g.safeInj 3)) := by
    rw [hinv.abort_loc, hinv.abort_M, hinv.win_false, hwinM, hitr_eq, hsafe_eq]
  cases hguardLoc : (esLoc.abort || esLoc.g.win || (esLoc.g.inTransit P.other c).isSome || !(esLoc.g.safeInj 3)) with
  | true =>
    have hguardM : (esM.abort || esM.g.win || (esM.g.inTransit P.other c).isSome || !(esM.g.safeInj 3)) = true :=
      hguard_eq.symm.trans hguardLoc
    have hstepLoc :
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
        pure (none, esLoc) := by
      simp only [qr, implEDFPaperBucketRaw, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
        _root_.CryptoGames.SM.Engine.injectE, StateT.run_bind, StateT.run_get,
        pure_bind, hguardLoc, ↓reduceIte, StateT.run_pure, simulateQ_pure]
    have hstepM :
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tblM) =
        pure ((none, esM), (fun _ => false, tblM)) := by
      simp only [qr, implEDFPaperBucketRaw, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
        _root_.CryptoGames.SM.Engine.injectE, StateT.run_bind, StateT.run_get,
        pure_bind, hguardM, ↓reduceIte, StateT.run_pure, simulateQ_pure]
    rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc none hinv.win_false hstepLoc,
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM none hwinM hstepM]
    simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
    exact hIH2 none ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))
  | false =>
    have hguardM : (esM.abort || esM.g.win || (esM.g.inTransit P.other c).isSome || !(esM.g.safeInj 3)) = false :=
      hguard_eq.symm.trans hguardLoc
    have hidLoc : (esLoc.g.st P).id = P := (hinv.vp_id P).1
    have hidM : (esM.g.st P).id = P := (hinv.vp_id P).2
    have htcurLoc : (esLoc.g.st P).tcur = esLoc.g.epoch P := (hinv.vp_tcur_eq P).1
    have htcurM : (esM.g.st P).tcur = esLoc.g.epoch P := (hinv.vp_tcur_eq P).2
    cases hvguard : (P.sendsIn c.1.1 || decide (esLoc.g.epoch P + 1 < c.1.1)) with
    | true =>
      have hvLoc :
          simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
            (((_root_.CryptoGames.SM.Engine.vRecv
              (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
              esLoc.g P (esLoc.g.st P) c none)).run esLoc.h) = pure (some none, esLoc.h) := by
        simp [_root_.CryptoGames.SM.Engine.vRecv, hidLoc, htcurLoc, hvguard,
          StateT.run_pure, simulateQ_pure]
      have hvM :
          (simulateQ (pubFsImplOpt C ℓ encT idOf false)
            (((_root_.CryptoGames.SM.Engine.vRecv
              (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
              esM.g P (esM.g.st P) c none)).run esM.h)).run (fun _ => false, tblM) =
          pure ((some none, esM.h), (fun _ => false, tblM)) := by
        simp [_root_.CryptoGames.SM.Engine.vRecv, hidM, htcurM, hvguard,
          StateT.run_pure, simulateQ_pure]
      have hstepLoc := step2_inject_aux_run_loc mode C Dh encPt encT idOf ℓ q qep tL par ks P c esLoc (some none) hguardLoc hvLoc
      have hstepM := step2_inject_aux_run_multi mode C Dh encPt encT idOf ℓ q qep tL par P c esM esM.h tblM tblM (some none) hguardM hvM
      dsimp only at hstepLoc hstepM
      rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc (some .rejected) hinv.win_false hstepLoc,
          runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM (some .rejected) hwinM hstepM]
      simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
      exact hIH2 (some .rejected) ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))
    | false =>
      have hsends : P.sendsIn c.1.1 = false := by
        cases h : P.sendsIn c.1.1
        · rfl
        · rw [h] at hvguard; cases hvguard
      have ht0_le : c.1.1 ≤ esLoc.g.epoch P + 1 := by
        by_cases hlt : esLoc.g.epoch P + 1 < c.1.1
        · simp [hsends, hlt] at hvguard
        · omega
      have hP : P = Party.receiverOf c.1.1 := (not_sendsIn_iff_receiverOf P c.1.1).mp hsends
      by_cases ht_next : c.1.1 = esLoc.g.epoch P + 1
      · cases hhdr2 : c.1.2 with
        | none =>
          have hvLoc :
              simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
                (((_root_.CryptoGames.SM.Engine.vRecv
                  (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                  esLoc.g P (esLoc.g.st P) c none)).run esLoc.h) = pure (some none, esLoc.h) := by
            simp only [_root_.CryptoGames.SM.Engine.vRecv, hidLoc, htcurLoc, hvguard,
              Bool.false_eq_true, ↓reduceIte]
            simp only [eq_true ht_next, ↓reduceIte, hhdr2]
            simp [StateT.run_pure, simulateQ_pure]
          have hvM :
              (simulateQ (pubFsImplOpt C ℓ encT idOf false)
                (((_root_.CryptoGames.SM.Engine.vRecv
                  (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
                  esM.g P (esM.g.st P) c none)).run esM.h)).run (fun _ => false, tblM) =
              pure ((some none, esM.h), (fun _ => false, tblM)) := by
            simp only [_root_.CryptoGames.SM.Engine.vRecv, hidM, htcurM, hvguard,
              Bool.false_eq_true, ↓reduceIte]
            simp only [eq_true ht_next, ↓reduceIte, hhdr2]
            simp [StateT.run_pure, simulateQ_pure]
          have hstepLoc := step2_inject_aux_run_loc mode C Dh encPt encT idOf ℓ q qep tL par ks P c esLoc (some none) hguardLoc hvLoc
          have hstepM := step2_inject_aux_run_multi mode C Dh encPt encT idOf ℓ q qep tL par P c esM esM.h tblM tblM (some none) hguardM hvM
          dsimp only at hstepLoc hstepM
          rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc (some .rejected) hinv.win_false hstepLoc,
              runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM (some .rejected) hwinM hstepM]
          simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
          exact hIH2 (some .rejected) ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))
        | some Tn =>
          rcases step2_inject_aux_startRecv mode C Dh encPt encT idOf ℓ q qep rem tL par ks
            P c.1.1 Tn hinv hP ht_next with
            ⟨hsrLoc, hsrM⟩ | ⟨hsrLoc, hsrM⟩ |
            ⟨γ', σ', rs0, hsrLoc, hsrM⟩ |
            ⟨γ', σ', j, ht0_cap, hbk0, ht0_not_tH, hj0, _, hsrLoc, hsrM⟩
          · have hvLoc :
                simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
                  (((_root_.CryptoGames.SM.Engine.vRecv
                    (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                    esLoc.g P (esLoc.g.st P) c none)).run esLoc.h) = pure (none, esLoc.h) := by
              simp only [_root_.CryptoGames.SM.Engine.vRecv, hidLoc, htcurLoc, hvguard,
                Bool.false_eq_true, ↓reduceIte]
              simp only [eq_true ht_next, ↓reduceIte, hhdr2, StateT.run_bind, simulateQ_bind]
              rw [hsrLoc]
              simp [StateT.run_pure, simulateQ_pure]
            have hvM :
                (simulateQ (pubFsImplOpt C ℓ encT idOf false)
                  (((_root_.CryptoGames.SM.Engine.vRecv
                    (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
                    esM.g P (esM.g.st P) c none)).run esM.h)).run (fun _ => false, tblM) =
                pure ((none, esM.h), (fun _ => false, tblM)) := by
              simp only [_root_.CryptoGames.SM.Engine.vRecv, hidM, htcurM, hvguard,
                Bool.false_eq_true, ↓reduceIte]
              simp only [eq_true ht_next, ↓reduceIte, hhdr2, StateT.run_bind, simulateQ_bind]
              rw [hsrM]
              simp [StateT.run_pure, simulateQ_pure]
            have hstepLoc := step2_inject_aux_run_loc mode C Dh encPt encT idOf ℓ q qep tL par ks P c esLoc none hguardLoc hvLoc
            have hstepM := step2_inject_aux_run_multi mode C Dh encPt encT idOf ℓ q qep tL par P c esM esM.h tblM tblM none hguardM hvM
            dsimp only at hstepLoc hstepM
            let esLoc' : LocES Pt ℓ := { esLoc with abort := true }
            let esM' : MultiES Pt ℓ := { esM with abort := true }
            rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc' none hinv.win_false hstepLoc,
                runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblM tblM none hwinM hstepM]
            have hwinLoc' : esLoc'.g.win = false := hinv.win_false
            have hwinM' : esM'.g.win = false := hwinM
            simp only [hwinLoc', hwinM', calcWinEp, Bool.false_eq_true, ↓reduceIte]
            exact exit_halted_leOne mode C Dh encPt encT idOf ℓ q qep tL par ks (r none)
              esLoc' esM' none tblM (by simp [esLoc']) rfl
              (by dsimp only [esLoc', esM']; exact hinv.gsync.win_eq.symm)
              (by dsimp only [esLoc', esM']; exact hinv.gsync.leaks_eq.symm)
              (by dsimp only [esLoc', esM']; exact hinv.gsync.corrs_eq.symm)
          · have hvLoc :
                simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
                  (((_root_.CryptoGames.SM.Engine.vRecv
                    (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                    esLoc.g P (esLoc.g.st P) c none)).run esLoc.h) = pure (some none, esLoc.h) := by
              simp only [_root_.CryptoGames.SM.Engine.vRecv, hidLoc, htcurLoc, hvguard,
                Bool.false_eq_true, ↓reduceIte]
              simp only [eq_true ht_next, ↓reduceIte, hhdr2, StateT.run_bind, simulateQ_bind]
              rw [hsrLoc]
              simp [StateT.run_pure, simulateQ_pure]
            have hvM :
                (simulateQ (pubFsImplOpt C ℓ encT idOf false)
                  (((_root_.CryptoGames.SM.Engine.vRecv
                    (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
                    esM.g P (esM.g.st P) c none)).run esM.h)).run (fun _ => false, tblM) =
                pure ((some none, esM.h), (fun _ => false, tblM)) := by
              simp only [_root_.CryptoGames.SM.Engine.vRecv, hidM, htcurM, hvguard,
                Bool.false_eq_true, ↓reduceIte]
              simp only [eq_true ht_next, ↓reduceIte, hhdr2, StateT.run_bind, simulateQ_bind]
              rw [hsrM]
              simp [StateT.run_pure, simulateQ_pure]
            have hstepLoc := step2_inject_aux_run_loc mode C Dh encPt encT idOf ℓ q qep tL par ks P c esLoc (some none) hguardLoc hvLoc
            have hstepM := step2_inject_aux_run_multi mode C Dh encPt encT idOf ℓ q qep tL par P c esM esM.h tblM tblM (some none) hguardM hvM
            dsimp only at hstepLoc hstepM
            rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc (some .rejected) hinv.win_false hstepLoc,
                runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM (some .rejected) hwinM hstepM]
