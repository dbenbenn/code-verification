private theorem step2_deliver_aux_inv_phase2_reject_inr {Pt : Type} [DecidableEq Pt]
    (C : Crypto) (ℓ : ℕ) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (q qep rem : ℕ) (hq_pos : 0 < q) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt)
    (r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt))
    (j : ℕ) (htH_le : healEpoch tL ≤ c.1.1) (hj_q : j < q)
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (hinT : esLoc.g.inTransit P.other c = some r0)
    (hM' : MultiHS Pt) (sM' sL' : SessHSt Pt ℓ)
    (hcache : hM'.cache = esM.h.cache)
    (hft : hM'.fTable = esM.h.fTable)
    (hsess : hM'.sessions = esM.h.sessions)
    (hlf : hM'.lfWin = esM.h.lfWin)
    (hoth : ∀ i, i ≠ q * (c.1.1 - healEpoch tL) + j → hM'.book i = esM.h.book i)
    (hcnt : ((hM'.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).fsCount =
      ((esM.h.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).fsCount)
    (hheal_tr : healedBy esM.g.tL 3 c.1.1 = true →
      ((hM'.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).fsTrans =
        ((esM.h.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).fsTrans)
    (hinv_s' : ActiveSessInv C ℓ encT idOf
      (!((hM'.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).sCorr)
      (ks (q * (c.1.1 - healEpoch tL) + j))
      (ssLoc (q * (c.1.1 - healEpoch tL) + j))
      (rsLoc (q * (c.1.1 - healEpoch tL) + j))
      ((hM'.book (q * (c.1.1 - healEpoch tL) + j)).getD {}) sM' sL') :
    let sIdx := q * (c.1.1 - healEpoch tL) + j
    BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc rsLoc esLoc
      { esM with h := hM' } esL (Function.update tblM sIdx sM') (Function.update tblL sIdx sL') := by
  intro sIdx
  obtain ⟨_, hr0_mem, _, _, hr0_ep, _, _, _⟩ := step2_deliver_aux_inTransit_some_props hinv.gsync hinv.trans_meta hinT
  obtain ⟨_, hr0_send_of, hr0_le_ep, _, _⟩ := hinv.trans_meta r0 hr0_mem
  have ht0_le_sender : c.1.1 ≤ esLoc.g.epoch (Party.senderOf c.1.1) := by
    rw [← hr0_ep] at *; rw [← hr0_send_of]; exact hr0_le_ep
  exact
    { gsync := hinv.gsync
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := hinv.win_false
      lfWin_M := by dsimp only; rw [hlf]; exact hinv.lfWin_M
      comp_unhealed := hinv.comp_unhealed
      tL_mem_leaks := hinv.tL_mem_leaks
      phase1_props := fun hp => Bool.noConfusion hp
      phase2_props := hinv.phase2_props
      sess_eq := by dsimp only; rw [hsess]; exact hinv.sess_eq
      sess_nodup := fun τ => by dsimp only; rw [hsess]; exact hinv.sess_nodup τ
      sess_zero_le := by dsimp only; rw [hsess]; exact hinv.sess_zero_le
      sess_pos_bound := fun τ hτ => by
        dsimp only; rw [hsess]
        exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
      sess_epoch_ok := fun τ hne => by dsimp only at hne; rw [hsess] at hne; exact hinv.sess_epoch_ok τ hne
      fTable_M_iff := fun τ ik => by dsimp only; rw [hft, hsess]; exact hinv.fTable_M_iff τ ik
      fTable_loc_eq := fun τ ik => by dsimp only; rw [hsess]; exact hinv.fTable_loc_eq τ ik
      cache_sync := fun τ => by dsimp only; rw [hcache, hsess]; exact hinv.cache_sync τ
      vp_id := hinv.vp_id
      vp_tcur_eq := hinv.vp_tcur_eq
      vp_γ_eq := hinv.vp_γ_eq
      vp_root_eq := hinv.vp_root_eq
      vp_cka_eq := hinv.vp_cka_eq
      vp_cka_cache := fun Q hsQ => by dsimp only; rw [hcache]; exact hinv.vp_cka_cache Q hsQ
      epoch_bound := fun Q => le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
      vS_sync := fun Q => by dsimp only; rw [hsess]; exact hinv.vS_sync Q
      vR_dom := hinv.vR_dom
      vR_sync := fun Q τ => by dsimp only; rw [hsess]; exact hinv.vR_sync Q τ
      sess_inv := fun i => by
        dsimp only
        by_cases hi : i = sIdx
        · subst hi
          simp only [Function.update_self]
          exact hinv_s'
        · simp only [Function.update_of_ne hi, hoth i hi]
          exact hinv.sess_inv i
      ss_fresh := hinv.ss_fresh
      rs_fresh := hinv.rs_fresh
      book_fresh_before_send := fun τ j' h1 h2 h3 hlt hh => by
        dsimp only
        have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
          intro heq
          obtain ⟨hτ_eq, _⟩ := bucketSlot_inj h2 htH_le h3 hj_q heq
          subst hτ_eq; omega
        rw [hoth _ hne_s]
        exact hinv.book_fresh_before_send τ j' h1 h2 h3 hlt hh
      trans_meta := fun r' hr' => by dsimp only; rw [hcache]; exact hinv.trans_meta r' hr'
      cache_empty_gt := fun τ hlt => by dsimp only; rw [hcache]; exact hinv.cache_empty_gt τ hlt
      healed_sender_pin := fun Q τ j' hsQ hτ hvS hh => by
        dsimp only at hvS hh ⊢
        rw [hcache]
        have hpin0 := hinv.healed_sender_pin Q τ j' hsQ hτ hvS hh
        refine ⟨?_, hpin0.2⟩
        by_cases hs : q * (τ - healEpoch tL) + j' = sIdx
        · dsimp only [sIdx] at hs
          rw [hs] at hpin0 ⊢
          rw [hcnt]; exact hpin0.1
        · rw [hoth _ hs]; exact hpin0.1
      healed_vR_pin := fun Q τ sIdx' hvR hh => by
        dsimp only at hvR hh ⊢; rw [hcache]; exact hinv.healed_vR_pin Q τ sIdx' hvR hh
      healed_book_trans := fun τ sIdx' hh hro hp => by
        dsimp only at hh hro hp ⊢
        rw [hcache] at hp
        by_cases hs : sIdx' = sIdx
        · subst hs
          have hτ_eq : τ = c.1.1 := by
            rcases hp with ⟨h0, hs0, _, htL_n⟩ | ⟨h1, Tc', σc', kMulti', hc⟩
            · subst h0
              have htH0 : healEpoch tL = 0 := by subst htL_n; rfl
              dsimp only [sIdx] at hs0
              rw [htH0] at hs0
              cases hc0 : c.1.1 with
              | zero => rfl
              | succ n => rw [hc0, Nat.sub_zero, Nat.mul_succ] at hs0; omega
            · rcases hinv.cache_sync τ with ⟨_, hcn⟩ | ⟨_, _, _, _, _, hcn⟩ |
                  ⟨_, _, _, j', _, hj'_len, _, hbk', _, _, hcs⟩
              · rw [hcn] at hc; cases hc
              · rw [hcn] at hc; cases hc
              · rw [hcs] at hc
                simp only [Option.some.injEq, Prod.mk.injEq] at hc
                have hj'_q : j' < q := by have := hinv.sess_pos_bound τ h1; omega
                exact (bucketSlot_inj (healEpoch_le_of_gen4 hbk') htH_le hj'_q hj_q hc.2.2.2).1
          subst hτ_eq
          have hhM : healedBy esM.g.tL 3 c.1.1 = true := by rwa [← hinv.gsync.tL_eq]
          rw [hheal_tr hhM]
          exact hinv.healed_book_trans c.1.1 sIdx hh hro hp
        · rw [hoth _ hs]
          exact hinv.healed_book_trans τ sIdx' hh hro hp }

private theorem step2_deliver_aux_inv_phase2_accept_inl {Pt : Type} [DecidableEq Pt]
    (C : Crypto) (ℓ : ℕ) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt)
    (r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt))
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (hinT : esLoc.g.inTransit P.other c = some r0)
    (ht0_le_ep1 : c.1.1 ≤ esLoc.g.epoch P + 1)
    (γ_new : CryptoGames.CKA.DDH.State (BitVec 256) Pt)
    (σ_new : BitVec 256)
    (rs' : RatchetReceiverState (BitVec 256) (BitVec 256)) :
    let t0 := c.1.1
    let ep' := max (esLoc.g.epoch P) t0
    let stLoc' : LocVP Pt :=
      { esLoc.g.st P with
        tcur := ep', γ := γ_new, root := σ_new,
        vR := Function.update (esLoc.g.st P).vR t0 (some rs') }
    let stM' : MultiVP Pt :=
      { esM.g.st P with
        tcur := ep', γ := γ_new, root := σ_new,
        vR := Function.update (esM.g.st P).vR t0 (some (.inl rs')) }
    BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc rsLoc
      { esLoc with g := esLoc.g.accept P stLoc' r0.pos }
      { esM with g := esM.g.accept P stM' r0.pos } esL tblM tblL := by
  intro t0 ep' stLoc' stM'
  obtain ⟨_, hr0_mem, _, _, hr0_ep, hP_recv, hP_ns, _⟩ :=
    step2_deliver_aux_inTransit_some_props hinv.gsync hinv.trans_meta hinT
  obtain ⟨hepP_raw, hepQ, htL_acc, hleaks_acc⟩ := accept_epoch_eq esLoc.g P stLoc' r0.pos
  have hepP : (esLoc.g.accept P stLoc' r0.pos).epoch P = ep' := by
    rw [hepP_raw, hr0_ep]
  have hep_mono : ∀ Q, esLoc.g.epoch Q ≤ (esLoc.g.accept P stLoc' r0.pos).epoch Q := by
    intro Q
    by_cases hQ : Q = P
    · subst hQ; rw [hepP]; exact le_max_left _ _
    · rw [hepQ Q hQ]
  obtain ⟨hwin_acc, _, _, _, hidx_acc, htr_sub, hpl_acc, hcu_acc, _⟩ :=
    step2_deliver_aux_accept_preserve_props esLoc.g P stLoc' r0.pos tL
  have hsend_eq_P : ∀ Q, Q = P →
      Q.sendsIn ((esLoc.g.accept P stLoc' r0.pos).epoch Q) = true →
      (esLoc.g.accept P stLoc' r0.pos).epoch Q = esLoc.g.epoch P := by
    intro Q hQ hsQ
    subst hQ
    rw [hepP] at hsQ ⊢
    have hle : t0 ≤ esLoc.g.epoch Q := by
      by_contra hgt
      have heq : ep' = t0 := Nat.max_eq_right (by omega)
      rw [heq] at hsQ
      rw [hP_ns] at hsQ; cases hsQ
    exact Nat.max_eq_left hle
  exact
    { gsync := hinv.gsync.accept_sync P stLoc' stM' r0.pos
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := by dsimp only; rw [hwin_acc]; exact hinv.win_false
      lfWin_M := hinv.lfWin_M
      comp_unhealed := hcu_acc hinv.comp_unhealed
      tL_mem_leaks := fun cur hcur => by
        dsimp only at hcur ⊢
        rw [htL_acc] at hcur; rw [hleaks_acc]
        exact hinv.tL_mem_leaks cur hcur
      phase1_props := fun hp => Bool.noConfusion hp
      phase2_props := fun _ => by dsimp only; rw [← hpl_acc]; exact hinv.phase2_props rfl
      sess_eq := hinv.sess_eq
      sess_nodup := hinv.sess_nodup
      sess_zero_le := hinv.sess_zero_le
      sess_pos_bound := fun τ hτ =>
        le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
      sess_epoch_ok := hinv.sess_epoch_ok
      fTable_M_iff := hinv.fTable_M_iff
      fTable_loc_eq := hinv.fTable_loc_eq
      cache_sync := hinv.cache_sync
      vp_id := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM', (hinv.vp_id Q).1, (hinv.vp_id Q).2]
        · simp [Function.update_of_ne hQ, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
      vp_tcur_eq := fun Q => by
        dsimp only
        rcases eq_or_ne Q P with rfl | hQ
        · rw [hepP]
          simp [GameState.accept, GameState.delete, stLoc', stM']
        · rw [hepQ Q hQ]
          simp [GameState.accept, GameState.delete, Function.update_of_ne hQ,
            (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
      vp_γ_eq := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM']
        · simp [Function.update_of_ne hQ, hinv.vp_γ_eq Q]
      vp_root_eq := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM']
        · simp [Function.update_of_ne hQ, hinv.vp_root_eq Q]
      vp_cka_eq := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM', hinv.vp_cka_eq Q]
        · simp [Function.update_of_ne hQ, hinv.vp_cka_eq Q]
      vp_cka_cache := fun Q hsQ => by
        dsimp only at hsQ ⊢
        by_cases hQ : Q = P
        · have hep_eq := hsend_eq_P Q hQ hsQ
          subst hQ
          rw [hep_eq] at hsQ ⊢
          simpa [GameState.accept, GameState.delete, stLoc', stM'] using hinv.vp_cka_cache Q hsQ
        · rw [hepQ Q hQ] at hsQ ⊢
          simpa [GameState.accept, GameState.delete, Function.update_of_ne hQ] using
            hinv.vp_cka_cache Q hsQ
      epoch_bound := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst hQ; rw [hepP]
          have h1 := hinv.epoch_bound Q
          dsimp only [ep', t0] at ht0_le_ep1 ⊢
          omega
        · rw [hepQ Q hQ]
          exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
      vS_sync := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst hQ
          have hv0 := hinv.vS_sync Q
          have hst1 : (esLoc.g.accept Q stLoc' r0.pos).st Q = stLoc' := by
            simp [GameState.accept, GameState.delete]
          have hst2 : (esM.g.accept Q stM' r0.pos).st Q = stM' := by
            simp [GameState.accept, GameState.delete]
          rw [hst1, hst2]
          dsimp only [stLoc', stM']
          rcases hv0 with h0 | h1 | ⟨τ, j, hle, hsend_eq, hQ_send, hc, hb, ht, hj, hv1, hv2⟩
          · exact Or.inl h0
          · exact Or.inr (Or.inl h1)
          · refine Or.inr (Or.inr ⟨τ, j, le_trans hle (hep_mono Q), ?_, hQ_send, hc, hb, ht, hj, hv1, hv2⟩)
            intro hsQ
            have hep_eq := hsend_eq_P Q rfl hsQ
            rw [hep_eq] at hsQ ⊢
            exact hsend_eq hsQ
        · rw [hepQ Q hQ]
          have hst1 : (esLoc.g.accept P stLoc' r0.pos).st Q = esLoc.g.st Q := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          have hst2 : (esM.g.accept P stM' r0.pos).st Q = esM.g.st Q := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          rw [hst1, hst2]
          exact hinv.vS_sync Q
      vR_dom := fun Q τ hdom => by
        dsimp only at hdom ⊢
        by_cases hQ : Q = P
        · subst hQ
          rw [hepP]
          simp only [GameState.accept, GameState.delete, Function.update_self, stM'] at hdom
          by_cases hτ : τ = t0
          · subst hτ
            exact ⟨le_max_right _ _, hP_recv⟩
          · simp only [Function.update_of_ne hτ] at hdom
            obtain ⟨hle, hrecv⟩ := hinv.vR_dom Q τ hdom
            exact ⟨le_trans hle (le_max_left _ _), hrecv⟩
        · rw [hepQ Q hQ]
          simp only [GameState.accept, GameState.delete, Function.update_of_ne hQ] at hdom
          exact hinv.vR_dom Q τ hdom
      vR_sync := fun Q τ => by
        by_cases hQ : Q = P
        · subst hQ
          have hst1 : (esLoc.g.accept Q stLoc' r0.pos).st Q = stLoc' := by
            simp [GameState.accept, GameState.delete]
          have hst2 : (esM.g.accept Q stM' r0.pos).st Q = stM' := by
            simp [GameState.accept, GameState.delete]
          dsimp only; rw [hst1, hst2]; dsimp only [stLoc', stM']
          by_cases hτ : τ = t0
          · subst hτ
            exact Or.inr (Or.inl ⟨rs', by simp, by simp⟩)
          · rw [Function.update_of_ne hτ, Function.update_of_ne hτ]
            exact hinv.vR_sync Q τ
        · have hst1 : (esLoc.g.accept P stLoc' r0.pos).st Q = esLoc.g.st Q := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          have hst2 : (esM.g.accept P stM' r0.pos).st Q = esM.g.st Q := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          dsimp only; rw [hst1, hst2]
          exact hinv.vR_sync Q τ
      sess_inv := hinv.sess_inv
      ss_fresh := fun τ j h1 h2 h3 hlt =>
        hinv.ss_fresh τ j h1 h2 h3 (lt_of_le_of_lt (hep_mono _) hlt)
      rs_fresh := fun τ j h1 h2 h3 hlt =>
        hinv.rs_fresh τ j h1 h2 h3 (lt_of_le_of_lt (hep_mono _) hlt)
      book_fresh_before_send := fun τ j h1 h2 h3 hlt hh => by
        dsimp only at hlt hh ⊢
        rw [htL_acc] at hh
        exact hinv.book_fresh_before_send τ j h1 h2 h3 (lt_of_le_of_lt (hep_mono _) hlt) hh
      trans_meta := fun r' hr' => by
        dsimp only at hr' ⊢
        obtain ⟨h1, h2, h3, h4, h5⟩ := hinv.trans_meta r' (htr_sub r' hr')
        exact ⟨h1, h2, le_trans h3 (hep_mono _), h4, h5⟩
      cache_empty_gt := fun τ hlt =>
        hinv.cache_empty_gt τ (lt_of_le_of_lt (hep_mono _) hlt)
      healed_sender_pin := fun Q τ j hsQ hτ hvS hh => by
        dsimp only at hsQ hτ hvS hh ⊢
        rw [htL_acc] at hh
        rw [hidx_acc]
        by_cases hQ : Q = P
        · have hep_eq := hsend_eq_P Q hQ hsQ
          subst hQ
          rw [hep_eq] at hsQ hτ
          simp only [GameState.accept, GameState.delete, Function.update_self, stM'] at hvS ⊢
          exact hinv.healed_sender_pin Q τ j hsQ hτ hvS hh
        · rw [hepQ Q hQ] at hsQ hτ
          simp only [GameState.accept, GameState.delete, Function.update_of_ne hQ] at hvS ⊢
          exact hinv.healed_sender_pin Q τ j hsQ hτ hvS hh
      healed_vR_pin := fun Q τ sIdx' hvR hh => by
        dsimp only at hvR hh ⊢
        rw [htL_acc] at hh
        by_cases hQ : Q = P
        · subst hQ
          simp only [GameState.accept, GameState.delete, Function.update_self, stM'] at hvR
          by_cases hτ : τ = t0
          · subst hτ; simp at hvR
          · simp only [Function.update_of_ne hτ] at hvR
            exact hinv.healed_vR_pin Q τ sIdx' hvR hh
        · simp only [GameState.accept, GameState.delete, Function.update_of_ne hQ] at hvR
          exact hinv.healed_vR_pin Q τ sIdx' hvR hh
      healed_book_trans := fun τ sIdx' hh hro hp => by
        dsimp only at hh hro hp ⊢
        rw [htL_acc] at hh
        by_cases hτ : τ = t0
        · exfalso
          subst hτ
          rw [← hP_recv] at hro
          rcases hro with hlt | hvR
          · rw [hepP] at hlt
            have : t0 ≤ ep' := le_max_right _ _
            omega
          · simp [GameState.accept, GameState.delete, stM'] at hvR
        · have hne_pos : τ ≠ r0.pos.epoch := by rw [hr0_ep]; exact hτ
          have hfilt : (esLoc.g.accept P stLoc' r0.pos).trans.filter (fun r => r.pos.epoch == τ) =
              esLoc.g.trans.filter (fun r => r.pos.epoch == τ) := by
            simp only [GameState.accept, GameState.delete]
            exact step2_deliver_aux_filter_delete_pos_ne esLoc.g.trans r0.pos τ hne_pos
          rw [hfilt]
          have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
              (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
            rcases hro with hlt | hvR
            · exact Or.inl (lt_of_le_of_lt (hep_mono _) hlt)
            · right
              by_cases hQ : Party.receiverOf τ = P
              · rw [hQ] at hvR ⊢
                simpa [GameState.accept, GameState.delete, stM', Function.update_of_ne hτ] using hvR
              · simpa [GameState.accept, GameState.delete, Function.update_of_ne hQ] using hvR
          exact hinv.healed_book_trans τ sIdx' hh hro_orig hp }

private theorem step2_deliver_aux_inv_phase2_accept_inr {Pt : Type} [DecidableEq Pt]
    (C : Crypto) (ℓ : ℕ) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (q qep rem : ℕ) (hq_pos : 0 < q) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt)
    (r0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt))
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (hinT : esLoc.g.inTransit P.other c = some r0)
    (ht0_le_ep1 : c.1.1 ≤ esLoc.g.epoch P + 1)
    (j : ℕ)
    (hcap : !(qep + 1 < c.1.1) = true)
    (hbk_gen : inStage2BucketGen 4 tL par c.1.1 = true)
    (htH_ne : !(tL.isSome && (c.1.1 == healEpoch tL)) = true)
    (hj_len : j < (esM.h.sessions c.1.1).length)
    (hpin_t0 : healedBy esLoc.g.tL 3 c.1.1 = true →
      (c.1.1 = 0 ∧ q * (c.1.1 - healEpoch tL) + j = 0 ∧ inStage2BucketGen 4 tL par 0 = true ∧ tL = none) ∨
      (1 ≤ c.1.1 ∧ ∃ Tc σc kMulti,
        esM.h.cache c.1.1 = some (Tc, σc, kMulti, some (q * (c.1.1 - healEpoch tL) + j))))
    (hro_pre : esLoc.g.epoch (Party.receiverOf c.1.1) < c.1.1 ∨
      (esM.g.st (Party.receiverOf c.1.1)).vR c.1.1 = some (.inr (q * (c.1.1 - healEpoch tL) + j)))
    (γ_new : CryptoGames.CKA.DDH.State (BitVec 256) Pt)
    (σ_new : BitVec 256)
    (rsLoc_new : RatchetReceiverState (BitVec 256) (BitVec 256))
    (hM' : MultiHS Pt) (sM' sL' : SessHSt Pt ℓ)
    (hcache : hM'.cache = esM.h.cache)
    (hft : hM'.fTable = esM.h.fTable)
    (hsess : hM'.sessions = esM.h.sessions)
    (hlf : hM'.lfWin = esM.h.lfWin)
    (hoth : ∀ i, i ≠ q * (c.1.1 - healEpoch tL) + j → hM'.book i = esM.h.book i)
    (hcnt : ((hM'.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).fsCount =
      ((esM.h.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).fsCount)
    (hheal_tr : healedBy esM.g.tL 3 c.1.1 = true →
      ((hM'.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).fsTrans =
        (((esM.h.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).fsTrans).filter (·.1 != r0.pos.idx))
    (hinv_s' : ActiveSessInv C ℓ encT idOf
      (!((hM'.book (q * (c.1.1 - healEpoch tL) + j)).getD {}).sCorr)
      (ks (q * (c.1.1 - healEpoch tL) + j))
      (ssLoc (q * (c.1.1 - healEpoch tL) + j)) rsLoc_new
      ((hM'.book (q * (c.1.1 - healEpoch tL) + j)).getD {}) sM' sL') :
    let t0 := c.1.1
    let sIdx := q * (t0 - healEpoch tL) + j
    let ep' := max (esLoc.g.epoch P) t0
    let stLoc' : LocVP Pt :=
      { esLoc.g.st P with
        tcur := ep', γ := γ_new, root := σ_new,
        vR := Function.update (esLoc.g.st P).vR t0 (some rsLoc_new) }
    let stM' : MultiVP Pt :=
      { esM.g.st P with
        tcur := ep', γ := γ_new, root := σ_new,
        vR := Function.update (esM.g.st P).vR t0 (some (.inr sIdx)) }
    BucketSimInv C ℓ encT idOf q qep tL par ks false rem
      ssLoc (Function.update rsLoc sIdx rsLoc_new)
      { esLoc with g := esLoc.g.accept P stLoc' r0.pos }
      { esM with g := esM.g.accept P stM' r0.pos, h := hM' } esL
      (Function.update tblM sIdx sM') (Function.update tblL sIdx sL') := by
  intro t0 sIdx ep' stLoc' stM'
  have htH_le : healEpoch tL ≤ t0 := healEpoch_le_of_gen4 hbk_gen
  have hj_q : j < q := by
    by_cases ht00 : c.1.1 = 0
    · rw [ht00] at hj_len; exact lt_of_lt_of_le hj_len hinv.sess_zero_le
    · have := hinv.sess_pos_bound c.1.1 (by omega); omega
  obtain ⟨_, hr0_mem, _, _, hr0_ep, hP_recv, hP_ns, _⟩ :=
    step2_deliver_aux_inTransit_some_props hinv.gsync hinv.trans_meta hinT
  obtain ⟨_, hr0_send_of, hr0_le_ep, _, _⟩ := hinv.trans_meta r0 hr0_mem
  have ht0_le_sender : t0 ≤ esLoc.g.epoch (Party.senderOf t0) := by
    dsimp only [t0] at *; rw [← hr0_ep] at *; rw [← hr0_send_of]; exact hr0_le_ep
  obtain ⟨hepP_raw, hepQ, htL_acc, hleaks_acc⟩ := accept_epoch_eq esLoc.g P stLoc' r0.pos
  have hepP : (esLoc.g.accept P stLoc' r0.pos).epoch P = ep' := by
    rw [hepP_raw, hr0_ep]
  have hep_mono : ∀ Q, esLoc.g.epoch Q ≤ (esLoc.g.accept P stLoc' r0.pos).epoch Q := by
    intro Q
    by_cases hQ : Q = P
    · subst hQ; rw [hepP]; exact le_max_left _ _
    · rw [hepQ Q hQ]
  obtain ⟨hwin_acc, _, _, _, hidx_acc, htr_sub, hpl_acc, hcu_acc, hfilt_props⟩ :=
    step2_deliver_aux_accept_preserve_props esLoc.g P stLoc' r0.pos tL
  have hsend_same : ∀ r ∈ esLoc.g.trans, r.pos.epoch = r0.pos.epoch → r.pos.sender = r0.pos.sender := by
    intro r hr hep_eq
    rw [(hinv.trans_meta r hr).2.1, hr0_send_of, hep_eq]
  obtain ⟨hfilt_del, hfilt_ne⟩ := hfilt_props hsend_same
  have hsend_eq_P : ∀ Q, Q = P →
      Q.sendsIn ((esLoc.g.accept P stLoc' r0.pos).epoch Q) = true →
      (esLoc.g.accept P stLoc' r0.pos).epoch Q = esLoc.g.epoch P := by
    intro Q hQ hsQ
    subst hQ
    rw [hepP] at hsQ ⊢
    have hle : t0 ≤ esLoc.g.epoch Q := by
      by_contra hgt
      have heq : ep' = t0 := Nat.max_eq_right (by omega)
      rw [heq] at hsQ
      rw [hP_ns] at hsQ; cases hsQ
    exact Nat.max_eq_left hle
  exact
    { gsync := hinv.gsync.accept_sync P stLoc' stM' r0.pos
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := by dsimp only; rw [hwin_acc]; exact hinv.win_false
      lfWin_M := by dsimp only; rw [hlf]; exact hinv.lfWin_M
      comp_unhealed := hcu_acc hinv.comp_unhealed
      tL_mem_leaks := fun cur hcur => by
        dsimp only at hcur ⊢
        rw [htL_acc] at hcur; rw [hleaks_acc]
        exact hinv.tL_mem_leaks cur hcur
      phase1_props := fun hp => Bool.noConfusion hp
      phase2_props := fun _ => by dsimp only; rw [← hpl_acc]; exact hinv.phase2_props rfl
      sess_eq := by dsimp only; rw [hsess]; exact hinv.sess_eq
      sess_nodup := fun τ => by dsimp only; rw [hsess]; exact hinv.sess_nodup τ
      sess_zero_le := by dsimp only; rw [hsess]; exact hinv.sess_zero_le
      sess_pos_bound := fun τ hτ => by
        dsimp only; rw [hsess]
        exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
      sess_epoch_ok := fun τ hne => by dsimp only at hne; rw [hsess] at hne; exact hinv.sess_epoch_ok τ hne
      fTable_M_iff := fun τ ik => by dsimp only; rw [hft, hsess]; exact hinv.fTable_M_iff τ ik
      fTable_loc_eq := fun τ ik => by dsimp only; rw [hsess]; exact hinv.fTable_loc_eq τ ik
      cache_sync := fun τ => by dsimp only; rw [hcache, hsess]; exact hinv.cache_sync τ
      vp_id := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM', (hinv.vp_id Q).1, (hinv.vp_id Q).2]
        · simp [Function.update_of_ne hQ, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
      vp_tcur_eq := fun Q => by
        dsimp only
        rcases eq_or_ne Q P with rfl | hQ
        · rw [hepP]
          simp [GameState.accept, GameState.delete, stLoc', stM']
        · rw [hepQ Q hQ]
          simp [GameState.accept, GameState.delete, Function.update_of_ne hQ,
            (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
      vp_γ_eq := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM']
        · simp [Function.update_of_ne hQ, hinv.vp_γ_eq Q]
      vp_root_eq := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM']
        · simp [Function.update_of_ne hQ, hinv.vp_root_eq Q]
      vp_cka_eq := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM', hinv.vp_cka_eq Q]
        · simp [Function.update_of_ne hQ, hinv.vp_cka_eq Q]
      vp_cka_cache := fun Q hsQ => by
        dsimp only at hsQ ⊢
        rw [hcache]
        by_cases hQ : Q = P
        · have hep_eq := hsend_eq_P Q hQ hsQ
          subst hQ
          rw [hep_eq] at hsQ ⊢
          simpa [GameState.accept, GameState.delete, stLoc', stM'] using hinv.vp_cka_cache Q hsQ
        · rw [hepQ Q hQ] at hsQ ⊢
          simpa [GameState.accept, GameState.delete, Function.update_of_ne hQ] using
            hinv.vp_cka_cache Q hsQ
      epoch_bound := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst hQ; rw [hepP]
          have h1 := hinv.epoch_bound Q
          dsimp only [ep', t0] at ht0_le_ep1 ⊢
          omega
        · rw [hepQ Q hQ]
          exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
      vS_sync := fun Q => by
        dsimp only
        rw [hsess]
        by_cases hQ : Q = P
        · subst hQ
          have hv0 := hinv.vS_sync Q
          have hst1 : (esLoc.g.accept Q stLoc' r0.pos).st Q = stLoc' := by
            simp [GameState.accept, GameState.delete]
          have hst2 : (esM.g.accept Q stM' r0.pos).st Q = stM' := by
            simp [GameState.accept, GameState.delete]
          rw [hst1, hst2]
          dsimp only [stLoc', stM']
          rcases hv0 with h0 | h1 | ⟨τ, j', hle, hsend_eq, hQ_send, hc, hb, ht, hj', hv1, hv2⟩
          · exact Or.inl h0
          · exact Or.inr (Or.inl h1)
          · refine Or.inr (Or.inr ⟨τ, j', le_trans hle (hep_mono Q), ?_, hQ_send, hc, hb, ht, hj', hv1, hv2⟩)
            intro hsQ
            have hep_eq := hsend_eq_P Q rfl hsQ
            rw [hep_eq] at hsQ ⊢
            exact hsend_eq hsQ
        · rw [hepQ Q hQ]
          have hst1 : (esLoc.g.accept P stLoc' r0.pos).st Q = esLoc.g.st Q := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          have hst2 : (esM.g.accept P stM' r0.pos).st Q = esM.g.st Q := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          rw [hst1, hst2]
          exact hinv.vS_sync Q
      vR_dom := fun Q τ hdom => by
        dsimp only at hdom ⊢
        by_cases hQ : Q = P
        · subst hQ
          rw [hepP]
          simp only [GameState.accept, GameState.delete, Function.update_self, stM'] at hdom
          by_cases hτ : τ = t0
          · subst hτ
            exact ⟨le_max_right _ _, hP_recv⟩
          · simp only [Function.update_of_ne hτ] at hdom
            obtain ⟨hle, hrecv⟩ := hinv.vR_dom Q τ hdom
            exact ⟨le_trans hle (le_max_left _ _), hrecv⟩
        · rw [hepQ Q hQ]
          simp only [GameState.accept, GameState.delete, Function.update_of_ne hQ] at hdom
          exact hinv.vR_dom Q τ hdom
      vR_sync := fun Q τ => by
        dsimp only
        rw [hsess]
        by_cases hQ : Q = P
        · subst hQ
          have hst1 : (esLoc.g.accept Q stLoc' r0.pos).st Q = stLoc' := by
            simp [GameState.accept, GameState.delete]
          have hst2 : (esM.g.accept Q stM' r0.pos).st Q = stM' := by
            simp [GameState.accept, GameState.delete]
          rw [hst1, hst2]
          dsimp only [stLoc', stM']
          by_cases hτ : τ = t0
          · subst hτ
            exact Or.inr (Or.inr ⟨j, hP_recv, hcap, hbk_gen, htH_ne, hj_len,
              by simp [sIdx], by simp [sIdx]⟩)
          · rw [Function.update_of_ne hτ, Function.update_of_ne hτ]
            rcases hinv.vR_sync Q τ with h0 | h1 | ⟨j', hQr, hc', hb', ht', hj', hv1, hv2⟩
            · exact Or.inl h0
            · exact Or.inr (Or.inl h1)
            · have hj'_q : j' < q := by
                by_cases hτ0 : τ = 0
                · subst hτ0; exact lt_of_lt_of_le hj' hinv.sess_zero_le
                · have := hinv.sess_pos_bound τ (by omega); omega
              have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
                intro heq
                exact hτ (bucketSlot_inj (healEpoch_le_of_gen4 hb') htH_le hj'_q hj_q heq).1
              exact Or.inr (Or.inr ⟨j', hQr, hc', hb', ht', hj',
                by simp [Function.update_of_ne hne_s, hv1], hv2⟩)
        · have hst1 : (esLoc.g.accept P stLoc' r0.pos).st Q = esLoc.g.st Q := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          have hst2 : (esM.g.accept P stM' r0.pos).st Q = esM.g.st Q := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          rw [hst1, hst2]
          rcases hinv.vR_sync Q τ with h0 | h1 | ⟨j', hQr, hc', hb', ht', hj', hv1, hv2⟩
          · exact Or.inl h0
          · exact Or.inr (Or.inl h1)
          · have hτ_ne : τ ≠ t0 := by
              intro heq; subst heq; exact hQ (hQr.trans hP_recv.symm)
            have hj'_q : j' < q := by
              by_cases hτ0 : τ = 0
              · subst hτ0; exact lt_of_lt_of_le hj' hinv.sess_zero_le
              · have := hinv.sess_pos_bound τ (by omega); omega
            have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
              intro heq
              exact hτ_ne (bucketSlot_inj (healEpoch_le_of_gen4 hb') htH_le hj'_q hj_q heq).1
            exact Or.inr (Or.inr ⟨j', hQr, hc', hb', ht', hj',
              by simp [Function.update_of_ne hne_s, hv1], hv2⟩)
      sess_inv := fun i => by
        dsimp only
        by_cases hi : i = sIdx
        · subst hi
          simp only [Function.update_self]
          exact hinv_s'
        · simp only [Function.update_of_ne hi, hoth i hi]
          exact hinv.sess_inv i
      ss_fresh := fun τ j' h1 h2 h3 hlt =>
        hinv.ss_fresh τ j' h1 h2 h3 (lt_of_le_of_lt (hep_mono _) hlt)
      rs_fresh := fun τ j' h1 h2 h3 hlt => by
        dsimp only at hlt ⊢
        have hτ_ne : τ ≠ t0 := by
          intro heq; subst heq
          rw [← hP_recv, hepP] at hlt
          have : t0 ≤ ep' := le_max_right _ _
          omega
        have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
          intro heq
          exact hτ_ne (bucketSlot_inj h2 htH_le h3 hj_q heq).1
        rw [Function.update_of_ne hne_s]
        exact hinv.rs_fresh τ j' h1 h2 h3 (lt_of_le_of_lt (hep_mono _) hlt)
      book_fresh_before_send := fun τ j' h1 h2 h3 hlt hh => by
        dsimp only at hlt hh ⊢
        rw [htL_acc] at hh
        have hlt_orig := lt_of_le_of_lt (hep_mono _) hlt
        have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
          intro heq
          obtain ⟨hτ_eq, _⟩ := bucketSlot_inj h2 htH_le h3 hj_q heq
          subst hτ_eq; omega
        rw [hoth _ hne_s]
        exact hinv.book_fresh_before_send τ j' h1 h2 h3 hlt_orig hh
      trans_meta := fun r' hr' => by
        dsimp only at hr' ⊢
        rw [hcache]
        obtain ⟨h1, h2, h3, h4, h5⟩ := hinv.trans_meta r' (htr_sub r' hr')
        exact ⟨h1, h2, le_trans h3 (hep_mono _), h4, h5⟩
      cache_empty_gt := fun τ hlt => by
        dsimp only at hlt ⊢; rw [hcache]
        exact hinv.cache_empty_gt τ (lt_of_le_of_lt (hep_mono _) hlt)
      healed_sender_pin := fun Q τ j' hsQ hτ hvS hh => by
        dsimp only at hsQ hτ hvS hh ⊢
        rw [htL_acc] at hh
        rw [hidx_acc, hcache]
        have hpin0 : esLoc.g.idx Q = ((esM.h.book (q * (τ - healEpoch tL) + j')).getD {}).fsCount ∧
            ((τ = 0 ∧ j' = 0 ∧ (esM.g.st Q).curCkaMsg = none) ∨
             (1 ≤ τ ∧ ∃ Tc σc kMulti, (esM.g.st Q).curCkaMsg = some Tc ∧
               esM.h.cache τ = some (Tc, σc, kMulti, some (q * (τ - healEpoch tL) + j')))) := by
          by_cases hQ : Q = P
          · have hep_eq := hsend_eq_P Q hQ hsQ
            subst hQ
            rw [hep_eq] at hsQ hτ
            simp only [GameState.accept, GameState.delete, Function.update_self, stM'] at hvS
            exact hinv.healed_sender_pin Q τ j' hsQ hτ hvS hh
          · rw [hepQ Q hQ] at hsQ hτ
            simp only [GameState.accept, GameState.delete, Function.update_of_ne hQ] at hvS
            exact hinv.healed_sender_pin Q τ j' hsQ hτ hvS hh
        refine ⟨?_, ?_⟩
        · by_cases hs : q * (τ - healEpoch tL) + j' = sIdx
          · dsimp only [sIdx] at hs
            rw [hs] at hpin0 ⊢; rw [hcnt]; exact hpin0.1
          · rw [hoth _ hs]; exact hpin0.1
        · by_cases hQ : Q = P
          · subst hQ
            simpa [GameState.accept, GameState.delete, stM'] using hpin0.2
          · simpa [GameState.accept, GameState.delete, Function.update_of_ne hQ] using hpin0.2
      healed_vR_pin := fun Q τ sIdx' hvR hh => by
        dsimp only at hvR hh ⊢
        rw [htL_acc] at hh
        rw [hcache]
        by_cases hQ : Q = P
        · subst hQ
          simp only [GameState.accept, GameState.delete, Function.update_self, stM'] at hvR
          by_cases hτ : τ = t0
          · subst hτ
            simp only [Function.update_self, Option.some.injEq, Sum.inr.injEq] at hvR
            subst hvR
            exact hpin_t0 hh
          · simp only [Function.update_of_ne hτ] at hvR
            exact hinv.healed_vR_pin Q τ sIdx' hvR hh
        · simp only [GameState.accept, GameState.delete, Function.update_of_ne hQ] at hvR
          exact hinv.healed_vR_pin Q τ sIdx' hvR hh
      healed_book_trans := fun τ sIdx' hh hro hp => by
        dsimp only at hh hro hp ⊢
        rw [htL_acc] at hh
        rw [hcache] at hp
        by_cases hτ : τ = t0
        · subst hτ
          have hs_eq : sIdx' = sIdx := by
            rw [← hP_recv] at hro
            rcases hro with hlt | hvR
            · rw [hepP] at hlt
              have : t0 ≤ ep' := le_max_right _ _
              omega
            · simp only [GameState.accept, GameState.delete, Function.update_self, stM',
                Option.some.injEq, Sum.inr.injEq] at hvR
              exact hvR.symm
          subst hs_eq
          have hhM : healedBy esM.g.tL 3 t0 = true := by rwa [← hinv.gsync.tL_eq]
          rw [hheal_tr hhM, hinv.healed_book_trans t0 sIdx hh hro_pre (hpin_t0 hh)]
          have hfilt_del' := hfilt_del
          rw [hr0_ep] at hfilt_del'
          exact hfilt_del'.symm
        · have hne_s : sIdx' ≠ sIdx := by
            intro heq; subst heq
            rcases hp with ⟨h0, hs0, _, htL_n⟩ | ⟨h1, Tc', σc', kMulti', hc⟩
            · subst h0
              have htH0 : healEpoch tL = 0 := by subst htL_n; rfl
              have hs0' : q * (0 - healEpoch tL) + 0 = sIdx := by simp [hs0]
              exact hτ (bucketSlot_inj (by omega) htH_le hq_pos hj_q hs0').1
            · rcases hinv.cache_sync τ with ⟨_, hcn⟩ | ⟨_, _, _, _, _, hcn⟩ |
                  ⟨_, _, _, j', _, hj'_len, _, hbk', _, _, hcs⟩
              · rw [hcn] at hc; cases hc
              · rw [hcn] at hc; cases hc
              · rw [hcs] at hc
                simp only [Option.some.injEq, Prod.mk.injEq] at hc
                have hj'_q : j' < q := by have := hinv.sess_pos_bound τ h1; omega
                exact hτ (bucketSlot_inj (healEpoch_le_of_gen4 hbk') htH_le hj'_q hj_q hc.2.2.2).1
          rw [hoth _ hne_s]
          have hne_pos : τ ≠ r0.pos.epoch := by rw [hr0_ep]; exact hτ
          rw [hfilt_ne τ hne_pos]
          have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
              (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
            rcases hro with hlt | hvR
            · exact Or.inl (lt_of_le_of_lt (hep_mono _) hlt)
            · right
              by_cases hQ : Party.receiverOf τ = P
              · rw [hQ] at hvR ⊢
                simpa [GameState.accept, GameState.delete, stM', Function.update_of_ne hτ] using hvR
              · simpa [GameState.accept, GameState.delete, Function.update_of_ne hQ] using hvR
          exact hinv.healed_book_trans τ sIdx' hh hro_orig hp }

private theorem step2_deliver {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey)
    (hinj : Function.Injective encT) (hdum : ∀ T, encT T ≠ dummyKey)
    (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (hℓ : ℓ < 10 ^ 6) (hq_pos : 0 < q)
    (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c : Fig8C Pt)
    {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range (.inl (.inl (.inl (.inr ⟨P, c⟩)))) →
      OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inl (.inr ⟨P, c⟩)))
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  let _ := hinj; let _ := hdum
  intro qr
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  cases hinT : esLoc.g.inTransit P.other c with
  | none =>
    have hinM : esM.g.inTransit P.other c = none := by
      unfold GameState.inTransit at hinT ⊢; rw [← hinv.gsync.trans_eq]; exact hinT
    have hstepLoc :
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
        pure (none, esLoc) := by
      simp [qr, implEDFPaperBucketRaw, deliverE, hinv.abort_loc, hinv.win_false, hinT]
    have hstepM :
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tblM) =
        pure ((none, esM), (fun _ => false, tblM)) := by
      simp [qr, implEDFPaperBucketRaw, deliverE, hinv.abort_M, hwinM, hinM]
    rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc none hinv.win_false hstepLoc,
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM none hwinM hstepM]
    simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
    exact hIH2 none ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))
  | some r0 =>
    obtain ⟨hinM, hr0_mem, hr0_send, hr0_ct, hr0_ep, hP_recv, hP_ns, hpos1⟩ :=
      step2_deliver_aux_inTransit_some_props hinv.gsync hinv.trans_meta hinT
    let t0 := c.1.1
    have hsLoc_id : (esLoc.g.st P).id.sendsIn t0 = false := by rw [(hinv.vp_id P).1]; exact hP_ns
    have hsM_id : (esM.g.st P).id.sendsIn t0 = false := by rw [(hinv.vp_id P).2]; exact hP_ns
    have htcur_loc : (esLoc.g.st P).tcur = esLoc.g.epoch P := (hinv.vp_tcur_eq P).1
    have htcur_M : (esM.g.st P).tcur = esLoc.g.epoch P := (hinv.vp_tcur_eq P).2
    by_cases ht_gt : esLoc.g.epoch P + 1 < t0
    · have hvLoc : simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          ((vRecv (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
            esLoc.g P (esLoc.g.st P) c (some r0)).run esLoc.h) = pure (some none, esLoc.h) := by
        simp [vRecv, t0, hsLoc_id, htcur_loc, ht_gt, StateT.run_pure]
      have hvM : (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          ((vRecv (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
            esM.g P (esM.g.st P) c (some r0)).run esM.h)).run (fun _ => false, tblM) =
          pure ((some none, esM.h), (fun _ => false, tblM)) := by
        simp [vRecv, t0, hsM_id, htcur_M, ht_gt, StateT.run_pure]
      have hstepLoc := step2_deliver_aux_deliverE_of_vRecv_reject_loc mode C Dh encPt encT idOf ℓ q qep tL par ks
        P c r0 esLoc esLoc.h hinv.abort_loc hinv.win_false hinT hvLoc
      have hstepM := step2_deliver_aux_deliverE_of_vRecv_reject_multi mode C Dh encPt encT idOf ℓ q qep tL par false
        P c r0 esM esM.h tblM tblM hinv.abort_M hwinM hinM hvM
      rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc _ hinv.win_false hstepLoc,
          runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM _ hwinM hstepM]
      simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
      exact hIH2 (some .rejected) ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))
    · have ht0_le_ep1 : t0 ≤ esLoc.g.epoch P + 1 := Nat.le_of_not_lt ht_gt
      have hguard_loc : ((esLoc.g.st P).id.sendsIn t0 || decide ((esLoc.g.st P).tcur + 1 < t0)) = false := by
        simp [hsLoc_id, htcur_loc, ht_gt]
      have hguard_M : ((esM.g.st P).id.sendsIn t0 || decide ((esM.g.st P).tcur + 1 < t0)) = false := by
        simp [hsM_id, htcur_M, ht_gt]
      -- Unify `t0 = esLoc.g.epoch P + 1` (cache startRecv) and `t0 ≤ esLoc.g.epoch P` (existing vR)
      let mkS1Loc (γ_new : CryptoGames.CKA.DDH.State (BitVec 256) Pt) (σ_new : BitVec 256)
          (rs : RatchetReceiverState (BitVec 256) (BitVec 256)) : LocVP Pt :=
        { esLoc.g.st P with
          tcur := max (esLoc.g.epoch P) t0, γ := γ_new, root := σ_new,
          vR := Function.update (esLoc.g.st P).vR t0 (some rs) }
      let mkS1M (γ_new : CryptoGames.CKA.DDH.State (BitVec 256) Pt) (σ_new : BitVec 256)
          (vr : RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ) : MultiVP Pt :=
        { esM.g.st P with
          tcur := max (esLoc.g.epoch P) t0, γ := γ_new, root := σ_new,
          vR := Function.update (esM.g.st P).vR t0 (some vr) }
      have hvR_stage :
          (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
              ((vRecv (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                esLoc.g P (esLoc.g.st P) c (some r0)).run esLoc.h) = pure (some none, esLoc.h) ∧
           (simulateQ (pubFsImplOpt C ℓ encT idOf false)
              ((vRecv (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
                esM.g P (esM.g.st P) c (some r0)).run esM.h)).run (fun (_ : ℕ) => false, tblM) =
              pure ((some none, esM.h), (fun (_ : ℕ) => false, tblM))) ∨
          (∃ γ_new σ_new rs,
            simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
              ((vRecv (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                esLoc.g P (esLoc.g.st P) c (some r0)).run esLoc.h) =
              pure (some (((lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rs c.1 c.2).map
                (fun o => ({ mkS1Loc γ_new σ_new rs with
                  vR := Function.update (mkS1Loc γ_new σ_new rs).vR t0 (some o.1) }, t0, o.2.1, o.2.2))), esLoc.h) ∧
            (simulateQ (pubFsImplOpt C ℓ encT idOf false)
              ((vRecv (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
                esM.g P (esM.g.st P) c (some r0)).run esM.h)).run (fun (_ : ℕ) => false, tblM) =
              pure ((some (((lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive rs c.1 c.2).map
