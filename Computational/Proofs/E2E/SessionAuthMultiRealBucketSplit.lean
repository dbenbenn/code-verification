private theorem idxOf_append_singleton_of_not_mem {α : Type} [DecidableEq α]
    (l : List α) (x y : α) (hx : x ∉ l) :
    (l ++ [x]).idxOf y =
      if y = x then l.length else if y ∈ l then l.idxOf y else l.length + 1 := by
  induction l with
  | nil =>
    by_cases hy : y = x
    · subst hy; simp
    · simp [hy]
  | cons a tl ih =>
    have hax : a ≠ x := fun h => hx (by simp [h])
    have hx_tl : x ∉ tl := fun h => hx (by simp [h])
    by_cases hya : y = a
    · subst hya
      have hyx : y ≠ x := hax
      simp [hyx]
    · have hba : (a == y) = false := beq_false_of_ne (Ne.symm hya)
      have hmem_iff : (y ∈ a :: tl) ↔ (y ∈ tl) := by simp [hya]
      simp only [List.cons_append, List.idxOf_cons, hba, ih hx_tl,
        List.length_cons, hmem_iff]
      by_cases hyx : y = x <;> by_cases hytl : y ∈ tl <;> simp [hyx, hytl]

private abbrev hkLocOpt {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256) :=
  hooksSlotBucketOptAt mode q (((qep + 2) - healEpoch tL) * q) ks
    (dhScheme Dh) (rootPRNG C.F encPt)
    (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) qep tL par

private abbrev hkMultiOpt {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool) :=
  hooksFSMultiDFBucketOpt mode (q + 1)
    (dhScheme Dh) (rootPRNG C.F encPt)
    (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par la

private abbrev pubFsImplOpt {Pt : Type} [DecidableEq Pt]
    (C : Crypto) (ℓ : ℕ) (encT : Pt → PublicKey) (idOf : Party → IdentityKey) (la : Bool) :=
  pubFsMultiImpl (fsImpl (lIdeal C protoSignalCodec ℓ encT)
    (lAeadR C protoSignalCodec ℓ encT idOf) (lChainPRG C.F) maxForwardJumps (hp 0 0 la))

private abbrev runLocCont {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256) {α : Type}
    (oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (Fig8St Pt) (LibsignalMsgPublicPart × Plain ℓ) (BitVec 256) (Fig8C Pt)) α)
    (esLoc : LocES Pt ℓ) (winEp : Option ℕ) : ProbComp Bool :=
  simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl do
    let (_, es, we) ← (simulateQ (implEDFPaperBucketMode
      (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
      3 qep maxForwardJumps (bucketAuthCfg 1 tL par) (mode != some false)
      isHonestHdrSlotBucket) oa).run (esLoc, winEp)
    return authOutBucket 3 tL (es, we)

private abbrev runMultiCont {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool) {α : Type}
    (oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (Fig8St Pt) (LibsignalMsgPublicPart × Plain ℓ) (BitVec 256) (Fig8C Pt)) α)
    (es : MultiES Pt ℓ) (winEp : Option ℕ) (tbl : ℕ → SessHSt Pt ℓ) : ProbComp Bool :=
  Prod.fst <$> (simulateQ (pubFsImplOpt C ℓ encT idOf la) do
    let (_, es', we) ← (simulateQ (implEDFPaperBucketMode
      (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la)
      3 qep maxForwardJumps (bucketAuthCfg 1 tL par) (mode != some false)
      isHonestHdrFSMultiDFBucket) oa).run (es, winEp)
    return if la then es'.h.lfWin else authOutBucket 3 tL (es', we)).run (fun _ => false, tbl)

private theorem redFSAuthDFPaperMultiBucketOpt_eq
    {KC Γ CCoins T I KR RSt K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType KR] [SampleableType KC] [SampleableType CCoins]
    [SampleableType I] [SampleableType K]
    (mode : Option Bool) (L : ℕ)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR RSt I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (lam : I) (qep : ℕ)
    (la : Bool) (tL : Option ℕ) (par : Bool)
    (A : SchemeAdversaryDF Γ T RSt SS RS M CCoins E) :
    redFSAuthDFPaperMultiBucketOpt mode L cka prng fs lam 1 4 qep la tL par A =
      (do
        let r ← engRunDFPaperBucketMode
          (hooksFSMultiDFBucketOpt mode L cka prng fs 1 4 qep tL par la)
          3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false)
          isHonestHdrFSMultiDFBucket
          (initFSMultiDFBucketPaper L cka prng fs lam 4 qep tL par) {} false A
        return match r with
          | none => false
          | some (_, st) => if la then st.1.h.lfWin else authOutBucket 3 tL st) := by
  cases mode with
  | none => rfl
  | some gMain => cases gMain <;> rfl

