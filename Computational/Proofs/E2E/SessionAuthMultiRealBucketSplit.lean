private theorem GSync.afterCorr_sync {Pt : Type} {ℓ : ℕ}
    {gLoc : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256)) (RatchetReceiverState (BitVec 256) (BitVec 256))
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    {gM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    (h : GSync gLoc gM) (P : Party) :
    GSync (gLoc.afterCorr P) (gM.afterCorr P) := by
  unfold GameState.afterCorr GameState.leak
  exact
    { epoch_eq := h.epoch_eq
      idx_eq := h.idx_eq
      tL_eq := by dsimp only; rw [h.tL_eq, h.epoch_eq]
      trans_eq := h.trans_eq
      chall_eq := h.chall_eq
      comp_eq := by dsimp only; rw [h.trans_eq, h.comp_eq]
      maxAcc_eq := h.maxAcc_eq
      b_eq := h.b_eq
      win_eq := h.win_eq
      leaks_eq := by dsimp only; rw [h.tL_eq, h.epoch_eq, h.leaks_eq]
      corrs_eq := by dsimp only; rw [h.epoch_eq, h.corrs_eq] }

private theorem postLeak_afterCorr_of_postLeak {St Msg C : Type}
    {tL : Option ℕ} {g : GameState St Msg C} (P : Party)
    (hpl : postLeak tL g = true) :
    postLeak tL (g.afterCorr P) = true := by
  unfold postLeak at hpl ⊢
  cases htL : g.tL with
  | none => rw [htL] at hpl; cases hpl
  | some cur =>
    rw [htL] at hpl
    have hl := leak_props g (max (g.epoch .A) (g.epoch .B))
    have htL' : (g.afterCorr P).tL = some (maxOpt g.tL (max (g.epoch .A) (g.epoch .B))) := rfl
    rw [htL']
    have hle := hl.2.2.2.2 cur htL
    cases tL with
    | none => rfl
    | some l => simp only [ltOpt, decide_eq_true_eq] at hpl ⊢; omega

private def calcWinEp {St Msg Coins T' E' : Type}
    (gMain : Bool) (isHonest : Header T' → Bool) (epOf : Party → ℕ)
    (qr : (_root_.CryptoGames.SM.Construction.DeliverForge.specDF St Msg Coins (Header T' × E')).Domain)
    (nowWin : Bool) : Option ℕ :=
  if nowWin then
    if gMain then
      @_root_.CryptoGames.SM.Construction.DeliverForge.dfQueryTargetEpoch St Msg Coins
        (Header T' × E') (fun c => c.1.1) (.inr qr)
    else
      match qr with
      | .inl (.inl (.inr (P, c))) =>
        if decide (c.1.1 = epOf P + 1) && !isHonest c.1 then some c.1.1 else none
      | _ => none
  else
    none

private theorem implEDFPaperBucketMode_inr_run_of_not_win
    {ι : Type} {tspec : OracleSpec.{0, 0} ι}
    {Γ CCoins T Sig SS RS M E HS Γv Sv SSv RSv : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hk : _root_.CryptoGames.SM.Engine.Hooks tspec HS Γ T Sig SS RS M E CCoins Γv Sv SSv RSv)
    (Δ qep maxSkip : ℕ) (cfg : Config M) (gMain : Bool) (isHonest : HS → Header T → Bool)
    (qr : (_root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)).Domain)
    (es : EState (VP Γv T Sv SSv RSv) M (Header T × E) HS) (hwin : es.g.win = false) :
    ((implEDFPaperBucketMode hk Δ qep maxSkip cfg gMain isHonest) (.inr qr)).run (es, none) =
      (((implEDFPaperBucketRaw hk Δ qep maxSkip cfg) (.inr qr)).run es >>= fun p =>
        pure (p.1, (p.2, calcWinEp gMain (isHonest es.h) (fun P => (es.g.st P).tcur) qr p.2.g.win))) := by
  cases gMain
  · cases qr with
    | inl q1 =>
      cases q1 with
      | inl q2 =>
        cases q2 with
        | inl _ => simp [implEDFPaperBucketMode, withWinEpDFMode, calcWinEp, StateT.run_mk]
        | inr _ => simp [implEDFPaperBucketMode, withWinEpDFMode, calcWinEp, hwin, StateT.run_mk]
      | inr _ => simp [implEDFPaperBucketMode, withWinEpDFMode, calcWinEp, StateT.run_mk]
    | inr _ => simp [implEDFPaperBucketMode, withWinEpDFMode, calcWinEp, StateT.run_mk]
  · simp [implEDFPaperBucketMode, withWinEpDFMode, withWinEpDF, calcWinEp, hwin, StateT.run_mk]

private theorem runLocCont_inr_eq {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (qr : (Fig8SpecDF Pt ℓ).Domain) {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range qr → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (esLoc : LocES Pt ℓ) (hwin : esLoc.g.win = false) :
    runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
      (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none =
    (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) >>= fun p =>
      runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r p.1) p.2
        (calcWinEp (mode != some false) (isHonestHdrSlotBucket esLoc.h)
          (fun P => (esLoc.g.st P).tcur) qr p.2.g.win)) := by
  dsimp only [runLocCont]
  rw [simulateQ_query_bind]
  dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift]
  rw [StateT.run_bind, bind_assoc, simulateQ_bind,
    implEDFPaperBucketMode_inr_run_of_not_win _ _ _ _ _ _ _ qr esLoc hwin]
  simp only [simulateQ_bind, simulateQ_pure, bind_assoc, pure_bind]

private theorem runMultiCont_inr_eq {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool)
    (qr : (Fig8SpecDF Pt ℓ).Domain) {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range qr → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (es : MultiES Pt ℓ) (tbl : ℕ → SessHSt Pt ℓ) (hwin : es.g.win = false) :
    runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par la
      (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) es none tbl =
    ((simulateQ (pubFsImplOpt C ℓ encT idOf la)
      (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la)
        3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run es)).run (fun _ => false, tbl) >>=
      fun p =>
        Prod.fst <$> (simulateQ (pubFsImplOpt C ℓ encT idOf la) do
          let (_, es', we) ← (simulateQ (implEDFPaperBucketMode
            (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par) (mode != some false)
            isHonestHdrFSMultiDFBucket) (r p.1.1)).run
            (p.1.2, calcWinEp (mode != some false) (isHonestHdrFSMultiDFBucket es.h)
              (fun P => (es.g.st P).tcur) qr p.1.2.g.win)
          return if la then es'.h.lfWin else authOutBucket 3 tL (es', we)).run p.2) := by
  dsimp only [runMultiCont]
  rw [simulateQ_query_bind]
  dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift]
  rw [StateT.run_bind, bind_assoc, simulateQ_bind, StateT.run_bind, map_bind,
    implEDFPaperBucketMode_inr_run_of_not_win _ _ _ _ _ _ _ qr es hwin]
  simp only [simulateQ_bind, simulateQ_pure, StateT.run_bind, StateT.run_pure,
    bind_assoc, pure_bind]

private theorem runLocCont_inr_of_step {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
