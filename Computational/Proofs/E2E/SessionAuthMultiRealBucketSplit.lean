private def bucketRawOut {VP M C HS : Type} (Δ : ℕ) (tL : Option ℕ) :
    Option (Bool × (EState VP M C HS × Option ℕ)) → Bool
  | none => false
  | some (_, st) =>
    match st.2 with
    | none => false
    | some tWin => !st.1.abort && st.1.g.win && authLosingConditionsAvoided Δ tL tWin st.1.g

private theorem localAuthDFPaperBucketRaw_eq_map
    {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType KR] [SampleableType KC] [SampleableType CCoins]
    [SampleableType I] [SampleableType K]
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (lam : I) (Δcka qep : ℕ)
    (tL : Option ℕ) (par : Bool)
    (A : SchemeAdversaryDF Γ T Sig SS RS M CCoins E) :
    localAuthDFPaperBucketRaw cka prng fs lam Δcka qep tL par A =
      bucketRawOut (2 + Δcka) tL <$>
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (engRunDFPaperBucket (hooksLocalBucket cka prng fs Δcka qep tL par)
            (2 + Δcka) qep fs.maxSkip (bucketAuthCfg Δcka tL par)
            (initLocalBucket cka prng fs lam (3 + Δcka) qep tL par) {} false A) := by
  unfold localAuthDFPaperBucketRaw bucketRawOut
  rw [map_eq_bind_pure_comp]
  congr 1; funext r; rcases r with _ | ⟨_, _⟩ <;> rfl

section BucketPureHelpers

private theorem ltOpt_of_inStage2BucketGen_le {tL : Option ℕ} {par : Bool} {t0 e : ℕ}
    (h0 : inStage2BucketGen 4 tL par t0 = true) (hle : t0 ≤ e) :
    ltOpt tL e = true := by
  simp only [inStage2BucketGen, lastLeakGuessAdmissible, healedBy, Bool.and_eq_true] at h0
  cases tL with
  | none => rfl
  | some l =>
    simp only [decide_eq_true_eq] at h0
    simp only [ltOpt, decide_eq_true_eq]
    omega

private theorem bucketSlot_lt_mSess {q qep : ℕ} {tL : Option ℕ} {par : Bool} {t0 idx : ℕ}
    (hcap : !(qep + 1 < t0) = true)
    (hbk : inStage2BucketGen 4 tL par t0 = true)
    (hidx : idx < q) :
    q * (t0 - healEpoch tL) + idx < ((qep + 2) - healEpoch tL) * q := by
  have hcap' : t0 ≤ qep + 1 := by simpa using hcap
  simp only [inStage2BucketGen, lastLeakGuessAdmissible, healedBy, Bool.and_eq_true] at hbk
  have htH : healEpoch tL ≤ t0 := by
    cases tL with
    | none => simp [healEpoch]
    | some l =>
      simp only [decide_eq_true_eq] at hbk
      simp only [healEpoch]; omega
  generalize healEpoch tL = h at htH ⊢
  have hsub : t0 - h + 1 ≤ (qep + 2) - h := by omega
  calc
    q * (t0 - h) + idx < q * (t0 - h) + q := by omega
    _ = q * (t0 - h + 1) := by ring
    _ ≤ q * ((qep + 2) - h) := Nat.mul_le_mul_left q hsub
    _ = ((qep + 2) - h) * q := Nat.mul_comm _ _

private theorem bucketSlot_inj {q : ℕ} {tL : Option ℕ} {t1 t2 i1 i2 : ℕ}
    (ht1 : healEpoch tL ≤ t1) (ht2 : healEpoch tL ≤ t2)
    (hi1 : i1 < q) (hi2 : i2 < q)
    (heq : q * (t1 - healEpoch tL) + i1 = q * (t2 - healEpoch tL) + i2) :
    t1 = t2 ∧ i1 = i2 := by
  have hq : 0 < q := by omega
  have hdiv : (q * (t1 - healEpoch tL) + i1) / q = (q * (t2 - healEpoch tL) + i2) / q :=
    congrArg (· / q) heq
  rw [Nat.mul_add_div hq, Nat.mul_add_div hq,
      Nat.div_eq_zero_iff.mpr (Or.inr hi1), Nat.div_eq_zero_iff.mpr (Or.inr hi2)] at hdiv
  simp only [add_zero] at hdiv
  have ht1' := Nat.sub_add_cancel ht1
  have ht2' := Nat.sub_add_cancel ht2
  have ht12 : t1 = t2 := by rw [← ht1', ← ht2', hdiv]
  subst ht12
  exact ⟨rfl, Nat.add_left_cancel heq⟩

private theorem not_tH_of_inStage2BucketGen_some {l : ℕ} {par : Bool} {t0 : ℕ}
    (hbk : inStage2BucketGen 4 (some l) par t0 = true) :
    t0 ≠ healEpoch (some l) := by
  simp only [inStage2BucketGen, lastLeakGuessAdmissible, healedBy, Bool.and_eq_true,
    decide_eq_true_eq, healEpoch] at hbk ⊢
  omega

end BucketPureHelpers

