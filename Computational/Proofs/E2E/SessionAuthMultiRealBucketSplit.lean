      have ht_le : c.1.1 ≤ esLoc.g.epoch P + 1 := by
        have := (Bool.or_eq_false_iff.mp hhdr_f).2
        simp only [decide_eq_false_iff_not] at this; omega
      have hP_recv : P = Party.receiverOf c.1.1 :=
        (not_sendsIn_iff_receiverOf P c.1.1).mp (by simp [hsends_f])
      rw [runLocCont_inr_eq _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc hinv.win_false,
          runMultiCont_inr_eq _ _ _ _ _ _ _ _ _ _ _ _ qr r esM tblM hwinM,
          runMultiCont_inr_eq _ _ _ _ _ _ _ _ _ _ _ _ qr r esM tblL hwinM]
      by_cases heq : c.1.1 = esLoc.g.epoch P + 1
      · have heqLoc : c.1.1 = (esLoc.g.st P).tcur + 1 := by rw [(hinv.vp_tcur_eq P).1]; exact heq
        have heqM : c.1.1 = (esM.g.st P).tcur + 1 := by rw [(hinv.vp_tcur_eq P).2]; exact heq
        have ht1 : 1 ≤ c.1.1 := by omega
        have hmax_eq : max (esLoc.g.epoch P) c.1.1 = c.1.1 := Nat.max_eq_right (by omega)
        have hep_recv_lt : esLoc.g.epoch (Party.receiverOf c.1.1) < c.1.1 := by
          rw [← hP_recv]; omega
        rcases htn : c.1.2 with _ | tn0
        · dsimp only [qr]
          rw [step1_inject_aux_raw_succ_none _ _ _ _ _ _ _ hguard_f hhdrLoc_f heqLoc htn,
              step1_inject_aux_raw_succ_none _ _ _ _ _ _ _ hguardM_f hhdrM_f heqM htn,
              step1_inject_aux_raw_succ_none _ _ _ _ _ _ _ hguardM_f hhdrM_f heqM htn]
          simp only [simulateQ_pure, StateT.run_pure, pure_bind, hinv.win_false, hwinM,
            calcWinEp, Bool.false_eq_true, ↓reduceIte]
          exact hIH1 (some .rejected) ssLoc rsLoc esLoc esM esM tblM tblL (hinv.mono_rem (Nat.le_succ rem))
        · dsimp only [qr]
          rw [step1_inject_aux_sim_raw_succ_some_loc hguard_f hhdrLoc_f heqLoc htn,
              step1_inject_aux_sim_raw_succ_some_multi false tblM hguardM_f hhdrM_f heqM htn,
              step1_inject_aux_sim_raw_succ_some_multi true tblL hguardM_f hhdrM_f heqM htn]
          by_cases hhon : isHonestHdrSlotBucket esLoc.h (c.1.1, some tn0) = true
          · rcases hinv.cache_sync c.1.1 with ⟨hcL, _⟩ |
                ⟨Tc, σc, kVal, _, hcL, hcM⟩ |
                ⟨Tc, σc, kMulti, j, _, hj, hcap, hgen, _, hcL, hcM⟩
            · simp [isHonestHdrSlotBucket, toLocalBucketState, isHonestHdrLocalBucket, hcL] at hhon
            · have hTc : Tc = tn0 := by
                simpa [isHonestHdrSlotBucket, toLocalBucketState, isHonestHdrLocalBucket, hcL, beq_iff_eq] using hhon
              subst hTc
              rw [step1_inject_aux_sim_startRecv_loc_honest _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hcL,
                  step1_inject_aux_sim_startRecv_multi_honest _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hcM,
                  step1_inject_aux_sim_startRecv_multi_honest _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hcM]
              simp only [pure_bind]
              let γNew := ((dhScheme Dh).receive (esLoc.g.st P).γ Tc).1
              let rsNew := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver kVal
              have hs1L : { esLoc.g.st P with
                    tcur := c.1.1, γ := γNew, root := σc,
                    vR := Function.update (esLoc.g.st P).vR c.1.1 (some rsNew) } =
                  { esLoc.g.st P with
                    tcur := max (esLoc.g.epoch P) c.1.1, γ := γNew, root := σc,
                    vR := Function.update (esLoc.g.st P).vR c.1.1 (some rsNew) } := by
                rw [hmax_eq]
              have hs1M : { esM.g.st P with
                    tcur := c.1.1, γ := ((dhScheme Dh).receive (esM.g.st P).γ Tc).1, root := σc,
                    vR := Function.update (esM.g.st P).vR c.1.1 (some (.inl rsNew)) } =
                  { esM.g.st P with
                    tcur := max (esLoc.g.epoch P) c.1.1, γ := γNew, root := σc,
                    vR := Function.update (esM.g.st P).vR c.1.1 (some (.inl rsNew)) } := by
                dsimp only [γNew]; rw [← hinv.vp_γ_eq P, hmax_eq]
              rw [hs1L, hs1M]
              exact step1_inject_aux_afterS1_inl mode C Dh encPt encT idOf ℓ q qep rem tL par ks
                P c r hIH1 ssLoc rsLoc esLoc esM tblM tblL hinv hsends_f ht_le γNew σc rsNew
            · have hTc : Tc = tn0 := by
                simpa [isHonestHdrSlotBucket, toLocalBucketState, isHonestHdrLocalBucket, hcL, beq_iff_eq] using hhon
              subst hTc
              let sIdx := q * (c.1.1 - healEpoch tL) + j
              have hj_q : j < q := by have := hinv.sess_pos_bound c.1.1 ht1; omega
              have hrs_eq : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver (ks sIdx) =
                  rsLoc sIdx :=
                (hinv.rs_fresh c.1.1 j ht1 (healEpoch_le_of_gen4 hgen) hj_q hep_recv_lt).symm
              rw [step1_inject_aux_sim_startRecv_loc_honest _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hcL,
                  step1_inject_aux_sim_startRecv_multi_honest _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hcM,
                  step1_inject_aux_sim_startRecv_multi_honest _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hcM]
              simp only [pure_bind]
              have hcap' : (!decide (qep + 1 < c.1.1)) = true := by simpa using hcap
              refine step1_inject_aux_afterS1_inr mode C Dh hD encPt encT idOf ℓ q qep rem (rem + 1)
                hℓ (Nat.le_succ rem) tL par ks P c r hIH1 ssLoc rsLoc esLoc esM esLoc esM tblM tblL
                hinv hinv hcap' hgen sIdx _ _ ?_ ?_
              · simp [hrs_eq, sIdx]
              · simp [sIdx]
          · have hfLoc : isHonestHdrSlotBucket esLoc.h (c.1.1, some tn0) = false :=
              Bool.eq_false_iff.mpr hhon
            have hfM : isHonestHdrFSMultiDFBucket esM.h (c.1.1, some tn0) = false := by
              rw [← isHonestHdr_eq_of_cache_sync hinv.cache_sync]; exact hfLoc
            by_cases hrej : (mode == some true) = true ∨ (!decide (qep + 1 < c.1.1) && inStage2BucketGen 4 tL par c.1.1) = false
            · rw [step1_inject_aux_sim_startRecv_loc_forged_rej _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hfLoc hrej,
                  step1_inject_aux_sim_startRecv_multi_forged_rej _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hfM hrej,
                  step1_inject_aux_sim_startRecv_multi_forged_rej _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hfM hrej]
              simp only [pure_bind, hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
              exact hIH1 (some .rejected) ssLoc rsLoc esLoc esM esM tblM tblL (hinv.mono_rem (Nat.le_succ rem))
            · obtain ⟨hrej1, hrej2⟩ := not_or.mp hrej
              have hm_f : (mode == some true) = false := Bool.eq_false_iff.mpr hrej1
              have hbg : (!decide (qep + 1 < c.1.1) && inStage2BucketGen 4 tL par c.1.1) = true :=
                Bool.not_eq_false _ |>.mp hrej2
              have hcap : (!decide (qep + 1 < c.1.1)) = true := (Bool.and_eq_true _ _).mp hbg |>.1
              have hgen : inStage2BucketGen 4 tL par c.1.1 = true := (Bool.and_eq_true _ _).mp hbg |>.2
              let kk := (dhScheme Dh).receive (esLoc.g.st P).γ tn0
              have hkk_eq : (dhScheme Dh).receive (esM.g.st P).γ tn0 = kk := by
                dsimp only [kk]; rw [← hinv.vp_γ_eq P]
              by_cases hmem : kk.2 ∈ esM.h.sessions c.1.1
              · let j := (esM.h.sessions c.1.1).idxOf kk.2
                let sIdx := q * (c.1.1 - healEpoch tL) + j
                have hlk_loc : (esLoc.h.fTable c.1.1).lookup kk.2 = some (ks sIdx) := by
                  simpa [hmem, sIdx, j] using hinv.fTable_loc_eq c.1.1 kk.2
                have hlk_M_some : ((esM.h.fTable c.1.1).lookup kk.2).isSome = true := by
                  simpa [hmem] using hinv.fTable_M_iff c.1.1 kk.2
                obtain ⟨kHit, hlk_M⟩ := Option.isSome_iff_exists.mp hlk_M_some
                have hmemM : ((dhScheme Dh).receive (esM.g.st P).γ tn0).2 ∈ esM.h.sessions c.1.1 := by
                  rwa [hkk_eq]
                have hlk_M' : (esM.h.fTable c.1.1).lookup ((dhScheme Dh).receive (esM.g.st P).γ tn0).2 = some kHit := by
                  rwa [hkk_eq]
                have hj_lt : j < (esM.h.sessions c.1.1).length := List.idxOf_lt_length_of_mem hmem
                have hj_q : j < q := by have := hinv.sess_pos_bound c.1.1 ht1; omega
                have hrs_eq : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver (ks sIdx) =
                    rsLoc sIdx :=
                  (hinv.rs_fresh c.1.1 j ht1 (healEpoch_le_of_gen4 hgen) hj_q hep_recv_lt).symm
                rw [step1_inject_aux_sim_startRecv_loc_forged_phase1_hit _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
                      hfLoc hm_f hcap hgen hpl0 hlk_loc,
                    step1_inject_aux_sim_startRecv_multi_forged_phase1_hit _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
                      hfM hm_f hcap hgen hplM0 hmemM hlk_M',
                    step1_inject_aux_sim_startRecv_multi_forged_phase1_hit _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
                      hfM hm_f hcap hgen hplM0 hmemM hlk_M']
                simp only [pure_bind, hkk_eq]
                refine step1_inject_aux_afterS1_inr mode C Dh hD encPt encT idOf ℓ q qep rem (rem + 1)
                  hℓ (Nat.le_succ rem) tL par ks P c r hIH1 ssLoc rsLoc esLoc esM esLoc esM tblM tblL
                  hinv hinv hcap hgen sIdx _ _ ?_ ?_
                · simp [hrs_eq, sIdx, j]
                · simp [sIdx, j]
              · have hlk_loc : (esLoc.h.fTable c.1.1).lookup kk.2 = none := by
                  simpa [hmem] using hinv.fTable_loc_eq c.1.1 kk.2
                have hlk_M_false : ((esM.h.fTable c.1.1).lookup kk.2).isSome = false := by
                  simpa [hmem] using hinv.fTable_M_iff c.1.1 kk.2
                have hlk_M : (esM.h.fTable c.1.1).lookup kk.2 = none :=
                  Option.not_isSome_iff_eq_none.mp (by simp [hlk_M_false])
                have hnotmemM : ((dhScheme Dh).receive (esM.g.st P).γ tn0).2 ∉ esM.h.sessions c.1.1 := by
                  rwa [hkk_eq]
                have hlk_M' : (esM.h.fTable c.1.1).lookup ((dhScheme Dh).receive (esM.g.st P).γ tn0).2 = none := by
                  rwa [hkk_eq]
                have htH_le : healEpoch tL ≤ c.1.1 := healEpoch_le_of_gen4 hgen
                have hcap_le : c.1.1 ≤ qep + 1 := by
                  simp only [Bool.not_eq_true', decide_eq_false_iff_not] at hcap; omega
                have hlen_lt_q : (esLoc.h.sessions c.1.1).length < q := by
                  rw [hinv.sess_eq]; have := hinv.sess_pos_bound c.1.1 ht1; omega
                have hslt : q * (c.1.1 - healEpoch tL) + (esLoc.h.sessions c.1.1).length <
                    ((qep + 2) - healEpoch tL) * q := by
                  calc q * (c.1.1 - healEpoch tL) + (esLoc.h.sessions c.1.1).length
                      < q * (c.1.1 - healEpoch tL) + q := Nat.add_lt_add_left hlen_lt_q _
                    _ = (c.1.1 - healEpoch tL + 1) * q := by
                        rw [Nat.add_mul, Nat.one_mul, Nat.mul_comm]
                    _ ≤ ((qep + 2) - healEpoch tL) * q := Nat.mul_le_mul_right q (by omega)
                let j := (esM.h.sessions c.1.1).length
                let sIdx := q * (c.1.1 - healEpoch tL) + j
                have hj_q : j < q := by have := hinv.sess_pos_bound c.1.1 ht1; omega
                have hrs_eq : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver (ks sIdx) =
                    rsLoc sIdx :=
                  (hinv.rs_fresh c.1.1 j ht1 htH_le hj_q hep_recv_lt).symm
                have htH_f : !(tL.isSome && (c.1.1 == healEpoch tL)) = true := by
                  rw [step1_inject_aux_tH_check_false_of_gen4 hgen]; rfl
                rw [step1_inject_aux_sim_startRecv_loc_forged_phase1_miss _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
                      hfLoc hm_f hcap hgen hpl0 hlk_loc hslt,
                    step1_inject_aux_sim_startRecv_multi_forged_phase1_miss _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
                      hfM hm_f hcap hgen hplM0 hnotmemM hlk_M',
                    step1_inject_aux_sim_startRecv_multi_forged_phase1_miss _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
                      hfM hm_f hcap hgen hplM0 hnotmemM hlk_M']
                simp only [bind_assoc ($ᵗ (BitVec 256) : ProbComp (BitVec 256)), pure_bind, hkk_eq, hinv.sess_eq]
                refine leAdd_bind ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) fun kSample _ => ?_
                have hinv1 := step1_inject_aux_new_recv_sess hinv kSample
                  ht1 (by simpa using hcap) hgen htH_f hmem
                have hLoc1_eq :
                    ({ esLoc with
                      h := { esLoc.h with
                        fTable := Function.update esLoc.h.fTable c.1.1 ((kk.2, ks sIdx) :: esLoc.h.fTable c.1.1)
                        sessions := Function.update esM.h.sessions c.1.1 (esM.h.sessions c.1.1 ++ [kk.2]) } } : LocES Pt ℓ) =
                    { esLoc with
                      h := { esLoc.h with
                        fTable := Function.update esLoc.h.fTable c.1.1 ((kk.2, ks sIdx) :: esLoc.h.fTable c.1.1)
                        sessions := Function.update esLoc.h.sessions c.1.1 (esLoc.h.sessions c.1.1 ++ [kk.2]) } } := by
                  simp [hinv.sess_eq]
                rw [hLoc1_eq]
                refine step1_inject_aux_afterS1_inr mode C Dh hD encPt encT idOf ℓ q qep rem rem
                  hℓ (le_refl rem) tL par ks P c r hIH1 ssLoc rsLoc esLoc esM _ _ tblM tblL
                  hinv hinv1 hcap hgen sIdx _ _ ?_ ?_
                · simp [hrs_eq, sIdx, j]
                · simp [sIdx, j]
      · have hneLoc : c.1.1 ≠ (esLoc.g.st P).tcur + 1 := by rw [(hinv.vp_tcur_eq P).1]; exact heq
        have hneM : c.1.1 ≠ (esM.g.st P).tcur + 1 := by rw [(hinv.vp_tcur_eq P).2]; exact heq
        have hle_ep : c.1.1 ≤ esLoc.g.epoch P := by omega
        have hmax_eq : max (esLoc.g.epoch P) c.1.1 = esLoc.g.epoch P := Nat.max_eq_left hle_ep
        dsimp only [qr]
        rw [step1_inject_aux_raw_le _ _ _ _ _ _ _ hguard_f hhdrLoc_f hneLoc,
            step1_inject_aux_raw_le _ _ _ _ _ _ _ hguardM_f hhdrM_f hneM,
            step1_inject_aux_raw_le _ _ _ _ _ _ _ hguardM_f hhdrM_f hneM]
        rcases hinv.vR_sync P c.1.1 with ⟨hvL, hvM⟩ | ⟨rs, hvL, hvM⟩ |
            ⟨j, _, hcap, hgen, _, _, hvL, hvM⟩
        · rw [step1_inject_aux_afterS1_vR_none _ _ _ _ _ _ _ _ hvL,
              step1_inject_aux_afterS1_vR_none _ _ _ _ _ _ _ _ hvM,
              step1_inject_aux_afterS1_vR_none _ _ _ _ _ _ _ _ hvM]
          simp only [simulateQ_pure, StateT.run_pure, pure_bind, hinv.win_false, hwinM,
            calcWinEp, Bool.false_eq_true, ↓reduceIte]
          exact hIH1 (some .rejected) ssLoc rsLoc esLoc esM esM tblM tblL (hinv.mono_rem (Nat.le_succ rem))
        · have hvL_upd : Function.update (esLoc.g.st P).vR c.1.1 (some rs) = (esLoc.g.st P).vR := by
            funext τ; by_cases hτ : τ = c.1.1 <;> simp_all
          have hvM_upd : Function.update (esM.g.st P).vR c.1.1 (some (.inl rs)) = (esM.g.st P).vR := by
            funext τ; by_cases hτ : τ = c.1.1 <;> simp_all
          have hs1L : (esLoc.g.st P : LocVP Pt) =
              { esLoc.g.st P with
                tcur := max (esLoc.g.epoch P) c.1.1, γ := (esLoc.g.st P).γ, root := (esLoc.g.st P).root,
                vR := Function.update (esLoc.g.st P).vR c.1.1 (some rs) } := by
            rw [hmax_eq, ← (hinv.vp_tcur_eq P).1, hvL_upd]
          have hs1M : (esM.g.st P : MultiVP Pt) =
              { esM.g.st P with
                tcur := max (esLoc.g.epoch P) c.1.1, γ := (esLoc.g.st P).γ, root := (esLoc.g.st P).root,
                vR := Function.update (esM.g.st P).vR c.1.1 (some (.inl rs)) } := by
            rw [hmax_eq, ← (hinv.vp_tcur_eq P).2, hinv.vp_γ_eq P, hinv.vp_root_eq P, hvM_upd]
          have hgoal := step1_inject_aux_afterS1_inl mode C Dh encPt encT idOf ℓ q qep rem tL par ks
            P c r hIH1 ssLoc rsLoc esLoc esM tblM tblL hinv hsends_f ht_le
            (esLoc.g.st P).γ (esLoc.g.st P).root rs
          dsimp only at hgoal
          rw [← hs1L, ← hs1M] at hgoal
          exact hgoal
        · have hcap' : (!decide (qep + 1 < c.1.1)) = true := by simpa using hcap
          exact step1_inject_aux_afterS1_inr mode C Dh hD encPt encT idOf ℓ q qep rem (rem + 1)
            hℓ (Nat.le_succ rem) tL par ks P c r hIH1 ssLoc rsLoc esLoc esM esLoc esM tblM tblL
            hinv hinv hcap' hgen (q * (c.1.1 - healEpoch tL) + j)
            (esLoc.g.st P) (esM.g.st P) hvL hvM

private theorem step1_deliverForge_aux_receiverOf_sendsIn_false (t0 : ℕ) :
    (Party.receiverOf t0).sendsIn t0 = false := by
  unfold Party.receiverOf Party.senderOf Party.sendsIn Party.other
  by_cases h : t0 % 2 = 1 <;> simp [h]

private theorem step1_deliverForge_aux_accept_inl {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep rem : ℕ} {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ}
    {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (P : Party) (t0 i' : ℕ) (rs' : RatchetReceiverState (BitVec 256) (BitVec 256))
    (hP_recv : P = Party.receiverOf t0)
    (ht0_q : t0 + rem ≤ q)
    (htriv : esLoc.g.trivial 3 ⟨P.other, t0, i'⟩ = true)
    (vpLoc' : LocVP Pt) (vpM' : MultiVP Pt)
    (hid : vpLoc'.id = (esLoc.g.st P).id ∧ vpM'.id = (esM.g.st P).id)
    (htcur : vpLoc'.tcur = max (esLoc.g.epoch P) t0 ∧ vpM'.tcur = max (esM.g.epoch P) t0)
    (hγ : vpLoc'.γ = vpM'.γ)
    (hroot : vpLoc'.root = vpM'.root)
    (hcka : vpLoc'.curCkaMsg = (esLoc.g.st P).curCkaMsg ∧ vpM'.curCkaMsg = (esM.g.st P).curCkaMsg)
    (hvS : vpLoc'.vS = (esLoc.g.st P).vS ∧ vpM'.vS = (esM.g.st P).vS)
    (hvR_eq : vpLoc'.vR t0 = some rs' ∧ vpM'.vR t0 = some (.inl rs'))
    (hvR_ne : ∀ t_r, t_r ≠ t0 → vpLoc'.vR t_r = (esLoc.g.st P).vR t_r ∧ vpM'.vR t_r = (esM.g.st P).vR t_r) :
    let pos : Pos := ⟨P.other, t0, i'⟩
    let esLoc' : LocES Pt ℓ := { esLoc with g := esLoc.g.accept P vpLoc' pos }
    let esM' : MultiES Pt ℓ := { esM with g := esM.g.accept P vpM' pos }
    BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc rsLoc esLoc' esM' esM' tblM tblL := by
  intro pos esLoc' esM'
  have hinv0 := hinv.mono_rem (Nat.le_succ rem)
  rcases hinv.phase1_props rfl with ⟨hpl0, _, hscorr0⟩
  have hep_le : ∀ Q, esLoc.g.epoch Q ≤ esLoc'.g.epoch Q := by
    intro Q
    simp only [esLoc', GameState.accept, GameState.delete]
    by_cases hQ : Q = P
    · subst hQ; simp
    · simp [Function.update_of_ne hQ]
  have hp_nsend : P.sendsIn t0 = false := by
    rw [hP_recv]; exact step1_deliverForge_aux_receiverOf_sendsIn_false t0
  refine
    { gsync := hinv.gsync.accept_sync P vpLoc' vpM' pos
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := hinv.win_false
      lfWin_M := hinv.lfWin_M
      comp_unhealed :=
        Computational.Proofs.SessionCostedFig8.BucketFSAuthBridgeForgedAux.compUnhealed_accept
          hinv.comp_unhealed
      tL_mem_leaks := hinv.tL_mem_leaks
      phase1_props := fun _ => ⟨hpl0, rfl, hscorr0⟩
      phase2_props := fun h => by cases h
      sess_eq := hinv.sess_eq
      sess_nodup := hinv.sess_nodup
      sess_zero_le := hinv.sess_zero_le
      sess_pos_bound := hinv0.sess_pos_bound
      sess_epoch_ok := hinv.sess_epoch_ok
      fTable_M_iff := hinv.fTable_M_iff
      fTable_loc_eq := hinv.fTable_loc_eq
      cache_sync := hinv.cache_sync
      vp_id := fun Q => by
        simp only [esLoc', esM', GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst hQ; simp [hid.1, hid.2, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
        · simp [Function.update_of_ne hQ, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
      vp_tcur_eq := fun Q => by
        simp only [pos, esLoc', esM', GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst hQ
          have heqM : esM.g.epoch Q = esLoc.g.epoch Q := (congrFun hinv.gsync.epoch_eq Q).symm
          simp [htcur.1, htcur.2, heqM]
        · simp [Function.update_of_ne hQ, (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
      vp_γ_eq := fun Q => by
        simp only [esLoc', esM', GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst hQ; simp [hγ]
        · simp [Function.update_of_ne hQ, hinv.vp_γ_eq Q]
      vp_root_eq := fun Q => by
        simp only [esLoc', esM', GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst hQ; simp [hroot]
        · simp [Function.update_of_ne hQ, hinv.vp_root_eq Q]
      vp_cka_eq := fun Q => by
        simp only [esLoc', esM', GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst hQ; simp [hcka.1, hcka.2, hinv.vp_cka_eq Q]
        · simp [Function.update_of_ne hQ, hinv.vp_cka_eq Q]
      vp_cka_cache := fun Q hsend => by
        simp only [pos, esLoc', esM', GameState.accept, GameState.delete] at hsend ⊢
        by_cases hQ : Q = P
        · subst hQ
          simp only [Function.update_self] at hsend ⊢
          by_cases hle : t0 ≤ esLoc.g.epoch Q
          · have hmax : max (esLoc.g.epoch Q) t0 = esLoc.g.epoch Q := Nat.max_eq_left hle
            rw [hmax] at hsend ⊢
            rw [hcka.1, hvS.2]
            exact hinv.vp_cka_cache Q hsend
          · have hmax : max (esLoc.g.epoch Q) t0 = t0 := Nat.max_eq_right (by omega)
            rw [hmax, hp_nsend] at hsend
            cases hsend
        · simp only [Function.update_of_ne hQ] at hsend ⊢
          exact hinv.vp_cka_cache Q hsend
      epoch_bound := fun Q => by
        simp only [pos, esLoc', GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst hQ
          simp only [Function.update_self]
          have h1 := hinv0.epoch_bound Q
          omega
        · simp only [Function.update_of_ne hQ]
          exact hinv0.epoch_bound Q
      vS_sync := fun Q => by
        dsimp only [pos, esLoc', esM', GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst hQ
          rw [Function.update_self, Function.update_self, Function.update_self, hvS.1, hvS.2]
          rcases hinv.vS_sync Q with h1 | h2 | ⟨t_s, j, hts_le, hts_send, hrest⟩
          · exact Or.inl h1
          · exact Or.inr (Or.inl h2)
          · refine Or.inr (Or.inr ⟨t_s, j, le_trans hts_le (le_max_left _ _), ?_, hrest⟩)
            intro hsend
            by_cases hle : t0 ≤ esLoc.g.epoch Q
            · rw [Nat.max_eq_left hle] at hsend ⊢
              exact hts_send hsend
            · rw [Nat.max_eq_right (by omega), hp_nsend] at hsend
              cases hsend
        · rw [Function.update_of_ne hQ, Function.update_of_ne hQ, Function.update_of_ne hQ]
          exact hinv.vS_sync Q
      vR_dom := fun Q t_r hsome => by
        simp only [pos, esLoc', esM', GameState.accept, GameState.delete] at hsome ⊢
        by_cases hQ : Q = P
        · subst hQ
          simp only [Function.update_self] at hsome ⊢
          by_cases htr : t_r = t0
          · subst htr
            exact ⟨le_max_right _ _, hP_recv⟩
          · rw [(hvR_ne t_r htr).2] at hsome
            rcases hinv.vR_dom Q t_r hsome with ⟨hle, hrec⟩
            exact ⟨le_trans hle (le_max_left _ _), hrec⟩
        · simp only [Function.update_of_ne hQ] at hsome ⊢
          exact hinv.vR_dom Q t_r hsome
      vR_sync := fun Q t_r => by
        dsimp only [pos, esLoc', esM', GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst hQ
          rw [Function.update_self, Function.update_self]
          by_cases htr : t_r = t0
          · subst htr
            exact Or.inr (Or.inl ⟨rs', hvR_eq.1, hvR_eq.2⟩)
          · rw [(hvR_ne t_r htr).1, (hvR_ne t_r htr).2]
            exact hinv.vR_sync Q t_r
        · rw [Function.update_of_ne hQ, Function.update_of_ne hQ]
          exact hinv.vR_sync Q t_r
      sess_inv := hinv.sess_inv
      ss_fresh := fun t_x j h1 h2 h3 hlt =>
        hinv.ss_fresh t_x j h1 h2 h3 (lt_of_le_of_lt (hep_le _) hlt)
      rs_fresh := fun t_x j h1 h2 h3 hlt =>
        hinv.rs_fresh t_x j h1 h2 h3 (lt_of_le_of_lt (hep_le _) hlt)
      book_fresh_before_send := fun t_x j h1 h2 h3 hlt hh =>
        hinv.book_fresh_before_send t_x j h1 h2 h3 (lt_of_le_of_lt (hep_le _) hlt) hh
      trans_meta := fun r hr => by
        simp only [esLoc', GameState.accept, GameState.delete, List.mem_filter] at hr
        rcases hinv.trans_meta r hr.1 with ⟨h1, h2, h3, h4, h5⟩
        exact ⟨h1, h2, le_trans h3 (hep_le _), h4, h5⟩
      cache_empty_gt := fun t_x hlt =>
        hinv.cache_empty_gt t_x (lt_of_le_of_lt (hep_le _) hlt)
      healed_sender_pin := fun Q t_s j hsend ht_eq hvS_in hh => by
        simp only [pos, esLoc', esM', GameState.accept, GameState.delete] at hsend ht_eq hvS_in hh ⊢
        by_cases hQ : Q = P
        · subst hQ
          simp only [Function.update_self] at hsend ht_eq hvS_in ⊢
          by_cases hle : t0 ≤ esLoc.g.epoch Q
          · rw [Nat.max_eq_left hle] at hsend ht_eq
            rw [hvS.2] at hvS_in
            rw [hcka.2]
            exact hinv.healed_sender_pin Q t_s j hsend ht_eq hvS_in hh
          · rw [Nat.max_eq_right (by omega), hp_nsend] at hsend
            cases hsend
        · simp only [Function.update_of_ne hQ] at hsend ht_eq hvS_in ⊢
          exact hinv.healed_sender_pin Q t_s j hsend ht_eq hvS_in hh
      healed_vR_pin := fun Q t_r sIdx hvR_in hh => by
        simp only [esLoc', esM', GameState.accept, GameState.delete] at hvR_in hh
        by_cases hQ : Q = P
        · subst hQ
          simp only [Function.update_self] at hvR_in
          by_cases htr : t_r = t0
          · subst htr; rw [hvR_eq.2] at hvR_in; cases hvR_in
          · rw [(hvR_ne t_r htr).2] at hvR_in
            exact hinv.healed_vR_pin Q t_r sIdx hvR_in hh
        · simp only [Function.update_of_ne hQ] at hvR_in
          exact hinv.healed_vR_pin Q t_r sIdx hvR_in hh
      healed_book_trans := fun t_b sIdx hh hro hpin => by
        have hh0 : healedBy esLoc.g.tL 3 t_b = true := hh
        have htb_ne : t_b ≠ t0 := by
          intro heq
          subst heq
          have hf : esLoc.g.trivial 3 pos = false :=
            Computational.Proofs.SessionCostedFig8.BucketFSAuthBridgeForgedAux.trivial_eq_false_of_healed
              hinv.comp_unhealed hh0
          rw [hf] at htriv
          cases htriv
        have hro0 : esLoc.g.epoch (Party.receiverOf t_b) < t_b ∨
            (esM.g.st (Party.receiverOf t_b)).vR t_b = some (.inr sIdx) := by
          rcases hro with hlt | hvR
          · exact Or.inl (lt_of_le_of_lt (hep_le _) hlt)
          · refine Or.inr ?_
            by_cases hQ : Party.receiverOf t_b = P
            · rw [hQ] at hvR ⊢
              simp only [esM', GameState.accept, GameState.delete, Function.update_self] at hvR
              rwa [(hvR_ne t_b htb_ne).2] at hvR
            · simpa [esM', GameState.accept, GameState.delete, Function.update_of_ne hQ] using hvR
        have hfilt :
            (esLoc'.g.trans.filter fun r => r.pos.epoch == t_b) =
              esLoc.g.trans.filter fun r => r.pos.epoch == t_b := by
          simp only [esLoc', GameState.accept, GameState.delete, List.filter_filter]
          apply List.filter_congr
          intro r _
          by_cases he : (r.pos.epoch == t_b) = true
          · have he' : r.pos.epoch = t_b := of_decide_eq_true he
            have hne_pos : r.pos ≠ pos := by
              intro hp; apply htb_ne; rw [← he', hp]
            have hne_b : (r.pos != pos) = true := by simp [hne_pos]
            simp [he, hne_b]
          · simp only [Bool.not_eq_true] at he
            simp [he]
        rw [hfilt]
        exact hinv.healed_book_trans t_b sIdx hh0 hro0 hpin }

private theorem step1_deliverForge_aux_startRecv_loc_honest
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256)) (RatchetReceiverState (BitVec 256) (BitVec 256))
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 : ℕ) (γ0 : CryptoGames.CKA.DDH.State (BitVec 256) Pt)
    (σ0 : BitVec 256) (Tc : Pt) (hLoc : LocHS Pt) (σc kVal : BitVec 256)
    (hc : hLoc.cache t0 = some (Tc, σc, kVal)) :
    ((hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks).startRecv ctx P t0 γ0 σ0 Tc).run hLoc =
      pure (some (some (((dhScheme Dh).receive γ0 Tc).1, σc,
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver kVal)), hLoc) := by
  dsimp only [hkLocOpt, hooksSlotBucketOptAt]
  simp [hc]

private theorem step1_deliverForge_aux_startRecv_multi_honest
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 : ℕ) (γ0 : CryptoGames.CKA.DDH.State (BitVec 256) Pt)
    (σ0 : BitVec 256) (Tc : Pt) (hM : MultiHS Pt) (σc kMulti : BitVec 256) (optIdx : Option ℕ)
    (hc : hM.cache t0 = some (Tc, σc, kMulti, optIdx)) :
    ((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la).startRecv ctx P t0 γ0 σ0 Tc).run hM =
      pure (some (some (((dhScheme Dh).receive γ0 Tc).1, σc,
        match optIdx with
        | none => .inl ((lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver kMulti)
        | some sIdx => .inr sIdx)), hM) := by
  rw [hkMultiOpt_startRecv]
  by_cases hm : (mode == some true) = true
  · cases optIdx <;> simp [hm, hooksFSMultiDFBucketPaperMode, hc]
  · cases optIdx <;> simp [hm, hooksFSMultiDFBucketPaper, hc]

private theorem step1_deliverForge_aux_matched_none {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep rem : ℕ} {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ}
    {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (P : Party) (c' : Fig8C Pt) (sIdx : ℕ)
    (hP_sender : P.other = Party.senderOf c'.1.1)
    (hinT_none : esLoc.g.inTransit P.other c' = none)
    (hhealed : healedBy esLoc.g.tL 3 c'.1.1 = true)
    (hro : esLoc.g.epoch (Party.receiverOf c'.1.1) < c'.1.1 ∨
      (esM.g.st (Party.receiverOf c'.1.1)).vR c'.1.1 = some (.inr sIdx))
    (hpin : (c'.1.1 = 0 ∧ sIdx = 0 ∧ inStage2BucketGen 4 tL par 0 = true ∧ tL = none) ∨
      (1 ≤ c'.1.1 ∧ ∃ Tc σc kMulti, esM.h.cache c'.1.1 = some (Tc, σc, kMulti, some sIdx))) :
    ((esM.h.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == c') = none := by
  rw [hinv.healed_book_trans c'.1.1 sIdx hhealed hro hpin,
    find_filter_map_trans esLoc.g.trans P c' hP_sender
      (fun r hr => ⟨(hinv.trans_meta r hr).1.symm, (hinv.trans_meta r hr).2.1⟩)]
  change (esLoc.g.inTransit P.other c').map _ = none
  rw [hinT_none]
  rfl

private theorem step1_deliverForge_aux_inv_sess_reject {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep rem : ℕ} {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM : MultiES Pt ℓ}
    {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL)
    (sIdx : ℕ) (sM' sL' : SessHSt Pt ℓ)
    (hinv_s' : ActiveSessInv C ℓ encT idOf true (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
      ((esM.h.book sIdx).getD {}) sM' sL') :
    BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc rsLoc esLoc esM esM
      (Function.update tblM sIdx sM') (Function.update tblL sIdx sL') := by
  have hinv0 := hinv.mono_rem (Nat.le_succ rem)
  rcases hinv.phase1_props rfl with ⟨_, _, hscorr0⟩
  exact
    { hinv0 with
      sess_inv := fun k => by
        by_cases hk : k = sIdx
        · subst hk
          rw [Function.update_self, Function.update_self, hscorr0 k]
          exact hinv_s'
        · rw [Function.update_of_ne hk, Function.update_of_ne hk]
          exact hinv0.sess_inv k }

private def step1_deliverForge_aux_postVRecv
    {T M E Γv Sv SSv RSv HS : Type} [DecidableEq T] [DecidableEq M] [DecidableEq E]
    (qep : ℕ) (cfg : Config M) (P : Party) (epRec : ℕ)
    (es : EState (VP Γv T Sv SSv RSv) M (Header T × E) HS)
    (p : Option (Option (VP Γv T Sv SSv RSv × ℕ × ℕ × M)) × HS) :
    Option (RecvResult M) × EState (VP Γv T Sv SSv RSv) M (Header T × E) HS :=
  match p.1 with
  | none => (none, { es with h := p.2, abort := true })
  | some none => (some .rejected, { es with h := p.2 })
  | some (some (st', t', i', m')) =>
    if decide (qep + 1 < t') || (t' != epRec) then
      (some .rejected, { es with h := p.2 })
    else
      let pos : Pos := ⟨P.other, t', i'⟩
      if es.g.trivial 3 pos then
        (some (.accepted t' i' (some m')), { es with g := es.g.accept P st' pos, h := p.2 })
      else if cfg.injectFull t' then
        (some .rejected, { es with g := { es.g with win := true }, h := p.2 })
      else
        (some .rejected, { es with h := p.2 })

private theorem step1_deliverForge_aux_raw_after_guards
    {ι : Type} {tspec : OracleSpec.{0, 0} ι}
    {Γ CCoins T Sig SS RS M E HS Γv Sv SSv RSv : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hk : _root_.CryptoGames.SM.Engine.Hooks tspec HS Γ T Sig SS RS M E CCoins Γv Sv SSv RSv)
    (qep maxSkip : ℕ) (cfg : Config M)
    (hcommit : hk.commit = fun _ _ _ new => pure (some new))
    (P : Party) (c c' : Header T × E)
    (es : EState (VP Γv T Sv SSv RSv) M (Header T × E) HS)
    (r_rec : Record M (Header T × E))
    (habort : es.abort = false) (hwin : es.g.win = false)
    (hinT : es.g.inTransit P.other c = some r_rec)
    (hg2 : ((es.g.inTransit P.other c').isSome || es.g.comp.contains r_rec.pos || (c.1 != c'.1)) = false) :
    ((implEDFPaperBucketRaw hk 3 qep maxSkip cfg) (.inr (.inr ⟨P, c, c'⟩))).run es =
      ((_root_.CryptoGames.SM.Engine.vRecv hk es.g P (es.g.st P) c' none).run es.h >>= fun p =>
        pure (step1_deliverForge_aux_postVRecv qep cfg P r_rec.pos.epoch es p)) := by
  change (_root_.CryptoGames.SM.Construction.DeliverForge.deliverForgeE hk 3 qep cfg ⟨P, c, c'⟩).run es = _
  unfold _root_.CryptoGames.SM.Construction.DeliverForge.deliverForgeE
  simp only [StateT.run_bind, StateT.run_get, pure_bind, habort, hwin, Bool.or_self,
    Bool.false_eq_true, ↓reduceIte, hinT, hg2, run_liftH_eq, bind_assoc]
  congr 1; funext ⟨o, h'⟩
  rcases o with _ | (_ | ⟨st', t', i', m'⟩)
  · simp [step1_deliverForge_aux_postVRecv, _root_.CryptoGames.SM.Engine.abortE,
      StateT.run_modify]
  · simp [step1_deliverForge_aux_postVRecv, StateT.run_pure, habort]
  · dsimp only [step1_deliverForge_aux_postVRecv]
    by_cases hgt : (decide (qep + 1 < t') || (t' != r_rec.pos.epoch)) = true
    · simp only [Bool.or_eq_true, decide_eq_true_eq] at hgt
      rcases hgt with h1 | h2
      · simp [h1, StateT.run_pure, habort]
      · by_cases h1 : qep + 1 < t'
        · simp [h1, StateT.run_pure, habort]
        · simp [h1, h2, StateT.run_pure, habort]
    · simp only [Bool.not_eq_true] at hgt
      have h1 : ¬ (qep + 1 < t') := by
        intro hc1; rw [decide_eq_true hc1, Bool.true_or] at hgt; cases hgt
      have h2 : (t' != r_rec.pos.epoch) = false := by
        cases hb : (t' != r_rec.pos.epoch)
        · rfl
        · rw [hb, Bool.or_true] at hgt; cases hgt
      simp only [h1, decide_false, h2, Bool.false_or, Bool.false_eq_true, ↓reduceIte]
      by_cases htr : es.g.trivial 3 ⟨P.other, t', i'⟩ = true
      · simp [htr, _root_.CryptoGames.SM.Engine.commitE, hcommit,
          StateT.run_bind, StateT.run_pure, StateT.run_modify, habort]
      · simp only [Bool.not_eq_true] at htr
        by_cases hinj : cfg.injectFull t' = true
        · simp [htr, hinj, StateT.run_modify, habort]
        · simp only [Bool.not_eq_true] at hinj
          simp [htr, hinj, StateT.run_pure, habort]

private def step1_deliverForge_aux_vRecvTail
    {ι : Type} {tspec : OracleSpec.{0, 0} ι}
    {Γ T Sig SS RS M E CCoins Γv Sv SSv RSv HS : Type}
    (hk : _root_.CryptoGames.SM.Engine.Hooks tspec HS Γ T Sig SS RS M E CCoins Γv Sv SSv RSv)
    (ctx : _root_.CryptoGames.SM.Engine.Ctx Γv T Sv SSv RSv M E)
    (P : Party) (s₁ : VP Γv T Sv SSv RSv) (c : Header T × E) :
    _root_.CryptoGames.SM.Engine.HM tspec HS
      (Option (Option (VP Γv T Sv SSv RSv × ℕ × ℕ × M))) :=
  let t := c.1.1
  match s₁.vR t with
  | none => pure (some none)
  | some v => do
    match ← hk.fsRecv ctx P t v c.1 c.2 none with
    | none => pure none
    | some none => pure (some none)
    | some (some (v', i, m)) =>
      pure (some (some ({ s₁ with vR := Function.update s₁.vR t (some v') }, t, i, m)))

private theorem step1_deliverForge_aux_vRecv_eq_tail_same
    {ι : Type} {tspec : OracleSpec.{0, 0} ι}
    {Γ T Sig SS RS M E CCoins Γv Sv SSv RSv HS : Type}
    (hk : _root_.CryptoGames.SM.Engine.Hooks tspec HS Γ T Sig SS RS M E CCoins Γv Sv SSv RSv)
    (ctx : _root_.CryptoGames.SM.Engine.Ctx Γv T Sv SSv RSv M E)
    (P : Party) (s : VP Γv T Sv SSv RSv) (c : Header T × E) (h0 : HS)
    (hsends : s.id.sendsIn c.1.1 = false) (hnlt : ¬ (s.tcur + 1 < c.1.1))
    (hne : c.1.1 ≠ s.tcur + 1) :
    (_root_.CryptoGames.SM.Engine.vRecv hk ctx P s c none).run h0 =
      (step1_deliverForge_aux_vRecvTail hk ctx P s c).run h0 := by
  unfold _root_.CryptoGames.SM.Engine.vRecv step1_deliverForge_aux_vRecvTail
  simp only [hsends, hnlt, decide_false, Bool.or_self, Bool.false_eq_true, ↓reduceIte, hne, pure_bind]
  cases s.vR c.1.1 with
  | none => rfl
  | some v => simp only [StateT.run_bind]; congr 1

private theorem step1_deliverForge_aux_vRecv_eq_tail_next
    {ι : Type} {tspec : OracleSpec.{0, 0} ι}
    {Γ T Sig SS RS M E CCoins Γv Sv SSv RSv HS : Type}
    (hk : _root_.CryptoGames.SM.Engine.Hooks tspec HS Γ T Sig SS RS M E CCoins Γv Sv SSv RSv)
    (ctx : _root_.CryptoGames.SM.Engine.Ctx Γv T Sv SSv RSv M E)
    (P : Party) (s : VP Γv T Sv SSv RSv) (c : Header T × E) (h0 : HS)
    (Tc : T) (γ' : Γv) (σ' : Sv) (rs : RSv)
    (hsends : s.id.sendsIn c.1.1 = false) (hnlt : ¬ (s.tcur + 1 < c.1.1))
    (heq : c.1.1 = s.tcur + 1) (hc2 : c.1.2 = some Tc)
    (hsr : (hk.startRecv ctx P c.1.1 s.γ s.root Tc).run h0 = pure (some (some (γ', σ', rs)), h0)) :
    (_root_.CryptoGames.SM.Engine.vRecv hk ctx P s c none).run h0 =
      (step1_deliverForge_aux_vRecvTail hk ctx P
        { s with tcur := c.1.1, γ := γ', root := σ',
                 vR := Function.update s.vR c.1.1 (some rs) } c).run h0 := by
  unfold _root_.CryptoGames.SM.Engine.vRecv step1_deliverForge_aux_vRecvTail
  dsimp only []
  rw [hsends, decide_eq_false hnlt]
  simp only [Bool.or_self, Bool.false_eq_true, ↓reduceIte, heq, hc2]
  simp only [← heq, StateT.run_bind, hsr, pure_bind, Function.update_self]
  congr 1

private theorem step1_deliverForge_aux_vRecv_s1
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM : MultiES Pt ℓ}
    {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL)
    (P : Party) (c' : Fig8C Pt)
    (hP_recv : P = Party.receiverOf c'.1.1)
    (hnlt : ¬ (esLoc.g.epoch P + 1 < c'.1.1))
    (hcache_pos : 1 ≤ c'.1.1 → ∃ Tc, c'.1 = (c'.1.1, some Tc) ∧
      ∃ σc kMulti optIdx, esM.h.cache c'.1.1 = some (Tc, σc, kMulti, optIdx)) :
    ∃ (s₁Loc : LocVP Pt) (s₁M : MultiVP Pt),
      (_root_.CryptoGames.SM.Engine.vRecv (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        esLoc.g P (esLoc.g.st P) c' none).run esLoc.h =
        (step1_deliverForge_aux_vRecvTail (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
          esLoc.g P s₁Loc c').run esLoc.h ∧
      (∀ la, (_root_.CryptoGames.SM.Engine.vRecv (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la)
        esM.g P (esM.g.st P) c' none).run esM.h =
        (step1_deliverForge_aux_vRecvTail (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la)
          esM.g P s₁M c').run esM.h) ∧
      (s₁Loc.id = (esLoc.g.st P).id ∧ s₁M.id = (esM.g.st P).id) ∧
      (s₁Loc.tcur = max (esLoc.g.epoch P) c'.1.1 ∧ s₁M.tcur = max (esM.g.epoch P) c'.1.1) ∧
      s₁Loc.γ = s₁M.γ ∧
      s₁Loc.root = s₁M.root ∧
      (s₁Loc.curCkaMsg = (esLoc.g.st P).curCkaMsg ∧ s₁M.curCkaMsg = (esM.g.st P).curCkaMsg) ∧
      (s₁Loc.vS = (esLoc.g.st P).vS ∧ s₁M.vS = (esM.g.st P).vS) ∧
      (∀ t_r, t_r ≠ c'.1.1 → s₁Loc.vR t_r = (esLoc.g.st P).vR t_r ∧ s₁M.vR t_r = (esM.g.st P).vR t_r) ∧
      ((s₁Loc.vR c'.1.1 = none ∧ s₁M.vR c'.1.1 = none) ∨
       (∃ rs, s₁Loc.vR c'.1.1 = some rs ∧ s₁M.vR c'.1.1 = some (.inl rs)) ∨
       (∃ sIdx, s₁Loc.vR c'.1.1 = some (rsLoc sIdx) ∧ s₁M.vR c'.1.1 = some (.inr sIdx) ∧
         !(qep + 1 < c'.1.1) = true ∧ inStage2BucketGen 4 tL par c'.1.1 = true ∧
         (esLoc.g.epoch (Party.receiverOf c'.1.1) < c'.1.1 ∨
           (esM.g.st (Party.receiverOf c'.1.1)).vR c'.1.1 = some (.inr sIdx)) ∧
         ((c'.1.1 = 0 ∧ sIdx = 0 ∧ inStage2BucketGen 4 tL par 0 = true ∧ tL = none) ∨
          (1 ≤ c'.1.1 ∧ ∃ Tc σc kMulti, esM.h.cache c'.1.1 = some (Tc, σc, kMulti, some sIdx))))) := by
  let t0 := c'.1.1
  have hP_nsend : P.sendsIn t0 = false := by
    rw [hP_recv]; exact step1_deliverForge_aux_receiverOf_sendsIn_false t0
  have hidLoc : (esLoc.g.st P).id.sendsIn t0 = false := by rw [(hinv.vp_id P).1]; exact hP_nsend
  have hidM : (esM.g.st P).id.sendsIn t0 = false := by rw [(hinv.vp_id P).2]; exact hP_nsend
  have hepM_eq : esM.g.epoch P = esLoc.g.epoch P := (congrFun hinv.gsync.epoch_eq P).symm
  have htcurLoc : (esLoc.g.st P).tcur = esLoc.g.epoch P := (hinv.vp_tcur_eq P).1
  have htcurM : (esM.g.st P).tcur = esLoc.g.epoch P := (hinv.vp_tcur_eq P).2
  have hnltLoc : ¬ ((esLoc.g.st P).tcur + 1 < t0) := by rw [htcurLoc]; exact hnlt
  have hnltM : ¬ ((esM.g.st P).tcur + 1 < t0) := by rw [htcurM]; exact hnlt
  by_cases hnext : t0 = esLoc.g.epoch P + 1
  · have ht0_pos : 1 ≤ t0 := by omega
    rcases hcache_pos ht0_pos with ⟨Tc, hc1_Tc, σc0, kM0, opt0, hcM0⟩
    have hc2 : c'.1.2 = some Tc := by rw [hc1_Tc]
    have hnextLoc : c'.1.1 = (esLoc.g.st P).tcur + 1 := by rw [htcurLoc]; exact hnext
    have hnextM : c'.1.1 = (esM.g.st P).tcur + 1 := by rw [htcurM]; exact hnext
    rcases hinv.cache_sync t0 with ⟨_, hcNone⟩ | ⟨Tc', σc, kVal, _, hcLoc, hcM⟩ |
        ⟨Tc', σc, kMulti, j, _, hj_len, hno_gt, hbk, _, hcLoc, hcM⟩
    · rw [hcNone] at hcM0; cases hcM0
    · have hTc : Tc' = Tc := by rw [hcM0] at hcM; injection hcM with h; exact (Prod.mk.inj h).1.symm
      subst hTc
      let γ' := ((dhScheme Dh).receive (esLoc.g.st P).γ Tc').1
      let rs0 := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver kVal
      let s₁Loc : LocVP Pt :=
        { esLoc.g.st P with tcur := t0, γ := γ', root := σc,
                            vR := Function.update (esLoc.g.st P).vR t0 (some rs0) }
      let s₁M : MultiVP Pt :=
        { esM.g.st P with tcur := t0, γ := ((dhScheme Dh).receive (esM.g.st P).γ Tc').1, root := σc,
                          vR := Function.update (esM.g.st P).vR t0 (some (.inl rs0)) }
      refine ⟨s₁Loc, s₁M, ?_, ?_, ⟨rfl, rfl⟩, ?_, ?_, rfl, ⟨rfl, rfl⟩, ⟨rfl, rfl⟩, ?_, ?_⟩
      · exact step1_deliverForge_aux_vRecv_eq_tail_next _ _ _ _ _ _ Tc' _ _ _
          hidLoc hnltLoc hnextLoc hc2
          (step1_deliverForge_aux_startRecv_loc_honest mode C Dh encPt encT idOf ℓ q qep tL par ks
            esLoc.g P t0 (esLoc.g.st P).γ (esLoc.g.st P).root Tc' esLoc.h σc kVal hcLoc)
      · intro la
        exact step1_deliverForge_aux_vRecv_eq_tail_next _ _ _ _ _ _ Tc' _ _ _
          hidM hnltM hnextM hc2
          (step1_deliverForge_aux_startRecv_multi_honest mode C Dh encPt encT idOf ℓ q qep tL par la
            esM.g P t0 (esM.g.st P).γ (esM.g.st P).root Tc' esM.h σc kVal none hcM)
      · dsimp only [s₁Loc, s₁M]
        rw [hepM_eq]
        exact ⟨(Nat.max_eq_right (by omega)).symm, (Nat.max_eq_right (by omega)).symm⟩
      · dsimp only [s₁Loc, s₁M, γ']; rw [hinv.vp_γ_eq P]
      · intro t_r hne
        dsimp only [s₁Loc, s₁M]
        rw [Function.update_of_ne hne, Function.update_of_ne hne]
        exact ⟨rfl, rfl⟩
      · refine Or.inr (Or.inl ⟨rs0, ?_, ?_⟩) <;> simp [s₁Loc, s₁M, t0]
    · have hTc : Tc' = Tc := by rw [hcM0] at hcM; injection hcM with h; exact (Prod.mk.inj h).1.symm
      subst hTc
      let sIdx := q * (t0 - healEpoch tL) + j
      have hj_q : j < q := by
        have hsb := hinv.sess_pos_bound t0 ht0_pos
        omega
      have hep_recv_lt : esLoc.g.epoch (Party.receiverOf t0) < t0 := by
        rw [← hP_recv]; omega
      have hrs_eq : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initReceiver (ks sIdx) =
          rsLoc sIdx :=
        (hinv.rs_fresh t0 j ht0_pos (healEpoch_le_of_gen4 hbk) hj_q hep_recv_lt).symm
      let s₁Loc : LocVP Pt :=
        { esLoc.g.st P with tcur := t0, γ := ((dhScheme Dh).receive (esLoc.g.st P).γ Tc').1, root := σc,
                            vR := Function.update (esLoc.g.st P).vR t0 (some (rsLoc sIdx)) }
      let s₁M : MultiVP Pt :=
        { esM.g.st P with tcur := t0, γ := ((dhScheme Dh).receive (esM.g.st P).γ Tc').1, root := σc,
                          vR := Function.update (esM.g.st P).vR t0 (some (.inr sIdx)) }
      refine ⟨s₁Loc, s₁M, ?_, ?_, ⟨rfl, rfl⟩, ?_, ?_, rfl, ⟨rfl, rfl⟩, ⟨rfl, rfl⟩, ?_, ?_⟩
      · have hsrLoc := step1_deliverForge_aux_startRecv_loc_honest mode C Dh encPt encT idOf
          ℓ q qep tL par ks esLoc.g P t0 (esLoc.g.st P).γ (esLoc.g.st P).root Tc' esLoc.h σc (ks sIdx) hcLoc
        rw [hrs_eq] at hsrLoc
        exact step1_deliverForge_aux_vRecv_eq_tail_next _ _ _ _ _ _ Tc' _ _ _
          hidLoc hnltLoc hnextLoc hc2 hsrLoc
      · intro la
        exact step1_deliverForge_aux_vRecv_eq_tail_next _ _ _ _ _ _ Tc' _ _ _
          hidM hnltM hnextM hc2
          (step1_deliverForge_aux_startRecv_multi_honest mode C Dh encPt encT idOf ℓ q qep tL par la
            esM.g P t0 (esM.g.st P).γ (esM.g.st P).root Tc' esM.h σc kMulti (some sIdx) hcM)
      · dsimp only [s₁Loc, s₁M]
        rw [hepM_eq]
        exact ⟨(Nat.max_eq_right (by omega)).symm, (Nat.max_eq_right (by omega)).symm⟩
      · dsimp only [s₁Loc, s₁M]; rw [hinv.vp_γ_eq P]
      · intro t_r hne
        dsimp only [s₁Loc, s₁M]
        rw [Function.update_of_ne hne, Function.update_of_ne hne]
        exact ⟨rfl, rfl⟩
      · refine Or.inr (Or.inr ⟨sIdx, by simp [s₁Loc, t0], by simp [s₁M, t0], hno_gt, hbk,
          Or.inl hep_recv_lt, Or.inr ⟨ht0_pos, Tc', σc, kMulti, hcM⟩⟩)
  · have hle : t0 ≤ esLoc.g.epoch P := by omega
    have hneLoc : c'.1.1 ≠ (esLoc.g.st P).tcur + 1 := by rw [htcurLoc]; exact hnext
    have hneM : c'.1.1 ≠ (esM.g.st P).tcur + 1 := by rw [htcurM]; exact hnext
    refine ⟨esLoc.g.st P, esM.g.st P,
      step1_deliverForge_aux_vRecv_eq_tail_same _ _ _ _ _ _ hidLoc hnltLoc hneLoc,
      fun la => step1_deliverForge_aux_vRecv_eq_tail_same _ _ _ _ _ _ hidM hnltM hneM,
      ⟨rfl, rfl⟩,
      ⟨by rw [htcurLoc, Nat.max_eq_left hle], by rw [htcurM, hepM_eq, Nat.max_eq_left hle]⟩,
      hinv.vp_γ_eq P, hinv.vp_root_eq P, ⟨rfl, rfl⟩, ⟨rfl, rfl⟩,
      fun _ _ => ⟨rfl, rfl⟩, ?_⟩
    rcases hinv.vR_sync P t0 with h1 | h2 | ⟨j, _, hno_gt, hbk, _, _, hvRLoc, hvRM⟩
    · exact Or.inl h1
    · exact Or.inr (Or.inl h2)
    · have hh : healedBy esLoc.g.tL 3 t0 = true :=
        healedBy_of_inStage2BucketGen_phase1 (hinv.phase1_props rfl).1 hbk
      exact Or.inr (Or.inr ⟨q * (t0 - healEpoch tL) + j, hvRLoc, hvRM, hno_gt, hbk,
        Or.inr (hP_recv ▸ hvRM), hinv.healed_vR_pin P t0 _ hvRM hh⟩)

private theorem step1_deliverForge_aux_hdr_ct_beq_eq_decide {Pt : Type} [DecidableEq Pt]
    {inst : BEq (Header Pt × (ℕ × LibsignalCiphertextWithSalt32))}
    [@LawfulBEq (Header Pt × (ℕ × LibsignalCiphertextWithSalt32)) inst]
    (x y : Header Pt × (ℕ × LibsignalCiphertextWithSalt32)) :
    @BEq.beq _ inst x y = decide (x = y) :=
  Bool.eq_iff_iff.2 (by simp [@beq_iff_eq _ inst _])

private theorem step1_deliverForge_aux_fsRecv_inr_healed_eq
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool)
    (g : GameState (MultiVP Pt) (LibsignalMsgPublicPart × Plain ℓ)
      (Header Pt × (ℕ × LibsignalCiphertextWithSalt32)))
    (P : Party) (sIdx : ℕ) (c' : Fig8C Pt) (hM : MultiHS Pt)
    (hmatched : ((hM.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == c') = none)
    (hhealed : healedBy g.tL (2 + 1) c'.1.1 = true) :
    ((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la).fsRecv
      g P c'.1.1 (.inr sIdx) c'.1 c'.2 none).run hM =
    ((liftFSMultiDFBucket sIdx
        (_root_.CryptoGames.FSAEAD.injectQuery
          (SenderState := RatchetSenderState (BitVec 256))
          (ReceiverState := RatchetReceiverState (BitVec 256) (BitVec 256))
          (Message := LibsignalMsgPublicPart × Plain ℓ) c'.1 (c'.2.1, c'.2.2))).run hM >>= fun p =>
      match p.1 with
      | none => pure (none, p.2)
      | some .rejected => pure (some none, p.2)
      | some (.accepted i mo') =>
        if (la && !((p.2.book sIdx).getD {}).sCorr &&
            decide (((p.2.book sIdx).getD {}).fsCount < i)) = true then
          pure (none, { p.2 with lfWin := true })
        else
          let b := (p.2.book sIdx).getD {}
          let b' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
            { b with fsTrans := b.fsTrans.filter (·.1 != i) }
          let s2 : MultiHS Pt :=
            { p.2 with book := Function.update p.2.book sIdx (some b') }
          match mo' with
          | some m => pure (some (some (.inr sIdx, i, m)), s2)
          | none => pure (none, s2)) := by
  rw [hkMultiOpt_fsRecv]
  rcases c' with ⟨hdr, idx, ct⟩
  have hmatch_dec : ((hM.book sIdx).getD {}).fsTrans.find?
      (fun x => decide (x.2 = (hdr, idx, ct))) = none := by
    simpa only [step1_deliverForge_aux_hdr_ct_beq_eq_decide] using hmatched
  dsimp only [hooksFSMultiDFBucketPaper]
  simp only [step1_deliverForge_aux_hdr_ct_beq_eq_decide,
    StateT.run_bind, StateT.run_get, pure_bind,
    hmatch_dec, Option.isNone_none, Option.isSome_none, Option.map_none, Option.getD_none,
    hhealed, Bool.not_true, Bool.and_true, Bool.and_false, Bool.false_and,
    Bool.false_eq_true, ↓reduceIte]
  congr 1; funext ⟨res, s1⟩
  rcases res with _ | _ | ⟨i, _ | m⟩
  · rfl
  · rfl
  · cases la
    · simp
    · cases hsc : ((s1.book sIdx).getD {}).sCorr
      · by_cases hlt : ((s1.book sIdx).getD {}).fsCount < i <;> simp [hsc, hlt]
      · simp [hsc]
  · cases la
    · simp
    · cases hsc : ((s1.book sIdx).getD {}).sCorr
      · by_cases hlt : ((s1.book sIdx).getD {}).fsCount < i <;> simp [hsc, hlt]
      · simp [hsc]

set_option linter.unusedVariables false in
private theorem step1_deliverForge {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey)
    (hinj : Function.Injective encT) (hdum : ∀ T, encT T ≠ dummyKey)
    (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (hℓ : ℓ < 10 ^ 6) (hq_pos : 0 < q)
    (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c c' : Fig8C Pt)
    {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range (.inr ⟨P, c, c'⟩) →
      OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH1 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeAdd
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM')
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true (r u) esL' none tblL'))
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (hq_r : ∀ u, MakesAtMostQueriesDF (r u) rem)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inr ⟨P, c, c'⟩
    LeAdd
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esL none tblL) := by
  intro qr
  rcases hinv.phase1_props rfl with ⟨hpl0, hesL, hscorr0⟩
  rw [hesL]
  have hinvM : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL := by
    rwa [hesL] at hinv
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  have hinT_eq : ∀ c0, esM.g.inTransit P.other c0 = esLoc.g.inTransit P.other c0 := by
    intro c0; simp [GameState.inTransit, hinv.gsync.trans_eq]
  cases hinT_c : esLoc.g.inTransit P.other c with
  | none =>
    have hinT_cM : esM.g.inTransit P.other c = none := (hinT_eq c).trans hinT_c
    have hstepLoc : simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
        (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
