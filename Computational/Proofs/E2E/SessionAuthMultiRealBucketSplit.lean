private theorem df_halted_leOne
    {Γ CCoins T Sig SS RS M E HSLoc HSM σM : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hkLoc : _root_.CryptoGames.SM.Engine.Hooks _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
      HSLoc Γ T Sig SS RS M E CCoins Γ Sig SS RS)
    (hkM : _root_.CryptoGames.SM.Engine.Hooks
      (_root_.CryptoGames.SM.Construction.FSMultiSpec SS RS T M E) HSM
      Γ T Sig SS RS M E CCoins Γ Sig (SS ⊕ ℕ) (RS ⊕ ℕ))
    (Δ qep maxSkip : ℕ) (cfg : Config M) (gMain : Bool) (tL : Option ℕ)
    (isHonestLoc : HSLoc → Header T → Bool) (isHonestM : HSM → Header T → Bool)
    (implM : QueryImpl (unifSpec + _root_.CryptoGames.SM.Construction.FSMultiSpec SS RS T M E)
      (StateT σM ProbComp))
    (hImplM_inl : ∀ (n : ℕ) (s : σM), (implM (.inl n)).run s =
      ((liftM (OracleSpec.query (spec := unifSpec) n) : ProbComp (Fin (n + 1))) >>= fun u => pure (u, s)))
    {α : Type}
    (oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)) α)
    (esLoc : EState (VP Γ T Sig SS RS) M (Header T × E) HSLoc)
    (esM : EState (VP Γ T Sig (SS ⊕ ℕ) (RS ⊕ ℕ)) M (Header T × E) HSM)
    (winEp : Option ℕ) (sM : σM)
    (hhalt : (esLoc.abort || esLoc.g.win) = true)
    (habort : esM.abort = esLoc.abort)
    (hwin : esM.g.win = esLoc.g.win)
    (hleaks : esM.g.leaks = esLoc.g.leaks)
    (hcorrs : esM.g.corrs = esLoc.g.corrs) :
    LeOne
      (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl do
        let (_, es, we) ← (simulateQ (implEDFPaperBucketMode
          hkLoc Δ qep maxSkip cfg gMain isHonestLoc) oa).run (esLoc, winEp)
        return authOutBucket Δ tL (es, we))
      (Prod.fst <$> (simulateQ implM do
        let (_, es, we) ← (simulateQ (implEDFPaperBucketMode
          hkM Δ qep maxSkip cfg gMain isHonestM) oa).run (esM, winEp)
        return authOutBucket Δ tL (es, we)).run sM) := by
  have hhaltM : (esM.abort || esM.g.win) = true := by rw [habort, hwin]; exact hhalt
  induction oa using OracleComp.inductionOn generalizing sM with
  | pure _ =>
    simp only [simulateQ_pure, StateT.run_pure, pure_bind, map_pure, LeOne]
    have hout : authOutBucket Δ tL (esLoc, winEp) = authOutBucket Δ tL (esM, winEp) := by
      cases winEp with
      | none => rfl
      | some tWin =>
        simp only [authOutBucket, _root_.CryptoGames.SM.Engine.authOut]
        rw [habort, hwin, authLosingConditionsAvoided_congr Δ tL tWin esLoc.g esM.g
          hleaks.symm hcorrs.symm]
    rw [hout]
  | query_bind q k ih =>
    rw [simulateQ_query_bind, simulateQ_query_bind]
    dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift]
    rw [StateT.run_bind, StateT.run_bind, bind_assoc, bind_assoc,
      simulateQ_bind, simulateQ_bind, StateT.run_bind, map_bind]
    rcases q with n | qr
    · rw [implEDFPaperBucketMode_inl_run hkLoc Δ qep maxSkip cfg gMain isHonestLoc n esLoc winEp,
        implEDFPaperBucketMode_inl_run hkM Δ qep maxSkip cfg gMain isHonestM n esM winEp,
        simulateQ_query_bind, simulateQ_query_bind]
      simp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift,
        _root_.CryptoGames.SM.Construction.AuthL11.lImpl, QueryImpl.add_apply_inl,
        QueryImpl.ofLift_apply, simulateQ_pure, StateT.run_bind, StateT.run_pure, hImplM_inl,
        bind_assoc, pure_bind]
      exact leOne_bind (liftM (OracleSpec.query (spec := unifSpec) n)) fun u _ => ih u sM
    · rw [implEDFPaperBucketMode_halted_inr_run hkLoc Δ qep maxSkip cfg gMain isHonestLoc qr esLoc winEp hhalt,
        implEDFPaperBucketMode_halted_inr_run hkM Δ qep maxSkip cfg gMain isHonestM qr esM winEp hhaltM]
      simp only [simulateQ_pure, StateT.run_pure, pure_bind]
      exact ih (dfHaltedRet qr) sM

private theorem df_halted_cLoc_zero
    {Γ CCoins T Sig SS RS M E HSLoc : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hkLoc : _root_.CryptoGames.SM.Engine.Hooks _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
      HSLoc Γ T Sig SS RS M E CCoins Γ Sig SS RS)
    (Δ qep maxSkip : ℕ) (cfg : Config M) (gMain : Bool) (tL : Option ℕ)
    (isHonestLoc : HSLoc → Header T → Bool)
    {α : Type}
    (oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)) α)
    (esLoc : EState (VP Γ T Sig SS RS) M (Header T × E) HSLoc) (winEp : Option ℕ)
    (hhalt : (esLoc.abort || esLoc.g.win) = true)
    (hout : authOutBucket Δ tL (esLoc, winEp) = false) :
    𝒟[simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl do
        let (_, es, we) ← (simulateQ (implEDFPaperBucketMode
          hkLoc Δ qep maxSkip cfg gMain isHonestLoc) oa).run (esLoc, winEp)
        return authOutBucket Δ tL (es, we)] {true} = 0 := by
  apply evalDist_bool_eq_zero_of_true_not_mem
  induction oa using OracleComp.inductionOn with
  | pure _ =>
    simp [simulateQ_pure, StateT.run_pure, hout]
  | query_bind q k ih =>
    intro hsup
    rw [simulateQ_query_bind] at hsup
    dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift] at hsup
    rw [StateT.run_bind, bind_assoc, simulateQ_bind] at hsup
    rcases q with n | qr
    · rw [implEDFPaperBucketMode_inl_run hkLoc Δ qep maxSkip cfg gMain isHonestLoc n esLoc winEp,
        simulateQ_query_bind] at hsup
      simp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift,
        _root_.CryptoGames.SM.Construction.AuthL11.lImpl, QueryImpl.add_apply_inl,
        QueryImpl.ofLift_apply, simulateQ_pure, bind_assoc, pure_bind, mem_support_bind_iff] at hsup
      obtain ⟨u, _, hu⟩ := hsup
      exact ih u hu
    · rw [implEDFPaperBucketMode_halted_inr_run hkLoc Δ qep maxSkip cfg gMain isHonestLoc qr esLoc winEp hhalt] at hsup
      simp only [simulateQ_pure, pure_bind] at hsup
      exact ih (dfHaltedRet qr) hsup

private theorem df_lfWin_aborted_eq_one
    {Γ CCoins T I K Sig SS RS M E σL : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hkL : _root_.CryptoGames.SM.Engine.Hooks
      (_root_.CryptoGames.SM.Construction.FSMultiSpec SS RS T M E)
      (FSMultiDFBucketState T Sig K I E) Γ T Sig SS RS M E CCoins Γ Sig (SS ⊕ ℕ) (RS ⊕ ℕ))
    (Δ qep maxSkip : ℕ) (cfg : Config M) (gMain : Bool)
    (isHonestL : FSMultiDFBucketState T Sig K I E → Header T → Bool)
    (implL : QueryImpl (unifSpec + _root_.CryptoGames.SM.Construction.FSMultiSpec SS RS T M E)
      (StateT σL ProbComp))
    (hImplL_inl : ∀ (n : ℕ) (s : σL), (implL (.inl n)).run s =
      ((liftM (OracleSpec.query (spec := unifSpec) n) : ProbComp (Fin (n + 1))) >>= fun u => pure (u, s)))
    {α : Type}
    (oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)) α)
    (esL : EState (VP Γ T Sig (SS ⊕ ℕ) (RS ⊕ ℕ)) M (Header T × E) (FSMultiDFBucketState T Sig K I E))
    (winEpL : Option ℕ) (sL : σL) (habort : esL.abort = true) (hlf : esL.h.lfWin = true) :
    𝒟[Prod.fst <$> (simulateQ implL do
        let (_, es, _) ← (simulateQ (implEDFPaperBucketMode
          hkL Δ qep maxSkip cfg gMain isHonestL) oa).run (esL, winEpL)
        return es.h.lfWin).run sL] {true} = 1 := by
  have hhaltL : (esL.abort || esL.g.win) = true := by simp [habort]
  induction oa using OracleComp.inductionOn generalizing sL with
  | pure _ => simp [simulateQ_pure, StateT.run_pure, hlf]
  | query_bind q k ih =>
    rw [simulateQ_query_bind]
    dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift]
    rw [StateT.run_bind, bind_assoc, simulateQ_bind, StateT.run_bind, map_bind]
    rcases q with n | qr
    · rw [implEDFPaperBucketMode_inl_run hkL Δ qep maxSkip cfg gMain isHonestL n esL winEpL,
        simulateQ_query_bind]
      simp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift,
        simulateQ_pure, StateT.run_bind, StateT.run_pure, hImplL_inl, bind_assoc, pure_bind]
      rw [evalDist_bind_of_discrete, MeasureTheory.Measure.bind_apply MeasurableSet.of_discrete
        Measurable.of_discrete.aemeasurable]
      trans ∫⁻ (_ : Fin (n + 1)), (1 : ℝ≥0∞) ∂𝒟[(liftM (OracleSpec.query (spec := unifSpec) n) : ProbComp (Fin (n + 1)))]
      · exact MeasureTheory.lintegral_congr fun u => ih u sL
      · rw [MeasureTheory.lintegral_const, MeasureTheory.IsProbabilityMeasure.measure_univ, mul_one]
    · rw [implEDFPaperBucketMode_halted_inr_run hkL Δ qep maxSkip cfg gMain isHonestL qr esL winEpL hhaltL]
      simp only [simulateQ_pure, StateT.run_pure, pure_bind]
      exact ih (dfHaltedRet qr) sL

private theorem liftH_mem_support_g_eq
    {Γv T Sv SSv RSv M E HS α : Type}
    (hm : _root_.CryptoGames.SM.Engine.HM _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS α)
    (es : EState (VP Γv T Sv SSv RSv) M (Header T × E) HS)
