      (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la).startRecv ctx P t0 γ0 σ0 tn0).run hM)).run
        (fun _ => false, tbl) =
    (($ᵗ (BitVec 256) : ProbComp (BitVec 256)) >>= fun kMulti =>
      pure ((some (some (kk.1, ((rootPRNG C.F encPt).up σ0 kk.2).1, .inr sIdx)), hM' kMulti),
        (fun _ => false, tbl))) := by
  intro kk sIdx hM'
  have htH := step1_inject_aux_tH_check_false_of_gen4 hgen
  rw [hkMultiOpt_startRecv]
  rcases step1_inject_aux_honest_multi_none_of_isHonestHdr_false hf with hc | ⟨tCached, σc, kVal, optIdx, hc, hne⟩
  · simp only [hm_f, Bool.false_eq_true, ↓reduceIte, hooksFSMultiDFBucketPaper,
      StateT.run_bind, StateT.run_get, pure_bind, hc, hcap, hgen, Bool.and_self,
      htH, hpl_f, simulateQ_bind]
    rw [sim_lookupMultiDFBucketF]
    simp only [hlk, bind_assoc, pure_bind,
      regSessMultiDFBucket, Nat.add_sub_cancel, hnotmem, ↓reduceIte,
      StateT.run_set, StateT.run_pure, simulateQ_pure, sIdx, hM']
    rfl
  · simp only [hm_f, Bool.false_eq_true, ↓reduceIte, hooksFSMultiDFBucketPaper,
      StateT.run_bind, StateT.run_get, pure_bind, hc, hne, hcap, hgen, Bool.and_self,
      htH, hpl_f, simulateQ_bind]
    rw [sim_lookupMultiDFBucketF]
    simp only [hlk, bind_assoc, pure_bind,
      regSessMultiDFBucket, Nat.add_sub_cancel, hnotmem, ↓reduceIte,
      StateT.run_set, StateT.run_pure, simulateQ_pure, sIdx, hM']
    rfl

private theorem step1_inject_aux_filter_epoch_ne_delete {Pt : Type} {ℓ : ℕ}
    (trans : List (Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)))
    (pos : Pos) (t0' : ℕ) (hne : t0' ≠ pos.epoch) :
    ((trans.filter (fun r => r.pos != pos)).filter (fun r => r.pos.epoch == t0')) =
      trans.filter (fun r => r.pos.epoch == t0') := by
  rw [List.filter_filter]
  apply List.filter_congr
  intro r _
  by_cases hep : r.pos.epoch = t0'
  · have hpos_ne : r.pos ≠ pos := fun h => hne (hep.symm.trans (congrArg Pos.epoch h))
    simp [hep, hpos_ne]
  · have hb : (r.pos.epoch == t0') = false := beq_false_of_ne hep
    simp [hb]

private theorem step1_inject_aux_new_recv_sess {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep rem : ℕ} {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL)
    {t0 : ℕ} {ik : Pt} (kMulti : BitVec 256)
    (ht1 : 1 ≤ t0) (hcap : !(qep + 1 < t0) = true)
    (hgen : inStage2BucketGen 4 tL par t0 = true)
    (htH_f : !(tL.isSome && (t0 == healEpoch tL)) = true)
    (hnotmem : ik ∉ esM.h.sessions t0) :
    let sIdx := q * (t0 - healEpoch tL) + (esM.h.sessions t0).length
    let hLoc' : LocHS Pt :=
      { esLoc.h with
        fTable := Function.update esLoc.h.fTable t0 ((ik, ks sIdx) :: esLoc.h.fTable t0)
        sessions := Function.update esLoc.h.sessions t0 (esLoc.h.sessions t0 ++ [ik]) }
    let hM' : MultiHS Pt :=
      { esM.h with
        fTable := Function.update esM.h.fTable t0 ((ik, kMulti) :: esM.h.fTable t0)
        sessions := Function.update esM.h.sessions t0 (esM.h.sessions t0 ++ [ik]) }
    BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc rsLoc
      { esLoc with h := hLoc' } { esM with h := hM' } { esM with h := hM' } tblM tblL := by
  intro sIdx hLoc' hM'
  exact
    { gsync := hinv.gsync
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := hinv.win_false
      lfWin_M := hinv.lfWin_M
      comp_unhealed := hinv.comp_unhealed
      tL_mem_leaks := hinv.tL_mem_leaks
      phase1_props := fun _ => ⟨(hinv.phase1_props rfl).1, rfl, (hinv.phase1_props rfl).2.2⟩
      phase2_props := fun hp => Bool.noConfusion hp
      sess_eq := by
        funext τ
        by_cases hτ : τ = t0 <;> simp [hLoc', hM', hτ, hinv.sess_eq]
      sess_nodup := fun τ => by
        by_cases hτ : τ = t0
        · subst τ
          simp only [hM', Function.update_self]
          exact List.Nodup.append (hinv.sess_nodup t0) (List.nodup_singleton ik) (by simp [hnotmem])
        · simp [hM', hτ, hinv.sess_nodup τ]
      sess_zero_le := by
        have h0 : (0 : ℕ) ≠ t0 := by omega
        simpa [hM', Function.update_of_ne h0] using hinv.sess_zero_le
      sess_pos_bound := fun τ hτ1 => by
        by_cases hτ : τ = t0
        · subst τ
          simp only [hM', Function.update_self, List.length_append, List.length_singleton]
          have := hinv.sess_pos_bound t0 ht1
          omega
        · simp only [hM', Function.update_of_ne hτ]
          have := hinv.sess_pos_bound τ hτ1
          omega
      sess_epoch_ok := fun τ hne => by
        by_cases hτ : τ = t0
        · subst τ; exact ⟨hcap, hgen, htH_f⟩
        · simp only [hM', Function.update_of_ne hτ] at hne
          exact hinv.sess_epoch_ok τ hne
      fTable_M_iff := fun τ ik' => by
        by_cases hτ : τ = t0
        · subst τ
          simp only [hM', Function.update_self]
          exact lookup_cons_fTable_M_iff _ _ ik kMulti (hinv.fTable_M_iff t0) ik'
        · simp [hM', hτ, hinv.fTable_M_iff τ ik']
      fTable_loc_eq := fun τ ik' => by
        by_cases hτ : τ = t0
        · subst τ
          simpa [hLoc', hM', sIdx] using
            lookup_cons_fTable_loc_eq _ _ ik _ ks hnotmem (hinv.fTable_loc_eq t0) ik'
        · simp [hLoc', hM', hτ, hinv.fTable_loc_eq τ ik']
      cache_sync := fun τ => by
        rcases hinv.cache_sync τ with ⟨h1, h2⟩ | ⟨Tc, σc, kVal, ht, h1, h2⟩ |
            ⟨Tc, σc, kM0, j, ht, hj, hc1, hc2, hc3, h1, h2⟩
        · exact Or.inl ⟨h1, h2⟩
        · exact Or.inr (Or.inl ⟨Tc, σc, kVal, ht, h1, h2⟩)
        · refine Or.inr (Or.inr ⟨Tc, σc, kM0, j, ht, ?_, hc1, hc2, hc3, h1, h2⟩)
          by_cases hτ : τ = t0
          · subst hτ; simp only [hM', Function.update_self, List.length_append, List.length_singleton]; omega
          · simpa [hM', Function.update_of_ne hτ] using hj
      vp_id := hinv.vp_id
      vp_tcur_eq := hinv.vp_tcur_eq
      vp_γ_eq := hinv.vp_γ_eq
      vp_root_eq := hinv.vp_root_eq
      vp_cka_eq := hinv.vp_cka_eq
      vp_cka_cache := hinv.vp_cka_cache
      epoch_bound := fun Q => by dsimp only; have := hinv.epoch_bound Q; omega
      vS_sync := fun Q => by
        rcases hinv.vS_sync Q with h1 | h2 | ⟨τ, j, hle, hs, hp, hc1, hc2, hc3, hj, hv1, hv2⟩
        · exact Or.inl h1
        · exact Or.inr (Or.inl h2)
        · refine Or.inr (Or.inr ⟨τ, j, hle, hs, hp, hc1, hc2, hc3, ?_, hv1, hv2⟩)
          by_cases hτ : τ = t0
          · subst hτ; simp only [hM', Function.update_self, List.length_append, List.length_singleton]; omega
          · simpa [hM', Function.update_of_ne hτ] using hj
      vR_dom := hinv.vR_dom
      vR_sync := fun Q τ => by
        rcases hinv.vR_sync Q τ with h1 | h2 | ⟨j, hp, hc1, hc2, hc3, hj, hv1, hv2⟩
        · exact Or.inl h1
        · exact Or.inr (Or.inl h2)
        · refine Or.inr (Or.inr ⟨j, hp, hc1, hc2, hc3, ?_, hv1, hv2⟩)
          by_cases hτ : τ = t0
          · subst hτ; simp only [hM', Function.update_self, List.length_append, List.length_singleton]; omega
          · simpa [hM', Function.update_of_ne hτ] using hj
      sess_inv := hinv.sess_inv
      ss_fresh := hinv.ss_fresh
      rs_fresh := hinv.rs_fresh
      book_fresh_before_send := hinv.book_fresh_before_send
      trans_meta := hinv.trans_meta
      cache_empty_gt := hinv.cache_empty_gt
      healed_sender_pin := hinv.healed_sender_pin
      healed_vR_pin := hinv.healed_vR_pin
      healed_book_trans := hinv.healed_book_trans }

private theorem step1_inject_aux_accept_inl {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {q qep rem : ℕ} {tL : Option ℕ} {par phase1 : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks phase1 rem ssLoc rsLoc esLoc esM esL tblM tblL)
    {P : Party} {t0 idxOut : ℕ}
    {γ' : CryptoGames.CKA.DDH.State (BitVec 256) Pt} {σ' : BitVec 256}
    {rs' : RatchetReceiverState (BitVec 256) (BitVec 256)}
    (hsends_f : P.sendsIn t0 = false)
    (ht_le : t0 ≤ esLoc.g.epoch P + 1)
    (hep_bound_P : max (esLoc.g.epoch P) t0 + rem ≤ q)
    (hvR0_ok : t0 = 0 → inStage2BucketGen 4 tL par 0 = false)
    (hhealed_inl_ok : 1 ≤ t0 → healedBy esLoc.g.tL 3 t0 = true →
      t0 ≤ esLoc.g.epoch (Party.senderOf t0) ∧
      ∀ Tc σc kMulti sIdx', esM.h.cache t0 ≠ some (Tc, σc, kMulti, some sIdx')) :
    let pos : Pos := ⟨Party.senderOf t0, t0, idxOut⟩
    let stLoc' : LocVP Pt :=
      { esLoc.g.st P with
        tcur := max (esLoc.g.epoch P) t0, γ := γ', root := σ',
        vR := Function.update (esLoc.g.st P).vR t0 (some rs') }
    let stM' : MultiVP Pt :=
      { esM.g.st P with
        tcur := max (esLoc.g.epoch P) t0, γ := γ', root := σ',
        vR := Function.update (esM.g.st P).vR t0 (some (.inl rs')) }
    let gLoc' := esLoc.g.accept P stLoc' pos
    let gM' := esM.g.accept P stM' pos
    let esL' := if phase1 then { esM with g := gM' } else esL
    BucketSimInv C ℓ encT idOf q qep tL par ks phase1 rem ssLoc rsLoc
      { esLoc with g := gLoc' } { esM with g := gM' } esL' tblM tblL := by
  intro pos stLoc' stM' gLoc' gM' esL'
  have hP_recv : P = Party.receiverOf t0 := (not_sendsIn_iff_receiverOf P t0).mp (by simp [hsends_f])
  have hsends_max : t0 = esLoc.g.epoch P + 1 → P.sendsIn (max (esLoc.g.epoch P) t0) = false := by
    intro ht; subst ht; simpa [Nat.max_eq_right (Nat.le_succ _)] using hsends_f
  exact
    { gsync := hinv.gsync.accept_sync P stLoc' stM' pos
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := hinv.win_false
      lfWin_M := hinv.lfWin_M
      comp_unhealed := compUnhealed_accept hinv.comp_unhealed
      tL_mem_leaks := hinv.tL_mem_leaks
      phase1_props := fun hp => by
        rcases hinv.phase1_props hp with ⟨hpl, _, hsc⟩
        exact ⟨hpl, by simp [esL', hp], hsc⟩
      phase2_props := fun hp => hinv.phase2_props hp
      sess_eq := hinv.sess_eq
      sess_nodup := hinv.sess_nodup
      sess_zero_le := hinv.sess_zero_le
      sess_pos_bound := hinv.sess_pos_bound
      sess_epoch_ok := hinv.sess_epoch_ok
      fTable_M_iff := hinv.fTable_M_iff
      fTable_loc_eq := hinv.fTable_loc_eq
      cache_sync := hinv.cache_sync
      vp_id := fun Q => by
        by_cases hQ : Q = P
        · subst hQ; simp [gLoc', gM', GameState.accept, GameState.delete, stLoc', stM', (hinv.vp_id Q).1, (hinv.vp_id Q).2]
        · simp [gLoc', gM', GameState.accept, GameState.delete, hQ, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
      vp_tcur_eq := fun Q => by
        by_cases hQ : Q = P
        · subst hQ; simp [gLoc', gM', GameState.accept, GameState.delete, stLoc', stM', pos]
        · simp [gLoc', gM', GameState.accept, GameState.delete, hQ, (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
      vp_γ_eq := fun Q => by
        by_cases hQ : Q = P
        · subst hQ; simp [gLoc', gM', GameState.accept, GameState.delete, stLoc', stM']
        · simp [gLoc', gM', GameState.accept, GameState.delete, hQ, hinv.vp_γ_eq Q]
      vp_root_eq := fun Q => by
        by_cases hQ : Q = P
        · subst hQ; simp [gLoc', gM', GameState.accept, GameState.delete, stLoc', stM']
        · simp [gLoc', gM', GameState.accept, GameState.delete, hQ, hinv.vp_root_eq Q]
      vp_cka_eq := fun Q => by
        by_cases hQ : Q = P
        · subst hQ; simp [gLoc', gM', GameState.accept, GameState.delete, stLoc', stM', hinv.vp_cka_eq Q]
        · simp [gLoc', gM', GameState.accept, GameState.delete, hQ, hinv.vp_cka_eq Q]
      vp_cka_cache := fun Q hs => by
        by_cases hQ : Q = P
        · subst hQ
          simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos] at hs
          by_cases ht : t0 = esLoc.g.epoch Q + 1
          · rw [hsends_max ht] at hs; cases hs
          · have hle0 : t0 ≤ esLoc.g.epoch Q := by omega
            have hmax : max (esLoc.g.epoch Q) t0 = esLoc.g.epoch Q := Nat.max_eq_left hle0
            rw [hmax] at hs
            simpa [gLoc', gM', GameState.accept, GameState.delete, stLoc', stM', pos, hmax] using
              hinv.vp_cka_cache Q hs
        · simp only [gLoc', GameState.accept, GameState.delete, Function.update_of_ne hQ] at hs
          simpa [gLoc', gM', GameState.accept, GameState.delete, hQ] using hinv.vp_cka_cache Q hs
      epoch_bound := fun Q => by
        by_cases hQ : Q = P
        · subst hQ
          simpa [gLoc', GameState.accept, GameState.delete, pos] using hep_bound_P
        · simpa [gLoc', GameState.accept, GameState.delete, hQ] using hinv.epoch_bound Q
      vS_sync := fun Q => by
        by_cases hQ : Q = P
        · subst hQ
          rcases hinv.vS_sync Q with ⟨h1, h2⟩ | ⟨ss, h1, h2⟩ | ⟨τ, j, hle, hs, hp, hc1, hc2, hc3, hj, hv1, hv2⟩
          · exact Or.inl (by simp [gLoc', gM', GameState.accept, GameState.delete, stLoc', stM', h1, h2])
          · exact Or.inr (Or.inl ⟨ss, by simp [gLoc', gM', GameState.accept, GameState.delete, stLoc', stM', h1, h2]⟩)
          · refine Or.inr (Or.inr ⟨τ, j, ?_, ?_, hp, hc1, hc2, hc3, hj,
              by simp [gLoc', GameState.accept, GameState.delete, stLoc', hv1],
              by simp [gM', GameState.accept, GameState.delete, stM', hv2]⟩)
            · simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos]
              exact le_trans hle (Nat.le_max_left _ _)
            · intro hs'
              simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos] at hs' ⊢
              by_cases ht : t0 = esLoc.g.epoch Q + 1
              · rw [hsends_max ht] at hs'; cases hs'
              · have hmax : max (esLoc.g.epoch Q) t0 = esLoc.g.epoch Q := Nat.max_eq_left (by omega)
                rw [hmax] at hs' ⊢
                exact hs hs'
        · simpa [gLoc', gM', GameState.accept, GameState.delete, hQ] using hinv.vS_sync Q
      vR_dom := fun Q τ hv => by
        by_cases hQ : Q = P
        · subst hQ
          simp only [gM', GameState.accept, GameState.delete, Function.update_self, stM'] at hv
          by_cases hτ : τ = t0
          · subst hτ
            simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos]
            exact ⟨Nat.le_max_right _ _, hP_recv⟩
          · simp only [Function.update_of_ne hτ] at hv
            obtain ⟨hle, hrec⟩ := hinv.vR_dom Q τ hv
            simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos]
            exact ⟨le_trans hle (Nat.le_max_left _ _), hrec⟩
        · simp only [gM', GameState.accept, GameState.delete, Function.update_of_ne hQ] at hv
          simpa [gLoc', GameState.accept, GameState.delete, hQ] using hinv.vR_dom Q τ hv
      vR_sync := fun Q τ => by
        by_cases hQ : Q = P
        · subst hQ
          by_cases hτ : τ = t0
          · subst hτ
            exact Or.inr (Or.inl ⟨rs',
              by simp [gLoc', GameState.accept, GameState.delete, stLoc'],
              by simp [gM', GameState.accept, GameState.delete, stM']⟩)
          · simpa [gLoc', gM', GameState.accept, GameState.delete, stLoc', stM', hτ] using
              hinv.vR_sync Q τ
        · simpa [gLoc', gM', GameState.accept, GameState.delete, hQ] using hinv.vR_sync Q τ
      sess_inv := hinv.sess_inv
      ss_fresh := fun τ j ht1' htH' hj' hep' => by
        apply hinv.ss_fresh τ j ht1' htH' hj'
        by_cases hQ : Party.senderOf τ = P
        · rw [hQ] at hep' ⊢
          simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos] at hep'
          exact lt_of_le_of_lt (Nat.le_max_left _ _) hep'
        · simpa [gLoc', GameState.accept, GameState.delete, hQ] using hep'
      rs_fresh := fun τ j ht1' htH' hj' hep' => by
        apply hinv.rs_fresh τ j ht1' htH' hj'
        by_cases hQ : Party.receiverOf τ = P
        · rw [hQ] at hep' ⊢
          simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos] at hep'
          exact lt_of_le_of_lt (Nat.le_max_left _ _) hep'
        · simpa [gLoc', GameState.accept, GameState.delete, hQ] using hep'
      book_fresh_before_send := fun τ j ht1' htH' hj' hep' hh' => by
        apply hinv.book_fresh_before_send τ j ht1' htH' hj' _ hh'
        by_cases hQ : Party.senderOf τ = P
        · rw [hQ] at hep' ⊢
          simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos] at hep'
          exact lt_of_le_of_lt (Nat.le_max_left _ _) hep'
        · simpa [gLoc', GameState.accept, GameState.delete, hQ] using hep'
      trans_meta := fun r hr => by
        simp only [gLoc', GameState.accept, GameState.delete, List.mem_filter] at hr
        obtain ⟨hc1, hsnd, hle, h0, h1⟩ := hinv.trans_meta r hr.1
        refine ⟨hc1, hsnd, ?_, h0, h1⟩
        by_cases hQ : r.pos.sender = P
        · rw [hQ] at hle ⊢
          simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos]
          exact le_trans hle (Nat.le_max_left _ _)
        · simpa [gLoc', GameState.accept, GameState.delete, hQ] using hle
      cache_empty_gt := fun τ hep' => by
        apply hinv.cache_empty_gt τ
        by_cases hQ : Party.senderOf τ = P
        · rw [hQ] at hep' ⊢
          simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos] at hep'
          exact lt_of_le_of_lt (Nat.le_max_left _ _) hep'
        · simpa [gLoc', GameState.accept, GameState.delete, hQ] using hep'
      healed_sender_pin := fun Q τ j hs ht hv hh => by
        by_cases hQ : Q = P
        · subst hQ
          simp only [gLoc', GameState.accept, GameState.delete, Function.update_self, pos] at hs ht
          by_cases hteq : t0 = esLoc.g.epoch Q + 1
          · rw [hsends_max hteq] at hs; cases hs
          · have hmax : max (esLoc.g.epoch Q) t0 = esLoc.g.epoch Q := Nat.max_eq_left (by omega)
            rw [hmax] at hs ht
            simp only [gM', GameState.accept, GameState.delete, Function.update_self, stM'] at hv ⊢
            exact hinv.healed_sender_pin Q τ j hs ht hv hh
        · simp only [gLoc', GameState.accept, GameState.delete, Function.update_of_ne hQ] at hs ht
          simp only [gM', GameState.accept, GameState.delete, Function.update_of_ne hQ] at hv ⊢
          exact hinv.healed_sender_pin Q τ j hs ht hv hh
      healed_vR_pin := fun Q τ sIdx' hv hh => by
        by_cases hQ : Q = P
        · subst hQ
          simp only [gM', GameState.accept, GameState.delete, Function.update_self, stM'] at hv
          by_cases hτ : τ = t0
          · subst τ; simp at hv
          · simp only [Function.update_of_ne hτ] at hv
            exact hinv.healed_vR_pin Q τ sIdx' hv hh
        · simp only [gM', GameState.accept, GameState.delete, Function.update_of_ne hQ] at hv
          exact hinv.healed_vR_pin Q τ sIdx' hv hh
      healed_book_trans := fun τ sIdx' hh hro hp => by
        have hτ_ne : τ ≠ t0 := by
          intro hτ; subst hτ
          rcases hp with ⟨rfl, _, hbk0, _⟩ | ⟨ht1, Tc, σc, kMulti, hc⟩
          · rw [hvR0_ok rfl] at hbk0; cases hbk0
          · exact (hhealed_inl_ok ht1 hh).2 Tc σc kMulti sIdx' hc
        have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
            (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
          rcases hro with hlt | hvR
          · refine Or.inl (lt_of_le_of_lt ?_ hlt)
            simp only [gLoc', GameState.accept, GameState.delete]
            by_cases hQ : Party.receiverOf τ = P
            · rw [hQ]; simp
            · simp [Function.update_of_ne hQ]
          · refine Or.inr ?_
            by_cases hQ : Party.receiverOf τ = P
            · rw [hQ] at hvR ⊢
              simpa [gM', stM', GameState.accept, GameState.delete, Function.update_self,
                Function.update_of_ne hτ_ne] using hvR
            · simpa [gM', GameState.accept, GameState.delete, Function.update_of_ne hQ] using hvR
        dsimp only [gLoc', GameState.accept, GameState.delete]
        rw [step1_inject_aux_filter_epoch_ne_delete esLoc.g.trans pos τ hτ_ne]
        exact hinv.healed_book_trans τ sIdx' hh hro_orig hp }

private def step1_inject_aux_afterS1
    {ι : Type} {tspec : OracleSpec.{0, 0} ι}
    {Γ CCoins T Sig SS RS M E HS Γv Sv SSv RSv : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hk : _root_.CryptoGames.SM.Engine.Hooks tspec HS Γ T Sig SS RS M E CCoins Γv Sv SSv RSv)
    (qep _maxSkip : ℕ) (cfg : Config M)
    (P : Party) (c : Header T × E) (s₁ : VP Γv T Sv SSv RSv) :
    _root_.CryptoGames.SM.Engine.EM tspec Γv T Sv SSv RSv M E HS (Option (RecvResult M)) := do
  let es ← get
  let s := es.g
  let rv ← _root_.CryptoGames.SM.Engine.liftH (do
    match s₁.vR c.1.1 with
    | none => return some none
    | some v =>
      match ← hk.fsRecv s P c.1.1 v c.1 c.2 none with
      | none => return none
      | some none => return some none
      | some (some (v', i, m)) =>
        return some (some ({ s₁ with vR := Function.update s₁.vR c.1.1 (some v') }, c.1.1, i, m)))
  match rv with
  | none =>
    abortE
    return none
  | some none => return some .rejected
  | some (some (st', t', i', m')) =>
    if qep + 1 < t' then return some .rejected
    let pos : Pos := ⟨P.other, t', i'⟩
    if s.trivial 3 pos then
      match ← commitE hk s P (s.st P) st' pos with
      | none => return none
      | some s₁' =>
        modify fun es => { es with g := s₁' }
        return some (.accepted t' i' (some m'))
    else
      if cfg.injectFull t' then modify fun es => { es with g := { es.g with win := true } }
      return some .rejected

