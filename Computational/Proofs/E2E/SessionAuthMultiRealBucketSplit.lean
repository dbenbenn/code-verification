private inductive OffZeroBound {ι : Type} {spec : OracleSpec.{0, 0} ι} {α : Type}
    (P : spec.Domain → Bool) (post : α → Prop) : OracleComp spec α → Prop where
  | pure {a : α} (ha : post a) : OffZeroBound P post (Pure.pure a)
  | query_bind {t : spec.Domain} {k : spec.Range t → OracleComp spec α}
      (ht : P t = false) (hk : ∀ y, OffZeroBound P post (k y)) :
      OffZeroBound P post (liftM (OracleSpec.query t) >>= k)

private theorem OffZeroBound.bind {ι : Type} {spec : OracleSpec.{0, 0} ι} {α β : Type}
    {P : spec.Domain → Bool} {mid : α → Prop} {post : β → Prop}
    {mx : OracleComp spec α} {f : α → OracleComp spec β}
    (h : OffZeroBound P mid mx) (hf : ∀ a, mid a → OffZeroBound P post (f a)) :
    OffZeroBound P post (mx >>= f) := by
  induction h with
  | pure ha => rw [pure_bind]; exact hf _ ha
  | query_bind ht _ ih => rw [bind_assoc]; exact OffZeroBound.query_bind ht ih

private theorem OffZeroBound.query_false {ι : Type} {spec : OracleSpec.{0, 0} ι}
    {P : spec.Domain → Bool} {t : spec.Domain} (ht : P t = false) :
    OffZeroBound P (fun _ => True) (query (spec := spec) t) := by
  have hq : (query (spec := spec) t : OracleComp spec _) = liftM (OracleSpec.query t) >>= Pure.pure := by
    rw [show (query (spec := spec) t : OracleComp spec _) = liftM (OracleSpec.query t) from rfl, bind_pure]
  rw [hq]; exact OffZeroBound.query_bind ht fun _ => OffZeroBound.pure trivial

private theorem OffZeroBound.to_isQueryBoundP {ι : Type} {spec : OracleSpec.{0, 0} ι} {α : Type}
    {P : spec.Domain → Bool} {post : α → Prop} {oa : OracleComp spec α} (h : OffZeroBound P post oa) :
    oa.IsQueryBoundP (fun x => P x = true) 0 := by
  induction h with
  | pure _ => exact isQueryBoundP_pure _ _ 0
  | query_bind ht _ ih =>
    rw [isQueryBoundP_query_bind_iff]
    exact ⟨Or.inl (by simp [ht]), fun y => by simpa [ht] using ih y⟩

private theorem OffZeroBound.of_probComp {ι₀ : Type} {spec₀ : OracleSpec.{0, 0} ι₀} {α : Type}
    {P : (unifSpec + spec₀).Domain → Bool} (hInl : ∀ u, P (.inl u) = false) (oa : ProbComp α) :
    OffZeroBound P (fun _ => True) (liftM oa : OracleComp (unifSpec + spec₀) α) := by
  induction oa using OracleComp.inductionOn with
  | pure a => change OffZeroBound P (fun _ => True) (Pure.pure a); exact OffZeroBound.pure trivial
  | query_bind t k ih =>
    change OffZeroBound P (fun _ => True)
      ((query (spec := unifSpec + spec₀) (.inl t)) >>= fun u => (liftM (k u) : OracleComp (unifSpec + spec₀) α))
    exact (OffZeroBound.query_false (hInl t)).bind fun u _ => ih u

private theorem off_sampleT_zeroBound {ι₀ : Type} {tspec : OracleSpec.{0, 0} ι₀}
    {P : (unifSpec + tspec).Domain → Bool} (hInl : ∀ u, P (.inl u) = false)
    (α : Type) [SampleableType α] : OffZeroBound P (fun _ => True) (sampleT (tspec := tspec) α) :=
  OffZeroBound.of_probComp hInl ($ᵗ α : ProbComp α)

private theorem off_lift_sampleT_zeroBound {ι₀ : Type} {tspec : OracleSpec.{0, 0} ι₀} {HS : Type}
    (P : (unifSpec + tspec).Domain → Bool) (hInl : ∀ u, P (.inl u) = false)
    (α : Type) [SampleableType α] (Q : HS → Prop) (h : HS) (hQ : Q h) :
    OffZeroBound P (fun z => Q z.2) ((StateT.lift (sampleT (tspec := tspec) α)).run h) := by
  rw [StateT.run_lift]; exact (off_sampleT_zeroBound hInl α).bind fun _ _ => OffZeroBound.pure hQ

private theorem off_simulateQ_run_fuel {ι₁ ι₂ : Type}
    {spec₁ : OracleSpec.{0, 0} ι₁} {spec₂ : OracleSpec.{0, 0} ι₂} {S α : Type}
    (P : (unifSpec + spec₂).Domain → Bool) (Inv : ℕ → S → Prop)
    (impl : QueryImpl (unifSpec + spec₁) (StateT S (OracleComp (unifSpec + spec₂))))
    (hInl : ∀ (u : unifSpec.Domain) (st : S) (rem : ℕ),
      Inv rem st → OffZeroBound P (fun z => Inv rem z.2) ((impl (.inl u)).run st))
    (hInr : ∀ (qr : spec₁.Domain) (st : S) (rem : ℕ),
      Inv (rem + 1) st → OffZeroBound P (fun z => Inv rem z.2) ((impl (.inr qr)).run st)) :
    ∀ (rem : ℕ) (oa : OracleComp (unifSpec + spec₁) α)
      (_hq : oa.IsQueryBoundP (fun x => x.isRight = true) rem) (st : S),
      Inv rem st → OffZeroBound P (fun _ => True) ((simulateQ impl oa).run st) := by
  intro rem oa
  induction oa using OracleComp.inductionOn generalizing rem with
  | pure a => intro _ st _; change OffZeroBound P (fun _ => True) (Pure.pure (a, st)); exact OffZeroBound.pure trivial
  | query_bind t k ih =>
    intro hq st hst; simp only [simulateQ_query_bind, StateT.run_bind]; rw [isQueryBoundP_query_bind_iff] at hq
    rcases t with u | qr
    · exact (hInl u st rem hst).bind fun z hz => ih z.1 rem (by simpa using hq.2 z.1) z.2 hz
    · rcases rem with _ | rem'
      · simp at hq
      · exact (hInr qr st rem' hst).bind fun z hz => ih z.1 rem' (by simpa using hq.2 z.1) z.2 hz

private structure InRangeH {T RSt K I E : Type}
    (q qep : ℕ) (tL : Option ℕ) (par : Bool) (rem : ℕ)
    (h : FSMultiDFBucketState T RSt K I E) : Prop where
  pos_len : ∀ u, 1 ≤ u → (h.sessions u).length + rem ≤ q
  cache_lt : ∀ u Tc σc k sIdx,
    h.cache u = some (Tc, σc, k, some sIdx) → sIdx < ((qep + 2) - healEpoch tL) * q

private theorem InRangeH.mono {T RSt K I E : Type} {q qep rem₁ rem₂ : ℕ} {tL : Option ℕ} {par : Bool}
    {h : FSMultiDFBucketState T RSt K I E} (hle : rem₁ ≤ rem₂)
    (hH : InRangeH q qep tL par rem₂ h) : InRangeH q qep tL par rem₁ h :=
  ⟨fun u hu => by have := hH.pos_len u hu; omega, hH.cache_lt⟩

private def InRangeVP {Γ T RSt SS RS : Type} (M_sess : ℕ) (vp : VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ)) : Prop :=
  (∀ sIdx, vp.vS = some (.inr sIdx) → sIdx < M_sess) ∧
  (∀ u sIdx, vp.vR u = some (.inr sIdx) → sIdx < M_sess)

private structure InRangeES {Γ T RSt SS RS M E K I : Type}
    (q qep : ℕ) (tL : Option ℕ) (par : Bool) (rem : ℕ)
    (es : EState (VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ)) M (Header T × E)
      (FSMultiDFBucketState T RSt K I E)) : Prop where
  vp_ok : ∀ P, InRangeVP (((qep + 2) - healEpoch tL) * q) (es.g.st P)
  h_ok : InRangeH q qep tL par rem es.h

private theorem InRangeES.mono {Γ T RSt SS RS M E K I : Type}
    {q qep rem₁ rem₂ : ℕ} {tL : Option ℕ} {par : Bool}
    {es : EState (VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ)) M (Header T × E)
      (FSMultiDFBucketState T RSt K I E)} (hle : rem₁ ≤ rem₂)
    (hes : InRangeES q qep tL par rem₂ es) : InRangeES q qep tL par rem₁ es :=
  ⟨hes.vp_ok, hes.h_ok.mono hle⟩

private theorem regSessMultiDFBucket_pos_lt {T RSt K I E : Type} [DecidableEq I]
    {q qep rem t0 : ℕ} {tL : Option ℕ} {par : Bool} (ik : I)
    {h : FSMultiDFBucketState T RSt K I E}
    (ht0 : 1 ≤ t0) (hcap : (!decide (qep + 1 < t0)) = true) (hbk : inStage2BucketGen 4 tL par t0 = true)
    (hH : InRangeH q qep tL par (rem + 1) h) :
    let (sIdx, h') := regSessMultiDFBucket (q + 1) tL t0 ik h
    sIdx < ((qep + 2) - healEpoch tL) * q ∧ InRangeH q qep tL par rem h' := by
  have hcap' : !(qep + 1 < t0) = true := by simpa using hcap
  have hlen : (h.sessions t0).length < q := by have := hH.pos_len t0 ht0; omega
  dsimp only [regSessMultiDFBucket]
  have hsub : (q + 1) - 1 = q := Nat.add_sub_cancel q 1
  rw [hsub]
  by_cases hmem : ik ∈ h.sessions t0
  · simp only [hmem, ↓reduceIte]
    have hidx : (h.sessions t0).idxOf ik < q := Nat.lt_trans (List.idxOf_lt_length_of_mem hmem) hlen
    exact ⟨bucketSlot_lt_mSess hcap' hbk hidx, hH.mono (Nat.le_succ rem)⟩
  · simp only [hmem, ↓reduceIte]
    refine ⟨bucketSlot_lt_mSess hcap' hbk hlen, ?_, hH.cache_lt⟩
    intro u hu
    by_cases hut : u = t0
    · subst hut
      simp only [Function.update_self, List.length_append, List.length_singleton]
      have := hH.pos_len u hu; omega
    · simpa only [Function.update_of_ne hut] using (hH.mono (Nat.le_succ rem)).pos_len u hu

private theorem off_liftFSMultiDFBucket_lt {SS RS T M E RSt K I : Type}
    {M_sess sIdx : ℕ} (hlt : sIdx < M_sess)
    (q_fs : (_root_.CryptoGames.FSAEAD.spec SS RS (Header T) M E).Domain)
    {Q : FSMultiDFBucketState T RSt K I E → Prop}
    (h : FSMultiDFBucketState T RSt K I E) (hQ : Q h) :
    OffZeroBound (sessOffRange M_sess) (fun z => Q z.2)
      ((liftFSMultiDFBucket (SS := SS) (RS := RS) (T := T) (M := M) (E := E) sIdx
        (query (spec := _root_.CryptoGames.FSAEAD.spec SS RS (Header T) M E) q_fs)).run h) := by
  have hfalse : sessOffRange M_sess (.inr ⟨sIdx, q_fs⟩) = false := by
    simp [sessOffRange]; omega
  unfold liftFSMultiDFBucket
  simp only [StateT.run_lift]
  change OffZeroBound (sessOffRange M_sess) (fun z => Q z.2)
    ((query (spec := unifSpec + FSMultiSpec SS RS T M E) (.inr ⟨sIdx, q_fs⟩)) >>= fun y => pure (y, h))
  exact (OffZeroBound.query_false hfalse).bind fun _ _ => OffZeroBound.pure hQ

private theorem lookupMultiDFBucketF_inRange {SS RS T M E RSt K I : Type}
    [DecidableEq I] [SampleableType K]
    {M_sess q qep rem t0 : ℕ} {tL : Option ℕ} {par : Bool} (ik : I)
    (h : FSMultiDFBucketState T RSt K I E) (hH : InRangeH q qep tL par rem h) :
    OffZeroBound (sessOffRange M_sess)
      (fun z => InRangeH q qep tL par rem z.2 ∧ z.2.sessions = h.sessions)
      ((lookupMultiDFBucketF (SS := SS) (RS := RS) (M := M) t0 ik).run h) := by
  unfold lookupMultiDFBucketF
  simp only [StateT.run_bind, StateT.run_get, pure_bind]
  rcases (h.fTable t0).lookup ik with _ | k
  · simp only [StateT.run_bind]
    refine (off_lift_sampleT_zeroBound (sessOffRange M_sess) (fun _ => rfl) K
      (fun h' => InRangeH q qep tL par rem h' ∧ h'.sessions = h.sessions) h ⟨hH, rfl⟩).bind
      fun ⟨k', h1⟩ ⟨hH1, hs1⟩ => ?_
    simp only [StateT.run_modify, StateT.run_pure, pure_bind]
    exact OffZeroBound.pure ⟨⟨hH1.pos_len, hH1.cache_lt⟩, hs1⟩
  · simp only [StateT.run_pure]; exact OffZeroBound.pure ⟨hH, rfl⟩

private theorem rootFSMultiDFBucketPaper_inRange {KR RSt I K SS RS T M E : Type}
    [DecidableEq I] [SampleableType I] [SampleableType K]
    (prng : PRFPRNG KR RSt I K) {M_sess q qep rem t0 : ℕ} {tL : Option ℕ} {par : Bool}
    (pl : Bool) (ik0 : I) (σ0 : RSt)
    (h : FSMultiDFBucketState T RSt K I E) (hH : InRangeH q qep tL par rem h) :
    OffZeroBound (sessOffRange M_sess)
      (fun z => InRangeH q qep tL par rem z.2 ∧ z.2.sessions = h.sessions ∧
        (z.1.2.2.isSome = true → (!decide (qep + 1 < t0)) = true ∧ inStage2BucketGen 4 tL par t0 = true))
      ((rootFSMultiDFBucketPaper (SS := SS) (RS := RS) (M := M) prng 4 qep tL par t0 pl ik0 σ0).run h) := by
  unfold rootFSMultiDFBucketPaper
  dsimp only
  by_cases h1 : (pl || decide (qep + 1 < t0)) = true
  · simp only [h1, ↓reduceIte, StateT.run_pure]
    apply OffZeroBound.pure; exact ⟨hH, rfl, by simp⟩
  · have hcap : (!decide (qep + 1 < t0)) = true := by
      cases hlt : decide (qep + 1 < t0)
      · rfl
      · exfalso; simp [hlt] at h1
    simp only [h1, Bool.false_eq_true, ↓reduceIte]
    by_cases h2 : inStage2BucketGen 4 tL par t0 = true
    · simp only [h2, ↓reduceIte]
      split_ifs
      · simp only [StateT.run_bind]
        refine (off_lift_sampleT_zeroBound (sessOffRange M_sess) (fun _ => rfl) I
          (fun h' => InRangeH q qep tL par rem h' ∧ h'.sessions = h.sessions) h ⟨hH, rfl⟩).bind
          fun ⟨ir, h_1⟩ ⟨hH1, hs1⟩ => ?_
        refine (off_lift_sampleT_zeroBound (sessOffRange M_sess) (fun _ => rfl) K
          (fun h' => InRangeH q qep tL par rem h' ∧ h'.sessions = h.sessions) h_1 ⟨hH1, hs1⟩).bind
          fun ⟨kS, h_2⟩ ⟨hH2, hs2⟩ => ?_
        simp only [StateT.run_pure]
        apply OffZeroBound.pure; exact ⟨hH2, hs2, fun _ => ⟨hcap, trivial⟩⟩
      · simp only [StateT.run_bind]
        refine (lookupMultiDFBucketF_inRange ik0 h hH).bind fun ⟨kL, h_1⟩ ⟨hH1, hs1⟩ => ?_
        simp only [StateT.run_pure]
        apply OffZeroBound.pure; exact ⟨hH1, hs1, fun _ => ⟨hcap, trivial⟩⟩
    · simp only [h2, Bool.false_eq_true, ↓reduceIte]
      split_ifs
      · simp only [StateT.run_bind]
        refine (off_lift_sampleT_zeroBound (sessOffRange M_sess) (fun _ => rfl) I
          (fun h' => InRangeH q qep tL par rem h' ∧ h'.sessions = h.sessions) h ⟨hH, rfl⟩).bind
          fun ⟨ir, h_1⟩ ⟨hH1, hs1⟩ => ?_
        refine (off_lift_sampleT_zeroBound (sessOffRange M_sess) (fun _ => rfl) K
          (fun h' => InRangeH q qep tL par rem h' ∧ h'.sessions = h.sessions) h_1 ⟨hH1, hs1⟩).bind
          fun ⟨kS, h_2⟩ ⟨hH2, hs2⟩ => ?_
        simp only [StateT.run_pure]
        apply OffZeroBound.pure; exact ⟨hH2, hs2, by simp⟩
      · simp only [StateT.run_pure]
        apply OffZeroBound.pure; exact ⟨hH, rfl, by simp⟩

private theorem startSend_mode_inRange {KC Γ CCoins T I KR RSt K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q qep rem t0 : ℕ} (ht0 : 1 ≤ t0)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR RSt I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (gMain : Bool)
    (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ) M E) (P : Party)
    (γ0 : Γ) (σ0 : RSt) (r0 : Option CCoins)
    (h : FSMultiDFBucketState T RSt K I E) (hH : InRangeH q qep tL par (rem + 1) h) :
    let M_sess := ((qep + 2) - healEpoch tL) * q
    OffZeroBound (sessOffRange M_sess)
      (fun z => InRangeH q qep tL par rem z.2 ∧
        ∀ γ' T' σ' ssv, z.1 = some (γ', T', σ', ssv) → ∀ sIdx, ssv = .inr sIdx → sIdx < M_sess)
      (((hooksFSMultiDFBucketPaperMode (q + 1) cka prng fs 1 4 qep gMain tL par la).startSend
        ctx P t0 γ0 σ0 r0).run h) := by
  intro M_sess
  have hMode : (hooksFSMultiDFBucketPaperMode (q + 1) cka prng fs 1 4 qep gMain tL par la).startSend =
      (hooksFSMultiDFBucketPaper (q + 1) cka prng fs 1 4 qep tL par la).startSend := by
    cases gMain <;> rfl
  rw [hMode]
  rcases r0 with _ | coins
  · dsimp only [hooksFSMultiDFBucketPaper]
    rw [StateT.run_bind]
    refine (off_lift_sampleT_zeroBound (sessOffRange M_sess) (fun _ => rfl) CCoins
      (fun h' => InRangeH q qep tL par (rem + 1) h') h hH).bind fun ⟨coins, h1⟩ hH1 => ?_
    rw [StateT.run_bind]
    refine (rootFSMultiDFBucketPaper_inRange prng (postLeakDFBucket tL ctx)
      (cka.send γ0 coins).2.2 σ0 h1 hH1).bind fun ⟨⟨σ', kVal, optSid⟩, h2⟩ ⟨hH2, _, hopt⟩ => ?_
    simp only [StateT.run_bind, StateT.run_get, StateT.run_set, StateT.run_pure, pure_bind]
    rcases optSid with _ | ik
    · dsimp only [regSessOptMultiDFBucket]
      apply OffZeroBound.pure
      refine ⟨⟨(hH2.mono (Nat.le_succ rem)).pos_len, ?_⟩, ?_⟩
      · intro u Tc σc k sIdx hcu
        by_cases hut : u = t0
        · subst hut
          dsimp only at hcu
          simp [Function.update_self] at hcu
        · dsimp only at hcu
          rw [Function.update_of_ne hut] at hcu
          exact hH2.cache_lt u Tc σc k sIdx hcu
      · intro _ _ _ _ hEq _ hsIdx; simp only [Option.some.injEq, Prod.mk.injEq] at hEq
        rcases hEq with ⟨_, _, _, rfl⟩; cases hsIdx
    · obtain ⟨hcap, hbk⟩ := hopt rfl
      have hreg := regSessMultiDFBucket_pos_lt ik ht0 hcap hbk hH2
      rcases hres : regSessMultiDFBucket (q + 1) tL t0 ik h2 with ⟨sIdx0, h3⟩
      rw [hres] at hreg
      dsimp only [regSessOptMultiDFBucket]
      rw [hres]
      dsimp only
      apply OffZeroBound.pure
      refine ⟨⟨hreg.2.pos_len, ?_⟩, ?_⟩
      · intro u Tc σc k sIdx hcu
        by_cases hut : u = t0
        · subst hut
          simp only [Function.update_self, Option.some.injEq, Prod.mk.injEq] at hcu
          rcases hcu with ⟨_, _, _, rfl⟩; exact hreg.1
        · dsimp only at hcu
          rw [Function.update_of_ne hut] at hcu
          exact hreg.2.cache_lt u Tc σc k sIdx hcu
      · intro _ _ _ _ hEq sIdx hsIdx
        simp only [Option.some.injEq, Prod.mk.injEq] at hEq
        rcases hEq with ⟨_, _, _, rfl⟩
        cases hsIdx; exact hreg.1
  · dsimp only [hooksFSMultiDFBucketPaper]
    rw [StateT.run_bind, StateT.run_pure, pure_bind, StateT.run_bind]
    refine (rootFSMultiDFBucketPaper_inRange prng (postLeakDFBucket tL ctx)
      (cka.send γ0 coins).2.2 σ0 h hH).bind fun ⟨⟨σ', kVal, optSid⟩, h2⟩ ⟨hH2, _, hopt⟩ => ?_
    simp only [StateT.run_bind, StateT.run_get, StateT.run_set, StateT.run_pure, pure_bind]
    rcases optSid with _ | ik
    · dsimp only [regSessOptMultiDFBucket]
      apply OffZeroBound.pure
      refine ⟨⟨(hH2.mono (Nat.le_succ rem)).pos_len, ?_⟩, ?_⟩
      · intro u Tc σc k sIdx hcu
        by_cases hut : u = t0
        · subst hut
          dsimp only at hcu
          simp [Function.update_self] at hcu
        · dsimp only at hcu
          rw [Function.update_of_ne hut] at hcu
          exact hH2.cache_lt u Tc σc k sIdx hcu
      · intro _ _ _ _ hEq _ hsIdx; simp only [Option.some.injEq, Prod.mk.injEq] at hEq
        rcases hEq with ⟨_, _, _, rfl⟩; cases hsIdx
    · obtain ⟨hcap, hbk⟩ := hopt rfl
      have hreg := regSessMultiDFBucket_pos_lt ik ht0 hcap hbk hH2
      rcases hres : regSessMultiDFBucket (q + 1) tL t0 ik h2 with ⟨sIdx0, h3⟩
      rw [hres] at hreg
      dsimp only [regSessOptMultiDFBucket]
      rw [hres]
      dsimp only
      apply OffZeroBound.pure
      refine ⟨⟨hreg.2.pos_len, ?_⟩, ?_⟩
      · intro u Tc σc k sIdx hcu
        by_cases hut : u = t0
        · subst hut
          simp only [Function.update_self, Option.some.injEq, Prod.mk.injEq] at hcu
          rcases hcu with ⟨_, _, _, rfl⟩; exact hreg.1
        · dsimp only at hcu
          rw [Function.update_of_ne hut] at hcu
          exact hreg.2.cache_lt u Tc σc k sIdx hcu
      · intro _ _ _ _ hEq sIdx hsIdx
        simp only [Option.some.injEq, Prod.mk.injEq] at hEq
        rcases hEq with ⟨_, _, _, rfl⟩
        cases hsIdx; exact hreg.1

private theorem startRecv_mode_inRange {KC Γ CCoins T I KR RSt K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q qep rem t0 : ℕ} (ht0 : 1 ≤ t0)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR RSt I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (gMain : Bool)
    (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ) M E) (P : Party)
    (γ0 : Γ) (σ0 : RSt) (tn0 : T)
    (h : FSMultiDFBucketState T RSt K I E) (hH : InRangeH q qep tL par (rem + 1) h) :
    let M_sess := ((qep + 2) - healEpoch tL) * q
    OffZeroBound (sessOffRange M_sess)
      (fun z => InRangeH q qep tL par rem z.2 ∧
        ∀ γ' σ' rsv, z.1 = some (some (γ', σ', rsv)) → ∀ sIdx, rsv = .inr sIdx → sIdx < M_sess)
      (((hooksFSMultiDFBucketPaperMode (q + 1) cka prng fs 1 4 qep gMain tL par la).startRecv
        ctx P t0 γ0 σ0 tn0).run h) := by
  intro M_sess
  have hmono := hH.mono (Nat.le_succ rem)
  cases gMain
  · -- gMain = false: hooksFSMultiDFBucketPaper.startRecv
    simp only [hooksFSMultiDFBucketPaperMode, Bool.false_eq_true, ↓reduceIte, hooksFSMultiDFBucketPaper]
    simp only [StateT.run_bind, StateT.run_get, pure_bind]
    rcases hcache : h.cache t0 with _ | ⟨tCached, σc, kVal, optIdx⟩
    · dsimp only
      by_cases hcond : (!(decide (qep + 1 < t0)) && inStage2BucketGen 4 tL par t0) = true
      · simp only [hcond, ↓reduceIte]
        simp only [Bool.and_eq_true] at hcond
        split_ifs
        · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hmono, by simp⟩
        · simp only [StateT.run_pure]
          apply OffZeroBound.pure
          exact ⟨hmono, fun _ _ _ hEq _ hs => by
            simp only [Option.some.injEq, Prod.mk.injEq] at hEq; rcases hEq with ⟨_, _, rfl⟩; cases hs⟩
        · simp only [StateT.run_bind]
          refine (lookupMultiDFBucketF_inRange (cka.receive γ0 tn0).2 h hH).bind fun ⟨_, h1⟩ ⟨hH1, _⟩ => ?_
          simp only [StateT.run_get, StateT.run_set, StateT.run_pure, pure_bind]
          have hreg := regSessMultiDFBucket_pos_lt (cka.receive γ0 tn0).2 ht0 hcond.1 hcond.2 hH1
          rcases hres : regSessMultiDFBucket (q + 1) tL t0 (cka.receive γ0 tn0).2 h1 with ⟨sIdx0, h2⟩
          rw [hres] at hreg
          apply OffZeroBound.pure
          refine ⟨hreg.2, fun _ _ _ hEq sIdx hs => ?_⟩
          simp only [Option.some.injEq, Prod.mk.injEq] at hEq
          rcases hEq with ⟨_, _, rfl⟩; cases hs; exact hreg.1
      · simp only [hcond, Bool.false_eq_true, ↓reduceIte, StateT.run_pure]
        apply OffZeroBound.pure; exact ⟨hmono, by simp⟩
    · by_cases heq : tCached = tn0
      · simp only [heq, ↓reduceIte, StateT.run_pure]
        rcases optIdx with _ | sIdx0
        · apply OffZeroBound.pure
          exact ⟨hmono, fun _ _ _ hEq _ hs => by
            simp only [Option.some.injEq, Prod.mk.injEq] at hEq; rcases hEq with ⟨_, _, rfl⟩; cases hs⟩
        · have hlt := hH.cache_lt t0 tCached σc kVal sIdx0 hcache
          apply OffZeroBound.pure
          exact ⟨hmono, fun _ _ _ hEq sIdx hs => by
            simp only [Option.some.injEq, Prod.mk.injEq] at hEq; rcases hEq with ⟨_, _, rfl⟩
            cases hs; exact hlt⟩
      · simp only [heq, ↓reduceIte]
        by_cases hcond : (!(decide (qep + 1 < t0)) && inStage2BucketGen 4 tL par t0) = true
        · simp only [hcond, ↓reduceIte]
          simp only [Bool.and_eq_true] at hcond
          split_ifs
          · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hmono, by simp⟩
          · simp only [StateT.run_pure]
            apply OffZeroBound.pure
            exact ⟨hmono, fun _ _ _ hEq _ hs => by
              simp only [Option.some.injEq, Prod.mk.injEq] at hEq; rcases hEq with ⟨_, _, rfl⟩; cases hs⟩
          · simp only [StateT.run_bind]
            refine (lookupMultiDFBucketF_inRange (cka.receive γ0 tn0).2 h hH).bind fun ⟨_, h1⟩ ⟨hH1, _⟩ => ?_
            simp only [StateT.run_get, StateT.run_set, StateT.run_pure, pure_bind]
            have hreg := regSessMultiDFBucket_pos_lt (cka.receive γ0 tn0).2 ht0 hcond.1 hcond.2 hH1
            rcases hres : regSessMultiDFBucket (q + 1) tL t0 (cka.receive γ0 tn0).2 h1 with ⟨sIdx0, h2⟩
            rw [hres] at hreg
            apply OffZeroBound.pure
            refine ⟨hreg.2, fun _ _ _ hEq sIdx hs => ?_⟩
            simp only [Option.some.injEq, Prod.mk.injEq] at hEq
            rcases hEq with ⟨_, _, rfl⟩; cases hs; exact hreg.1
        · simp only [hcond, Bool.false_eq_true, ↓reduceIte, StateT.run_pure]
          apply OffZeroBound.pure; exact ⟨hmono, by simp⟩
  · -- gMain = true
    simp only [hooksFSMultiDFBucketPaperMode, ↓reduceIte]
    simp only [StateT.run_bind, StateT.run_get, pure_bind]
    rcases hcache : h.cache t0 with _ | ⟨tCached, σc, kVal, optIdx⟩
    · split_ifs <;> simp only [StateT.run_pure] <;>
        (apply OffZeroBound.pure; exact ⟨hmono, by simp⟩)
    · by_cases heq : tCached = tn0
      · simp only [heq, ↓reduceIte, StateT.run_pure]
        rcases optIdx with _ | sIdx0
        · apply OffZeroBound.pure
          exact ⟨hmono, fun _ _ _ hEq _ hs => by
            simp only [Option.some.injEq, Prod.mk.injEq] at hEq; rcases hEq with ⟨_, _, rfl⟩; cases hs⟩
        · have hlt := hH.cache_lt t0 tCached σc kVal sIdx0 hcache
          apply OffZeroBound.pure
          exact ⟨hmono, fun _ _ _ hEq sIdx hs => by
            simp only [Option.some.injEq, Prod.mk.injEq] at hEq; rcases hEq with ⟨_, _, rfl⟩
            cases hs; exact hlt⟩
      · simp only [heq, ↓reduceIte]
        split_ifs <;> simp only [StateT.run_pure] <;>
          (apply OffZeroBound.pure; exact ⟨hmono, by simp⟩)

private theorem fsSend_mode_inRange {KC Γ CCoins T I KR RSt K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q qep rem : ℕ}
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR RSt I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (gMain : Bool)
    (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ) M E) (P : Party) (t0 : ℕ)
    (ssv : SS ⊕ ℕ) (hdr : Header T) (m : M) (pair : Option (M × M))
    (h : FSMultiDFBucketState T RSt K I E)
    (hssv : ∀ sIdx, ssv = .inr sIdx → sIdx < ((qep + 2) - healEpoch tL) * q)
    (hH : InRangeH q qep tL par rem h) :
    let M_sess := ((qep + 2) - healEpoch tL) * q
    OffZeroBound (sessOffRange M_sess)
      (fun z => InRangeH q qep tL par rem z.2 ∧
        ∀ vc, z.1 = some vc → ∀ sIdx, vc.1 = .inr sIdx → sIdx < M_sess)
      (((hooksFSMultiDFBucketPaperMode (q + 1) cka prng fs 1 4 qep gMain tL par la).fsSend
        ctx P t0 ssv hdr m pair).run h) := by
  intro M_sess
  dsimp only [hooksFSMultiDFBucketPaperMode, hooksFSMultiDFBucketPaper]
  rcases ssv with ss | sIdx
  · simp only [StateT.run_pure]
    apply OffZeroBound.pure
    exact ⟨hH, fun vc hvc _ hs => by
      simp only [Option.some.injEq] at hvc; subst hvc; cases hs⟩
  · have hlt : sIdx < M_sess := hssv sIdx rfl
    have htail : ∀ (h0 : FSMultiDFBucketState T RSt K I E), InRangeH q qep tL par rem h0 →
        OffZeroBound (sessOffRange M_sess)
          (fun z => InRangeH q qep tL par rem z.2 ∧
            ∀ vc, z.1 = some vc → ∀ sIdx', vc.1 = .inr sIdx' → sIdx' < M_sess)
          ((do
            let e? ← match pair with
              | some (m₀, m₁) => liftFSMultiDFBucket sIdx (challengeQuery (SenderState := SS) (ReceiverState := RS) hdr m₀ m₁)
              | none => liftFSMultiDFBucket sIdx (transmitQuery (SenderState := SS) (ReceiverState := RS) hdr m)
            match e? with
            | none => return (none : Option ((SS ⊕ ℕ) × E))
            | some e =>
              modify fun (st : FSMultiDFBucketState T RSt K I E) =>
                let b := (st.book sIdx).getD {}
                let cnt' := b.fsCount + 1
                let b' : FSMultiBook T E := { b with fsCount := cnt', fsTrans := (cnt', hdr, e) :: b.fsTrans }
                { st with book := Function.update st.book sIdx (some b') }
              return some (.inr sIdx, e)).run h0) := by
      intro h0 hH0
      rcases pair with _ | ⟨m₀, m₁⟩ <;>
        simp only [StateT.run_bind, challengeQuery, transmitQuery] <;>
        (refine (off_liftFSMultiDFBucket_lt (SS := SS) (RS := RS) (M := M) hlt _ h0 hH0).bind
           fun ⟨e?, h1⟩ hH1 => ?_;
         rcases e? with _ | e;
         · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH1, by simp⟩
         · simp only [StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind]
           apply OffZeroBound.pure
           exact ⟨⟨hH1.pos_len, hH1.cache_lt⟩, fun vc hvc sIdx' hs => by
             simp only [Option.some.injEq] at hvc; subst hvc; cases hs; exact hlt⟩)
    simp only [StateT.run_bind, StateT.run_get, pure_bind]
    split
    · simp only [StateT.run_bind, corruptSenderQuery]
      refine (off_liftFSMultiDFBucket_lt (SS := SS) (RS := RS) (M := M) hlt _ h hH).bind
        fun ⟨o, h1⟩ hH1 => ?_
      rcases o with _ | _
      · simp only [StateT.run_pure, Bool.not_false, ↓reduceIte]
        apply OffZeroBound.pure; exact ⟨hH1, by simp⟩
      · simp only [StateT.run_bind, StateT.run_modify, pure_bind, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
        exact htail _ ⟨hH1.pos_len, hH1.cache_lt⟩
    · simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
      exact htail h hH

private theorem fsRecv_mode_inRange {KC Γ CCoins T I KR RSt K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q qep rem : ℕ}
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR RSt I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (gMain : Bool)
    (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ) M E) (P : Party) (t0 : ℕ)
    (rsv : RS ⊕ ℕ) (hdr : Header T) (e : E)
    (rec : Option (_root_.CryptoGames.SM.Record M (Header T × E)))
    (h : FSMultiDFBucketState T RSt K I E)
    (hrsv : ∀ sIdx, rsv = .inr sIdx → sIdx < ((qep + 2) - healEpoch tL) * q)
    (hH : InRangeH q qep tL par rem h) :
    let M_sess := ((qep + 2) - healEpoch tL) * q
    OffZeroBound (sessOffRange M_sess)
      (fun z => InRangeH q qep tL par rem z.2 ∧
        ∀ vim, z.1 = some (some vim) → ∀ sIdx, vim.1 = .inr sIdx → sIdx < M_sess)
      (((hooksFSMultiDFBucketPaperMode (q + 1) cka prng fs 1 4 qep gMain tL par la).fsRecv
        ctx P t0 rsv hdr e rec).run h) := by
  intro M_sess
  dsimp only [hooksFSMultiDFBucketPaperMode, hooksFSMultiDFBucketPaper]
  rcases rsv with rs | sIdx
  · simp only [StateT.run_pure]
    apply OffZeroBound.pure
    refine ⟨hH, fun vim hvim _ hs => ?_⟩
    rcases hrec : fs.receive rs hdr e with _ | o
    · simp [hrec] at hvim
    · simp only [hrec, Option.map_some, Option.some.injEq] at hvim; subst hvim; cases hs
  · have hlt : sIdx < M_sess := hrsv sIdx rfl
    have htail : ∀ (matched : Option (ℕ × Header T × E)) (h0 : FSMultiDFBucketState T RSt K I E),
        InRangeH q qep tL par rem h0 →
        OffZeroBound (sessOffRange M_sess)
          (fun (z : Option (Option ((RS ⊕ ℕ) × ℕ × M)) × FSMultiDFBucketState T RSt K I E) =>
            InRangeH q qep tL par rem z.2 ∧
              ∀ vim, z.1 = some (some vim) → ∀ sIdx', vim.1 = Sum.inr sIdx' → sIdx' < M_sess)
          ((do
            let res ← if matched.isSome then
                liftFSMultiDFBucket sIdx (deliverQuery (SenderState := SS) (ReceiverState := RS) hdr e)
              else
                liftFSMultiDFBucket sIdx (injectQuery (SenderState := SS) (ReceiverState := RS) hdr e)
            match res with
            | none => return (none : Option (Option ((RS ⊕ ℕ) × ℕ × M)))
            | some .rejected => return some none
            | some (.accepted i mo') =>
              let s1 ← get
              let bk1 := (s1.book sIdx).getD {}
              if la && matched.isNone && (!bk1.sCorr) && bk1.fsCount < i then
                modify fun (st : FSMultiDFBucketState T RSt K I E) => { st with lfWin := true }
                return none
              else
                let drop := (matched.map (fun (x : ℕ × Header T × E) => x.1)).getD i
                modify fun (st : FSMultiDFBucketState T RSt K I E) =>
                  let b := (st.book sIdx).getD {}
                  let b' : FSMultiBook T E := { b with fsTrans := b.fsTrans.filter (·.1 != drop) }
                  { st with book := Function.update st.book sIdx (some b') }
                match mo', rec with
                | some m, _ => return some (some (.inr sIdx, i, m))
                | none, some r => return some (some (.inr sIdx, i, r.msg))
                | none, none => return none).run h0) := by
      intro matched h0 hH0
      split_ifs <;>
        simp only [StateT.run_bind, deliverQuery, injectQuery] <;>
        (refine (off_liftFSMultiDFBucket_lt (SS := SS) (RS := RS) (M := M) hlt _ h0 hH0).bind
           fun ⟨res, h1⟩ hH1 => ?_;
         rcases res with _ | (_ | ⟨i, mo'⟩);
         · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH1, by simp⟩
         · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH1, by simp⟩
         · simp only [StateT.run_bind, StateT.run_get, pure_bind]
           split_ifs
           · simp only [StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind]
             apply OffZeroBound.pure; exact ⟨⟨hH1.pos_len, hH1.cache_lt⟩, by simp⟩
           · simp only [StateT.run_bind, StateT.run_modify, pure_bind]
             rcases mo' with _ | m
             · rcases rec with _ | r
               · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨⟨hH1.pos_len, hH1.cache_lt⟩, by simp⟩
               · simp only [StateT.run_pure]
                 apply OffZeroBound.pure
                 exact ⟨⟨hH1.pos_len, hH1.cache_lt⟩, fun vim hvim _ hs => by
                   simp only [Option.some.injEq] at hvim; subst hvim; cases hs; exact hlt⟩
             · simp only [StateT.run_pure]
               apply OffZeroBound.pure
               exact ⟨⟨hH1.pos_len, hH1.cache_lt⟩, fun vim hvim _ hs => by
                 simp only [Option.some.injEq] at hvim; subst hvim; cases hs; exact hlt⟩)
    simp only [StateT.run_bind, StateT.run_get, pure_bind]
    split
    · simp only [StateT.run_bind, corruptSenderQuery]
      refine (off_liftFSMultiDFBucket_lt (SS := SS) (RS := RS) (M := M) hlt _ h hH).bind fun ⟨o, h1⟩ hH1 => ?_
      rcases o with _ | _
      · simp only [StateT.run_pure, Bool.not_false, ↓reduceIte]
        apply OffZeroBound.pure; exact ⟨hH1, by simp⟩
      · simp only [StateT.run_bind, StateT.run_modify, pure_bind, Bool.not_true, Bool.false_eq_true, ↓reduceIte]
        exact htail _ _ ⟨hH1.pos_len, hH1.cache_lt⟩
    · simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte]
      exact htail _ h hH

private theorem reveal_mode_inRange {KC Γ CCoins T I KR RSt K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q qep rem : ℕ}
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR RSt I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (gMain : Bool)
    (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ) M E) (P : Party)
    (vp : VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ))
    (h : FSMultiDFBucketState T RSt K I E)
    (hvp : InRangeVP (((qep + 2) - healEpoch tL) * q) vp)
    (hH : InRangeH q qep tL par (rem + 1) h) :
    OffZeroBound (sessOffRange (((qep + 2) - healEpoch tL) * q))
      (fun z => InRangeH q qep tL par rem z.2)
      (((hooksFSMultiDFBucketPaperMode (q + 1) cka prng fs 1 4 qep gMain tL par la).reveal
        ctx P vp).run h) := by
  have hmono := hH.mono (Nat.le_succ rem)
  have hbase : OffZeroBound (sessOffRange (((qep + 2) - healEpoch tL) * q))
      (fun z => InRangeH q qep tL par rem z.2)
      (((hooksFSMultiDFBucketPaper (q + 1) cka prng fs 1 4 qep tL par la).reveal
        ctx P vp).run h) := by
    dsimp only [hooksFSMultiDFBucketPaper]
    rcases hvs : vp.vS with _ | (ss | sIdx)
    · simp only [pure_bind]; split_ifs <;> simp only [StateT.run_pure] <;> exact OffZeroBound.pure hmono
    · simp only [pure_bind]; split_ifs <;> simp only [StateT.run_pure] <;> exact OffZeroBound.pure hmono
    · have hlt : sIdx < ((qep + 2) - healEpoch tL) * q := hvp.1 sIdx hvs
      simp only [StateT.run_bind, corruptSenderQuery]
      refine (off_liftFSMultiDFBucket_lt (SS := SS) (RS := RS) (M := M) hlt _ h hmono).bind
        fun ⟨o, h1⟩ hH1 => ?_
      rcases o with _ | ss
      · simp only [StateT.run_pure, pure_bind]; exact OffZeroBound.pure hH1
      · simp only [StateT.run_bind, StateT.run_modify, pure_bind]
        split_ifs <;> simp only [StateT.run_pure] <;> exact OffZeroBound.pure ⟨hH1.pos_len, hH1.cache_lt⟩
  cases gMain
  · simp only [hooksFSMultiDFBucketPaperMode, Bool.false_eq_true, ↓reduceIte]
    split_ifs
    · simp only [StateT.run_pure]; exact OffZeroBound.pure hmono
    · exact hbase
  · simp only [hooksFSMultiDFBucketPaperMode, ↓reduceIte]; exact hbase

private theorem vSend_mode_inRange {KC Γ CCoins T I KR RSt K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq E] [Inhabited E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q qep rem : ℕ}
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR RSt I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (gMain : Bool)
    (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ) M E) (P : Party)
    (vp : VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ)) (m : M) (pair : Option (M × M)) (r0 : Option CCoins)
    (h : FSMultiDFBucketState T RSt K I E)
    (hvp : InRangeVP (((qep + 2) - healEpoch tL) * q) vp)
    (hH : InRangeH q qep tL par (rem + 1) h) :
    let M_sess := ((qep + 2) - healEpoch tL) * q
    OffZeroBound (sessOffRange M_sess)
      (fun z => InRangeH q qep tL par rem z.2 ∧
        ∀ vp' ct, z.1 = some (vp', ct) → InRangeVP M_sess vp')
      ((vSend (hooksFSMultiDFBucketPaperMode (q + 1) cka prng fs 1 4 qep gMain tL par la)
        ctx P vp m pair r0).run h) := by
  intro M_sess
  unfold vSend
  dsimp only
  by_cases hs : vp.id.sendsIn (vp.tcur + 1)
  · simp only [hs, ↓reduceIte, StateT.run_bind]
    refine (startSend_mode_inRange (Nat.succ_pos _) cka prng fs gMain tL par la ctx P vp.γ vp.root r0 h hH).bind
      fun ⟨out, h1⟩ ⟨hH1, hout⟩ => ?_
    rcases out with _ | ⟨γ', T', σ', ssv⟩
    · simp only [pure_bind, StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH1, by simp⟩
    · simp only [pure_bind, StateT.run_bind]
      refine (fsSend_mode_inRange cka prng fs gMain tL par la ctx P (vp.tcur + 1) ssv
        (vp.tcur + 1, some T') m pair h1 (hout γ' T' σ' ssv rfl) hH1).bind fun ⟨res, h2⟩ ⟨hH2, hres⟩ => ?_
      rcases res with _ | ⟨ssv', ct⟩
      · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH2, by simp⟩
      · simp only [StateT.run_pure]
        apply OffZeroBound.pure
        refine ⟨hH2, fun vp' _ hEq => ?_⟩
        simp only [Option.some.injEq, Prod.mk.injEq] at hEq
        rcases hEq with ⟨rfl, _⟩
        exact ⟨fun sIdx hs => hres (ssv', ct) rfl sIdx (Option.some.inj hs), hvp.2⟩
  · simp only [hs, Bool.false_eq_true, ↓reduceIte, pure_bind]
    rcases hvs : vp.vS with _ | ssv
    · dsimp only
      simp only [StateT.run_pure]
      apply OffZeroBound.pure
      refine ⟨hH.mono (Nat.le_succ rem), fun vp' _ hEq => ?_⟩
      simp only [Option.some.injEq, Prod.mk.injEq] at hEq
      rcases hEq with ⟨rfl, _⟩; exact hvp
    · dsimp only
      simp only [StateT.run_bind]
      refine (fsSend_mode_inRange cka prng fs gMain tL par la ctx P vp.tcur ssv
        (vp.tcur, vp.curCkaMsg) m pair h (fun sIdx hs => hvp.1 sIdx (hvs.trans (congrArg some hs)))
        (hH.mono (Nat.le_succ rem))).bind fun ⟨res, h2⟩ ⟨hH2, hres⟩ => ?_
      rcases res with _ | ⟨ssv', ct⟩
      · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH2, by simp⟩
      · simp only [StateT.run_pure]
        apply OffZeroBound.pure
        refine ⟨hH2, fun vp' _ hEq => ?_⟩
        simp only [Option.some.injEq, Prod.mk.injEq] at hEq
        rcases hEq with ⟨rfl, _⟩
        exact ⟨fun sIdx hs => hres (ssv', ct) rfl sIdx (Option.some.inj hs), hvp.2⟩

private theorem vRecv_mode_inRange {KC Γ CCoins T I KR RSt K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq E] [Inhabited E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q qep rem : ℕ}
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR RSt I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (gMain : Bool)
    (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ) M E) (P : Party)
    (vp : VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ)) (c : Header T × E)
    (rec : Option (_root_.CryptoGames.SM.Record M (Header T × E)))
    (h : FSMultiDFBucketState T RSt K I E)
    (hvp : InRangeVP (((qep + 2) - healEpoch tL) * q) vp)
    (hH : InRangeH q qep tL par (rem + 1) h) :
    let M_sess := ((qep + 2) - healEpoch tL) * q
    OffZeroBound (sessOffRange M_sess)
      (fun (z : Option (Option (VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ) × ℕ × ℕ × M)) ×
          FSMultiDFBucketState T RSt K I E) =>
        InRangeH q qep tL par rem z.2 ∧
          ∀ vp' t' i' m', z.1 = some (some (vp', t', i', m')) → InRangeVP M_sess vp')
      ((vRecv (hooksFSMultiDFBucketPaperMode (q + 1) cka prng fs 1 4 qep gMain tL par la)
        ctx P vp c rec).run h) := by
  intro M_sess
  have hmono := hH.mono (Nat.le_succ rem)
  unfold vRecv
  dsimp only
  by_cases hg : (vp.id.sendsIn c.1.1 || decide (vp.tcur + 1 < c.1.1)) = true
  · simp only [hg, ↓reduceIte, StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hmono, by simp⟩
  · simp only [hg, Bool.false_eq_true, ↓reduceIte]
    by_cases ht : c.1.1 = vp.tcur + 1
    · simp only [ht, ↓reduceIte]
      rcases c.1.2 with _ | Tn
      · simp only [pure_bind, StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hmono, by simp⟩
      · simp only [StateT.run_bind]
        refine (startRecv_mode_inRange (by omega) cka prng fs gMain tL par la ctx P vp.γ vp.root Tn h hH).bind
          fun ⟨out, h1⟩ ⟨hH1, hout⟩ => ?_
        rcases out with _ | (_ | ⟨γ', σ', rsv⟩)
        · simp only [pure_bind, StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH1, by simp⟩
        · simp only [pure_bind, StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH1, by simp⟩
        · simp only [pure_bind, Function.update_self, StateT.run_bind]
          refine (fsRecv_mode_inRange cka prng fs gMain tL par la ctx P (vp.tcur + 1) rsv
            c.1 c.2 rec h1 (hout γ' σ' rsv rfl) hH1).bind fun ⟨res, h2⟩ ⟨hH2, hres⟩ => ?_
          rcases res with _ | (_ | ⟨rsv', i', m'⟩)
          · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH2, by simp⟩
          · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH2, by simp⟩
          · simp only [StateT.run_pure]
            apply OffZeroBound.pure
            refine ⟨hH2, fun vp' _ _ _ hEq => ?_⟩
            simp only [Option.some.injEq, Prod.mk.injEq] at hEq
            rcases hEq with ⟨rfl, _, _, _⟩
            refine ⟨hvp.1, fun u sIdx hu => ?_⟩
            by_cases huc : u = vp.tcur + 1
            · subst huc
              simp only [Function.update_self, Option.some.injEq] at hu
              exact hres (rsv', i', m') rfl sIdx hu
            · dsimp only at hu
              simp only [Function.update_of_ne huc] at hu
              exact hvp.2 u sIdx hu
    · simp only [ht, ↓reduceIte, pure_bind]
      rcases hvr : vp.vR c.1.1 with _ | rsv
      · dsimp only; simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hmono, by simp⟩
      · dsimp only; simp only [StateT.run_bind]
        refine (fsRecv_mode_inRange cka prng fs gMain tL par la ctx P c.1.1 rsv c.1 c.2 rec h
          (fun sIdx hs => hvp.2 c.1.1 sIdx (hvr.trans (congrArg some hs))) hmono).bind
          fun ⟨res, h2⟩ ⟨hH2, hres⟩ => ?_
        rcases res with _ | (_ | ⟨rsv', i', m'⟩)
        · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH2, by simp⟩
        · simp only [StateT.run_pure]; apply OffZeroBound.pure; exact ⟨hH2, by simp⟩
        · simp only [StateT.run_pure]
          apply OffZeroBound.pure
          refine ⟨hH2, fun vp' _ _ _ hEq => ?_⟩
          simp only [Option.some.injEq, Prod.mk.injEq] at hEq
          rcases hEq with ⟨rfl, _, _, _⟩
