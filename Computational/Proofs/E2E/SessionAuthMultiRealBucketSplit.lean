          · subst huc
            simp only [Function.update_self, Option.some.injEq] at hu
            exact hres (rsv', i', m') rfl sIdx hu
          · dsimp only at hu
            simp only [Function.update_of_ne huc] at hu
            exact hvp.2 u sIdx hu

private theorem inRangeVP_update {Γ T RSt SS RS : Type} {M_sess : ℕ}
    {st : Party → VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ)} (hst : ∀ Q, InRangeVP M_sess (st Q))
    (P : Party) {vp' : VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ)} (hvp' : InRangeVP M_sess vp') :
    ∀ Q, InRangeVP M_sess (Function.update st P vp' Q) := by
  intro Q
  by_cases hQP : Q = P
  · subst hQP; simpa only [Function.update_self] using hvp'
  · simpa only [Function.update_of_ne hQP] using hst Q

private theorem epMgmt_st_eq {St Msg C : Type} {g s₁ : GameState St Msg C}
    {Δ qep : ℕ} {P : Party} {bad : Bool} (h : g.epMgmt Δ qep P bad = some s₁) : s₁.st = g.st := by
  unfold GameState.epMgmt at h
  split at h
  · split at h
    · cases h
    · simp only [Option.some.injEq] at h; subst h; dsimp only; split <;> rfl
  · split at h
    · cases h
    · simp only [Option.some.injEq] at h; subst h; rfl

