private theorem step2_deliverForge_aux_reject_sCorr_inv
    {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ q qep rem : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    {t0 j : ℕ} {sM' : SessHSt Pt ℓ}
    (hbk : inStage2BucketGen 4 tL par t0 = true)
    (hj_q : j < q)
    (ht0_send : t0 ≤ esLoc.g.epoch (Party.senderOf t0))
    (hsess' : ActiveSessInv C ℓ encT idOf false (ks (q * (t0 - healEpoch tL) + j))
      (ssLoc (q * (t0 - healEpoch tL) + j)) (rsLoc (q * (t0 - healEpoch tL) + j))
      { (esM.h.book (q * (t0 - healEpoch tL) + j)).getD {} with sCorr := true }
      sM' (tblL (q * (t0 - healEpoch tL) + j))) :
    let sIdx := q * (t0 - healEpoch tL) + j
    let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
      { (esM.h.book sIdx).getD {} with sCorr := true }
    BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc rsLoc esLoc
      { esM with h := { esM.h with book := Function.update esM.h.book sIdx (some bk') } }
      esL (Function.update tblM sIdx sM') tblL := by
  intro sIdx bk'
  have hbase := hinv.mono_rem (Nat.le_succ rem)
  have htH : healEpoch tL ≤ t0 := healEpoch_le_of_gen4 hbk
  refine
    { hbase with
      phase1_props := fun hp1 => Bool.noConfusion hp1
      sess_inv := fun i => by
        by_cases hi : i = sIdx
        · subst hi
          simpa [sIdx, bk', Function.update_self] using hsess'
        · simpa [Function.update_of_ne hi] using hbase.sess_inv i
      book_fresh_before_send := fun τ j' h1 h2 hj' hlt hh => by
        have hne : q * (τ - healEpoch tL) + j' ≠ sIdx := by
          intro heq
          obtain ⟨hτ, _⟩ := bucketSlot_inj h2 htH hj' hj_q heq
          subst hτ
          omega
        simpa [Function.update_of_ne hne] using hbase.book_fresh_before_send τ j' h1 h2 hj' hlt hh
      healed_sender_pin := fun Q τ j' hs he hv hh => by
        have hcnt : ∀ i,
            (((Function.update esM.h.book sIdx (some bk') i).getD {}).fsCount) =
              ((esM.h.book i).getD {}).fsCount := by
          intro i; by_cases hi : i = sIdx
          · subst i; simp [bk']
          · simp [hi]
        simpa [hcnt] using hbase.healed_sender_pin Q τ j' hs he hv hh
      healed_book_trans := fun τ sIdx' hh hro hp => by
        have htr : ∀ i,
            (((Function.update esM.h.book sIdx (some bk') i).getD {}).fsTrans) =
              ((esM.h.book i).getD {}).fsTrans := by
          intro i; by_cases hi : i = sIdx
          · subst i; simp [bk']
          · simp [hi]
        simpa [htr] using hbase.healed_book_trans τ sIdx' hh hro hp }

private theorem step2_deliverForge_aux_accept_inv
    {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ q qep rem : ℕ} (hq_pos : 0 < q)
    {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc rsLoc' : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ}
    {hM' : MultiHS Pt} {tblM tblL tblM' tblL' : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    {P : Party} {t0 idxOut : ℕ} {stLoc' : LocVP Pt} {stM' : MultiVP Pt}
    (hP_recv : P = Party.receiverOf t0)
    (ht0_le_succ : t0 ≤ esLoc.g.epoch P + 1)
    (ht0_le_other : t0 ≤ esLoc.g.epoch P.other)
    (hunhealed : healedBy esLoc.g.tL 3 t0 = false)
    (hst_id : stLoc'.id = P ∧ stM'.id = P)
    (hst_tcur : stLoc'.tcur = max (esLoc.g.epoch P) t0 ∧ stM'.tcur = max (esLoc.g.epoch P) t0)
    (hst_γ : stLoc'.γ = stM'.γ)
    (hst_root : stLoc'.root = stM'.root)
    (hst_cka : stLoc'.curCkaMsg = (esLoc.g.st P).curCkaMsg ∧ stM'.curCkaMsg = (esM.g.st P).curCkaMsg)
    (hst_vS : stLoc'.vS = (esLoc.g.st P).vS ∧ stM'.vS = (esM.g.st P).vS)
    (hst_vR_ne : ∀ τ, τ ≠ t0 → stLoc'.vR τ = (esLoc.g.st P).vR τ ∧ stM'.vR τ = (esM.g.st P).vR τ)
    (hbranch :
      (rsLoc' = rsLoc ∧ hM' = esM.h ∧ tblM' = tblM ∧ tblL' = tblL ∧
        ∃ rs', stLoc'.vR t0 = some rs' ∧ stM'.vR t0 = some (.inl rs')) ∨
      (∃ j rs' bk',
        !(qep + 1 < t0) = true ∧ inStage2BucketGen 4 tL par t0 = true ∧
        !(tL.isSome && (t0 == healEpoch tL)) = true ∧ j < (esM.h.sessions t0).length ∧
        let sIdx := q * (t0 - healEpoch tL) + j
        rsLoc' = Function.update rsLoc sIdx rs' ∧
        hM' = { esM.h with book := Function.update esM.h.book sIdx (some bk') } ∧
        stLoc'.vR t0 = some rs' ∧ stM'.vR t0 = some (.inr sIdx) ∧
        ActiveSessInv C ℓ encT idOf (!bk'.sCorr) (ks sIdx) (ssLoc sIdx) rs' bk' (tblM' sIdx) (tblL' sIdx) ∧
        (∀ i, i ≠ sIdx → tblM' i = tblM i ∧ tblL' i = tblL i))) :
    let pos : Pos := ⟨P.other, t0, idxOut⟩
    BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc rsLoc'
      { esLoc with g := esLoc.g.accept P stLoc' pos }
      { esM with g := esM.g.accept P stM' pos, h := hM' }
      esL tblM' tblL' := by
  intro pos
  have hbase := hinv.mono_rem (Nat.le_succ rem)
  have hP_notsend : P.sendsIn t0 = false := (not_sendsIn_iff_receiverOf P t0).mpr hP_recv
  have haep := accept_epoch_eq esLoc.g P stLoc' pos
  have hh_meta : hM'.lfWin = esM.h.lfWin ∧ hM'.sessions = esM.h.sessions ∧
      hM'.fTable = esM.h.fTable ∧ hM'.cache = esM.h.cache := by
    rcases hbranch with ⟨_, rfl, _, _, _⟩ | ⟨_, _, _, _, _, _, _, _, rfl, _⟩ <;>
      exact ⟨rfl, rfl, rfl, rfl⟩
  rcases hh_meta with ⟨hlf_eq, hsess_eq, hft_eq, hcache_eq⟩
  have hep_le : ∀ Q, esLoc.g.epoch Q ≤ (esLoc.g.accept P stLoc' pos).epoch Q := by
    intro Q; by_cases hQ : Q = P
    · subst hQ; rw [haep.1]; exact le_max_left _ _
    · rw [haep.2.1 Q hQ]
  have hne_of_healed : ∀ τ, healedBy esLoc.g.tL 3 τ = true → τ ≠ t0 := by
    intro τ hh heq; subst heq; rw [hunhealed] at hh; cases hh
  refine
    { gsync := hinv.gsync.accept_sync P stLoc' stM' pos
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := hinv.win_false
      lfWin_M := by dsimp only; rw [hlf_eq]; exact hinv.lfWin_M
      comp_unhealed := compUnhealed_accept hinv.comp_unhealed
      tL_mem_leaks := fun cur hc => by
        dsimp only at hc ⊢
        rw [haep.2.2.1] at hc
        rw [haep.2.2.2]
        exact hinv.tL_mem_leaks cur hc
      phase1_props := fun hp1 => Bool.noConfusion hp1
      phase2_props := fun _ => by
        dsimp only
        unfold postLeak
        rw [haep.2.2.1]
        exact hinv.phase2_props rfl
      sess_eq := by dsimp only; rw [hsess_eq]; exact hinv.sess_eq
      sess_nodup := fun τ => by dsimp only; rw [hsess_eq]; exact hinv.sess_nodup τ
      sess_zero_le := by dsimp only; rw [hsess_eq]; exact hinv.sess_zero_le
      sess_pos_bound := fun τ hτ => by dsimp only; rw [hsess_eq]; exact hbase.sess_pos_bound τ hτ
      sess_epoch_ok := fun τ hne => by dsimp only at hne ⊢; rw [hsess_eq] at hne; exact hinv.sess_epoch_ok τ hne
      fTable_M_iff := fun τ ik => by dsimp only; rw [hft_eq, hsess_eq]; exact hinv.fTable_M_iff τ ik
      fTable_loc_eq := fun τ ik => by dsimp only; rw [hsess_eq]; exact hinv.fTable_loc_eq τ ik
      cache_sync := fun τ => by dsimp only; rw [hcache_eq, hsess_eq]; exact hinv.cache_sync τ
      vp_id := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst Q; simp [Function.update_self, hst_id.1, hst_id.2]
        · simp [Function.update_of_ne hQ, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
      vp_tcur_eq := fun Q => by
        by_cases hQ : Q = P
        · subst Q
          have h1 : ((esLoc.g.accept P stLoc' pos).st P).tcur = max (esLoc.g.epoch P) t0 := by
            simp [GameState.accept, GameState.delete, Function.update_self, hst_tcur.1]
          have h2 : ((esM.g.accept P stM' pos).st P).tcur = max (esLoc.g.epoch P) t0 := by
            simp [GameState.accept, GameState.delete, Function.update_self, hst_tcur.2]
          dsimp only at haep ⊢
          rw [haep.1, h1, h2]
          exact ⟨rfl, rfl⟩
        · have h1 : ((esLoc.g.accept P stLoc' pos).st Q).tcur = (esLoc.g.st Q).tcur := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          have h2 : ((esM.g.accept P stM' pos).st Q).tcur = (esM.g.st Q).tcur := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          dsimp only
          rw [haep.2.1 Q hQ, h1, h2]
          exact hinv.vp_tcur_eq Q
      vp_γ_eq := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst Q; simp [Function.update_self, hst_γ]
        · simp [Function.update_of_ne hQ, hinv.vp_γ_eq Q]
      vp_root_eq := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst Q; simp [Function.update_self, hst_root]
        · simp [Function.update_of_ne hQ, hinv.vp_root_eq Q]
      vp_cka_eq := fun Q => by
        dsimp only [GameState.accept, GameState.delete]
        by_cases hQ : Q = P
        · subst Q; simp [Function.update_self, hst_cka.1, hst_cka.2, hinv.vp_cka_eq P]
        · simp [Function.update_of_ne hQ, hinv.vp_cka_eq Q]
      vp_cka_cache := fun Q hsends => by
        dsimp only at hsends ⊢
        rw [hcache_eq]
        by_cases hQ : Q = P
        · subst Q
          rw [haep.1] at hsends ⊢
          dsimp only [pos] at hsends ⊢
          by_cases ht0_le : t0 ≤ esLoc.g.epoch P
          · have hmax : max (esLoc.g.epoch P) t0 = esLoc.g.epoch P := Nat.max_eq_left ht0_le
            rw [hmax] at hsends ⊢
            have hcka_loc : ((esLoc.g.accept P stLoc' pos).st P).curCkaMsg = (esLoc.g.st P).curCkaMsg := by
              simp [GameState.accept, GameState.delete, Function.update_self, hst_cka.1]
            have hvS_M : ((esM.g.accept P stM' pos).st P).vS = (esM.g.st P).vS := by
              simp [GameState.accept, GameState.delete, Function.update_self, hst_vS.2]
            rw [hcka_loc, hvS_M]
            exact hinv.vp_cka_cache P hsends
          · have hmax : max (esLoc.g.epoch P) t0 = t0 := by omega
            rw [hmax, hP_notsend] at hsends
            cases hsends
        · rw [haep.2.1 Q hQ] at hsends ⊢
          have hcka_loc : ((esLoc.g.accept P stLoc' pos).st Q).curCkaMsg = (esLoc.g.st Q).curCkaMsg := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          have hvS_M : ((esM.g.accept P stM' pos).st Q).vS = (esM.g.st Q).vS := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          rw [hcka_loc, hvS_M]
          exact hinv.vp_cka_cache Q hsends
      epoch_bound := fun Q => by
        dsimp only
        by_cases hQ : Q = P
        · subst Q
          rw [haep.1]; dsimp only [pos]
          have hbP := hinv.epoch_bound P
          have hbO := hinv.epoch_bound P.other
          omega
        · rw [haep.2.1 Q hQ]
          exact hbase.epoch_bound Q
      vS_sync := fun Q => by
        dsimp only
        rw [hsess_eq]
        by_cases hQ : Q = P
        · subst Q
          have hvL : ((esLoc.g.accept P stLoc' pos).st P).vS = (esLoc.g.st P).vS := by
            simp [GameState.accept, GameState.delete, Function.update_self, hst_vS.1]
          have hvM : ((esM.g.accept P stM' pos).st P).vS = (esM.g.st P).vS := by
            simp [GameState.accept, GameState.delete, Function.update_self, hst_vS.2]
          rw [hvL, hvM, haep.1]; dsimp only [pos]
          rcases hinv.vS_sync P with h1 | h2 | ⟨τ, j, hτ_le, hτ_send, hrest⟩
          · exact Or.inl h1
          · exact Or.inr (Or.inl h2)
          · refine Or.inr (Or.inr ⟨τ, j, le_trans hτ_le (le_max_left _ _), ?_, hrest⟩)
            intro hs
            by_cases ht0_le : t0 ≤ esLoc.g.epoch P
            · have hmax : max (esLoc.g.epoch P) t0 = esLoc.g.epoch P := Nat.max_eq_left ht0_le
              rw [hmax] at hs ⊢
              exact hτ_send hs
            · have hmax : max (esLoc.g.epoch P) t0 = t0 := by omega
              rw [hmax, hP_notsend] at hs
              cases hs
        · have hvL : ((esLoc.g.accept P stLoc' pos).st Q).vS = (esLoc.g.st Q).vS := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          have hvM : ((esM.g.accept P stM' pos).st Q).vS = (esM.g.st Q).vS := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          rw [hvL, hvM, haep.2.1 Q hQ]
          exact hinv.vS_sync Q
      vR_dom := fun Q τ his => by
        dsimp only at his ⊢
        by_cases hQ : Q = P
        · subst Q
          rw [haep.1]; dsimp only [pos]
          by_cases hτ : τ = t0
          · subst τ
            exact ⟨le_max_right _ _, hP_recv⟩
          · have hvM : ((esM.g.accept P stM' pos).st P).vR τ = (esM.g.st P).vR τ := by
              simp [GameState.accept, GameState.delete, Function.update_self, (hst_vR_ne τ hτ).2]
            rw [hvM] at his
            rcases hinv.vR_dom P τ his with ⟨hle, hrec⟩
            exact ⟨le_trans hle (le_max_left _ _), hrec⟩
        · rw [haep.2.1 Q hQ]
          have hvM : ((esM.g.accept P stM' pos).st Q).vR τ = (esM.g.st Q).vR τ := by
            simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
          rw [hvM] at his
          exact hinv.vR_dom Q τ his
      vR_sync := fun Q τ => by
        dsimp only
        rw [hsess_eq]
        rcases hbranch with ⟨rfl, _, _, _, rs', hvL0, hvM0⟩ |
            ⟨j, rs', bk', hcap, hbk, hnot_tH, hj_len, hrest⟩
        · by_cases hQP : Q = P ∧ τ = t0
          · obtain ⟨hQ, hτ⟩ := hQP
            subst Q; subst τ
            have hvL : ((esLoc.g.accept P stLoc' pos).st P).vR t0 = some rs' := by
              simp [GameState.accept, GameState.delete, Function.update_self, hvL0]
            have hvM : ((esM.g.accept P stM' pos).st P).vR t0 = some (.inl rs') := by
              simp [GameState.accept, GameState.delete, Function.update_self, hvM0]
            exact Or.inr (Or.inl ⟨rs', hvL, hvM⟩)
          · have hv_eq : ((esLoc.g.accept P stLoc' pos).st Q).vR τ = (esLoc.g.st Q).vR τ ∧
                ((esM.g.accept P stM' pos).st Q).vR τ = (esM.g.st Q).vR τ := by
              by_cases hQ : Q = P
              · subst Q
                have hτ : τ ≠ t0 := fun heq => hQP ⟨rfl, heq⟩
                simp [GameState.accept, GameState.delete, Function.update_self,
                  (hst_vR_ne τ hτ).1, (hst_vR_ne τ hτ).2]
              · simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
            rw [hv_eq.1, hv_eq.2]
            exact hinv.vR_sync Q τ
        · dsimp only at hrest
          rcases hrest with ⟨rfl, _, hvL0, hvM0, _, _⟩
          let sIdx := q * (t0 - healEpoch tL) + j
          have hj_q : j < q := by
            by_cases ht0_0 : t0 = 0
            · subst ht0_0; have := hinv.sess_zero_le; omega
            · have := hinv.sess_pos_bound t0 (by omega); omega
          have htH : healEpoch tL ≤ t0 := healEpoch_le_of_gen4 hbk
          by_cases hQP : Q = P ∧ τ = t0
          · obtain ⟨hQ, hτ⟩ := hQP
            subst Q; subst τ
            have hvL : ((esLoc.g.accept P stLoc' pos).st P).vR t0 =
                some (Function.update rsLoc sIdx rs' sIdx) := by
              simp [GameState.accept, GameState.delete, Function.update_self, hvL0]
            have hvM : ((esM.g.accept P stM' pos).st P).vR t0 = some (.inr sIdx) := by
              simp [GameState.accept, GameState.delete, Function.update_self, hvM0, sIdx]
            exact Or.inr (Or.inr ⟨j, hP_recv, hcap, hbk, hnot_tH, hj_len, hvL, hvM⟩)
          · have hv_eq : ((esLoc.g.accept P stLoc' pos).st Q).vR τ = (esLoc.g.st Q).vR τ ∧
                ((esM.g.accept P stM' pos).st Q).vR τ = (esM.g.st Q).vR τ := by
              by_cases hQ : Q = P
              · subst Q
                have hτ : τ ≠ t0 := fun heq => hQP ⟨rfl, heq⟩
                simp [GameState.accept, GameState.delete, Function.update_self,
                  (hst_vR_ne τ hτ).1, (hst_vR_ne τ hτ).2]
              · simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
            rw [hv_eq.1, hv_eq.2]
            rcases hinv.vR_sync Q τ with h1 | h2 | ⟨j', hQ_rec, hc', hb', hn', hj'_len, hvL', hvM'⟩
            · exact Or.inl h1
            · exact Or.inr (Or.inl h2)
            · have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
                intro heq
                have hj'_q : j' < q := by
                  by_cases hτ_0 : τ = 0
                  · subst hτ_0; have := hinv.sess_zero_le; omega
                  · have := hinv.sess_pos_bound τ (by omega); omega
                obtain ⟨hτ_eq, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hb') htH hj'_q hj_q heq
                subst τ
                exact hQP ⟨hQ_rec.trans hP_recv.symm, rfl⟩
              refine Or.inr (Or.inr ⟨j', hQ_rec, hc', hb', hn', hj'_len, ?_, hvM'⟩)
              rw [Function.update_of_ne hne_s]
              exact hvL'
      sess_inv := fun i => by
        dsimp only
        rcases hbranch with ⟨rfl, rfl, rfl, rfl, _⟩ |
            ⟨j, rs', bk', _, _, _, _, hrest⟩
        · exact hinv.sess_inv i
        · dsimp only at hrest
          rcases hrest with ⟨rfl, rfl, _, _, hsess_sIdx, htbl_ne⟩
          let sIdx := q * (t0 - healEpoch tL) + j
          by_cases hi : i = sIdx
          · subst hi
            simpa [sIdx, Function.update_self] using hsess_sIdx
          · rcases htbl_ne i hi with ⟨htM, htL⟩
            rw [htM, htL]
            simpa [sIdx, Function.update_of_ne hi] using hinv.sess_inv i
      ss_fresh := fun τ j' h1 h2 hj' hlt =>
        hinv.ss_fresh τ j' h1 h2 hj' (lt_of_le_of_lt (hep_le _) hlt)
      rs_fresh := fun τ j' h1 h2 hj' hlt => by
        dsimp only at hlt ⊢
        have hlt0 : esLoc.g.epoch (Party.receiverOf τ) < τ := lt_of_le_of_lt (hep_le _) hlt
        rcases hbranch with ⟨rfl, _⟩ | ⟨j, rs', bk', _, hbk, _, hj_len, hrest⟩
        · exact hinv.rs_fresh τ j' h1 h2 hj' hlt0
        · dsimp only at hrest
          rcases hrest with ⟨rfl, _⟩
          have hj_q : j < q := by
            by_cases ht0_0 : t0 = 0
            · subst ht0_0; have := hinv.sess_zero_le; omega
            · have := hinv.sess_pos_bound t0 (by omega); omega
          have hne_s : q * (τ - healEpoch tL) + j' ≠ q * (t0 - healEpoch tL) + j := by
            intro heq
            obtain ⟨hτ_eq, _⟩ := bucketSlot_inj h2 (healEpoch_le_of_gen4 hbk) hj' hj_q heq
            subst hτ_eq
            rw [← hP_recv, haep.1] at hlt
            dsimp only [pos] at hlt
            omega
          rw [Function.update_of_ne hne_s]
          exact hinv.rs_fresh τ j' h1 h2 hj' hlt0
      book_fresh_before_send := fun τ j' h1 h2 hj' hlt hh => by
        dsimp only at hlt hh ⊢
        rw [haep.2.2.1] at hh
        have hlt0 : esLoc.g.epoch (Party.senderOf τ) < τ := lt_of_le_of_lt (hep_le _) hlt
        rcases hbranch with ⟨_, rfl, _⟩ | ⟨j, rs', bk', _, hbk, _, hj_len, hrest⟩
        · exact hinv.book_fresh_before_send τ j' h1 h2 hj' hlt0 hh
        · dsimp only at hrest
          rcases hrest with ⟨_, rfl, _⟩
          have hj_q : j < q := by
            by_cases ht0_0 : t0 = 0
            · subst ht0_0; have := hinv.sess_zero_le; omega
            · have := hinv.sess_pos_bound t0 (by omega); omega
          have hne_s : q * (τ - healEpoch tL) + j' ≠ q * (t0 - healEpoch tL) + j := by
            intro heq
            obtain ⟨hτ_eq, _⟩ := bucketSlot_inj h2 (healEpoch_le_of_gen4 hbk) hj' hj_q heq
            exact hne_of_healed τ hh hτ_eq
          dsimp only
          rw [Function.update_of_ne hne_s]
          exact hinv.book_fresh_before_send τ j' h1 h2 hj' hlt0 hh
      trans_meta := fun rec hr => by
        dsimp only [GameState.accept, GameState.delete] at hr
        rw [List.mem_filter] at hr
        rcases hinv.trans_meta rec hr.1 with ⟨h1, h2, h3, h4, h5⟩
        dsimp only
        rw [hcache_eq]
        exact ⟨h1, h2, le_trans h3 (hep_le _), h4, h5⟩
      cache_empty_gt := fun τ hlt => by
        dsimp only at hlt ⊢
        rw [hcache_eq]
        exact hinv.cache_empty_gt τ (lt_of_le_of_lt (hep_le _) hlt)
      healed_sender_pin := fun Q τ j' hs he hv hh => by
        dsimp only at hs he hv hh ⊢
        rw [haep.2.2.1] at hh
        have hτ_ne : τ ≠ t0 := hne_of_healed τ hh
        have hQ_same : (esLoc.g.accept P stLoc' pos).epoch Q = esLoc.g.epoch Q ∧
            ((esM.g.accept P stM' pos).st Q).vS = (esM.g.st Q).vS ∧
            ((esM.g.accept P stM' pos).st Q).curCkaMsg = (esM.g.st Q).curCkaMsg := by
          by_cases hQ : Q = P
          · subst Q
            rw [haep.1] at hs he ⊢; dsimp only [pos] at hs he ⊢
            by_cases ht0_le : t0 ≤ esLoc.g.epoch P
            · refine ⟨Nat.max_eq_left ht0_le, ?_, ?_⟩
              · simp [GameState.accept, GameState.delete, Function.update_self, hst_vS.2]
              · simp [GameState.accept, GameState.delete, Function.update_self, hst_cka.2]
            · have hmax : max (esLoc.g.epoch P) t0 = t0 := by omega
              rw [hmax, hP_notsend] at hs; cases hs
          · refine ⟨haep.2.1 Q hQ, ?_, ?_⟩
            · simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
            · simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
        rw [hQ_same.1] at hs he
        rw [hQ_same.2.1] at hv
        have hidx_eq : (esLoc.g.accept P stLoc' pos).idx Q = esLoc.g.idx Q := rfl
        rw [hidx_eq, hQ_same.2.2, hcache_eq]
        have hbk_eq : (hM'.book (q * (τ - healEpoch tL) + j')).getD {} =
            (esM.h.book (q * (τ - healEpoch tL) + j')).getD {} := by
          rcases hbranch with ⟨_, rfl, _⟩ | ⟨j, rs', bk', _, hbk, _, hj_len, hrest⟩
          · rfl
          · dsimp only at hrest
            rcases hrest with ⟨_, rfl, _⟩
            have hj_q : j < q := by
              by_cases ht0_0 : t0 = 0
              · subst ht0_0; have := hinv.sess_zero_le; omega
              · have := hinv.sess_pos_bound t0 (by omega); omega
            rcases hinv.vS_sync Q with ⟨_, hvn⟩ | ⟨_, _, hvn⟩ | ⟨τ', j'', _, hτ'_send, _, _, hbk', _, hj''_len, _, hvM'⟩
            · rw [hvn] at hv; cases hv
            · rw [hvn] at hv; cases hv
            · have hτ'_eq : τ' = τ := by rw [hτ'_send hs]; exact he.symm
              subst τ'
              rw [hv] at hvM'
              injection hvM' with hvM'
              injection hvM' with hs_eq
              have hj''_q : j'' < q := by
                by_cases hτ_0 : τ = 0
                · subst hτ_0; have := hinv.sess_zero_le; omega
                · have := hinv.sess_pos_bound τ (by omega); omega
              have hne_s : q * (τ - healEpoch tL) + j' ≠ q * (t0 - healEpoch tL) + j := by
                intro heq
                rw [hs_eq] at heq
                obtain ⟨hτ_t0, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hbk') (healEpoch_le_of_gen4 hbk) hj''_q hj_q heq
                exact hτ_ne hτ_t0
              simp [Function.update_of_ne hne_s]
        rw [hbk_eq]
        exact hinv.healed_sender_pin Q τ j' hs he hv hh
      healed_vR_pin := fun Q τ sIdx' hv hh => by
        dsimp only at hv hh ⊢
        rw [haep.2.2.1] at hh
        have hτ_ne : τ ≠ t0 := hne_of_healed τ hh
        have hvM : ((esM.g.accept P stM' pos).st Q).vR τ = (esM.g.st Q).vR τ := by
          by_cases hQ : Q = P
          · subst Q; simp [GameState.accept, GameState.delete, Function.update_self, (hst_vR_ne τ hτ_ne).2]
          · simp [GameState.accept, GameState.delete, Function.update_of_ne hQ]
        rw [hvM] at hv
        rw [hcache_eq]
        exact hinv.healed_vR_pin Q τ sIdx' hv hh
      healed_book_trans := fun τ sIdx' hh hro hp => by
        dsimp only at hh hro hp ⊢
        rw [haep.2.2.1] at hh
        rw [hcache_eq] at hp
        have hτ_ne : τ ≠ t0 := hne_of_healed τ hh
        have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
            (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
          rcases hro with hlt | hvR
          · exact Or.inl (lt_of_le_of_lt (hep_le _) hlt)
          · refine Or.inr ?_
            by_cases hQ : Party.receiverOf τ = P
            · rw [hQ] at hvR ⊢
              simpa [GameState.accept, GameState.delete, Function.update_self,
                (hst_vR_ne τ hτ_ne).2] using hvR
            · simpa [GameState.accept, GameState.delete, Function.update_of_ne hQ] using hvR
        have hbk_eq : (hM'.book sIdx').getD {} = (esM.h.book sIdx').getD {} := by
          rcases hbranch with ⟨_, rfl, _⟩ | ⟨j, rs', bk', _, hbk, _, hj_len, hrest⟩
          · rfl
          · dsimp only at hrest
            rcases hrest with ⟨_, rfl, _⟩
            have hj_q : j < q := by
              by_cases ht0_0 : t0 = 0
              · subst ht0_0; have := hinv.sess_zero_le; omega
              · have := hinv.sess_pos_bound t0 (by omega); omega
            have hne_s : sIdx' ≠ q * (t0 - healEpoch tL) + j := by
              intro heq; subst heq
              rcases hp with ⟨h0, hs0, _, htL_n⟩ | ⟨h1, Tc, σc, kMulti, hc⟩
              · subst h0
                have ht0_pos : 1 ≤ t0 := by omega
                have hsub : t0 - healEpoch tL = t0 := by subst htL_n; simp [healEpoch]
                rw [hsub] at hs0
                have hmul : 0 < q * t0 := Nat.mul_pos hq_pos ht0_pos
                omega
              · rcases hinv.cache_sync τ with ⟨_, hcn⟩ | ⟨_, _, _, _, _, hcn⟩ |
                    ⟨_, _, _, j', _, hj'_len, _, hbk', _, _, hcs⟩
                · rw [hcn] at hc; cases hc
                · rw [hcn] at hc; cases hc
                · rw [hcs] at hc
                  simp only [Option.some.injEq, Prod.mk.injEq] at hc
                  have hj'_q : j' < q := by have := hinv.sess_pos_bound τ h1; omega
                  obtain ⟨hτ_t0, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hbk')
                    (healEpoch_le_of_gen4 hbk) hj'_q hj_q hc.2.2.2
                  exact hτ_ne hτ_t0
            simp [Function.update_of_ne hne_s]
        have htr_eq : ((esLoc.g.accept P stLoc' pos).trans.filter (fun r => r.pos.epoch == τ)) =
            (esLoc.g.trans.filter (fun r => r.pos.epoch == τ)) := by
          dsimp only [GameState.accept, GameState.delete]
          rw [List.filter_filter]
          apply List.filter_congr
          intro rec _
          by_cases he : (rec.pos.epoch == τ) = true
          · have hrec_ep : rec.pos.epoch = τ := of_decide_eq_true (beq_iff_eq.mp he |> decide_eq_true)
            have hpne : (rec.pos != pos) = true := by
              rw [bne_iff_ne]
              intro hp_eq
              apply hτ_ne
              rw [← hrec_ep, hp_eq]
            simp [he, hpne]
          · simp only [Bool.not_eq_true] at he
            simp [he]
        rw [hbk_eq, htr_eq]
        exact hinv.healed_book_trans τ sIdx' hh hro_orig hp }

private theorem step2_deliverForge_aux_reject_same_book_inv
    {Pt : Type} [DecidableEq Pt]
    {C : Crypto} {ℓ q qep rem : ℕ} {encT : Pt → PublicKey} {idOf : Party → IdentityKey}
    {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {ssLoc : ℕ → RatchetSenderState (BitVec 256)}
    {rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256)}
    {esLoc : LocES Pt ℓ} {esM esL : MultiES Pt ℓ} {tblM tblL : ℕ → SessHSt Pt ℓ}
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (sIdx : ℕ) (sM' sL' : SessHSt Pt ℓ)
    (hsess' : ActiveSessInv C ℓ encT idOf (!((esM.h.book sIdx).getD {}).sCorr) (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((esM.h.book sIdx).getD {}) sM' sL') :
    BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc rsLoc esLoc esM esL
      (Function.update tblM sIdx sM') (Function.update tblL sIdx sL') :=
  { hinv.mono_rem (Nat.le_succ rem) with
    sess_inv := fun i => by
      by_cases hi : i = sIdx
      · subst i; simpa [Function.update_self] using hsess'
      · simpa [Function.update_of_ne hi] using hinv.sess_inv i }

private def step2_deliverForge_aux_vRecvPost {Γv T Sv SSv RSv M : Type}
    (s₁ : VP Γv T Sv SSv RSv) (t0 : ℕ) :
    Option (Option (RSv × ℕ × M)) → Option (Option (VP Γv T Sv SSv RSv × ℕ × ℕ × M))
  | none => none
  | some none => some none
  | some (some (v', i, m)) =>
    some (some ({ s₁ with vR := Function.update s₁.vR t0 (some v') }, t0, i, m))

private theorem step2_deliverForge_aux_vRecv_eq
    {ι : Type} {tspec : OracleSpec.{0, 0} ι}
    {HS Γ T Sig SS RS M E CCoins Γv Sv SSv RSv : Type}
    (hk : _root_.CryptoGames.SM.Engine.Hooks tspec HS Γ T Sig SS RS M E CCoins Γv Sv SSv RSv)
    (ctx : Ctx Γv T Sv SSv RSv M E) (P : Party)
    (s s₁ : VP Γv T Sv SSv RSv) (c' : Header T × E) (h : HS) (v0 : RSv)
    (hguard : (s.id.sendsIn c'.1.1 || decide (s.tcur + 1 < c'.1.1)) = false)
    (hs1 :
      (c'.1.1 = s.tcur + 1 ∧ ∃ Tc γ' σ', c'.1.2 = some Tc ∧
        (hk.startRecv ctx P c'.1.1 s.γ s.root Tc).run h = pure (some (some (γ', σ', v0)), h) ∧
        s₁ = { s with tcur := c'.1.1, γ := γ', root := σ',
                      vR := Function.update s.vR c'.1.1 (some v0) }) ∨
      (c'.1.1 ≠ s.tcur + 1 ∧ s.vR c'.1.1 = some v0 ∧ s₁ = s)) :
    (vRecv hk ctx P s c' none).run h =
      ((hk.fsRecv ctx P c'.1.1 v0 c'.1 c'.2 none).run h >>= fun p =>
        pure (step2_deliverForge_aux_vRecvPost s₁ c'.1.1 p.1, p.2)) := by
  unfold vRecv
  simp only [pure_bind, hguard, Bool.false_eq_true, ↓reduceIte]
  rcases hs1 with ⟨ht, Tc, γ', σ', hhdr2, hsr, rfl⟩ | ⟨hne, hvR, rfl⟩
  · have hsr' : (hk.startRecv ctx P (s.tcur + 1) s.γ s.root Tc).run h =
        pure (some (some (γ', σ', v0)), h) := ht ▸ hsr
    simp only [ht, ↓reduceIte, hhdr2, StateT.run_bind, hsr', pure_bind,
      Function.update_self]
    congr 1; funext p
    rcases p with ⟨_ | _ | ⟨v', i, m⟩, h'⟩ <;> simp [StateT.run_pure, step2_deliverForge_aux_vRecvPost]
  · simp only [hne, ↓reduceIte, StateT.run_bind, hvR]
    congr 1; funext p
    rcases p with ⟨_ | _ | ⟨v', i, m⟩, h'⟩ <;> simp [StateT.run_pure, step2_deliverForge_aux_vRecvPost]

private theorem step2_deliverForge_aux_post_loc
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (esLoc : LocES Pt ℓ) (P : Party) (c c' : Fig8C Pt)
    (rec0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt))
    (resLoc : Option (LocVP Pt × ℕ × ℕ × (LibsignalMsgPublicPart × Plain ℓ)))
    (hab : esLoc.abort = false) (hw : esLoc.g.win = false)
    (hit : esLoc.g.inTransit P.other c = some rec0)
    (hg : ((esLoc.g.inTransit P.other c').isSome || esLoc.g.comp.contains rec0.pos || (c.1 != c'.1)) = false)
    (hv : (vRecv (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        esLoc.g P (esLoc.g.st P) c' none).run esLoc.h = pure (some resLoc, esLoc.h)) :
    simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
        3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr (.inr ⟨P, c, c'⟩))).run esLoc) =
    match resLoc with
    | none => pure (some .rejected, esLoc)
    | some (stLoc', t', i', m') =>
      if decide (qep + 1 < t') || (t' != rec0.pos.epoch) then
        pure (some .rejected, esLoc)
      else if esLoc.g.trivial 3 ⟨P.other, t', i'⟩ then
        pure (some (.accepted t' i' (some m')),
          { esLoc with g := esLoc.g.accept P stLoc' ⟨P.other, t', i'⟩ })
      else if (bucketAuthCfg (Msg := LibsignalMsgPublicPart × Plain ℓ) 1 tL par).injectFull t' then
        pure (some .rejected, { esLoc with g := { esLoc.g with win := true } })
      else
        pure (some .rejected, esLoc) := by
  rcases esLoc with ⟨gL, hL, abL⟩
  dsimp only at hab hw hit hg hv ⊢
  subst abL
  dsimp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr, deliverForgeE]
  simp only [StateT.run_bind, StateT.run_get, pure_bind, hw, Bool.or_self,
    Bool.false_eq_true, ↓reduceIte, hit, hg, run_liftH_eq, hv]
  rcases resLoc with _ | ⟨stLoc', t', i', m'⟩
  · simp only [StateT.run_pure, simulateQ_pure]
  · cases hcap : (decide (qep + 1 < t') || (t' != rec0.pos.epoch))
    · simp only [hcap, Bool.false_eq_true, ↓reduceIte]
      cases htriv : gL.trivial 3 ⟨P.other, t', i'⟩
      · simp only [Bool.false_eq_true, ↓reduceIte]
        cases hinj : (bucketAuthCfg (Msg := LibsignalMsgPublicPart × Plain ℓ) 1 tL par).injectFull t'
        · simp only [Bool.false_eq_true, ↓reduceIte, StateT.run_pure, simulateQ_pure]
        · simp only [↓reduceIte, StateT.run_bind, StateT.run_modify, StateT.run_pure,
            pure_bind, simulateQ_pure]
      · simp only [↓reduceIte, commitE, run_liftH_eq, hkLocOpt, hooksSlotBucketOptAt,
          StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind, simulateQ_pure,
          accept_update_idem]
    · simp only [hcap, ↓reduceIte, StateT.run_pure, simulateQ_pure]

private theorem step2_deliverForge_aux_post_fsm
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool)
    (esM : MultiES Pt ℓ) (P : Party) (c c' : Fig8C Pt)
    (rec0 : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt))
    (resM : Option (MultiVP Pt × ℕ × ℕ × (LibsignalMsgPublicPart × Plain ℓ)))
    (hM' : MultiHS Pt) (tblM tblM' : ℕ → SessHSt Pt ℓ)
    (hab : esM.abort = false) (hw : esM.g.win = false)
    (hit : esM.g.inTransit P.other c = some rec0)
    (hg : ((esM.g.inTransit P.other c').isSome || esM.g.comp.contains rec0.pos || (c.1 != c'.1)) = false)
    (hv : (simulateQ (pubFsImplOpt C ℓ encT idOf false)
      ((vRecv (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
        esM.g P (esM.g.st P) c' none).run esM.h)).run (fun _ => false, tblM) =
      pure ((some resM, hM'), (fun _ => false, tblM'))) :
    (simulateQ (pubFsImplOpt C ℓ encT idOf false)
      (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
        3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr (.inr ⟨P, c, c'⟩))).run esM)).run
      (fun _ => false, tblM) =
    match resM with
    | none => pure ((some .rejected, { esM with h := hM' }), (fun _ => false, tblM'))
    | some (stM', t', i', m') =>
      if decide (qep + 1 < t') || (t' != rec0.pos.epoch) then
        pure ((some .rejected, { esM with h := hM' }), (fun _ => false, tblM'))
      else if esM.g.trivial 3 ⟨P.other, t', i'⟩ then
        pure ((some (.accepted t' i' (some m')),
          { esM with g := esM.g.accept P stM' ⟨P.other, t', i'⟩, h := hM' }),
          (fun _ => false, tblM'))
      else if (bucketAuthCfg (Msg := LibsignalMsgPublicPart × Plain ℓ) 1 tL par).injectFull t' then
        pure ((some .rejected, { esM with g := { esM.g with win := true }, h := hM' }),
          (fun _ => false, tblM'))
      else
        pure ((some .rejected, { esM with h := hM' }), (fun _ => false, tblM')) := by
  rcases esM with ⟨gM, hM0, abM⟩
  dsimp only at hab hw hit hg hv ⊢
  subst abM
  rcases resM with _ | ⟨stM', t', i', m'⟩
  · dsimp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr, deliverForgeE]
    simp only [StateT.run_bind, StateT.run_get, pure_bind, hw, Bool.or_self,
      Bool.false_eq_true, ↓reduceIte, hit, hg, run_liftH_eq, bind_assoc, simulateQ_bind]
    rw [hv]
    simp only [pure_bind, StateT.run_pure, simulateQ_pure]
  · dsimp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr, deliverForgeE]
    simp only [StateT.run_bind, StateT.run_get, pure_bind, hw, Bool.or_self,
      Bool.false_eq_true, ↓reduceIte, hit, hg, run_liftH_eq, bind_assoc, simulateQ_bind]
    rw [hv]
    simp only [pure_bind]
    cases hcap : (decide (qep + 1 < t') || (t' != rec0.pos.epoch))
    · simp only [Bool.false_eq_true, ↓reduceIte]
      cases htriv : gM.trivial 3 ⟨P.other, t', i'⟩
      · simp only [Bool.false_eq_true, ↓reduceIte]
        cases hinj : (bucketAuthCfg (Msg := LibsignalMsgPublicPart × Plain ℓ) 1 tL par).injectFull t'
        · simp only [Bool.false_eq_true, ↓reduceIte, StateT.run_pure, simulateQ_pure]
        · simp only [↓reduceIte, StateT.run_bind, StateT.run_modify, StateT.run_pure,
            pure_bind, simulateQ_pure]
      · simp only [↓reduceIte, commitE, run_liftH_eq, hkMultiOpt_commit,
          StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind, simulateQ_pure,
          accept_update_idem]
    · simp only [↓reduceIte, StateT.run_pure, simulateQ_pure]

set_option linter.unusedVariables false in
private theorem step2_deliverForge {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (hD : ∀ k x, C.D k (C.E k x) = x)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey)
    (hinj : Function.Injective encT) (hdum : ∀ T, encT T ≠ dummyKey)
    (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (hℓ : ℓ < 10 ^ 6) (hq_pos : 0 < q)
    (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (c c' : Fig8C Pt)
    {α : Type}
    (r : (Fig8SpecDF Pt ℓ).Range (.inr ⟨P, c, c'⟩) →
      OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inr ⟨P, c, c'⟩
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  intro qr
  have habL : esLoc.abort = false := hinv.abort_loc
  have habM : esM.abort = false := hinv.abort_M
  have hwL : esLoc.g.win = false := hinv.win_false
  have hwM : esM.g.win = false := hinv.gsync.win_eq.symm.trans hwL
  have hit_eq : esM.g.inTransit P.other c = esLoc.g.inTransit P.other c :=
    step2_deliverForge_aux_inTransit_eq hinv.gsync P.other c
  have hit_eq' : esM.g.inTransit P.other c' = esLoc.g.inTransit P.other c' :=
    step2_deliverForge_aux_inTransit_eq hinv.gsync P.other c'
  have hcomp_eq : esM.g.comp = esLoc.g.comp := hinv.gsync.comp_eq.symm
  have step_nonwin : ∀ (u : (Fig8SpecDF Pt ℓ).Range qr)
      (ssLoc' : ℕ → RatchetSenderState (BitVec 256))
      (rsLoc' : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
      (esLoc' : LocES Pt ℓ) (esM' esL' : MultiES Pt ℓ) (tblM' tblL' : ℕ → SessHSt Pt ℓ),
      esLoc'.g.win = false → esM'.g.win = false →
      simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
        (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
          3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
        pure (u, esLoc') →
      (simulateQ (pubFsImplOpt C ℓ encT idOf false)
        (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
          3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run
        (fun _ => false, tblM) =
        pure ((u, esM'), (fun _ => false, tblM')) →
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
          (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
