private theorem init_coupled_leAdd {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (lam : Pt) (ℓ q qep : ℕ) (hq0 : 0 < q) (tL : Option ℕ) (par : Bool)
    (ks : ℕ → BitVec 256) (bs : ℕ → Bool)
    (A : AdversaryDF (Fig8St Pt) (LibsignalMsgPublicPart × Plain ℓ) (BitVec 256) (Fig8C Pt))
    (hPhase1 : ∀ ssLoc rsLoc esLoc esM esL tblM tblL,
      BucketSimInv C ℓ encT idOf q qep tL par ks true q ssLoc rsLoc esLoc esM esL tblM tblL →
      LeAdd
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks A esLoc none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false A esM none tblM)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true A esL none tblL)) :
    let M_sess := ((qep + 2) - healEpoch tL) * q
    let tbl0 := fun i => hInit (bs i) (.seed (ks i))
    LeAdd
      (localSlotBucketOptAt mode q M_sess ks (dhScheme Dh) (rootPRNG C.F encPt)
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam qep tL par A)
      (Prod.fst <$> (simulateQ (pubFsImplOpt C ℓ encT idOf false)
        (redFSAuthDFPaperMultiBucketOpt mode (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
          (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 1 4 qep false tL par A)).run
        (fun _ => false, tbl0))
      (Prod.fst <$> (simulateQ (pubFsImplOpt C ℓ encT idOf true)
        (redFSAuthDFPaperMultiBucketOpt mode (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
          (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 1 4 qep true tL par A)).run
        (fun _ => false, tbl0)) := by
  intro M_sess tbl0
  rw [redFSAuthDFPaperMultiBucketOpt_eq mode (q + 1),
      redFSAuthDFPaperMultiBucketOpt_eq mode (q + 1)]
  unfold localSlotBucketOptAt engRunDFPaperBucketMode initSlotBucketAt initFSMultiDFBucketPaper
  simp only [StateT.run_bind, StateT.run_lift, StateT.run_get, StateT.run_set, StateT.run_pure,
    bind_assoc, pure_bind, simulateQ_bind, simulateQ_pure, map_bind, map_pure,
    sim_sampleT_lImpl, bucketRawOut_some_eq]
  rw [sim_sampleT_pubImpl _ (fun _ => false, tbl0),
      sim_sampleT_pubImpl _ (fun _ => false, tbl0)]
  simp only [bind_assoc, pure_bind]
  refine leAdd_bind ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) fun kr _ => ?_
  rw [sim_sampleT_pubImpl _ (fun _ => false, tbl0),
      sim_sampleT_pubImpl _ (fun _ => false, tbl0)]
  simp only [bind_assoc, pure_bind]
  refine leAdd_bind ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) fun kc _ => ?_
  rw [sim_rootSlotBucketAt, sim_rootFSMultiDFBucketPaper, sim_rootFSMultiDFBucketPaper]
  have h1 : (false || decide (qep + 1 < 0)) = false := by simp
  have h2 : (tL.isSome && decide (0 = healEpoch tL)) = false := (zero_eq_healEpoch_false tL).1
  simp only [h1, h2, Bool.false_eq_true, ↓reduceIte]
  cases hbk : inStage2BucketGen 4 tL par 0
  · simp only [Bool.false_eq_true, ↓reduceIte, pure_bind, regSessOptMultiDFBucket]
    have h := hPhase1 _ _ _ _ _ _ _
      (bucketSimInv_init_off C Dh encPt encT idOf lam ℓ q qep tL par hbk ks bs kr kc)
    rwa [runLocCont_eq, runMultiCont_eq, runMultiCont_eq] at h
  · have htL_none : tL = none := tL_none_of_gen4_zero hbk
    subst htL_none
    have h0_lt : 0 < M_sess := by
      dsimp only [M_sess, healEpoch]
      exact Nat.mul_pos (by omega) hq0
    simp only [↓reduceIte]
    rw [sim_lookupSlotBucketAt, sim_lookupMultiDFBucketF, sim_lookupMultiDFBucketF]
    have hlkL : (({} : LocHS Pt).fTable 0).lookup lam = none := rfl
    have hlenL : (({} : LocHS Pt).sessions 0).length = 0 := rfl
    have hnotmem : lam ∉ (({} : MultiHS Pt).sessions 0) := by intro h; cases h
    simp only [hlkL, hlenL, healEpoch, Nat.sub_zero, mul_zero, zero_add, h0_lt, ↓reduceIte,
      bind_assoc, pure_bind, regSessOptMultiDFBucket, regSessMultiDFBucket,
      hnotmem, List.nil_append]
    refine leAdd_bind ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) fun kSample _ => ?_
    have h := hPhase1 _ _ _ _ _ _ _
      (bucketSimInv_init_on C Dh encPt encT idOf lam ℓ q qep hq0 none par hbk ks bs kr kSample kc)
    rwa [runLocCont_eq, runMultiCont_eq, runMultiCont_eq] at h

private theorem phase2_opt_leOne {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (hStep : ∀ (rem : ℕ)
      (qr : (Fig8SpecDF Pt ℓ).Domain)
      (_hbad : badSendMsgDF (St := Fig8St Pt) (Coins := BitVec 256) (C := Fig8C Pt)
        (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (.inr qr) = false)
      {α : Type}
      (r : (Fig8SpecDF Pt ℓ).Range qr → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
      (_hIH : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
        BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
        LeOne
          (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
          (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
      (ssLoc : ℕ → RatchetSenderState (BitVec 256))
      (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
      (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
      (_hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL),
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
          (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
          (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM)) :
    ∀ {α : Type}
      (oa : OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
      (rem : ℕ) (_hq : MakesAtMostQueriesDF oa rem)
      (_hsh : w7SendMsgsOkDF (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) oa)
      (ssLoc : ℕ → RatchetSenderState (BitVec 256))
      (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
      (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
      (_hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc rsLoc esLoc esM esL tblM tblL),
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks oa esLoc none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false oa esM none tblM) := by
  intro α oa
  induction oa using OracleComp.inductionOn with
  | pure a =>
    intro rem _ _ _ _ esLoc esM _ tblM _ _
    simp [runLocCont, runMultiCont, authOutBucket, LeOne]
  | query_bind t r ih =>
    intro rem hq hsh ssLoc rsLoc esLoc esM esL tblM tblL hinv
    dsimp only [MakesAtMostQueriesDF, w7SendMsgsOkDF] at hq hsh
    rw [isQueryBoundP_query_bind_iff] at hq hsh
    rcases t with n | qr
    · have hq' : ∀ u, MakesAtMostQueriesDF (r u) rem := fun u => by
        simpa [MakesAtMostQueriesDF] using hq.2 u
      have hsh' : ∀ u, w7SendMsgsOkDF (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (r u) :=
        fun u => by simpa [w7SendMsgsOkDF, badSendMsgDF] using hsh.2 u
      dsimp only [runLocCont, runMultiCont]
      rw [simulateQ_query_bind, simulateQ_query_bind]
      dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift]
      rw [StateT.run_bind, StateT.run_bind, bind_assoc, bind_assoc,
        simulateQ_bind, simulateQ_bind, StateT.run_bind, map_bind]
      rw [implEDFPaperBucketMode_inl_run _ _ _ _ _ _ _ n esLoc none,
          implEDFPaperBucketMode_inl_run _ _ _ _ _ _ _ n esM none,
          simulateQ_query_bind, simulateQ_query_bind]
      simp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift,
        _root_.CryptoGames.SM.Construction.AuthL11.lImpl, QueryImpl.add_apply_inl,
        QueryImpl.ofLift_apply, simulateQ_pure, StateT.run_bind, StateT.run_pure,
        pubFsMultiImpl_inl_run, bind_assoc, pure_bind]
      exact leOne_bind (liftM (OracleSpec.query (spec := unifSpec) n)) fun u _ =>
        ih u rem (hq' u) (hsh' u) ssLoc rsLoc esLoc esM esL tblM tblL hinv
    · have hpos : 0 < rem := by
        rcases hq.1 with hfalse | hpos
        · simp at hfalse
        · exact hpos
      obtain ⟨rem', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hpos)
      have hq' : ∀ u, MakesAtMostQueriesDF (r u) rem' := fun u => by
        have := hq.2 u; simpa [MakesAtMostQueriesDF, Nat.add_sub_cancel] using this
      have hbad : badSendMsgDF (St := Fig8St Pt) (Coins := BitVec 256) (C := Fig8C Pt)
          (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (.inr qr) = false := by
        rcases hsh.1 with h0 | hpos0
        · simpa using h0
        · omega
      have hsh' : ∀ u, w7SendMsgsOkDF (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (r u) :=
        fun u => by simpa [w7SendMsgsOkDF, hbad] using hsh.2 u
      exact hStep rem' qr hbad r
        (fun u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' hinv' =>
          ih u rem' (hq' u) (hsh' u) ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' hinv')
        ssLoc rsLoc esLoc esM esL tblM tblL hinv

private theorem phase1_opt_leAdd {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (hPhase2 : ∀ {α : Type}
      (oa : OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
      (rem : ℕ), MakesAtMostQueriesDF oa rem →
      w7SendMsgsOkDF (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) oa →
      ∀ ssLoc rsLoc esLoc esM esL tblM tblL,
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc rsLoc esLoc esM esL tblM tblL →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks oa esLoc none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false oa esM none tblM))
    (hStep1 : ∀ (rem : ℕ)
      (qr : (Fig8SpecDF Pt ℓ).Domain)
      (_hbad : badSendMsgDF (St := Fig8St Pt) (Coins := BitVec 256) (C := Fig8C Pt)
        (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (.inr qr) = false)
      {α : Type}
      (r : (Fig8SpecDF Pt ℓ).Range qr → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
      (_hIH1 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
        BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
        LeAdd
          (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
          (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM')
          (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true (r u) esL' none tblL'))
      (_hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
        BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
        LeOne
          (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
          (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
      (_hq_r : ∀ u, MakesAtMostQueriesDF (r u) rem)
      (ssLoc : ℕ → RatchetSenderState (BitVec 256))
      (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
      (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
      (_hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL),
      LeAdd
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
          (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
          (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true
          (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esL none tblL)) :
    ∀ {α : Type}
      (oa : OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
      (rem : ℕ) (_hq : MakesAtMostQueriesDF oa rem)
      (_hsh : w7SendMsgsOkDF (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) oa)
      (ssLoc : ℕ → RatchetSenderState (BitVec 256))
      (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
      (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
      (_hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc rsLoc esLoc esM esL tblM tblL),
      LeAdd
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks oa esLoc none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false oa esM none tblM)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true oa esL none tblL) := by
  intro α oa
  induction oa using OracleComp.inductionOn with
  | pure a =>
    intro rem _ _ _ _ esLoc esM esL tblM tblL hinv
    have hlfL : esL.h.lfWin = false := by rw [(hinv.phase1_props rfl).2.1]; exact hinv.lfWin_M
    simp [runLocCont, runMultiCont, authOutBucket, hlfL, LeAdd]
  | query_bind t r ih =>
    intro rem hq hsh ssLoc rsLoc esLoc esM esL tblM tblL hinv
    dsimp only [MakesAtMostQueriesDF, w7SendMsgsOkDF] at hq hsh
    rw [isQueryBoundP_query_bind_iff] at hq hsh
    rcases t with n | qr
    · have hq' : ∀ u, MakesAtMostQueriesDF (r u) rem := fun u => by
        simpa [MakesAtMostQueriesDF] using hq.2 u
      have hsh' : ∀ u, w7SendMsgsOkDF (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (r u) :=
        fun u => by simpa [w7SendMsgsOkDF, badSendMsgDF] using hsh.2 u
      dsimp only [runLocCont, runMultiCont]
      rw [simulateQ_query_bind, simulateQ_query_bind, simulateQ_query_bind]
      dsimp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift]
      rw [StateT.run_bind, StateT.run_bind, StateT.run_bind,
        bind_assoc, bind_assoc, bind_assoc,
        simulateQ_bind, simulateQ_bind, simulateQ_bind,
        StateT.run_bind, StateT.run_bind, map_bind, map_bind]
      rw [implEDFPaperBucketMode_inl_run _ _ _ _ _ _ _ n esLoc none,
          implEDFPaperBucketMode_inl_run _ _ _ _ _ _ _ n esM none,
          implEDFPaperBucketMode_inl_run _ _ _ _ _ _ _ n esL none,
          simulateQ_query_bind, simulateQ_query_bind, simulateQ_query_bind]
      simp only [OracleQuery.input_query, OracleQuery.cont_query, id_eq, liftM, monadLift,
        _root_.CryptoGames.SM.Construction.AuthL11.lImpl, QueryImpl.add_apply_inl,
        QueryImpl.ofLift_apply, simulateQ_pure, StateT.run_bind, StateT.run_pure,
        pubFsMultiImpl_inl_run, bind_assoc, pure_bind]
      exact leAdd_bind (liftM (OracleSpec.query (spec := unifSpec) n)) fun u _ =>
        ih u rem (hq' u) (hsh' u) ssLoc rsLoc esLoc esM esL tblM tblL hinv
    · have hpos : 0 < rem := by
        rcases hq.1 with hfalse | hpos
        · simp at hfalse
        · exact hpos
      obtain ⟨rem', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hpos)
      have hq' : ∀ u, MakesAtMostQueriesDF (r u) rem' := fun u => by
        have := hq.2 u; simpa [MakesAtMostQueriesDF, Nat.add_sub_cancel] using this
      have hbad : badSendMsgDF (St := Fig8St Pt) (Coins := BitVec 256) (C := Fig8C Pt)
          (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (.inr qr) = false := by
        rcases hsh.1 with h0 | hpos0
        · simpa using h0
        · omega
      have hsh' : ∀ u, w7SendMsgsOkDF (fun m : LibsignalMsgPublicPart × Plain ℓ => atomicShortPubB m.1) (r u) :=
        fun u => by simpa [w7SendMsgsOkDF, hbad] using hsh.2 u
      exact hStep1 rem' qr hbad r
        (fun u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' hinv' =>
          ih u rem' (hq' u) (hsh' u) ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' hinv')
        (fun u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' hinv' =>
          hPhase2 (r u) rem' (hq' u) (hsh' u) ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' hinv')
        hq' ssLoc rsLoc esLoc esM esL tblM tblL hinv

