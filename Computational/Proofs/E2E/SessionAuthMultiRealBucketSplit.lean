private theorem healedBy_of_inStage2BucketGen_phase1 {St Msg C : Type}
    {tL : Option ℕ} {par : Bool} {t0 : ℕ} {g : GameState St Msg C}
    (hpl : postLeak tL g = false) (hbk : inStage2BucketGen 4 tL par t0 = true) :
    healedBy g.tL 3 t0 = true := by
  apply Computational.Proofs.SessionCostedFig8.BucketFSAuthBridgeHopShallow.healedBy_of_not_postLeak tL g t0 hpl
  simp only [inStage2BucketGen, lastLeakGuessAdmissible, Bool.and_eq_true] at hbk
  cases tL with
  | none => rfl
  | some l =>
    simp only [healedBy, decide_eq_true_eq] at hbk ⊢
    omega

private theorem inStage2Bucket_of_gen4 {tL : Option ℕ} {par : Bool} {t0 : ℕ}
    (hbk : inStage2BucketGen 4 tL par t0 = true) :
    inStage2Bucket 1 tL par t0 = true := hbk

private theorem healEpoch_le_of_gen4 {tL : Option ℕ} {par : Bool} {t0 : ℕ}
    (hbk : inStage2BucketGen 4 tL par t0 = true) :
    healEpoch tL ≤ t0 := by
  simp only [inStage2BucketGen, lastLeakGuessAdmissible, healedBy, Bool.and_eq_true] at hbk
  cases tL with
  | none => simp [healEpoch]
  | some l =>
    simp only [decide_eq_true_eq] at hbk
    simp only [healEpoch]; omega

private theorem zero_eq_healEpoch_false (tL : Option ℕ) :
    (tL.isSome && decide (0 = healEpoch tL)) = false ∧
    (tL.isSome && (0 == healEpoch tL)) = false := by
  cases tL with
  | none => simp
  | some l => simp [healEpoch]

private theorem tL_none_of_gen4_zero {tL : Option ℕ} {par : Bool}
    (hbk : inStage2BucketGen 4 tL par 0 = true) :
    tL = none := by
  cases tL with
  | none => rfl
  | some l =>
    simp only [inStage2BucketGen, lastLeakGuessAdmissible, healedBy, Bool.and_eq_true,
      decide_eq_true_eq] at hbk
    omega

private theorem bucketSimInv_init_off {Pt : Type} [DecidableEq Pt] [Zero Pt]
    (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (lam : Pt) (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool)
    (hbk : inStage2BucketGen 4 tL par 0 = false)
    (ks : ℕ → BitVec 256) (bs : ℕ → Bool)
    (kr : BitVec 256) (kc : BitVec 256) :
    let fs := lFS C protoSignalCodec ℓ encT idOf maxForwardJumps
    let p0 := (rootPRNG C.F encPt).up ((rootPRNG C.F encPt).init kr) lam
    let (vA_loc, vB_loc) := mkParties ((dhScheme Dh).initA kc) ((dhScheme Dh).initB kc)
      p0.1 (fs.initSender p0.2) (fs.initReceiver p0.2)
    let (vA_M, vB_M) := mkParties ((dhScheme Dh).initA kc) ((dhScheme Dh).initB kc)
      p0.1 (.inl (fs.initSender p0.2)) (.inl (fs.initReceiver p0.2))
    let gLoc : Ctx _ _ _ _ _ _ _ := { st := fun P => match P with | .A => vA_loc | .B => vB_loc, b := false }
    let gM : Ctx _ _ _ _ _ _ _ := { st := fun P => match P with | .A => vA_M | .B => vB_M, b := false }
    let ssLoc := fun i => fs.initSender (ks i)
    let rsLoc := fun i => fs.initReceiver (ks i)
    let tbl0 := fun i => hInit (bs i) (.seed (ks i))
    BucketSimInv C ℓ encT idOf q qep tL par ks true q ssLoc rsLoc
      { g := gLoc, h := {} } { g := gM, h := {} } { g := gM, h := {} } tbl0 tbl0 := by
  intro fs p0
  dsimp only [mkParties]
  refine
    { gsync := ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
      abort_loc := rfl
      abort_M := rfl
      win_false := rfl
      lfWin_M := rfl
      comp_unhealed := compUnhealed_init _ false
      tL_mem_leaks := fun _ h => by cases h
      phase1_props := fun _ => ⟨rfl, rfl, fun _ => rfl⟩
      phase2_props := fun hp => Bool.noConfusion hp
      sess_eq := rfl
      sess_nodup := fun _ => List.nodup_nil
      sess_zero_le := Nat.zero_le q
      sess_pos_bound := fun _ _ => by simp
      sess_epoch_ok := fun _ hne => absurd rfl hne
      fTable_M_iff := fun _ _ => rfl
      fTable_loc_eq := fun _ _ => rfl
      cache_sync := fun _ => Or.inl ⟨rfl, rfl⟩
      vp_id := fun P => by cases P <;> exact ⟨rfl, rfl⟩
      vp_tcur_eq := fun P => by cases P <;> exact ⟨rfl, rfl⟩
      vp_γ_eq := fun P => by cases P <;> rfl
      vp_root_eq := fun P => by cases P <;> rfl
      vp_cka_eq := fun P => by cases P <;> rfl
      epoch_bound := fun _ => by simp
      vS_sync := fun P => by
        cases P with
        | A => exact Or.inl ⟨rfl, rfl⟩
        | B => exact Or.inr (Or.inl ⟨_, rfl, rfl⟩)
      vR_dom := fun P t0 h => by
        cases P with
        | A =>
          by_cases ht0 : t0 = 0
          · subst ht0; exact ⟨Nat.zero_le _, rfl⟩
          · simp [ht0] at h
        | B => simp at h
      vR_sync := fun P t0 => by
        cases P with
        | A =>
          by_cases ht0 : t0 = 0
          · subst ht0; simp
          · simp [ht0]
        | B => exact Or.inl ⟨rfl, rfl⟩
      vp_cka_cache := fun P hP => by
        cases P
        · cases hP
        · exact Or.inl ⟨rfl, rfl, Or.inl ⟨hbk, _, rfl⟩⟩
      sess_inv := fun sIdx => activeSessInv_init C ℓ encT idOf true (ks sIdx) (bs sIdx)
      ss_fresh := fun _ _ _ _ _ _ => rfl
      rs_fresh := fun _ _ _ _ _ _ => rfl
      book_fresh_before_send := fun _ _ _ _ _ _ _ => rfl
      trans_meta := fun _ hr => by cases hr
      cache_empty_gt := fun _ _ => rfl
      healed_sender_pin := fun P _ _ _ _ hv _ => by cases P <;> simp at hv
      healed_vR_pin := fun P t0 _ hv _ => by
        cases P with
        | A =>
          by_cases ht0 : t0 = 0
          · subst ht0; simp at hv
          · simp [ht0] at hv
        | B => simp at hv
      healed_book_trans := fun _ _ _ _ hp => by
        rcases hp with ⟨_, _, hbk0, _⟩ | ⟨_, _, _, _, hc⟩
        · rw [hbk] at hbk0; cases hbk0
        · cases hc }

private theorem bucketSimInv_init_on {Pt : Type} [DecidableEq Pt] [Zero Pt]
    (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (lam : Pt) (ℓ q qep : ℕ) (hq0 : 0 < q) (tL : Option ℕ) (par : Bool)
    (hbk : inStage2BucketGen 4 tL par 0 = true)
    (ks : ℕ → BitVec 256) (bs : ℕ → Bool)
    (kr kMulti : BitVec 256) (kc : BitVec 256) :
    let fs := lFS C protoSignalCodec ℓ encT idOf maxForwardJumps
    let p0 := (rootPRNG C.F encPt).up ((rootPRNG C.F encPt).init kr) lam
    let (vA_loc, vB_loc) := mkParties ((dhScheme Dh).initA kc) ((dhScheme Dh).initB kc)
      p0.1 (fs.initSender (ks 0)) (fs.initReceiver (ks 0))
    let (vA_M, vB_M) := mkParties ((dhScheme Dh).initA kc) ((dhScheme Dh).initB kc)
      p0.1 (.inr 0) (.inr 0)
    let gLoc : Ctx _ _ _ _ _ _ _ := { st := fun P => match P with | .A => vA_loc | .B => vB_loc, b := false }
    let gM : Ctx _ _ _ _ _ _ _ := { st := fun P => match P with | .A => vA_M | .B => vB_M, b := false }
    let hLoc : LocHS Pt :=
      { fTable := Function.update (fun _ => []) 0 [(lam, ks 0)]
        sessions := Function.update (fun _ => []) 0 [lam] }
    let hM : MultiHS Pt :=
      { fTable := Function.update (fun _ => []) 0 [(lam, kMulti)]
        sessions := Function.update (fun _ => []) 0 [lam] }
    let ssLoc := fun i => fs.initSender (ks i)
    let rsLoc := fun i => fs.initReceiver (ks i)
    let tbl0 := fun i => hInit (bs i) (.seed (ks i))
    BucketSimInv C ℓ encT idOf q qep tL par ks true q ssLoc rsLoc
      { g := gLoc, h := hLoc } { g := gM, h := hM } { g := gM, h := hM } tbl0 tbl0 := by
  have htL_none : tL = none := tL_none_of_gen4_zero hbk
  subst htL_none
  intro fs p0
  dsimp only [mkParties]
  refine
    { gsync := ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
      abort_loc := rfl
      abort_M := rfl
      win_false := rfl
      lfWin_M := rfl
      comp_unhealed := compUnhealed_init _ false
      tL_mem_leaks := fun _ h => by cases h
      phase1_props := fun _ => ⟨rfl, rfl, fun _ => rfl⟩
      phase2_props := fun hp => Bool.noConfusion hp
      sess_eq := rfl
      sess_nodup := fun t0 => by
        by_cases ht0 : t0 = 0
        · subst ht0; simp [Function.update_self]
        · simp [Function.update_of_ne ht0]
      sess_zero_le := by simp [Function.update_self]; exact hq0
      sess_pos_bound := fun t0 ht0 => by
        have hne : t0 ≠ 0 := by omega
        simp [Function.update_of_ne hne]
      sess_epoch_ok := fun t0 hne => by
        by_cases ht0 : t0 = 0
        · subst ht0; exact ⟨by simp, hbk, rfl⟩
        · simp [Function.update_of_ne ht0] at hne
      fTable_M_iff := fun t0 ik => by
        by_cases ht0 : t0 = 0
        · subst ht0
          by_cases hik : ik = lam
          · subst hik; simp [Function.update_self]
          · have hb : (ik == lam) = false := beq_false_of_ne hik
            simp [Function.update_self, List.lookup, hb, hik]
        · simp [Function.update_of_ne ht0]
      fTable_loc_eq := fun t0 ik => by
        by_cases ht0 : t0 = 0
        · subst ht0
          by_cases hik : ik = lam
          · subst hik; simp [Function.update_self, healEpoch]
          · have hb : (ik == lam) = false := beq_false_of_ne hik
            simp [Function.update_self, List.lookup, hb, hik]
        · simp [Function.update_of_ne ht0]
      cache_sync := fun _ => Or.inl ⟨rfl, rfl⟩
      vp_id := fun P => by cases P <;> exact ⟨rfl, rfl⟩
      vp_tcur_eq := fun P => by cases P <;> exact ⟨rfl, rfl⟩
      vp_γ_eq := fun P => by cases P <;> rfl
      vp_root_eq := fun P => by cases P <;> rfl
      vp_cka_eq := fun P => by cases P <;> rfl
      epoch_bound := fun _ => by simp
      vS_sync := fun P => by
        cases P with
        | A => exact Or.inl ⟨rfl, rfl⟩
        | B =>
          refine Or.inr (Or.inr ⟨0, 0, le_rfl, fun _ => rfl, rfl, by simp, hbk, rfl, ?_, ?_⟩)
          · simp [Function.update_self]
          · simp [healEpoch]
      vR_dom := fun P t0 h => by
        cases P with
        | A =>
          by_cases ht0 : t0 = 0
          · subst ht0; exact ⟨Nat.zero_le _, rfl⟩
          · simp [ht0] at h
        | B => simp at h
      vR_sync := fun P t0 => by
        cases P with
        | A =>
          by_cases ht0 : t0 = 0
          · subst ht0
            refine Or.inr (Or.inr ⟨0, rfl, by simp, hbk, rfl, ?_, ?_⟩)
            · simp [Function.update_self]
            · simp [healEpoch]
          · simp [ht0]
        | B => exact Or.inl ⟨rfl, rfl⟩
      vp_cka_cache := fun P hP => by
        cases P
        · cases hP
        · exact Or.inl ⟨rfl, rfl, Or.inr ⟨hbk, rfl⟩⟩
      sess_inv := fun sIdx => activeSessInv_init C ℓ encT idOf true (ks sIdx) (bs sIdx)
      ss_fresh := fun _ _ _ _ _ _ => rfl
      rs_fresh := fun _ _ _ _ _ _ => rfl
      book_fresh_before_send := fun _ _ _ _ _ _ _ => rfl
      trans_meta := fun _ hr => by cases hr
      cache_empty_gt := fun _ _ => rfl
      healed_sender_pin := fun P t0 j _ ht0 hv _ => by
        cases P with
        | A => simp at hv
        | B =>
          have ht0' : t0 = 0 := ht0
          subst ht0'
          have hj : j = 0 := by
            dsimp only [healEpoch] at hv
            injection hv with hv'
            injection hv' with hj'
            omega
          exact ⟨rfl, Or.inl ⟨rfl, hj, rfl⟩⟩
      healed_vR_pin := fun P t0 sIdx hv _ => by
        cases P with
        | A =>
          by_cases ht0 : t0 = 0
          · subst ht0
            dsimp only [↓reduceIte] at hv
            injection hv with hv'
            injection hv' with hs'
            exact Or.inl ⟨rfl, hs'.symm, hbk, rfl⟩
          · simp [ht0] at hv
        | B => simp at hv
      healed_book_trans := fun _ _ _ _ _ => rfl }

private theorem sim_lookupSlotBucketAt {Pt : Type} [DecidableEq Pt]
    (q M_sess : ℕ) (ks : ℕ → BitVec 256) (tL : Option ℕ) (t0 : ℕ) (ik : Pt)
    (hLoc : LocHS Pt) :
    simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      ((lookupSlotBucketAt q M_sess ks tL t0 ik).run hLoc) =
    match (hLoc.fTable t0).lookup ik with
    | some k => pure (k, hLoc)
    | none =>
      (($ᵗ (BitVec 256) : ProbComp (BitVec 256)) >>= fun kDrawn =>
        let sIdx := q * (t0 - healEpoch tL) + (hLoc.sessions t0).length
        let kUse := if sIdx < M_sess then ks sIdx else kDrawn
        pure (kUse,
          { hLoc with
            fTable := Function.update hLoc.fTable t0 ((ik, kUse) :: hLoc.fTable t0)
            sessions := Function.update hLoc.sessions t0 (hLoc.sessions t0 ++ [ik]) })) := by
  unfold lookupSlotBucketAt
  simp only [StateT.run_bind, StateT.run_get, pure_bind]
  rcases hlk : (hLoc.fTable t0).lookup ik with _ | k
  · simp only [StateT.run_bind, StateT.run_lift, StateT.run_modify, StateT.run_pure,
      bind_assoc, pure_bind, simulateQ_bind, simulateQ_pure, sim_sampleT_lImpl]
  · simp only [StateT.run_pure, simulateQ_pure]

private theorem sim_lookupMultiDFBucketF {Pt : Type} [DecidableEq Pt] {ℓ : ℕ} {σ : Type}
    (impl : QueryImpl (fsSpec (BitVec 256) (BitVec 256)
      (Header Pt × LibsignalMsgPublicPart) (Plain ℓ) LibsignalCiphertextWithSalt32) (StateT σ ProbComp))
    (t0 : ℕ) (ik : Pt) (hM : MultiHS Pt) (st : (ℕ → Bool) × (ℕ → σ)) :
    (simulateQ (pubFsMultiImpl impl)
      ((lookupMultiDFBucketF
        (SS := RatchetSenderState (BitVec 256))
        (RS := RatchetReceiverState (BitVec 256) (BitVec 256))
        (M := LibsignalMsgPublicPart × Plain ℓ) t0 ik).run hM)).run st =
    match (hM.fTable t0).lookup ik with
    | some k => pure ((k, hM), st)
    | none =>
      (($ᵗ (BitVec 256) : ProbComp (BitVec 256)) >>= fun k =>
        pure ((k, { hM with fTable := Function.update hM.fTable t0 ((ik, k) :: hM.fTable t0) }), st)) := by
  unfold lookupMultiDFBucketF
  simp only [StateT.run_bind, StateT.run_get, pure_bind]
  rcases hlk : (hM.fTable t0).lookup ik with _ | k
  · simp only [StateT.run_bind, StateT.run_lift, StateT.run_modify, StateT.run_pure,
      bind_assoc, pure_bind, simulateQ_bind, simulateQ_pure]
    rw [sim_sampleT_pubImpl impl st]
    simp only [bind_assoc, pure_bind]
  · simp only [StateT.run_pure, simulateQ_pure, StateT.run_pure]

private theorem lookup_cons_fTable_M_iff {I K : Type} [DecidableEq I]
    (tb : List (I × K)) (ses : List I) (ik : I) (k : K)
    (hiff : ∀ ik', (tb.lookup ik').isSome = decide (ik' ∈ ses)) :
    ∀ ik', (((ik, k) :: tb).lookup ik').isSome = decide (ik' ∈ ses ++ [ik]) := by
  intro ik'
  by_cases heq : ik' = ik
  · subst heq; simp [List.lookup]
  · have hb : (ik' == ik) = false := beq_false_of_ne heq
    simp [List.lookup, hb, hiff ik', heq]

private theorem lookup_cons_fTable_loc_eq {I K : Type} [DecidableEq I]
    (tb : List (I × K)) (ses : List I) (ik : I) (base : ℕ) (ks : ℕ → K)
    (hnotmem : ik ∉ ses)
    (heq_tb : ∀ ik', tb.lookup ik' =
      if ik' ∈ ses then some (ks (base + ses.idxOf ik')) else none) :
    ∀ ik', (((ik, ks (base + ses.length)) :: tb).lookup ik') =
      if ik' ∈ ses ++ [ik] then some (ks (base + (ses ++ [ik]).idxOf ik')) else none := by
  intro ik'
  have hidx := idxOf_append_singleton_of_not_mem ses ik ik' hnotmem
  by_cases hik : ik' = ik
  · subst hik; simp [hidx]
  · have hb : (ik' == ik) = false := beq_false_of_ne hik
    rw [List.lookup_cons, hb]
    dsimp only [Bool.cond_false]
    rw [heq_tb ik']
    by_cases hmem : ik' ∈ ses
    · have hmem' : ik' ∈ ses ++ [ik] := List.mem_append_left [ik] hmem
      simp [hmem, hmem', hik, hidx]
    · have hmem' : ik' ∉ ses ++ [ik] := by simp [hmem, hik]
      simp [hmem, hmem']

private theorem inStage2BucketGen_false_of_tH {tL : Option ℕ} {par : Bool} {t0 : ℕ}
    (htH : (tL.isSome && decide (t0 = healEpoch tL)) = true) :
    inStage2BucketGen 4 tL par t0 = false := by
  rcases tL with _ | l
  · simp at htH
  · simp only [Option.isSome_some, Bool.true_and, decide_eq_true_eq] at htH
    cases hbk : inStage2BucketGen 4 (some l) par t0
    · rfl
    · exact absurd htH (not_tH_of_inStage2BucketGen_some hbk)

private theorem sim_rootSlotBucketAt {Pt : Type} [DecidableEq Pt] [SampleableType Pt] {KR : Type}
    (q M_sess : ℕ) (ks : ℕ → BitVec 256)
    (prng : PRFPRNG KR (BitVec 256) Pt (BitVec 256))
    (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (t0 : ℕ) (pl : Bool) (ik0 : Pt) (σ0 : BitVec 256) (hLoc : LocHS Pt) :
    simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      ((rootSlotBucketAt q M_sess ks prng qep tL par t0 pl ik0 σ0).run hLoc) =
    if pl || decide (qep + 1 < t0) then
      pure ((prng.up σ0 ik0), hLoc)
    else if tL.isSome && decide (t0 = healEpoch tL) then
      (($ᵗ Pt : ProbComp Pt) >>= fun ir =>
        ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) >>= fun kSample =>
          pure (((prng.up σ0 ir).1, kSample), hLoc))
    else if inStage2BucketGen 4 tL par t0 then
      (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
        ((lookupSlotBucketAt q M_sess ks tL t0 ik0).run hLoc)) >>= fun p =>
        pure (((prng.up σ0 ik0).1, p.1), p.2)
    else
      pure ((prng.up σ0 ik0), hLoc) := by
  unfold rootSlotBucketAt
  dsimp only
  by_cases h1 : (pl || decide (qep + 1 < t0)) = true
  · simp [h1]
  · simp only [h1, Bool.false_eq_true, ↓reduceIte]
    by_cases h2 : (tL.isSome && decide (t0 = healEpoch tL)) = true
    · simp only [h2, ↓reduceIte, StateT.run_bind, StateT.run_lift, StateT.run_pure,
        bind_assoc, pure_bind, simulateQ_bind, simulateQ_pure, sim_sampleT_lImpl]
    · simp only [h2, Bool.false_eq_true, ↓reduceIte]
      by_cases h3 : inStage2BucketGen 4 tL par t0 = true
      · simp only [h3, ↓reduceIte, StateT.run_bind, StateT.run_pure,
          simulateQ_bind, simulateQ_pure]
      · simp [h3]

private theorem sim_rootFSMultiDFBucketPaper {Pt : Type} [DecidableEq Pt] [SampleableType Pt]
    {ℓ : ℕ} {σ KR : Type}
    (impl : QueryImpl (fsSpec (BitVec 256) (BitVec 256)
      (Header Pt × LibsignalMsgPublicPart) (Plain ℓ) LibsignalCiphertextWithSalt32) (StateT σ ProbComp))
    (prng : PRFPRNG KR (BitVec 256) Pt (BitVec 256))
    (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (t0 : ℕ) (pl : Bool) (ik0 : Pt) (σ0 : BitVec 256) (hM : MultiHS Pt) (st : (ℕ → Bool) × (ℕ → σ)) :
    (simulateQ (pubFsMultiImpl impl)
      ((rootFSMultiDFBucketPaper
        (SS := RatchetSenderState (BitVec 256))
        (RS := RatchetReceiverState (BitVec 256) (BitVec 256))
        (M := LibsignalMsgPublicPart × Plain ℓ) prng 4 qep tL par t0 pl ik0 σ0).run hM)).run st =
    if pl || decide (qep + 1 < t0) then
      pure ((((prng.up σ0 ik0).1, (prng.up σ0 ik0).2, none), hM), st)
    else if tL.isSome && decide (t0 = healEpoch tL) then
      (($ᵗ Pt : ProbComp Pt) >>= fun ir =>
        ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) >>= fun kSample =>
          pure ((((prng.up σ0 ir).1, kSample, none), hM), st))
    else if inStage2BucketGen 4 tL par t0 then
      (simulateQ (pubFsMultiImpl impl)
        ((lookupMultiDFBucketF
          (SS := RatchetSenderState (BitVec 256))
          (RS := RatchetReceiverState (BitVec 256) (BitVec 256))
          (M := LibsignalMsgPublicPart × Plain ℓ) t0 ik0).run hM)).run st >>= fun p =>
        pure ((((prng.up σ0 ik0).1, p.1.1, some ik0), p.1.2), p.2)
    else
      pure ((((prng.up σ0 ik0).1, (prng.up σ0 ik0).2, none), hM), st) := by
  unfold rootFSMultiDFBucketPaper
  dsimp only
  have hbeq : (t0 == healEpoch tL) = decide (t0 = healEpoch tL) := by
    by_cases h : t0 = healEpoch tL <;> simp [h]
  rw [hbeq]
  by_cases h1 : (pl || decide (qep + 1 < t0)) = true
  · simp [h1]
  · simp only [h1, Bool.false_eq_true, ↓reduceIte]
    by_cases h2 : (tL.isSome && decide (t0 = healEpoch tL)) = true
    · have hbk : inStage2BucketGen 4 tL par t0 = false := inStage2BucketGen_false_of_tH h2
      simp only [hbk, h2, Bool.false_eq_true, ↓reduceIte, StateT.run_bind, StateT.run_lift,
        StateT.run_pure, bind_assoc, pure_bind, simulateQ_bind, simulateQ_pure, sim_sampleT_pubImpl]
    · simp only [h2, Bool.false_eq_true, ↓reduceIte]
      by_cases h3 : inStage2BucketGen 4 tL par t0 = true
      · simp only [h3, ↓reduceIte, StateT.run_bind, StateT.run_pure,
          simulateQ_bind, simulateQ_pure]
      · simp [h3]

