private theorem vRecv_mem_support_epoch_eq
    {Γ T Sig SS RS M E CCoins HSLoc : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hkLoc : _root_.CryptoGames.SM.Engine.Hooks _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
      HSLoc Γ T Sig SS RS M E CCoins Γ Sig SS RS)
    (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (vp : VP Γ T Sig SS RS)
    (c : Header T × E) (rec : Option (Record M (Header T × E))) (h0 : HSLoc)
    {st' : VP Γ T Sig SS RS} {t' i' : ℕ} {m' : M} {h1 : HSLoc}
    (hz : (some (some (st', t', i', m')), h1) ∈ support
      (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
        ((vRecv hkLoc ctx P vp c rec).run h0))) :
    t' = c.1.1 := by
  unfold vRecv at hz
  by_cases hcond : (vp.id.sendsIn c.1.1 || decide (vp.tcur + 1 < c.1.1)) = true
  · simp [hcond] at hz
  · simp only [hcond, Bool.false_eq_true, ↓reduceIte] at hz
    by_cases hc1 : c.1.1 = vp.tcur + 1
    · rw [← hc1] at hz
      simp only [↓reduceIte] at hz
      cases htn : c.1.2 with
      | none => simp [htn] at hz
      | some Tn =>
        simp only [htn, StateT.run_bind, simulateQ_bind, mem_support_bind_iff] at hz
        rcases hz with ⟨⟨sr, h_mid1⟩, _, hz1⟩
        rcases sr with _ | (_ | ⟨γ', σ', rs⟩)
        · simp at hz1
        · simp at hz1
        · simp only [StateT.run_bind, pure_bind, Function.update_self,
            simulateQ_bind, mem_support_bind_iff] at hz1
          rcases hz1 with ⟨⟨fso, _⟩, _, hz3⟩
          rcases fso with _ | (_ | ⟨_, _, _⟩)
          · simp at hz3
          · simp at hz3
          · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff,
              Prod.mk.injEq, Option.some.injEq] at hz3
            exact hz3.1.2.1
    · simp only [hc1, ↓reduceIte, pure_bind] at hz
      cases hs1 : vp.vR c.1.1 with
      | none => simp [hs1] at hz
      | some v =>
        simp only [hs1, StateT.run_bind, simulateQ_bind, mem_support_bind_iff] at hz
        rcases hz with ⟨⟨fso, _⟩, _, hz3⟩
        rcases fso with _ | (_ | ⟨_, _, _⟩)
        · simp at hz3
        · simp at hz3
        · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff,
            Prod.mk.injEq, Option.some.injEq] at hz3
          exact hz3.1.2.1

private theorem implEDFPaperBucketRaw_step_corrs_and_win
    {Γ CCoins T Sig SS RS M E HSLoc : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hkLoc : _root_.CryptoGames.SM.Engine.Hooks _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
      HSLoc Γ T Sig SS RS M E CCoins Γ Sig SS RS)
    (hcommit : ∀ s₁ P old new, hkLoc.commit s₁ P old new = pure (some new))
    (qep maxSkip : ℕ) (tL : Option ℕ) (par : Bool)
    (q : (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)).Domain)
    (esLoc es1 : EState (VP Γ T Sig SS RS) M (Header T × E) HSLoc)
    (out : (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)).Range q)
    (hraw : (out, es1) ∈ support
      (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
        ((implEDFPaperBucketRaw hkLoc 3 qep maxSkip (bucketAuthCfg 1 tL par) q).run esLoc))) :
    (∀ pe ∈ esLoc.g.corrs, pe ∈ es1.g.corrs) ∧
    (es1.g.win = true → esLoc.g.win = true ∨
      ∃ tNew, _root_.CryptoGames.SM.Construction.DeliverForge.dfQueryTargetEpoch
        (fun c : Header T × E => c.1.1) q = some tNew ∧
        inStage2Bucket 1 tL par tNew = true) := by
  rcases q with n | ((((⟨P, m, r⟩ | ⟨P, m₀, m₁, r⟩) | ⟨P, c⟩) | ⟨P, c⟩) | P) | ⟨P, c, c'⟩
  · simp only [implEDFPaperBucketRaw, coinsE, QueryImpl.add_apply_inl, StateT.run_lift,
      simulateQ_bind, simulateQ_pure, mem_support_bind_iff, support_pure,
      Set.mem_singleton_iff] at hraw
    rcases hraw with ⟨_, _, hpair⟩
    rcases Prod.mk.inj hpair with ⟨_, hEs⟩; subst hEs
    exact ⟨fun _ h => h, Or.inl⟩
  · simp only [implEDFPaperBucketRaw, transmitEBucket, QueryImpl.add_apply_inr,
      QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind] at hraw
    split at hraw
    · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw
      rcases Prod.mk.inj hraw with ⟨_, hEs⟩; subst hEs
      exact ⟨fun _ h => h, Or.inl⟩
    · cases hep : esLoc.g.epMgmt 3 qep P r.isSome with
      | none =>
        simp only [hep, StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw
        rcases Prod.mk.inj hraw with ⟨_, hEs⟩; subst hEs
        exact ⟨fun _ h => h, Or.inl⟩
      | some s1 =>
        simp only [hep, StateT.run_bind, simulateQ_bind, mem_support_bind_iff] at hraw
        rcases hraw with ⟨⟨res, es_m⟩, hv, hraw2⟩
        have hgm := (liftH_mem_support_g_eq _ _ hv).1
        cases res with
        | none =>
          simp only [abortE, StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind,
            simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw2
          rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
          refine ⟨fun _ h => by dsimp only; rw [hgm]; exact h, fun hw => Or.inl (by dsimp only at hw; rwa [hgm] at hw)⟩
        | some o =>
          simp only [StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind,
            simulateQ_pure, support_pure, Set.mem_singleton_iff, GameState.record] at hraw2
          rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
          have hwin_s1 : s1.win = esLoc.g.win := by
            unfold GameState.epMgmt GameState.leak at hep
            by_cases hcap : qep < esLoc.g.epoch P + 1
            · by_cases hsends : P.sendsIn (esLoc.g.epoch P + 1) = true
              · simp [hsends, hcap] at hep
              · by_cases hcap0 : qep < esLoc.g.epoch P
                · simp [hsends, hcap0] at hep
                · simp only [hsends, hcap0, Bool.false_eq_true, ↓reduceIte,
                    Option.some.injEq] at hep
                  subst hep; rfl
            · by_cases hsends : P.sendsIn (esLoc.g.epoch P + 1) = true
              · simp only [hcap, hsends, ↓reduceIte, Option.some.injEq] at hep
                subst hep; dsimp only; split <;> rfl
              · by_cases hcap0 : qep < esLoc.g.epoch P
                · simp [hsends, hcap0] at hep
                · simp only [hsends, hcap0, Bool.false_eq_true, ↓reduceIte,
                    Option.some.injEq] at hep
                  subst hep; rfl
          refine ⟨fun pe h => Computational.Proofs.SessionCostedFig8.BucketFSAuthBridgeHopHalt.corrs_sub_epMgmt
              esLoc.g s1 3 qep P r.isSome hep pe h,
            fun hw => Or.inl (by dsimp only at hw; rwa [hwin_s1] at hw)⟩
  · simp only [implEDFPaperBucketRaw, challEBucket, QueryImpl.add_apply_inr,
      QueryImpl.add_apply_inl, StateT.run_pure, simulateQ_pure, support_pure,
      Set.mem_singleton_iff] at hraw
    rcases Prod.mk.inj hraw with ⟨_, hEs⟩; subst hEs
    exact ⟨fun _ h => h, Or.inl⟩
  · simp only [implEDFPaperBucketRaw, deliverE, bucketAuthCfg, QueryImpl.add_apply_inr,
      QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind] at hraw
    split at hraw
    · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw
      rcases Prod.mk.inj hraw with ⟨_, hEs⟩; subst hEs
      exact ⟨fun _ h => h, Or.inl⟩
    · split at hraw
      · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw
        rcases Prod.mk.inj hraw with ⟨_, hEs⟩; subst hEs
        exact ⟨fun _ h => h, Or.inl⟩
      · simp only [Bool.false_and, Bool.false_eq_true, ↓reduceIte, StateT.run_bind, simulateQ_bind,
          mem_support_bind_iff] at hraw
        rcases hraw with ⟨⟨rv, es_m⟩, hv, hraw2⟩
        have hgm := (liftH_mem_support_g_eq _ _ hv).1
        rcases rv with _ | (_ | ⟨st', t', i', m'⟩)
        · simp only [abortE, StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind,
            simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw2
          rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
          exact ⟨fun _ h => by dsimp only; rw [hgm]; exact h, fun hw => Or.inl (by dsimp only at hw; rwa [hgm] at hw)⟩
        · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw2
          rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
          exact ⟨fun _ h => by rwa [hgm], fun hw => Or.inl (by rwa [hgm] at hw)⟩
        · simp only [commitE, hcommit, StateT.run_bind,
            GameState.accept, GameState.delete] at hraw2
          rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
          exact ⟨fun _ h => h, Or.inl⟩
  · simp only [implEDFPaperBucketRaw, injectE, QueryImpl.add_apply_inr,
      QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind] at hraw
    split at hraw
    · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw
      rcases Prod.mk.inj hraw with ⟨_, hEs⟩; subst hEs
      exact ⟨fun _ h => h, Or.inl⟩
    · simp only [StateT.run_bind, simulateQ_bind, mem_support_bind_iff] at hraw
      rcases hraw with ⟨⟨rv, es_m⟩, hv, hraw2⟩
      have hgm := (liftH_mem_support_g_eq _ _ hv).1
      rcases rv with _ | (_ | ⟨st', t', i', m'⟩)
      · simp only [abortE, StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind,
          simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw2
        rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
        exact ⟨fun _ h => by dsimp only; rw [hgm]; exact h, fun hw => Or.inl (by dsimp only at hw; rwa [hgm] at hw)⟩
      · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw2
        rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
        exact ⟨fun _ h => by rwa [hgm], fun hw => Or.inl (by rwa [hgm] at hw)⟩
      · have ht'_eq : t' = c.1.1 := by
          dsimp only [_root_.CryptoGames.SM.Engine.liftH, StateT.run] at hv
          simp only [simulateQ_bind, simulateQ_pure, mem_support_bind_iff, support_pure,
            Set.mem_singleton_iff] at hv
          rcases hv with ⟨⟨rv0, h1⟩, hv0, hEq⟩
          rcases Prod.mk.inj hEq with ⟨rfl, _⟩
          exact vRecv_mem_support_epoch_eq hkLoc esLoc.g P (esLoc.g.st P) c none esLoc.h hv0
        subst ht'_eq
        dsimp only at hraw2; split at hraw2
        · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw2
          rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
          exact ⟨fun _ h => by rwa [hgm], fun hw => Or.inl (by rwa [hgm] at hw)⟩
        · split at hraw2
          · simp only [commitE, hcommit, StateT.run_bind,
              GameState.accept, GameState.delete] at hraw2
            rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
            exact ⟨fun _ h => h, Or.inl⟩
          · by_cases hinj : (bucketAuthCfg (Msg := M) 1 tL par).injectFull c.1.1 = true
            · simp only [hinj, ↓reduceIte,
