  · simp only [implEDFPaperBucketRaw, deliverForgeE, QueryImpl.add_apply_inr,
      dfHaltedRet, StateT.run_bind, StateT.run_get, pure_bind, hhalt, ↓reduceIte, StateT.run_pure]

