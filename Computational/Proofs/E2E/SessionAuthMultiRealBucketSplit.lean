private theorem step2_deliverForge_aux_fsRecv_inr_scorr
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 sIdx : ℕ)
    (h : Header Pt) (e : ℕ × LibsignalCiphertextWithSalt32)
    (ks : ℕ → BitVec 256)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (hM : MultiHS Pt) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hmatch : ((hM.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (h, e)) = none)
    (hscorr : ((hM.book sIdx).getD {}).sCorr = true)
    (hsess : ActiveSessInv C ℓ encT idOf false (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((hM.book sIdx).getD {}) (tblM sIdx) (tblL sIdx)) :
    let bk := (hM.book sIdx).getD {}
    match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) h e with
    | none =>
      ∃ sM',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) h e none).run hM)).run (fun _ => false, tblM) =
          pure ((some none, hM), (fun _ => false, Function.update tblM sIdx sM')) ∧
        ActiveSessInv C ℓ encT idOf false (ks sIdx)
          (ssLoc sIdx) (rsLoc sIdx) bk sM' (tblL sIdx)
    | some (rsLoc', idxOut, pmOut) =>
      let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
        { bk with fsTrans := bk.fsTrans.filter (·.1 != idxOut) }
      ∃ sM',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) h e none).run hM)).run (fun _ => false, tblM) =
          pure ((some (some (.inr sIdx, idxOut, pmOut)),
            { hM with book := Function.update hM.book sIdx (some bk') }),
            (fun _ => false, Function.update tblM sIdx sM')) ∧
        ActiveSessInv C ℓ encT idOf false (ks sIdx)
          (ssLoc sIdx) rsLoc' bk' sM' (tblL sIdx) := by
  intro bk
  rcases e with ⟨e1, e2⟩
  cases hpub : lPubOf protoSignalCodec e2 with
  | none =>
    have hrec_none : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) h (e1, e2) = none := by
      rw [lFS_receive_eq, hpub]
    rw [hrec_none]
    refine ⟨tblM sIdx, ?_, hsess⟩
    rw [hkMultiOpt_fsRecv]
    dsimp only [hooksFSMultiDFBucketPaper]
    simp only [step2_deliverForge_aux_hdr_ct_beq_eq, StateT.run_bind, StateT.run_get, pure_bind,
      hscorr, Bool.not_true, Bool.and_false, Bool.false_eq_true, ↓reduceIte,
      hmatch, Option.isSome_none, simulateQ_bind]
    rw [sim_liftFS_inject_none_run C ℓ encT idOf false sIdx h e1 e2 hpub hM tblM]
    have htbl : Function.update tblM sIdx (tblM sIdx) = tblM := Function.update_eq_self _ _
    simp only [pure_bind, StateT.run_pure, simulateQ_pure, htbl]
  | some p =>
    have hinj_res := activeSessInv_inject_phase2 C ℓ encT idOf hsess hscorr h (e1, e2) hmatch p hpub
    cases hrec : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) h (e1, e2) with
    | none =>
      rw [hrec] at hinj_res
      rcases hinj_res with ⟨sM', hstep, hinv'⟩
      refine ⟨sM', ?_, hinv'⟩
      rw [hkMultiOpt_fsRecv]
      dsimp only [hooksFSMultiDFBucketPaper]
      simp only [step2_deliverForge_aux_hdr_ct_beq_eq, StateT.run_bind, StateT.run_get, pure_bind,
        hscorr, Bool.not_true, Bool.and_false, Bool.false_eq_true, ↓reduceIte,
        hmatch, Option.isSome_none, simulateQ_bind]
      rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx h e1 e2 p hpub hM tblM hstep]
      simp only [Option.map_some, withPub, pure_bind, StateT.run_pure, simulateQ_pure]
    | some out =>
      rcases out with ⟨rsLoc', idxOut, pmOut⟩
      rw [hrec] at hinj_res
      rcases hinj_res with ⟨sM', hstep, hp_eq, hinv'⟩
      refine ⟨sM', ?_, hinv'⟩
      rw [hkMultiOpt_fsRecv]
      dsimp only [hooksFSMultiDFBucketPaper]
      simp only [step2_deliverForge_aux_hdr_ct_beq_eq, StateT.run_bind, StateT.run_get, pure_bind,
        hscorr, Bool.not_true, Bool.and_false, Bool.false_eq_true, ↓reduceIte,
        hmatch, Option.isSome_none, simulateQ_bind]
      rw [sim_liftFS_inject_some_run C ℓ encT idOf false sIdx h e1 e2 p hpub hM tblM hstep]
      have hwp : (some (.accepted idxOut (some pmOut.2)) : Option (ReceiveResult (Plain ℓ))).map
          (withPub p) = some (.accepted idxOut (some pmOut)) := by
        rcases pmOut with ⟨pm1, pm2⟩
        dsimp only at hp_eq
        subst hp_eq
        rfl
      rw [hwp]
      simp only [pure_bind, StateT.run_bind, StateT.run_get, Option.map_none, Option.getD_none]
      rfl

private theorem step2_deliverForge_aux_fsRecv_inr_corrupt
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 sIdx : ℕ)
    (h : Header Pt) (e : ℕ × LibsignalCiphertextWithSalt32)
    (ks : ℕ → BitVec 256)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (hM : MultiHS Pt) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hmatch : ((hM.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (h, e)) = none)
    (hunhealed : healedBy ctx.tL 3 t0 = false)
    (huncorr : ((hM.book sIdx).getD {}).sCorr = false)
    (hsess : ActiveSessInv C ℓ encT idOf true (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((hM.book sIdx).getD {}) (tblM sIdx) (tblL sIdx)) :
    let bk := (hM.book sIdx).getD {}
    match (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) h e with
    | none =>
      let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) := { bk with sCorr := true }
      ∃ sM',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) h e none).run hM)).run (fun _ => false, tblM) =
          pure ((some none, { hM with book := Function.update hM.book sIdx (some bk') }),
            (fun _ => false, Function.update tblM sIdx sM')) ∧
        ActiveSessInv C ℓ encT idOf false (ks sIdx)
          (ssLoc sIdx) (rsLoc sIdx) bk' sM' (tblL sIdx)
    | some (rsLoc', idxOut, pmOut) =>
      let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
        { bk with sCorr := true, fsTrans := bk.fsTrans.filter (·.1 != idxOut) }
      ∃ sM',
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false).fsRecv
            ctx P t0 (.inr sIdx) h e none).run hM)).run (fun _ => false, tblM) =
          pure ((some (some (.inr sIdx, idxOut, pmOut)),
            { hM with book := Function.update hM.book sIdx (some bk') }),
            (fun _ => false, Function.update tblM sIdx sM')) ∧
        ActiveSessInv C ℓ encT idOf false (ks sIdx)
          (ssLoc sIdx) rsLoc' bk' sM' (tblL sIdx) := by
  intro bk
  rcases e with ⟨e1, e2⟩
  have hsess0 : ActiveSessInv C ℓ encT idOf false (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((hM.book sIdx).getD {}) (tblM sIdx) (tblL sIdx) :=
    activeSessInv_to_phase2 C ℓ encT idOf hsess
  rcases activeSessInv_corruptSender C ℓ encT idOf hsess0 with ⟨sM1, hcorr, hsess1⟩
  let bk1 : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) := { bk with sCorr := true }
  let hM1 : MultiHS Pt := { hM with book := Function.update hM.book sIdx (some bk1) }
  let tbl1 := Function.update tblM sIdx sM1
  have hbk1_eq : (hM1.book sIdx).getD {} = bk1 := by simp [hM1]
  have hmatch1 : ((hM1.book sIdx).getD {}).fsTrans.find? (fun x => x.2 == (h, (e1, e2))) = none := by
    rw [hbk1_eq]; exact hmatch
  have hscorr1 : ((hM1.book sIdx).getD {}).sCorr = true := by rw [hbk1_eq]
  have hsess1' : ActiveSessInv C ℓ encT idOf false (ks sIdx)
      (ssLoc sIdx) (rsLoc sIdx) ((hM1.book sIdx).getD {}) (tbl1 sIdx) (tblL sIdx) := by
    simpa [hbk1_eq, tbl1, Function.update_self] using hsess1
  have hsc := step2_deliverForge_aux_fsRecv_inr_scorr mode C Dh encPt encT idOf ℓ q qep tL par
    ctx P t0 sIdx h (e1, e2) ks ssLoc rsLoc hM1 tbl1 tblL hmatch1 hscorr1 hsess1'
  dsimp only at hsc
  cases hrec : (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).receive (rsLoc sIdx) h (e1, e2) with
  | none =>
    rw [hrec] at hsc
    rcases hsc with ⟨sM', hrun1, hinv'⟩
    rw [hbk1_eq] at hinv'
    refine ⟨sM', ?_, hinv'⟩
    rw [hkMultiOpt_fsRecv] at hrun1 ⊢
    dsimp only [hooksFSMultiDFBucketPaper] at hrun1 ⊢
    simp only [step2_deliverForge_aux_hdr_ct_beq_eq, StateT.run_bind, StateT.run_get, pure_bind,
      hmatch, Option.isNone_none, hunhealed, huncorr, Bool.not_false, Bool.and_self, ↓reduceIte,
      simulateQ_bind]
    rw [sim_liftFS_corruptSender_run C ℓ encT idOf sIdx hM tblM hcorr]
    simp only [pure_bind, StateT.run_bind, StateT.run_modify,
      simulateQ_bind, Bool.not_true, Bool.false_eq_true,
      ↓reduceIte, Option.isSome_none]
    simp only [step2_deliverForge_aux_hdr_ct_beq_eq, StateT.run_bind, StateT.run_get, pure_bind,
      hscorr1, Bool.not_true, Bool.and_false, Bool.false_eq_true, ↓reduceIte,
      hmatch1, Option.isSome_none, simulateQ_bind] at hrun1
    have htbl_upd : Function.update tbl1 sIdx sM' = Function.update tblM sIdx sM' := by
      funext i; by_cases hi : i = sIdx <;> simp [tbl1, hi]
    rw [← htbl_upd]
    exact hrun1
  | some out =>
    rcases out with ⟨rsLoc', idxOut, pmOut⟩
    rw [hrec] at hsc
    rcases hsc with ⟨sM', hrun1, hinv'⟩
    rw [hbk1_eq] at hinv'
    refine ⟨sM', ?_, hinv'⟩
    rw [hkMultiOpt_fsRecv] at hrun1 ⊢
    dsimp only [hooksFSMultiDFBucketPaper] at hrun1 ⊢
    simp only [step2_deliverForge_aux_hdr_ct_beq_eq, StateT.run_bind, StateT.run_get, pure_bind,
      hmatch, Option.isNone_none, hunhealed, huncorr, Bool.not_false, Bool.and_self, ↓reduceIte,
      simulateQ_bind]
    rw [sim_liftFS_corruptSender_run C ℓ encT idOf sIdx hM tblM hcorr]
    simp only [pure_bind, StateT.run_bind, StateT.run_modify,
      simulateQ_bind, Bool.not_true, Bool.false_eq_true,
      ↓reduceIte, Option.isSome_none]
    simp only [step2_deliverForge_aux_hdr_ct_beq_eq, StateT.run_bind, StateT.run_get, pure_bind,
      hscorr1, Bool.not_true, Bool.and_false, Bool.false_eq_true, ↓reduceIte,
      hmatch1, Option.isSome_none, simulateQ_bind] at hrun1
    have htbl_upd : Function.update tbl1 sIdx sM' = Function.update tblM sIdx sM' := by
      funext i; by_cases hi : i = sIdx <;> simp [tbl1, hi]
    have hbk_upd : Function.update hM1.book sIdx
        (some { bk1 with fsTrans := bk1.fsTrans.filter (·.1 != idxOut) }) =
        Function.update hM.book sIdx
          (some { bk with sCorr := true, fsTrans := bk.fsTrans.filter (·.1 != idxOut) }) := by
      funext i; by_cases hi : i = sIdx
      · subst hi; simp [hM1, bk1, bk]
      · simp [hM1, hi]
    rw [hbk1_eq] at hrun1
    rw [← htbl_upd, ← hbk_upd]
    exact hrun1

private theorem step2_deliverForge_aux_fsRecv_inr_healed_none
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
