        calcWinEp, Bool.false_eq_true, ↓reduceIte]
      exact hIH1 (some .rejected) ssLoc rsLoc esLoc esM esM tblM tblL (hinv.mono_rem (Nat.le_succ rem))
    · have hhdr_f : (P.sendsIn c.1.1 || decide (esLoc.g.epoch P + 1 < c.1.1)) = false :=
        Bool.eq_false_iff.mpr hhdr
      have hhdrLoc_f : ((esLoc.g.st P).id.sendsIn c.1.1 || decide ((esLoc.g.st P).tcur + 1 < c.1.1)) = false := by
        rwa [hhdr_eq_loc]
      have hhdrM_f : ((esM.g.st P).id.sendsIn c.1.1 || decide ((esM.g.st P).tcur + 1 < c.1.1)) = false := by
        rwa [hhdr_eq_M]
