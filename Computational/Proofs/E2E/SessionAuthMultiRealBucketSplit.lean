    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool) :
    (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la).startSend =
      (hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par la).startSend := by
  cases mode with
  | none => rfl
  | some g => cases g <;> rfl

