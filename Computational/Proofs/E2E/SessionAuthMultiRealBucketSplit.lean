        exact hF () st hi
      · simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
          corrEPaperBucket, StateT.run_bind, StateT.run_get, pure_bind, h0, ↓reduceIte,
          StateT.run_pure, simulateQ_pure]
        exact hT () st hi v
    · let K_rev : (Option (PartyState Γ T Sig SS RS) × LocalSlotBucketState T Sig K I) →
          ℕ → (ℕ → K) → ProbComp Bool := fun ⟨out, st1⟩ m' ks' =>
        match out with
        | none => K_cont ((none, g0, true), st1) m' ks'
        | some stP => K_cont ((some stP, g0.afterCorr P, ab0), st1) m' ks'
      have hC_rev : ShiftCont q m rem tL ks K_rev := by
        refine ⟨fun out st1 hi => ?_, fun out st1 hi v => ?_⟩
        · rcases out with _ | stP <;> exact hC.1 _ st1 hi
        · rcases out with _ | stP <;> exact hC.2 _ st1 hi v
      obtain ⟨hF, hT⟩ := ((ShiftHM.reveal_any mode q m rem cka prng fs qep tL par g0 P (g0.st P)).weaken
        (Nat.le_succ rem) le_rfl).run ks K_rev hC_rev
      have hEqRun : ∀ m' ks' (st : LocalSlotBucketState T Sig K I),
          simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
            ((implEDFPaperBucketRaw (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
              3 qep fs.maxSkip (bucketAuthCfg 1 tL par)
              (.inr (.inl (.inr P)))).run
              { g := g0, h := st, abort := ab0 }) >>=
            (fun ⟨res, es'⟩ => K_cont ((res, es'.g, es'.abort), es'.h) m' ks') =
          simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
            (((hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par).reveal g0 P (g0.st P)).run st) >>=
            fun z => K_rev z m' ks' := by
        intro m' ks' st
        simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
          corrEPaperBucket, StateT.run_bind, StateT.run_get, pure_bind, h0, Bool.false_eq_true,
          ↓reduceIte, liftH_run_eq, abortE, simulateQ_bind, bind_assoc]
        refine bind_congr fun ⟨out, st1⟩ => ?_
        rcases out with _ | stP <;>
          simp [StateT.run_modify, simulateQ_pure, K_rev]
      exact ⟨fun _ st hi => by simpa only [hEqRun] using hF () st hi,
             fun _ st hi v => by simpa only [hEqRun] using hT () st hi v⟩
  · by_cases h0 : (ab0 || g0.win) = true
    · obtain ⟨hF, hT⟩ := hPure none g0 ab0
      refine ⟨fun _ st hi => ?_, fun _ st hi v => ?_⟩
      · simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr,
          deliverForgeE, StateT.run_bind, StateT.run_get, pure_bind, h0, ↓reduceIte,
          StateT.run_pure, simulateQ_pure]
        exact hF () st hi
      · simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr,
          deliverForgeE, StateT.run_bind, StateT.run_get, pure_bind, h0, ↓reduceIte,
          StateT.run_pure, simulateQ_pure]
        exact hT () st hi v
    · rcases htr : g0.inTransit P.other c with _ | r
      · obtain ⟨hF, hT⟩ := hPure none g0 ab0
        refine ⟨fun _ st hi => ?_, fun _ st hi v => ?_⟩
        · simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr,
            deliverForgeE, StateT.run_bind, StateT.run_get, pure_bind, h0, Bool.false_eq_true,
            ↓reduceIte, htr, StateT.run_pure, simulateQ_pure]
          exact hF () st hi
        · simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr,
            deliverForgeE, StateT.run_bind, StateT.run_get, pure_bind, h0, Bool.false_eq_true,
            ↓reduceIte, htr, StateT.run_pure, simulateQ_pure]
          exact hT () st hi v
      · dsimp only
        by_cases h1 : ((g0.inTransit P.other c').isSome || g0.comp.contains r.pos || c.1 != c'.1) = true
        · obtain ⟨hF, hT⟩ := hPure none g0 ab0
          refine ⟨fun _ st hi => ?_, fun _ st hi v => ?_⟩
          · simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr,
              deliverForgeE, StateT.run_bind, StateT.run_get, pure_bind, h0, Bool.false_eq_true,
              ↓reduceIte, htr, h1, StateT.run_pure, simulateQ_pure]
            exact hF () st hi
          · simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr,
              deliverForgeE, StateT.run_bind, StateT.run_get, pure_bind, h0, Bool.false_eq_true,
              ↓reduceIte, htr, h1, StateT.run_pure, simulateQ_pure]
            exact hT () st hi v
        · let K_vr : (Option (Option (VP Γ T Sig SS RS × ℕ × ℕ × M)) × LocalSlotBucketState T Sig K I) →
              ℕ → (ℕ → K) → ProbComp Bool := fun ⟨out, st1⟩ m' ks' =>
            match out with
            | none => K_cont ((none, g0, true), st1) m' ks'
            | some none => K_cont ((some .rejected, g0, ab0), st1) m' ks'
            | some (some (st', t', i', msg')) =>
              if (decide (qep + 1 < t') || t' != r.pos.epoch) then
                K_cont ((some .rejected, g0, ab0), st1) m' ks'
              else
                let pos : Pos := ⟨P.other, t', i'⟩
                if g0.trivial 3 pos then
                  let s₁ := { (g0.accept P st' pos) with
                              st := Function.update (g0.accept P st' pos).st P st' }
                  K_cont ((some (.accepted t' i' (some msg')), s₁, ab0), st1) m' ks'
                else
                  let g' := if (bucketAuthCfg (Msg := M) 1 tL par).injectFull t' then
                    { g0 with win := true } else g0
                  K_cont ((some .rejected, g', ab0), st1) m' ks'
          have hC_vr : ShiftCont q m rem tL ks K_vr := by
            refine ⟨fun out st1 hi => ?_, fun out st1 hi v => ?_⟩
            · rcases out with _ | (_ | ⟨st', t', i', msg'⟩)
              · exact hC.1 _ st1 hi
              · exact hC.1 _ st1 hi
              · dsimp only [K_vr]; split_ifs <;> exact hC.1 _ st1 hi
            · rcases out with _ | (_ | ⟨st', t', i', msg'⟩)
              · exact hC.2 _ st1 hi v
              · exact hC.2 _ st1 hi v
              · dsimp only [K_vr]; split_ifs <;> exact hC.2 _ st1 hi v
          obtain ⟨hF, hT⟩ := (ShiftHM.vRecv_step hq0 mode cka prng fs qep tL par g0 P (g0.st P)
            c' none).run ks K_vr hC_vr
          have hEqRun : ∀ m' ks' (st : LocalSlotBucketState T Sig K I),
              simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
                ((implEDFPaperBucketRaw (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
                  3 qep fs.maxSkip (bucketAuthCfg 1 tL par)
                  (.inr (.inr (P, c, c')))).run
                  { g := g0, h := st, abort := ab0 }) >>=
                (fun ⟨res, es'⟩ => K_cont ((res, es'.g, es'.abort), es'.h) m' ks') =
              simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
                ((vRecv (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
                  g0 P (g0.st P) c' none).run st) >>=
                fun z => K_vr z m' ks' := by
            intro m' ks' st
            simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr,
              deliverForgeE, StateT.run_bind, StateT.run_get, pure_bind, h0, Bool.false_eq_true,
              ↓reduceIte, htr, h1, liftH_run_eq, abortE, simulateQ_bind, bind_assoc]
            refine bind_congr fun ⟨out, st1⟩ => ?_
            rcases out with _ | (_ | ⟨st', t', i', msg'⟩)
            · simp [StateT.run_modify, simulateQ_pure, K_vr]
            · simp [StateT.run_pure, simulateQ_pure, K_vr]
            · dsimp only [K_vr]
              by_cases hbad : (decide (qep + 1 < t') || t' != r.pos.epoch) = true
              · simp only [hbad, ↓reduceIte, StateT.run_pure, simulateQ_pure, pure_bind]
              · simp only [hbad, Bool.false_eq_true, ↓reduceIte]
                by_cases htriv : g0.trivial 3 ⟨P.other, t', i'⟩ = true
                · simp only [htriv, ↓reduceIte, commitE_hooksSlotBucketAt_run, StateT.run_bind,
                    StateT.run_modify, StateT.run_pure, simulateQ_pure, pure_bind]
                · simp only [htriv, Bool.false_eq_true, ↓reduceIte]
                  by_cases hfull : (bucketAuthCfg (Msg := M) 1 tL par).injectFull t' = true <;>
                    simp only [hfull, Bool.false_eq_true, ↓reduceIte, StateT.run_bind,
                      StateT.run_modify, StateT.run_pure, simulateQ_pure, pure_bind]
          exact ⟨fun _ st hi => by simpa only [hEqRun] using hF () st hi,
                 fun _ st hi v => by simpa only [hEqRun] using hT () st hi v⟩

private theorem probComp_bind_congr_support {α β : Type} (oa : ProbComp α)
    (f g : α → ProbComp β) (h : ∀ x ∈ support oa, f x = g x) :
    (oa >>= f) = (oa >>= g) := by
  induction oa using OracleComp.inductionOn with
  | pure a =>
    simp only [pure_bind]
    exact h a (by simp)
  | query_bind t r ih =>
    simp only [bind_assoc]
    exact bind_congr fun u => ih u fun x hx =>
      h x (by rw [mem_support_bind_iff]; exact ⟨u, by simp, hx⟩)

private theorem lookupSlotBucketAt_cache_eq {T Sig K I : Type} [DecidableEq I] [SampleableType K]
    (q m' : ℕ) (ks' : ℕ → K) (tL : Option ℕ) (t0 : ℕ) (ik : I)
    (s : LocalSlotBucketState T Sig K I) :
    ∀ z ∈ support (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      ((lookupSlotBucketAt q m' ks' tL t0 ik).run s)), z.2.cache = s.cache := by
  intro z hz
  unfold lookupSlotBucketAt at hz
  simp only [StateT.run_bind, StateT.run_get, pure_bind] at hz
  rcases hlk : (s.fTable t0).lookup ik with _ | k
  · simp only [hlk, StateT.run_bind, StateT.run_modify, StateT.run_pure,
      _root_.CryptoGames.SM.Construction.AuthL11.simulateQ_lImpl_run_lift_sampleT,
      simulateQ_bind, simulateQ_pure, bind_assoc, pure_bind,
      mem_support_bind_iff, support_pure, Set.mem_singleton_iff] at hz
    obtain ⟨_, _, rfl⟩ := hz; rfl
  · simp only [hlk, StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz
    subst hz; rfl

private theorem startRecv_hooksSlotBucketOptAt_cache_eq
    {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [SampleableType CCoins] [SampleableType I] [SampleableType K]
    (mode : Option Bool) (q m' : ℕ) (ks' : ℕ → K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (t0 : ℕ) (γ0 : Γ) (σ0 : Sig) (tn0 : T)
    (s : LocalSlotBucketState T Sig K I) :
    ∀ z ∈ support (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (((hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par).startRecv
        ctx P t0 γ0 σ0 tn0).run s)), z.2.cache = s.cache := by
  intro z hz
  dsimp only [hooksSlotBucketOptAt] at hz
  simp only [StateT.run_bind, StateT.run_get, pure_bind] at hz
  rcases hhon : (match s.cache t0 with
    | some (tCached, σc, kVal) => if tCached = tn0 then some (σc, kVal) else none
    | none => none) with _ | ⟨σc, kVal⟩
  · simp only [hhon] at hz
    split_ifs at hz
    · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz; subst hz; rfl
    · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz; subst hz; rfl
    · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz; subst hz; rfl
    · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz; subst hz; rfl
    · simp only [StateT.run_bind, StateT.run_pure, simulateQ_bind, simulateQ_pure,
        mem_support_bind_iff, support_pure, Set.mem_singleton_iff] at hz
      obtain ⟨⟨_, s1⟩, hs1, rfl⟩ := hz
      exact lookupSlotBucketAt_cache_eq q m' ks' tL t0 _ s _ hs1
    · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz; subst hz; rfl
  · simp only [hhon, StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz; subst hz; rfl

private theorem vRecv_hooksSlotBucketOptAt_cache_eq
    {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [Inhabited E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    (mode : Option Bool) (q m' : ℕ) (ks' : ℕ → K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (vp : VP Γ T Sig SS RS)
    (c : Header T × E) (rec : Option (Record M (Header T × E)))
    (s : LocalSlotBucketState T Sig K I) :
    ∀ z ∈ support (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      ((vRecv (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
        ctx P vp c rec).run s)), z.2.cache = s.cache := by
  intro z hz
  rcases c with ⟨⟨t_hdr, optTn⟩, e_ct⟩
  unfold vRecv at hz
  dsimp only at hz
  by_cases hg : (vp.id.sendsIn t_hdr || decide (vp.tcur + 1 < t_hdr)) = true
  · simp only [hg, ↓reduceIte, StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz
    subst hz; rfl
  · simp only [hg, Bool.false_eq_true, ↓reduceIte] at hz
    by_cases ht : t_hdr = vp.tcur + 1
    · subst ht
      simp only [↓reduceIte] at hz
      rcases optTn with _ | Tn
      · simp only [StateT.run_pure, pure_bind, simulateQ_pure, support_pure,
          Set.mem_singleton_iff] at hz
        subst hz; rfl
      · simp only [StateT.run_bind, pure_bind, simulateQ_bind,
          mem_support_bind_iff] at hz
        obtain ⟨⟨out, s1⟩, hs1, hz2⟩ := hz
        have hc1 := startRecv_hooksSlotBucketOptAt_cache_eq mode q m' ks' cka prng fs qep tL par
          ctx P (vp.tcur + 1) vp.γ vp.root Tn s _ hs1
        rcases out with _ | (_ | ⟨γ', σ', rs⟩)
        · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz2
          subst hz2; exact hc1
        · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz2
          subst hz2; exact hc1
        · dsimp only [hooksSlotBucketOptAt] at hz2
          simp only [Function.update_self, pure_bind] at hz2
          rcases hrec : fs.receive rs (vp.tcur + 1, some Tn) e_ct with _ | ⟨rs', i', m'⟩ <;>
            (simp only [hrec, StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz2;
             subst hz2; exact hc1)
    · simp only [ht, ↓reduceIte, pure_bind] at hz
      rcases hvr : vp.vR t_hdr with _ | rs
      · simp only [hvr, StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz
        subst hz; rfl
      · simp only [hvr] at hz
        dsimp only [hooksSlotBucketOptAt] at hz
        simp only [pure_bind] at hz
        rcases hrec : fs.receive rs (t_hdr, optTn) e_ct with _ | ⟨rs', i', m'⟩ <;>
          (simp only [hrec, StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz;
           subst hz; rfl)

private theorem injectE_hooksSlotBucketOptAt_cache_eq
    {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    (mode : Option Bool) (q m' : ℕ) (ks' : ℕ → K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (P : Party) (c : Header T × E)
    (es : EState (VP Γ T Sig SS RS) M (Header T × E) (LocalSlotBucketState T Sig K I)) :
    ∀ z ∈ support (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      ((implEDFPaperBucketRaw (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
        3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (.inr (.inl (.inl (.inr (P, c)))))).run es)),
      z.2.h.cache = es.h.cache := by
  intro z hz
  simp only [implEDFPaperBucketRaw, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
    injectE, StateT.run_bind, StateT.run_get, pure_bind] at hz
  split_ifs at hz
  · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz
    subst hz; rfl
  · rw [StateT.run_bind, liftH_run_eq] at hz
    simp only [simulateQ_bind, bind_assoc, pure_bind, mem_support_bind_iff] at hz
    obtain ⟨⟨out, s1⟩, hs1, hz2⟩ := hz
    have hc1 := vRecv_hooksSlotBucketOptAt_cache_eq mode q m' ks' cka prng fs qep tL par
      es.g P (es.g.st P) c none es.h _ hs1
    rcases out with _ | (_ | ⟨vp', t', i', m'⟩)
    · simp only [abortE, StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind,
        simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz2
      subst hz2; exact hc1
    · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz2
      subst hz2; exact hc1
    · dsimp only at hz2
      split_ifs at hz2
      · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz2
        subst hz2; exact hc1
      · rw [StateT.run_bind, commitE_hooksSlotBucketAt_run] at hz2
        simp only [pure_bind, pure_bind] at hz2
        subst hz2; exact hc1
      · simp only [StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind,
          simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz2
        subst hz2; exact hc1
      · simp only [StateT.run_pure, simulateQ_pure, support_pure, Set.mem_singleton_iff] at hz2
        subst hz2; exact hc1

private def forgedWinEpStep {Γ T Sig SS RS M CCoins E K I : Type} [DecidableEq T]
    (qdf : (_root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)).Domain)
    (g0 g1 : Ctx Γ T Sig SS RS M E) (st1 : LocalSlotBucketState T Sig K I)
    (winEp0 : Option ℕ) : Option ℕ :=
  if !g0.win && g1.win then
    match qdf with
    | .inl (.inl (.inr (P, c))) =>
      if decide (c.1.1 = (g0.st P).tcur + 1) && !isHonestHdrSlotBucket st1 c.1 then
        some c.1.1
      else winEp0
    | _ => winEp0
  else winEp0

private theorem ShiftEM_simulateQ {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q m : ℕ} (hq0 : 0 < q)
    (mode : Option Bool)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)) Bool)
    {rem : ℕ}
    (hoa : oa.IsQueryBoundP (· matches .inr _) rem)
    (g0 : Ctx Γ T Sig SS RS M E) (ab0 : Bool) (winEp0 : Option ℕ)
    (ks : ℕ → K) :
    ShiftCont (α := Unit) q m rem tL ks (fun ⟨_, st⟩ m' ks' =>
      simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
        ((simulateQ (implEDFPaperBucketMode (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
          3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket) oa).run
          ({ g := g0, h := st, abort := ab0 }, winEp0)) >>=
        fun ⟨bOut, (esOut, winEpOut)⟩ =>
          pure (bucketRawOut 3 tL (some (bOut, (esOut, winEpOut))))) := by
  induction oa using OracleComp.inductionOn generalizing rem g0 ab0 winEp0 with
  | pure a =>
    refine ⟨fun _ st _ => ?_, fun _ st _ _ => ?_⟩
    · simp only [simulateQ_pure, StateT.run_pure, pure_bind]
      exact OracleComp.evalDist_bind_const ($ᵗ K : ProbComp K) _
    · simp only [simulateQ_pure, StateT.run_pure, pure_bind]
  | query_bind t cont ih =>
    rw [isQueryBoundP_query_bind_iff] at hoa
    rcases t with n | qdf
    · have hcont : ∀ u, (cont u).IsQueryBoundP (· matches .inr _) rem :=
        fun u => by simpa using hoa.2 u
      have hEq : ∀ m' ks' (st : LocalSlotBucketState T Sig K I),
          simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
            ((simulateQ (implEDFPaperBucketMode (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
              3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket)
              (liftM (OracleSpec.query (spec := unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
                (PartyState Γ T Sig SS RS) M CCoins (Header T × E)) (.inl n)) >>= cont)).run
              ({ g := g0, h := st, abort := ab0 }, winEp0)) >>=
            (fun ⟨bOut, (esOut, winEpOut)⟩ =>
              pure (bucketRawOut 3 tL (some (bOut, (esOut, winEpOut))))) =
          (query (spec := unifSpec) n : ProbComp _) >>= fun u =>
            simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
              ((simulateQ (implEDFPaperBucketMode (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
                3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket) (cont u)).run
                ({ g := g0, h := st, abort := ab0 }, winEp0)) >>=
              fun ⟨bOut, (esOut, winEpOut)⟩ =>
                pure (bucketRawOut 3 tL (some (bOut, (esOut, winEpOut)))) := by
        intro m' ks' st
        have hnot : (!g0.win && g0.win) = false := by cases g0.win <;> rfl
        rcases mode with _ | (_ | _) <;>
          simp [simulateQ_bind, simulateQ_query, OracleQuery.input_query, OracleQuery.cont_query,
            id_map, StateT.run_bind, StateT.run_mk, implEDFPaperBucketMode, withWinEpDFMode,
            withWinEpDF, implEDFPaperBucketRaw, coinsE, StateT.run_lift, bind_map_left,
            _root_.CryptoGames.SM.Construction.DeliverForge.dfQueryTargetEpoch,
            _root_.CryptoGames.SM.Construction.AuthL11.lImpl]
      refine ⟨fun _ st hi => ?_, fun _ st hi v => ?_⟩
      · simp_rw [hEq]
        rw [(_root_.CryptoGames.Lazy.DEq.swap ($ᵗ K : ProbComp K)
          (query (spec := unifSpec) n : ProbComp _) _).evalDist_eq]
        exact evalDist_bind_congr (query (spec := unifSpec) n : ProbComp _) _ _ fun u =>
          (ih u (hcont u) g0 ab0 winEp0).1 () st hi
      · simp_rw [hEq]
        exact evalDist_bind_congr (query (spec := unifSpec) n : ProbComp _) _ _ fun u =>
          (ih u (hcont u) g0 ab0 winEp0).2 () st hi v
    · rcases rem with _ | rem'
      · exact absurd (hoa.1.resolve_left (by simp)) (Nat.not_lt_zero _)
      have hcont : ∀ u, (cont u).IsQueryBoundP (· matches .inr _) rem' :=
        fun u => by simpa using hoa.2 u
      let K_step : (((_root_.CryptoGames.SM.Construction.DeliverForge.specDF
          (PartyState Γ T Sig SS RS) M CCoins (Header T × E)).Range qdf ×
            Ctx Γ T Sig SS RS M E × Bool) × LocalSlotBucketState T Sig K I) →
          ℕ → (ℕ → K) → ProbComp Bool := fun ⟨(u, g1, ab1), st1⟩ m' ks' =>
        let winEp1 :=
          if mode != some false then
            if !g0.win && g1.win then
              _root_.CryptoGames.SM.Construction.DeliverForge.dfQueryTargetEpoch
                (St := PartyState Γ T Sig SS RS) (fun c => c.1.1) (.inr qdf)
            else winEp0
          else
            forgedWinEpStep qdf g0 g1 st1 winEp0
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          ((simulateQ (implEDFPaperBucketMode (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
            3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket) (cont u)).run
            ({ g := g1, h := st1, abort := ab1 }, winEp1)) >>=
          fun ⟨bOut, (esOut, winEpOut)⟩ =>
            pure (bucketRawOut 3 tL (some (bOut, (esOut, winEpOut))))
      have hC_step : ShiftCont q m rem' tL ks K_step :=
        ⟨fun ⟨u, g1, ab1⟩ st1 => (ih u (hcont u) g1 ab1 _).1 () st1,
         fun ⟨u, g1, ab1⟩ st1 => (ih u (hcont u) g1 ab1 _).2 () st1⟩
      obtain ⟨hF, hT⟩ := ShiftEM_raw_step hq0 mode cka prng fs qep tL par qdf g0 ab0 ks K_step hC_step
      have hEq : ∀ m' ks' (st : LocalSlotBucketState T Sig K I),
          simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
            ((simulateQ (implEDFPaperBucketMode (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
              3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket)
              (liftM (OracleSpec.query (spec := unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
                (PartyState Γ T Sig SS RS) M CCoins (Header T × E)) (.inr qdf)) >>= cont)).run
              ({ g := g0, h := st, abort := ab0 }, winEp0)) >>=
            (fun ⟨bOut, (esOut, winEpOut)⟩ =>
              pure (bucketRawOut 3 tL (some (bOut, (esOut, winEpOut))))) =
          simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
            ((implEDFPaperBucketRaw (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
              3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (.inr qdf)).run
              { g := g0, h := st, abort := ab0 }) >>=
            fun ⟨r, es'⟩ => K_step ((r, es'.g, es'.abort), es'.h) m' ks' := by
        intro m' ks' st
        by_cases hmf : (mode != some false) = true
        · simp [hmf, simulateQ_bind, simulateQ_query, OracleQuery.input_query, OracleQuery.cont_query,
            id_map, StateT.run_bind, StateT.run_mk, implEDFPaperBucketMode, withWinEpDFMode,
            withWinEpDF, K_step]
        · simp only [Bool.not_eq_true] at hmf
          simp only [hmf, Bool.false_eq_true, ↓reduceIte, simulateQ_bind, simulateQ_query,
            OracleQuery.input_query, OracleQuery.cont_query, id_map, StateT.run_bind, StateT.run_mk,
            implEDFPaperBucketMode, withWinEpDFMode, bind_assoc, pure_bind, K_step]
          refine probComp_bind_congr_support _ _ _ fun ⟨r, es'⟩ hmem => ?_
          rcases qdf with (((( _ | _ ) | _ ) | ⟨P, c⟩) | _) | _
          · rfl
          · rfl
          · rfl
          · have hc := injectE_hooksSlotBucketOptAt_cache_eq mode q m' ks' cka prng fs qep tL par
              P c { g := g0, h := st, abort := ab0 } (r, es') hmem
            have hhon : isHonestHdrSlotBucket st c.1 = isHonestHdrSlotBucket es'.h c.1 := by
              dsimp only [isHonestHdrSlotBucket, isHonestHdrLocalBucket, toLocalBucketState]
              rw [hc]
            dsimp only [forgedWinEpStep]
            rw [hhon]
          · rfl
          · rfl
      exact ⟨fun _ st hi => by simpa only [hEq] using hF () st hi,
             fun _ st hi v => by simpa only [hEq] using hT () st hi v⟩

private theorem localSlotBucketOptAt_step_evalDist_eq {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType KR] [SampleableType KC] [SampleableType CCoins]
    [SampleableType I] [SampleableType K]
    {q m : ℕ} (hq0 : 0 < q) (mode : Option Bool) (ks : ℕ → K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (lam : I)
    (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (A : SchemeAdversaryDF Γ T Sig SS RS M CCoins E)
    (hq : MakesAtMostQueriesDF A q) :
    𝒟[($ᵗ K : ProbComp K) >>= fun v =>
        localSlotBucketOptAt mode q (m + 1) (Function.update ks m v) cka prng fs lam qep tL par A] =
      𝒟[localSlotBucketOptAt mode q m ks cka prng fs lam qep tL par A] := by
  unfold MakesAtMostQueriesDF at hq
  have hUnfold : ∀ m' ks',
      localSlotBucketOptAt mode q m' ks' cka prng fs lam qep tL par A =
        (($ᵗ KR : ProbComp KR) >>= fun kr => ($ᵗ KC : ProbComp KC) >>= fun kc =>
          simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
            ((rootSlotBucketAt q m' ks' prng qep tL par 0 false lam (prng.init kr)).run {}) >>=
            fun ⟨⟨σ, kVal⟩, s0⟩ =>
              let parties := mkParties (cka.initA kc) (cka.initB kc) σ
                (fs.initSender kVal) (fs.initReceiver kVal)
              let g0 : Ctx Γ T Sig SS RS M E :=
                { st := fun P => match P with | .A => parties.1 | .B => parties.2, b := false }
              simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
                ((simulateQ (implEDFPaperBucketMode (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
                  3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket) A).run
                  ({ g := g0, h := s0, abort := false }, none)) >>=
                fun ⟨bOut, (esOut, winEpOut)⟩ =>
                  pure (bucketRawOut 3 tL (some (bOut, (esOut, winEpOut))))) := by
    intro m' ks'
    unfold localSlotBucketOptAt engRunDFPaperBucketMode initSlotBucketAt
    rw [map_eq_bind_pure_comp]
    simp only [StateT.run_bind, _root_.CryptoGames.SM.Construction.AuthL11.simulateQ_lImpl_run_lift_sampleT,
      StateT.run_pure, simulateQ_bind, simulateQ_pure, bind_assoc, pure_bind, Function.comp_def]
    rfl
  simp_rw [hUnfold]
  rw [(_root_.CryptoGames.Lazy.DEq.swap ($ᵗ K : ProbComp K) ($ᵗ KR : ProbComp KR) _).evalDist_eq]
  refine evalDist_bind_congr ($ᵗ KR : ProbComp KR) _ _ fun kr => ?_
  rw [(_root_.CryptoGames.Lazy.DEq.swap ($ᵗ K : ProbComp K) ($ᵗ KC : ProbComp KC) _).evalDist_eq]
  refine evalDist_bind_congr ($ᵗ KC : ProbComp KC) _ _ fun kc => ?_
  let K_init : ((Sig × K) × LocalSlotBucketState T Sig K I) → ℕ → (ℕ → K) → ProbComp Bool :=
    fun ⟨⟨σ, kVal⟩, s0⟩ m' ks' =>
      let parties := mkParties (cka.initA kc) (cka.initB kc) σ
        (fs.initSender kVal) (fs.initReceiver kVal)
      let g0 : Ctx Γ T Sig SS RS M E :=
        { st := fun P => match P with | .A => parties.1 | .B => parties.2, b := false }
      simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
        ((simulateQ (implEDFPaperBucketMode (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par)
          3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket) A).run
          ({ g := g0, h := s0, abort := false }, none)) >>=
        fun ⟨bOut, (esOut, winEpOut)⟩ =>
          pure (bucketRawOut 3 tL (some (bOut, (esOut, winEpOut))))
  have hSim : ∀ (σ : Sig) (kVal : K),
      ShiftCont (α := Unit) q m q tL ks (fun ⟨_, s0⟩ m' ks' => K_init ((σ, kVal), s0) m' ks') := by
    intro σ kVal
    exact ShiftEM_simulateQ hq0 mode cka prng fs qep tL par A
      (rem := q) (by convert hq using 1; funext x; rcases x with _ | _ <;> rfl) _ false none ks
  have hInvEmpty : SlotInv q m q tL false ({} : LocalSlotBucketState T Sig K I) := by
    refine ⟨by simp, fun _ _ => by simp, ?_⟩
    simp only [Bool.false_eq_true, false_iff]
    rintro ⟨t0, i, _, hi, _⟩
    simp at hi
  unfold rootSlotBucketAt
  dsimp only
  split_ifs with h1 h2 h3
  · simp only [StateT.run_pure, simulateQ_pure, pure_bind]
    exact (hSim _ _).1 () {} hInvEmpty
  · simp only [StateT.run_bind, _root_.CryptoGames.SM.Construction.AuthL11.simulateQ_lImpl_run_lift_sampleT,
      StateT.run_pure, simulateQ_bind, simulateQ_pure, bind_assoc, pure_bind]
    rw [(_root_.CryptoGames.Lazy.DEq.swap ($ᵗ K : ProbComp K) ($ᵗ I : ProbComp I) _).evalDist_eq]
    refine evalDist_bind_congr ($ᵗ I : ProbComp I) _ _ fun ir => ?_
    rw [(_root_.CryptoGames.Lazy.DEq.swap ($ᵗ K : ProbComp K) ($ᵗ K : ProbComp K) _).evalDist_eq]
    refine evalDist_bind_congr ($ᵗ K : ProbComp K) _ _ fun kS => ?_
    exact (hSim _ _).1 () {} hInvEmpty
  · have htH0 : healEpoch tL ≤ 0 := healEpoch_le_of_inStage2Bucket h3
    have hsub0 : 0 - healEpoch tL = 0 := by omega
    let mkSt0 : K → LocalSlotBucketState T Sig K I := fun kUse =>
      { fTable := Function.update (fun _ => []) 0 [(lam, kUse)]
        sessions := Function.update (fun _ => []) 0 [lam] }
    have hRunLk : ∀ m' (ks' : ℕ → K),
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          ((do
            let kLookup ← lookupSlotBucketAt (T := T) (Sig := Sig) q m' ks' tL 0 lam
            pure ((prng.up (prng.init kr) lam).1, kLookup)).run {}) =
        (($ᵗ K : ProbComp K) >>= fun kDrawn =>
          let kUse := if 0 < m' then ks' 0 else kDrawn
          pure (((prng.up (prng.init kr) lam).1, kUse), mkSt0 kUse)) := by
      intro m' ks'
      unfold lookupSlotBucketAt
      have h0ft : ({} : LocalSlotBucketState T Sig K I).fTable 0 = [] := rfl
      have h0ses : ({} : LocalSlotBucketState T Sig K I).sessions 0 = [] := rfl
      simp only [StateT.run_bind, StateT.run_get, pure_bind, List.lookup,
        StateT.run_modify, StateT.run_pure,
        _root_.CryptoGames.SM.Construction.AuthL11.simulateQ_lImpl_run_lift_sampleT,
        simulateQ_bind, simulateQ_pure, bind_assoc, List.length_nil, List.nil_append,
        hsub0, mul_zero, add_zero]
      rfl
    simp_rw [hRunLk]
    simp only [bind_assoc, pure_bind]
    by_cases hm0 : m = 0
    · subst hm0
      simp only [Nat.zero_lt_succ, Nat.lt_irrefl, ↓reduceIte, Function.update_self]
      trans 𝒟[($ᵗ K : ProbComp K) >>= fun v =>
          K_init (((prng.up (prng.init kr) lam).1, v), mkSt0 v) 1 (Function.update ks 0 v)]
      · refine evalDist_bind_congr ($ᵗ K : ProbComp K) _ _ fun v => ?_
        exact OracleComp.evalDist_bind_const ($ᵗ K : ProbComp K) _
      · refine evalDist_bind_congr ($ᵗ K : ProbComp K) _ _ fun w => ?_
        have hInv0 : SlotInv q 0 q tL true (mkSt0 w) := by
          refine ⟨by simp [mkSt0], fun t' ht' => ?_, ?_⟩
          · have hne : t' ≠ 0 := by omega
            simp [mkSt0, Function.update_of_ne hne]
          · simp only [true_iff]
            exact ⟨0, 0, htH0, by simp [mkSt0], by simp [hsub0]⟩
        exact (hSim _ w).2 () (mkSt0 w) hInv0 w
    · have h0_ne : (0 : ℕ) ≠ m := Ne.symm hm0
      have h0_lt : 0 < m := by omega
      have h0_lt1 : 0 < m + 1 := by omega
      simp only [h0_lt, h0_lt1, ↓reduceIte, Function.update_of_ne h0_ne]
      rw [(_root_.CryptoGames.Lazy.DEq.swap ($ᵗ K : ProbComp K) ($ᵗ K : ProbComp K) _).evalDist_eq]
      refine evalDist_bind_congr ($ᵗ K : ProbComp K) _ _ fun _ => ?_
      have hInv0 : SlotInv q m q tL false (mkSt0 (ks 0)) := by
        refine ⟨by simp [mkSt0], fun t' ht' => ?_, ?_⟩
        · have hne : t' ≠ 0 := by omega
          simp [mkSt0, Function.update_of_ne hne]
        · simp only [Bool.false_eq_true, false_iff]
          rintro ⟨t1, i1, _, hi1, heq1⟩
          by_cases ht1 : t1 = 0
          · subst ht1
            simp only [mkSt0, Function.update_self, List.length_singleton] at hi1
            have hi0 : i1 = 0 := by omega
            subst hi0; simp [hsub0] at heq1; exact h0_ne heq1
          · simp [mkSt0, Function.update_of_ne ht1] at hi1
      exact (hSim _ (ks 0)).1 () (mkSt0 (ks 0)) hInv0
  · simp only [StateT.run_pure, simulateQ_pure, pure_bind]
    exact (hSim _ _).1 () {} hInvEmpty

private theorem localAuthDFPaperBucketOpt_evalDist_eq_sampleVec
    {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType KR] [SampleableType KC] [SampleableType CCoins]
    [SampleableType I] [SampleableType K]
    {q : ℕ} (hq0 : 0 < q) (mode : Option Bool) (k0 : K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (lam : I)
    (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (A : SchemeAdversaryDF Γ T Sig SS RS M CCoins E)
    (hq : MakesAtMostQueriesDF A q) (M_sess : ℕ) :
    𝒟[sampleVec ($ᵗ K : ProbComp K) k0 M_sess >>= fun ks =>
        localSlotBucketOptAt mode q M_sess ks cka prng fs lam qep tL par A] =
      𝒟[localAuthDFPaperBucketOpt mode cka prng fs lam 1 qep tL par A] := by
  induction M_sess with
  | zero =>
    simp [sampleVec, localSlotBucketOptAt_zero_eq mode q (fun _ => k0) cka prng fs lam qep tL par A hq]
  | succ m ih =>
    simp only [sampleVec, bind_assoc, pure_bind]
    rw [evalDist_bind_congr (sampleVec ($ᵗ K : ProbComp K) k0 m) _ _ fun ks =>
      localSlotBucketOptAt_step_evalDist_eq hq0 mode ks cka prng fs lam qep tL par A hq]
    exact ih

end SeedAlignment

private theorem le_multiSessRealWinProb_of_perKey_local {Pt : Type} [DecidableEq Pt]
    (C : Crypto) (ℓ : ℕ) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (Adv : Bool → Computational.Proofs.E2E.SessionAuthBridge.MultiSessFsAdv Pt ℓ)
    (LOCAL : ProbComp Bool) (LOCALks : (ℕ → BitVec 256) → ProbComp Bool)
    (M : ℕ) (k0 : BitVec 256)
    (hH1 : 𝒟[LOCAL] {true} ≤
      𝒟[sampleVec ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) k0 M >>= LOCALks] {true})
    (hH3 : ∀ la, (Adv la).IsQueryBoundP (fun t => sessOffRange M t = true) 0)
    (hK : ∀ (ks : ℕ → BitVec 256) (bs : ℕ → Bool), LeAdd (LOCALks ks)
      (Prod.fst <$> (simulateQ (sessLift (fsImpl
          (lIdeal C protoSignalCodec ℓ encT)
          (lAeadR C protoSignalCodec ℓ encT idOf)
          (lChainPRG C.F) maxForwardJumps (hp 0 0 false)))
          (Adv false)).run (fun i => hInit (bs i) (.seed (ks i))))
      (Prod.fst <$> (simulateQ (sessLift (fsImpl
          (lIdeal C protoSignalCodec ℓ encT)
          (lAeadR C protoSignalCodec ℓ encT idOf)
          (lChainPRG C.F) maxForwardJumps (hp 0 0 true)))
          (Adv true)).run (fun i => hInit (bs i) (.seed (ks i))))) :
    𝒟[LOCAL] {true} ≤
      multiSessRealWinProb C ℓ encT idOf Adv false +
        multiSessRealWinProb C ℓ encT idOf Adv true := by
  refine hH1.trans ?_
  have hStep : LeAdd
      (sampleVec ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) k0 M >>= LOCALks)
      (sampleVec ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) k0 M >>= fun ks =>
        sampleVec ($ᵗ Bool : ProbComp Bool) false M >>= fun bs =>
          Prod.fst <$> (simulateQ (sessLift (fsImpl
            (lIdeal C protoSignalCodec ℓ encT)
            (lAeadR C protoSignalCodec ℓ encT idOf)
            (lChainPRG C.F) maxForwardJumps (hp 0 0 false)))
            (Adv false)).run (fun i => hInit (bs i) (.seed (ks i))))
      (sampleVec ($ᵗ (BitVec 256) : ProbComp (BitVec 256)) k0 M >>= fun ks =>
        sampleVec ($ᵗ Bool : ProbComp Bool) false M >>= fun bs =>
          Prod.fst <$> (simulateQ (sessLift (fsImpl
            (lIdeal C protoSignalCodec ℓ encT)
            (lAeadR C protoSignalCodec ℓ encT idOf)
            (lChainPRG C.F) maxForwardJumps (hp 0 0 true)))
            (Adv true)).run (fun i => hInit (bs i) (.seed (ks i)))) :=
    leAdd_bind _ fun ks _ =>
      leAdd_bind_dummy_loc _ fun bs _ => hK ks bs
  unfold LeAdd at hStep
  exact hStep.trans (add_le_add
    (multiFsEager_le_real
      (lIdeal C protoSignalCodec ℓ encT)
      (lAeadR C protoSignalCodec ℓ encT idOf)
      (lChainPRG C.F) maxForwardJumps M k0 false (Adv false) (hH3 false))
    (multiFsEager_le_real
      (lIdeal C protoSignalCodec ℓ encT)
      (lAeadR C protoSignalCodec ℓ encT idOf)
      (lChainPRG C.F) maxForwardJumps M k0 true (Adv true) (hH3 true)))

private theorem redFSAuthDFPaperMultiBucket_offRange_raw
    (ℓ : ℕ) (Pt : Type) [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey)
    (idOf : Party → IdentityKey) (lam : Pt)
    (q qep : ℕ) (tL : Option ℕ) (par la : Bool)
    (A : AdversaryDF (Fig8St Pt) (LibsignalMsgPublicPart × Plain ℓ) (BitVec 256) (Fig8C Pt))
    (hq : MakesAtMostQueriesDF A q) :
    (redFSAuthDFPaperMultiBucket (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
      (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) lam 1 4 qep la tL par A).IsQueryBoundP
      (fun u => sessOffRange (((qep + 2) - healEpoch tL) * q) u = true) 0 := by
  apply isQueryBoundP_sessOffRange_of_ge_zero
  intro idx hidx
  convert
    Computational.Proofs.CryptoGames.SM.Theorem8.DeliverForgePaperFSMulti.redFSAuthDFPaperMultiBucket_inactive_isQueryBoundP_zero
      ℓ Pt C Dh encPt encT idOf lam q 1 4 qep (by decide) tL par la A hq idx (Or.inr (Or.inl hidx))
    using 1
  funext x; rcases x with _ | ⟨_, _⟩ <;> rfl

/-! ### Independent Sub-Lemmas -/

/-- Sub-lemma 1 (Lazy-to-eager slot key pre-sampling): When `0 < q` and `MakesAtMostQueriesDF A q`,
pre-sampling `m` uniform session keys `ks ← sampleVec ($ᵗ K) k0 m` and feeding active bucket slots
`< m` from `ks` upper-bounds `localAuthDFPaperBucketOpt`. -/
private theorem localAuthBucketOpt_le_sampleVec
    {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType KR] [SampleableType KC] [SampleableType CCoins]
    [SampleableType I] [SampleableType K]
