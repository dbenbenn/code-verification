                  · rw [h0] at hvS; cases hvS
                  · rw [h0] at hvS; cases hvS
                  · have heq_idx : q * (τ' - healEpoch tL) + k' = q * (τ - healEpoch tL) + j' := by
                      rw [hvS] at h0; injection h0 with h0'; injection h0' with h0''; exact h0''.symm
                    rw [hs' hsQ, ← hτ] at heq_idx hk'
                    have hk'_eq : j' = k' := by omega
                    subst hk'_eq
                    by_cases hτ0 : τ = 0
                    · subst hτ0; exact lt_of_lt_of_le hk' hinv.sess_zero_le
                    · have := hinv.sess_pos_bound τ (by omega); omega
                have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
                  intro heq
                  obtain ⟨hτ_eq, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hτ_bk) htH_le hj'_q hj_q heq
                  rw [hτ_eq, hhealed_ep_f] at hh; cases hh
                simp only [Function.update_of_ne hne_s]
                exact hinv.healed_sender_pin Q τ j' hsQ hτ hvS hh
            healed_vR_pin := fun Q τ sIdx' hvR hh => by
              dsimp only [esLoc', esM', GameState.record] at hvR hh ⊢
              have hvR_orig : (esM.g.st Q).vR τ = some (.inr sIdx') := by
                by_cases hQ : Q = P
                · subst hQ; simpa [stM'] using hvR
                · simpa [Function.update_of_ne hQ] using hvR
              exact hinv.healed_vR_pin Q τ sIdx' hvR_orig hh
            healed_book_trans := fun τ sIdx' hh hro hp => by
              dsimp only [esLoc', esM', GameState.record] at hh hro hp ⊢
              have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
                  (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
                rcases hro with hlt | hvR
                · exact Or.inl hlt
                · right
                  by_cases hQ : Party.receiverOf τ = P
                  · rw [hQ] at hvR ⊢; simpa [stM'] using hvR
                  · simpa [Function.update_of_ne hQ] using hvR
              have hne_ep : τ ≠ ep := by intro heq; subst heq; rw [hhealed_ep_f] at hh; cases hh
              have hne_s : sIdx' ≠ sIdx := by
                intro heq; subst heq
                rcases hp with ⟨h0, hs0, _, htL_n⟩ | ⟨h1, Tc, σc, kMulti, hc⟩
                · subst h0
                  have hep_gt : 1 ≤ ep := by omega
                  have hq_pos : 0 < q := by omega
                  have hmul_pos : 0 < q * ep := Nat.mul_pos hq_pos hep_gt
                  have hsub : ep - healEpoch tL = ep := by subst htL_n; simp [healEpoch]
                  dsimp only [sIdx] at hs0
                  rw [hsub] at hs0
                  omega
                · rcases hinv.cache_sync τ with ⟨_, hcn⟩ | ⟨_, _, _, _, _, hcn⟩ |
                      ⟨_, _, _, j', _, hj'_len, _, hbk', _, _, hcs⟩
                  · rw [hcn] at hc; cases hc
                  · rw [hcn] at hc; cases hc
                  · rw [hcs] at hc
                    simp only [Option.some.injEq, Prod.mk.injEq] at hc
                    have hs_eq' : q * (τ - healEpoch tL) + j' = sIdx := hc.2.2.2
                    have hj'_q : j' < q := by have := hinv.sess_pos_bound τ h1; omega
                    obtain ⟨hτ_eq, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hbk') htH_le hj'_q hj_q hs_eq'
                    exact hne_ep hτ_eq
              have hb_ne : (rec_.pos.epoch == τ) = false := beq_false_of_ne (Ne.symm hne_ep)
              simp only [Function.update_of_ne hne_s, List.filter_cons, hb_ne, Bool.false_eq_true, ↓reduceIte]
              exact hinv.healed_book_trans τ sIdx' hh hro_orig hp }
      · -- No corruptSender needed: transmitQuery directly
        have hchk_f : (!(esM.g.safeCh 3 P) && !bk.sCorr) = false := Bool.not_eq_true _ |>.mp hchk
        obtain ⟨sM', sL', htx_run, _, hsinv'⟩ :=
          activeSessInv_transmit C (hrt_and_len_check ℓ hℓ).1 ℓ (hrt_and_len_check ℓ hℓ).2 encT idOf
            (hinv.sess_inv sIdx) hdr m hshort
        let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
          { bk with fsCount := bk.fsCount + 1, fsTrans := (bk.fsCount + 1, hdr, o.2) :: bk.fsTrans }
        let esM' : MultiES Pt ℓ :=
          { esM with
            g := esM.g.record 3 P stM' rec_ false
            h := { esM.h with book := Function.update esM.h.book sIdx (some bk') } }
        let tblM' := Function.update tblM sIdx sM'
        let tblL' := Function.update tblL sIdx sL'
        have hstepM :
            (simulateQ (pubFsImplOpt C ℓ encT idOf false)
              (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
                3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tblM) =
            pure ((some (hdr, o.2), esM'), (fun _ => false, tblM')) := by
          simp only [qr, implEDFPaperBucketRaw, transmitEBucket, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
            StateT.run_bind, StateT.run_get, pure_bind, hinv.abort_M, hwinM, Bool.or_self,
            Bool.false_eq_true, ↓reduceIte, hepM, run_liftH_eq, vSend, hsM_id,
            bind_assoc, hhdr_M, hvM, hkMultiOpt_fsSend, simulateQ_bind, ep]
          rw [sim_fsSend_multi_inr_nocheck C Dh encPt encT idOf ℓ q qep tL par false
            esM.g P (esM.g.st P).tcur (q * (esLoc.g.epoch P - healEpoch tL) + j) hdr m esM.h tblM hchk_f htx_run]
          simp only [pure_bind, StateT.run_bind, StateT.run_modify, StateT.run_pure, simulateQ_pure,
            ← congrFun hinv.gsync.epoch_eq P, ← congrFun hinv.gsync.idx_eq P, hinv.abort_M,
            hdr, bk', bk, o, stM', rec_, esM', tblM', ep, sIdx]
        rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc' _ hinv.win_false hstepLoc,
            runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM' tblM tblM' _ hwinM hstepM]
        have hwinLoc' : esLoc'.g.win = false := hinv.win_false
        have hwinM' : esM'.g.win = false := hwinM
        simp only [hwinLoc', hwinM', calcWinEp, Bool.false_eq_true, ↓reduceIte]
        apply hIH2 (some (hdr, o.2)) ssLoc' rsLoc esLoc' esM' esL tblM' tblL'
        exact
          { gsync := hinv.gsync.record_sync P stLoc' stM' rec_ false
            abort_loc := hinv.abort_loc
            abort_M := hinv.abort_M
            win_false := hinv.win_false
            lfWin_M := hinv.lfWin_M
            comp_unhealed := hrec_pr.1
            tL_mem_leaks := hrec_pr.2.1
            phase1_props := fun hp => Bool.noConfusion hp
            phase2_props := fun _ => hpl1
            sess_eq := hinv.sess_eq
            sess_nodup := hinv.sess_nodup
            sess_zero_le := hinv.sess_zero_le
            sess_pos_bound := fun τ hτ =>
              le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
            sess_epoch_ok := hinv.sess_epoch_ok
            fTable_M_iff := hinv.fTable_M_iff
            fTable_loc_eq := hinv.fTable_loc_eq
            cache_sync := hinv.cache_sync
            vp_id := fun Q => by
              dsimp only [esLoc', esM', GameState.record]
              rcases eq_or_ne Q P with rfl | hQ
              · simp [stLoc', stM', (hinv.vp_id Q).1, (hinv.vp_id Q).2]
              · simp [Function.update_of_ne hQ, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
            vp_tcur_eq := fun Q => by
              dsimp only [esLoc', esM', GameState.record]
              rcases eq_or_ne Q P with rfl | hQ
              · simp [stLoc', stM', (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
              · simp [Function.update_of_ne hQ, (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
            vp_γ_eq := fun Q => by
              dsimp only [esLoc', esM', GameState.record]
              rcases eq_or_ne Q P with rfl | hQ
              · simp [stLoc', stM', hinv.vp_γ_eq Q]
              · simp [Function.update_of_ne hQ, hinv.vp_γ_eq Q]
            vp_root_eq := fun Q => by
              dsimp only [esLoc', esM', GameState.record]
              rcases eq_or_ne Q P with rfl | hQ
              · simp [stLoc', stM', hinv.vp_root_eq Q]
              · simp [Function.update_of_ne hQ, hinv.vp_root_eq Q]
            vp_cka_eq := fun Q => by
              dsimp only [esLoc', esM', GameState.record]
              rcases eq_or_ne Q P with rfl | hQ
              · simp [stLoc', stM', hinv.vp_cka_eq Q]
              · simp [Function.update_of_ne hQ, hinv.vp_cka_eq Q]
            vp_cka_cache := fun Q hQ_sends => by
              dsimp only [esLoc', esM', GameState.record] at hQ_sends ⊢
              by_cases hQ : Q = P
              · rw [hQ] at hQ_sends ⊢
                rcases hinv.vp_cka_cache P hP_sends with ⟨h0, hc, ⟨_, _, hv⟩ | ⟨hbk0, hv⟩⟩ |
                    ⟨h1, Tc, σc, kMulti, optIdx, hc, hcache, ⟨_, _, hv⟩ | ⟨sIdx', hopt, hv⟩⟩
                · rw [hvM] at hv; cases hv
                · rw [hvM] at hv; simp only [Option.some.injEq, Sum.inr.injEq] at hv
                  exact Or.inl ⟨h0, by simp [stLoc', hc], Or.inr ⟨hbk0, by simp [stM', sIdx, ← hv]⟩⟩
                · rw [hvM] at hv; cases hv
                · rw [hvM] at hv; simp only [Option.some.injEq, Sum.inr.injEq] at hv
                  exact Or.inr ⟨h1, Tc, σc, kMulti, optIdx, by simp [stLoc', hc], hcache,
                    Or.inr ⟨sIdx, by dsimp only [sIdx]; rw [hopt, hv], by simp [stM']⟩⟩
              · simpa [Function.update_of_ne hQ] using hinv.vp_cka_cache Q hQ_sends
            epoch_bound := fun Q =>
              le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
            vS_sync := fun Q => by
              dsimp only [esLoc', esM', GameState.record]
              by_cases hQ : Q = P
              · subst hQ
                exact Or.inr (Or.inr ⟨ep, j, le_rfl, fun _ => rfl, hP_send, hcap, hbk, htH, hj_len,
                  by simp [stLoc', ssLoc', sIdx], by simp [stM', sIdx]⟩)
              · rw [Function.update_of_ne hQ, Function.update_of_ne hQ]
                rcases hinv.vS_sync Q with h0 | h1 | ⟨τ, j', hle, hsend_eq, hQ_send, hc', hb', ht', hj', hv1, hv2⟩
                · exact Or.inl h0
                · exact Or.inr (Or.inl h1)
                · have hj'_q : j' < q := by
                    by_cases hτ0 : τ = 0
                    · subst hτ0; exact lt_of_lt_of_le hj' hinv.sess_zero_le
                    · have := hinv.sess_pos_bound τ (by omega); omega
                  have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
                    intro heq
                    obtain ⟨hτ_eq, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hb') htH_le hj'_q hj_q heq
                    exact hQ (hQ_send.trans (hτ_eq ▸ hP_send.symm))
                  exact Or.inr (Or.inr ⟨τ, j', hle, hsend_eq, hQ_send, hc', hb', ht', hj',
                    by simp [ssLoc', Function.update_of_ne hne_s, hv1], hv2⟩)
            vR_dom := fun Q τ hdom => by
              dsimp only [esLoc', esM', GameState.record] at hdom ⊢
              by_cases hQ : Q = P
              · subst hQ; simp only [Function.update_self, stM'] at hdom; exact hinv.vR_dom Q τ hdom
              · simp only [Function.update_of_ne hQ] at hdom; exact hinv.vR_dom Q τ hdom
            vR_sync := fun Q τ => by
              dsimp only [esLoc', esM', GameState.record]
              by_cases hQ : Q = P
              · subst hQ; simpa [stLoc', stM'] using hinv.vR_sync Q τ
              · simpa [Function.update_of_ne hQ] using hinv.vR_sync Q τ
            sess_inv := fun sIdx' => by
              dsimp only [esM', ssLoc', tblM', tblL']
              by_cases hs' : sIdx' = sIdx
              · subst hs'
                have hsCorr_eq : bk'.sCorr = bk.sCorr := rfl
                simpa [Function.update_self, hsCorr_eq, o] using hsinv'
              · simpa [Function.update_of_ne hs'] using hinv.sess_inv sIdx'
            ss_fresh := fun τ j' h1 h2 h3 hlt => by
              dsimp only [esLoc', GameState.record] at hlt
              dsimp only [ssLoc']
              have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
                intro heq
                obtain ⟨hτ_eq, _⟩ := bucketSlot_inj h2 htH_le h3 hj_q heq
                subst hτ_eq; rw [← hP_send] at hlt; omega
              rw [Function.update_of_ne hne_s]
              exact hinv.ss_fresh τ j' h1 h2 h3 hlt
            rs_fresh := hinv.rs_fresh
            book_fresh_before_send := fun τ j' h1 h2 h3 hlt hh => by
              dsimp only [esLoc', esM', GameState.record] at hlt hh ⊢
              have hne_s : q * (τ - healEpoch tL) + j' ≠ sIdx := by
                intro heq
                obtain ⟨hτ_eq, _⟩ := bucketSlot_inj h2 htH_le h3 hj_q heq
                subst hτ_eq; rw [← hP_send] at hlt; omega
              rw [Function.update_of_ne hne_s]
              exact hinv.book_fresh_before_send τ j' h1 h2 h3 hlt hh
            trans_meta := fun r' hr' => by
              dsimp only [esLoc', esM', GameState.record] at hr' ⊢
              rcases List.mem_cons.mp hr' with rfl | hr_old
              · refine ⟨rfl, hP_send, le_rfl, ?_, ?_⟩
                · intro h0
                  dsimp only [rec_, ep] at h0
                  rcases hinv.vp_cka_cache P hP_sends with ⟨_, hc, _⟩ | ⟨h1, _⟩
                  · simp [rec_, hdr, ep, h0, hc]
                  · omega
                · intro h1
                  dsimp only [rec_, ep] at h1
                  rcases hinv.vp_cka_cache P hP_sends with ⟨h0, _⟩ | ⟨_, Tc, σc, kMulti, optIdx, hc, hcache, _⟩
                  · omega
                  · exact ⟨Tc, by simp [rec_, hdr, hc], σc, kMulti, optIdx, hcache⟩
              · exact hinv.trans_meta r' hr_old
            cache_empty_gt := hinv.cache_empty_gt
            healed_sender_pin := fun Q τ j' hsQ hτ hvS hh => by
              dsimp only [esLoc', esM', GameState.record] at hsQ hτ hvS hh ⊢
              by_cases hQ : Q = P
              · rw [hQ] at hsQ hτ hvS ⊢
                simp only [Function.update_self, stM'] at hvS ⊢
                have heq_idx : q * (ep - healEpoch tL) + j = q * (τ - healEpoch tL) + j' := by
                  simp only [Option.some.injEq, Sum.inr.injEq, sIdx] at hvS; exact hvS
                rw [hτ] at heq_idx ⊢
                have hj'_eq : j' = j := by dsimp only [ep] at heq_idx; omega
                rw [hj'_eq]
                obtain ⟨hidx_cnt, hpin_rest⟩ :=
                  hinv.healed_sender_pin P ep j hP_sends rfl hvM (by dsimp only [ep]; rwa [← hτ])
                exact ⟨by simp [rec_, bk', bk, hidx_cnt, sIdx, ep], by simpa [stM', sIdx, ep] using hpin_rest⟩
              · simp only [Function.update_of_ne hQ] at hvS ⊢
                rcases hinv.vS_sync Q with ⟨_, h0⟩ | ⟨_, _, h0⟩ | ⟨τ', k', _, hs', hQ_send, _, hb', _, hk', _, h0⟩
                · rw [h0] at hvS; cases hvS
                · rw [h0] at hvS; cases hvS
                · have heq_idx : q * (τ' - healEpoch tL) + k' = q * (τ - healEpoch tL) + j' := by
                    rw [hvS] at h0; simp only [Option.some.injEq, Sum.inr.injEq] at h0; exact h0.symm
                  rw [hs' hsQ, ← hτ] at heq_idx hk' hb' hQ_send
                  have hk'_eq : j' = k' := by omega
                  rw [hk'_eq] at hvS ⊢
                  have hj'_q : k' < q := by
                    by_cases hτ0 : τ = 0
                    · subst hτ0; exact lt_of_lt_of_le hk' hinv.sess_zero_le
                    · have := hinv.sess_pos_bound τ (by omega); omega
                  have hne_s : q * (τ - healEpoch tL) + k' ≠ sIdx := by
                    intro heq
                    obtain ⟨hτ_eq, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hb') htH_le hj'_q hj_q heq
                    exact hQ (hQ_send.trans (hτ_eq ▸ hP_send.symm))
                  simp only [Function.update_of_ne hne_s]
                  exact hinv.healed_sender_pin Q τ k' hsQ hτ hvS hh
            healed_vR_pin := fun Q τ sIdx' hvR hh => by
              dsimp only [esLoc', esM', GameState.record] at hvR hh ⊢
              have hvR_orig : (esM.g.st Q).vR τ = some (.inr sIdx') := by
                by_cases hQ : Q = P
                · rw [hQ] at hvR ⊢; simpa [stM'] using hvR
                · simpa [Function.update_of_ne hQ] using hvR
              exact hinv.healed_vR_pin Q τ sIdx' hvR_orig hh
            healed_book_trans := fun τ sIdx' hh hro hp => by
              dsimp only [esLoc', esM', GameState.record] at hh hro hp ⊢
              have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
                  (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx') := by
                rcases hro with hlt | hvR
                · exact Or.inl hlt
                · right
                  by_cases hQ : Party.receiverOf τ = P
                  · rw [hQ] at hvR ⊢; simpa [stM'] using hvR
                  · simpa [Function.update_of_ne hQ] using hvR
              by_cases hτ_ep : τ = ep
              · rw [hτ_ep] at hh hro_orig hp ⊢
                obtain ⟨hidx_cnt, hpin_rest⟩ := hinv.healed_sender_pin P ep j hP_sends rfl hvM hh
                have hs_eq : sIdx' = sIdx := by
                  rcases hpin_rest with ⟨h0, hj0, _⟩ | ⟨h1, Tc, σc, kMulti, _, hc⟩
                  · rcases hp with ⟨_, rfl, _⟩ | ⟨h1, _⟩
                    · simp [sIdx, h0, hj0]
                    · omega
                  · rcases hp with ⟨h0, _⟩ | ⟨_, _, _, _, hc'⟩
                    · omega
                    · rw [hc] at hc'
                      simp only [Option.some.injEq, Prod.mk.injEq] at hc'
                      exact hc'.2.2.2.symm
                rw [hs_eq] at hro_orig hp ⊢
                have hprev := hinv.healed_book_trans ep sIdx hh hro_orig hp
                rw [Function.update_self, List.filter_cons_of_pos (by simp [rec_])]
                dsimp only [Option.getD, bk', bk, rec_, List.map_cons, sIdx] at hidx_cnt hprev ⊢
                rw [hidx_cnt, hprev]; rfl
              · have hne_s : sIdx' ≠ sIdx := by
                  intro heq; subst heq
                  rcases hp with ⟨h0, hs0, _, htL_n⟩ | ⟨h1, Tc, σc, kMulti, hc⟩
                  · subst h0
                    have hep_gt : 1 ≤ ep := by omega
                    have hq_pos : 0 < q := by omega
                    have hmul_pos : 0 < q * ep := Nat.mul_pos hq_pos hep_gt
                    have hsub : ep - healEpoch tL = ep := by subst htL_n; simp [healEpoch]
                    dsimp only [sIdx] at hs0
                    rw [hsub] at hs0
                    omega
                  · rcases hinv.cache_sync τ with ⟨_, hcn⟩ | ⟨_, _, _, _, _, hcn⟩ |
                        ⟨_, _, _, j', _, hj'_len, _, hbk', _, _, hcs⟩
                    · rw [hcn] at hc; cases hc
                    · rw [hcn] at hc; cases hc
                    · rw [hcs] at hc
                      simp only [Option.some.injEq, Prod.mk.injEq] at hc
                      have hs_eq' : q * (τ - healEpoch tL) + j' = sIdx := hc.2.2.2
                      have hj'_q : j' < q := by have := hinv.sess_pos_bound τ h1; omega
                      obtain ⟨hτ_eq, _⟩ := bucketSlot_inj (healEpoch_le_of_gen4 hbk') htH_le hj'_q hj_q hs_eq'
                      exact hτ_ep hτ_eq
                have hb_ne : (rec_.pos.epoch == τ) = false := beq_false_of_ne (Ne.symm hτ_ep)
                simp only [Function.update_of_ne hne_s, List.filter_cons, hb_ne, Bool.false_eq_true, ↓reduceIte]
                exact hinv.healed_book_trans τ sIdx' hh hro_orig hp }

private theorem step2_transmit {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (hℓ : ℓ < 10 ^ 6) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (m : LibsignalMsgPublicPart × Plain ℓ) (r₀ : Option (BitVec 256))
    (hshort : m.1.shortB = true)
    {α : Type}
    (r : Option (Fig8C Pt) → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inl (.inl (.inl ⟨P, m, r₀⟩))))
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  intro qr
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  rcases hinv.gsync.epMgmt_sync qep P r₀.isSome with ⟨hnoneLoc, hnoneM⟩ | ⟨s1Loc, s1M, hepLoc, hepM, hgs1⟩
  · have hstepLoc :
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
        pure (none, esLoc) := by
      simp [qr, implEDFPaperBucketRaw, transmitEBucket, hinv.abort_loc, hinv.win_false, hnoneLoc]
    have hstepM :
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tblM) =
        pure ((none, esM), (fun _ => false, tblM)) := by
      simp [qr, implEDFPaperBucketRaw, transmitEBucket, hinv.abort_M, hwinM, hnoneM]
    rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc none hinv.win_false hstepLoc,
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM none hwinM hstepM]
    simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
    exact hIH2 none ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))
  · exact step_transmit_postLeak_leOne mode C Dh encPt encT idOf ℓ q qep rem hℓ tL par false ks
      P m r₀ hshort r hIH2 ssLoc rsLoc esLoc esM esL tblM tblL hinv hepLoc hepM hgs1
      (postLeak_epMgmt_of_postLeak (hinv.phase2_props rfl) hepLoc)

private theorem regSessOpt_some_mem {Pt : Type} [DecidableEq Pt]
    (q : ℕ) (tL : Option ℕ) (t0 : ℕ) (ik : Pt) (s : MultiHS Pt)
    (hmem : ik ∈ s.sessions t0) :
    regSessOptMultiDFBucket (q + 1) tL t0 (some ik) s =
      (some (q * (t0 - healEpoch tL) + (s.sessions t0).idxOf ik), s) := by
  simp [regSessOptMultiDFBucket, regSessMultiDFBucket, hmem]

private theorem regSessOpt_some_not_mem {Pt : Type} [DecidableEq Pt]
    (q : ℕ) (tL : Option ℕ) (t0 : ℕ) (ik : Pt) (s : MultiHS Pt)
    (hnotmem : ik ∉ s.sessions t0) :
    regSessOptMultiDFBucket (q + 1) tL t0 (some ik) s =
      (some (q * (t0 - healEpoch tL) + (s.sessions t0).length),
        { s with sessions := Function.update s.sessions t0 (s.sessions t0 ++ [ik]) }) := by
  simp [regSessOptMultiDFBucket, regSessMultiDFBucket, hnotmem]

private theorem inv_phase1_newSend_inl {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (C : Crypto) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (m : LibsignalMsgPublicPart × Plain ℓ) (bad : Bool)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL)
    {s1Loc : GameState (LocVP Pt) (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    {s1M : GameState (MultiVP Pt) (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    (hepLoc : esLoc.g.epMgmt 3 qep P bad = some s1Loc)
    (hepM : esM.g.epMgmt 3 qep P bad = some s1M)
    (hgs1 : GSync s1Loc s1M)
    (hpl1_f : postLeak tL s1Loc = false)
    (hs : P.sendsIn (esLoc.g.epoch P + 1) = true)
    (γ' : CryptoGames.CKA.DDH.State (BitVec 256) Pt) (Tc : Pt) (σ' kVal : BitVec 256) :
    let t0 := esLoc.g.epoch P + 1
    let hdr : Header Pt := (t0, some Tc)
    let ss0 := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initSender kVal
    let o := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).send ss0 hdr m
    let stLoc' : LocVP Pt :=
      { esLoc.g.st P with tcur := t0, γ := γ', curCkaMsg := some Tc, root := σ', vS := some o.1 }
    let stM' : MultiVP Pt :=
      { esM.g.st P with tcur := t0, γ := γ', curCkaMsg := some Tc, root := σ', vS := some (.inl o.1) }
    let rec_ : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt) := ⟨⟨P, t0, 1⟩, m, (hdr, o.2)⟩
    let esLoc' : LocES Pt ℓ :=
      { esLoc with
        g := s1Loc.record 3 P stLoc' rec_ false
        h := { esLoc.h with cache := Function.update esLoc.h.cache t0 (some (Tc, σ', kVal)) } }
    let esM' : MultiES Pt ℓ :=
      { esM with
        g := s1M.record 3 P stM' rec_ false
        h := { esM.h with cache := Function.update esM.h.cache t0 (some (Tc, σ', kVal, none)) } }
    BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc rsLoc esLoc' esM' esM' tblM tblL := by
  intro t0 hdr ss0 o stLoc' stM' rec_ esLoc' esM'
  obtain ⟨_, _, hscorr0⟩ := hinv.phase1_props rfl
  have hpr := epMgmt_some_props hepLoc hinv.comp_unhealed hinv.tL_mem_leaks
  have hstLoc1 : s1Loc.st = esLoc.g.st := hpr.1
  have hstM1 : s1M.st = esM.g.st := w7_epMgmt_st_eq hepM
  obtain ⟨_, hep1_loc, hidx1_loc⟩ := epMgmt_some_sendsIn hepLoc hs
  have hep1_P : s1Loc.epoch P = t0 := by simp [hep1_loc, t0]
  have hep1M_P : s1M.epoch P = t0 := by rw [← hgs1.epoch_eq]; exact hep1_P
  have hP_send : P = Party.senderOf t0 := (sendsIn_iff_senderOf P t0).mp hs
  have hrec_pr := record_preserve_props s1Loc P stLoc' rec_ rfl (by simp [rec_, hep1_P])
    hpr.2.2.2.2.2.2.1 hpr.2.2.2.2.2.2.2.1
  have ht0_pos : 1 ≤ t0 := by dsimp only [t0]; omega
  have hcache0_none : esM.h.cache t0 = none :=
    hinv.cache_empty_gt t0 (by rw [← hP_send]; dsimp only [t0]; omega)
  exact
    { gsync := hgs1.record_sync P stLoc' stM' rec_ false
      abort_loc := hinv.abort_loc
      abort_M := hinv.abort_M
      win_false := by dsimp only [esLoc']; rw [hrec_pr.2.2.2, hpr.2.2.1]; exact hinv.win_false
      lfWin_M := hinv.lfWin_M
      comp_unhealed := hrec_pr.1
      tL_mem_leaks := hrec_pr.2.1
      phase1_props := fun _ => ⟨hpl1_f, rfl, hscorr0⟩
      phase2_props := fun hp => Bool.noConfusion hp
      sess_eq := hinv.sess_eq
      sess_nodup := hinv.sess_nodup
      sess_zero_le := hinv.sess_zero_le
      sess_pos_bound := fun τ hτ =>
        le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound τ hτ)
      sess_epoch_ok := hinv.sess_epoch_ok
      fTable_M_iff := hinv.fTable_M_iff
      fTable_loc_eq := hinv.fTable_loc_eq
      cache_sync := fun τ => by
        dsimp only [esLoc', esM']
        by_cases hτ : τ = t0
        · rw [hτ]
          exact Or.inr (Or.inl ⟨Tc, σ', kVal, ht0_pos, by simp, by simp⟩)
        · rw [Function.update_of_ne hτ, Function.update_of_ne hτ]
          exact hinv.cache_sync τ
      vp_id := fun Q => by
        dsimp only [esLoc', esM', GameState.record]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM', (hinv.vp_id Q).1, (hinv.vp_id Q).2]
        · simp [Function.update_of_ne hQ, hstLoc1, hstM1, (hinv.vp_id Q).1, (hinv.vp_id Q).2]
      vp_tcur_eq := fun Q => by
        dsimp only [esLoc', esM', GameState.record]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM', hep1_loc, t0]
        · simp [Function.update_of_ne hQ, hstLoc1, hstM1, hep1_loc, (hinv.vp_tcur_eq Q).1, (hinv.vp_tcur_eq Q).2]
      vp_γ_eq := fun Q => by
        dsimp only [esLoc', esM', GameState.record]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM']
        · simp [Function.update_of_ne hQ, hstLoc1, hstM1, hinv.vp_γ_eq Q]
      vp_root_eq := fun Q => by
        dsimp only [esLoc', esM', GameState.record]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM']
        · simp [Function.update_of_ne hQ, hstLoc1, hstM1, hinv.vp_root_eq Q]
      vp_cka_eq := fun Q => by
        dsimp only [esLoc', esM', GameState.record]
        rcases eq_or_ne Q P with rfl | hQ
        · simp [stLoc', stM']
        · simp [Function.update_of_ne hQ, hstLoc1, hstM1, hinv.vp_cka_eq Q]
      vp_cka_cache := fun Q hQ_sends => by
        dsimp only [esLoc', esM', GameState.record] at hQ_sends ⊢
        by_cases hQ : Q = P
        · rw [hQ] at hQ_sends ⊢
          exact Or.inr ⟨by rw [hep1_P]; exact ht0_pos, Tc, σ', kVal, none,
            by simp [stLoc'], by simp [hep1_P],
            Or.inl ⟨rfl, o.1, by simp [stM']⟩⟩
        · have hepQ : s1Loc.epoch Q = esLoc.g.epoch Q := by simp [hep1_loc, Function.update_of_ne hQ]
          rw [hepQ] at hQ_sends ⊢
          simp only [Function.update_of_ne hQ, hstLoc1, hstM1]
          rcases hinv.vp_cka_cache Q hQ_sends with h0 | ⟨h1, Tc', σc', kMulti', optIdx, hc, hcache, hv⟩
          · exact Or.inl h0
          · have hne_t0 : esLoc.g.epoch Q ≠ t0 := by
              intro heq; rw [heq] at hQ_sends
              exact hQ ((sendsIn_iff_senderOf Q t0).mp hQ_sends |>.trans hP_send.symm)
            exact Or.inr ⟨h1, Tc', σc', kMulti', optIdx, hc,
              by simp [Function.update_of_ne hne_t0, hcache], hv⟩
      epoch_bound := fun Q => by
        dsimp only [esLoc', GameState.record]
        rcases eq_or_ne Q P with rfl | hQ
        · rw [hep1_P]; have := hinv.epoch_bound Q; dsimp only [t0]; omega
        · simp only [hep1_loc, Function.update_of_ne hQ]
          have := hinv.epoch_bound Q; omega
      vS_sync := fun Q => by
        dsimp only [esLoc', esM', GameState.record]
        rcases eq_or_ne Q P with rfl | hQ
        · exact Or.inr (Or.inl ⟨o.1, by simp [stLoc'], by simp [stM']⟩)
        · simp only [Function.update_of_ne hQ, hstLoc1, hstM1, hep1_loc]
          rcases hinv.vS_sync Q with h0 | h1 | ⟨τ, j, hle, hsend_eq, hQ_send, hc, hb, ht, hj, hv1, hv2⟩
          · exact Or.inl h0
          · exact Or.inr (Or.inl h1)
          · exact Or.inr (Or.inr ⟨τ, j, hle, hsend_eq, hQ_send, by simpa using hc, hb, ht, hj, hv1, hv2⟩)
      vR_dom := fun Q τ hdom => by
        dsimp only [esLoc', esM', GameState.record] at hdom ⊢
        by_cases hQ : Q = P
        · rw [hQ] at hdom ⊢
          simp only [Function.update_self, stM'] at hdom
          obtain ⟨hle, hrecQ⟩ := hinv.vR_dom P τ hdom
          exact ⟨by rw [hep1_P]; dsimp only [t0]; omega, hrecQ⟩
        · simp only [Function.update_of_ne hQ, hstM1, hep1_loc] at hdom ⊢
          exact hinv.vR_dom Q τ hdom
      vR_sync := fun Q τ => by
        dsimp only [esLoc', esM', GameState.record]
        rcases eq_or_ne Q P with rfl | hQ
        · simpa [stLoc', stM'] using hinv.vR_sync Q τ
        · simpa [Function.update_of_ne hQ, hstLoc1, hstM1] using hinv.vR_sync Q τ
      sess_inv := hinv.sess_inv
      ss_fresh := fun τ j h1 h2 h3 hlt => by
        dsimp only [esLoc', GameState.record] at hlt
        exact hinv.ss_fresh τ j h1 h2 h3 (lt_of_le_of_lt (hpr.2.2.2.2.2.2.2.2.2 _) hlt)
      rs_fresh := fun τ j h1 h2 h3 hlt => by
        dsimp only [esLoc', GameState.record] at hlt
        exact hinv.rs_fresh τ j h1 h2 h3 (lt_of_le_of_lt (hpr.2.2.2.2.2.2.2.2.2 _) hlt)
      book_fresh_before_send := fun τ j h1 h2 h3 hlt hh => by
        dsimp only [esLoc', GameState.record] at hlt hh
        exact hinv.book_fresh_before_send τ j h1 h2 h3
          (lt_of_le_of_lt (hpr.2.2.2.2.2.2.2.2.2 _) hlt) (hpr.2.2.2.2.2.2.2.2.1 τ hh)
      trans_meta := fun r' hr' => by
        dsimp only [esLoc', esM', GameState.record] at hr' ⊢
        rw [hpr.2.1] at hr'
        rcases List.mem_cons.mp hr' with rfl | hr_old
        · refine ⟨rfl, hP_send, by simp [rec_, hep1_P], fun h0 => by simp [rec_, t0] at h0,
            fun _ => ⟨Tc, rfl, σ', kVal, none, by simp [rec_]⟩⟩
        · rcases hinv.trans_meta r' hr_old with ⟨h1, h2, h3, h4, h5⟩
          have hne_t0 : r'.pos.epoch ≠ t0 := by
            intro heq; rw [heq, ← hP_send] at h2; rw [heq, h2] at h3
            dsimp only [t0] at h3; omega
          exact ⟨h1, h2, le_trans h3 (hpr.2.2.2.2.2.2.2.2.2 _), h4,
            fun hpos => by
              rcases h5 hpos with ⟨Tc', hct, σc', kMulti', optIdx, hc⟩
              exact ⟨Tc', hct, σc', kMulti', optIdx, by simp [Function.update_of_ne hne_t0, hc]⟩⟩
      cache_empty_gt := fun τ hlt => by
        dsimp only [esLoc', esM', GameState.record] at hlt ⊢
        have hne_t0 : τ ≠ t0 := by
          intro heq; subst heq; rw [← hP_send, hep1_P] at hlt; omega
        rw [Function.update_of_ne hne_t0]
        exact hinv.cache_empty_gt τ (lt_of_le_of_lt (hpr.2.2.2.2.2.2.2.2.2 _) hlt)
      healed_sender_pin := fun Q τ j hsQ hτ hvS hh => by
        dsimp only [esLoc', esM', GameState.record] at hsQ hτ hvS hh ⊢
        by_cases hQ : Q = P
        · rw [hQ] at hvS; simp [stM'] at hvS
        · have hepQ : s1Loc.epoch Q = esLoc.g.epoch Q := by simp [hep1_loc, Function.update_of_ne hQ]
          have hidxQ : s1Loc.idx Q = esLoc.g.idx Q := by simp [hidx1_loc, Function.update_of_ne hQ]
          rw [hepQ] at hsQ hτ
          simp only [Function.update_of_ne hQ, hstM1] at hvS ⊢
          rw [hidxQ]
          have hne_t0 : τ ≠ t0 := by
            intro heq; rw [hτ] at heq; rw [heq] at hsQ
            exact hQ ((sendsIn_iff_senderOf Q t0).mp hsQ |>.trans hP_send.symm)
          simp only [Function.update_of_ne hne_t0]
          exact hinv.healed_sender_pin Q τ j hsQ hτ hvS (hpr.2.2.2.2.2.2.2.2.1 τ hh)
      healed_vR_pin := fun Q τ sIdx hvR hh => by
        dsimp only [esLoc', esM', GameState.record] at hvR hh ⊢
        have hvR_orig : (esM.g.st Q).vR τ = some (.inr sIdx) := by
          by_cases hQ : Q = P
          · rw [hQ] at hvR ⊢; simpa [stM'] using hvR
          · simpa [Function.update_of_ne hQ, hstM1] using hvR
        rcases hinv.healed_vR_pin Q τ sIdx hvR_orig (hpr.2.2.2.2.2.2.2.2.1 τ hh) with h0 | ⟨h1, Tc', σc', kMulti', hc⟩
        · exact Or.inl h0
        · have hne_t0 : τ ≠ t0 := by intro heq; subst heq; rw [hcache0_none] at hc; cases hc
          exact Or.inr ⟨h1, Tc', σc', kMulti', by simp [Function.update_of_ne hne_t0, hc]⟩
      healed_book_trans := fun τ sIdx hh hro hp => by
        dsimp only [esLoc', esM', GameState.record] at hh hro hp ⊢
        rw [hpr.2.1]
        have hro_orig : esLoc.g.epoch (Party.receiverOf τ) < τ ∨
            (esM.g.st (Party.receiverOf τ)).vR τ = some (.inr sIdx) := by
          rcases hro with hlt | hvR
          · exact Or.inl (lt_of_le_of_lt (hpr.2.2.2.2.2.2.2.2.2 _) hlt)
          · right
            by_cases hQ : Party.receiverOf τ = P
            · rw [hQ] at hvR ⊢; simpa [stM'] using hvR
            · simpa [Function.update_of_ne hQ, hstM1] using hvR
        have hne_t0 : τ ≠ t0 := by
          intro heq; subst heq
          rcases hp with ⟨h0, _⟩ | ⟨_, _, _, _, hc⟩
          · omega
          · simp at hc
        have hb_ne : (rec_.pos.epoch == τ) = false := beq_false_of_ne (Ne.symm hne_t0)
        simp only [List.filter_cons, hb_ne]
        apply hinv.healed_book_trans τ sIdx (hpr.2.2.2.2.2.2.2.2.1 τ hh) hro_orig
        rcases hp with h0 | ⟨h1, Tc', σc', kMulti', hc⟩
        · exact Or.inl h0
        · simp only [Function.update_of_ne hne_t0] at hc
          exact Or.inr ⟨h1, Tc', σc', kMulti', hc⟩ }

private theorem inv_phase1_newSend_inr {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (C : Crypto) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (m : LibsignalMsgPublicPart × Plain ℓ) (bad : Bool)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL)
    {s1Loc : GameState (LocVP Pt) (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    {s1M : GameState (MultiVP Pt) (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)}
    (hepLoc : esLoc.g.epMgmt 3 qep P bad = some s1Loc)
    (hepM : esM.g.epMgmt 3 qep P bad = some s1M)
    (hgs1 : GSync s1Loc s1M)
    (hpl1_f : postLeak tL s1Loc = false)
    (hs : P.sendsIn (esLoc.g.epoch P + 1) = true)
    (hcap : !(qep + 1 < esLoc.g.epoch P + 1) = true)
    (hbk : inStage2BucketGen 4 tL par (esLoc.g.epoch P + 1) = true)
    (htH_beq_f : !(tL.isSome && ((esLoc.g.epoch P + 1) == healEpoch tL)) = true)
    (γ' : CryptoGames.CKA.DDH.State (BitVec 256) Pt) (Tc : Pt) (σ' kMulti : BitVec 256)
    (j : ℕ) (hj_q : j < q)
    (hLoc_mid : LocHS Pt) (hM_mid : MultiHS Pt)
    (hj_len : j < (hM_mid.sessions (esLoc.g.epoch P + 1)).length)
    (hsess_eq' : hLoc_mid.sessions = hM_mid.sessions)
    (hsess_nodup' : ∀ τ, (hM_mid.sessions τ).Nodup)
    (hsess_zero' : (hM_mid.sessions 0).length ≤ q)
    (hsess_pos' : ∀ τ, 1 ≤ τ → (hM_mid.sessions τ).length + rem ≤ q)
    (hsess_ok' : ∀ τ, hM_mid.sessions τ ≠ [] →
      !(qep + 1 < τ) = true ∧ inStage2BucketGen 4 tL par τ = true ∧ !(tL.isSome && (τ == healEpoch tL)) = true)
    (hfM' : ∀ τ ik, ((hM_mid.fTable τ).lookup ik).isSome = decide (ik ∈ hM_mid.sessions τ))
    (hfLoc' : ∀ τ ik, (hLoc_mid.fTable τ).lookup ik =
      if ik ∈ hM_mid.sessions τ then some (ks (q * (τ - healEpoch tL) + (hM_mid.sessions τ).idxOf ik)) else none)
    (hsess_le : ∀ τ, (esM.h.sessions τ).length ≤ (hM_mid.sessions τ).length)
    (hmid_eq : hLoc_mid.cache = esLoc.h.cache ∧ hM_mid.cache = esM.h.cache ∧
      hM_mid.book = esM.h.book ∧ hM_mid.lfWin = esM.h.lfWin)
    (sM' sL' : SessHSt Pt ℓ)
    (hsinv' :
      let t0 := esLoc.g.epoch P + 1
      let sIdx := q * (t0 - healEpoch tL) + j
