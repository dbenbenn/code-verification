    have hstepM (la : Bool) (tbl : ℕ → SessHSt Pt ℓ) :
        (simulateQ (pubFsImplOpt C ℓ encT idOf la)
          (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tbl) =
        pure ((none, esM), (fun _ => false, tbl)) := by
      simp [qr, implEDFPaperBucketRaw, deliverE, StateT.run_bind, StateT.run_get, StateT.run_pure,
        hinv.abort_M, hwinM, hinM]
    rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc none hinv.win_false hstepLoc,
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM none hwinM (hstepM false tblM),
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblL tblL none hwinM (hstepM true tblL)]
    simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
