private theorem step2_deliverForge_aux_hdr_ct_beq_eq {Pt : Type} [DecidableEq Pt]
    (x y : Header Pt × (ℕ × LibsignalCiphertextWithSalt32)) :
    @BEq.beq _ (@instBEqProd (Header Pt) (ℕ × LibsignalCiphertextWithSalt32)
      (@instBEqProd ℕ (Option Pt) instBEqOfDecidableEq Option.instBEq)
      instBEqOfDecidableEq) x y = (x == y) := by
  change (x.1 == y.1 && decide (x.2 = y.2)) = (x.1 == y.1 && (x.2 == y.2))
  congr 1
  exact Bool.eq_iff_iff.mpr (by simp [beq_iff_eq, decide_eq_true_eq])

private theorem step2_deliverForge_aux_fsRecv_inl
    {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
