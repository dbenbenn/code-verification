    (es : EState (VP Γ T Sig SS RS) M (Header T × E) (LocalSlotBucketState T Sig K I)) :
    (commitE (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par) s P old new pos).run es =
      pure (some { (s.accept P new pos) with st := Function.update (s.accept P new pos).st P new }, es) := by
  unfold commitE
  dsimp only
  simp [hooksSlotBucketOptAt, StateT.run_bind, StateT.run_pure]

