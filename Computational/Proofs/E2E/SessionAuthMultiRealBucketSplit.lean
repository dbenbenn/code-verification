          simp only [qr, implEDFPaperBucketRaw, transmitEBucket, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
            StateT.run_bind, StateT.run_get, pure_bind, hinv.abort_M, hwinM, Bool.or_self,
            Bool.false_eq_true, ↓reduceIte, hepM, run_liftH_eq, vSend, hsM_id,
            hkMultiOpt_startSend, hkMultiOpt_fsSend]
          simp only [hooksFSMultiDFBucketPaper, hstM1, (hinv.vp_tcur_eq P).2,
            ← hinv.vp_γ_eq P, ← hinv.vp_root_eq P, hplM,
            StateT.run_bind, StateT.run_pure,
            bind_assoc, pure_bind, simulateQ_bind]
          rw [sim_rootFSMultiDFBucketPaper]
          simp only [Bool.true_or, ↓reduceIte, pure_bind, regSessOptMultiDFBucket,
            StateT.run_bind, StateT.run_get, StateT.run_set, StateT.run_modify,
            StateT.run_pure, simulateQ_pure,
            hep1M_P, hidx1M_P, zero_add, mkStep, t0, ep]
        rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc _ _ hinv.win_false hstepLoc,
            runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM _ tblM tblM _ hwinM hstepM]
        simp only [record_win_false, hpr.2.2.1, hgs1.win_eq.symm, hinv.win_false, calcWinEp,
          Bool.false_eq_true, ↓reduceIte, mkStep]
        exact hcoins c
      | none =>
        rw [runLocCont_inr_eq _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc hinv.win_false,
            runMultiCont_inr_eq _ _ _ _ _ _ _ _ _ _ _ _ qr r esM tblM hwinM]
        have hstepLoc :
            simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
              (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
            (($ᵗ (BitVec 256) : ProbComp (BitVec 256)) >>= fun c =>
              pure (some (mkStep c),
                let cOut := (dhScheme Dh).send (esLoc.g.st P).γ c
                let pIk := (rootPRNG C.F encPt).up (esLoc.g.st P).root cOut.2.2
                let hdr : Header Pt := (t0, some cOut.2.1)
                let ss0 := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initSender pIk.2
                let o := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).send ss0 hdr m
                { esLoc with
                  g := s1Loc.record 3 P
                    { esLoc.g.st P with tcur := t0, γ := cOut.1, curCkaMsg := some cOut.2.1, root := pIk.1, vS := some o.1 }
                    ⟨⟨P, t0, 1⟩, m, (hdr, o.2)⟩ false
                  h := { hLoc1 with cache := Function.update hLoc1.cache t0 (some (cOut.2.1, pIk.1, pIk.2)) } })) := by
          simp only [qr, implEDFPaperBucketRaw, transmitEBucket, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
            StateT.run_bind, StateT.run_get, pure_bind, hinv.abort_loc, hinv.win_false, Bool.or_self,
