                       StateT.run_modify, pure_bind, support_pure, Set.mem_singleton_iff] at hz2;
                     subst hz2; exact hInv1)

private theorem bind_congr_support_nilSpec {α β : Type}
    (m : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.AuthL11.nilSpec) α)
    {k₁ k₂ : α → OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.AuthL11.nilSpec) β}
    (h : ∀ a ∈ support m, k₁ a = k₂ a) :
    m >>= k₁ = m >>= k₂ := by
  induction m using OracleComp.inductionOn with
  | pure a =>
    simp only [pure_bind]
    exact h a (by simp)
  | query_bind t r ih =>
    rcases t with n | e
    · simp only [bind_assoc]
      refine bind_congr fun u => ih u fun a ha => h a ?_
      rw [mem_support_bind_iff]
      exact ⟨u, by simp, ha⟩
    · exact e.elim

private theorem simulateQ_implEDFPaperBucketMode_map_eq_on
    {Γ CCoins T Sig SS RS M E HS₁ HS₂ α : Type}
    [DecidableEq M] [DecidableEq T] [DecidableEq E] [Inhabited E]
    {Inv : ℕ → HS₁ → Prop} {f : HS₁ → HS₂}
    {hk₁ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₁ Γ T Sig SS RS M E CCoins Γ Sig SS RS}
    {hk₂ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₂ Γ T Sig SS RS M E CCoins Γ Sig SS RS}
    (hH : HooksMapStep Inv f hk₁ hk₂)
    (Δ qep maxSkip : ℕ) (cfg : Config M) (gMain : Bool)
    (isHonest₁ : HS₁ → Header T → Bool) (isHonest₂ : HS₂ → Header T → Bool)
    (hHonest : ∀ s hdr, isHonest₂ (f s) hdr = isHonest₁ s hdr)
    (oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)) α)
    {rem : ℕ} (hq : oa.IsQueryBoundP (· matches .inr _) rem)
    (es : EState (VP Γ T Sig SS RS) M (Header T × E) HS₁) (winEp : Option ℕ)
    (hInv : Inv rem es.h) :
    Prod.map id (Prod.map (mapEStateH f) id) <$>
        (simulateQ (implEDFPaperBucketMode hk₁ Δ qep maxSkip cfg gMain isHonest₁) oa).run (es, winEp) =
      (simulateQ (implEDFPaperBucketMode hk₂ Δ qep maxSkip cfg gMain isHonest₂) oa).run
        (mapEStateH f es, winEp) := by
  induction oa using OracleComp.inductionOn generalizing rem es winEp with
  | pure a =>
    simp [Prod.map]
  | query_bind t r ih =>
    rw [isQueryBoundP_query_bind_iff] at hq
    rcases t with n | qdf
    · have hcont : ∀ u, (r u).IsQueryBoundP (· matches .inr _) rem :=
        fun u => by simpa using hq.2 u
      cases gMain
      · simp only [simulateQ_bind, simulateQ_query, OracleQuery.input_query, OracleQuery.cont_query,
          id_map, implEDFPaperBucketMode, withWinEpDFMode, Bool.false_eq_true, ↓reduceIte,
          implEDFPaperBucketRaw, QueryImpl.add_apply_inl, coinsE,
          StateT.run_bind, StateT.run_mk, StateT.run_lift,
          bind_assoc, pure_bind, map_bind]
        refine bind_congr fun u => ?_
        have hg : (mapEStateH f es).g.win = es.g.win := rfl
        rw [hg]
        exact ih u (hcont u) es _ hInv
      · simp only [simulateQ_bind, simulateQ_query, OracleQuery.input_query, OracleQuery.cont_query,
          id_map, implEDFPaperBucketMode, withWinEpDFMode, ↓reduceIte, withWinEpDF,
          implEDFPaperBucketRaw, QueryImpl.add_apply_inl, coinsE,
          StateT.run_bind, StateT.run_mk, StateT.run_lift,
          bind_assoc, pure_bind, map_bind]
        refine bind_congr fun u => ?_
        have hg : (mapEStateH f es).g.win = es.g.win := rfl
        rw [hg]
        exact ih u (hcont u) es _ hInv
    · rcases rem with _ | rem'
      · exact absurd (hq.1.resolve_left (by simp)) (Nat.not_lt_zero _)
      have hcont : ∀ u, (r u).IsQueryBoundP (· matches .inr _) rem' :=
        fun u => by simpa using hq.2 u
      obtain ⟨heq, hsupp⟩ := implEDFPaperBucketRaw_map_step hH Δ qep maxSkip cfg rem' qdf es hInv
      cases gMain
      · simp only [simulateQ_bind, simulateQ_query, OracleQuery.input_query, OracleQuery.cont_query,
          id_map, implEDFPaperBucketMode, withWinEpDFMode, Bool.false_eq_true, ↓reduceIte,
          StateT.run_bind, StateT.run_mk, bind_assoc, pure_bind, map_bind]
        rw [← heq, bind_map_left]
        refine bind_congr_support_nilSpec _ fun ⟨u, es1⟩ hum => ?_
        have hg0 : (mapEStateH f es).g.win = es.g.win := rfl
        have hg1 : (mapEStateH f es1).g.win = es1.g.win := rfl
        have hgst : (mapEStateH f es).g.st = es.g.st := rfl
        have hhh : (mapEStateH f es).h = f es.h := rfl
        simp only [Prod.map, id_eq, hg0, hg1, hgst, hhh]
        rcases qdf with (((( _ | _ ) | _ ) | ⟨P, c⟩) | _) | _
        · dsimp only; exact ih u (hcont u) es1 _ (hsupp (u, es1) hum)
        · dsimp only; exact ih u (hcont u) es1 _ (hsupp (u, es1) hum)
        · dsimp only; exact ih u (hcont u) es1 _ (hsupp (u, es1) hum)
        · dsimp only; rw [hHonest]; exact ih u (hcont u) es1 _ (hsupp (u, es1) hum)
        · dsimp only; exact ih u (hcont u) es1 _ (hsupp (u, es1) hum)
        · dsimp only; exact ih u (hcont u) es1 _ (hsupp (u, es1) hum)
      · simp only [simulateQ_bind, simulateQ_query, OracleQuery.input_query, OracleQuery.cont_query,
          id_map, implEDFPaperBucketMode, withWinEpDFMode, ↓reduceIte, withWinEpDF,
          StateT.run_bind, StateT.run_mk, bind_assoc, pure_bind, map_bind]
        rw [← heq, bind_map_left]
        refine bind_congr_support_nilSpec _ fun ⟨u, es1⟩ hum => ?_
        have hg0 : (mapEStateH f es).g.win = es.g.win := rfl
        have hg1 : (mapEStateH f es1).g.win = es1.g.win := rfl
        simp only [Prod.map, id_eq, hg0, hg1]
        exact ih u (hcont u) es1 _ (hsupp (u, es1) hum)

private theorem hooksSlotBucketOptAt_zero_step {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [SampleableType CCoins] [SampleableType I] [SampleableType K]
    (mode : Option Bool) (q : ℕ) (ks : ℕ → K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool) :
    HooksMapStep (fun _ _ => True) toLocalBucketState
      (hooksSlotBucketOptAt mode q 0 ks cka prng fs qep tL par)
      (hooksLocalBucketOpt mode cka prng fs 1 qep tL par) where
  mono _ _ _ := trivial
  startSend_eq _ ctx P t0 γ0 σ0 r0 s _ _ := by
    refine ⟨?_, fun _ _ => trivial⟩
    have hRHS : (hooksLocalBucketOpt mode cka prng fs 1 qep tL par).startSend ctx P t0 γ0 σ0 r0 =
        (hooksLocalBucket cka prng fs 1 qep tL par).startSend ctx P t0 γ0 σ0 r0 := by
      rcases mode with _ | (_ | _) <;> rfl
    rw [hRHS]
    dsimp only [hooksSlotBucketOptAt, hooksLocalBucket]
    simp only [StateT.run_bind, StateT.run_get, pure_bind]
    have hlc : (toLocalBucketState s).lc = s.lc := rfl
    rw [hlc]
    by_cases hcond : (postLeak tL ctx && s.lc.isNone && decide (healEpoch tL < t0)) = true <;>
      (rcases r0 with _ | c0 <;>
        simp only [hcond, Bool.false_eq_true, ↓reduceIte, StateT.run_modify, StateT.run_pure,
          StateT.run_lift, StateT.run_bind, map_bind, bind_assoc, pure_bind])
    · refine bind_congr fun coins => ?_
      have hrt := rootSlotBucketAt_zero_map q ks prng qep tL par t0 (postLeak tL ctx)
        (cka.send γ0 coins).2.2 σ0 { s with lc := some (t0 - 1) }
      have hst_eq : toLocalBucketState { s with lc := some (t0 - 1) } =
          { toLocalBucketState s with lc := some (t0 - 1) } := rfl
      rw [← hst_eq, ← hrt, bind_map_left]
      refine bind_congr fun ⟨⟨σ', kVal⟩, s1⟩ => ?_
      simp [Prod.map, toLocalBucketState]
    · have hrt := rootSlotBucketAt_zero_map q ks prng qep tL par t0 (postLeak tL ctx)
        (cka.send γ0 c0).2.2 σ0 { s with lc := some (t0 - 1) }
      have hst_eq : toLocalBucketState { s with lc := some (t0 - 1) } =
          { toLocalBucketState s with lc := some (t0 - 1) } := rfl
      rw [← hst_eq, ← hrt, bind_map_left]
      refine bind_congr fun ⟨⟨σ', kVal⟩, s1⟩ => ?_
      simp [Prod.map, toLocalBucketState]
    · refine bind_congr fun coins => ?_
      have hrt := rootSlotBucketAt_zero_map q ks prng qep tL par t0 (postLeak tL ctx)
        (cka.send γ0 coins).2.2 σ0 s
      rw [← hrt, bind_map_left]
      refine bind_congr fun ⟨⟨σ', kVal⟩, s1⟩ => ?_
      simp [Prod.map, toLocalBucketState]
    · have hrt := rootSlotBucketAt_zero_map q ks prng qep tL par t0 (postLeak tL ctx)
        (cka.send γ0 c0).2.2 σ0 s
      rw [← hrt, bind_map_left]
      refine bind_congr fun ⟨⟨σ', kVal⟩, s1⟩ => ?_
      simp [Prod.map, toLocalBucketState]
  startRecv_eq _ ctx P t0 γ0 σ0 tn0 s _ _ := by
    refine ⟨?_, fun _ _ => trivial⟩
    have hcache : (toLocalBucketState s).cache = s.cache := rfl
    have hbg : inStage2BucketGen 4 tL par t0 = inStage2Bucket 1 tL par t0 := rfl
    by_cases hm : (mode == some true) = true
    · have hmode : mode = some true := by rcases mode with _ | (_ | _) <;> simp_all
      subst hmode
      dsimp only [hooksSlotBucketOptAt, hooksLocalBucketOpt, hooksLocalBucketMain]
      simp only [StateT.run_bind, StateT.run_get, pure_bind, hcache]
      rcases hc : s.cache t0 with _ | ⟨tCached, σc, kVal⟩
      · simp only [hm, hbg, ↓reduceIte]
        split_ifs <;> simp_all [StateT.run_pure, Prod.map, toLocalBucketState]
      · by_cases ht : tCached = tn0
        · simp [ht, StateT.run_pure, Prod.map, toLocalBucketState]
        · simp only [ht, hm, hbg, ↓reduceIte]
          split_ifs <;> simp_all [StateT.run_pure, Prod.map, toLocalBucketState]
    · simp only [Bool.not_eq_true] at hm
      have hRHS : (hooksLocalBucketOpt mode cka prng fs 1 qep tL par).startRecv ctx P t0 γ0 σ0 tn0 =
          (hooksLocalBucket cka prng fs 1 qep tL par).startRecv ctx P t0 γ0 σ0 tn0 := by
        rcases mode with _ | (_ | _) <;> simp_all [hooksLocalBucketOpt, hooksLocalBucketForgedHdr]
      rw [hRHS]
      dsimp only [hooksSlotBucketOptAt, hooksLocalBucket]
      simp only [StateT.run_bind, StateT.run_get, pure_bind, hcache]
      have hc1 : ((!decide (qep + 1 < t0) && inStage2Bucket 1 tL par t0) = true) ↔
          (t0 ≤ qep + 1 ∧ inStage2Bucket 1 tL par t0 = true) := by simp
      have hc2 : ((tL.isSome && decide (t0 = healEpoch tL)) = true) ↔
          (tL.isSome = true ∧ t0 = healEpoch tL) := by simp
      let G : K → Option (Option (Γ × Sig × RS)) := fun kVal =>
        some (some ((cka.receive γ0 tn0).1, (prng.up σ0 (cka.receive γ0 tn0).2).1, fs.initReceiver kVal))
      have hLkEq : Prod.map id toLocalBucketState <$>
          ((lookupSlotBucketAt q 0 ks tL t0 (cka.receive γ0 tn0).2 >>= fun kVal => pure (G kVal)).run s) =
          (G <$> lookupLocalBucketF t0 (cka.receive γ0 tn0).2).run (toLocalBucketState s) := by
        rw [show G <$> lookupLocalBucketF t0 (cka.receive γ0 tn0).2 =
            (lookupLocalBucketF t0 (cka.receive γ0 tn0).2 >>= fun kVal => pure (G kVal)) by
          rw [map_eq_bind_pure_comp]; rfl]
        simp only [StateT.run_bind, StateT.run_pure, map_bind, map_pure,
          ← lookupSlotBucketAt_zero_map q ks tL t0 (cka.receive γ0 tn0).2 s,
          bind_map_left, Prod.map, id_eq]
      rcases hc : s.cache t0 with _ | ⟨tCached, σc, kVal⟩
      · simp only [hm, Bool.false_eq_true, ↓reduceIte, hc1, hc2]
        split_ifs
        · simp [StateT.run_pure, Prod.map, toLocalBucketState]
        · simp [StateT.run_pure, Prod.map, toLocalBucketState]
        · exact hLkEq
        · simp [StateT.run_pure, Prod.map, toLocalBucketState]
      · by_cases ht : tCached = tn0
        · simp [ht, StateT.run_pure, Prod.map, toLocalBucketState]
        · simp only [ht, hm, Bool.false_eq_true, ↓reduceIte, hc1, hc2]
          split_ifs
          · simp [StateT.run_pure, Prod.map, toLocalBucketState]
          · simp [StateT.run_pure, Prod.map, toLocalBucketState]
          · exact hLkEq
          · simp [StateT.run_pure, Prod.map, toLocalBucketState]
  fsSend_pure _ _ _ ss h m _ := by rcases mode with _ | (_ | _) <;> exact ⟨some (fs.send ss h m), rfl, rfl⟩
  fsRecv_pure _ _ _ rs h e _ := by rcases mode with _ | (_ | _) <;> exact ⟨some (fs.receive rs h e), rfl, rfl⟩
  commit_pure _ _ _ new := by rcases mode with _ | (_ | _) <;> exact ⟨some new, rfl, rfl⟩
  reveal_eq _ ctx _ vp s _ := by
    refine ⟨?_, fun _ _ => trivial⟩
    have hlc : (toLocalBucketState s).lc = s.lc := rfl
    rcases mode with _ | gMain
    · dsimp only [hooksSlotBucketOptAt, hooksLocalBucketOpt, hooksLocalBucket]
      have hm : (none == some false) = false := rfl
      rw [hm]
      simp only [Bool.false_and, Bool.false_eq_true, ↓reduceIte,
        StateT.run_bind, StateT.run_get, pure_bind, hlc]
      split_ifs <;> simp [StateT.run_modify, StateT.run_pure, Prod.map, toLocalBucketState]
    · cases gMain
      · dsimp only [hooksSlotBucketOptAt, hooksLocalBucketOpt, hooksLocalBucketForgedHdr, hooksLocalBucket]
        have hm : (some false == some false) = true := rfl
        rw [hm]
        simp only [Bool.true_and]
        by_cases hfg : (!(decide (vp.tcur < healEpoch tL)) || !(decide (max (ctx.epoch .A) (ctx.epoch .B) < healEpoch tL))) = true
        · have hfg' : healEpoch tL ≤ vp.tcur ∨ healEpoch tL ≤ ctx.epoch .A ∨ healEpoch tL ≤ ctx.epoch .B := by
            simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not] at hfg
            omega
          simp only [hfg, ↓reduceIte, StateT.run_pure, map_pure, Prod.map, id_eq]
        · have hlt : decide (vp.tcur < healEpoch tL) = true := by
            cases hd : decide (vp.tcur < healEpoch tL)
            · exfalso; apply hfg; simp [hd]
            · rfl
          simp only [hlt, Bool.not_true, Bool.and_false, Bool.false_eq_true, ↓reduceIte]
          split_ifs <;> simp [StateT.run_pure, Prod.map, toLocalBucketState]
      · dsimp only [hooksSlotBucketOptAt, hooksLocalBucketOpt, hooksLocalBucketMain, hooksLocalBucket]
        have hm : (some true == some false) = false := rfl
        rw [hm]
        simp only [Bool.false_and, Bool.false_eq_true, ↓reduceIte,
          StateT.run_bind, StateT.run_get, pure_bind, hlc]
        split_ifs <;> simp [StateT.run_modify, StateT.run_pure, Prod.map, toLocalBucketState]

private theorem localSlotBucketOptAt_zero_eq {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType KR] [SampleableType KC] [SampleableType CCoins]
    [SampleableType I] [SampleableType K]
    (mode : Option Bool) (q : ℕ) (ks : ℕ → K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (lam : I)
    (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (A : SchemeAdversaryDF Γ T Sig SS RS M CCoins E)
    (hq : MakesAtMostQueriesDF A q) :
    localSlotBucketOptAt mode q 0 ks cka prng fs lam qep tL par A =
      localAuthDFPaperBucketOpt mode cka prng fs lam 1 qep tL par A := by
  unfold MakesAtMostQueriesDF at hq
  have hRHS : localAuthDFPaperBucketOpt mode cka prng fs lam 1 qep tL par A =
      bucketRawOut 3 tL <$>
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (engRunDFPaperBucketMode (hooksLocalBucketOpt mode cka prng fs 1 qep tL par)
            3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrLocalBucket
            (initLocalBucket cka prng fs lam 4 qep tL par) {} false A) := by
    rcases mode with _ | gMain
    · exact localAuthDFPaperBucketRaw_eq_map cka prng fs lam 1 qep tL par A
    · cases gMain <;> {
        simp only [localAuthDFPaperBucketOpt, localAuthDFPaperBucketMode,
          localAuthDFPaperBucketSplit, Bool.false_eq_true, ↓reduceIte,
          localAuthDFPaperBucketMain, localAuthDFPaperBucketForgedHdr,
          hooksLocalBucketOpt, map_eq_bind_pure_comp, Function.comp_def]
        congr 1; funext r
        rcases r with _ | ⟨_, ⟨es, we⟩⟩
        · rfl
        · rcases we with _ | tWin <;>
            simp [bucketRawOut, authOutBucketPaper, authOutBucket,
              _root_.CryptoGames.SM.Engine.authOut]
      }
  rw [hRHS]
  unfold localSlotBucketOptAt
  rw [← simulateQ_map, ← simulateQ_map]
  congr 1
  unfold engRunDFPaperBucketMode initSlotBucketAt initLocalBucket
  simp only [StateT.run_bind, StateT.run_lift, StateT.run_pure, bind_assoc, pure_bind, map_bind]
  refine bind_congr fun kr => bind_congr fun kc => ?_
  have hrt := rootSlotBucketAt_zero_map (T := T) q ks prng qep tL par 0 false lam (prng.init kr) {}
  have h0 : toLocalBucketState ({} : LocalSlotBucketState T Sig K I) = {} := rfl
  rw [h0] at hrt
  rw [← hrt, bind_map_left]
  refine bind_congr fun ⟨⟨σ, kVal⟩, s0⟩ => ?_
  simp only [Prod.map, id_eq]
  let parties := mkParties (T := T) (cka.initA kc) (cka.initB kc) σ (fs.initSender kVal) (fs.initReceiver kVal)
  let es0 : EState (VP Γ T Sig SS RS) M (Header T × E) (LocalSlotBucketState T Sig K I) :=
    { g := { st := fun P => match P with | .A => parties.1 | .B => parties.2, b := false }, h := s0 }
  have hsim := simulateQ_implEDFPaperBucketMode_map_eq_on
    (hooksSlotBucketOptAt_zero_step mode q ks cka prng fs qep tL par) 3 qep fs.maxSkip
    (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket isHonestHdrLocalBucket
    (fun _ _ => rfl) A (rem := q) (by convert hq using 1; funext x; rcases x with _ | _ <;> rfl) es0 none trivial
  change (do
      let a ← (simulateQ (implEDFPaperBucketMode (hooksSlotBucketOptAt mode q 0 ks cka prng fs qep tL par)
        3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket) A).run (es0, none)
      bucketRawOut 3 tL <$> pure (some a)) =
    (do
      let a ← (simulateQ (implEDFPaperBucketMode (hooksLocalBucketOpt mode cka prng fs 1 qep tL par)
        3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrLocalBucket) A).run
        (mapEStateH toLocalBucketState es0, none)
      bucketRawOut 3 tL <$> pure (some a))
  rw [← hsim, bind_map_left]
  refine bind_congr fun ⟨bOut, esOut, winEpOut⟩ => ?_
  simp [Prod.map, bucketRawOut, mapEStateH]
private structure SlotInv {T Sig K I : Type} (q m rem : ℕ) (tL : Option ℕ) (used : Bool)
    (st : LocalSlotBucketState T Sig K I) : Prop where
  len_zero : (st.sessions 0).length ≤ 1
  len_pos : ∀ t0, 1 ≤ t0 → (st.sessions t0).length + rem ≤ q
  used_iff : used = true ↔
    ∃ t0 i, healEpoch tL ≤ t0 ∧ i < (st.sessions t0).length ∧
      q * (t0 - healEpoch tL) + i = m

private theorem SlotInv.mono_rem {T Sig K I : Type} {q m rem₁ rem₂ : ℕ} {tL : Option ℕ}
    {used : Bool} {st : LocalSlotBucketState T Sig K I}
    (h : SlotInv q m rem₁ tL used st) (hle : rem₂ ≤ rem₁) :
    SlotInv q m rem₂ tL used st :=
  ⟨h.len_zero, fun t0 ht0 => by have := h.len_pos t0 ht0; omega, h.used_iff⟩

private theorem SlotInv.upd_other {T Sig K I : Type} {q m rem : ℕ} {tL : Option ℕ}
    {used : Bool} {st st' : LocalSlotBucketState T Sig K I}
    (h : SlotInv q m rem tL used st) (hses : st'.sessions = st.sessions) :
    SlotInv q m rem tL used st' := by
  refine ⟨?_, ?_, ?_⟩
  · rw [hses]; exact h.len_zero
  · intro t0 ht0; rw [hses]; exact h.len_pos t0 ht0
  · rw [hses]; exact h.used_iff

private theorem SlotInv.slot_ne_m_of_true {T Sig K I : Type} {q m rem : ℕ} {tL : Option ℕ}
    {st : LocalSlotBucketState T Sig K I}
    (hq0 : 0 < q) (h : SlotInv q m (rem + 1) tL true st)
    {t0 : ℕ} (ht0 : 1 ≤ t0) (htH : healEpoch tL ≤ t0) :
    q * (t0 - healEpoch tL) + (st.sessions t0).length ≠ m := by
  intro heq
  obtain ⟨t1, i1, htH1, hi1, heq1⟩ := h.used_iff.mp rfl
  have hi1_lt_q : i1 < q := by
    by_cases ht1 : t1 = 0
    · subst ht1; have := h.len_zero; omega
    · have := h.len_pos t1 (by omega); omega
  have hlen_lt_q : (st.sessions t0).length < q := by
    have := h.len_pos t0 ht0; omega
  obtain ⟨rfl, hlen_eq⟩ := bucketSlot_inj htH1 htH hi1_lt_q hlen_lt_q (heq1.trans heq.symm)
  omega

private def ShiftCont {T Sig K I α : Type} [SampleableType K]
    (q m rem : ℕ) (tL : Option ℕ) (ks : ℕ → K)
    (K_cont : (α × LocalSlotBucketState T Sig K I) → ℕ → (ℕ → K) → ProbComp Bool) : Prop :=
  (∀ a st, SlotInv q m rem tL false st →
    𝒟[($ᵗ K : ProbComp K) >>= fun v =>
        K_cont (a, st) (m + 1) (Function.update ks m v)] =
      𝒟[K_cont (a, st) m ks]) ∧
  (∀ a st, SlotInv q m rem tL true st → ∀ v : K,
    𝒟[K_cont (a, st) (m + 1) (Function.update ks m v)] =
      𝒟[K_cont (a, st) m ks])

private structure ShiftHM {T Sig K I α : Type} [SampleableType K]
    (q m rem rem' : ℕ) (tL : Option ℕ)
    (act : ℕ → (ℕ → K) →
      _root_.CryptoGames.SM.Engine.HM _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
        (LocalSlotBucketState T Sig K I) α) : Prop where
  run : ∀ (ks : ℕ → K)
    (K_cont : (α × LocalSlotBucketState T Sig K I) → ℕ → (ℕ → K) → ProbComp Bool),
    ShiftCont q m rem' tL ks K_cont →
    ShiftCont (α := Unit) q m rem tL ks (fun p m' ks' =>
      simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl ((act m' ks').run p.2) >>=
        fun z => K_cont z m' ks')

private theorem ShiftHM.state_pure {T Sig K I α : Type} [SampleableType K]
    (q m rem : ℕ) (tL : Option ℕ)
    (f : LocalSlotBucketState T Sig K I → α × LocalSlotBucketState T Sig K I)
    (hses : ∀ s, (f s).2.sessions = s.sessions) :
    ShiftHM q m rem rem tL (fun _ _ => StateT.mk fun s => pure (f s)) := by
  constructor
  intro ks K_cont ⟨hF, hT⟩
  refine ⟨fun _ st hInv => ?_, fun _ st hInv v => ?_⟩
  · simp only [StateT.run_mk, simulateQ_pure, pure_bind]
    exact hF (f st).1 (f st).2 (hInv.upd_other (hses st))
  · simp only [StateT.run_mk, simulateQ_pure, pure_bind]
    exact hT (f st).1 (f st).2 (hInv.upd_other (hses st)) v

private theorem ShiftHM.pure_val {T Sig K I α : Type} [SampleableType K]
    (q m rem : ℕ) (tL : Option ℕ) (x : α) :
    ShiftHM (T := T) (Sig := Sig) (K := K) (I := I) q m rem rem tL (fun _ _ => pure x) :=
  ShiftHM.state_pure q m rem tL (fun s => (x, s)) (fun _ => rfl)

private theorem ShiftHM.get_st {T Sig K I : Type} [SampleableType K]
    (q m rem : ℕ) (tL : Option ℕ) :
    ShiftHM q m rem rem tL (fun _ _ => (get : StateT (LocalSlotBucketState T Sig K I) _ _)) :=
  ShiftHM.state_pure q m rem tL (fun s => (s, s)) (fun _ => rfl)

private theorem ShiftHM.modify_other {T Sig K I : Type} [SampleableType K]
    (q m rem : ℕ) (tL : Option ℕ)
    (g : LocalSlotBucketState T Sig K I → LocalSlotBucketState T Sig K I)
    (hses : ∀ s, (g s).sessions = s.sessions) :
    ShiftHM q m rem rem tL (fun _ _ => modify g) :=
  ShiftHM.state_pure q m rem tL (fun s => ((), g s)) hses

private theorem ShiftHM.weaken {T Sig K I α : Type} [SampleableType K]
    {q m rem₁ rem₂ rem₁' rem₂' : ℕ} {tL : Option ℕ}
    {act : ℕ → (ℕ → K) →
      _root_.CryptoGames.SM.Engine.HM _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
        (LocalSlotBucketState T Sig K I) α}
    (h : ShiftHM q m rem₁' rem₂' tL act) (h1 : rem₁' ≤ rem₁) (h2 : rem₂ ≤ rem₂') :
    ShiftHM q m rem₁ rem₂ tL act := by
  constructor
  intro ks K_cont ⟨hF, hT⟩
  have hC' : ShiftCont q m rem₂' tL ks K_cont :=
    ⟨fun a st hi => hF a st (hi.mono_rem h2), fun a st hi v => hT a st (hi.mono_rem h2) v⟩
  obtain ⟨hF', hT'⟩ := h.run ks K_cont hC'
  exact ⟨fun a st hi => hF' a st (hi.mono_rem h1), fun a st hi v => hT' a st (hi.mono_rem h1) v⟩

private theorem ShiftHM.bind {T Sig K I α γ : Type} [SampleableType K]
    {q m rem rem₁ rem₂ : ℕ} {tL : Option ℕ}
    {act₁ : ℕ → (ℕ → K) →
      _root_.CryptoGames.SM.Engine.HM _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
        (LocalSlotBucketState T Sig K I) α}
    {act₂ : α → ℕ → (ℕ → K) →
      _root_.CryptoGames.SM.Engine.HM _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
        (LocalSlotBucketState T Sig K I) γ}
    (h1 : ShiftHM q m rem rem₁ tL act₁) (h2 : ∀ x, ShiftHM q m rem₁ rem₂ tL (act₂ x)) :
    ShiftHM q m rem rem₂ tL (fun m' ks' => act₁ m' ks' >>= fun x => act₂ x m' ks') := by
  constructor
  intro ks K_cont hC
  let K₁ : (α × LocalSlotBucketState T Sig K I) → ℕ → (ℕ → K) → ProbComp Bool :=
    fun ⟨x, st₁⟩ m' ks' =>
      simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl ((act₂ x m' ks').run st₁) >>=
        fun z => K_cont z m' ks'
  have hC₁ : ShiftCont q m rem₁ tL ks K₁ :=
    ⟨fun x st₁ hi => ((h2 x).run ks K_cont hC).1 () st₁ hi,
     fun x st₁ hi v => ((h2 x).run ks K_cont hC).2 () st₁ hi v⟩
  obtain ⟨hF, hT⟩ := h1.run ks K₁ hC₁
  refine ⟨fun u st hi => ?_, fun u st hi v => ?_⟩
  · simpa only [StateT.run_bind, simulateQ_bind, bind_assoc, K₁] using hF u st hi
  · simpa only [StateT.run_bind, simulateQ_bind, bind_assoc, K₁] using hT u st hi v

private theorem ShiftHM.lift_sampleT {T Sig K I X : Type} [SampleableType K] [SampleableType X]
    (q m rem : ℕ) (tL : Option ℕ) :
    ShiftHM (T := T) (Sig := Sig) (K := K) (I := I) q m rem rem tL
      (fun _ _ => StateT.lift (_root_.CryptoGames.SM.Construction.sampleT X)) := by
  constructor
  intro ks K_cont ⟨hF, hT⟩
  refine ⟨fun _ st hInv => ?_, fun _ st hInv v => ?_⟩
  · simp only [_root_.CryptoGames.SM.Construction.AuthL11.simulateQ_lImpl_run_lift_sampleT,
      bind_assoc, pure_bind]
    rw [(_root_.CryptoGames.Lazy.DEq.swap ($ᵗ K : ProbComp K) ($ᵗ X : ProbComp X) _).evalDist_eq]
    exact evalDist_bind_congr ($ᵗ X : ProbComp X) _ _ fun x => hF x st hInv
  · simp only [_root_.CryptoGames.SM.Construction.AuthL11.simulateQ_lImpl_run_lift_sampleT,
      bind_assoc, pure_bind]
    exact evalDist_bind_congr ($ᵗ X : ProbComp X) _ _ fun x => hT x st hInv v

private theorem ShiftHM.lookup_pos {T Sig K I : Type} [DecidableEq I] [SampleableType K]
    {q m rem t0 : ℕ} {tL : Option ℕ} (hq0 : 0 < q) (ht0 : 1 ≤ t0) (htH : healEpoch tL ≤ t0)
    (ik : I) :
    ShiftHM (T := T) (Sig := Sig) (K := K) (I := I) q m (rem + 1) rem tL
      (fun m' ks' => lookupSlotBucketAt q m' ks' tL t0 ik) := by
  constructor
  intro ks K_cont ⟨hF, hT⟩
  refine ⟨fun _ st hInv => ?_, fun _ st hInv v => ?_⟩
  · dsimp only [lookupSlotBucketAt]
    simp only [StateT.run_bind, StateT.run_get, pure_bind]
    cases hlk : (st.fTable t0).lookup ik with
    | some k =>
      simp only [StateT.run_pure, simulateQ_pure, pure_bind]
      exact hF k st (hInv.mono_rem (Nat.le_succ rem))
    | none =>
      simp only [StateT.run_bind, simulateQ_bind, _root_.CryptoGames.SM.Construction.AuthL11.simulateQ_lImpl_run_lift_sampleT,
        StateT.run_modify, StateT.run_pure, pure_bind, simulateQ_pure, bind_assoc]
      let sIdx := q * (t0 - healEpoch tL) + (st.sessions t0).length
      let mkSt : K → LocalSlotBucketState T Sig K I := fun kUse =>
        { st with
          fTable := Function.update st.fTable t0 ((ik, kUse) :: st.fTable t0)
          sessions := Function.update st.sessions t0 (st.sessions t0 ++ [ik]) }
      by_cases hsm : sIdx = m
      · have hlt1 : sIdx < m + 1 := by omega
        have hnlt0 : ¬ (sIdx < m) := by omega
        simp only [sIdx] at hlt1 hnlt0
        simp only [hlt1, hnlt0, ↓reduceIte]
        have hupd_self : ∀ v : K, Function.update ks m v (q * (t0 - healEpoch tL) + (st.sessions t0).length) = v := by
          intro v; rw [show q * (t0 - healEpoch tL) + (st.sessions t0).length = m from hsm]; exact Function.update_self m v ks
        simp_rw [hupd_self]
        trans 𝒟[($ᵗ K : ProbComp K) >>= fun v =>
            K_cont (v, mkSt v) (m + 1) (Function.update ks m v)]
        · refine evalDist_bind_congr ($ᵗ K : ProbComp K) _ _ fun v => ?_
          exact OracleComp.evalDist_bind_const ($ᵗ K : ProbComp K) _
        · refine evalDist_bind_congr ($ᵗ K : ProbComp K) _ _ fun w => ?_
          have hInv' : SlotInv q m rem tL true (mkSt w) := by
            refine ⟨?_, ?_, ?_⟩
            · have ht0_ne : (0 : ℕ) ≠ t0 := by omega
              simp [mkSt, Function.update_of_ne ht0_ne, hInv.len_zero]
            · intro t' ht'
              by_cases htt : t' = t0
              · subst htt
                have := hInv.len_pos t' ht'
                simp [mkSt]; omega
              · simp [mkSt, Function.update_of_ne htt,
                  (hInv.mono_rem (Nat.le_succ rem)).len_pos t' ht']
            · simp only [true_iff]
              refine ⟨t0, (st.sessions t0).length, htH, ?_, hsm⟩
              simp [mkSt]
          exact hT w (mkSt w) hInv' w
      · have hiff_lt : (sIdx < m + 1) ↔ (sIdx < m) := by omega
        have hupd_ne : ∀ v : K, Function.update ks m v sIdx = ks sIdx := fun v =>
          Function.update_of_ne hsm v ks
        rw [(_root_.CryptoGames.Lazy.DEq.swap ($ᵗ K : ProbComp K) ($ᵗ K : ProbComp K) _).evalDist_eq]
        refine evalDist_bind_congr ($ᵗ K : ProbComp K) _ _ fun kDrawn => ?_
        have hkUse : ∀ v : K,
            (if sIdx < m + 1 then Function.update ks m v sIdx else kDrawn) =
              (if sIdx < m then ks sIdx else kDrawn) := by
          intro v
          by_cases hlt : sIdx < m
          · have hlt' : sIdx < m + 1 := hiff_lt.mpr hlt
            simp [hlt, hlt', hupd_ne v]
          · have hlt' : ¬ (sIdx < m + 1) := fun hc => hlt (hiff_lt.mp hc)
            simp [hlt, hlt']
        let kUse := if sIdx < m then ks sIdx else kDrawn
        have hInv' : SlotInv q m rem tL false (mkSt kUse) := by
          refine ⟨?_, ?_, ?_⟩
          · have ht0_ne : (0 : ℕ) ≠ t0 := by omega
            simp [mkSt, Function.update_of_ne ht0_ne, hInv.len_zero]
          · intro t' ht'
            by_cases htt : t' = t0
            · subst htt
              have := hInv.len_pos t' ht'
              simp [mkSt]; omega
            · simp [mkSt, Function.update_of_ne htt,
                (hInv.mono_rem (Nat.le_succ rem)).len_pos t' ht']
          · simp only [Bool.false_eq_true, false_iff]
            rintro ⟨t1, i1, htH1, hi1, heq1⟩
            by_cases htt : t1 = t0
            · subst htt
              simp only [mkSt, Function.update_self, List.length_append, List.length_singleton] at hi1
              by_cases hi_eq : i1 = (st.sessions t1).length
              · subst hi_eq; exact hsm heq1
              · have hi_lt : i1 < (st.sessions t1).length := by omega
                exact Bool.false_ne_true (hInv.used_iff.mpr ⟨t1, i1, htH1, hi_lt, heq1⟩)
            · simp only [mkSt, Function.update_of_ne htt] at hi1
              exact Bool.false_ne_true (hInv.used_iff.mpr ⟨t1, i1, htH1, hi1, heq1⟩)
        simpa only [sIdx, mkSt, hkUse, kUse] using hF kUse (mkSt kUse) hInv'
  · dsimp only [lookupSlotBucketAt]
    simp only [StateT.run_bind, StateT.run_get, pure_bind]
    cases hlk : (st.fTable t0).lookup ik with
    | some k =>
      simp only [StateT.run_pure, simulateQ_pure, pure_bind]
      exact hT k st (hInv.mono_rem (Nat.le_succ rem)) v
    | none =>
      simp only [StateT.run_bind, simulateQ_bind, _root_.CryptoGames.SM.Construction.AuthL11.simulateQ_lImpl_run_lift_sampleT,
        StateT.run_modify, StateT.run_pure, pure_bind, simulateQ_pure, bind_assoc]
      have hsm : q * (t0 - healEpoch tL) + (st.sessions t0).length ≠ m :=
        hInv.slot_ne_m_of_true hq0 ht0 htH
      let sIdx := q * (t0 - healEpoch tL) + (st.sessions t0).length
      have hiff_lt : (sIdx < m + 1) ↔ (sIdx < m) := by omega
      refine evalDist_bind_congr ($ᵗ K : ProbComp K) _ _ fun kDrawn => ?_
      have hkUse :
          (if sIdx < m + 1 then Function.update ks m v sIdx else kDrawn) =
            (if sIdx < m then ks sIdx else kDrawn) := by
        by_cases hlt : sIdx < m
        · have hlt' : sIdx < m + 1 := hiff_lt.mpr hlt
          simp only [hlt, hlt', ↓reduceIte]; exact Function.update_of_ne hsm v ks
        · have hlt' : ¬ (sIdx < m + 1) := fun hc => hlt (hiff_lt.mp hc)
          simp [hlt, hlt']
      let kUse := if sIdx < m then ks sIdx else kDrawn
      let st' : LocalSlotBucketState T Sig K I :=
        { st with
          fTable := Function.update st.fTable t0 ((ik, kUse) :: st.fTable t0)
          sessions := Function.update st.sessions t0 (st.sessions t0 ++ [ik]) }
      have hInv' : SlotInv q m rem tL true st' := by
        refine ⟨?_, ?_, ?_⟩
        · have ht0_ne : (0 : ℕ) ≠ t0 := by omega
          simp [st', Function.update_of_ne ht0_ne, hInv.len_zero]
        · intro t' ht'
          by_cases htt : t' = t0
          · subst htt; have := hInv.len_pos t' ht'; simp [st']; omega
          · simp [st', Function.update_of_ne htt,
              (hInv.mono_rem (Nat.le_succ rem)).len_pos t' ht']
        · simp only [true_iff]
          obtain ⟨t1, i1, htH1, hi1, heq1⟩ := hInv.used_iff.mp rfl
          refine ⟨t1, i1, htH1, ?_, heq1⟩
          by_cases htt : t1 = t0
          · subst htt; simp [st']; omega
          · simp [st', Function.update_of_ne htt, hi1]
      simpa only [sIdx, hkUse, kUse, st'] using hT kUse st' hInv' v

private theorem healEpoch_le_of_inStage2Bucket {tL : Option ℕ} {par : Bool} {t0 : ℕ}
    (hbk : inStage2Bucket 1 tL par t0 = true) :
    healEpoch tL ≤ t0 := by
  simp only [inStage2Bucket, lastLeakGuessAdmissible, healedBy, Bool.and_eq_true] at hbk
  cases tL with
  | none => simp [healEpoch]
  | some l => simp only [decide_eq_true_eq] at hbk; simp only [healEpoch]; omega

private theorem ShiftHM.root_pos {KR T Sig I K : Type}
    [DecidableEq I] [SampleableType I] [SampleableType K]
    {q m rem t0 : ℕ} (hq0 : 0 < q) (ht0 : 1 ≤ t0)
    (prng : PRFPRNG KR Sig I K) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (pl : Bool) (ik0 : I) (σ0 : Sig) :
    ShiftHM (T := T) (Sig := Sig) (K := K) (I := I) q m (rem + 1) rem tL
      (fun m' ks' => rootSlotBucketAt q m' ks' prng qep tL par t0 pl ik0 σ0) := by
  unfold rootSlotBucketAt
  dsimp only
  split_ifs with h1 h2 h3
  · exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl
  · exact ((ShiftHM.lift_sampleT (X := I) q m rem tL).bind fun ir =>
      (ShiftHM.lift_sampleT (X := K) q m rem tL).bind fun kS =>
        ShiftHM.pure_val q m rem tL ((prng.up σ0 ir).1, kS)).weaken (Nat.le_succ rem) le_rfl
  · exact (ShiftHM.lookup_pos hq0 ht0 (healEpoch_le_of_inStage2Bucket h3) ik0).bind fun kL =>
      ShiftHM.pure_val q m rem tL ((prng.up σ0 ik0).1, kL)
  · exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl

private theorem ShiftHM.startSend_pos {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q m rem t0 : ℕ} (hq0 : 0 < q) (ht0 : 1 ≤ t0)
    (mode : Option Bool) (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (γ0 : Γ) (σ0 : Sig) (r0 : Option CCoins) :
    ShiftHM q m (rem + 1) rem tL (fun m' ks' =>
      (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par).startSend ctx P t0 γ0 σ0 r0) := by
  dsimp only [hooksSlotBucketOptAt]
  refine (ShiftHM.get_st q m (rem + 1) tL).bind fun h0 => ?_
  have hrest : ∀ (coins : CCoins), ShiftHM (T := T) (Sig := Sig) (K := K) (I := I) q m (rem + 1) rem tL
      (fun m' ks' => do
        let c := cka.send γ0 coins
        let (σ', kVal) ← rootSlotBucketAt q m' ks' prng qep tL par t0 (postLeak tL ctx) c.2.2 σ0
        modify fun s => { s with cache := Function.update s.cache t0 (some (c.2.1, σ', kVal)) }
        return some (c.1, c.2.1, σ', fs.initSender kVal)) := fun coins => by
    refine ShiftHM.bind (ShiftHM.root_pos hq0 ht0 prng qep tL par (postLeak tL ctx)
      (cka.send γ0 coins).2.2 σ0) fun ⟨σ', kVal⟩ => ?_
    exact ShiftHM.bind (ShiftHM.modify_other q m rem tL _ (fun _ => rfl)) fun _ =>
      ShiftHM.pure_val q m rem tL _
  split_ifs
  · refine ShiftHM.bind (ShiftHM.modify_other q m (rem + 1) tL _ (fun _ => rfl)) fun _ => ?_
    rcases r0 with _ | c0
    · exact ShiftHM.bind (ShiftHM.lift_sampleT q m (rem + 1) tL) hrest
    · exact ShiftHM.bind (ShiftHM.pure_val q m (rem + 1) tL c0) hrest
  · rcases r0 with _ | c0
    · exact ShiftHM.bind (ShiftHM.lift_sampleT q m (rem + 1) tL) hrest
    · exact ShiftHM.bind (ShiftHM.pure_val q m (rem + 1) tL c0) hrest


private theorem ShiftHM.startRecv_pos {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q m rem t0 : ℕ} (hq0 : 0 < q) (ht0 : 1 ≤ t0)
    (mode : Option Bool)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (γ0 : Γ) (σ0 : Sig) (tn0 : T) :
    ShiftHM q m (rem + 1) rem tL (fun m' ks' =>
      (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par).startRecv ctx P t0 γ0 σ0 tn0) := by
  dsimp only [hooksSlotBucketOptAt]
  refine (ShiftHM.get_st q m (rem + 1) tL).bind fun h0 => ?_
  rcases hhon : (match h0.cache t0 with
    | some (tCached, σc, kVal) => if tCached = tn0 then some (σc, kVal) else none
    | none => none) with _ | ⟨σc, kVal⟩
  · simp only [hhon]
    by_cases hm : (mode == some true) = true
    · simp only [hm, ↓reduceIte]
      split_ifs <;> exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl
    · simp only [hm, Bool.false_eq_true, ↓reduceIte]
      split_ifs with h1 h2 h3
      · exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl
      · exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl
      · simp only [Bool.and_eq_true] at h1
        exact (ShiftHM.lookup_pos hq0 ht0 (healEpoch_le_of_inStage2Bucket h1.2)
          (cka.receive γ0 tn0).2).bind fun k' =>
            ShiftHM.pure_val q m rem tL _
      · exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl
  · simp only [hhon]
    exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl

private theorem ShiftHM.reveal_any {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [SampleableType CCoins] [SampleableType I] [SampleableType K]
    (mode : Option Bool) (q m rem : ℕ)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (vp : VP Γ T Sig SS RS) :
    ShiftHM q m rem rem tL (fun m' ks' =>
      (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par).reveal ctx P vp) := by
  dsimp only [hooksSlotBucketOptAt]
  by_cases hfg : (mode == some false &&
      (!(decide (vp.tcur < healEpoch tL)) || !(decide (max (ctx.epoch .A) (ctx.epoch .B) < healEpoch tL)))) = true
  · simp only [hfg, ↓reduceIte]
    exact ShiftHM.pure_val q m rem tL none
  · simp only [hfg, Bool.false_eq_true, ↓reduceIte]
    refine (ShiftHM.get_st q m rem tL).bind fun h0 => ?_
    split_ifs
    · exact ShiftHM.bind (ShiftHM.modify_other q m rem tL _ (fun _ => rfl)) fun _ =>
        ShiftHM.pure_val q m rem tL _
    · exact ShiftHM.pure_val q m rem tL _

private theorem ShiftHM.vSend_step {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [Inhabited E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q m rem : ℕ} (hq0 : 0 < q) (mode : Option Bool)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (vp : VP Γ T Sig SS RS)
    (m_msg : M) (pair : Option (M × M)) (r0 : Option CCoins) :
    ShiftHM q m (rem + 1) rem tL (fun m' ks' =>
      vSend (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par) ctx P vp m_msg pair r0) := by
  unfold vSend
  dsimp only
  by_cases hs : vp.id.sendsIn (vp.tcur + 1)
  · simp only [hs, ↓reduceIte, pure_bind]
    refine (ShiftHM.startSend_pos hq0 (Nat.succ_pos _) mode cka prng fs qep tL par
      ctx P vp.γ vp.root r0).bind fun o => ?_
    rcases o with _ | ⟨γ', T', σ', ss⟩
    · exact ShiftHM.pure_val q m rem tL none
    · dsimp only [hooksSlotBucketOptAt]
      simp only [pure_bind]
      exact ShiftHM.pure_val q m rem tL _
  · simp only [hs, Bool.false_eq_true, ↓reduceIte, pure_bind]
    rcases vp.vS with _ | ss
    · exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl
    · dsimp only [hooksSlotBucketOptAt]
      simp only [pure_bind]
      exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl

private theorem ShiftHM.vRecv_step {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [Inhabited E]
    [SampleableType CCoins] [SampleableType I] [SampleableType K]
    {q m rem : ℕ} (hq0 : 0 < q) (mode : Option Bool)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (vp : VP Γ T Sig SS RS)
    (c : Header T × E) (rec : Option (Record M (Header T × E))) :
    ShiftHM q m (rem + 1) rem tL (fun m' ks' =>
      vRecv (hooksSlotBucketOptAt mode q m' ks' cka prng fs qep tL par) ctx P vp c rec) := by
  rcases c with ⟨⟨t_hdr, optTn⟩, e_ct⟩
  unfold vRecv
  dsimp only
  by_cases hg : (vp.id.sendsIn t_hdr || decide (vp.tcur + 1 < t_hdr)) = true
  · simp only [hg, ↓reduceIte]
    exact (ShiftHM.pure_val q m rem tL (some none)).weaken (Nat.le_succ rem) le_rfl
  · simp only [hg, Bool.false_eq_true, ↓reduceIte]
    by_cases heq : t_hdr = vp.tcur + 1
    · subst heq
      simp only [↓reduceIte]
      rcases optTn with _ | Tn
      · simp only [pure_bind]
        exact (ShiftHM.pure_val q m rem tL (some none)).weaken (Nat.le_succ rem) le_rfl
      · refine (ShiftHM.startRecv_pos (t0 := vp.tcur + 1) hq0 (by omega) mode cka prng fs qep tL par
          ctx P vp.γ vp.root Tn).bind fun o => ?_
        rcases o with _ | (_ | ⟨γ', σ', rs⟩)
        · simp only [pure_bind]; exact ShiftHM.pure_val q m rem tL none
        · simp only [pure_bind]; exact ShiftHM.pure_val q m rem tL (some none)
        · dsimp only [hooksSlotBucketOptAt]
          simp only [pure_bind, Function.update_self]
          rcases fs.receive rs (vp.tcur + 1, some Tn) e_ct with _ | ⟨v', i', msg'⟩ <;>
            exact ShiftHM.pure_val q m rem tL _
    · simp only [heq, ↓reduceIte, pure_bind]
      rcases vp.vR t_hdr with _ | rs
      · exact (ShiftHM.pure_val q m rem tL (some none)).weaken (Nat.le_succ rem) le_rfl
      · dsimp only [hooksSlotBucketOptAt]
        simp only [pure_bind]
        rcases fs.receive rs (t_hdr, optTn) e_ct with _ | ⟨v', i', msg'⟩ <;>
          exact (ShiftHM.pure_val q m rem tL _).weaken (Nat.le_succ rem) le_rfl

private theorem commitE_hooksSlotBucketAt_run {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [SampleableType CCoins] [SampleableType I] [SampleableType K]
