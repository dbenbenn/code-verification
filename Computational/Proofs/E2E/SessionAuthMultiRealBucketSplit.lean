private theorem isHonestHdr_eq_of_cache_sync {Pt : Type} [DecidableEq Pt]
    {hLoc : LocHS Pt} {hM : MultiHS Pt} {q : ℕ} {tL : Option ℕ} {par : Bool} {qep : ℕ}
    {ks : ℕ → BitVec 256}
    (hcache : ∀ t0,
      (hLoc.cache t0 = none ∧ hM.cache t0 = none) ∨
      (∃ Tc σc kVal, 1 ≤ t0 ∧ hLoc.cache t0 = some (Tc, σc, kVal) ∧
        hM.cache t0 = some (Tc, σc, kVal, none)) ∨
      (∃ Tc σc kMulti j, 1 ≤ t0 ∧ j < (hM.sessions t0).length ∧
        !(qep + 1 < t0) = true ∧ inStage2BucketGen 4 tL par t0 = true ∧
        !(tL.isSome && (t0 == healEpoch tL)) = true ∧
        let sIdx := q * (t0 - healEpoch tL) + j
        hLoc.cache t0 = some (Tc, σc, ks sIdx) ∧
        hM.cache t0 = some (Tc, σc, kMulti, some sIdx)))
    (hdr : Header Pt) :
    isHonestHdrSlotBucket hLoc hdr = isHonestHdrFSMultiDFBucket hM hdr := by
  rcases hdr with ⟨t0, o⟩
  rcases hcache t0 with ⟨h1, h2⟩ | ⟨Tc, σc, kVal, _, h1, h2⟩ |
      ⟨Tc, σc, kMulti, j, _, _, _, _, _, h1, h2⟩ <;>
    (cases o <;>
      simp [isHonestHdrSlotBucket, toLocalBucketState, isHonestHdrLocalBucket,
        isHonestHdrFSMultiDFBucket, h1, h2])

private theorem GSync.corrAllowedPaper_eq {Pt : Type} {ℓ : ℕ}
    {gLoc : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
