private theorem step2_chall {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (m₀ m₁ : LibsignalMsgPublicPart × Plain ℓ) (r₀ : Option (BitVec 256))
    {α : Type}
    (r : Option (Fig8C Pt) → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inl (.inl (.inr ⟨P, m₀, m₁, r₀⟩))))
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  intro qr
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc none hinv.win_false rfl,
      runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM none hwinM rfl]
  simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
  exact hIH none ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))

private theorem step1_chall {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (m₀ m₁ : LibsignalMsgPublicPart × Plain ℓ) (r₀ : Option (BitVec 256))
    {α : Type}
    (r : Option (Fig8C Pt) → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH1 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeAdd
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM')
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true (r u) esL' none tblL'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inl (.inl (.inr ⟨P, m₀, m₁, r₀⟩))))
    LeAdd
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esL none tblL) := by
  intro qr
  have hesL : esL = esM := (hinv.phase1_props rfl).2.1
  rw [hesL]
  have hinvM : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL := by
    rwa [hesL] at hinv
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc none hinv.win_false rfl,
      runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM none hwinM rfl,
      runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblL tblL none hwinM rfl]
  simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
  exact hIH1 none ssLoc rsLoc esLoc esM esM tblM tblL (hinvM.mono_rem (Nat.le_succ rem))

private theorem realParty_eq_of_vp_sync {Pt : Type}
    {vpLoc : LocVP Pt} {vpM : MultiVP Pt}
    (hid : vpLoc.id = vpM.id) (htcur : vpLoc.tcur = vpM.tcur)
    (hγ : vpLoc.γ = vpM.γ) (hroot : vpLoc.root = vpM.root) (hcka : vpLoc.curCkaMsg = vpM.curCkaMsg)
    {vSM vSLoc : Option (RatchetSenderState (BitVec 256))}
    {vRM vRLoc : ℕ → Option (RatchetReceiverState (BitVec 256) (BitVec 256))}
    (hvS : vSM = vSLoc) (hvR : vRM = vRLoc) :
    realParty vpM vpM.γ vpM.root vSM vRM = realParty vpLoc vpLoc.γ vpLoc.root vSLoc vRLoc := by
  subst hvS; subst hvR; simp [realParty, hid, htcur, hγ, hroot, hcka]

private theorem ite_false_eq {α : Type _} {c : Prop} [Decidable c] (a b : α) (hc : ¬ c) :
    (if c then a else b) = b := by
  by_cases h : c
  · exact False.elim (hc h)
  · simp [h]

private theorem sim_reveal_multi_inl {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par phase1 la : Bool) (ks : ℕ → BitVec 256)
    (P : Party)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL tbl : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks phase1 rem ssLoc rsLoc esLoc esM esL tblM tblL)
    (hvS : ((esLoc.g.st P).vS = none ∧ (esM.g.st P).vS = none) ∨
      ∃ ss, (esLoc.g.st P).vS = some ss ∧ (esM.g.st P).vS = some (.inl ss))
    (hvR_no_inr : ∀ t sIdx, t < q + 1 → (esM.g.st P).vR t ≠ some (.inr sIdx)) :
    (simulateQ (pubFsImplOpt C ℓ encT idOf la)
      (((hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par la).reveal
        esM.g P (esM.g.st P)).run esM.h)).run (fun _ => false, tbl) =
    pure ((some (realParty (esLoc.g.st P) (esLoc.g.st P).γ (esLoc.g.st P).root
      (esLoc.g.st P).vS (esLoc.g.st P).vR), esM.h), (fun _ => false, tbl)) := by
  have htcur_eq : (esLoc.g.st P).tcur = (esM.g.st P).tcur :=
    (hinv.vp_tcur_eq P).1.trans (hinv.vp_tcur_eq P).2.symm
  rcases hvS with ⟨hv1, hv2⟩ | ⟨ss, hv1, hv2⟩
  · dsimp only [hooksFSMultiDFBucketPaper]
    rw [hv2]; dsimp only
    simp only [pure_bind]
    rw [ite_false_eq _ _ ?_]
    · simp only [StateT.run_pure, simulateQ_pure]
      congr 4
      refine realParty_eq_of_vp_sync ((hinv.vp_id P).1.trans (hinv.vp_id P).2.symm)
        htcur_eq (hinv.vp_γ_eq P) (hinv.vp_root_eq P) (hinv.vp_cka_eq P) hv1.symm ?_
      funext t
      by_cases ht : t < q + 1
      · simp only [ht, ↓reduceIte]
        rcases hinv.vR_sync P t with ⟨h1, h2⟩ | ⟨rs, h1, h2⟩ | ⟨_, _, _, _, _, _, _, h2⟩
        · simp [h1, h2]
        · simp [h1, h2]
        · exact False.elim (hvR_no_inr t _ ht h2)
      · simp only [ht, ↓reduceIte]
        cases hvM : (esM.g.st P).vR t with
        | none =>
          rcases hinv.vR_sync P t with ⟨h1, _⟩ | ⟨_, _, h2⟩ | ⟨_, _, _, _, _, _, _, h2⟩
          · exact h1.symm
          · rw [hvM] at h2; cases h2
          · rw [hvM] at h2; cases h2
        | some _ =>
          have := (hinv.vR_dom P t (by simp [hvM])).1
          have := hinv.epoch_bound P; omega
    · intro hany
      obtain ⟨t, ht_mem, ht_m⟩ := List.any_eq_true.mp hany
      cases hv : (esM.g.st P).vR t with
      | none => rw [hv] at ht_m; cases ht_m
      | some v =>
        cases v with
        | inl _ => rw [hv] at ht_m; cases ht_m
        | inr sIdx => exact hvR_no_inr t sIdx (List.mem_range.mp ht_mem) hv
  · dsimp only [hooksFSMultiDFBucketPaper]
    rw [hv2]; dsimp only
    simp only [pure_bind]
    rw [ite_false_eq _ _ ?_]
    · simp only [StateT.run_pure, simulateQ_pure]
      congr 4
      refine realParty_eq_of_vp_sync ((hinv.vp_id P).1.trans (hinv.vp_id P).2.symm)
        htcur_eq (hinv.vp_γ_eq P) (hinv.vp_root_eq P) (hinv.vp_cka_eq P) hv1.symm ?_
      funext t
      by_cases ht : t < q + 1
      · simp only [ht, ↓reduceIte]
        rcases hinv.vR_sync P t with ⟨h1, h2⟩ | ⟨rs, h1, h2⟩ | ⟨_, _, _, _, _, _, _, h2⟩
        · simp [h1, h2]
        · simp [h1, h2]
        · exact False.elim (hvR_no_inr t _ ht h2)
      · simp only [ht, ↓reduceIte]
        cases hvM : (esM.g.st P).vR t with
        | none =>
          rcases hinv.vR_sync P t with ⟨h1, _⟩ | ⟨_, _, h2⟩ | ⟨_, _, _, _, _, _, _, h2⟩
          · exact h1.symm
          · rw [hvM] at h2; cases h2
          · rw [hvM] at h2; cases h2
        | some _ =>
          have := (hinv.vR_dom P t (by simp [hvM])).1
          have := hinv.epoch_bound P; omega
    · intro hany
      obtain ⟨t, ht_mem, ht_m⟩ := List.any_eq_true.mp hany
      cases hv : (esM.g.st P).vR t with
      | none => rw [hv] at ht_m; cases ht_m
      | some v =>
        cases v with
        | inl _ => rw [hv] at ht_m; cases ht_m
        | inr sIdx => exact hvR_no_inr t sIdx (List.mem_range.mp ht_mem) hv

private theorem sim_reveal_multi_inr {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par phase1 : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (sIdx : ℕ)
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (sM' : SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks phase1 rem ssLoc rsLoc esLoc esM esL tblM tblL)
    (hv1 : (esLoc.g.st P).vS = some (ssLoc sIdx))
    (hv2 : (esM.g.st P).vS = some (.inr sIdx))
    (hpub : (simulateQ (pubFsMultiImpl (fsImpl (lIdeal C protoSignalCodec ℓ encT)
        (lAeadR C protoSignalCodec ℓ encT idOf) (lChainPRG C.F) maxForwardJumps (hp 0 0 false)))
        ((liftFSMultiDFBucket sIdx CryptoGames.FSAEAD.corruptSenderQuery).run esM.h)).run
        (fun _ => false, tblM) =
      pure ((some (ssLoc sIdx), esM.h), (fun _ => false, Function.update tblM sIdx sM')))
    (hvR_no_inr : ∀ t sIdx0, t < q + 1 → (esM.g.st P).vR t ≠ some (.inr sIdx0)) :
    let bk0 := (esM.h.book sIdx).getD {}
    let hM1 : MultiHS Pt :=
      { esM.h with book := Function.update esM.h.book sIdx (some { bk0 with sCorr := true }) }
    (simulateQ (pubFsImplOpt C ℓ encT idOf false)
      (((hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
        (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par false).reveal
        esM.g P (esM.g.st P)).run esM.h)).run (fun _ => false, tblM) =
    pure ((some (realParty (esLoc.g.st P) (esLoc.g.st P).γ (esLoc.g.st P).root
      (esLoc.g.st P).vS (esLoc.g.st P).vR), hM1), (fun _ => false, Function.update tblM sIdx sM')) := by
  intro bk0 hM1
  have htcur_eq : (esLoc.g.st P).tcur = (esM.g.st P).tcur :=
    (hinv.vp_tcur_eq P).1.trans (hinv.vp_tcur_eq P).2.symm
  dsimp only [hooksFSMultiDFBucketPaper, pubFsImplOpt]
  rw [hv2]; dsimp only
  rw [StateT.run_bind, simulateQ_bind, StateT.run_bind, hpub, pure_bind]
  dsimp only
  simp only [StateT.run_bind, StateT.run_modify, pure_bind]
  rw [ite_false_eq _ _ ?_]
  · simp only [StateT.run_pure, simulateQ_pure, bk0, hM1]
    congr 4
    refine realParty_eq_of_vp_sync ((hinv.vp_id P).1.trans (hinv.vp_id P).2.symm)
      htcur_eq (hinv.vp_γ_eq P) (hinv.vp_root_eq P) (hinv.vp_cka_eq P) hv1.symm ?_
    funext t
    by_cases ht : t < q + 1
    · simp only [ht, ↓reduceIte]
      rcases hinv.vR_sync P t with ⟨h1, h2⟩ | ⟨rs, h1, h2⟩ | ⟨_, _, _, _, _, _, _, h2⟩
      · simp [h1, h2]
      · simp [h1, h2]
      · exact False.elim (hvR_no_inr t _ ht h2)
    · simp only [ht, ↓reduceIte]
      cases hvM : (esM.g.st P).vR t with
      | none =>
        rcases hinv.vR_sync P t with ⟨h1, _⟩ | ⟨_, _, h2⟩ | ⟨_, _, _, _, _, _, _, h2⟩
        · exact h1.symm
        · rw [hvM] at h2; cases h2
        · rw [hvM] at h2; cases h2
      | some _ =>
        have := (hinv.vR_dom P t (by simp [hvM])).1
        have := hinv.epoch_bound P; omega
  · intro hany
    obtain ⟨t, ht_mem, ht_m⟩ := List.any_eq_true.mp hany
    cases hv : (esM.g.st P).vR t with
    | none => rw [hv] at ht_m; cases ht_m
    | some v =>
      cases v with
      | inl _ => rw [hv] at ht_m; cases ht_m
      | inr sIdx0 => exact hvR_no_inr t sIdx0 (List.mem_range.mp ht_mem) hv

private theorem step_corr_postLeak_leOne {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par phase1 : Bool) (ks : ℕ → BitVec 256)
    (P : Party) {α : Type}
    (r : Option (Fig8St Pt) → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks phase1 (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    (hallow : esLoc.g.corrAllowedPaper P = true)
    (hpl_after : postLeak tL (esLoc.g.afterCorr P) = true) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inr P)
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  intro qr
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  have hallowM : esM.g.corrAllowedPaper P = true := by
    rw [← hinv.gsync.corrAllowedPaper_eq P]; exact hallow
  have htcur_loc := (hinv.vp_tcur_eq P).1
  have htcur_M := (hinv.vp_tcur_eq P).2
  have hepA : esLoc.g.epoch .A = esM.g.epoch .A := congrFun hinv.gsync.epoch_eq .A
  have hepB : esLoc.g.epoch .B = esM.g.epoch .B := congrFun hinv.gsync.epoch_eq .B
  by_cases hguard : (mode == some false &&
      (!(esLoc.g.epoch P < healEpoch tL) || !(max (esLoc.g.epoch .A) (esLoc.g.epoch .B) < healEpoch tL))) = true
  · have hguardL : (mode == some false &&
        (!((esLoc.g.st P).tcur < healEpoch tL) || !(max (esLoc.g.epoch .A) (esLoc.g.epoch .B) < healEpoch tL))) = true := by
      rwa [htcur_loc]
    have hguardM : (mode == some false &&
        (!((esM.g.st P).tcur < healEpoch tL) || !(max (esM.g.epoch .A) (esM.g.epoch .B) < healEpoch tL))) = true := by
      rwa [htcur_M, ← hepA, ← hepB]
    have hstepLoc :
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
        pure (none, { esLoc with abort := true }) := by
      simp only [qr, implEDFPaperBucketRaw, corrEPaperBucket, QueryImpl.add_apply_inr,
        QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind,
        hinv.abort_loc, hinv.win_false, hallow, Bool.not_true, Bool.or_self,
        Bool.false_eq_true, ↓reduceIte, run_liftH_eq]
      dsimp only [hkLocOpt, hooksSlotBucketOptAt]
      simp only [hguardL, ↓reduceIte, StateT.run_pure, pure_bind, abortE,
        StateT.run_bind, StateT.run_modify, simulateQ_pure]
    have hstepM :
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tblM) =
        pure ((none, { esM with abort := true }), (fun _ => false, tblM)) := by
      simp only [qr, implEDFPaperBucketRaw, corrEPaperBucket, QueryImpl.add_apply_inr,
        QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind,
        hinv.abort_M, hwinM, hallowM, Bool.not_true, Bool.or_self,
        Bool.false_eq_true, ↓reduceIte, run_liftH_eq]
      rw [hkMultiOpt_reveal]
      simp only [hguardM, ↓reduceIte, StateT.run_pure, pure_bind, abortE,
        StateT.run_bind, StateT.run_modify, simulateQ_pure]
    rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc _ none hinv.win_false hstepLoc,
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM _ tblM tblM none hwinM hstepM]
    simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
    exact exit_halted_leOne mode C Dh encPt encT idOf ℓ q qep tL par ks (r none)
      { esLoc with abort := true } { esM with abort := true } none tblM
      (by simp) rfl hinv.gsync.win_eq.symm hinv.gsync.leaks_eq.symm hinv.gsync.corrs_eq.symm
  · have hguardL : (mode == some false &&
        (!((esLoc.g.st P).tcur < healEpoch tL) || !(max (esLoc.g.epoch .A) (esLoc.g.epoch .B) < healEpoch tL))) = false := by
      rw [htcur_loc]; exact Bool.eq_false_iff.mpr hguard
    have hguardM : (mode == some false &&
        (!((esM.g.st P).tcur < healEpoch tL) || !(max (esM.g.epoch .A) (esM.g.epoch .B) < healEpoch tL))) = false := by
      rw [htcur_M, ← hepA, ← hepB]; exact Bool.eq_false_iff.mpr hguard
    let hLoc1 : LocHS Pt :=
      if !postLeak tL esLoc.g && esLoc.h.lc.isNone && !((esLoc.g.st P).tcur < healEpoch tL) then
        { esLoc.h with lc := some (esLoc.g.st P).tcur }
      else esLoc.h
    have hhLoc1_fields : hLoc1.cache = esLoc.h.cache ∧ hLoc1.fTable = esLoc.h.fTable ∧
        hLoc1.sessions = esLoc.h.sessions := by
      dsimp only [hLoc1]; split <;> exact ⟨rfl, rfl, rfl⟩
    let stOut := realParty (esLoc.g.st P) (esLoc.g.st P).γ (esLoc.g.st P).root
      (esLoc.g.st P).vS (esLoc.g.st P).vR
    have hstepLoc :
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
        pure (some stOut, { esLoc with g := esLoc.g.afterCorr P, h := hLoc1 }) := by
      simp only [qr, implEDFPaperBucketRaw, corrEPaperBucket, QueryImpl.add_apply_inr,
        QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind,
        hinv.abort_loc, hinv.win_false, hallow, Bool.not_true, Bool.or_self,
        Bool.false_eq_true, ↓reduceIte, run_liftH_eq]
      dsimp only [hkLocOpt, hooksSlotBucketOptAt]
      simp only [hguardL, Bool.false_eq_true, ↓reduceIte]
      by_cases hcond : (!postLeak tL esLoc.g && esLoc.h.lc.isNone &&
          !((esLoc.g.st P).tcur < healEpoch tL)) = true <;>
        simp only [StateT.run_bind, StateT.run_get, hcond, Bool.false_eq_true, ↓reduceIte,
          StateT.run_modify, StateT.run_pure, pure_bind, simulateQ_pure, hLoc1, stOut]
    rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc _ (some stOut) hinv.win_false hstepLoc]
    simp only [show (esLoc.g.afterCorr P).win = false from hinv.win_false,
      calcWinEp, Bool.false_eq_true, ↓reduceIte]
    let pInr : ℕ → Bool := fun t => match (esM.g.st P).vR t with | some (.inr _) => true | _ => false
    by_cases hany : ((List.range (q + 1)).any pInr) = true
    · obtain ⟨t0, _, ht_inr⟩ := List.any_eq_true.mp hany
      dsimp only [pInr] at ht_inr
      cases hvRt : (esM.g.st P).vR t0 with
      | none => rw [hvRt] at ht_inr; cases ht_inr
      | some v =>
        cases v with
        | inl _ => rw [hvRt] at ht_inr; cases ht_inr
        | inr sIdx0 =>
          have hdom := hinv.vR_dom P t0 (by simp [hvRt])
          have hsyncR := hinv.vR_sync P t0
          rw [hvRt] at hsyncR
          rcases hsyncR with ⟨_, h0⟩ | ⟨_, _, h0⟩ | ⟨j, _, _, hbk0, _, _, _, _⟩
          · cases h0
          · cases h0
          · have hlt_ep : ltOpt tL (esLoc.g.epoch P) = true :=
              ltOpt_of_inStage2BucketGen_le hbk0 hdom.1
            have hmem_corr : (Party.receiverOf t0, esLoc.g.epoch P) ∈ (esLoc.g.afterCorr P).corrs := by
              rw [← hdom.2]; simp [GameState.afterCorr, GameState.leak]
            exact leOne_of_lhs_zero (df_cLoc_zero_of_receiver_corr
              (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
              (fun _ _ _ new => rfl) qep maxForwardJumps (mode != some false) tL par
              isHonestHdrSlotBucket hbk0 hlt_ep
              (r (some stOut)) { esLoc with g := esLoc.g.afterCorr P, h := hLoc1 } none
              hmem_corr (fun _ h => nomatch h))
    · have hvR_no_inr : ∀ t sIdx, t < q + 1 → (esM.g.st P).vR t ≠ some (.inr sIdx) := by
        intro t sIdx ht hv
        exact hany (List.any_eq_true.mpr ⟨t, List.mem_range.mpr ht, by simp [pInr, hv]⟩)
      have hvS_step : ∃ (hM1 : MultiHS Pt) (tblM1 : ℕ → SessHSt Pt ℓ),
          (simulateQ (pubFsImplOpt C ℓ encT idOf false)
            (((hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
              (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par false).reveal
              esM.g P (esM.g.st P)).run esM.h)).run (fun _ => false, tblM) =
          pure ((some stOut, hM1), (fun _ => false, tblM1)) ∧
          hM1.lfWin = esM.h.lfWin ∧ hM1.cache = esM.h.cache ∧
          hM1.fTable = esM.h.fTable ∧ hM1.sessions = esM.h.sessions ∧
          (∀ sIdx, ActiveSessInv C ℓ encT idOf (!((hM1.book sIdx).getD {}).sCorr) (ks sIdx)
            (ssLoc sIdx) (rsLoc sIdx) ((hM1.book sIdx).getD {}) (tblM1 sIdx) (tblL sIdx)) ∧
          (∀ sIdx, ((hM1.book sIdx).getD {}).fsCount = ((esM.h.book sIdx).getD {}).fsCount ∧
            ((hM1.book sIdx).getD {}).fsTrans = ((esM.h.book sIdx).getD {}).fsTrans) ∧
          (∀ t1 j1, 1 ≤ t1 → healEpoch tL ≤ t1 → j1 < q →
            esLoc.g.epoch (Party.senderOf t1) < t1 → healedBy esLoc.g.tL 3 t1 = true →
            hM1.book (q * (t1 - healEpoch tL) + j1) = none) := by
        rcases hinv.vS_sync P with ⟨hv1, hv2⟩ | ⟨ss, hv1, hv2⟩ |
            ⟨t0, j, _, _, hP_send, _, hbk0, _, hj_len, hv1, hv2⟩
        · exact ⟨esM.h, tblM, sim_reveal_multi_inl C Dh encPt encT idOf ℓ q qep (rem + 1) tL par
            phase1 false ks P ssLoc rsLoc esLoc esM esL tblM tblL tblM hinv (.inl ⟨hv1, hv2⟩) hvR_no_inr,
            rfl, rfl, rfl, rfl, hinv.sess_inv, fun _ => ⟨rfl, rfl⟩, hinv.book_fresh_before_send⟩
        · exact ⟨esM.h, tblM, sim_reveal_multi_inl C Dh encPt encT idOf ℓ q qep (rem + 1) tL par
            phase1 false ks P ssLoc rsLoc esLoc esM esL tblM tblL tblM hinv (.inr ⟨ss, hv1, hv2⟩) hvR_no_inr,
            rfl, rfl, rfl, rfl, hinv.sess_inv, fun _ => ⟨rfl, rfl⟩, hinv.book_fresh_before_send⟩
        · let sIdx := q * (t0 - healEpoch tL) + j
          let bk0 := (esM.h.book sIdx).getD {}
          have hinv0 : ActiveSessInv C ℓ encT idOf false (ks sIdx) (ssLoc sIdx) (rsLoc sIdx)
              bk0 (tblM sIdx) (tblL sIdx) := by
            have hs0 := hinv.sess_inv sIdx
            dsimp only [bk0] at hs0 ⊢
            cases hc : ((esM.h.book sIdx).getD {}).sCorr
            · rw [hc] at hs0; exact activeSessInv_to_phase2 C ℓ encT idOf hs0
            · rw [hc] at hs0; exact hs0
          rcases activeSessInv_corruptSender C ℓ encT idOf hinv0 with ⟨sM', hcs, hinv0'⟩
          have hpub := sim_liftFS_corruptSender_run C ℓ encT idOf sIdx esM.h tblM hcs
          let hM1 : MultiHS Pt :=
            { esM.h with book := Function.update esM.h.book sIdx (some { bk0 with sCorr := true }) }
          let tblM1 := Function.update tblM sIdx sM'
          refine ⟨hM1, tblM1, sim_reveal_multi_inr C Dh encPt encT idOf ℓ q qep (rem + 1) tL par
            phase1 ks P sIdx ssLoc rsLoc esLoc esM esL tblM tblL sM' hinv hv1 hv2 hpub hvR_no_inr,
            rfl, rfl, rfl, rfl, ?_, ?_, ?_⟩
          · intro sIdx'
            by_cases hs : sIdx' = sIdx
            · subst hs; simpa [hM1, tblM1, bk0, sIdx] using hinv0'
            · simp [hM1, tblM1, hs, hinv.sess_inv sIdx']
          · intro sIdx'
            by_cases hs : sIdx' = sIdx
            · subst hs; simp [hM1, bk0, sIdx]
            · simp [hM1, hs]
          · intro t1 j1 ht1_pos htH1 hj1_lt hep1_lt hh1
            have hne_t : t1 ≠ t0 := by intro heq; subst heq; rw [← hP_send] at hep1_lt; omega
            have htH0 : healEpoch tL ≤ t0 := healEpoch_le_of_gen4 hbk0
            have hj_q : j < q := by
              by_cases ht0_pos : 1 ≤ t0
              · have := hinv.sess_pos_bound t0 ht0_pos; omega
              · have ht0_z : t0 = 0 := by omega
                subst ht0_z; exact lt_of_lt_of_le hj_len hinv.sess_zero_le
            have hne_idx : q * (t1 - healEpoch tL) + j1 ≠ sIdx := fun heq =>
              hne_t (bucketSlot_inj htH1 htH0 hj1_lt hj_q heq).1
            simp only [hM1, Function.update_of_ne hne_idx]
            exact hinv.book_fresh_before_send t1 j1 ht1_pos htH1 hj1_lt hep1_lt hh1
      rcases hvS_step with ⟨hM1, tblM1, hM_eval, hlf1, hcache1, hfT1, hsess1, hsinv1, hbk_eq1, hbf1⟩
      have hstepM :
          (simulateQ (pubFsImplOpt C ℓ encT idOf false)
            (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
              3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tblM) =
          pure ((some stOut, { esM with g := esM.g.afterCorr P, h := hM1 }), (fun _ => false, tblM1)) := by
        simp only [qr, implEDFPaperBucketRaw, corrEPaperBucket, QueryImpl.add_apply_inr,
          QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind,
          hinv.abort_M, hwinM, hallowM, Bool.not_true, Bool.or_self,
          Bool.false_eq_true, ↓reduceIte, run_liftH_eq]
        rw [hkMultiOpt_reveal]
        simp only [hguardM, Bool.false_eq_true, ↓reduceIte, bind_assoc,
          simulateQ_bind, StateT.run_bind]
        rw [hM_eval]
        simp only [pure_bind, StateT.run_bind, StateT.run_modify, StateT.run_pure, simulateQ_pure]
      rw [runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM _ tblM tblM1 (some stOut) hwinM hstepM]
      simp only [show (esM.g.afterCorr P).win = false from hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
      have hhealed_imp : ∀ t0, healedBy (esLoc.g.afterCorr P).tL 3 t0 = true →
          healedBy esLoc.g.tL 3 t0 = true :=
        fun t0 hh => (healedBy_leak_imp esLoc.g (max (esLoc.g.epoch .A) (esLoc.g.epoch .B)) 3 t0 hh).1
      have htL_mem' : ∀ cur, (esLoc.g.afterCorr P).tL = some cur → cur ∈ (esLoc.g.afterCorr P).leaks := by
        intro cur hcur
        have hl := leak_props esLoc.g (max (esLoc.g.epoch .A) (esLoc.g.epoch .B))
        have htL_eq : (esLoc.g.afterCorr P).tL = (esLoc.g.leak (max (esLoc.g.epoch .A) (esLoc.g.epoch .B))).tL := rfl
        rw [htL_eq, hl.1, Option.some.injEq] at hcur
        subst hcur; exact hl.2.1
      refine hIH2 (some stOut) ssLoc rsLoc
        { esLoc with g := esLoc.g.afterCorr P, h := hLoc1 }
        { esM with g := esM.g.afterCorr P, h := hM1 } esL tblM1 tblL ?_
      exact
        { gsync := hinv.gsync.afterCorr_sync P
          abort_loc := hinv.abort_loc
          abort_M := hinv.abort_M
          win_false := hinv.win_false
          lfWin_M := by dsimp only; rw [hlf1]; exact hinv.lfWin_M
          comp_unhealed := compUnhealed_afterCorr hinv.comp_unhealed
          tL_mem_leaks := htL_mem'
          phase1_props := fun hp => Bool.noConfusion hp
          phase2_props := fun _ => hpl_after
          sess_eq := by dsimp only; rw [hhLoc1_fields.2.2, hsess1]; exact hinv.sess_eq
          sess_nodup := by dsimp only; rw [hsess1]; exact hinv.sess_nodup
          sess_zero_le := by dsimp only; rw [hsess1]; exact hinv.sess_zero_le
          sess_pos_bound := fun t0 ht0 => by
            dsimp only; rw [hsess1]
            exact le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound t0 ht0)
          sess_epoch_ok := fun t0 hne => by dsimp only at hne; rw [hsess1] at hne; exact hinv.sess_epoch_ok t0 hne
          fTable_M_iff := fun t0 ik => by dsimp only; rw [hfT1, hsess1]; exact hinv.fTable_M_iff t0 ik
          fTable_loc_eq := fun t0 ik => by
            dsimp only; rw [hhLoc1_fields.2.1, hsess1]; exact hinv.fTable_loc_eq t0 ik
          cache_sync := fun t0 => by
            dsimp only; rw [hhLoc1_fields.1, hcache1, hsess1]; exact hinv.cache_sync t0
          vp_id := hinv.vp_id
          vp_tcur_eq := hinv.vp_tcur_eq
          vp_γ_eq := hinv.vp_γ_eq
          vp_root_eq := hinv.vp_root_eq
          vp_cka_eq := hinv.vp_cka_eq
          vp_cka_cache := fun Q hQ => by
            dsimp only; rw [hcache1]; exact hinv.vp_cka_cache Q hQ
          epoch_bound := fun Q => le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
          vS_sync := fun Q => by dsimp only; rw [hsess1]; exact hinv.vS_sync Q
          vR_dom := hinv.vR_dom
          vR_sync := fun Q t0 => by dsimp only; rw [hsess1]; exact hinv.vR_sync Q t0
          sess_inv := hsinv1
          ss_fresh := hinv.ss_fresh
          rs_fresh := hinv.rs_fresh
          book_fresh_before_send := fun t0 j h1 h2 h3 h4 h5 =>
            hbf1 t0 j h1 h2 h3 h4 (hhealed_imp t0 h5)
          trans_meta := fun rec hr => by
            rcases hinv.trans_meta rec hr with ⟨h1, h2, h3, h4, h5⟩
            exact ⟨h1, h2, h3, h4, fun ht => by dsimp only; rw [hcache1]; exact h5 ht⟩
          cache_empty_gt := fun t0 hlt => by dsimp only; rw [hcache1]; exact hinv.cache_empty_gt t0 hlt
          healed_sender_pin := fun Q t0 j hs ht hv hh => by
            dsimp only at hs ht hv hh ⊢
            rw [(hbk_eq1 _).1, hcache1]
            exact hinv.healed_sender_pin Q t0 j hs ht hv (hhealed_imp t0 hh)
          healed_vR_pin := fun Q t0 sIdx hv hh => by
            dsimp only at hv hh ⊢
            rw [hcache1]
            exact hinv.healed_vR_pin Q t0 sIdx hv (hhealed_imp t0 hh)
          healed_book_trans := fun t0 sIdx hh hro hp => by
            dsimp only at hh hro hp ⊢
            rw [(hbk_eq1 sIdx).2]
            rw [hcache1] at hp
            exact hinv.healed_book_trans t0 sIdx (hhealed_imp t0 hh) hro hp }

private theorem step2_corr {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) {α : Type}
    (r : Option (Fig8St Pt) → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks false (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inr P)
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  intro qr
  by_cases hallow : esLoc.g.corrAllowedPaper P = true
  · exact step_corr_postLeak_leOne mode C Dh encPt encT idOf ℓ q qep rem tL par false ks P r hIH
      ssLoc rsLoc esLoc esM esL tblM tblL hinv hallow
      (postLeak_afterCorr_of_postLeak P (hinv.phase2_props rfl))
  · have hallow_f : esLoc.g.corrAllowedPaper P = false := Bool.eq_false_iff.mpr hallow
    have hallowM_f : esM.g.corrAllowedPaper P = false := by
      rw [← hinv.gsync.corrAllowedPaper_eq P]; exact hallow_f
    have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
    have hstepLoc :
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
        pure (none, esLoc) := by
      simp [qr, implEDFPaperBucketRaw, corrEPaperBucket, hinv.abort_loc, hinv.win_false, hallow_f]
    have hstepM :
        (simulateQ (pubFsImplOpt C ℓ encT idOf false)
          (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tblM) =
        pure ((none, esM), (fun _ => false, tblM)) := by
      simp [qr, implEDFPaperBucketRaw, corrEPaperBucket, hinv.abort_M, hwinM, hallowM_f]
    rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc none hinv.win_false hstepLoc,
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM none hwinM hstepM]
    simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
    exact hIH none ssLoc rsLoc esLoc esM esL tblM tblL (hinv.mono_rem (Nat.le_succ rem))

private theorem step1_corr {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (tL : Option ℕ) (par : Bool) (ks : ℕ → BitVec 256)
    (P : Party) {α : Type}
    (r : Option (Fig8St Pt) → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH1 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks true rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeAdd
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM')
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true (r u) esL' none tblL'))
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inr P)
    LeAdd
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par true
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esL none tblL) := by
  intro qr
  have hesL : esL = esM := (hinv.phase1_props rfl).2.1
  rw [hesL]
  have hinvM : BucketSimInv C ℓ encT idOf q qep tL par ks true (rem + 1) ssLoc rsLoc esLoc esM esM tblM tblL := by
    rwa [hesL] at hinv
  by_cases hallow : esLoc.g.corrAllowedPaper P = true
  · by_cases hpl_after : postLeak tL (esLoc.g.afterCorr P) = true
    · exact leAdd_of_le_main (step_corr_postLeak_leOne mode C Dh encPt encT idOf ℓ q qep rem tL par
        true ks P r hIH2 ssLoc rsLoc esLoc esM esM tblM tblL hinvM hallow hpl_after)
    · have hpl_after_f : postLeak tL (esLoc.g.afterCorr P) = false := Bool.eq_false_iff.mpr hpl_after
      have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
      have hallowM : esM.g.corrAllowedPaper P = true := by
        rw [← hinv.gsync.corrAllowedPaper_eq P]; exact hallow
      have htcur_loc := (hinv.vp_tcur_eq P).1
      have htcur_M := (hinv.vp_tcur_eq P).2
      have hepA : esLoc.g.epoch .A = esM.g.epoch .A := congrFun hinv.gsync.epoch_eq .A
      have hepB : esLoc.g.epoch .B = esM.g.epoch .B := congrFun hinv.gsync.epoch_eq .B
      by_cases hguard : (mode == some false &&
          (!(esLoc.g.epoch P < healEpoch tL) || !(max (esLoc.g.epoch .A) (esLoc.g.epoch .B) < healEpoch tL))) = true
      · apply leAdd_of_le_main
        have hguardL : (mode == some false &&
            (!((esLoc.g.st P).tcur < healEpoch tL) || !(max (esLoc.g.epoch .A) (esLoc.g.epoch .B) < healEpoch tL))) = true := by
          rwa [htcur_loc]
        have hguardM : (mode == some false &&
            (!((esM.g.st P).tcur < healEpoch tL) || !(max (esM.g.epoch .A) (esM.g.epoch .B) < healEpoch tL))) = true := by
          rwa [htcur_M, ← hepA, ← hepB]
        have hstepLoc :
            simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
              (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
            pure (none, { esLoc with abort := true }) := by
          simp only [qr, implEDFPaperBucketRaw, corrEPaperBucket, QueryImpl.add_apply_inr,
            QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind,
            hinv.abort_loc, hinv.win_false, hallow, Bool.not_true, Bool.or_self,
            Bool.false_eq_true, ↓reduceIte, run_liftH_eq]
          dsimp only [hkLocOpt, hooksSlotBucketOptAt]
          simp only [hguardL, ↓reduceIte, StateT.run_pure, pure_bind, abortE,
            StateT.run_bind, StateT.run_modify, simulateQ_pure]
        have hstepM :
            (simulateQ (pubFsImplOpt C ℓ encT idOf false)
              (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
                3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tblM) =
            pure ((none, { esM with abort := true }), (fun _ => false, tblM)) := by
          simp only [qr, implEDFPaperBucketRaw, corrEPaperBucket, QueryImpl.add_apply_inr,
            QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind,
            hinv.abort_M, hwinM, hallowM, Bool.not_true, Bool.or_self,
            Bool.false_eq_true, ↓reduceIte, run_liftH_eq]
          rw [hkMultiOpt_reveal]
          simp only [hguardM, ↓reduceIte, StateT.run_pure, pure_bind, abortE,
            StateT.run_bind, StateT.run_modify, simulateQ_pure]
        rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc _ none hinv.win_false hstepLoc,
            runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM _ tblM tblM none hwinM hstepM]
        simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
        exact exit_halted_leOne mode C Dh encPt encT idOf ℓ q qep tL par ks (r none)
          { esLoc with abort := true } { esM with abort := true } none tblM
          (by simp) rfl hinv.gsync.win_eq.symm hinv.gsync.leaks_eq.symm hinv.gsync.corrs_eq.symm
      · have hno_gen4_le : ∀ t0, t0 ≤ esLoc.g.epoch P → inStage2BucketGen 4 tL par t0 = false := by
          intro t0 ht0_le
          cases hbk' : inStage2BucketGen 4 tL par t0
          · rfl
          · exfalso
            have hlt_ep : ltOpt tL (esLoc.g.epoch P) = true := ltOpt_of_inStage2BucketGen_le hbk' ht0_le
            have hl := leak_props esLoc.g (max (esLoc.g.epoch .A) (esLoc.g.epoch .B))
            have hep_le_max : esLoc.g.epoch P ≤ maxOpt esLoc.g.tL (max (esLoc.g.epoch .A) (esLoc.g.epoch .B)) := by
              have h1 : esLoc.g.epoch P ≤ max (esLoc.g.epoch .A) (esLoc.g.epoch .B) := by
                cases P <;> simp
              exact le_trans h1 hl.2.2.2.1
            have hlt_after : ltOpt tL (maxOpt esLoc.g.tL (max (esLoc.g.epoch .A) (esLoc.g.epoch .B))) = true := by
              cases tL with
              | none => rfl
              | some l => simp only [ltOpt, decide_eq_true_eq] at hlt_ep ⊢; omega
            have hpl_true : postLeak tL (esLoc.g.afterCorr P) = true := by
              unfold postLeak
              have htL' : (esLoc.g.afterCorr P).tL = some (maxOpt esLoc.g.tL (max (esLoc.g.epoch .A) (esLoc.g.epoch .B))) := rfl
              rw [htL']; exact hlt_after
            rw [hpl_after_f] at hpl_true; cases hpl_true
        have hvR_no_inr : ∀ t0, ∀ sIdx, (esM.g.st P).vR t0 ≠ some (.inr sIdx) := by
          intro t0 sIdx hv
          have hdom := (hinv.vR_dom P t0 (by simp [hv])).1
          rcases hinv.vR_sync P t0 with ⟨_, h2⟩ | ⟨_, _, h2⟩ | ⟨_, _, _, hbk0, _, _, _, _⟩
          · rw [hv] at h2; cases h2
          · rw [hv] at h2; cases h2
          · rw [hno_gen4_le t0 hdom] at hbk0; cases hbk0
        have hguardL : (mode == some false &&
            (!((esLoc.g.st P).tcur < healEpoch tL) || !(max (esLoc.g.epoch .A) (esLoc.g.epoch .B) < healEpoch tL))) = false := by
          rw [htcur_loc]; exact Bool.eq_false_iff.mpr hguard
        have hguardM : (mode == some false &&
            (!((esM.g.st P).tcur < healEpoch tL) || !(max (esM.g.epoch .A) (esM.g.epoch .B) < healEpoch tL))) = false := by
          rw [htcur_M, ← hepA, ← hepB]; exact Bool.eq_false_iff.mpr hguard
        let hLoc1 : LocHS Pt :=
          if !postLeak tL esLoc.g && esLoc.h.lc.isNone && !((esLoc.g.st P).tcur < healEpoch tL) then
            { esLoc.h with lc := some (esLoc.g.st P).tcur }
          else esLoc.h
        have hhLoc1_fields : hLoc1.cache = esLoc.h.cache ∧ hLoc1.fTable = esLoc.h.fTable ∧
            hLoc1.sessions = esLoc.h.sessions := by
          dsimp only [hLoc1]; split <;> exact ⟨rfl, rfl, rfl⟩
        let stOut := realParty (esLoc.g.st P) (esLoc.g.st P).γ (esLoc.g.st P).root
          (esLoc.g.st P).vS (esLoc.g.st P).vR
        have hstepLoc :
            simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
              (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
            pure (some stOut, { esLoc with g := esLoc.g.afterCorr P, h := hLoc1 }) := by
          simp only [qr, implEDFPaperBucketRaw, corrEPaperBucket, QueryImpl.add_apply_inr,
            QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind,
            hinv.abort_loc, hinv.win_false, hallow, Bool.not_true, Bool.or_self,
            Bool.false_eq_true, ↓reduceIte, run_liftH_eq]
          dsimp only [hkLocOpt, hooksSlotBucketOptAt]
          simp only [hguardL, Bool.false_eq_true, ↓reduceIte]
          by_cases hcond : (!postLeak tL esLoc.g && esLoc.h.lc.isNone &&
              !((esLoc.g.st P).tcur < healEpoch tL)) = true <;>
            simp only [StateT.run_bind, StateT.run_get, hcond, Bool.false_eq_true, ↓reduceIte,
              StateT.run_modify, StateT.run_pure, pure_bind, simulateQ_pure, hLoc1, stOut]
        have hstepM : ∀ (la : Bool) (tbl : ℕ → SessHSt Pt ℓ),
            (simulateQ (pubFsImplOpt C ℓ encT idOf la)
              (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la)
                3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tbl) =
            pure ((some stOut, { esM with g := esM.g.afterCorr P }), (fun _ => false, tbl)) := by
          intro la tbl
          have hrevM :
              (simulateQ (pubFsImplOpt C ℓ encT idOf la)
                (((hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
                  (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par la).reveal
                  esM.g P (esM.g.st P)).run esM.h)).run (fun _ => false, tbl) =
              pure ((some stOut, esM.h), (fun _ => false, tbl)) := by
            rcases hinv.vS_sync P with ⟨hv1, hv2⟩ | ⟨ss, hv1, hv2⟩ | ⟨t0, _, ht0_le, _, _, _, hbk0, _, _, _, _⟩
            · exact sim_reveal_multi_inl C Dh encPt encT idOf ℓ q qep (rem + 1) tL par
                true la ks P ssLoc rsLoc esLoc esM esL tblM tblL tbl hinv (.inl ⟨hv1, hv2⟩)
                (fun t sIdx _ => hvR_no_inr t sIdx)
            · exact sim_reveal_multi_inl C Dh encPt encT idOf ℓ q qep (rem + 1) tL par
                true la ks P ssLoc rsLoc esLoc esM esL tblM tblL tbl hinv (.inr ⟨ss, hv1, hv2⟩)
                (fun t sIdx _ => hvR_no_inr t sIdx)
            · rw [hno_gen4_le t0 ht0_le] at hbk0; cases hbk0
          simp only [qr, implEDFPaperBucketRaw, corrEPaperBucket, QueryImpl.add_apply_inr,
            QueryImpl.add_apply_inl, StateT.run_bind, StateT.run_get, pure_bind,
            hinv.abort_M, hwinM, hallowM, Bool.not_true, Bool.or_self,
            Bool.false_eq_true, ↓reduceIte, run_liftH_eq]
          rw [hkMultiOpt_reveal]
          simp only [hguardM, Bool.false_eq_true, ↓reduceIte, bind_assoc,
            simulateQ_bind, StateT.run_bind]
          rw [hrevM]
          simp only [pure_bind, StateT.run_bind, StateT.run_modify, StateT.run_pure, simulateQ_pure]
        rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc _ (some stOut) hinv.win_false hstepLoc,
            runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM _ tblM tblM (some stOut) hwinM (hstepM false tblM),
            runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM _ tblL tblL (some stOut) hwinM (hstepM true tblL)]
        simp only [show (esLoc.g.afterCorr P).win = false from hinv.win_false,
          show (esM.g.afterCorr P).win = false from hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
        have hhealed_imp : ∀ t0, healedBy (esLoc.g.afterCorr P).tL 3 t0 = true →
            healedBy esLoc.g.tL 3 t0 = true :=
          fun t0 hh => (healedBy_leak_imp esLoc.g (max (esLoc.g.epoch .A) (esLoc.g.epoch .B)) 3 t0 hh).1
        have htL_mem' : ∀ cur, (esLoc.g.afterCorr P).tL = some cur → cur ∈ (esLoc.g.afterCorr P).leaks := by
          intro cur hcur
          have hl := leak_props esLoc.g (max (esLoc.g.epoch .A) (esLoc.g.epoch .B))
          have htL_eq : (esLoc.g.afterCorr P).tL = (esLoc.g.leak (max (esLoc.g.epoch .A) (esLoc.g.epoch .B))).tL := rfl
          rw [htL_eq, hl.1, Option.some.injEq] at hcur
          subst hcur; exact hl.2.1
        exact hIH1 (some stOut) ssLoc rsLoc
          { esLoc with g := esLoc.g.afterCorr P, h := hLoc1 }
          { esM with g := esM.g.afterCorr P }
          { esM with g := esM.g.afterCorr P } tblM tblL
          { gsync := hinv.gsync.afterCorr_sync P
            abort_loc := hinv.abort_loc
            abort_M := hinv.abort_M
            win_false := hinv.win_false
            lfWin_M := hinv.lfWin_M
            comp_unhealed := compUnhealed_afterCorr hinv.comp_unhealed
            tL_mem_leaks := htL_mem'
            phase1_props := fun _ => ⟨hpl_after_f, rfl, (hinv.phase1_props rfl).2.2⟩
            phase2_props := fun hp => Bool.noConfusion hp
            sess_eq := by dsimp only; rw [hhLoc1_fields.2.2]; exact hinv.sess_eq
            sess_nodup := hinv.sess_nodup
            sess_zero_le := hinv.sess_zero_le
            sess_pos_bound := fun t0 ht0 =>
              le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.sess_pos_bound t0 ht0)
            sess_epoch_ok := hinv.sess_epoch_ok
            fTable_M_iff := hinv.fTable_M_iff
            fTable_loc_eq := fun t0 ik => by
              dsimp only; rw [hhLoc1_fields.2.1]; exact hinv.fTable_loc_eq t0 ik
            cache_sync := fun t0 => by dsimp only; rw [hhLoc1_fields.1]; exact hinv.cache_sync t0
            vp_id := hinv.vp_id
            vp_tcur_eq := hinv.vp_tcur_eq
            vp_γ_eq := hinv.vp_γ_eq
            vp_root_eq := hinv.vp_root_eq
            vp_cka_eq := hinv.vp_cka_eq
            vp_cka_cache := hinv.vp_cka_cache
            epoch_bound := fun Q => le_trans (Nat.add_le_add_left (Nat.le_succ rem) _) (hinv.epoch_bound Q)
            vS_sync := hinv.vS_sync
            vR_dom := hinv.vR_dom
            vR_sync := hinv.vR_sync
            sess_inv := hinv.sess_inv
            ss_fresh := hinv.ss_fresh
            rs_fresh := hinv.rs_fresh
            book_fresh_before_send := fun t0 j h1 h2 h3 h4 h5 =>
              hinv.book_fresh_before_send t0 j h1 h2 h3 h4 (hhealed_imp t0 h5)
            trans_meta := hinv.trans_meta
            cache_empty_gt := hinv.cache_empty_gt
            healed_sender_pin := fun Q t0 j hs ht hv hh =>
              hinv.healed_sender_pin Q t0 j hs ht hv (hhealed_imp t0 hh)
            healed_vR_pin := fun Q t0 sIdx hv hh =>
              hinv.healed_vR_pin Q t0 sIdx hv (hhealed_imp t0 hh)
            healed_book_trans := fun t0 sIdx hh hro hp =>
              hinv.healed_book_trans t0 sIdx (hhealed_imp t0 hh) hro hp }
  · have hallow_f : esLoc.g.corrAllowedPaper P = false := Bool.eq_false_iff.mpr hallow
    have hallowM_f : esM.g.corrAllowedPaper P = false := by
      rw [← hinv.gsync.corrAllowedPaper_eq P]; exact hallow_f
    have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
    have hstepLoc :
        simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
        pure (none, esLoc) := by
      simp [qr, implEDFPaperBucketRaw, corrEPaperBucket, hinv.abort_loc, hinv.win_false, hallow_f]
    have hstepM : ∀ (la : Bool) (tbl : ℕ → SessHSt Pt ℓ),
        (simulateQ (pubFsImplOpt C ℓ encT idOf la)
          (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la)
            3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tbl) =
        pure ((none, esM), (fun _ => false, tbl)) := by
      intro la tbl
      simp [qr, implEDFPaperBucketRaw, corrEPaperBucket, hinv.abort_M, hwinM, hallowM_f]
    rw [runLocCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc esLoc none hinv.win_false hstepLoc,
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblM tblM none hwinM (hstepM false tblM),
        runMultiCont_inr_of_step _ _ _ _ _ _ _ _ _ _ _ _ qr r esM esM tblL tblL none hwinM (hstepM true tblL)]
    simp only [hinv.win_false, hwinM, calcWinEp, Bool.false_eq_true, ↓reduceIte]
    exact hIH1 none ssLoc rsLoc esLoc esM esM tblM tblL (hinvM.mono_rem (Nat.le_succ rem))

private theorem ct_beq_iff_local :
    ∀ (c1 c2 : ℕ × _root_.CryptoGames.Ratchet.LibsignalInst.LibsignalCiphertextWithSalt32),
      (c1 == c2) = true ↔ c1 = c2
  | ⟨n1, s1, b1⟩, ⟨n2, s2, b2⟩ => by
    change (n1 == n2 && (s1 == s2 && b1 == b2)) = true ↔ _
    simp [Bool.and_eq_true, beq_iff_eq]

private theorem hdr_beq_iff_local {Pt : Type} [DecidableEq Pt] :
    ∀ (h1 h2 : Header Pt), (h1 == h2) = true ↔ h1 = h2
  | ⟨t1, o1⟩, ⟨t2, o2⟩ => by
    cases o1 <;> cases o2 <;>
      (change (t1 == t2 && _) = true ↔ _; dsimp only [BEq.beq, Option.instBEq, Option.instBEq.beq];
       simp [Bool.and_eq_true])

private theorem find_filter_map_trans {Pt M : Type} [DecidableEq Pt]
    (L : List (Record M (Header Pt × (ℕ × LibsignalCiphertextWithSalt32))))
    (P : Party)
    (c : Header Pt × (ℕ × LibsignalCiphertextWithSalt32))
    (hP : P.other = Party.senderOf c.1.1)
    (htr : ∀ r ∈ L, r.pos.epoch = r.ct.1.1 ∧ r.pos.sender = Party.senderOf r.pos.epoch) :
    ((L.filter (fun r => r.pos.epoch == c.1.1)).map (fun r => (r.pos.idx, r.ct.1, r.ct.2))).find?
      (fun x => x.2 == c) =
    (L.find? (fun r => r.pos.sender == P.other && decide (r.ct = c))).map
      (fun r => (r.pos.idx, r.ct.1, r.ct.2)) := by
  induction L with
  | nil => rfl
  | cons r rs ih =>
    rcases htr r List.mem_cons_self with ⟨hep, hsend⟩
    have ih' := ih (fun r' hr' => htr r' (List.mem_cons_of_mem _ hr'))
    by_cases hct : r.ct = c
    · subst hct
      have h1 : (r.pos.epoch == r.ct.1.1) = true := by simp [hep]
      have h2 : (r.pos.sender == P.other) = true := by simp [hsend, hP, hep]
      simp [h1, h2]
    · by_cases he : (r.pos.epoch == c.1.1) = true
      · have hne2 : ((r.ct.1, r.ct.2) == c) = false := by
          change (r.ct.1 == c.1 && r.ct.2 == c.2) = false
          cases hbeq : (r.ct.1 == c.1 && r.ct.2 == c.2) with
          | false => rfl
          | true =>
            simp only [Bool.and_eq_true, hdr_beq_iff_local, ct_beq_iff_local] at hbeq
            exact False.elim (hct (Prod.ext hbeq.1 hbeq.2))
        simp [he, hct, hne2, ih']
      · simp only [Bool.not_eq_true] at he
        simp [he, hct, ih']

private theorem accept_update_idem {St Msg C : Type}
    (s : GameState St Msg C) (P : Party) (st' : St) (pos : Pos) :
    { s.accept P st' pos with st := Function.update (s.accept P st' pos).st P st' } =
      s.accept P st' pos := by
  have h : Function.update (Function.update s.st P st') P st' = Function.update s.st P st' := by
    funext Q; by_cases hQ : Q = P <;> simp [hQ]
  cases s; simp [GameState.accept, GameState.delete, h]

private theorem runMultiCont_fold {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool) {α : Type}
    (oa : OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (es' : MultiES Pt ℓ) (we' : Option ℕ) (tbl' : ℕ → SessHSt Pt ℓ) :
    (Prod.fst <$> (simulateQ (pubFsImplOpt C ℓ encT idOf la) do
      let (_, es'', we) ← (simulateQ (implEDFPaperBucketMode
        (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par la)
        3 qep maxForwardJumps (bucketAuthCfg 1 tL par) (mode != some false)
        isHonestHdrFSMultiDFBucket) oa).run (es', we')
      return if la then es''.h.lfWin else authOutBucket 3 tL (es'', we)).run (fun _ => false, tbl')) =
    runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par la oa es' we' tbl' := rfl

private theorem GSync.record_sync {Pt : Type} {ℓ : ℕ}
    {gLoc : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256)) (RatchetReceiverState (BitVec 256) (BitVec 256))
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    {gM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    (h : GSync gLoc gM) (P : Party)
    (stLoc' : LocVP Pt) (stM' : MultiVP Pt)
    (rec : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt)) (isChall : Bool) :
    GSync (gLoc.record 3 P stLoc' rec isChall) (gM.record 3 P stM' rec isChall) := by
  have hsc : gLoc.safeCh 3 P = gM.safeCh 3 P := h.safeCh_eq 3 P
  unfold GameState.record
  exact
    { epoch_eq := h.epoch_eq
      idx_eq := by dsimp only; rw [h.idx_eq]
      tL_eq := h.tL_eq
      trans_eq := by dsimp only; rw [h.trans_eq]
      chall_eq := by dsimp only; rw [h.chall_eq]
      comp_eq := by dsimp only; rw [hsc, h.comp_eq]
      maxAcc_eq := h.maxAcc_eq
      b_eq := h.b_eq
      win_eq := h.win_eq
      leaks_eq := h.leaks_eq
      corrs_eq := h.corrs_eq }

private theorem GSync.accept_sync {Pt : Type} {ℓ : ℕ}
    {gLoc : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256)) (RatchetReceiverState (BitVec 256) (BitVec 256))
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    {gM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    (h : GSync gLoc gM) (P : Party)
    (stLoc' : LocVP Pt) (stM' : MultiVP Pt) (pos : Pos) :
    GSync (gLoc.accept P stLoc' pos) (gM.accept P stM' pos) := by
  unfold GameState.accept GameState.delete
  exact
    { epoch_eq := by dsimp only; rw [h.epoch_eq]
      idx_eq := h.idx_eq
      tL_eq := h.tL_eq
      trans_eq := by dsimp only; rw [h.trans_eq]
      chall_eq := by dsimp only; rw [h.chall_eq]
      comp_eq := by dsimp only; rw [h.comp_eq]
      maxAcc_eq := by dsimp only; rw [h.maxAcc_eq]
      b_eq := h.b_eq
      win_eq := h.win_eq
      leaks_eq := h.leaks_eq
      corrs_eq := h.corrs_eq }

private theorem GSync.epMgmt_sync {Pt : Type} {ℓ : ℕ}
    {gLoc : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256)) (RatchetReceiverState (BitVec 256) (BitVec 256))
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    {gM : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32)}
    (h : GSync gLoc gM) (qep : ℕ) (P : Party) (bad : Bool) :
    (gLoc.epMgmt 3 qep P bad = none ∧ gM.epMgmt 3 qep P bad = none) ∨
    (∃ s1Loc s1M, gLoc.epMgmt 3 qep P bad = some s1Loc ∧
      gM.epMgmt 3 qep P bad = some s1M ∧ GSync s1Loc s1M) := by
  have hsc : gLoc.safeCh 3 P = gM.safeCh 3 P := h.safeCh_eq 3 P
  unfold GameState.epMgmt
  by_cases hs : P.sendsIn (gLoc.epoch P + 1) = true
  · have hsM : P.sendsIn (gM.epoch P + 1) = true := by rw [← h.epoch_eq]; exact hs
    simp only [hs, hsM, ↓reduceIte]
    by_cases hq : qep < gLoc.epoch P + 1
    · have hqM : qep < gM.epoch P + 1 := by rw [← h.epoch_eq]; exact hq
      simp [hq, hqM]
    · have hqM : ¬ qep < gM.epoch P + 1 := by rw [← h.epoch_eq]; exact hq
      simp only [hq, hqM, ↓reduceIte]
      refine Or.inr ⟨_, _, rfl, rfl, ?_⟩
      by_cases hb : (bad && !(gLoc.safeCh 3 P)) = true
      · have hbM : (bad && !(gM.safeCh 3 P)) = true := by rw [← hsc]; exact hb
        simp only [hb, hbM, ↓reduceIte, GameState.leak]
        exact
          { epoch_eq := by dsimp only; rw [h.epoch_eq]
            idx_eq := by dsimp only; rw [h.idx_eq]
            tL_eq := by dsimp only; rw [h.tL_eq, h.epoch_eq]
            trans_eq := h.trans_eq
            chall_eq := h.chall_eq
            comp_eq := h.comp_eq
            maxAcc_eq := h.maxAcc_eq
            b_eq := h.b_eq
            win_eq := h.win_eq
            leaks_eq := by dsimp only; rw [h.tL_eq, h.epoch_eq, h.leaks_eq]
            corrs_eq := h.corrs_eq }
      · have hbM : (bad && !(gM.safeCh 3 P)) = false := by
          rw [← hsc]; exact Bool.not_eq_true _ |>.mp hb
        simp only [Bool.not_eq_true _ |>.mp hb, hbM, Bool.false_eq_true, ↓reduceIte]
        exact
          { epoch_eq := by dsimp only; rw [h.epoch_eq]
            idx_eq := by dsimp only; rw [h.idx_eq]
            tL_eq := h.tL_eq
            trans_eq := h.trans_eq
            chall_eq := h.chall_eq
            comp_eq := h.comp_eq
            maxAcc_eq := h.maxAcc_eq
            b_eq := h.b_eq
            win_eq := h.win_eq
            leaks_eq := h.leaks_eq
            corrs_eq := h.corrs_eq }
  · have hs' : P.sendsIn (gLoc.epoch P + 1) = false := Bool.not_eq_true _ |>.mp hs
    have hsM' : P.sendsIn (gM.epoch P + 1) = false := by rw [← h.epoch_eq]; exact hs'
    simp only [hs', hsM', Bool.false_eq_true, ↓reduceIte]
    by_cases hq : qep < gLoc.epoch P
    · have hqM : qep < gM.epoch P := by rw [← h.epoch_eq]; exact hq
      simp [hq, hqM]
    · have hqM : ¬ qep < gM.epoch P := by rw [← h.epoch_eq]; exact hq
      simp only [hq, hqM, ↓reduceIte]
      exact Or.inr ⟨_, _, rfl, rfl, h⟩

private theorem postLeak_epMgmt_of_postLeak {St Msg C : Type}
    {tL : Option ℕ} {g s1 : GameState St Msg C} {qep : ℕ} {P : Party} {bad : Bool}
    (hpl : postLeak tL g = true)
    (hep : g.epMgmt 3 qep P bad = some s1) :
    postLeak tL s1 = true := by
  unfold GameState.epMgmt at hep
  by_cases hs : P.sendsIn (g.epoch P + 1) = true
  · simp only [hs, ↓reduceIte] at hep
    split at hep
    · cases hep
    · cases hep
      by_cases hb : (bad && !(g.safeCh 3 P)) = true
      · simp only [hb, ↓reduceIte]
        unfold postLeak at hpl ⊢
        cases htL : g.tL with
        | none => rw [htL] at hpl; cases hpl
        | some cur =>
          rw [htL] at hpl
          have hl := leak_props g (g.epoch P + 1)
          have hle := hl.2.2.2.2 cur htL
          change ltOpt tL (maxOpt g.tL (g.epoch P + 1)) = true
          cases tL with
          | none => rfl
          | some l => simp only [ltOpt, decide_eq_true_eq] at hpl ⊢; omega
      · simp only [Bool.not_eq_true _ |>.mp hb, Bool.false_eq_true, ↓reduceIte]
        exact hpl
  · simp only [Bool.not_eq_true _ |>.mp hs, Bool.false_eq_true, ↓reduceIte] at hep
    split at hep
    · cases hep
    · cases hep; exact hpl

private theorem epMgmt_some_props {St Msg C : Type}
    {g s1 : GameState St Msg C} {qep : ℕ} {P : Party} {bad : Bool}
    (hep : g.epMgmt 3 qep P bad = some s1)
    (hcu : CompUnhealed g)
    (htL_mem : ∀ cur, g.tL = some cur → cur ∈ g.leaks) :
    s1.st = g.st ∧ s1.trans = g.trans ∧ s1.win = g.win ∧
    s1.chall = g.chall ∧ s1.comp = g.comp ∧ s1.corrs = g.corrs ∧
    CompUnhealed s1 ∧
    (∀ cur, s1.tL = some cur → cur ∈ s1.leaks) ∧
    (∀ t0, healedBy s1.tL 3 t0 = true → healedBy g.tL 3 t0 = true) ∧
    (∀ Q, g.epoch Q ≤ s1.epoch Q) := by
  unfold GameState.epMgmt at hep
  by_cases hs : P.sendsIn (g.epoch P + 1) = true
  · simp only [hs, ↓reduceIte] at hep
    split at hep
    · cases hep
    · by_cases hb : (bad && !(g.safeCh 3 P)) = true
      · simp only [hb, ↓reduceIte, Option.some.injEq] at hep
        subst hep
        have hl := leak_props g (g.epoch P + 1)
        refine ⟨rfl, rfl, rfl, rfl, rfl, rfl, ?_, ?_, ?_, ?_⟩
        · unfold CompUnhealed at hcu ⊢
          refine ⟨fun r hr => ?_, fun pos hpos => ?_⟩
          · dsimp only [GameState.leak] at hr ⊢
            by_cases hP : r.pos.sender = P
            · subst hP; simp; have := hcu.1 r hr; omega
            · simp [Function.update_of_ne hP]; exact hcu.1 r hr
          · exact Bool.eq_false_iff.mpr fun hh =>
              Bool.eq_false_iff.mp (hcu.2 pos hpos)
                (healedBy_leak_imp g (g.epoch P + 1) 3 pos.epoch hh).1
        · intro cur hcur
          change (g.leak (g.epoch P + 1)).tL = some cur at hcur
          rw [hl.1] at hcur; injection hcur with hcur; subst hcur
          exact hl.2.1
        · intro t0 hh
          exact (healedBy_leak_imp g (g.epoch P + 1) 3 t0 hh).1
        · intro Q; dsimp only
          by_cases hQ : Q = P
          · subst hQ; simp [GameState.leak]
          · simp [GameState.leak, Function.update_of_ne hQ]
      · simp only [Bool.not_eq_true _ |>.mp hb, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at hep
        subst hep
        refine ⟨rfl, rfl, rfl, rfl, rfl, rfl, ?_, htL_mem, fun _ hh => hh, ?_⟩
        · unfold CompUnhealed at hcu ⊢
          refine ⟨fun r hr => ?_, hcu.2⟩
          dsimp only at hr ⊢
          by_cases hP : r.pos.sender = P
          · subst hP; simp; have := hcu.1 r hr; omega
          · simp [Function.update_of_ne hP]; exact hcu.1 r hr
        · intro Q; dsimp only
          by_cases hQ : Q = P
          · subst hQ; simp
          · simp [Function.update_of_ne hQ]
  · simp only [Bool.not_eq_true _ |>.mp hs, Bool.false_eq_true, ↓reduceIte] at hep
    split at hep
    · cases hep
    · simp only [Option.some.injEq] at hep
      subst hep
      exact ⟨rfl, rfl, rfl, rfl, rfl, rfl, hcu, htL_mem, fun _ hh => hh, fun _ => le_rfl⟩

private theorem record_win_false {St Msg C : Type}
    (s1 : GameState St Msg C) (Δ : ℕ) (P : Party) (st' : St) (r : Record Msg C) :
    (s1.record Δ P st' r false).win = s1.win := rfl

private theorem record_preserve_props {St Msg C : Type}
    (s1 : GameState St Msg C) (P : Party) (st' : St) (r : Record Msg C)
    (hsend_r : r.pos.sender = P)
    (hep_r : r.pos.epoch = s1.epoch P)
    (hcu : CompUnhealed s1)
    (htL_mem : ∀ cur, s1.tL = some cur → cur ∈ s1.leaks) :
    CompUnhealed (s1.record 3 P st' r false) ∧
    (∀ cur, (s1.record 3 P st' r false).tL = some cur → cur ∈ (s1.record 3 P st' r false).leaks) ∧
    (s1.record 3 P st' r false).tL = s1.tL ∧
    (s1.record 3 P st' r false).win = s1.win := by
  refine ⟨?_, htL_mem, rfl, rfl⟩
  unfold CompUnhealed at hcu ⊢
  refine ⟨fun r' hr' => ?_, fun pos hpos => ?_⟩
  · unfold GameState.record at hr' ⊢
    rcases List.mem_cons.mp hr' with rfl | hr_old
    · dsimp only
      rw [hep_r, hsend_r]
    · exact hcu.1 r' hr_old
  · unfold GameState.record at hpos ⊢
    dsimp only at hpos ⊢
    by_cases hsc : s1.safeCh 3 P = true
    · simp only [hsc, ↓reduceIte] at hpos
      exact hcu.2 pos hpos
    · simp only [Bool.not_eq_true _ |>.mp hsc, Bool.false_eq_true, ↓reduceIte, List.mem_cons] at hpos
      rcases hpos with rfl | hpos'
      · rw [hep_r]
        exact Bool.not_eq_true _ |>.mp hsc
      · exact hcu.2 pos hpos'

private theorem w7_epMgmt_st_eq {St Msg C : Type}
    {g s1 : GameState St Msg C} {Δ qep : ℕ} {P : Party} {bad : Bool}
    (hep : g.epMgmt Δ qep P bad = some s1) :
    s1.st = g.st := by
  unfold GameState.epMgmt at hep
  by_cases hs : P.sendsIn (g.epoch P + 1) = true
  · simp only [hs, ↓reduceIte] at hep
    split at hep
    · cases hep
    · cases hep
      by_cases hb : (bad && !(g.safeCh Δ P)) = true
      · simp [hb, GameState.leak]
      · simp [Bool.not_eq_true _ |>.mp hb]
  · simp only [Bool.not_eq_true _ |>.mp hs, Bool.false_eq_true, ↓reduceIte] at hep
    split at hep
    · cases hep
    · cases hep; rfl

private theorem epMgmt_some_sendsIn {St Msg C : Type}
    {g s1 : GameState St Msg C} {Δ qep : ℕ} {P : Party} {bad : Bool}
    (hep : g.epMgmt Δ qep P bad = some s1)
    (hs : P.sendsIn (g.epoch P + 1) = true) :
    ¬ (qep < g.epoch P + 1) ∧
    s1.epoch = Function.update g.epoch P (g.epoch P + 1) ∧
    s1.idx = Function.update g.idx P 0 := by
  unfold GameState.epMgmt at hep
  simp only [hs, ↓reduceIte] at hep
  by_cases hq : qep < g.epoch P + 1
  · simp [hq] at hep
  · simp only [hq, ↓reduceIte, Option.some.injEq] at hep
    subst hep
    by_cases hb : (bad && !(g.safeCh Δ P)) = true
    · simp [hq, hb, GameState.leak]
    · simp [hq, Bool.not_eq_true _ |>.mp hb]

private theorem epMgmt_some_not_sendsIn {St Msg C : Type}
    {g s1 : GameState St Msg C} {Δ qep : ℕ} {P : Party} {bad : Bool}
    (hep : g.epMgmt Δ qep P bad = some s1)
    (hs : P.sendsIn (g.epoch P + 1) = false) :
    ¬ (qep < g.epoch P) ∧ s1 = g := by
  unfold GameState.epMgmt at hep
  simp only [hs, Bool.false_eq_true, ↓reduceIte] at hep
  by_cases hq : qep < g.epoch P
  · simp [hq] at hep
  · simp only [hq, ↓reduceIte, Option.some.injEq] at hep
    exact ⟨hq, hep.symm⟩

private theorem sim_fsSend_multi_inl {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 : ℕ) (ss : RatchetSenderState (BitVec 256))
    (h : Header Pt) (m : LibsignalMsgPublicPart × Plain ℓ)
    (hM : MultiHS Pt) (tbl : ℕ → SessHSt Pt ℓ) :
    (simulateQ (pubFsImplOpt C ℓ encT idOf la)
      (((hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
          (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par la).fsSend
        ctx P t0 (.inl ss) h m none).run hM)).run (fun _ => false, tbl) =
    pure (((some (.inl ((lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).send ss h m).1,
        ((lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).send ss h m).2)), hM),
      (fun _ => false, tbl)) := by
  dsimp only [hooksFSMultiDFBucketPaper]
  simp only [StateT.run_pure, simulateQ_pure]

private theorem sim_fsSend_multi_inr_nocheck {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par la : Bool)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 sIdx : ℕ)
    (h : Header Pt) (m : LibsignalMsgPublicPart × Plain ℓ)
    (hM : MultiHS Pt) (tbl : ℕ → SessHSt Pt ℓ)
    (hnocheck : (!(ctx.safeCh 3 P) && !((hM.book sIdx).getD {}).sCorr) = false)
    {e : ℕ × LibsignalCiphertextWithSalt32} {s' : SessHSt Pt ℓ}
    (htx : (transmitHWith (lIdeal C protoSignalCodec ℓ encT)
        (lAeadR C protoSignalCodec ℓ encT idOf) (lChainPRG C.F) (hp 0 0 la) (DG (lChainPRG C.F))
        (none : Option (SpecialOps _ _ _ ProbComp)) ((h, m.1), m.2)).run (tbl sIdx) =
      pure (some e, s')) :
    let bk := (hM.book sIdx).getD {}
    let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
      { bk with fsCount := bk.fsCount + 1, fsTrans := (bk.fsCount + 1, h, e) :: bk.fsTrans }
    (simulateQ (pubFsImplOpt C ℓ encT idOf la)
      (((hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
          (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par la).fsSend
        ctx P t0 (.inr sIdx) h m none).run hM)).run (fun _ => false, tbl) =
    pure ((some (.inr sIdx, e), { hM with book := Function.update hM.book sIdx (some bk') }),
      (fun _ => false, Function.update tbl sIdx s')) := by
  intro bk bk'
  dsimp only [hooksFSMultiDFBucketPaper]
  simp only [StateT.run_bind, StateT.run_get, pure_bind, hnocheck, Bool.false_eq_true, ↓reduceIte,
    Bool.not_true]
  simp only [simulateQ_bind]
  rw [StateT.run_bind, sim_liftFS_transmit_run C ℓ encT idOf la sIdx h m hM tbl htx]
  dsimp only [bk', bk]
  simp only [pure_bind, StateT.run_bind, StateT.run_modify, StateT.run_pure, simulateQ_pure]

private theorem sim_fsSend_multi_inr_corrupt {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep : ℕ) (tL : Option ℕ) (par : Bool)
    (ctx : Ctx (CryptoGames.CKA.DDH.State (BitVec 256) Pt) Pt (BitVec 256)
      (RatchetSenderState (BitVec 256) ⊕ ℕ) (RatchetReceiverState (BitVec 256) (BitVec 256) ⊕ ℕ)
      (LibsignalMsgPublicPart × Plain ℓ) (ℕ × LibsignalCiphertextWithSalt32))
    (P : Party) (t0 sIdx : ℕ)
    (h : Header Pt) (m : LibsignalMsgPublicPart × Plain ℓ)
    (hM : MultiHS Pt) (tbl : ℕ → SessHSt Pt ℓ)
    (hcheck : (!(ctx.safeCh 3 P) && !((hM.book sIdx).getD {}).sCorr) = true)
    {ssOut : RatchetSenderState (BitVec 256)} {sM1 sM2 : SessHSt Pt ℓ}
    (hcorr : ((corruptSenderH (lChainPRG C.F) (hp 0 0 false) () :
        StateT (SessHSt Pt ℓ) ProbComp _)).run (tbl sIdx) = pure (some ssOut, sM1))
    {e : ℕ × LibsignalCiphertextWithSalt32}
    (htx : (transmitHWith (lIdeal C protoSignalCodec ℓ encT)
        (lAeadR C protoSignalCodec ℓ encT idOf) (lChainPRG C.F) (hp 0 0 false) (DG (lChainPRG C.F))
        (none : Option (SpecialOps _ _ _ ProbComp)) ((h, m.1), m.2)).run sM1 =
      pure (some e, sM2)) :
    let bk := (hM.book sIdx).getD {}
    let bk' : FSMultiBook Pt (ℕ × LibsignalCiphertextWithSalt32) :=
      { bk with sCorr := true, fsCount := bk.fsCount + 1, fsTrans := (bk.fsCount + 1, h, e) :: bk.fsTrans }
    (simulateQ (pubFsImplOpt C ℓ encT idOf false)
      (((hooksFSMultiDFBucketPaper (q + 1) (dhScheme Dh) (rootPRNG C.F encPt)
          (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps) 1 4 qep tL par false).fsSend
        ctx P t0 (.inr sIdx) h m none).run hM)).run (fun _ => false, tbl) =
    pure ((some (.inr sIdx, e), { hM with book := Function.update hM.book sIdx (some bk') }),
      (fun _ => false, Function.update tbl sIdx sM2)) := by
  intro bk bk'
  dsimp only [hooksFSMultiDFBucketPaper]
  simp only [StateT.run_bind, StateT.run_get, pure_bind, hcheck, ↓reduceIte]
  simp only [simulateQ_bind, StateT.run_bind]
  rw [sim_liftFS_corruptSender_run C ℓ encT idOf sIdx hM tbl hcorr]
  simp only [pure_bind, StateT.run_bind, StateT.run_modify, simulateQ_bind,
     Bool.not_true, Bool.false_eq_true, ↓reduceIte]
  let hM1 : MultiHS Pt := { hM with book := Function.update hM.book sIdx (some { bk with sCorr := true }) }
  let tbl1 := Function.update tbl sIdx sM1
  have htx1 : (transmitHWith (lIdeal C protoSignalCodec ℓ encT)
      (lAeadR C protoSignalCodec ℓ encT idOf) (lChainPRG C.F) (hp 0 0 false) (DG (lChainPRG C.F))
      (none : Option (SpecialOps _ _ _ ProbComp)) ((h, m.1), m.2)).run (tbl1 sIdx) =
      pure (some e, sM2) := by
    simpa [tbl1, Function.update_self] using htx
  rw [sim_liftFS_transmit_run C ℓ encT idOf false sIdx h m hM1 tbl1 htx1]
  have htbl_upd : Function.update tbl1 sIdx sM2 = Function.update tbl sIdx sM2 := by
    funext i; by_cases hi : i = sIdx <;> simp [tbl1, hi]
  have hbk_upd : Function.update hM1.book sIdx
      (some { (hM1.book sIdx).getD {} with
        fsCount := ((hM1.book sIdx).getD {}).fsCount + 1,
        fsTrans := (((hM1.book sIdx).getD {}).fsCount + 1, h, e) :: ((hM1.book sIdx).getD {}).fsTrans }) =
      Function.update hM.book sIdx (some bk') := by
    funext i
    by_cases hi : i = sIdx
    · subst hi; simp [hM1, bk', bk]
    · simp [hM1, hi]
  simp only [pure_bind, StateT.run_bind, StateT.run_modify, StateT.run_pure, simulateQ_pure, htbl_upd]
  rw [hbk_upd]

private theorem step_transmit_postLeak_leOne {Pt : Type} [DecidableEq Pt] [Zero Pt] [SampleableType Pt]
    (mode : Option Bool) (C : Crypto) (Dh : DHFun (BitVec 256) Pt)
    (encPt : Pt → List (BitVec 8)) (encT : Pt → PublicKey) (idOf : Party → IdentityKey)
    (ℓ q qep rem : ℕ) (hℓ : ℓ < 10 ^ 6) (tL : Option ℕ) (par phase1 : Bool) (ks : ℕ → BitVec 256)
    (P : Party) (m : LibsignalMsgPublicPart × Plain ℓ) (r₀ : Option (BitVec 256))
    (hshort : m.1.shortB = true)
    {α : Type}
    (r : Option (Fig8C Pt) → OracleComp (unifSpec + Fig8SpecDF Pt ℓ) α)
    (hIH2 : ∀ u ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL',
      BucketSimInv C ℓ encT idOf q qep tL par ks false rem ssLoc' rsLoc' esLoc' esM' esL' tblM' tblL' →
      LeOne
        (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r u) esLoc' none)
        (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r u) esM' none tblM'))
    (ssLoc : ℕ → RatchetSenderState (BitVec 256))
    (rsLoc : ℕ → RatchetReceiverState (BitVec 256) (BitVec 256))
    (esLoc : LocES Pt ℓ) (esM esL : MultiES Pt ℓ) (tblM tblL : ℕ → SessHSt Pt ℓ)
    (hinv : BucketSimInv C ℓ encT idOf q qep tL par ks phase1 (rem + 1) ssLoc rsLoc esLoc esM esL tblM tblL)
    {s1Loc s1M}
    (hepLoc : esLoc.g.epMgmt 3 qep P r₀.isSome = some s1Loc)
    (hepM : esM.g.epMgmt 3 qep P r₀.isSome = some s1M)
    (hgs1 : GSync s1Loc s1M)
    (hpl1 : postLeak tL s1Loc = true) :
    let qr : (Fig8SpecDF Pt ℓ).Domain := .inl (.inl (.inl (.inl (.inl ⟨P, m, r₀⟩))))
    LeOne
      (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esLoc none)
      (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false
        (liftM (OracleSpec.query (spec := unifSpec + Fig8SpecDF Pt ℓ) (.inr qr)) >>= r) esM none tblM) := by
  intro qr
  have hwinM : esM.g.win = false := by rw [← hinv.gsync.win_eq]; exact hinv.win_false
  have hpr := epMgmt_some_props hepLoc hinv.comp_unhealed hinv.tL_mem_leaks
  have hstLoc1 : s1Loc.st = esLoc.g.st := hpr.1
  have hstM1 : s1M.st = esM.g.st := w7_epMgmt_st_eq hepM
  by_cases hs : P.sendsIn (esLoc.g.epoch P + 1) = true
  · -- Post-leak Case A: new sending epoch t0 := esLoc.g.epoch P + 1
    let ep := esLoc.g.epoch P
    let t0 := ep + 1
    have hs_t0 : P.sendsIn t0 = true := hs
    have hP_send : P = Party.senderOf t0 := (sendsIn_iff_senderOf P t0).mp hs_t0
    obtain ⟨_, hep1_loc, hidx1_loc⟩ := epMgmt_some_sendsIn hepLoc hs
    have hep1_P : s1Loc.epoch P = t0 := by simp [hep1_loc, t0, ep]
    have hidx1_P : s1Loc.idx P = 0 := by simp [hidx1_loc]
    have hep1M_P : s1M.epoch P = t0 := by rw [← hgs1.epoch_eq]; exact hep1_P
    have hidx1M_P : s1M.idx P = 0 := by rw [← hgs1.idx_eq]; exact hidx1_P
    have hsLoc_id : (s1Loc.st P).id.sendsIn ((s1Loc.st P).tcur + 1) = true := by
      rw [hstLoc1, (hinv.vp_id P).1, (hinv.vp_tcur_eq P).1]; exact hs
    have hsM_id : (s1M.st P).id.sendsIn ((s1M.st P).tcur + 1) = true := by
      rw [hstM1, (hinv.vp_id P).2, (hinv.vp_tcur_eq P).2]; exact hs
    have hplM : postLeakDFBucket tL s1M = true := by
      rw [postLeakDFBucket_eq_postLeak tL s1M s1Loc hgs1.tL_eq.symm]; exact hpl1
    let hLoc1 : LocHS Pt :=
      if esLoc.h.lc.isNone && decide (healEpoch tL < t0) then
        { esLoc.h with lc := some (t0 - 1) }
      else esLoc.h
    have hhLoc1 : hLoc1.cache = esLoc.h.cache ∧ hLoc1.fTable = esLoc.h.fTable ∧
        hLoc1.sessions = esLoc.h.sessions := by
      dsimp only [hLoc1]; split <;> exact ⟨rfl, rfl, rfl⟩
    let mkStep (coins : BitVec 256) :=
      let cOut := (dhScheme Dh).send (esLoc.g.st P).γ coins
      let pIk := (rootPRNG C.F encPt).up (esLoc.g.st P).root cOut.2.2
      let hdr : Header Pt := (t0, some cOut.2.1)
      let ss0 := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initSender pIk.2
      let o := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).send ss0 hdr m
      (hdr, o.2)
    suffices hcoins : ∀ coins : BitVec 256,
        let cOut := (dhScheme Dh).send (esLoc.g.st P).γ coins
        let pIk := (rootPRNG C.F encPt).up (esLoc.g.st P).root cOut.2.2
        let hdr : Header Pt := (t0, some cOut.2.1)
        let ss0 := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initSender pIk.2
        let o := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).send ss0 hdr m
        let stLoc' : LocVP Pt :=
          { esLoc.g.st P with tcur := t0, γ := cOut.1, curCkaMsg := some cOut.2.1, root := pIk.1, vS := some o.1 }
        let stM' : MultiVP Pt :=
          { esM.g.st P with tcur := t0, γ := cOut.1, curCkaMsg := some cOut.2.1, root := pIk.1, vS := some (.inl o.1) }
        let rec_ : Record (LibsignalMsgPublicPart × Plain ℓ) (Fig8C Pt) := ⟨⟨P, t0, 1⟩, m, (hdr, o.2)⟩
        let esLoc' : LocES Pt ℓ :=
          { esLoc with
            g := s1Loc.record 3 P stLoc' rec_ false
            h := { hLoc1 with cache := Function.update hLoc1.cache t0 (some (cOut.2.1, pIk.1, pIk.2)) } }
        let esM' : MultiES Pt ℓ :=
          { esM with
            g := s1M.record 3 P stM' rec_ false
            h := { esM.h with cache := Function.update esM.h.cache t0 (some (cOut.2.1, pIk.1, pIk.2, none)) } }
        LeOne
          (runLocCont mode C Dh encPt encT idOf ℓ q qep tL par ks (r (some (hdr, o.2))) esLoc' none)
          (runMultiCont mode C Dh encPt encT idOf ℓ q qep tL par false (r (some (hdr, o.2))) esM' none tblM) by
      have M_sess_def : ((qep + 2) - healEpoch tL) * q = ((qep + 2) - healEpoch tL) * q := rfl
      cases r₀ with
      | some c =>
        have hstepLoc :
            simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
              (((implEDFPaperBucketRaw (hkLocOpt mode C Dh encPt encT idOf ℓ q qep tL par ks)
                3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esLoc) =
            pure (some (mkStep c),
              let cOut := (dhScheme Dh).send (esLoc.g.st P).γ c
              let pIk := (rootPRNG C.F encPt).up (esLoc.g.st P).root cOut.2.2
              let hdr : Header Pt := (t0, some cOut.2.1)
              let ss0 := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initSender pIk.2
              let o := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).send ss0 hdr m
              { esLoc with
                g := s1Loc.record 3 P
                  { esLoc.g.st P with tcur := t0, γ := cOut.1, curCkaMsg := some cOut.2.1, root := pIk.1, vS := some o.1 }
                  ⟨⟨P, t0, 1⟩, m, (hdr, o.2)⟩ false
                h := { hLoc1 with cache := Function.update hLoc1.cache t0 (some (cOut.2.1, pIk.1, pIk.2)) } }) := by
          simp only [qr, implEDFPaperBucketRaw, transmitEBucket, QueryImpl.add_apply_inr, QueryImpl.add_apply_inl,
            StateT.run_bind, StateT.run_get, pure_bind, hinv.abort_loc, hinv.win_false, Bool.or_self,
            Bool.false_eq_true, ↓reduceIte, hepLoc, run_liftH_eq, vSend, hsLoc_id]
          simp only [hkLocOpt, hooksSlotBucketOptAt, hstLoc1, (hinv.vp_tcur_eq P).1,
            hpl1, Bool.true_and, StateT.run_bind, StateT.run_get,
            bind_assoc, pure_bind, simulateQ_bind]
          by_cases hlc : (esLoc.h.lc.isNone && decide (healEpoch tL < esLoc.g.epoch P + 1)) = true
          · have hLoc1_eq : ({ esLoc.h with lc := some (esLoc.g.epoch P + 1 - 1) } : LocHS Pt) = hLoc1 := by
              dsimp only [hLoc1, t0, ep]; rw [hlc]; rfl
            simp only [hlc, ↓reduceIte, StateT.run_bind, StateT.run_modify, StateT.run_pure,
              pure_bind, simulateQ_bind, simulateQ_pure, hLoc1_eq]
            rw [sim_rootSlotBucketAt]
            simp only [Bool.true_or, ↓reduceIte, pure_bind, StateT.run_bind, StateT.run_modify,
              StateT.run_pure, simulateQ_pure, hep1_P, hidx1_P, zero_add, mkStep, t0, ep]
          · have hlc_f : (esLoc.h.lc.isNone && decide (healEpoch tL < esLoc.g.epoch P + 1)) = false :=
              Bool.eq_false_iff.mpr hlc
            have hLoc1_eq : esLoc.h = hLoc1 := by
              dsimp only [hLoc1, t0, ep]; rw [hlc_f]; rfl
            simp only [hlc_f, Bool.false_eq_true, ↓reduceIte, StateT.run_bind, StateT.run_pure,
              simulateQ_bind, simulateQ_pure]
            rw [sim_rootSlotBucketAt]
            simp only [Bool.true_or, ↓reduceIte, pure_bind, StateT.run_bind, StateT.run_modify,
              StateT.run_pure, simulateQ_pure, hep1_P, hidx1_P, zero_add,
              hLoc1_eq, mkStep, t0, ep]
        have hstepM :
            (simulateQ (pubFsImplOpt C ℓ encT idOf false)
              (((implEDFPaperBucketRaw (hkMultiOpt mode C Dh encPt encT idOf ℓ q qep tL par false)
                3 qep maxForwardJumps (bucketAuthCfg 1 tL par)) (.inr qr)).run esM)).run (fun _ => false, tblM) =
            pure ((some (mkStep c),
              let cOut := (dhScheme Dh).send (esLoc.g.st P).γ c
              let pIk := (rootPRNG C.F encPt).up (esLoc.g.st P).root cOut.2.2
              let hdr : Header Pt := (t0, some cOut.2.1)
              let ss0 := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).initSender pIk.2
              let o := (lFS C protoSignalCodec ℓ encT idOf maxForwardJumps).send ss0 hdr m
              { esM with
                g := s1M.record 3 P
                  { esM.g.st P with tcur := t0, γ := cOut.1, curCkaMsg := some cOut.2.1, root := pIk.1, vS := some (.inl o.1) }
                  ⟨⟨P, t0, 1⟩, m, (hdr, o.2)⟩ false
                h := { esM.h with cache := Function.update esM.h.cache t0 (some (cOut.2.1, pIk.1, pIk.2, none)) } }),
