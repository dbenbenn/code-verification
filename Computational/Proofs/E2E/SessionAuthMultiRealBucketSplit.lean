private theorem step1_inject_aux_calcWinEp_sync {Pt : Type} [DecidableEq Pt] {ℓ q qep : ℕ}
    {tL : Option ℕ} {par : Bool} {ks : ℕ → BitVec 256}
    {esLoc : LocES Pt ℓ} {esM : MultiES Pt ℓ}
    (hcache : ∀ t0,
      (esLoc.h.cache t0 = none ∧ esM.h.cache t0 = none) ∨
      (∃ Tc σc kVal, 1 ≤ t0 ∧ esLoc.h.cache t0 = some (Tc, σc, kVal) ∧
        esM.h.cache t0 = some (Tc, σc, kVal, none)) ∨
      (∃ Tc σc kMulti j, 1 ≤ t0 ∧ j < (esM.h.sessions t0).length ∧
        !(qep + 1 < t0) = true ∧ inStage2BucketGen 4 tL par t0 = true ∧
        !(tL.isSome && (t0 == healEpoch tL)) = true ∧
        let sIdx := q * (t0 - healEpoch tL) + j
        esLoc.h.cache t0 = some (Tc, σc, ks sIdx) ∧
        esM.h.cache t0 = some (Tc, σc, kMulti, some sIdx)))
    (htcur : ∀ P, (esLoc.g.st P).tcur = esLoc.g.epoch P ∧ (esM.g.st P).tcur = esLoc.g.epoch P)
    (gMain : Bool) (qr : (Fig8SpecDF Pt ℓ).Domain) (w : Bool) :
    calcWinEp gMain (isHonestHdrSlotBucket esLoc.h) (fun P => (esLoc.g.st P).tcur) qr w =
      calcWinEp gMain (isHonestHdrFSMultiDFBucket esM.h) (fun P => (esM.g.st P).tcur) qr w := by
  have hh : isHonestHdrSlotBucket esLoc.h = isHonestHdrFSMultiDFBucket esM.h :=
    funext (isHonestHdr_eq_of_cache_sync hcache)
  have ht : (fun P => (esLoc.g.st P).tcur) = (fun P => (esM.g.st P).tcur) :=
    funext fun P => (htcur P).1.trans (htcur P).2.symm
  rw [hh, ht]

