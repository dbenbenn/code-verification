private theorem simulateQ_implEDFPaperBucketMode_zero_winEp
    {Γ CCoins T Sig SS RS M E HS : Type}
    [DecidableEq T] [DecidableEq M] [DecidableEq E] [Inhabited E]
    (hk : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS Γ T Sig SS RS M E CCoins Γ Sig SS RS)
    (Δ qep maxSkip : ℕ) (cfg : Config M) (gMain : Bool)
    (isHonest : HS → Header T → Bool)
    {α : Type}
    (oa : OracleComp (unifSpec + _root_.CryptoGames.SM.Construction.DeliverForge.specDF
      (PartyState Γ T Sig SS RS) M CCoins (Header T × E)) α)
    (h0 : oa.IsQueryBoundP (· matches .inr _) 0)
    (es : EState (VP Γ T Sig SS RS) M (Header T × E) HS) :
    ∀ z ∈ support (simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      ((simulateQ (implEDFPaperBucketMode hk Δ qep maxSkip cfg gMain isHonest) oa).run (es, none))),
      z.2.2 = none := by
  induction oa using OracleComp.inductionOn generalizing es with
  | pure a =>
    intro z hz
    simp only [simulateQ_pure, StateT.run_pure, support_pure, Set.mem_singleton_iff] at hz
    subst hz; rfl
  | query_bind t r ih =>
    rw [isQueryBoundP_query_bind_iff] at h0
    rcases t with n | qdf
    · have hcont : ∀ u, (r u).IsQueryBoundP (· matches .inr _) 0 :=
        fun u => by simpa using h0.2 u
      intro z hz
      cases gMain
      · simp only [simulateQ_bind, simulateQ_query, OracleQuery.input_query,
          OracleQuery.cont_query, id_map, implEDFPaperBucketMode, withWinEpDFMode,
          Bool.false_eq_true, ↓reduceIte, implEDFPaperBucketRaw, QueryImpl.add_apply_inl, coinsE,
          StateT.run_bind, StateT.run_mk, StateT.run_lift,
          bind_assoc, pure_bind, mem_support_bind_iff] at hz
        obtain ⟨u, _, hzu⟩ := hz
        have hnot : (!es.g.win && es.g.win) = false := by cases es.g.win <;> rfl
        simp only [hnot, Bool.false_eq_true, ↓reduceIte] at hzu
        exact ih u (hcont u) es z hzu
      · simp only [simulateQ_bind, simulateQ_query, OracleQuery.input_query,
          OracleQuery.cont_query, id_map, implEDFPaperBucketMode, withWinEpDFMode, ↓reduceIte,
          withWinEpDF, implEDFPaperBucketRaw, QueryImpl.add_apply_inl, coinsE,
          StateT.run_bind, StateT.run_mk, StateT.run_lift,
          bind_assoc, pure_bind, mem_support_bind_iff] at hz
        obtain ⟨u, _, hzu⟩ := hz
        have hnot : (!es.g.win && es.g.win) = false := by cases es.g.win <;> rfl
        simp only [hnot, Bool.false_eq_true, ↓reduceIte] at hzu
        exact ih u (hcont u) es z hzu
    · exfalso
      exact Nat.not_lt_zero _ (h0.1.resolve_left (by simp))

private theorem evalDist_singleton_true_eq_zero_of_support {oa : ProbComp Bool}
    (h : ∀ b ∈ support oa, b = false) : 𝒟[oa] {true} = 0 := by
  have heq : 𝒟[oa] = 𝒟[(pure false : ProbComp Bool)] := by
    induction oa using OracleComp.inductionOn with
    | pure a =>
      rw [h a (by simp)]
    | query_bind t r ih =>
      trans 𝒟[(query (spec := unifSpec) t : ProbComp _) >>= fun _ => (pure false : ProbComp Bool)]
      · exact evalDist_bind_congr _ _ _ fun u => ih u fun b hb =>
          h b (by rw [mem_support_bind_iff]; exact ⟨u, by simp, hb⟩)
      · exact OracleComp.evalDist_bind_const (query (spec := unifSpec) t : ProbComp _) (pure false)
  rw [heq]
  simp

private theorem localAuthDFPaperBucketOpt_eq_zero_of_q_zero
    {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType KR] [SampleableType KC] [SampleableType CCoins]
    [SampleableType I] [SampleableType K]
    (mode : Option Bool)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (lam : I) (Δcka qep : ℕ)
    (tL : Option ℕ) (par : Bool)
    (A : SchemeAdversaryDF Γ T Sig SS RS M CCoins E)
    (hq0 : MakesAtMostQueriesDF A 0) :
    𝒟[localAuthDFPaperBucketOpt mode cka prng fs lam Δcka qep tL par A] {true} = 0 := by
  unfold MakesAtMostQueriesDF at hq0
  have hraw : ∀ (hk : _root_.CryptoGames.SM.Engine.Hooks
        _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
        (LocalBucketState T Sig K I) Γ T Sig SS RS M E CCoins Γ Sig SS RS)
      (gMain : Bool)
      (outFn : Option (Bool × (EState (VP Γ T Sig SS RS) M (Header T × E)
        (LocalBucketState T Sig K I) × Option ℕ)) → Bool),
      outFn none = false →
      (∀ b es, outFn (some (b, (es, none))) = false) →
      𝒟[simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
          (engRunDFPaperBucketMode hk (2 + Δcka) qep fs.maxSkip (bucketAuthCfg Δcka tL par)
            gMain isHonestHdrLocalBucket
            (initLocalBucket cka prng fs lam (3 + Δcka) qep tL par) {} false A) >>=
        fun r => pure (outFn r)] {true} = 0 := by
    intro hk gMain outFn hNone hSomeNone
    apply evalDist_singleton_true_eq_zero_of_support
    intro b hb
    rw [mem_support_bind_iff] at hb
    obtain ⟨r, hr, hbr⟩ := hb
    simp only [support_pure, Set.mem_singleton_iff] at hbr
    unfold engRunDFPaperBucketMode at hr
    simp only [simulateQ_bind, mem_support_bind_iff] at hr
    obtain ⟨⟨vs, h0⟩, _, hr2⟩ := hr
    rcases vs with _ | ⟨vA, vB⟩
    · simp only [simulateQ_pure, support_pure, Set.mem_singleton_iff] at hr2
      subst hr2; simpa [hNone] using hbr
    · simp only [simulateQ_bind, simulateQ_pure, mem_support_bind_iff, support_pure,
        Set.mem_singleton_iff] at hr2
      obtain ⟨z, hz, rfl⟩ := hr2
      have hnone := simulateQ_implEDFPaperBucketMode_zero_winEp hk (2 + Δcka) qep fs.maxSkip
        (bucketAuthCfg Δcka tL par) gMain isHonestHdrLocalBucket A
        (by convert hq0 using 1; funext x; rcases x with _ | _ <;> rfl)
        { g := { st := fun P => match P with | .A => vA | .B => vB, b := false }, h := h0 } z hz
      rcases z with ⟨bOut, esOut, winEpOut⟩
      dsimp only at hnone; subst hnone
      simpa [hSomeNone] using hbr
  rcases mode with _ | gMain
  · dsimp only [localAuthDFPaperBucketOpt]
    rw [localAuthDFPaperBucketRaw_eq_map, map_eq_bind_pure_comp]
    exact hraw (hooksLocalBucket cka prng fs Δcka qep tL par) true
      (bucketRawOut (2 + Δcka) tL) rfl (fun _ _ => rfl)
  · cases gMain
    · simp only [localAuthDFPaperBucketOpt, localAuthDFPaperBucketMode,
        localAuthDFPaperBucketSplit, Bool.false_eq_true, ↓reduceIte, localAuthDFPaperBucketForgedHdr]
      exact hraw (hooksLocalBucketForgedHdr cka prng fs Δcka qep tL par) false
        (fun r => match r with | none => false | some (_, st) => authOutBucketPaper (2 + Δcka) tL st)
        rfl (fun _ _ => rfl)
    · simp only [localAuthDFPaperBucketOpt, localAuthDFPaperBucketMode,
        localAuthDFPaperBucketSplit, ↓reduceIte, localAuthDFPaperBucketMain]
      exact hraw (hooksLocalBucketMain cka prng fs Δcka qep tL par) true
        (fun r => match r with | none => false | some (_, st) => authOutBucketPaper (2 + Δcka) tL st)
        rfl (fun _ _ => rfl)

end ZeroQueriesBase

