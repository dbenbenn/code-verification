      (calcWinEp (mode != some false) (isHonestHdrSlotBucket esLoc.h)
        (fun P => (esLoc.g.st P).tcur) qr esLoc'.g.win) := by
  rw [runLocCont_inr_eq _ _ _ _ _ _ _ _ _ _ _ _ qr r esLoc hwin, hstep, pure_bind]

