private theorem redFSAuthDFPaperMultiBucketMode_sessOffRange_zero_gen
    {KC Γ CCoins T I KR RSt K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType KR] [SampleableType KC] [SampleableType CCoins]
    [SampleableType I] [SampleableType K]
    {q : ℕ} (hqpos : 0 < q)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR RSt I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (lam : I)
    (qep : ℕ) (gMain : Bool) (tL : Option ℕ) (par la : Bool)
    (A : SchemeAdversaryDF Γ T RSt SS RS M CCoins E)
    (hq : MakesAtMostQueriesDF A q) :
    (redFSAuthDFPaperMultiBucketMode (q + 1) cka prng fs lam 1 4 qep gMain la tL par A).IsQueryBoundP
      (fun t => sessOffRange (((qep + 2) - healEpoch tL) * q) t = true) 0 := by
  let M_sess := ((qep + 2) - healEpoch tL) * q
  suffices h : OffZeroBound (sessOffRange M_sess) (fun _ => True)
      (redFSAuthDFPaperMultiBucketMode (q + 1) cka prng fs lam 1 4 qep gMain la tL par A) from
    h.to_isQueryBoundP
  have hq' : A.IsQueryBoundP (fun x => x.isRight = true) q := by
    unfold MakesAtMostQueriesDF at hq
    convert hq using 1; funext x; rcases x with _ | _ <;> rfl
  unfold redFSAuthDFPaperMultiBucketMode redFSAuthDFPaperMultiBucketModeGen engRunDFPaperBucketMode
    implEDFPaperBucketMode
  rw [bind_assoc]
  have hinit0 : InRangeH q qep tL par q ({} : FSMultiDFBucketState T RSt K I E) :=
    ⟨fun u _ => by simp, fun _ _ _ _ _ hc => by cases hc⟩
  have hinit : OffZeroBound (sessOffRange M_sess)
      (fun z => InRangeH q qep tL par q z.2 ∧
        ∀ vA vB, z.1 = some (vA, vB) → InRangeVP M_sess vA ∧ InRangeVP M_sess vB)
      ((initFSMultiDFBucketPaper (q + 1) cka prng fs lam 4 qep tL par).run {}) := by
    unfold initFSMultiDFBucketPaper
    simp only [StateT.run_bind]
    refine (off_lift_sampleT_zeroBound (sessOffRange M_sess) (fun _ => rfl) KR
      (fun h' => InRangeH q qep tL par q h' ∧ h'.sessions = ({} : FSMultiDFBucketState T RSt K I E).sessions)
      {} ⟨hinit0, rfl⟩).bind fun ⟨kr, h1⟩ ⟨hH1, hs1⟩ => ?_
    refine (off_lift_sampleT_zeroBound (sessOffRange M_sess) (fun _ => rfl) KC
      (fun h' => InRangeH q qep tL par q h' ∧ h'.sessions = h1.sessions)
      h1 ⟨hH1, rfl⟩).bind fun ⟨kc, h2⟩ ⟨hH2, hs2⟩ => ?_
    refine (rootFSMultiDFBucketPaper_inRange prng false lam (prng.init kr) h2 hH2).bind
      fun ⟨⟨σ, kVal, optSid⟩, h3⟩ ⟨hH3, hs3, hopt⟩ => ?_
    have hs30 : h3.sessions 0 = [] := by
      have h0s : ({} : FSMultiDFBucketState T RSt K I E).sessions 0 = [] := rfl
      rw [← h0s, ← hs1, ← hs2, ← hs3]
    dsimp only [MonadStateOf.get, StateT.get, MonadStateOf.set, StateT.set]
    simp only [StateT.run_get, StateT.run_pure, pure_bind]
    rcases optSid with _ | ik
    · dsimp only [regSessOptMultiDFBucket]
      apply OffZeroBound.pure
      refine ⟨hH3, fun vA vB hv => ?_⟩
      simp only [Option.some.injEq] at hv; rcases hv with ⟨rfl, rfl⟩
      refine ⟨⟨by simp, fun u sIdx hu => ?_⟩, ⟨by simp, fun u sIdx hu => ?_⟩⟩
      · by_cases hu0 : u = 0 <;> simp [hu0] at hu
      · by_cases hu0 : u = 0 <;> simp at hu
    · obtain ⟨_, hbk⟩ := hopt rfl
      have hcap' : !(qep + 1 < 0) = true := by simp
      dsimp only [regSessOptMultiDFBucket, regSessMultiDFBucket]
      have hsub : (q + 1) - 1 = q := Nat.add_sub_cancel q 1
      rw [hsub]
      simp only [hs30, List.not_mem_nil, ↓reduceIte, List.nil_append, List.length_nil]
      have hsIdx_lt : q * (0 - healEpoch tL) + 0 < M_sess :=
        bucketSlot_lt_mSess hcap' hbk hqpos
      apply OffZeroBound.pure
      refine ⟨⟨fun u hu => ?_, hH3.cache_lt⟩, fun vA vB hv => ?_⟩
      · have hu0 : u ≠ 0 := by omega
        simpa only [Function.update_of_ne hu0] using hH3.pos_len u hu
      · simp only [Option.some.injEq] at hv; rcases hv with ⟨rfl, rfl⟩
        refine ⟨⟨?_, fun u sIdx hu => ?_⟩, ⟨?_, fun u sIdx hu => ?_⟩⟩
        · intro sIdx hs
          simp only [reduceCtorEq] at hs
        · by_cases hu0 : u = 0
          · subst hu0
            simp only [↓reduceIte, Option.some.injEq, Sum.inr.injEq] at hu
            try (subst hu; exact hsIdx_lt)
          · simp [hu0] at hu
        · intro sIdx hs
          simp only [Option.some.injEq, Sum.inr.injEq] at hs
          try (subst hs; exact hsIdx_lt)
        · by_cases hu0 : u = 0
          · subst hu0
            simp only [reduceCtorEq] at hu
          · simp at hu
  refine hinit.bind fun ⟨vs, h⟩ ⟨hH, hvs⟩ => ?_
  rcases vs with _ | ⟨vA, vB⟩
  · simp only [pure_bind]; exact OffZeroBound.pure trivial
  · simp only [bind_assoc]
    obtain ⟨hvA, hvB⟩ := hvs vA vB rfl
    let es₀ : EState (VP Γ T RSt (SS ⊕ ℕ) (RS ⊕ ℕ)) M (Header T × E)
        (FSMultiDFBucketState T RSt K I E) :=
      { g := { st := (fun P => match P with | .A => vA | .B => vB), b := false }, h := h }
    have hes₀ : InRangeES q qep tL par q es₀ :=
      ⟨fun P => by cases P with | A => exact hvA | B => exact hvB, hH⟩
    let hk := hooksFSMultiDFBucketPaperMode (q + 1) cka prng fs 1 4 qep gMain tL par la
    let rawImpl := implEDFPaperBucketRaw hk 3 qep fs.maxSkip (bucketAuthCfgGen 4 tL par)
    let impl := withWinEpDFMode gMain isHonestHdrFSMultiDFBucket (fun vp => vp.tcur) rawImpl
    have hWithInl : ∀ (u : unifSpec.Domain) st rem,
        InRangeES q qep tL par rem st.1 →
        OffZeroBound (sessOffRange M_sess) (fun z => InRangeES q qep tL par rem z.2.1)
          ((impl (.inl u)).run st) := by
      intro u ⟨es, we⟩ rem hes
      cases gMain
      · simp only [impl, withWinEpDFMode, Bool.false_eq_true, ↓reduceIte,
          rawImpl, implEDFPaperBucketRaw, QueryImpl.add_apply_inl, coinsE,
          StateT.run_mk, StateT.run_lift, bind_assoc, pure_bind]
        exact (OffZeroBound.query_false (by simp [sessOffRange])).bind fun _ _ =>
          OffZeroBound.pure hes
      · simp only [impl, withWinEpDFMode, ↓reduceIte, withWinEpDF,
          rawImpl, implEDFPaperBucketRaw, QueryImpl.add_apply_inl, coinsE,
          StateT.run_mk, StateT.run_lift, bind_assoc, pure_bind]
        exact (OffZeroBound.query_false (by simp [sessOffRange])).bind fun _ _ =>
          OffZeroBound.pure hes
    have hWithInr : ∀ qr st rem,
        InRangeES q qep tL par (rem + 1) st.1 →
        OffZeroBound (sessOffRange M_sess) (fun z => InRangeES q qep tL par rem z.2.1)
          ((impl (.inr qr)).run st) := by
      intro qr ⟨es, we⟩ rem hes
      cases gMain
      · simp only [impl, withWinEpDFMode, Bool.false_eq_true, ↓reduceIte,
          StateT.run_mk]
        exact (implEDFPaperBucketRaw_mode_inRange cka prng fs false tL par la qr es hes).bind
          fun ⟨_, es'⟩ hes' => OffZeroBound.pure hes'
      · simp only [impl, withWinEpDFMode, ↓reduceIte, withWinEpDF,
          StateT.run_mk]
        exact (implEDFPaperBucketRaw_mode_inRange cka prng fs true tL par la qr es hes).bind
          fun ⟨_, es'⟩ hes' => OffZeroBound.pure hes'
    refine (off_simulateQ_run_fuel (sessOffRange M_sess)
      (fun rem st => InRangeES q qep tL par rem st.1) impl hWithInl hWithInr
      q A hq' (es₀, none) hes₀).bind fun _ _ => ?_
    simp only [pure_bind]; exact OffZeroBound.pure trivial

end OffRangeBound

section SeedAlignment

private structure LocalSlotBucketState (T Sig K I : Type) where
  cache : ℕ → Option (T × Sig × K) := fun _ => none
  fTable : ℕ → List (I × K) := fun _ => []
  sessions : ℕ → List I := fun _ => []
  lc : Option ℕ := none

private def toLocalBucketState {T Sig K I : Type}
    (s : LocalSlotBucketState T Sig K I) : LocalBucketState T Sig K I :=
  { cache := s.cache, fTable := s.fTable, lc := s.lc }

private def isHonestHdrSlotBucket {T Sig K I : Type} [DecidableEq T]
    (h : LocalSlotBucketState T Sig K I) (hdr : Header T) : Bool :=
  isHonestHdrLocalBucket (toLocalBucketState h) hdr

private def lookupSlotBucketAt {T Sig K I : Type} [DecidableEq I] [SampleableType K]
    (q m : ℕ) (ks : ℕ → K) (tL : Option ℕ) (t0 : ℕ) (ik : I) :
    _root_.CryptoGames.SM.Engine.HM _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
      (LocalSlotBucketState T Sig K I) K := do
  let st ← get
  match (st.fTable t0).lookup ik with
  | some k => return k
  | none =>
    let kDrawn ← StateT.lift (_root_.CryptoGames.SM.Construction.sampleT K)
    let sIdx := q * (t0 - healEpoch tL) + (st.sessions t0).length
    let kUse := if sIdx < m then ks sIdx else kDrawn
    modify fun s =>
      { s with
        fTable := Function.update s.fTable t0 ((ik, kUse) :: s.fTable t0)
        sessions := Function.update s.sessions t0 (s.sessions t0 ++ [ik]) }
    return kUse

private def rootSlotBucketAt {KR Sig I K T : Type} [DecidableEq I] [SampleableType I] [SampleableType K]
    (q m : ℕ) (ks : ℕ → K) (prng : PRFPRNG KR Sig I K) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (t0 : ℕ) (pl : Bool) (ik0 : I) (σ0 : Sig) :
    _root_.CryptoGames.SM.Engine.HM _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
      (LocalSlotBucketState T Sig K I) (Sig × K) := do
  let tH := healEpoch tL
  let pIk := prng.up σ0 ik0
  if pl || qep + 1 < t0 then
    return (pIk.1, pIk.2)
  else if tL.isSome && t0 = tH then
    let ir ← StateT.lift (_root_.CryptoGames.SM.Construction.sampleT I)
    let kSample ← StateT.lift (_root_.CryptoGames.SM.Construction.sampleT K)
    return ((prng.up σ0 ir).1, kSample)
  else if inStage2BucketGen 4 tL par t0 then
    let kLookup ← lookupSlotBucketAt q m ks tL t0 ik0
    return (pIk.1, kLookup)
  else
    return (pIk.1, pIk.2)

private def hooksSlotBucketOptAt {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [SampleableType CCoins] [SampleableType I] [SampleableType K]
    (mode : Option Bool) (q m : ℕ) (ks : ℕ → K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E)
    (qep : ℕ) (tL : Option ℕ) (par : Bool) :
    _root_.CryptoGames.SM.Engine.Hooks _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
      (LocalSlotBucketState T Sig K I) Γ T Sig SS RS M E CCoins Γ Sig SS RS where
  startSend ctx _ t0 γ0 σ0 r0 := do
    let tH := healEpoch tL
    let pl := postLeak tL ctx
    let h0 ← get
    if pl && h0.lc.isNone && tH < t0 then
      modify fun s => { s with lc := some (t0 - 1) }
    let coins ← match r0 with
      | some c => pure c
      | none => StateT.lift (_root_.CryptoGames.SM.Construction.sampleT CCoins)
    let c := cka.send γ0 coins
    let (σ', kVal) ← rootSlotBucketAt q m ks prng qep tL par t0 pl c.2.2 σ0
    modify fun s => { s with cache := Function.update s.cache t0 (some (c.2.1, σ', kVal)) }
    return some (c.1, c.2.1, σ', fs.initSender kVal)
  startRecv ctx _ t0 γ0 σ0 tn0 := do
    let tH := healEpoch tL
    let pl := postLeak tL ctx
    let honest := match (← get).cache t0 with
      | some (tCached, σc, kVal) => if tCached = tn0 then some (σc, kVal) else none
      | none => none
    match honest with
    | some (σc, kVal) =>
      return some (some ((cka.receive γ0 tn0).1, σc, fs.initReceiver kVal))
    | none =>
      if mode == some true then
        if !(qep + 1 < t0) && inStage2BucketGen 4 tL par t0 &&
            (tL.isSome && decide (t0 = tH)) then
          return none
        else
          return some none
      else if !(qep + 1 < t0) && inStage2Bucket 1 tL par t0 then
        if tL.isSome && t0 = tH then
          return none
        else if pl then
          let kk := cka.receive γ0 tn0
          let p := prng.up σ0 kk.2
          return some (some (kk.1, p.1, fs.initReceiver p.2))
        else
          let kk := cka.receive γ0 tn0
          let k' ← lookupSlotBucketAt q m ks tL t0 kk.2
          return some (some (kk.1, (prng.up σ0 kk.2).1, fs.initReceiver k'))
      else
        return some none
  fsSend _ _ _ ss h m_msg _ := pure (some (fs.send ss h m_msg))
  fsRecv _ _ _ rs h e _ := pure (some (fs.receive rs h e))
  commit _ _ _ new := pure (some new)
  reveal ctx _ vp := do
    if mode == some false &&
        (!(vp.tcur < healEpoch tL) || !(max (ctx.epoch .A) (ctx.epoch .B) < healEpoch tL)) then
      return none
    else
      let tH := healEpoch tL
      let e := vp.tcur
      let pl := postLeak tL ctx
      let h0 ← get
      if !pl && h0.lc.isNone && !(e < tH) then
        modify fun s => { s with lc := some e }
      return some (realParty vp vp.γ vp.root vp.vS vp.vR)

private def initSlotBucketAt {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq I] [SampleableType KR] [SampleableType KC] [SampleableType I] [SampleableType K]
    (q m : ℕ) (ks : ℕ → K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (lam : I)
    (qep : ℕ) (tL : Option ℕ) (par : Bool) :
    _root_.CryptoGames.SM.Engine.HM _root_.CryptoGames.SM.Construction.AuthL11.nilSpec
      (LocalSlotBucketState T Sig K I)
      (Option (VP Γ T Sig SS RS × VP Γ T Sig SS RS)) := do
  let kr ← StateT.lift (_root_.CryptoGames.SM.Construction.sampleT KR)
  let kc ← StateT.lift (_root_.CryptoGames.SM.Construction.sampleT KC)
  let (σ, kVal) ← rootSlotBucketAt q m ks prng qep tL par 0 false lam (prng.init kr)
  return some (mkParties (cka.initA kc) (cka.initB kc) σ
    (fs.initSender kVal) (fs.initReceiver kVal))

private def localSlotBucketOptAt {KC Γ CCoins T I KR Sig K SS RS M E : Type}
    [DecidableEq T] [DecidableEq I] [DecidableEq M] [DecidableEq E] [Inhabited E]
    [SampleableType KR] [SampleableType KC] [SampleableType CCoins]
    [SampleableType I] [SampleableType K]
    (mode : Option Bool) (q m : ℕ) (ks : ℕ → K)
    (cka : CKAScheme KC Γ CCoins T I) (prng : PRFPRNG KR Sig I K)
    (fs : FSAEADScheme K SS RS (Header T) M E) (lam : I)
    (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (A : SchemeAdversaryDF Γ T Sig SS RS M CCoins E) : ProbComp Bool :=
  bucketRawOut 3 tL <$>
    simulateQ _root_.CryptoGames.SM.Construction.AuthL11.lImpl
      (engRunDFPaperBucketMode (hooksSlotBucketOptAt mode q m ks cka prng fs qep tL par)
        3 qep fs.maxSkip (bucketAuthCfg 1 tL par) (mode != some false) isHonestHdrSlotBucket
        (initSlotBucketAt q m ks cka prng fs lam qep tL par) {} false A)

private theorem lookupSlotBucketAt_zero_map {T Sig K I : Type} [DecidableEq I] [SampleableType K]
    (q : ℕ) (ks : ℕ → K) (tL : Option ℕ) (t0 : ℕ) (ik : I)
    (s : LocalSlotBucketState T Sig K I) :
    Prod.map id toLocalBucketState <$> (lookupSlotBucketAt q 0 ks tL t0 ik).run s =
      (lookupLocalBucketF t0 ik).run (toLocalBucketState s) := by
  unfold lookupSlotBucketAt lookupLocalBucketF
  simp only [StateT.run_bind, StateT.run_get, pure_bind, toLocalBucketState]
  rcases hlk : (s.fTable t0).lookup ik with _ | k
  · simp [StateT.run_lift, StateT.run_modify, Prod.map, toLocalBucketState]
  · simp [StateT.run_pure, Prod.map, toLocalBucketState]

private theorem rootSlotBucketAt_zero_map {KR Sig I K T : Type}
    [DecidableEq I] [SampleableType I] [SampleableType K]
    (q : ℕ) (ks : ℕ → K) (prng : PRFPRNG KR Sig I K) (qep : ℕ) (tL : Option ℕ) (par : Bool)
    (t0 : ℕ) (pl : Bool) (ik0 : I) (σ0 : Sig) (s : LocalSlotBucketState T Sig K I) :
    Prod.map id toLocalBucketState <$>
        (rootSlotBucketAt q 0 ks prng qep tL par t0 pl ik0 σ0).run s =
      (rootLocalBucket prng 4 qep tL par t0 pl ik0 σ0).run (toLocalBucketState s) := by
  unfold rootSlotBucketAt rootLocalBucket
  dsimp only
  have hbg : inStage2BucketGen 4 tL par t0 =
      _root_.CryptoGames.SM.Construction.DeliverForge.inStage2BucketGen 4 tL par t0 := rfl
  rw [hbg]
  split_ifs
  · simp [StateT.run_pure, Prod.map]
  · simp [StateT.run_bind, StateT.run_lift, map_bind, Prod.map]
  · simp only [StateT.run_bind, StateT.run_pure, map_bind]
    rw [← lookupSlotBucketAt_zero_map q ks tL t0 ik0 s, bind_map_left]
    simp [Prod.map]
  · simp [StateT.run_pure, Prod.map]


private def mapEStateH {VPt M C HS₁ HS₂ : Type} (f : HS₁ → HS₂)
    (es : EState VPt M C HS₁) : EState VPt M C HS₂ :=
  { g := es.g, h := f es.h, abort := es.abort }

private structure HooksMapStep
    {Γ CCoins T Sig SS RS M E HS₁ HS₂ : Type}
    (Inv : ℕ → HS₁ → Prop) (f : HS₁ → HS₂)
    (hk₁ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₁ Γ T Sig SS RS M E CCoins Γ Sig SS RS)
    (hk₂ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₂ Γ T Sig SS RS M E CCoins Γ Sig SS RS) :
    Prop where
  mono : ∀ rem s, Inv (rem + 1) s → Inv rem s
  startSend_eq : ∀ rem ctx P t0 γ0 σ0 r0 s, 1 ≤ t0 → Inv (rem + 1) s →
    Prod.map id f <$> (hk₁.startSend ctx P t0 γ0 σ0 r0).run s =
      (hk₂.startSend ctx P t0 γ0 σ0 r0).run (f s) ∧
    ∀ z ∈ support ((hk₁.startSend ctx P t0 γ0 σ0 r0).run s), Inv rem z.2
  startRecv_eq : ∀ rem ctx P t0 γ0 σ0 tn0 s, 1 ≤ t0 → Inv (rem + 1) s →
    Prod.map id f <$> (hk₁.startRecv ctx P t0 γ0 σ0 tn0).run s =
      (hk₂.startRecv ctx P t0 γ0 σ0 tn0).run (f s) ∧
    ∀ z ∈ support ((hk₁.startRecv ctx P t0 γ0 σ0 tn0).run s), Inv rem z.2
  fsSend_pure : ∀ ctx P t0 ss h m r,
    ∃ res, hk₁.fsSend ctx P t0 ss h m r = pure res ∧ hk₂.fsSend ctx P t0 ss h m r = pure res
  fsRecv_pure : ∀ ctx P t0 rs h e rec,
    ∃ res, hk₁.fsRecv ctx P t0 rs h e rec = pure res ∧ hk₂.fsRecv ctx P t0 rs h e rec = pure res
  commit_pure : ∀ ctx P old new,
    ∃ res, hk₁.commit ctx P old new = pure res ∧ hk₂.commit ctx P old new = pure res
  reveal_eq : ∀ rem ctx P vp s, Inv (rem + 1) s →
    Prod.map id f <$> (hk₁.reveal ctx P vp).run s = (hk₂.reveal ctx P vp).run (f s) ∧
    ∀ z ∈ support ((hk₁.reveal ctx P vp).run s), Inv rem z.2

private theorem vSend_map_step
    {Γ CCoins T Sig SS RS M E HS₁ HS₂ : Type} [Inhabited E]
    {Inv : ℕ → HS₁ → Prop} {f : HS₁ → HS₂}
    {hk₁ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₁ Γ T Sig SS RS M E CCoins Γ Sig SS RS}
    {hk₂ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₂ Γ T Sig SS RS M E CCoins Γ Sig SS RS}
    (hH : HooksMapStep Inv f hk₁ hk₂)
    (rem : ℕ) (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (vp : VP Γ T Sig SS RS)
    (m_msg : M) (pair : Option (M × M)) (r : Option CCoins) (s : HS₁)
    (hInv : Inv (rem + 1) s) :
    Prod.map id f <$> (vSend hk₁ ctx P vp m_msg pair r).run s =
      (vSend hk₂ ctx P vp m_msg pair r).run (f s) ∧
    ∀ z ∈ support ((vSend hk₁ ctx P vp m_msg pair r).run s), Inv rem z.2 := by
  unfold vSend
  dsimp only
  by_cases hs : vp.id.sendsIn (vp.tcur + 1)
  · obtain ⟨heq, hsupp⟩ := hH.startSend_eq rem ctx P (vp.tcur + 1) vp.γ vp.root r s (by omega) hInv
    refine ⟨?_, ?_⟩
    · simp only [hs, ↓reduceIte, StateT.run_bind, pure_bind, map_bind,
        ← heq, bind_map_left]
      refine bind_congr fun ⟨out, s1⟩ => ?_
      dsimp only [Prod.map, id_eq]
      rcases out with _ | ⟨γ', T', σ', ss⟩
      · simp [StateT.run_pure, Prod.map]
      · dsimp only
        obtain ⟨res, hr1, hr2⟩ := hH.fsSend_pure ctx P (vp.tcur + 1) ss (vp.tcur + 1, some T') m_msg pair
        rw [hr1, hr2]
        rcases res with _ | ⟨ss', e⟩ <;> simp [StateT.run_pure, pure_bind, Prod.map]
    · intro z hz
      simp only [hs, ↓reduceIte, StateT.run_bind, pure_bind, mem_support_bind_iff] at hz
      obtain ⟨⟨out, s1⟩, hm1, hz2⟩ := hz
      have hInv1 := hsupp (out, s1) hm1
      rcases out with _ | ⟨γ', T', σ', ss⟩
      · simp only [StateT.run_pure, support_pure, Set.mem_singleton_iff] at hz2
        subst hz2; exact hInv1
      · dsimp only at hz2
        obtain ⟨res, hr1, _⟩ := hH.fsSend_pure ctx P (vp.tcur + 1) ss (vp.tcur + 1, some T') m_msg pair
        rw [hr1] at hz2
        rcases res with _ | ⟨ss', e⟩ <;>
          (simp only [StateT.run_pure, pure_bind, support_pure, Set.mem_singleton_iff] at hz2;
           subst hz2; exact hInv1)
  · simp only [hs, Bool.false_eq_true, ↓reduceIte, pure_bind]
    rcases hvs : vp.vS with _ | ss
    · refine ⟨?_, ?_⟩
      · simp [StateT.run_pure, Prod.map]
      · intro z hz
        simp only [StateT.run_pure, support_pure, Set.mem_singleton_iff] at hz
        subst hz; exact hH.mono rem s hInv
    · dsimp only
      obtain ⟨res, hr1, hr2⟩ := hH.fsSend_pure ctx P vp.tcur ss (vp.tcur, vp.curCkaMsg) m_msg pair
      refine ⟨?_, ?_⟩
      · rw [hr1, hr2]
        rcases res with _ | ⟨ss', e⟩ <;> simp [StateT.run_pure, pure_bind, Prod.map]
      · intro z hz
        rw [hr1] at hz
        rcases res with _ | ⟨ss', e⟩ <;>
          (simp only [StateT.run_pure, pure_bind, support_pure, Set.mem_singleton_iff] at hz;
           subst hz; exact hH.mono rem s hInv)

private theorem vRecv_map_step
    {Γ CCoins T Sig SS RS M E HS₁ HS₂ : Type} [Inhabited E]
    {Inv : ℕ → HS₁ → Prop} {f : HS₁ → HS₂}
    {hk₁ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₁ Γ T Sig SS RS M E CCoins Γ Sig SS RS}
    {hk₂ : _root_.CryptoGames.SM.Engine.Hooks
      _root_.CryptoGames.SM.Construction.AuthL11.nilSpec HS₂ Γ T Sig SS RS M E CCoins Γ Sig SS RS}
    (hH : HooksMapStep Inv f hk₁ hk₂)
    (rem : ℕ) (ctx : Ctx Γ T Sig SS RS M E) (P : Party) (vp : VP Γ T Sig SS RS)
    (c : Header T × E) (rec : Option (Record M (Header T × E))) (s : HS₁)
    (hInv : Inv (rem + 1) s) :
    Prod.map id f <$> (vRecv hk₁ ctx P vp c rec).run s =
      (vRecv hk₂ ctx P vp c rec).run (f s) ∧
    ∀ z ∈ support ((vRecv hk₁ ctx P vp c rec).run s), Inv rem z.2 := by
  rcases c with ⟨⟨t_hdr, optTn⟩, e_ct⟩
  unfold vRecv
  dsimp only
  by_cases hguard : (vp.id.sendsIn t_hdr || decide (vp.tcur + 1 < t_hdr)) = true
  · simp only [hguard, ↓reduceIte, StateT.run_pure, map_pure, Prod.map, support_pure,
      Set.mem_singleton_iff, forall_eq]
    exact ⟨rfl, hH.mono rem s hInv⟩
  · simp only [hguard, Bool.false_eq_true, ↓reduceIte]
    by_cases ht : t_hdr = vp.tcur + 1
    · subst ht
      simp only [↓reduceIte]
      rcases optTn with _ | Tn
      · simp only [StateT.run_pure, pure_bind, map_pure, Prod.map, support_pure,
          Set.mem_singleton_iff, forall_eq]
        exact ⟨rfl, hH.mono rem s hInv⟩
      · obtain ⟨heq, hsupp⟩ := hH.startRecv_eq rem ctx P (vp.tcur + 1) vp.γ vp.root Tn s (by omega) hInv
        refine ⟨?_, ?_⟩
        · simp only [StateT.run_bind, pure_bind, map_bind, ← heq, bind_map_left]
          refine bind_congr fun ⟨out, s1⟩ => ?_
          dsimp only [Prod.map, id_eq]
          rcases out with _ | (_ | ⟨γ', σ', rs⟩)
          · simp [StateT.run_pure, Prod.map]
          · simp [StateT.run_pure, Prod.map]
          · dsimp only
