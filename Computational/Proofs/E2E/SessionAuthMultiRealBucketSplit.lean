        · simp only [StateT.run_bind, simulateQ_bind, mem_support_bind_iff] at hraw
          rcases hraw with ⟨⟨rv, es_m⟩, hv, hraw2⟩
          have hgm := (liftH_mem_support_g_eq _ _ hv).1
          rcases rv with _ | (_ | ⟨st', t', i', m'⟩)
          · simp only [abortE, StateT.run_bind, StateT.run_modify, StateT.run_pure, pure_bind,
              simulateQ_pure, support_pure, Set.mem_singleton_iff] at hraw2
            rcases Prod.mk.inj hraw2 with ⟨_, hEs⟩; subst hEs
