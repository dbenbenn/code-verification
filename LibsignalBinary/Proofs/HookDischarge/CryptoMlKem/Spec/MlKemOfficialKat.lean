/-!
# Official NIST Known-Answer Tests for the Trusted ML-KEM-768 and Kyber-1024 Specs

`#guard` checks of the trusted definitions in `CryptoGames.MLKEM`
(`LibsignalBinary/Specifications/CryptoGames/KEM/MlKem.lean`) against official NIST vectors
(`Spec/MlKemOfficialVectors.lean`, generated by `Spec/official_kat_gen/gen_official_kat.py`).
`Spec/MlKemKat.lean` checks the same definitions against `libcrux-ml-kem` `0.0.10`; this file adds
vectors that do not come from the implementation being modelled.

The checks run the trusted definitions with the computable sampler `sampleNttFuel` (35 SHAKE-128
blocks per `SampleNTT` call) in place of the noncomputable `sampleNtt`. The two agree whenever 35
blocks are enough; if a case needed more, `sampleNttFuel` would return the zero polynomial and the
outputs would not match.

## ML-KEM-768 (FIPS 203, NIST ACVP-Server `v1.1.0.43`)

All 70 ML-KEM-768 cases of the ACVP `internalProjection.json` files:

* `keyGen` (25): `mlkem768KeyPairWith (d ‖ z)` is the FIPS 203 `dk` (2400 bytes,
  `dkPke ‖ ek ‖ H(ek) ‖ z`), and `dk[1152:2336]` is `ek`.
* `encapsulation` (25): the incremental API splits the FIPS 203 `ek = t̂ ‖ ρ` into the header
  `ρ ‖ H(ek)` and `t̂`. `mlkem768Encaps1With hdr m` gives `(c1, es, K)` and
  `mlkem768Encaps2List es t̂` gives `c2`; `c1 ‖ c2` is the FIPS 203 ciphertext and `K` the shared
  secret.
* `decapsulation` (10): `mlkem768DecapsWith dk c[0:960] c[960:1088]` is `K`, for 5 valid and 5
  modified ciphertexts (the implicit-rejection branch, `K = J(z ‖ c)`).
* `encapsulationKeyCheck` (10): `mlkem768ValidPk (ρ ‖ H(ek)) t̂` is the FIPS 203 §7.2 modulus
  check (5 valid keys, 5 with a coefficient `≥ q`).

Not covered: `decapsulationKeyCheck` (the spec, like `libcrux`'s incremental API, has no
decapsulation-key check).

## Kyber-1024 (Round 3, `PQCkemKAT_3168.rsp`)

Counts `0`..`9` of the Round 3 submission KAT. For each count, `kyber1024KeyPairWith (d ‖ z)` gives
the official `(pk, sk)`, `kyber1024EncapsWith pk rand` gives the official `(ct, ss)`, and
`kyber1024DecapsWith sk ct` gives `ss`. `d`, `z`, and `rand` are the DRBG outputs that
`PQCgenKAT_kem.c` passes to `crypto_kem_keypair` and `crypto_kem_enc` (re-derived by the generator).

The Round 3 KAT has only valid ciphertexts. On invalid ones the trusted spec follows `libcrux`
`variant::Kyber`, `SHAKE-256(SHAKE-256(z ‖ ct) ‖ H(ct))`, not the Round 3 reference
`crypto_kem_dec`, `SHAKE-256(z ‖ H(ct))`; `kyber1024RejectionDiffersFromRound3Reference` below
shows the two differ on a modified official ciphertext.
-/

set_option autoImplicit false

public section

namespace LibsignalBinary.Proofs.HookDischarge.CryptoMlKem.Spec.MlKemOfficialKat

open CryptoGames.MLKEM (
  kyber1024DecapsWith
  kyber1024EncapsWith
  kyber1024KeyPairWith
  mlkem768DecapsWith
  mlkem768Encaps1With
  mlkem768Encaps2List
  mlkem768KeyPairWith
  mlkem768ValidPk
)
open CryptoGames.SHA3 (sha3_256List shake256List)
open LibsignalBinary.Proofs.HookDischarge.CryptoMlKem.Spec (sampleNttFuel)
open LibsignalBinary.Proofs.HookDischarge.CryptoMlKem.Spec.MlKemOfficialVectors (
  DecapsVec
  EkCheckVec
  EncapsVec
  KeyGenVec
  Kyber1024Vec
  kyber1024Round3
  mlkem768Decaps
  mlkem768EkCheck
  mlkem768Encaps
  mlkem768KeyGen
)

/-! ## Hex Decoding -/

private def hexDigit? (c : Char) : Option Nat :=
  if '0' ≤ c && c ≤ '9' then some (c.toNat - '0'.toNat)
  else if 'a' ≤ c && c ≤ 'f' then some (c.toNat - 'a'.toNat + 10)
  else none

private def unhexChars? : List Char → Option (List (BitVec 8))
  | [] => some []
  | a :: b :: rest => do
    let hi ← hexDigit? a
    let lo ← hexDigit? b
    let tl ← unhexChars? rest
    pure (BitVec.ofNat 8 (16 * hi + lo) :: tl)
  | [_] => none

/-- Decode lowercase hex of exactly `n` bytes; `none` on a bad digit or length. -/
private def unhexN? (n : Nat) (s : String) : Option (List (BitVec 8)) := do
  let bs ← unhexChars? s.toList
  if bs.length == n then some bs else none

/-! ## ML-KEM-768 -/

/-- Split a FIPS 203 ML-KEM-768 `ek = t̂ ‖ ρ` (1184 bytes) into the incremental API's
`(hdr, t̂)` with `hdr = ρ ‖ H(ek)` (64 bytes). -/
private def splitEk (ek : List (BitVec 8)) : List (BitVec 8) × List (BitVec 8) :=
  ((ek.drop 1152).take 32 ++ sha3_256List ek, ek.take 1152)

private def checkKeyGen (v : KeyGenVec) : Bool := Option.getD (do
  let d ← unhexN? 32 v.d
  let z ← unhexN? 32 v.z
  let ekSha3 ← unhexN? 32 v.ekSha3
  let dkSha3 ← unhexN? 32 v.dkSha3
  let dk := mlkem768KeyPairWith sampleNttFuel (d ++ z)
  pure (dk.length == 2400 && sha3_256List dk == dkSha3 &&
    sha3_256List ((dk.drop 1152).take 1184) == ekSha3)) false

private def checkEncaps (v : EncapsVec) : Bool := Option.getD (do
  let ek ← unhexN? 1184 v.ek
  let m ← unhexN? 32 v.m
  let cSha3 ← unhexN? 32 v.cSha3
  let k ← unhexN? 32 v.k
  let (hdr, tHat) := splitEk ek
  let (c1, es, kOut) ← mlkem768Encaps1With sampleNttFuel hdr m
  let c2 := mlkem768Encaps2List es tHat
  pure (c1.length == 960 && c2.length == 128 && sha3_256List (c1 ++ c2) == cSha3 && kOut == k))
  false

private def checkDecaps (v : DecapsVec) : Bool := Option.getD (do
  let dk ← unhexN? 2400 v.dk
  let c ← unhexN? 1088 v.c
  let k ← unhexN? 32 v.k
  pure (mlkem768DecapsWith sampleNttFuel dk (c.take 960) (c.drop 960) == k)) false

private def checkEkCheck (v : EkCheckVec) : Bool := Option.getD (do
  let ek ← unhexN? 1184 v.ek
  let (hdr, tHat) := splitEk ek
  pure (mlkem768ValidPk hdr tHat == v.passed)) false

-- Every vector group is non-empty, has the expected size, and passes; a failure lists the
-- failing ACVP `tcId`s.
#guard mlkem768KeyGen.length == 25
#guard (mlkem768KeyGen.filter (! checkKeyGen ·)).map (·.tcId) == []

#guard mlkem768Encaps.length == 25
#guard (mlkem768Encaps.filter (! checkEncaps ·)).map (·.tcId) == []

#guard mlkem768Decaps.length == 10
#guard (mlkem768Decaps.filter (·.reason == "modified ciphertext")).length == 5
#guard (mlkem768Decaps.filter (! checkDecaps ·)).map (·.tcId) == []

#guard mlkem768EkCheck.length == 10
#guard (mlkem768EkCheck.filter (! ·.passed)).length == 5
#guard (mlkem768EkCheck.filter (! checkEkCheck ·)).map (·.tcId) == []

/-! ## Kyber-1024 (Round 3) -/

private def checkKyber1024 (v : Kyber1024Vec) : Bool := Option.getD (do
  let d ← unhexN? 32 v.d
  let z ← unhexN? 32 v.z
  let rand ← unhexN? 32 v.rand
  let pk ← unhexN? 1568 v.pk
  let sk ← unhexN? 3168 v.sk
  let ct ← unhexN? 1568 v.ct
  let ss ← unhexN? 32 v.ss
  let (pkOut, skOut) := kyber1024KeyPairWith sampleNttFuel (d ++ z)
  let (ctOut, ssOut) := kyber1024EncapsWith sampleNttFuel pk rand
  pure (pkOut == pk && skOut == sk &&
    ctOut == ct && ssOut == ss && kyber1024DecapsWith sampleNttFuel sk ct == ss)) false

#guard kyber1024Round3.length == 10
#guard (kyber1024Round3.filter (! checkKyber1024 ·)).map (·.count) == []

/-- On the first official ciphertext with its first byte flipped, the trusted Kyber-1024 decaps
returns `SHAKE-256(SHAKE-256(z ‖ ct) ‖ H(ct))` (`libcrux` `variant::Kyber`), which differs from the
Round 3 reference rejection key `SHAKE-256(z ‖ H(ct))`. -/
private def kyber1024RejectionDiffersFromRound3Reference : Bool := Option.getD (do
  let v ← kyber1024Round3.head?
  let sk ← unhexN? 3168 v.sk
  let ct ← unhexN? 1568 v.ct
  let z ← unhexN? 32 v.z
  let badCt := (ct.headD 0#8 ^^^ 0x01#8) :: ct.tail
  let ssRej := kyber1024DecapsWith sampleNttFuel sk badCt
  let hCt := sha3_256List badCt
  pure ((sk.drop 3136).take 32 == z &&
    ssRej == shake256List 32 (shake256List 32 (z ++ badCt) ++ hCt) &&
    ssRej != shake256List 32 (z ++ hCt))) false

#guard kyber1024RejectionDiffersFromRound3Reference

end LibsignalBinary.Proofs.HookDischarge.CryptoMlKem.Spec.MlKemOfficialKat
