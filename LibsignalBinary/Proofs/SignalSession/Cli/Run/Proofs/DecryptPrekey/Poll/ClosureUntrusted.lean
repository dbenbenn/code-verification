/-- Key IDs (`pid`, `sid`, `kid`, `kbk`) extracted from `pm : PreKeySignalMessage` for `cliPoll*Kit`
instantiation (`0#32` / zero-byte defaults when optional fields are `none`). -/
@[expose] def pmPreKeyId (pm : PreKeySignalMessage) : BitVec 32 :=
  pm.preKeyId.getD 0#32

@[expose] def pmKyberId (pm : PreKeySignalMessage) : BitVec 32 :=
  match pm.kyberPayload with
  | some kp => kp.preKeyId
  | none => 0#32

end CryptoVerification.SignalSession.Cli.RunProofs.Poll
